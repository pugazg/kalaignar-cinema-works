{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalaignar-thirai-isai-paadalgal-english-translation.schema.json",
  "title": "Kalaignar film-song anthology source-linked English translation record",
  "type": "object",
  "required": [
    "id",
    "song_id",
    "anthology_song_number",
    "target_language",
    "status",
    "mode",
    "source",
    "translation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^kalaignar-song-en-[0-9]{3}$"
    },
    "song_id": {
      "type": "string",
      "pattern": "^kalaignar-song-[0-9]{3}$"
    },
    "anthology_song_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 54
    },
    "target_language": {
      "const": "en"
    },
    "status": {
      "enum": ["draft", "review", "pilot-verified", "verified"]
    },
    "mode": {
      "const": "semantic-poetic-source-faithful"
    },
    "source": {
      "type": "object",
      "required": [
        "song_file",
        "tamil_status",
        "pdf_pages",
        "tamil_title",
        "film_title_ta",
        "attribution_status"
      ],
      "properties": {
        "song_file": {"type": "string", "minLength": 1},
        "tamil_status": {"const": "verified"},
        "pdf_pages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "tamil_title": {"type": "string", "minLength": 1},
        "film_title_ta": {"type": "string", "minLength": 1},
        "attribution_status": {
          "enum": ["anthology-attributed", "primary-source-verified", "review", "unresolved"]
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": ["english_title", "sections", "translator_notes"],
      "properties": {
        "english_title": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ordinal", "source_label", "english_label", "source_tamil_lines", "english_lines", "notes"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "source_label": {"type": ["string", "null"]},
              "english_label": {"type": ["string", "null"]},
              "source_tamil_lines": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "english_lines": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "notes": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          }
        },
        "translator_notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
