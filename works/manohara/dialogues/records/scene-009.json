{"work_id":"manohara","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-009.md","record_count":36,"records":[{"id":"manohara-s009-d001","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வசந்தி","speaker_delimiter":":","text":"எங்கே...நாடகக் கும்பல்?","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d002","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வீரன்","speaker_delimiter":":","text":"விரட்டிக் கொண்டே போனோம். தப்பிவிட்டார்கள்......","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d003","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"தைரியசாலிகள்! வெட்கமில்ல. சீ ஓடுங்கள்......","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d004","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"தோழி","speaker_delimiter":":","text":"ஏம்மா...நாடகக்காரர்கள்;","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d005","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"ஆம்?......பரிசு கொடுக்க!.....","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d006","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"தோழி","speaker_delimiter":":","text":"கொடுக்க வேண்டியதுதாம்மா...நம்மை காட்டி கொடுக்கிற கதையா இருந்தாலும் நடிப்பு நல்லா இருந்தது!","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d007","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"சீ...என்னடி விமர்சனம்...போடி! உம்!","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d008","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"ப்ரபூ!","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d009","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"வழக்கமான புன்சிரிப்பு இல்லே...வாட்டத்தோடு இருக்கிறீர்கள்...என்ன காரணம், ஸ்வாமி?......","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d010","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"ஒன்றுமில்ல...","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d011","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"பிறகேன், கண்ணே என்ற கனிமொழி உதிரவில்லே? கண்களிலே கலக்கம்...கண்ணாளா! பால்!...","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d012","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"பாலா?...","page_provenance":[{"pdf_page":19,"printed_page":18}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d013","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"ஏன், ஓஹோ! நாடகம் நினைவுக்கு வந்துவிட்டதோ...","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d014","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"அதெல்லாமில்ல...","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d015","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"பெருமூச்சால் பேசுவானேன் என்னையே கேளுங்கள் என் கணவர் கேசரி வர்மன்...நம் காதலை காண சகிக்காமல் ஊரைவிட்டு ஓடிவிட்டார் என்று தங்களிடம் சொல்லியிருந்தேன்...","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d016","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"ஆமாம்! இப்போது???","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d017","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"நஞ்சு கொடுத்துத் தன் கணவனைக் கொல்லுகிறாள் நாடக தேவசேனா! தாங்களும் அதை உண்மையென்று நம்பி......","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d018","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"வேண்டாம்...நீயே கொடு...","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d019","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"இல்லே தாங்கள் விரும்புவதை எடுத்துக் கொள்ளுங்கள். சந்தேகம் ஒரு சங்கடமான நோய். காதல் வாழ்வை துண்டாக்கும் கட்டாரி...அது வீரனையும் கோழையாக்கும்...உம், எடுத்துக் கொள்ளுங்கள்... (பிறகு யோசித்து)... அதுகூடவேண்டாம்... நானே இரண்டையும் சாப்பிடுகிறேன்.","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d020","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வசந்தி","speaker_delimiter":":","text":"என்னை மன்னித்துவிடுங்கள் மகாராஜா? பதின்மூன்று ஆண்டுகளாக தங்கள் பத்தினியாக வாழ்ந்தேன் - அதை வைத்துக் கேட்கிறேன். ஆபரணம் - ஆடம்பரவாழ்வு - அரச போகம் - போதும்... தாருங்கள் தயவு செய்து...காஷாய உடை! கையிலே ஒரு ஓடு! மறுக்காதீர்கள். போக விடை கொடுங்கள்......","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d021","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"போவதா......நீயா?......எங்கே கண்ணே......","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d022","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"உலகம் மிகப் பெரியது. பிரபு! அதன் ஜனக் கூட்டத்திலே நானும் ஒரு துளியாக விடுகிறேன் - தங்கள் பெயரை ஜபித்துக்கொண்டு என் ஜன்மத்தை கழித்துவிடுகிறேன்.","page_provenance":[{"pdf_page":20,"printed_page":19}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d023","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"உங்கள் காலடியில் கிடக்கும் என் இன்ப வாழ்வுக்கு தீ மூட்டத் திட்டம் போட்டு விட்டார்கள்!","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d024","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"திட்டம்? யார்?","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d025","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"மகாராணி தான்!","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d026","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"யார்... பத்மாவதியா?......","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d027","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"கேசரியின் குரல்","speaker_delimiter":":","text":"இல்லே...பச்சைப் புளுகு?...பாராளும் வேந்தே...பாகு மொழியில் பலியாகாதே!","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d028","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"வச","speaker_delimiter":":","text":"பாருங்கள் ஸ்வாமி பாருங்கள்...... நான் கேள்விப்பட்டது உண்மைதான்...... மகாராணி மந்திராலோசனை வேறு நடத்துகிறார்களாம்...... உங்களிடமிருந்து என்னைப் பிரிக்க......","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d029","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"அர","speaker_delimiter":":","text":"கவனிக்க வேண்டியதுதான்! (காவலரிடம்) யார் இங்கு பேசியது என்று தேடிப் பாருங்கள்.","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d030","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"புரையோடி விட்ட புண்ணுக்கு புனுகுப்பூச்சு பொல்லாங்குக்காரியின் போலி வேடத்தைப் பொசுக்க பொறுமை......... போதுமம்மா பொறுத்ததெல்லாம், உத்திரவு கொடுங்கள். உருத் தெரியாமல் ஆக்குகிறேன் அந்த ஊர் கெடுப்பவளை!","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d031","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"பத்மா","speaker_delimiter":":","text":"மனோகரா! இரு......","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d032","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"மனோ","speaker_delimiter":":","text":"அம்மா! (வாள் வீச்சு) வேஷக்காரி வசந்தா தொலைந்தாள்!","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d033","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"பத","speaker_delimiter":":","text":"பொறு செல்வா...\nஅதைவிட ஒரு புனிதமான காரியத்தில் உன்னை ஈடுபடச் சொல்கிறேன்.","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d034","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"மனோ","speaker_delimiter":":","text":"என்னம்மா அது?","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d035","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"பத்மா","speaker_delimiter":":","text":"இந்த வாள் ஏது தெரியுமா?......","page_provenance":[{"pdf_page":21,"printed_page":20}],"source_scene_file":"scene-009.md"},{"id":"manohara-s009-d036","scene_id":"manohara-s009","scene_ordinal":9,"transition_audit_id":"T009","speaker_label":"மனோ","speaker_delimiter":":","text":"நாடகத்தில் கூட இதுமாதிரி ஒரு வாள்...ஆமாம் பார்த்தேன்......","page_provenance":[{"pdf_page":22,"printed_page":21}],"source_scene_file":"scene-009.md"}]}
