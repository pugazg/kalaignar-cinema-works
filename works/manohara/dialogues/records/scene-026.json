{"work_id":"manohara","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-026.md","record_count":10,"records":[{"id":"manohara-s026-d001","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","speaker_label":"பிரதானி1","speaker_delimiter":":","text":"வசந்தசேனைக்கு ராஜ விருதுகளா? மன்னர் மயங்கித்தான் விட்டார்,","page_provenance":[{"pdf_page":38,"printed_page":37}],"source_scene_file":"scene-026.md"},{"id":"manohara-s026-d002","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","speaker_label":"பிரதானி2","speaker_delimiter":",","text":"மயக்கத்தால், இந்த மறவர் பூமியின் மானத்தையே வாங்கிவிட்டார்!","page_provenance":[{"pdf_page":38,"printed_page":37}],"source_scene_file":"scene-026.md"},{"id":"manohara-s026-d003","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","speaker_label":"பிரதானி3","speaker_delimiter":":","text":"அவமானச் சின்னம்—அவளோடு அரசர்... அதுவும் அவைக்களத்தில்","page_provenance":[{"pdf_page":38,"printed_page":37}],"source_scene_file":"scene-026.md"},{"id":"manohara-s026-d004","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","speaker_label":"பிரதானி4","speaker_delimiter":":","text":"சத்திய சீலரே...என்ன இது?","page_provenance":[{"pdf_page":38,"printed_page":37}],"source_scene_file":"scene-026.md"},{"id":"manohara-s026-d005","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","speaker_label":"சத்தியசீலர்","speaker_delimiter":":","text":"விண்மீன் இருக்க வேண்டிய இடத்தில் மின்மினி......","page_provenance":[{"pdf_page":38,"printed_page":37}],"source_scene_file":"scene-026.md"},{"id":"manohara-s026-d006","scene_id":"manohara-s026","scene_ordinal":26,"transition_audit_id":"T026","speaker_label":"ராஜப்பிரியன்","speaker_delimiter":":","text":"மனோகரா! தாயின் கட்டளை!","page_provenance":[{"pdf_page":38,"printed_page":37}],"source_scene_file":"scene-026.md"},{"i