{"work_id":"manohara","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-028.md","record_count":10,"records":[{"id":"manohara-s028-d001","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வைத்தியன்","speaker_delimiter":":","text":"உம்... சாப்பிடணும்......","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d002","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"ஏய்—வைத்தியா! இந்த மருந்துக்குப் பெயர் என்ன?","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d003","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வைத்தியன்","speaker_delimiter":":","text":"சுயபுத்தி சூரணம்......","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d004","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"இது எதிலே தயாரிக்கப்பட்டது—","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d005","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வைத்தியன்","speaker_delimiter":":","text":"திராட்சை, தேன், கற்கண்டு, சக்கரை இவைகளால் தயாரிக்கப்பட்டது.","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d006","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"அப்ப கசக்குமோ...","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d007","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வைத்","speaker_delimiter":":","text":"“ஊஹூம்...கொஞ்சம் புளிக்கும், என்னு ரெண்டு? மிளகாயும் சேர்த்திருக்கேன்.","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d008","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வச","speaker_delimiter":":","text":"வைத்தியா!...எனக்கு என்ன வியாதிடா—","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d009","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வைத்","speaker_delimiter":":","text":"தீராத வியாதி...","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-028.md"},{"id":"manohara-s028-d010","scene_id":"manohara-s028","scene_ordinal":28,"transition_audit_id":"T028","speaker_label":"வசந்","speaker_delimiter":":","text":"உம்—அதானே பாத்தேன்—எல்லாரும் பைத்தியம் பைத்தியங்கிறாங்களே—\nவிகடா! கேட்டியா—எனக்கு பைத்தியம் ஒண்ணும் கிடையாது! தீராத வியாதி!","page_provenance":[{"pdf_page":40,"printed_page":39}],"source_scene_file":"scene-028.md"}]}