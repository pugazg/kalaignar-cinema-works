{"work_id":"manohara","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-050.md","record_count":27,"records":[{"id":"manohara-s050-d001","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"வசந்தசேனை","speaker_delimiter":":","text":"நாளை ஆகவேண்டிய காரியத்தை ஆலோசிப்போம்.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d002","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"உக்ரசேனன்","speaker_delimiter":":","text":"இனியும் என்ன ஆகவேண்டியது?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d003","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"சேனா","speaker_delimiter":":","text":"நாளை வசந்தனின் பட்டாபிஷேகம்.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d004","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"உக்","speaker_delimiter":":","text":"நிச்சயமாக ஆனால் அதற்குள் நாடு நம் வசமானதை அறிவிக்க வேண்டும்.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d005","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"சேனா","speaker_delimiter":":","text":"அறிவிப்பதால் எதாவது ஆபத்து?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d006","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"உக்","speaker_delimiter":":","text":"ஆபத்து!... யாரால்? என்னை எதிர்க்கக் கூடியவர்கள் இந்த உலகத்தில் இருக்கிறார்களா?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d007","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"சேனா","speaker_delimiter":":","text":"உற்சாக வெள்ளத்தில் உயிரோடு இருக்கும் மனோகரனை! மறந்துவிடக் கூடாது.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d008","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"அம்மா","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d009","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"பத்மாவதி","speaker_delimiter":":","text":"நீ யார்!","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d010","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"மனோகரன்...என்னை அனுப்பினான்!","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d011","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"பத்","speaker_delimiter":":","text":"மனோகரன்...என் கண்மணி சுகமாக இருக்கிறானா?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d012","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"விஜயா","speaker_delimiter":":","text":"அத்தே! அவர் எங்கிருக்கிறாராம்?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d013","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"சதா உங்கள் இருதயத்திலே இருக்கும் அவர் வேறு எங்கு இருப்பார்.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d014","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"பத்","speaker_delimiter":":","text":"யாரப்பா நீ?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d015","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"அதைப் பிறகு சொல்லுகிறேன். இப்போது நீங்கள் இருவரும் இதை விட்டு தப்பிவிடவேண்டும்.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d016","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"பத்","speaker_delimiter":":","text":"என்ன?","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d017","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"ஆமாம்! மனோகரனின் ரகசிய ஏற்பாடு. இதோ முத்திரை மோதிரம் பயமின்றி யாருடைய தடையுமின்றி வெளியேறலாம். புறப்படுங்கள்","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d018","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"பத்","speaker_delimiter":",","text":"தந்திரமாக தப்பிவிடுவது—கூடாது, முடியாது. மகாராஜாவின் உத்திரவை மீற முடியாது. மனோகரனிடம் சொல்லிவிடு.","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d019","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"விஜ","speaker_delimiter":":","text":"அத்தே!","page_provenance":[{"pdf_page":77,"printed_page":76}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d020","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"இந்தப் பேரனுக்கு வரும் பேராபத்தை நீக்கத்தான் நீங்கள் வெளியேற வேண்டும் என்கிறேன்.","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d021","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"பத்","speaker_delimiter":":","text":"அரசன் கட்டளையை... அரசியே மீறுவதா? முறையல்ல.","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d022","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"அப்படியானால்... ராஜகுமாரி! அந்த குழந்தையையாவது கொடுங்கள் நான் கொண்டுபோய்விடுகிறேன்.","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d023","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"விஜ","speaker_delimiter":":","text":"ஆ! குழந்தையா?","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d024","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"குழந்தையின் உயிரைக் காப்பாற்ற வேண்டுமானால்......?","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d025","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"விஜ","speaker_delimiter":":","text":"அத்தே இவனை நம்பாதீர்கள்...... குழந்தையைக் கொல்லுவதற்கு ஏதோ சூழ்ச்சி நடக்கிறது.","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d026","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"மனோ","speaker_delimiter":":","text":"இல்ல! இல்ல!......","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"},{"id":"manohara-s050-d027","scene_id":"manohara-s050","scene_ordinal":50,"transition_audit_id":"T050","speaker_label":"விஜ","speaker_delimiter":":","text":"முடியாது... முடியாது... நீ போய்விடு.","page_provenance":[{"pdf_page":78,"printed_page":77}],"source_scene_file":"scene-050.md"}]}