{"work_id":"manohara","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-016.md","record_count":12,"records":[{"id":"manohara-s016-d001","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"விஜயா! தற்கொலை கோழைத்தனம்!","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d002","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"விஜயா","speaker_delimiter":":","text":"இருட்டு வேளையில் பெண்களின் அந்தப்புரத்தில் நுழைவது அதைவிட கோழைத்தனம்...","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d003","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"பரவாயில்ல. மரணப் புயலிலிருந்து ஒரு மலர்க் கொடியைக் காப்பாற்றி யிருக்கிறேன்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d004","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"விஜயா","speaker_delimiter":":","text":"இந்த அடிமையின் சாவை யாரும் தடுக்க வேண்டாம்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d005","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"அடிமையார் அடிமை? அழகே உருவான ராஜகுமாரி நீ...","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d006","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"ராஜ","speaker_delimiter":":","text":"அதனால் தான் சொல்லுகிறேன் அர்த்தராத்திரியில் அந்தப்புரத்தில் பிரவேசிக்கக் கூடாதென்று!","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d007","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"மனோ","speaker_delimiter":":","text":"ராஜப்பிரியா! தெரியுமா சேதி?","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d008","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"ராஜ","speaker_delimiter":":","text":"தெரிந்துதானே வந்தேன் உன் சேதி! மனோகரா! எச்சரிக்கையாய் இருக்க வேண்டிய நேரம். ஏமாந்து விடாதே! இளவரசி கொஞ்ச நேரத்துக்கு முன் உன்னைக் கொல்லவந்த எமன்!","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d009","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"விஜ","speaker_delimiter":":","text":"இருதயம் எனக்கும் இருக்கிறது. நல்ல இருதயம் படைத்தவர்கள் ஒரு முறைதான் தவறு செய்வார்கள்","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d010","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"மனோ","speaker_delimiter":":","text":"விஜயா! நீ வாழ வேண்டியவள். அதுமட்டுமல்ல என் பாதுகாப்பில் இருக்கிறாய்... இதுபோன்ற விபரீத செயல்களை என்னால் அனுமதிக்க முடியாது.","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d011","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"விஜ","speaker_delimiter":":","text":"உயிர் உங்கள் அடிமையல்ல. அது ஆண்டவன் தந்தது.","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"},{"id":"manohara-s016-d012","scene_id":"manohara-s016","scene_ordinal":16,"transition_audit_id":"T016","speaker_label":"மனோ","speaker_delimiter":":","text":"அதைப்பற்றிய விளக்கம் நாளை விசாரணை மண்டபத்தில்.","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-016.md"}]}