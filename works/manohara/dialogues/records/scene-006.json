{"work_id":"manohara","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-006.md","record_count":18,"records":[{"id":"manohara-s006-d001","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"தோழி","speaker_delimiter":":","text":"என்னம்மா... தினம் தினம் எதை மறந்தாலும் இதை மறப்பதில்லை நீங்கள்? அப்படியென்ன இந்தப் பதக்கத்தில் கண்ணை இழுக்கும் காந்தம் இருக்கிறது?","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d002","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வச","speaker_delimiter":":","text":"காந்தமில்லையடி! ஆபத்தில் கை கொடுக்கும் கடவுள்!","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d003","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"தோ","speaker_delimiter":":","text":"கடவுளா?","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d004","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வச","speaker_delimiter":":","text":"பாரேன்... (படத்தை காட்டுகிறாள்)","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d005","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"தோ","speaker_delimiter":":","text":"அம்மா, மகாராஜா! வருகிறார்.","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d006","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"புருஷோத்தமன்","speaker_delimiter":":","text":"இன்னுமா முடியவில்லை, அலங்காரம்? நேரமாகிவிட்டதே நாடகத்துக்கு...","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d007","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்","speaker_delimiter":":","text":"இதோ முடிந்துவிட்டது.","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d008","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"புரு","speaker_delimiter":":","text":"மறந்துவிட்டாயா, இன்று மனோகரன் பிறந்தநாள்.","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d009","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்","speaker_delimiter":":","text":"மறப்பேனா, செல்வன் பிறந்த நாள்; எனக்கு வேறு ஒரு நினைவு வந்தது...","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d010","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"புருஷோத்","speaker_delimiter":":","text":"எது? வசந்தி!","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d011","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்","speaker_delimiter":":","text":"நமதுகாதல் விழாவின் பதின்மூன்றாவது ஆண்டு.","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d012","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"புருஷோத்","speaker_delimiter":":","text":"ஆமாம் கண்ணே... வருடங்கள் ஓடியதே தெரியவில்லை.","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d013","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"நெருப்பைத் தொடாதீங்க! சுட்டுவிடும் தேகம்! கொஞ்சம் கொட்டிவிடும் - இதிலெல்லாம் எனக்கு சந்தேகமில்லே...சந்தேகமில்லே.... எப்படியம்மா இன்னிக்கு புதுப்பாடம்? எம்மா!... அடே... அப்பா! அம்மா அழகைப் பாருப்பா... எனக்கும் அம்மாவைப்போல ஒரு பெண்ணு கிடைச்சா...","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d014","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்","speaker_delimiter":":","text":"சீ... பேசாமலிரு!","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d015","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"பிள்ளையாரு மாத்திரம் கேட்டாரா, அவுங்க அம்மா பார்வதியைப் போல பெண்ணு! நான் கேட்டா என்னப்பா...","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d016","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"புருஷோத்","speaker_delimiter":":","text":"தீரவே தீராது இது!","page_provenance":[{"pdf_page":11,"printed_page":10}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d017","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"சந்தேகமில்லை.","page_provenance":[{"pdf_page":12,"printed_page":11}],"source_scene_file":"scene-006.md"},{"id":"manohara-s006-d018","scene_id":"manohara-s006","scene_ordinal":6,"transition_audit_id":"T006","speaker_label":"புருஷோத்","speaker_delimiter":":","text":"வசந்தி, நான் போகிறேன்... சீக்கிரம் புறப்படு...","page_provenance":[{"pdf_page":12,"printed_page":11}],"source_scene_file":"scene-006.md"}]}
