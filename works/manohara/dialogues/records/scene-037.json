{"work_id":"manohara","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-037.md","record_count":17,"records":[{"id":"manohara-s037-d001","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"காவலாளி","speaker_delimiter":":","text":"மகாராஜா! இளவரசர் தப்பிவிட்டார்.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d002","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"அரசர்","speaker_delimiter":":","text":"என்ன?","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d003","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"வ. சே","speaker_delimiter":":","text":"ஆ! மனோகரன் தப்பிவிட்டானா?","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d004","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"காவலாளி","speaker_delimiter":":","text":"ஆமாங்க... யாரோ கட்டுகளை அவுத்து காப்பாற்றினார்கள், கண்ணுக்கே தெரியவில்லை.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d005","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"வ. சே","speaker_delimiter":":","text":"விபரீதம்வளர ஆரம்பித்துவிட்டது பிரபு! நகர் முழுவதும் சோதனை போடுங்கள், அந்த நாசகாரன் எங்கிருந்தாலும் பிடித்து வாருங்கள்.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d006","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"அரசர்","speaker_delimiter":":","text":"உம்...போங்கள்.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d007","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"முடியாதும்மா... முடியாது... (சுற்றிலும் பார்த்தபடி) என்ன இது... கொல்லப்பட்ட நான் உயிரோடு...","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d008","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"கேசரிவர்மன்","speaker_delimiter":":","text":"இளவரசே!","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d009","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"மனோ","speaker_delimiter":":","text":"யார் நீ... நீ யார்... சத்யசீலரே! யார் இவன்?","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d010","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"சத்யசீலர்","speaker_delimiter":":","text":"விபரம் பிறகு சொல்கிறேன்... அவன் தான் உன்னைக் காப்பாற்றியவன்.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d011","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"மனோ","speaker_delimiter":":","text":"என்னைக் காப்பாற்றுவது...... மனோகரனைக் காப்பாற்றுவது... மன்னன் ஆசை... மாதாவின் அன்புக் கட்டளை.... இவைகளை உடன் நிறைவேற்றுங்கள்... கொல்லுங்கள்... என்னைக் கொல்லுங்கள்... கொல்லுங்கள் ராஜப்பிரியா! என் அன்புத் தோழா... என் அன்னையின் கட்டளையை நீயாவது நிறைவேற்று.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d012","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"சத்ய","speaker_delimiter":":","text":"பொறு மனோகரா!","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d013","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"ராஜப்","speaker_delimiter":":","text":"மனோகரா... தாய்ச்சொல் தவறக் கூடாது என்பதற்காக சிறை வாசத்திலிருக்கும் தாயை அனாதையாகச் சாகவிடுவதா?","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d014","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"மனோ","speaker_delimiter":":","text":"ஆ! அம்மா சிறையில்...","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d015","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"ராஜப்","speaker_delimiter":":","text":"அம்மா மட்டுமல்ல... விஜயா கூட...","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d016","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"மனோ","speaker_delimiter":":","text":"ஆ...","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"},{"id":"manohara-s037-d017","scene_id":"manohara-s037","scene_ordinal":37,"transition_audit_id":"T037","speaker_label":"ராஜப்","speaker_delimiter":":","text":"இப்போதாவது தெரிந்துகொள்...... நீ வாழ வேண்டிய அவசியத்தை.","page_provenance":[{"pdf_page":58,"printed_page":57}],"source_scene_file":"scene-037.md"}]}