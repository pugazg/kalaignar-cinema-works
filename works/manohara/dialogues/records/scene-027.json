{"work_id":"manohara","scene_id":"manohara-s027","scene_ordinal":27,"transition_audit_id":"T027","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-027.md","record_count":4,"records":[{"id":"manohara-s027-d001","scene_id":"manohara-s027","scene_ordinal":27,"transition_audit_id":"T027","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"அம்மா!","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-027.md"},{"id":"manohara-s027-d002","scene_id":"manohara-s027","scene_ordinal":27,"transition_audit_id":"T027","speaker_label":"பத்மாவதி","speaker_delimiter":":","text":"மனோகரா!...என்ன நடந்தது?","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-027.md"},{"id":"manohara-s027-d003","scene_id":"manohara-s027","scene_ordinal":27,"transition_audit_id":"T027","speaker_label":"மனோ","speaker_delimiter":":","text":"என்ன நடக்க வேண்டுமென்று எண்ணி என் கைகளைக் கட்டிப் போட்டீர்களோ அது நடந்தது. அம்மா! இப்படி பயங்கரமாகக் கட்டளை இடுவீர்கள் என்று முன்பே தெரிந்திருந்தால் முத்து விஜயனைக் கொன்று—படை வீரர் பலரின் உயிரைத் தந்து—அந்தப் பாதகி அமர்வதற்கு சிம்மாசனத்தைக் கொண்டுவந்திருக்க மாட்டேன். நீங்கள் அமர வேண்டிய சிம்மாசனத்தில் அவளா? அதற்காக ஒரு படையெடுப்பா?","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-027.md"},{"id":"manohara-s027-d004","scene_id":"manohara-s027","scene_ordinal":27,"transition_audit_id":"T027","speaker_label":"பத்மாவதி","speaker_delimiter":":","text":"படையெடுப்பால் வந்த பயன்தானே இந்தப் பைங்கிளி (விஜயாவைக் காட்டுகிறாள்) இதை நினைத்து அதை மறந்துவிடு மனோகரா!","page_provenance":[{"pdf_page":39,"printed_page":38}],"source_scene_file":"scene-027.md"}]}