{"work_id":"manohara","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-044.md","record_count":18,"records":[{"id":"manohara-s044-d001","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"யாரது ஓ... ராணி வசந்தா தேவியா?","page_provenance":[{"pdf_page":69,"printed_page":68}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d002","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"வசந்","speaker_delimiter":":","text":"ஸ்வாமிகளுக்கு ஆண்டவன் நினைவோ?","page_provenance":[{"pdf_page":69,"printed_page":68}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d003","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"ஆண்டவனைப்பற்றியல்ல. ஆண்டு கொண்டிருப்பவனைப்பற்றி... உட்கார். உல்லாசி.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d004","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"வ. சே.","speaker_delimiter":":","text":"பழரசம் அருந்துங்களேன்.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d005","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"முதலில் உன் பார்வை ரசம் அருந்துகிறேன் கண்ணே!","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d006","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"உங்களைப்பார்த்து எவ்வளவு நாட்களாகின்றன.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d007","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"தோழி","speaker_delimiter":":","text":"கூப்பிட்டீர்களா அம்மா.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d008","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"இல்லை போடி.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d009","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"(கூந்தலைக் கோதியபடி) ஆகா! முகில் கூட்டம். (பல்லைக்காட்டி) முல்லைத் தோட்டம். (கன்னத்தைத் தடவி) ரோஜாக் கொல்லை!","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d010","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"ஸ்வாமி!","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d011","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"மொத்தத்தில் இன்பத்தின் எல்லை!","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d012","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"ஆமாம்... திட்டங்கள் எல்லாம் எப்படி திட்டியிருக்கிறீர்கள்?","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d013","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"திவ்யமாக! அரண்மனையின் முக்கிய பகுதிகள் எல்லாம் நமது ஆண்டி வேடந்தரித்த வீரர்கள் ஆக்ரமித்துக்கொண்டிருக்கிறார்கள், நாம் ஆணையிட்டால் போதும், போர்! புருஷோத்தமன் கைது!","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d014","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"போர்கூட தேவைப்படாது. புருஷோத்தமனின் படை வீரர்களை என் கைக்குள் போட்டு வைத்திருக்கிறேன்.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d015","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"சபாஷ்! போர் வந்தால்தான் என்ன? எதிரிப் படைகள் அரண்மனைக்குள் வந்த பிறகு யாரால்தான் எதிர்த்து ஜெயிக்க முடியும்?","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d016","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"எதிரிப் படை அரண்மனைக்குள் மட்டுமா வந்திருக்கிறது?","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d017","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"உக்","speaker_delimiter":":","text":"அந்தப்புரத்திற்கே வந்துவிட்டது என்கிறாயா? இது சண்டையிட அல்ல. சரணாகதி அடைய.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"},{"id":"manohara-s044-d018","scene_id":"manohara-s044","scene_ordinal":44,"transition_audit_id":"T044","speaker_label":"சேனா","speaker_delimiter":":","text":"இரவு வருகிறேன்.","page_provenance":[{"pdf_page":70,"printed_page":69}],"source_scene_file":"scene-044.md"}]}