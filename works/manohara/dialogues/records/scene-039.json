{"work_id":"manohara","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-039.md","record_count":37,"records":[{"id":"manohara-s039-d001","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வசந்தி","speaker_delimiter":":","text":"வந்துவிட்டீர்களா ஸ்வாமி, நான் சோலைப் பாறையில் காத்துக் கிடந்தேன்—தாங்கள் மாளிகை வழியே வந்திருக்கிறீர்கள்.","page_provenance":[{"pdf_page":61,"printed_page":60}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d002","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"வழி, எதுவானால் என்ன... உன் மொழியிலே, தேன் விழியிலே ஒளி மாறிவிடுகிறதா வசந்தி!","page_provenance":[{"pdf_page":61,"printed_page":60}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d003","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"எப்படி மாறும்—இந்திரனுக்காகப் படைக்கப்பட்ட அகல்யா—சந்திரனுக்காகப் படைக்கப்பட்ட தாரை—புருஷோத்தமருக்காகப் படைக்கப்பட்ட வசந்தா—","page_provenance":[{"pdf_page":61,"printed_page":60}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d004","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"வசந்தி! கண்ணே... உன்னோடு என்ன பேசுவதென்றே தெரியவில்லை—","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d005","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"ஊமையாகவே இருங்கள்—அந்த ஒய்யாரத்தை நான் ரசிக்கிறேன்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d006","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"இப்போது... நீ எது கேட்டாலும் கொடுப்பேன்—","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d007","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"வந்தது ஆபத்து!... நான் கேட்பதாக நினைத்ததைக் கூட இப்போது கேட்கப் போவதில்ல...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d008","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"ஏன் வசந்தி!...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d009","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"சமயம் பார்த்து கேட்கிறாள் சாகசக்காரி என்பீர்கள் நானென்ன தசரதனை ஏமாற்றிய கைகேயியா?... வேண்டாம்... வேண்டாம்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d010","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"என்ன வசந்தி, கேள்!...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d011","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"வேண்டாம்... ஹூம்!...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d012","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"சரி... நான் போகிறேன்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d013","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"அய்யோ!... என் உயிர் போய்விடும்—உட்காருங்கள்","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d014","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"பிறகு... சொல்லேன்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d015","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"மனோகரன் நாட்டை விட்டுப் போய் விட்டான்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d016","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"அதையேன் கிளறுகிறாய்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d017","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"இல்ல...இளவரசன் இல்லாத நாடு... எழிலில்லாத ஓவியம் போலத்தானே!...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d018","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"அதற்கென்ன செய்வது...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d019","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"ஏன், நம் வசந்தனை இளவரசனாக்கிவிட்டால்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d020","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"பைத்தியம்! வசந்தனைவிட நீ பெரிய பைத்தியம்!...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d021","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"ஸ்வாமி...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d022","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"அவனை இளவரசனாக்கக் கூடாது!... பைத்தியக்காரனுக்குத் தீர்க்கதரிசியாக பட்டம் கட்ட வேண்டும்—அவனுக்கு முடி சூட்டினால்.... முதலில் நீ பைத்தியம்—பிறகு நான் பைத்தியம்—அப்புறம் இந்த நாடே பைத்தியம்...","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d023","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"போதும்... போதும்!... வர்ணிக்காதீர்கள்—வசந்த ராஜனுக்கு இதுவும் வேண்டும் இன்னமும் வேண்டும் உன்னை... அறிவாளி என்று நினைத்தேன்... [கோபமாக] நீ ஒரு ஞான சூன்யம்!","page_provenance":[{"pdf_page":62,"printed_page":61}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d024","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"(தந்திரமாக) முட்டாள் என்று மூவாயிரம் முறை சொல்லுங்கள்—சந்தோஷம்!... ஆனால்... உங்கள் வசந்தி வஞ்சகி என்று மாத்திரம் நினைக்காதீர்கள்... ஸ்வாமி!... ஒரு யோசனைதான் உங்களைக் கேட்டேன்— என் மகன்மட்டு மல்லவே அவன்—தங்கள் மகனுந் தான்—தங்களை விட எனக்கென்ன ஆசை வந்து கிடக்கிறது! என் லட்சியம் தங்கள் சுகம்... சுயநலமல்ல...","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d025","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"எனக்குத் தெரியாதா கண்ணே! ஆனால் வசந்தன்!","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d026","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"அந்த பேச்சு வேண்டாம்—விபரீதப் பேச்சு!... பைத்தியத்துக்கு பட்டம் சூட்டினால்... என்ன ஆகுமென்று எனக்கும் தெரியும்... உங்களை கிண்டல் செய்தேன். நீங்கள் அதற்குள்.... ஹூம்!","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d027","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அர","speaker_delimiter":":","text":"வசந்தி!...","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d028","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"ப்ரபூ!...நிலாமுற்றம் தேடுகிறது—வாருங்கள்...","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d029","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வசந்தசேனை மனதிற்குள்","speaker_delimiter":":","text":"“இனி புருஷோத்தமனை நம்பி புண்யமில்லை—புதிய திட்டம் போடவேண்டும். நன்றி கெட்ட இந்த ராஜனை நாடு கடத்த வேண்டும்... மனோகரனைக் கொல்ல வேண்டும்... வசந்தனுக்கு பட்டம் கட்ட வேண்டும். இதற்கெல்லாம் உதவி செய்யக் கூடியவன் என் பழைய காதலன் உக்ரசேனன் தான்”","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d030","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வ. சே","speaker_delimiter":":","text":"யாரங்கே! ஒரு கொடியவன் உள்ளே ஒளிந்திருக்கிறான். விடாதீர்கள் அவனை!","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d031","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"நீ பிசாசா? கடவுளா?","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d032","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அரூபம்","speaker_delimiter":":","text":"இல்லை வசந்தா... நான் மனிதன்.","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d033","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"மனுஷனா? என் கண்ணுக்கு தெரியலையே.","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d034","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அரூ","speaker_delimiter":":","text":"தெரியமாட்டேன்! என் அய்யன் குருநாதன் அருள் அறிவின் விளைவு. ஒரு மருந்தின் வேலை,","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d035","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"வச","speaker_delimiter":":","text":"அந்த மருந்தை எனக்கு கொஞ்சம் தர்ரியா?","page_provenance":[{"pdf_page":63,"printed_page":62}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d036","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அரூ","speaker_delimiter":":","text":"தருகிறேன்! ஆனால் நீ நான் சொல்றபடி கேட்க வேண்டும்.","page_provenance":[{"pdf_page":64,"printed_page":63}],"source_scene_file":"scene-039.md"},{"id":"manohara-s039-d037","scene_id":"manohara-s039","scene_ordinal":39,"transition_audit_id":"T039","speaker_label":"அரூ","speaker_delimiter":":","text":"முதலில் ஒரு சிப்பாயை வரச் சொல்...","page_provenance":[{"pdf_page":64,"printed_page":63}],"source_scene_file":"scene-039.md"}]}