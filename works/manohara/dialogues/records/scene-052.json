{"work_id":"manohara","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-052.md","record_count":19,"records":[{"id":"manohara-s052-d001","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"மனோ","speaker_delimiter":":","text":"எங்கே! அந்தக் குழந்தையைக் கொஞ்சம் கொடுங்கள்!","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d002","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"விஜயா","speaker_delimiter":":","text":"அத்தே... நீ போகிறாயா? இல்லையா? சூழ்ச்சிக்காரா?","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d003","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"மனோ","speaker_delimiter":":","text":"இல்லை விஜயா என்னைத் தெரியவில்லையா உனக்கு\n\n[தன் பொய்த்தாடியைக் கலைக்கிறான்.] விஜயா என்னைத் தெரியவில்லை. உனக்கு......","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d004","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"சேனா","speaker_delimiter":":","text":"பிடியுங்கள் இவனை; மனோகரா!... இந்த முறையும் நீ தப்ப முடியாது.","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d005","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"மனோ","speaker_delimiter":":","text":"பார்ப்போமடி அதை...","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d006","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"சேனா","speaker_delimiter":":","text":"ஆ!","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d007","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"பத்மாவதி","speaker_delimiter":":","text":"மனோகரா!...... (தடுக்கிறாள்)","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d008","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"மனோ","speaker_delimiter":":","text":"நாசமாகி விட்டது! எல்லாம் நாசமாகிவிட்டதம்மா!","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d009","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"சேனா","speaker_delimiter":":","text":"நாசமா?","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d010","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"விஜயா","speaker_delimiter":":","text":"அத்தே!... அத்தே!...","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d011","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"பத்","speaker_delimiter":":","text":"விஜயா!","page_provenance":[{"pdf_page":79,"printed_page":78}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d012","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"மனோ","speaker_delimiter":":","text":"அம்மா, அப்பா சிறையிலே பூட்டப்பட்டு விட்டார். உங்கள் ஆணையை மீறமுடியாத நான் இந்தப் பாதகியின்\nஉத்திரவுக்குப் பணிந்தேன். இந்தப் பாவியின் கரங்களால் பாதாள சிறையில் பூட்டினேன்.","page_provenance":[{"pdf_page":79,"printed_page":78},{"pdf_page":80,"printed_page":79}],"page_segments":[{"pdf_page":79,"printed_page":78,"text":"அம்மா, அப்பா சிறையிலே பூட்டப்பட்டு விட்டார். உங்கள் ஆணையை மீறமுடியாத நான் இந்தப் பாதகியின்"},{"pdf_page":80,"printed_page":79,"text":"உத்திரவுக்குப் பணிந்தேன். இந்தப் பாவியின் கரங்களால் பாதாள சிறையில் பூட்டினேன்."}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d013","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"சேனா","speaker_delimiter":":","text":"இழுத்துச் செல்லுங்கள்.","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d014","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"மனோ","speaker_delimiter":":","text":"அம்மா... உண்மையை உணர்ந்துகொண்ட தந்தை உங்களையும் என்னையும் காணத் துடிக்கிறார். இறந்து போன கொடுமைகளை எண்ணி எண்ணி கண்ணீர் வடிக்கிறார். கலங்கித் தவிக்கிறார்... கலங்கித் தவிக்கிறார் அம்மா...அம்மா...அம்மா...","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d015","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"பத்மாவதி","speaker_delimiter":":","text":"மகாராஜா உண்மையை உணர்ந்து கொண்டார்! என் மகுடபதி உண்மையை உணர்ந்து கொண்டார். உண்மையை உணர்ந்து கொண்டார்.","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d016","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"விஜயா","speaker_delimiter":":","text":"அத்தே!... என்ன அத்தே!","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d017","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"பத்","speaker_delimiter":":","text":"இருள் நீங்கிவிட்டது. இன்பம் உதயமாகிறது.","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d018","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"விஜ","speaker_delimiter":":","text":"இன்பம்...! நமக்கா?... இந்த நிலையிலா?","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"},{"id":"manohara-s052-d019","scene_id":"manohara-s052","scene_ordinal":52,"transition_audit_id":"T052","speaker_label":"பத்","speaker_delimiter":":","text":"மகாராஜா உணர்ந்துவிட்டார் என் மகுடபதி உண்மையை உணர்ந்துவிட்டார்.","page_provenance":[{"pdf_page":80,"printed_page":79}],"source_scene_file":"scene-052.md"}]}