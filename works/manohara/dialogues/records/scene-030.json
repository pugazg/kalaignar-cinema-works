{"work_id":"manohara","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-030.md","record_count":29,"records":[{"id":"manohara-s030-d001","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"விஜயா","speaker_delimiter":":","text":"இந்த அன்பு மாறவே மாறாதே...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d002","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"இது என்ன கேள்வி விஜயா!","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d003","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"விஜயா","speaker_delimiter":":","text":"இல்லை... நீங்களும் மாமாவைப் போல்...ஒரு வசந்த சேனையின் மயக்கத்தில் விழுந்து விட்டால்","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d004","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோ","speaker_delimiter":":","text":"வசந்த சேனா. அவள் பெயரையே என்னிடம் உச்சரிக்காதே!.........என் தாய் இருக்கவேண்டிய இடத்திலே அந்த நாய்.........தணலில் விழுந்த புழுவாக அவளைத் தவிக்கவிட்டு—என் தாயை கொலு மண்டபத்தில் அமர்த்தா விட்டால்...நான் மனோகரனல்ல.","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d005","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"விஜயா","speaker_delimiter":":","text":"ஆ!...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d006","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோ","speaker_delimiter":":","text":"என்ன?","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d007","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"காலை மிதிச்சுட்டியே அண்ணி!","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d008","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோ","speaker_delimiter":":","text":"ஏ, நீ இங்கேயா ஒளிந்து கொண்டிருந்தாய்,","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d009","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்","speaker_delimiter":":","text":"உம்...பொம்பளைங்க எல்லாம் தண்ணியாலையும், பூவாலையும், தண்ணிப் பூவாலையும், பூத்தண்ணியாலையும், பூத்தண்ணியாலையும் தண்ணிப் பூவாலையும் அடிச்சா நீங்களுந்தான் ஒளியுவீங்க!","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d010","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோ","speaker_delimiter":":","text":"(சிரிக்கிறான்...)தைரியசாலி...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d011","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்","speaker_delimiter":":","text":"சிரிங்க...சிரிங்க...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d012","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தி","speaker_delimiter":":","text":"வசந்தா!... வசந்தா!...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d013","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"நான் இங்கே இருக்கேம்மா...ஏம்மா...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d014","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"அம்மா!...அண்ணனும் அண்ணியும் என்னைப் பார்த்து சிரிக்கிறாங்க!...","page_provenance":[{"pdf_page":41,"printed_page":40}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d015","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தி","speaker_delimiter":":","text":"பாண்டியன் மகளை பாணிக்கிரகணம் செய்தது பற்றித்தான் ஊர் உன் அண்ணனைப் பார்த்து சிரிக்கிறது. தகப்பனைக் கொன்றவனுக்கு தாரமாய் வாய்த்ததைப் பற்றித்தான் உலகமே உன் அண்ணியைப் பார்த்து சிரிக்கிறது...\n[பல்லைக் கடித்து]......\nசிரிக்கிறார்களாம் சிரிப்பு...... எல்லாம் சிரித்துவிடுகிறேன்... வாடா நீ!...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d016","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தன்","speaker_delimiter":":","text":"அதெல்லாம் உன்னால் முடியாதம்மா!...உன்னை புழுமாதிரி தவிக்கவிடப் போவது அண்ணன் - ஜாக்கிரதை! இப்பத்தான் அண்ணிகிட்ட சொன்னது. என் அண்ணி!","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d017","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வசந்தி","speaker_delimiter":":","text":"உம்...வீராதி வீரர்களாலும் முடியாத காரியம் இந்த வேசி மகனால்தான் முடியப்போகிறது...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d018","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"ஆ! என்ன சொன்னாய்?\n[கட்டாரியை உருவுகிறான்]\nநஞ்சு கக்கிய அந்த நாவைத் துண்டாடுகிறேன் பார்!...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d019","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"அரசன்","speaker_delimiter":":","text":"மனோகரா! விடு","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d020","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"முடியாது நீர் உம் மனைவியின் மானத்தைக் காப்பாற்றாவிட்டாலும் நான் என் தாயாரின் மானத்தைக் காப்பாற்றியே தீருவேன்.","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d021","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"அரசன்","speaker_delimiter":":","text":"சொல்வதைக் கேள்...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d022","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"முடியாது......உமக்கு வல்லமையிருந்தால் அவளைக் காப்பாற்றும்...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d023","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"சத்யசீலர்","speaker_delimiter":":","text":"மனோகரா!...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d024","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"விஜயா","speaker_delimiter":":","text":"அத்தான்! அத்தைக்குச் சொன்ன வாக்குறுதி","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d025","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"சீ......","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d026","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"மனோகரன்","speaker_delimiter":":","text":"அம்மா!...","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d027","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"அரசன்","speaker_delimiter":":","text":"வசந்தி!...நீ வரம்பு மீறிவிட்டாய்.","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d028","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"வ. சே.","speaker_delimiter":":","text":"ஸ்வாமி...","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-030.md"},{"id":"manohara-s030-d029","scene_id":"manohara-s030","scene_ordinal":30,"transition_audit_id":"T030","speaker_label":"அரசன்","speaker_delimiter":":","text":"சீ...பேசாதே!","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-030.md"}]}