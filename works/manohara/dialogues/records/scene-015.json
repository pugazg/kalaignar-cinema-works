{"work_id":"manohara","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-015.md","record_count":21,"records":[{"id":"manohara-s015-d001","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"யாரடா நீ","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d002","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜயா","speaker_delimiter":":","text":"நீர் உண்டாக்கிய சுடுகாட்டிலே மறு உயிர் பெற்ற பேயுமல்ல, பிணமுமல்ல! உனது பார்வையில்\nதட்டுப்படாமல்போன பகைவர்களில் ஒருவன்—பாண்டிய நாட்டு வீரன்!","page_provenance":[{"pdf_page":28,"printed_page":27},{"pdf_page":29,"printed_page":28}],"page_segments":[{"pdf_page":28,"printed_page":27,"text":"நீர் உண்டாக்கிய சுடுகாட்டிலே மறு உயிர் பெற்ற பேயுமல்ல, பிணமுமல்ல! உனது பார்வையில்"},{"pdf_page":29,"printed_page":28,"text":"தட்டுப்படாமல்போன பகைவர்களில் ஒருவன்—பாண்டிய நாட்டு வீரன்!"}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d003","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"பாண்டிய நாட்டு வீரன்! உம்...பாதி ராத்திரியிலே பதுங்கிப் பாயும் பட்டாளப் பயிற்சிக்கு முத்து விஜயன் ஆட்சியிலே முதல் இடம் போலும், முதுகெலும்பில்லாதவனே. கையிலே வாளும், நெஞ்சிலே கோழைத்தனமும் கொண்டவர்களில் ஒருவன் மிச்சமா? ஓடிப்போ...உயிரைக் காப்பாற்றிக்கொள்...","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d004","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"ராஜப்பிரியன்","speaker_delimiter":":","text":"மனோகரா!...இவனை விடக்கூடாது...","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d005","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"போகட்டும் பாவம்...மன்னித்துவிட்டேன்","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d006","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜ","speaker_delimiter":":","text":"மன்னிப்பு கேட்கும் மரபல்ல...","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d007","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"மறைந்திருந்து தாக்கும் மரபு...மாவீரன்!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d008","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"ராஜ","speaker_delimiter":":","text":"தூங்குபவன் தலையைத் துண்டாடுபவர்களும் வீரர்கள்தான், பாண்டியநாட்டுப் பள்ளிக்கூடத்திலே! போடா போக்கற்ற கோழையே!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d009","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜ","speaker_delimiter":":","text":"கோழை...நானா கோழை! இதோ பார்...இப்பொழுதே நேராகவே பழிதீர்த்துக்கொள்கிறேன்....","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d010","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"ஆ! பெண்!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d011","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜ","speaker_delimiter":":","text":"உன் பகைவரின் பெண்... பழிவாங்க வந்தவள்...","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d012","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"ராஜ","speaker_delimiter":":","text":"இளவரசி!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d013","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"அற்புதமான காட்சி, வளையல் ஏந்தும் கைகளிலே வாள்!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d014","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜ","speaker_delimiter":":","text":"பேசாதீர்!... நீர் வீரனெனில் என்னை ஜெயித்த பிறகு பேசும்!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d015","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"வேல்விழி மாதர்களிடம் வீரர்கள் ஜெயித்தார்கள் என்பதற்கு சரித்திரமே கிடையாது, இளவரசி!","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d016","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜ","speaker_delimiter":":","text":"கேலி தேவையில்ல...எடும் வாளை,","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d017","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"என் வாள் களத்திலேதான் விளையாடும்... கனிகளைக் காயப்படுத்தாது!","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d018","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜ","speaker_delimiter":":","text":"துணிவிருந்தால் - வீரர் லக்ஷணத்தைப்பற்றி பேசியதெல்லாம் வாய்வீச்சாக இல்லாமல் இருந்தால் வாளை வீசும்... நல்ல தீர்ப்பு கிடைக்கட்டும்....","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d019","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"மனோ","speaker_delimiter":":","text":"நல்ல தீர்ப்பு...வாள்முனை வழங்காது இனிமேல் வழக்கு மன்றத்திலே தான் பெறவேண்டும்! பாண்டியன் பெற்ற பைங்கொடியே நீ இப்போது கைதி - பாதுகாப்புக் கைதி! ராஜப்பிரியா! அழைத்துச் செல்!","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d020","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"ராஜப்","speaker_delimiter":":","text":"அதோ கோட்டை வாசலிலே எங்கள் கொடி! ராஜகுமாரி மனோகரனின் அடிமை என்பதை அறிவிக்கும் கொடி!","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-015.md"},{"id":"manohara-s015-d021","scene_id":"manohara-s015","scene_ordinal":15,"transition_audit_id":"T015","speaker_label":"விஜயா","speaker_delimiter":":","text":"பேசாதே! அரசிளங் குமரியாக வாழ்ந்தேன் - அடிமையாக வாழமாட்டேன். வானம்பாடியாகத் திரிந்தேன் - வல்லூறுகளின் கோரப் பிடியிலே சிக்க மாட்டேன். சுதந்திரத் தென்றலிலே மிதந்தேன் - அடிமைச் சூறாவளியிலே அகப்பட்டுக் கொள்ளமாட்டேன் - மாற்றானின் காலடியைவிட மரணத்தின் மடி எவ்வளவோ மேல்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-015.md"}]}