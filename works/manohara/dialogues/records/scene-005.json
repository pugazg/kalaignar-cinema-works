{"work_id":"manohara","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","source_scene_number":null,"source_scene_file":"works/manohara/scenes/scene-005.md","record_count":15,"records":[{"id":"manohara-s005-d001","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரியவர்","speaker_delimiter":":","text":"எங்கே கேசரி வர்மா அவசரமாகப் புறப்பட்டு இருப்பாய்?","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d002","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேசரி வர்மன்","speaker_delimiter":":","text":"நாடகத்திற்கு - அதோ அவர்களைத்தான் ஏற்பாடு செய்திருக்கிறேன்.","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d003","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"மறந்துவிட்டேன். இன்று மனோகரன் பிறந்த விழாவா? உம் ... நாடகத்திற்கு என்ன பெயர் வைத்திருக்கிறாய்?","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d004","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேசரி","speaker_delimiter":":","text":"போர்வாள்.","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d005","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"சபாஷ் ... தடையொன்றும் கிடையாதே நடத்துவதற்கு?...","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d006","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேச","speaker_delimiter":":","text":"கிடையாது. காரணம், கதை அவர்களுக்குப் புரியாது...","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d007","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"வசந்த சேனைக்கு உன் நாடகத்துப் புனைப்பெயர் என்ன?","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d008","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேச","speaker_delimiter":":","text":"தேவ சேனா!","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d009","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"உன் பெயர்?","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d010","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேச","speaker_delimiter":":","text":"ஈஸ்வரி வர்மன். புருஷோத்தமனை உத்தம புருஷனென்று மாற்றியிருக்கிறேன்.","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d011","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"கட்டாயம் புரிந்துகொள்வார்கள் கதையை.","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d012","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேச","speaker_delimiter":":","text":"புரியத்தானே வேண்டும். அப்போதாவது புருஷோத்தமனுக்கு புத்தி வராதா?","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d013","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"உம்... முயற்சி செய்து பார்!","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d014","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"கேச","speaker_delimiter":":","text":"வருகிறேன், குரு தேவா!","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"},{"id":"manohara-s005-d015","scene_id":"manohara-s005","scene_ordinal":5,"transition_audit_id":"T005","speaker_label":"பெரி","speaker_delimiter":":","text":"ஜாக்கிரதை","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-005.md"}]}
