    {"id":"manohara-en-s027-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s027","archival_scene_ordinal":27,"source":{"source_path":"works/manohara/dialogues/records/scene-027.json","canonical_scene_path":"works/manohara/scenes/scene-027.md","source_record_id":"manohara-s027-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Amma!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s027-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s027","archival_scene_ordinal":27,"source":{"source_path":"works/manohara/dialogues/records/scene-027.json","canonical_scene_path":"works/manohara/scenes/scene-027.md","source_record_id":"manohara-s027-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Manohara!... what happened?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s027-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s027","archival_scene_ordinal":27,"source":{"source_path":"works/manohara/dialogues/records/scene-027.json","canonical_scene_path":"works/manohara/scenes/scene-027.md","source_record_id":"manohara-s027-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"What you bound my hands expecting to happen—that is what happened. Amma! Had I known beforehand that you would lay down such a terrible command, I would not have killed Muthu Vijayan—given the lives of so many soldiers—and brought that throne for that sinner to sit upon. She on the throne where you ought to sit? Was an invasion fought for that?","mode":"prose-faithful","notes":["The kill/lives/throne accumulation is preserved rather than compressed."]}},
    {"id":"manohara-en-s027-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s027","archival_scene_ordinal":27,"source":{"source_path":"works/manohara/dialogues/records/scene-027.json","canonical_scene_path":"works/manohara/scenes/scene-027.md","source_record_id":"manohara-s027-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Isn't this green parrot the gain that came from the invasion? (She points to Vijaya.) Think of this and forget that, Manohara!","mode":"semantic-poetic","notes":["Padmavathi's `பைங்கிளி` image for Vijaya is retained as green parrot."]}},
    {"id":"manohara-en-s027-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s027","archival_scene_ordinal":27,"source":{"source_path":"works/manohara/scenes/scene-027.md","canonical_scene_path":"works/manohara/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-dialogue","ordinal":1,"description":"After the source direction `(விஜயாவிடம்)`, Padmavathi's quoted instruction is printed without a speaker label."},"speaker_label":null,"page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Vijaya, calm your husband!","mode":"prose-faithful","notes":["The dramatic context identifies the addressee, but the source prints no speaker label; metadata therefore remains null."]}}
  ]
}