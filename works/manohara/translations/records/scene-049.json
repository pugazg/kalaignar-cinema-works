{"work_id":"manohara","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source_scene_number":null,"scene_status":"verified","unit_count":13,"units":[{"id":"manohara-en-s049-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/scenes/scene-049.md","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Palace."},"speaker_label":null,"page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"[Palace.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Akshaya! They say Vijaya, who is lying in the underground prison, has given birth to a child.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"What is it, Akshaya?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Nothing...... nothing. A bud has sprouted at the very moment of destruction!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s049-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Yes. You must pluck out that very bud and cast it away!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s049-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Ah! What—me?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Who is there but you to do this deed? Here! Go this very moment!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/scenes/scene-049.md","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"prop-action","ordinal":1,"description":"Vasantha Sena gives him the signet ring."},"speaker_label":null,"page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"[She gives him the signet ring.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"I must kill my own treasure.\nNo... no...","mode":"semantic-poetic","notes":["The source-unlabelled `இல்ல...இல்ல...` continuation remains inside the preceding explicit Manoharan record, matching the immutable dialogue layer."]}},{"id":"manohara-en-s049-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/scenes/scene-049.md","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"weapon-action","ordinal":1,"description":"Manoharan draws his sword."},"speaker_label":null,"page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"[He draws his sword.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s049-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/dialogues/records/scene-049.json","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":"manohara-s049-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனக்குரல்","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Manohara, stop. Do not give way to fury; do not become a slave to haste! The palace is full of enemies. Your mother is in prison—your father is suffering. You rush forward with sword outstretched... who will protect your unfading flowers? Who will protect your many-coloured parrots?","mode":"semantic-poetic","notes":["The inner voice and the paired `unfading flowers / coloured parrots` protective images are retained."]}},{"id":"manohara-en-s049-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s049","archival_scene_ordinal":49,"source":{"source_path":"works/manohara/scenes/scene-049.md","canonical_scene_path":"works/manohara/scenes/scene-049.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"exit-action","ordinal":1,"description":"Manoharan turns back and goes to the prison."},"speaker_label":null,"page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"[He turns back and goes to the prison.]","mode":"prose-faithful","notes":[]}}]}