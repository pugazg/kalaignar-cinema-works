    {"id":"manohara-en-s022-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s022","archival_scene_ordinal":22,"source":{"source_path":"works/manohara/dialogues/records/scene-022.json","canonical_scene_path":"works/manohara/scenes/scene-022.md","source_record_id":"manohara-s022-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Bauthayanan is a useless little wall!... a cowardly fellow!... He will certainly betray me. If I am to escape, he must not remain alive.","mode":"prose-faithful","notes":["The source insult `குட்டிச்சுவரு` is kept close to its concrete wall-image rather than silently replaced with a different insult."]}},
