    {"id":"manohara-en-s022-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s022","archival_scene_ordinal":22,"source":{"source_path":"works/manohara/dialogues/records/scene-022.json","canonical_scene_path":"works/manohara/scenes/scene-022.md","source_record_id":"manohara-s022-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hmm. If one wants to take honey, many bees must be killed... all right, arrange what I told you!","mode":"prose-faithful","notes":["The honey/bees metaphor for eliminating intermediaries is preserved without explanatory expansion."]}}
