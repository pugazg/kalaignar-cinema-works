{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source_scene_number":null,"scene_status":"verified","unit_count":17,
  "units":[
    {"id":"manohara-en-s034-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/scenes/scene-034.md","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Padmavathi's room."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Padmavathi's room.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Minister! Ask the Maharaja himself what he says!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்யசீலா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"The Maharaja will not pay attention to any of this—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"When I think of Manoharan, I am afraid.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"There is no need to fear—I will take care of it.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/scenes/scene-034.md","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"eavesdropping-action","ordinal":1,"description":"The king and Vasantha Sena listen from hiding."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"[The king and Vasantha Sena listen from hiding.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"The Maharaja will not notice... there is no need to fear Manoharan.","mode":"prose-faithful","notes":["Vasantha Sena repeats the overheard phrases to sharpen the king's suspicion."]}},
    {"id":"manohara-en-s034-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/scenes/scene-034.md","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"reaction-action","ordinal":1,"description":"The king turns away suspicious of Padmavathi."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"[The king turns away, now suspicious of Padmavathi.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/scenes/scene-034.md","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":2,"description":"A private place."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"[In a private place.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"(Looking at the moon) Stain... stain! A stain never before in my lineage! Sinner!","mode":"semantic-poetic","notes":["The moon-gazing cue and repeated `stain` image remain inside the source-linked turn."]}},
    {"id":"manohara-en-s034-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/scenes/scene-034.md","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"violent-symbolic-action","ordinal":1,"description":"The king smashes Padmavathi's nearby statue."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"[He smashes Padmavathi's statue beside him.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Prabhu! Be calm...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Calm! Only in her death will I have calm!","mode":"prose-faithful","notes":["The repeated `அமைதி` word is preserved."]}},
    {"id":"manohara-en-s034-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Listen to this, Maharaja! The queen......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Queen...... do not say that again! Woman without honour! Vagabond... whore! Vasanthi! You yourself give the order! She must be put in the underground prison.","mode":"prose-faithful","notes":["The king's escalating insults are translated directly rather than euphemized."]}},
    {"id":"manohara-en-s034-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Putting the queen in prison will cool your fury. At the spring festival Manoharan leapt at me because I spoke ill of his mother! What will he say now? Will he ask my pardon?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s034-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s034","archival_scene_ordinal":34,"source":{"source_path":"works/manohara/dialogues/records/scene-034.json","canonical_scene_path":"works/manohara/scenes/scene-034.md","source_record_id":"manohara-s034-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"I shall make him ask... I shall make him apologize in the royal hall itself for speaking against you. Prison for Padmavathi! Manoharan must apologize to Vasantha Sena......","mode":"prose-faithful","notes":[]}}
  ]
}