{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source_scene_number":null,"scene_status":"verified","unit_count":8,
  "units":[
    {"id":"manohara-en-s018-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/scenes/scene-018.md","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-parenthetical-stage-direction","ordinal":1,"description":"Pandiyan palace."},"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"(The Pandiyan palace.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s018-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Vijaya.... I thought you alone were the beauty in this palace. I failed to notice that there is a golden creeper to rival you.","mode":"prose-faithful","notes":["The `பொற்கொடி` golden-creeper image is retained."]}},
    {"id":"manohara-en-s018-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Who?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s018-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"[Pointing to Vijaya's reflection in the mirror] There! This smile is a sadir-dance of diamond dewdrops upon a golden rose!","mode":"prose-faithful","notes":["The mirror action remains inside the immutable dialogue-linked unit as in the source record.","`சதிராட்டம்` is retained as `sadir-dance` to preserve the cultural dance image."]}},
    {"id":"manohara-en-s018-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Leave that aside! I am the enemy's daughter! Will your mother and father accept me?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s018-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"I wondered the same thing. I am your enemy, after all—would you accept me?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s018-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"I loved your valour. The soil of my motherland stopped it! I was enchanted by your charm! My father's affection dammed it back. In the end, your honest heart conquered me! What?","mode":"prose-faithful","notes":["The soil/dam/conquest sequence is preserved as a linked metaphorical progression."]}},
    {"id":"manohara-en-s018-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s018","archival_scene_ordinal":18,"source":{"source_path":"works/manohara/dialogues/records/scene-018.json","canonical_scene_path":"works/manohara/scenes/scene-018.md","source_record_id":"manohara-s018-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Speak, my dear... speak! I go on savouring the honey-waves of the sea of your nectar-dripping lips... the love-epics your eyes write and heap before me, queen of my heart... speak a little more...","mode":"semantic-poetic","notes":["The deliberately lush lip-sea/honey-wave and eye-written-epic imagery is retained rather than reduced to ordinary romantic prose."]}}
  ]
}
