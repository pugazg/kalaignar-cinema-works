{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source_scene_number":null,"scene_status":"verified","unit_count":10,
  "units":[
    {"id":"manohara-en-s025-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/scenes/scene-025.md","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-bracketed-stage-direction","ordinal":1,"description":"Inner chamber."},"speaker_label":null,"page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"[Inner chamber.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s025-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hmm, tomorrow a victory-festival welcome for Manoharan!... and then I, like a widow, in some corner......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s025-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"(With discomfort)......... Vasanthi! Do not speak like this—you may come to the assembly with every honour......","mode":"prose-faithful","notes":["The parenthetical emotional cue remains within the immutable dialogue-linked unit as stored in the source record."]}},
    {"id":"manohara-en-s025-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"May I come?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s025-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hmm... you may.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s025-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hmm... hesitation has been born... poor you! What can you do? The people of the assembly will not permit it. So what if you are emperor—you must still fear ordinary subjects, must you not!","mode":"prose-faithful","notes":["Vasantha Sena's insinuating progression from hesitation to the emperor's fear of ordinary subjects is preserved."]}},
    {"id":"manohara-en-s025-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"No... you may come......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s025-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"I may come!... What does it matter where I come? On that Ratna throne brought from the enemy land, can this wretched woman—who day and night performs penance thinking only of your love—sit beside you like the chief queen? Am I a sinner blessed with such fortune?","mode":"prose-faithful","notes":["The self-abasing `தரித்திரம் பிடித்தவள்` and ironic `கொடுத்து வைத்த பாவி` are retained rather than neutralized."]}},
    {"id":"manohara-en-s025-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Why merely beside me—if I had strength like Paramasiva, I would keep you even upon my head, like the Ganga!","mode":"prose-faithful","notes":["The Paramasiva/Ganga image is retained rather than replaced with a generic declaration of devotion."]}},
    {"id":"manohara-en-s025-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s025","archival_scene_ordinal":25,"source":{"source_path":"works/manohara/dialogues/records/scene-025.json","canonical_scene_path":"works/manohara/scenes/scene-025.md","source_record_id":"manohara-s025-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Then tomorrow...... in the durbar!","mode":"prose-faithful","notes":[]}}
  ]
}
