  "work_id":"manohara","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source_scene_number":null,"scene_status":"verified","unit_count":17,
  "units":[
    {"id":"manohara-en-s013-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/scenes/scene-013.md","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-parenthetical-stage-direction","ordinal":1,"description":"Muthu Vijayan's palace."},"speaker_label":null,"page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"(Muthu Vijayan's palace.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய் 1","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"My king! Danger... danger... destruction to the ramparts!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய் 2","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"The ceremonial full-pot has been shattered.","mode":"prose-faithful","notes":["`பூரண கும்பம்` is retained as the ceremonial full-pot image rather than generalized into merely 'an omen'."]}},
    {"id":"manohara-en-s013-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய் 3","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"The enemies are advancing.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Appa! Must so much blood flow for this Ratna throne?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்து விஜயன்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Blood... blood is a swimming pool to me. War is a pastime to me! Not knowing that, this brute comes crashing against Muthu Vijayan!","mode":"prose-faithful","notes":["The blood/swimming-pool and war/pastime boasts are preserved at full theatrical pitch."]}},
    {"id":"manohara-en-s013-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Danger! Danger! The formations have broken apart.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மு. வி","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Where is the commander? Where is that lion-hearted man?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"He has won a body of fame, O king! He has fallen on the battlefield.","mode":"prose-faithful","notes":["`புகழுடம்பு பெற்றுவிட்டார்` is preserved as the classical image of gaining a 'body of fame'."]}},
    {"id":"manohara-en-s013-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய் 2","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"The fish-flag has fallen.","mode":"prose-faithful","notes":["The source's hyphen delimiter is preserved in metadata upstream; translation does not normalize the source record."]}},
    {"id":"manohara-en-s013-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மு. வி","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Ah!... I am setting out now... where are my armies...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/scenes/scene-013.md","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"battle-stage-direction","ordinal":1,"description":"Manoharan's forces scale the fort wall under heavy resistance."},"speaker_label":null,"page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Manoharan's forces climb the fort wall. Fierce resistance—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்து","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Come on, little brother!...\nYoung man who does not know how to hold a sword! Do not imagine you have encircled the fort.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"I have heard that you are a warrior... in the swing of your tongue!","mode":"prose-faithful","notes":["The `வாய் வீச்சு / வாள் வீச்சு` setup is preserved for Muthu Vijayan's answer."]}},
    {"id":"manohara-en-s013-u015","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/scenes/scene-013.md","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-battle-stage-direction","ordinal":1,"description":"Muthu Vijayan angrily swings his sword as he answers."},"speaker_label":null,"page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"[Muthu Vijayan, in a fit of rage, swinging his sword...]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s013-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/dialogues/records/scene-013.json","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":"manohara-s013-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்து","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"In the swing of the sword too!...","mode":"prose-faithful","notes":["The tongue/sword swing wordplay is retained as closely as English permits."]}},
    {"id":"manohara-en-s013-u017","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s013","archival_scene_ordinal":13,"source":{"source_path":"works/manohara/scenes/scene-013.md","canonical_scene_path":"works/manohara/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"cross-page-battle-stage-direction","ordinal":2,"description":"The fierce duel, breach, Muthu Vijayan's death, victorious entry and flag change span PDF 27→28."},"speaker_label":null,"page_provenance":[{"pdf_page":27,"printed_page":26},{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"A furious swordfight rages between the two...... At the fort gate the two armies fight savagely; at last Manoharan's forces begin to enter. Muthu Vijayan falls to Manoharan's sword...... At the fort gate Manoharan's forces enter with cries of victory... At the front of the fort the Pandiyan fish-flag is lowered, and Rajapriyan has the tiger-flag raised......","english_page_segments":[{"pdf_page":27,"printed_page":26,"english_text":"A furious swordfight rages between the two...... At the fort gate the two armies fight savagely; at last Manoharan's forces begin to enter. Muthu Vijayan falls to Manoharan's sword......"},{"pdf_page":28,"printed_page":27,"english_text":"At the fort gate Manoharan's forces enter with cries of victory... At the front of the fort the Pandiyan fish-flag is lowered, and Rajapriyan has the tiger-flag raised......"}],"mode":"prose-faithful","notes":["Preserved as one continuous battle-result unit across the physical page break."]}}
  ]
}
