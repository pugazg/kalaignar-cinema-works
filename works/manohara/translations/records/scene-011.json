{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source_scene_number":null,"scene_status":"verified","unit_count":35,
  "units":[
    {"id":"manohara-en-s011-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-parenthetical-stage-direction","ordinal":1,"description":"A war proclamation is beaten out in the street."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"(A war proclamation is beaten out in the street.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u002","kind":"chant","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முரசறைவோன்","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"War! Terrible war! A war that will decide our country's honour—its future! Warriors, make ready! One from every household, set forth! We shall break the bones of the worthless—we shall raise the flag of victory. Come! Come! To war!... War! War! War! Dum, dum, dum!","mode":"prose-faithful","notes":["Classified as chant/proclamation while preserving the immutable labelled source-record link and drum-beat ending."]}},
    {"id":"manohara-en-s011-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"War! War! Mightiest of warriors! March to war! There are two kinds of war. In one war, cattle graze—that is a hay-war! Another war is merely an akka-war! The war I speak of is the fight in which skulls are smashed! Tiger-eyed warriors! Lions! Leopards! Sheep! Roar and charge! Hmm, set out. Why are you standing there? Cut! Strike down! Kill... rip out their guts......","mode":"prose-faithful","notes":["Vasanthan's intentionally absurd war-wordplay and descending animal catalogue are preserved rather than regularized."]}},
    {"id":"manohara-en-s011-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-direction","ordinal":1,"description":"Warrior dolls now appear in the scene."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"[Warrior dolls now appear in the scene.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"விகடன்","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Shabash! Vasanthan—you truly are a warrior.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"No doubt... no doubt......","mode":"prose-faithful","notes":["Carries forward Vasanthan's recurring `சந்தேகமில்லே` comic refrain."]}},
    {"id":"manohara-en-s011-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"cross-page-parenthetical-stage-direction","ordinal":1,"description":"Vasanthan draws a sword that has only a hilt; as Vasantha Sena arrives he shoots an arrow. The source direction crosses PDF 23→24."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22},{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"(Saying this, he draws his sword. Only the hilt is in his hand...... Vasantha Sena arrives; he shoots an arrow.)","english_page_segments":[{"pdf_page":23,"printed_page":22,"english_text":"(Saying this, he draws his sword. Only the hilt is in his hand......"},{"pdf_page":24,"printed_page":23,"english_text":"Vasantha Sena arrives; he shoots an arrow.)"}],"mode":"prose-faithful","notes":["Preserved as one source-continuous stage unit across the physical page break."]}},
    {"id":"manohara-en-s011-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Vasantha, what is this?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"He says he's going to the battlefield... for that......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"The battlefield?...... Why should you go there, my dear?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"விகடன்","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"That is a place for warriors to go...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Hmm!... Give me leave, Amma...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"You'll ruin your health...... You don't need this swaggering work......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Mother! Is it you who speaks like this? You, descended from the line of that heroic mother who, hearing that her son had been wounded in the chest on the battlefield, vowed in anguish to break the vessel from which he drank her milk—and who rejoiced when she saw that her son had died with a wound on his back? Is it you who speaks so—coward! Coward!... Coward!...","mode":"prose-faithful","notes":["The deliberately overblown heroic-mother rhetoric is retained without silently correcting its paradoxical source wording."]}},
    {"id":"manohara-en-s011-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Ayyo... fate!......... Vikata! I have sent for the physician—let Vasanthan's treatments begin...... The throne is waiting......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Father!...\nGive me leave!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Manohara! Make the enemy know the glory of the warrior clan! Grind the enemy's arrogance into the dust!","mode":"prose-faithful","notes":["The parallel martial imperatives are retained."]}},
    {"id":"manohara-en-s011-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Bring the victory garland!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Vasanthi brings the garland."},"speaker_label":null,"page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Vasanthi brings the garland.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"I myself shall place it on my darling...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Rajapriya, warriors do not customarily wear the garland of victory before victory is won.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-reaction","ordinal":1,"description":"Vasanthi's face changes."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"(Vasanthi's expression changes......)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"I take my leave—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"May you conquer! Long live!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u025","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"The two leave."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"The two leave......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Vasanthi!...... Are you angry, my dear—\nManoharan is a boy—forgive him!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"I have never once been angry with him—he is the treasure of my desire—my beloved son—he may hate me—but to me he is moonlight—a star! Sugarcane juice!","mode":"prose-faithful","notes":["The moonlight/star/sugarcane-juice accumulation is retained rather than rationalized."]}},
    {"id":"manohara-en-s011-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Vasanthi!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u029","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Outside Padmavathi's inner chamber."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Outside Padmavathi's inner chamber.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Amma......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"My son...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u032","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Padmavathi takes the tray from her companion and applies the tilak to Manoharan."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"She takes the tray from her companion and applies the tilak to Manoharan...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s011-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Come back a victorious warrior, Manohara, so that the mother who bore you and the golden land where you were born may rejoice!","mode":"prose-faithful","notes":["`பொன்னாடு` is kept as the image of the golden native land."]}},
    {"id":"manohara-en-s011-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/dialogues/records/scene-011.json","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":"manohara-s011-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Amma! If I win, the Ratna throne will return! If not, this blood-soaked warrior's sword will return and bear you my news!","mode":"prose-faithful","notes":["The paired throne/sword return image is preserved."]}},
    {"id":"manohara-en-s011-u035","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s011","archival_scene_ordinal":11,"source":{"source_path":"works/manohara/scenes/scene-011.md","canonical_scene_path":"works/manohara/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-direction","ordinal":2,"description":"Departure by chariot."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"[He departs in the chariot.]","mode":"prose-faithful","notes":[]}}
  ]
}
