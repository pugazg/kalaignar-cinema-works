{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source_scene_number":null,"scene_status":"verified","unit_count":19,
  "units":[
    {"id":"manohara-en-s044-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/scenes/scene-044.md","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Puja room."},"speaker_label":null,"page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"[Puja room.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Who is it—oh... Queen Vasantha Devi?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Are Swami's thoughts on God?","mode":"semantic-poetic","notes":["This sets up the `ஆண்டவன் / ஆண்டு கொண்டிருப்பவன்` wordplay in Ugrasenan's reply."]}},
    {"id":"manohara-en-s044-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Not about the Lord. About the one who is ruling... sit down, my delight.","mode":"semantic-poetic","notes":["The Lord/ruler turn in `ஆண்டவன் / ஆண்டு கொண்டிருப்பவன்` is retained rather than flattened."]}},
    {"id":"manohara-en-s044-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Have some fruit juice.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"First I shall drink the nectar of your gaze, my dear!","mode":"semantic-poetic","notes":["The source's `பார்வை ரசம்` image is preserved as gaze-nectar rather than reduced to ordinary flirtation."]}},
    {"id":"manohara-en-s044-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"How many days it has been since I saw you.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Did you call me, Amma?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"No, go away.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"(Running his hand through her hair) Ah! A gathering of clouds. (Showing her teeth) A jasmine garden. (Stroking her cheek) A field of roses!","mode":"semantic-poetic","notes":["The cloud / jasmine-garden / rose-field sequence and its source-attached gestures are retained in order."]}},
    {"id":"manohara-en-s044-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Swami!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Altogether, the very limit of delight!","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s044-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Yes... how have you planned all the plans?","mode":"prose-faithful","notes":["The source's repetition of `திட்டங்கள் / திட்டியிருக்கிறீர்கள்` remains audible."]}},
    {"id":"manohara-en-s044-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Splendidly! All the important parts of the palace are being occupied by our warriors disguised as mendicants. One command from us is enough—war! Purushothaman under arrest!","mode":"semantic-poetic","notes":["The abrupt `போர்! புருஷோத்தமன் கைது!` military cadence is preserved."]}},
    {"id":"manohara-en-s044-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Even war will not be necessary. I have Purushothaman's soldiers in the palm of my hand.","mode":"semantic-poetic","notes":["`என் கைக்குள் போட்டு வைத்திருக்கிறேன்` remains a control-in-the-hand image rather than being generalized."]}},
    {"id":"manohara-en-s044-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Sabash! What if war does come? Once enemy troops have entered the palace, who can resist and win?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s044-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Have the enemy troops come only into the palace?","mode":"semantic-poetic","notes":["The line deliberately opens the sexual double meaning that follows."]}},
    {"id":"manohara-en-s044-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"You mean they have come all the way into the inner chambers? This is not to fight. To surrender.","mode":"semantic-poetic","notes":["The palace/inner-chambers and fight/surrender double entendre is preserved without explanatory expansion."]}},
    {"id":"manohara-en-s044-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s044","archival_scene_ordinal":44,"source":{"source_path":"works/manohara/dialogues/records/scene-044.json","canonical_scene_path":"works/manohara/scenes/scene-044.md","source_record_id":"manohara-s044-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"I will come tonight.","mode":"semantic-poetic","notes":["The concise closing line is left to carry its source double meaning without added explanation."]}}
  ]
}
