  "work_id":"manohara","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source_scene_number":null,"scene_status":"verified","unit_count":13,
  "units":[
    {"id":"manohara-en-s026-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/scenes/scene-026.md","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-location-action","ordinal":1,"description":"Court hall; cries of Long live Manoharan; the king enters with Vasantha Sena."},"speaker_label":null,"page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Court hall. Cries of ‘Long live Manoharan!’ The king enters with Vasantha Sena.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பிரதானி1","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Royal honours for Vasantha Sena? The king has truly fallen under her spell.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பிரதானி2","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"In that spell, he has bartered away the very honour of this warrior land!","mode":"prose-faithful","notes":["The source record's comma delimiter is preserved upstream and is not normalized here."]}},
    {"id":"manohara-en-s026-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பிரதானி3","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"A symbol of disgrace—the king with her... and that too in the royal assembly.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பிரதானி4","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Satyaseelar... what is this?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்தியசீலர்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"A firefly in the place where a star should be......","mode":"semantic-poetic","notes":["The star/firefly contrast is retained literally."]}},
    {"id":"manohara-en-s026-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/scenes/scene-026.md","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-entrance-reaction","ordinal":1,"description":"Manoharan enters amid cheers and cries out on seeing Vasantha Sena on the Ratna throne."},"speaker_label":null,"page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"[Manoharan enters amid cries of welcome. Seeing Vasantha Sena on the Ratna throne, he boils with rage and cries ‘Ah!’]","mode":"prose-faithful","notes":["The embedded cry belongs to the source stage narration and is not assigned an invented dialogue record."]}},
    {"id":"manohara-en-s026-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Manohara! Your mother's command!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தசேனை","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Son......... do you remember........... You said you would wear the victory garland only after winning the war—here is the vaagai garland I place on my darling.","mode":"prose-faithful","notes":["`வாகைமாலை` is retained as the traditional vaagai victory garland rather than flattened to a generic wreath."]}},
    {"id":"manohara-en-s026-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Fie! A victory garland!... from your hand... sword—(he draws it)","mode":"prose-faithful","notes":["The source-attached sword-drawing cue remains inside the linked utterance."]}},
    {"id":"manohara-en-s026-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்தியசீலர்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Manohara... do not disobey your mother's word...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/dialogues/records/scene-026.json","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":"manohara-s026-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Yes... Manohara!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s026-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s026","archival_scene_ordinal":26,"source":{"source_path":"works/manohara/scenes/scene-026.md","canonical_scene_path":"works/manohara/scenes/scene-026.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"closing-action","ordinal":1,"description":"Enraged, Manoharan slaps Rajapriyan and leaves quickly."},"speaker_label":null,"page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Enraged, Manoharan slaps Rajapriyan across the cheek and storms out.","mode":"prose-faithful","notes":[]}}
  ]
