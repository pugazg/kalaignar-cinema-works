{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source_scene_number":null,"scene_status":"verified","unit_count":21,
  "units":[
    {"id":"manohara-en-s040-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/scenes/scene-040.md","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Cave."},"speaker_label":null,"page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"[Cave.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரிவர்மன்","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"The vengeful woman has prepared the palm-leaf letter. To make her plan succeed, if we are careless even a little with this final letter, it itself will become our death-letter!","mode":"semantic-poetic","notes":["The `letter/death-letter` wordplay is retained."]}},
    {"id":"manohara-en-s040-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்யசீலர்","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Tell us the matter, Varma!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"கே. வ","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"The deceiver tried to crown Vasanthan! The king refused. So she has sent a letter to the outsider Ugrasenan, asking him to seize this palace and make her son king.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Ugrasenan! King of Imayapuri!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Yes! The man who has been waiting for a chance to enter our empire.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"கே. வ","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"The man bringing a reply from Ugrasenan must come by this very route. Come, let us see.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/scenes/scene-040.md","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"Akshayan comes on horseback; Manoharan stops him."},"speaker_label":null,"page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"[Akshayan comes on horseback. Manoharan stops him.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Who are you!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"அட்","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Are you asking me? I am myself!","mode":"prose-faithful","notes":["The evasive comic tautology is retained."]}},
    {"id":"manohara-en-s040-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வர்ம","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Where are you going?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"அட்","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"To the place I must go!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/scenes/scene-040.md","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"capture-action","ordinal":1,"description":"Manoharan and Rajapriyan attack Akshayan, bind him to a stone pillar, and take a letter from him."},"speaker_label":null,"page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"[Manoharan and Rajapriyan attack Akshayan and bind him to a stone pillar. Manoharan takes a letter from him.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u014","kind":"written-text","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/scenes/scene-040.md","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"printed-letter","ordinal":1,"description":"Ugrasenan's letter to Vasantha Sena printed in full on PDF 65."},"speaker_label":null,"page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"‘Dear Vasantha Sena!\n\nKeep Akshayan as your aide and attend to what must be done inside the palace. The troops and I are setting out. We shall do away with Purushothaman. We shall begin a new life.\n\nUgrasenan.’","mode":"prose-faithful","notes":["The salutation, body and signature are preserved as one printed-letter unit; no words are supplied beyond the source."]}},
    {"id":"manohara-en-s040-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Treason... we must not let this go!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Let us set out now... that crooked-minded woman must be destroyed root and branch.","mode":"prose-faithful","notes":["`கூண்டோடு அழிக்க` is rendered as total/root-and-branch destruction without adding a literal cage not warranted in this idiomatic context."]}},
    {"id":"manohara-en-s040-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"கே. வ.","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"If you destroy her, your valour will be revealed. That whore's disguise will not be revealed. Prince! Have I wandered yearning all this time merely to kill her in half a second? I too could do that; I would have done it long ago.","mode":"prose-faithful","notes":["The valour/disguise contrast is retained."]}},
    {"id":"manohara-en-s040-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Why did you not?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வர்","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Wisdom, Prince! Wisdom. Had I killed her then, the king—who had lost his eyes for that deceitful woman—would have shed tears for her. Her schemes would not have been exposed. The world could not have known her deceits. Our cleverness does not lie in killing her. It lies in exposing her plots.","mode":"semantic-poetic","notes":["The repeated `விவேகம்` and killing-versus-exposing contrast are preserved."]}},
    {"id":"manohara-en-s040-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"And the way to do that......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s040-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s040","archival_scene_ordinal":40,"source":{"source_path":"works/manohara/dialogues/records/scene-040.json","canonical_scene_path":"works/manohara/scenes/scene-040.md","source_record_id":"manohara-s040-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வர்","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Just as a thorn is removed with another thorn, a plot must be defeated by a plot. I shall tell you—come.","mode":"prose-faithful","notes":["The thorn-with-thorn proverb is translated literally rather than replaced by an English proverb."]}}
  ]
}