e_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"I yearned and pined, wondering when I would see you again, slender-bangled one!","mode":"semantic-poetic","notes":["`ஏந்திழையே` is retained as a heightened poetic address rather than flattened."]}},{"id":"manohara-en-s046-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s046","archival_scene_ordinal":46,"source":{"source_path":"works/manohara/dialogues/records/scene-046.json","canonical_scene_path":"works/manohara/scenes/scene-046.md","source_record_id":"manohara-s046-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Swami!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s046-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s046","archival_scene_ordinal":46,"source":{"source_path":"works/manohara/dialogues/records/scene-046.json","canonical_scene_path":"works/manohara/scenes/scene-046.md","source_record_id":"manohara-s046-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Vasanthi!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s046-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s046","archival_scene_ordinal":46,"source":{"source_path":"works/manohara/dialogues/records/scene-046.json","canonical_scene_path":"works/manohara/scenes/scene-046.md","source_record_id":"manohara-s046-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Prabho! Where are we now?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s046-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s046","archival_scene_ordinal":46,"source":{"source_path":"works/manohara/dialogues/records/scene-046.json","canonical_scene_path":"works/manohara/scenes/scene-046.md","source_record_id":"manohara-s046-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"We are on our way to heaven, my dear!","mode":"prose-faithful","notes":[]}}]}