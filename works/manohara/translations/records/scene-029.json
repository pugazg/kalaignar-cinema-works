  "work_id":"manohara","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source_scene_number":null,"scene_status":"verified","unit_count":8,
  "units":[
    {"id":"manohara-en-s029-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/scenes/scene-029.md","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-location-action","ordinal":1,"description":"Cave; the elder is absorbed in discovering a medicinal method."},"speaker_label":null,"page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Cave. The elder is absorbed in discovering a medicinal method...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s029-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/dialogues/records/scene-029.json","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":"manohara-s029-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெரியவர்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Before this invisibility medicine runs out, victory is certain......","mode":"prose-faithful","notes":["`அரூப மருந்து` is translated as invisibility medicine in continuity with the source's established effect."]}},
    {"id":"manohara-en-s029-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/dialogues/records/scene-029.json","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":"manohara-s029-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரிவர்மன்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"The invisibility medicine... has dwindled. A little more...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s029-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/dialogues/records/scene-029.json","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":"manohara-s029-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெரியவர்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"No need...... Here...... today itself I shall discover a sanjeevi that does not die...","mode":"prose-faithful","notes":["`சஞ்சீவி` is retained as sanjeevi, preserving the source's mythic medicinal register rather than replacing it with a modern scientific term."]}},
    {"id":"manohara-en-s029-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/dialogues/records/scene-029.json","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":"manohara-s029-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரிவர்மன்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"(Pointing to Vasantha Sena's statue)... Vasantha Sena... I must tear out her heart, squeeze it, and paint this statue red... her eyes...","mode":"prose-faithful","notes":["The source-attached pointing cue remains inside the linked utterance."]}},
    {"id":"manohara-en-s029-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/scenes/scene-029.md","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"explosion-and-collapse","ordinal":1,"description":"An explosion; the guru falls amid smoke and is carried out, his life wavering."},"speaker_label":null,"page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"[An explosion...... The Gurunathar falls amid smoke. He is carried outside... his life is wavering...]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s029-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/dialogues/records/scene-029.json","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":"manohara-s029-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெரியவர்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Kesari Varma... my last... blessing.... Do not rush... make Manoharan your ally... for your goal!... I... I am dying......","mode":"prose-faithful","notes":["The broken dying cadence is preserved."]}},
    {"id":"manohara-en-s029-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s029","archival_scene_ordinal":29,"source":{"source_path":"works/manohara/dialogues/records/scene-029.json","canonical_scene_path":"works/manohara/scenes/scene-029.md","source_record_id":"manohara-s029-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரிவர்மன்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"You laboured without rest to tell the world of a wonder! The invisibility medicine. You did not even show me that method... Swami! All those who discovered something new vanished without revealing it to others... You too have walked that path... is there such a curse upon this country itself?...","mode":"prose-faithful","notes":["The lament about inventions dying with their discoverers is kept explicit rather than modernized into a generic science metaphor."]}}
  ]
}