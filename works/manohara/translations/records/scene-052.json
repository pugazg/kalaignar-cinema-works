{"work_id":"manohara","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source_scene_number":null,"scene_status":"verified","unit_count":25,"units":[{"id":"manohara-en-s052-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/scenes/scene-052.md","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Prison."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"[Prison.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Come! Let me hold that child for a little while!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/scenes/scene-052.md","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":1,"description":"Colon-only line following Manoharan's request to hold the child."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"May I not give even one kiss to Manoharan's child?","mode":"prose-faithful","notes":["Empty source speaker field; no speaker is inferred."]}},{"id":"manohara-en-s052-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Atthai... are you going or not, schemer?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"No, Vijaya—do you not recognize me?\n\n[He removes his false beard.] Vijaya, do you not recognize me?......","mode":"prose-faithful","notes":["The unlabelled continuation after the beard-removal action remains inside the preceding immutable Manoharan turn."]}},{"id":"manohara-en-s052-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Seize him; Manohara!... This time too you cannot escape.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"We shall see about that...","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/scenes/scene-052.md","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"weapon-action","ordinal":1,"description":"Manoharan aims a dagger at Vasantha Sena."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"[He aims to throw the dagger at Sena.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Manohara!...... [She stops him.]","mode":"prose-faithful","notes":["Source-attached action remains within the labelled turn."]}},{"id":"manohara-en-s052-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/scenes/scene-052.md","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"combat-action","ordinal":1,"description":"Manoharan freezes; Ugrasenan's dagger strikes his hand."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"[Manoharan freezes like a statue. Ugrasenan throws a dagger; it strikes Manoharan's hand.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Ruined! Everything is ruined, Mother!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Ruined?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/scenes/scene-052.md","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":2,"description":"Colon-only threat following `நாசமா?`."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"I have fixed a day even for that, Manohara!","mode":"prose-faithful","notes":["Empty source speaker field; no speaker is inferred."]}},{"id":"manohara-en-s052-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/scenes/scene-052.md","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":3,"description":"Second colon-only threat in the same sequence."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"That great event is tomorrow morning, in the royal palace! A death-abhishekam for your child!!","mode":"semantic-poetic","notes":["`மரணாபிஷேகம்` is retained as `death-abhishekam` rather than flattened into a generic killing phrase.","Empty source speaker field; no speaker is inferred."]}},{"id":"manohara-en-s052-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Atthai!... Atthai!...","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Vijaya!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":79,"printed_page":78},{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Mother, Father has been locked in prison. Unable to disobey your command, I submitted to this wretch's order. With these sinful hands I locked him in the underground prison.","mode":"semantic-poetic","notes":["Physical PDF 79→80 continuation remains one utterance."],"english_page_segments":[{"pdf_page":79,"printed_page":78,"english_text":"Mother, Father has been locked in prison. Unable to disobey your command, I submitted to this wretch's"},{"pdf_page":80,"printed_page":79,"english_text":"order. With these sinful hands I locked him in the underground prison."}]}},{"id":"manohara-en-s052-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Drag him away.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Mother... Father, who has understood the truth, longs to see you and me. Thinking again and again of the cruelties now past, he sheds tears. He is shaken and tormented... shaken and tormented, Mother... Mother... Mother...","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s052-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"The Maharaja has understood the truth! My crowned lord has understood the truth. He has understood the truth.","mode":"semantic-poetic","notes":["The source's repeated realization is retained."]}},{"id":"manohara-en-s052-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Atthai!... What is it, Atthai!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"The darkness has lifted. Joy is dawning.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s052-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Joy...! For us?... In this condition?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s052-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s052","archival_scene_ordinal":52,"source":{"source_path":"works/manohara/dialogues/records/scene-052.json","canonical_scene_path":"works/manohara/scenes/scene-052.md","source_record_id":"manohara-s052-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"The Maharaja has understood. My crowned lord has understood the truth.","mode":"semantic-poetic","notes":[]}}]}