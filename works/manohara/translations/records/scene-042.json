{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source_scene_number":null,"scene_status":"verified","unit_count":39,
  "units":[
    {"id":"manohara-en-s042-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/scenes/scene-042.md","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Ugrasenan's tent."},"speaker_label":null,"page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"[Ugrasenan's tent.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ரசேனன்","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Veerasimha! We may have to set out suddenly... all our soldiers are ready, aren't they!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீர","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Ready, my king!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"(Handing over a palm-leaf letter) Enter Purushothaman's palace and, through Vasantha Sena, get this delivered to Akshayan.","mode":"prose-faithful","notes":["The source-attached letter-handover action remains inside the linked utterance."]}},
    {"id":"manohara-en-s042-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"They say Ugrasenan has arrived; they say they're all coming disguised as sadhus...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"போ. அக்ஷ.","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Sadhus... disguise...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"What, Akshaya?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"போ. அக்ஷ.","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Nothing, Amma. Many empires have fallen under the guise of sadhus...","mode":"semantic-poetic","notes":["The political irony of `சாது வேடத்தில்` is retained rather than softened."]}},
    {"id":"manohara-en-s042-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Oh! Yes... how do we bring them into the palace?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"அக்ஷ","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"We shall have to think it over...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"What is there to think about? I'll arrange it in half a second.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/scenes/scene-042.md","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"procession-and-reception","ordinal":1,"description":"Ugrasenan's sadhu group is welcomed with music and devotional cries; the king and Vasanthi receive and honour them with devotion and respect."},"speaker_label":null,"page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"[Ugrasenan's group of sadhus is welcomed with drums, music and devotional cries...... The king and Vasanthi receive and honour the group with devotion, reverence and respect......]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Welcome...... welcome...... I am blessed.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"May Bhagavan's great grace be attained... King Purushothaman... the world itself is a drama; who knows what will happen tomorrow!......","mode":"semantic-poetic","notes":["The disguised holy-man register and `the world is a drama` aphoristic turn are preserved."]}},
    {"id":"manohara-en-s042-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"True, true!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"So this is the queen!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"(Nods his head)......","mode":"prose-faithful","notes":["The source stores this action under an explicit speaker label; it remains linked as dialogue-kind rather than being silently reclassified."]}},
    {"id":"manohara-en-s042-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Mahalakshmi!... Nalayini of the Kali age... Queen...... may you live as your heart desires!... may your thoughts be fulfilled......","mode":"semantic-poetic","notes":["`மகாலஷ்மி` and `கலிகால நளாயினி` remain culturally explicit rather than being replaced with generic praise."]}},
    {"id":"manohara-en-s042-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Vasantha... bow to Swami!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"May I have the company of those noble ones who, with singleness of mind, think upon Your sacred flower-feet... Vikata, I've forgotten the lesson, da...","mode":"semantic-poetic","notes":["The half-remembered devotional recitation is kept elevated before Vasanthan breaks it with his comic admission."]}},
    {"id":"manohara-en-s042-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Enough... enough.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Long live! Long live...... Hey, King... I have come at just the right time. A great danger is waiting for you........","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Swami!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"If you are to escape that danger, you and your queen must remain apart from this very moment until tomorrow morning.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Is that so?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Otherwise, death will occur...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Be separated from Maharaja?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Only until tomorrow morning, Vasanthi!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Hmm—separate... separate...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"I remember now: may I not mingle in the company of those who keep one thing within and speak another without.","mode":"semantic-poetic","notes":["The devotional-lesson cadence is retained as part of Vasanthan's comic recitation."]}},
    {"id":"manohara-en-s042-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Vasantha","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Forgetfulness... desire for women must be forgotten.","mode":"semantic-poetic","notes":["The source prints `மறவு பெண்ணாசை மறக்கவேண்டும்`; it is preserved as printed rather than silently normalized to a familiar devotional line."]}},
    {"id":"manohara-en-s042-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Hey! Keep quiet!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Wisdom is needed...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Vasantha!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u036","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/scenes/scene-042.md","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"exit-action","ordinal":1,"description":"Vasanthi leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"[Vasanthi leaves]...","mode":"prose-faithful","notes":["The source's unusual agreement is not used to infer or alter identity; the English avoids adding a gendered pronoun."]}},
    {"id":"manohara-en-s042-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":68,"printed_page":67}]},"translation":{"english_text":"Everything is God's doing! King!... this body needs a little rest...","mode":"prose-faithful","notes":["The counterfeit ascetic register remains visible in `this body` rather than being normalized to `I`." ]}},
    {"id":"manohara-en-s042-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/dialogues/records/scene-042.json","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":"manohara-s042-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"I'll arrange it at once......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s042-u039","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s042","archival_scene_ordinal":42,"source":{"source_path":"works/manohara/scenes/scene-042.md","canonical_scene_path":"works/manohara/scenes/scene-042.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"palace-seizure-action","ordinal":1,"description":"The king leaves; Ugrasenan's soldiers disguised as sadhus spread through the palace, kill the guards and occupy their places."},"speaker_label":null,"page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"[The king leaves. Ugrasenan's soldiers, disguised as sadhus, spread throughout the palace, kill the guards and occupy their places.]","mode":"prose-faithful","notes":[]}}
  ]
}
