{"work_id":"manohara","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source_scene_number":null,"scene_status":"verified","unit_count":46,"units":[{"id":"manohara-en-s048-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/scenes/scene-048.md","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Puja room."},"speaker_label":null,"page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"[Puja room.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"Why so many lamps, Vasanthi?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"Why? Would one lamp be enough?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"Even that is unnecessary when you, the lamp that never goes out, are beside me!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/scenes/scene-048.md","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"door-action","ordinal":1,"description":"The king pounds on the door; Ugrasenan draws his sword."},"speaker_label":null,"page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"[The king pounds on the door. Ugrasenan draws his sword.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"No! The whole affair will be ruined. I will handle it. Come this way... [She sends him into a room and closes the door; the door breaks.] Who is it?","mode":"prose-faithful","notes":["Source-attached action remains inside the linked utterance."]}},{"id":"manohara-en-s048-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"Who?...... Wretch!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"Ah! Prabhu! Did you not say you must not see this servant? It was the Lord's command!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":72,"printed_page":71},{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"What Lord's command, woman? What? At dead midnight, upon a hamsa-down couch, with that male—with that fellow, was it the Lord's command that you should conduct a revel of pleasure?","mode":"semantic-poetic","notes":["The physical page-break interruption after `ஆண்—` is preserved in page segments."],"english_page_segments":[{"pdf_page":72,"printed_page":71,"english_text":"What Lord's command, woman? What? At dead midnight, upon a hamsa-down couch, with that male—"},{"pdf_page":73,"printed_page":72,"english_text":"with that fellow, was it the Lord's command that you should conduct a revel of pleasure?"}]}},{"id":"manohara-en-s048-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சே","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Ah! What the eye sees is false! What the ear hears is false! Only thorough inquiry is truth, Maharaja!","mode":"semantic-poetic","notes":["The proverbial three-part cadence is preserved."]}},{"id":"manohara-en-s048-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Chi! Do not put on a drama! Where is that mendicant?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சே","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"He is in the realm of dhyana.","mode":"prose-faithful","notes":["`தியான லோகம்` is kept as a devotional-register phrase."]}},{"id":"manohara-en-s048-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"In the realm of udyana, is he? You town-ruining wretch! You can no longer deceive Purushothaman.","mode":"semantic-poetic","notes":["The source's `தியான / உத்தியான` sound-play is kept visible as dhyana/udyana."]}},{"id":"manohara-en-s048-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Maharaja! Think calmly. Do not slander Amma. She is a virtuous woman!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"You who have come to lecture me on the marks of a virtuous woman—embodiment of treachery that betrays the house whose food you ate! All this came because of you. You screamed, ‘She is about to die...... come at once and save her!’ You cast a stain upon the noble Satyaseelar and the chaste Padmavathi. I did not know then that you were the crowbar in this thief-woman's hand!","mode":"semantic-poetic","notes":["The house-betrayal and `கன்னக்கோல்` burglary image are retained."]}},{"id":"manohara-en-s048-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Maharaja!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Tell the truth. Is it not true that you and this destroyer lived by deceiving me? Speak, woman! Speak!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சே","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Do nothing to her. I will tell you everything myself. I poisoned my husband and killed him. I fabricated the story that spotless Padmavathi had lost her chastity.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"What, da! Are you wondering why I am telling every truth? I say all this not to obtain your forgiveness. I say it with the courage of knowing that from now on you can do nothing to me!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Deceiver!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சே","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Deceiver! I am the deceiver? For so many years you kept me merely as a lotus of the bedchamber, and you are the one who levelled to the ground even my one unquenchable desire—that my boy should be crowned! Are you not the deceiver?","mode":"semantic-poetic","notes":["`பள்ளியறைப் பதுமை` remains an elevated bedchamber-lotus image."]}},{"id":"manohara-en-s048-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Your boy's coronation—forget it! No one can wrest this land from the line of Purushothaman.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"You are dreaming! Prepare the address of felicitation—for Vasanthan's coronation! For the coronation of Vasanthan, son of Kesari Varman—","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Stop it, woman! Stop, whore!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Poor man! Have you understood that only now?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Sinner! Harlot! If I leave you alive, you will keep raving. Who is there? Run here! Seize her!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u028","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/scenes/scene-048.md","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"guard-action","ordinal":1,"description":"The guards stand without moving."},"speaker_label":null,"page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"[The guards stand without moving.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"It will not happen. Your authority has set. These are my warriors! Akshaya, arrest him!","mode":"semantic-poetic","notes":["The source's sunset image for vanished authority is retained."]}},{"id":"manohara-en-s048-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Ah! You are ordering my arrest?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Yes—you. I order you arrested. And in this, your last royal dress! Akshaya! Why are you standing there, Akshaya? Hmm............ let it proceed.......","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u032","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/scenes/scene-048.md","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"arrest-action","ordinal":1,"description":"Manoharan arrests his father."},"speaker_label":null,"page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"[Manoharan arrests his father.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"[To himself] Purushothama! You have ground into dust the fame of a lineage that never knew how to show its back! A beast—with fetters locked upon those hands that bore the sword! O land of valour! Will you not forgive me?","mode":"semantic-poetic","notes":["The `விலங்கு` beast/fetter word-play is carried into the line as far as English allows."]}},{"id":"manohara-en-s048-u034","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/scenes/scene-048.md","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":2,"description":"Prison chamber."},"speaker_label":null,"page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"[Prison chamber.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"At a mere nod of his head, petty kings would bow with tribute and army commanders would rise roaring. Today the majesty of that lion of the sceptre has been confined behind prison bars.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Cowards! Is there not even one warrior loyal to the king here?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"There are. Every one of them is in prison. Without a drop of blood being spent, without the clang of swords being heard, our sovereign has beaten the drum of victory.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Sovereign! Even an ascetic who does not know how to hold a spear, who entered the battlefield bearing a kamandalam, is called a sovereign!","mode":"semantic-poetic","notes":["The spear/kamandalam contrast is preserved."]}},{"id":"manohara-en-s048-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Not so! Ugrasenan is clever! He understood that to oppose Purushothaman in the bedchamber he needed neither arrows nor shields. So he decided that saffron robes and kamandalams would be enough.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Enough, da—stop. My valour has not become worthless merely because I fell into the net cast by a whore.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Who is a whore? Vasantha Sena is a chaste woman! Ten-and-a-half-touch gold.","mode":"semantic-poetic","notes":["`பத்தரை மாற்று தங்கம்` is retained as a period purity metaphor rather than replaced by a modern carat figure."]}},{"id":"manohara-en-s048-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"No! It is my ten-and-a-half-touch gold whom I threw into the underground prison! Sinner that I am! Padmavathi! You are the ten-and-a-half-touch gold. The wretch who accused you has received his proper reward. Padmavathi!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s048-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Grieving is useless. Tomorrow morning Vasanthan will be crowned.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":75,"printed_page":74},{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Vasanthan! That deceitful woman's son—the twisted-brained one—the future guardian of our prosperous land! Alas! Manohara! My treasure born to rule! The Chandala who drove you to death has received his proper punishment. Manohara! To you, to your mother, to my jewel Vijaya, how many obstacles I placed! From whom shall I ask forgiveness for all of it? Where are you, Manohara! Though I had committed a thousand crimes, if danger came to your father you would run here ready to give your very head! Who will tell you this news, Manohara! Manohara, where are you, Manohara!","mode":"semantic-poetic","notes":["The repeated invocations of Manoharan and the father's escalating remorse are preserved.","Physical source word-split across PDF 75→76 is represented in English page segments."],"english_page_segments":[{"pdf_page":75,"printed_page":74,"english_text":"Vasanthan! That deceitful woman's son—the twisted-brained one—the future guardian of our prosperous land! Alas! Manohara! My treasure born to rule! The Chandala who drove you to death has received his proper punishment. Manohara! To you, to your mother, to my jewel Vijaya, how many obsta—"},{"pdf_page":76,"printed_page":75,"english_text":"cles I placed! From whom shall I ask forgiveness for all of it? Where are you, Manohara! Though I had committed a thousand crimes, if danger came to your father you would run here ready to give your very head! Who will tell you this news, Manohara! Manohara, where are you, Manohara!"}]}},{"id":"manohara-en-s048-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"I am right here!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s048-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s048","archival_scene_ordinal":48,"source":{"source_path":"works/manohara/dialogues/records/scene-048.json","canonical_scene_path":"works/manohara/scenes/scene-048.md","source_record_id":"manohara-s048-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Where? Where is my Manoharan? Where is Manoharan? Manohara! Manohara!","mode":"semantic-poetic","notes":[]}}]}