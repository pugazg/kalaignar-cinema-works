{"work_id":"manohara","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source_scene_number":null,"scene_status":"verified","unit_count":31,"units":[{"id":"manohara-en-s050-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/scenes/scene-050.md","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-action","ordinal":1,"description":"The real Akshayan cuts the ropes binding him to the stone pillar near the cave."},"speaker_label":null,"page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"[Near the cave, the real Akshayan—who was tied to a stone pillar—struggles and cuts through the ropes.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/scenes/scene-050.md","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Palace."},"speaker_label":null,"page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"[Palace.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தசேனை","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Let us discuss what must be done tomorrow.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ரசேனன்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"What more remains to be done?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Tomorrow is Vasanthan's coronation.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Certainly. But before that, we must proclaim that the country is under our control.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Will proclaiming it bring any danger?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Danger!... From whom? Is there anyone in this world capable of opposing me?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"In this flood of triumph, do not forget that Manoharan is still alive!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s050-u010","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/scenes/scene-050.md","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-and-entrance","ordinal":1,"description":"Prison; Manoharan enters by showing the signet ring."},"speaker_label":null,"page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"[Prison. Showing the signet ring, Manoharan enters.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Mother.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Who are you!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Manoharan... sent me!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Manoharan... is my jewel well?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Atthai! Where do they say he is?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Where else could he be, when he is always in your heart?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Who are you, son?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"I will tell you that later. Now both of you must escape from here.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Yes! Manoharan's secret arrangement. Here is the signet ring. You can leave without fear and without anyone stopping you. Set out.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"To escape by trickery—no, I cannot. I cannot disobey the Maharaja's order. Tell Manoharan that.","mode":"prose-faithful","notes":["The source's anomalous comma delimiter after `பத்` remains source metadata in the immutable dialogue layer; translation does not normalize it."]}},{"id":"manohara-en-s050-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Atthai!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/scenes/scene-050.md","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":1,"description":"Colon-only source line after Vijaya's `Atthai!`; no printed speaker label."},"speaker_label":null,"page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Tell Manoharan, thambi—I have a precious grandson, born here in prison!","mode":"semantic-poetic","notes":["The source begins with an empty speaker field; no speaker is inferred. `தம்பி` is retained as the vocative `thambi`."]}},{"id":"manohara-en-s050-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"I am telling you to leave only to avert the great danger coming upon this grandson.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"For the queen herself to disobey the king's command...? It would not be proper.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Then... Princess! At least give me that child. I will carry him away.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Ah! The child?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"If the child's life is to be saved......?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Atthai, do not trust him...... some plot is under way to kill the child.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"No! No!......","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s050-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s050","archival_scene_ordinal":50,"source":{"source_path":"works/manohara/dialogues/records/scene-050.json","canonical_scene_path":"works/manohara/scenes/scene-050.md","source_record_id":"manohara-s050-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Impossible... impossible... go away.","mode":"prose-faithful","notes":[]}}]}