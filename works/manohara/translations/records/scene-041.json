{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source_scene_number":null,"scene_status":"verified","unit_count":32,
  "units":[
    {"id":"manohara-en-s041-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/scenes/scene-041.md","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"King's palace."},"speaker_label":null,"page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"[King's palace.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலன்","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Maharaja...... there is a man said to be a great expert at treating madness...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Is that so!... Take him to Vasanthi!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலன்","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Your command!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/scenes/scene-041.md","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"disguise-introduction","ordinal":1,"description":"In Vasantha Sena's inner quarters, the guard points out Manoharan disguised as Akshayan."},"speaker_label":null,"page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"[In Vasantha Sena's inner quarters, the guard points out Manoharan, who is in Akshayan's guise.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலன்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Amma—Maharaja sent this man to you. They say he is a great physician...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Who?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"போலி அக்ஷயன்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"I am a physician. My name is..... Ugrasenan's messenger... [understanding]","mode":"prose-faithful","notes":["The source-attached `புரிந்துகொண்டு` cue is retained without assigning an unstated subject."]}},
    {"id":"manohara-en-s041-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"A long name...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u010","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/scenes/scene-041.md","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"letter-action","ordinal":1,"description":"Manoharan extends the letter to Vasantha Sena; she reads it."},"speaker_label":null,"page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"[Manoharan extends the letter to Vasantha Sena. She reads it.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/scenes/scene-041.md","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":1,"description":"The source prints `உமது பெயர்?` without a speaker label after the letter-reading action."},"speaker_label":null,"page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Your name?","mode":"prose-faithful","notes":["No speaker is inferred because the source line has no printed speaker label."]}},
    {"id":"manohara-en-s041-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"போலி அக்ஷயன்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Akshayan!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"You have fooled the king properly.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"போ. அக்ஷ","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Yes—no one can discover who I am...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"All right... keep acting just like a physician—I'll attend to the rest.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"போ. அக்ஷ.","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Acting? That's easy!... Oh!...","mode":"prose-faithful","notes":["The boast in `நடிப்பதா பிரமாதம்` is kept brisk rather than formalized."]}},
    {"id":"manohara-en-s041-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Hey, physician... medicine, medicine—you keep taking my life!","mode":"semantic-poetic","notes":["The literal `உயிரை வாங்குறே` sets up the physician's death-joke in the next exchange and is retained."]}},
    {"id":"manohara-en-s041-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"That's exactly what I'm trying to do, but it isn't happening!","mode":"semantic-poetic","notes":["The physician's reply preserves the dark comic reversal of `உயிரை வாங்க`."]}},
    {"id":"manohara-en-s041-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"What for? To take my life?","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s041-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Tch...tch... by God's grace, may your lifespan go on... this disease go on... and this humble servant's job go on; I am forever praying to Yama-Dharma for it.","mode":"semantic-poetic","notes":["The threefold `நீடிச்சு` repetition and the joke of praying to Yama-Dharma are preserved."]}},
    {"id":"manohara-en-s041-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Physician! What is Yama's vehicle?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"A buffalo bull! That's why he comes so slowly to all the bad people...","mode":"prose-faithful","notes":["The Yama/buffalo joke is retained directly."]}},
    {"id":"manohara-en-s041-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Yes... no doubt... no doubt—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Physician... first, allow me to convey my deepest condolences...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"What is it, Vikatare...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Life is impermanent... here... a new physician has arrived for Vasanthan!","mode":"semantic-poetic","notes":["The mock-condolence setup in `நிலையில்லா வாழ்வு` is kept intact."]}},
    {"id":"manohara-en-s041-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Then I...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Step aside a little, my boy...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u029","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/scenes/scene-041.md","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"Manoharan enters in Akshayan's guise."},"speaker_label":null,"page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"[Manoharan enters in Akshayan's guise.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Hey, new physician... what all do you know?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s041-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"அட்","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Without even giving medicine, I'll put an end to the disease!","mode":"prose-faithful","notes":["The ominous joke in `ஒரு முடிவு கட்டுவேன்` is left intact."]}},
    {"id":"manohara-en-s041-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s041","archival_scene_ordinal":41,"source":{"source_path":"works/manohara/dialogues/records/scene-041.json","canonical_scene_path":"works/manohara/scenes/scene-041.md","source_record_id":"manohara-s041-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":67,"printed_page":66}]},"translation":{"english_text":"Then... you're the new physician, no doubt... hey, old physician, you run...","mode":"prose-faithful","notes":["Vasanthan's recurring `சந்தேகமில்லே` refrain is retained as `no doubt`." ]}}
  ]
}
