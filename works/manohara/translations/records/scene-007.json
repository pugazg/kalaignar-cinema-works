  "units": [
    {"id":"manohara-en-s007-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/scenes/scene-007.md","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-parenthetical-location","ordinal":1,"description":"Opening location direction at Manoharan's mansion; the following decorative stars remain structural."},"speaker_label":null,"page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"(At Manoharan's mansion.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்யசீலர்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Deceit has never lived... cruelty has never endured... Listen to this! The celebration is being held for you... you must come to the celebration...","mode":"prose-faithful","notes":["The parallel opening clauses and repeated pauses are retained as part of Sathyaseelar's admonitory cadence."]}},
    {"id":"manohara-en-s007-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"A celebration for me. Wholeheartedly? No... for the sake of convention!","mode":"prose-faithful","notes":["The clipped rhetorical question is preserved rather than merged into an explanatory sentence."]}},
    {"id":"manohara-en-s007-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Wrong, Manohara! Purushothaman is not a man without a father's affection for his son.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"It is your wish that he should not lose even that affection! But Father is being poisoned, atom by atom.","mode":"prose-faithful","notes":["`அணு அணுவாக` is carried literally as `atom by atom` to preserve the source image of gradual corruption."]}},
    {"id":"manohara-en-s007-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Whatever it may be, others should not speak this way of dissension within the royal family.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"A noble thought! But it ought to have dawned on that woman who ruins the land.","mode":"prose-faithful","notes":["The sarcastic opening and Manoharan's harsh `ஊர் கெடுப்பவள்` description are retained."]}},
    {"id":"manohara-en-s007-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Manohara! Your birthday... if you are not there...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"The king will not worry... while that Anandavalli is beside him!","mode":"prose-faithful","notes":["`ஆனந்தவல்லி` is retained as the source's pointed name-like taunt rather than silently replaced with Vasantha Sena."]}},
    {"id":"manohara-en-s007-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Hmm... both of you are being flippant!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Teaching calm is indeed the nature of the wise! But crouching subdued like a tortoise is not the nature of warriors! That woman with the bewitching tongue will come; and my mother must come there too—impossible! I cannot bear to see it!","mode":"prose-faithful","notes":["The wise/warrior contrast and tortoise image are kept intact instead of paraphrased into generic impatience."]}},
    {"id":"manohara-en-s007-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Manohara!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Amma!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s007-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/dialogues/records/scene-007.json","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":"manohara-s007-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"My dear... I came listening all along! Even Rajapriyan flared up—why? Minister... Manoharan will certainly come to the play...","mode":"prose-faithful","notes":["Padmavathi's affectionate address and her quiet assertion of authority are kept in the same cadence."]}},
    {"id":"manohara-en-s007-u015","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s007","archival_scene_ordinal":7,"source":{"source_path":"works/manohara/scenes/scene-007.md","canonical_scene_path":"works/manohara/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"closing-parenthetical-stage-direction","ordinal":1,"description":"Closing source action after Padmavathi says Manoharan will attend the play."},"speaker_label":null,"page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"(Manoharan falls silent.)","mode":"prose-faithful","notes":[]}}
  ]
}
