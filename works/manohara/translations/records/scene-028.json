  "units":[
    {"id":"manohara-en-s028-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/scenes/scene-028.md","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-location-action","ordinal":1,"description":"A part of the palace; the physician is giving medicine to Vasanthan."},"speaker_label":null,"page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"A part of the palace. The physician is giving medicine to Vasanthan......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்தியன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Hmm... you must take it......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Hey—physician! What's the name of this medicine?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்தியன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Suyabuddhi Chooranam......","mode":"prose-faithful","notes":["The comic medicine-name `சுயபுத்தி சூரணம்` is transliterated rather than replaced with a modern diagnosis; literally it suggests a powder for one's own sense/wits."]}},
    {"id":"manohara-en-s028-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"What is it made from—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்தியன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"It is made with grapes, honey, rock candy and sugar.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Then will it be bitter?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Uh-huh... a little sour; and I've added a couple of chillies too.","mode":"prose-faithful","notes":["The source's colloquial comic phrasing is retained rather than medicalized."]}},
    {"id":"manohara-en-s028-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Physician!... what disease do I have, man—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"An incurable disease...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s028-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/scenes/scene-028.md","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"physical-page-continuation","ordinal":1,"description":"The exchange continues onto PDF 40."},"speaker_label":null,"page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"[The exchange continues.]","mode":"prose-faithful","notes":["This unit marks the source's physical continuation without inventing a new scene ending or beginning."]}},
    {"id":"manohara-en-s028-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s028","archival_scene_ordinal":28,"source":{"source_path":"works/manohara/dialogues/records/scene-028.json","canonical_scene_path":"works/manohara/scenes/scene-028.md","source_record_id":"manohara-s028-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Hmm—that's what I thought! Everyone keeps saying mad, mad—Vikata! Did you hear? I haven't got any madness at all! It's an incurable disease!","mode":"prose-faithful","notes":["The joke depends on Vasanthan taking `incurable disease` as proof that he is not mad; the comic logic is preserved."]}}
