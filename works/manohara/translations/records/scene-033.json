{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source_scene_number":null,"scene_status":"verified","unit_count":50,
  "units":[
    {"id":"manohara-en-s033-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/scenes/scene-033.md","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Padmavathi's room."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"[Padmavathi's room.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"She said that? And the king simply stood there listening? Was Satyaseelar there then, Vijaya?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"He was.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"It was a mother's command that stopped Manoharan. What stopped Satyaseelar...... Did his voice tremble so that he could not speak against that cruelty? Or did cowardice take up residence in his heart? (To the attendant) Call Satyaseelar... go at once... bring him now!","mode":"semantic-poetic","notes":["The voice/heart parallel accusation is retained."]}},
    {"id":"manohara-en-s033-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/scenes/scene-033.md","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-direction","ordinal":1,"description":"Vasantha Sena looks at Ugrasenan's picture in the pendant on her pearl necklace."},"speaker_label":null,"page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"[Vasantha Sena looks at Ugrasenan's picture in the pendant on her pearl necklace.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"What is it, Amma... why that now...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Haven't I told you... this is the god who gives a hand in danger.","mode":"prose-faithful","notes":["The ironic `god who helps in danger` image for Ugrasenan's portrait is preserved."]}},
    {"id":"manohara-en-s033-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Its help isn't needed now at all.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Leave that... the news you brought...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Manoharan is in a fury. The queen too, after hearing what happened, is terribly shaken......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Don't pile it up... tell me quickly.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"They have sent an attendant to bring Satyaseelar at once.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"At this hour?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Yes...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"In the darkness?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Yes...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Satyaseelar is coming to Padmavathi's inner chamber... at night...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"To inquire about the spring-festival incident,","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே.","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"I know, girl... I know why he has been summoned... I know that... that is what must be turned around...\nDarkness! Padmavathi's inner chamber! Satyaseelar there! It must be seen with his own eyes! By whom? By whom, girl? We must arrange for the king to see it... we must find a way... come...","mode":"semantic-poetic","notes":["The clipped darkness/chamber/Satyaseelar plotting cadence is retained."]}},
    {"id":"manohara-en-s033-u020","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/scenes/scene-033.md","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-action","ordinal":2,"description":"At the king's room, Vasantha Sena's attendant knocks on the door."},"speaker_label":null,"page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"[At the king's room, Vasantha Sena's attendant knocks on the door.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Maharaja... Maharaja, danger... open the door, Maharaja... everything will be ruined... danger, Maharaja!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"What is this?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Maharaja! Ayyo...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Tell me what happened...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோ","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Vasantha Sena Amma... she's put up a noose...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோ","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"She's going to die... only if we hurry can we save her...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Where?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோ","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"She went this way...... Ayyo...... Amma......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u030","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/scenes/scene-033.md","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"staged-suicide-action","ordinal":1,"description":"They run; beneath a tree Vasantha Sena stands as though preparing to hang herself."},"speaker_label":null,"page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"[They run. Beneath a tree Vasantha Sena stands as though preparing to hang herself.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சேனை","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Lord...... take this servant into your sacred feet. All the loyalty I showed the king has become water poured upon barren grass... he is not at fault... it is my fate—I alone must endure it.","mode":"semantic-poetic","notes":["The `water poured on barren grass` image is retained rather than generalized as wasted devotion."]}},
    {"id":"manohara-en-s033-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Che! Che? (He runs in.) Vasanthi!... what have you done... what madness is this?","mode":"prose-faithful","notes":["The source-attached running cue remains inside the linked turn."]}},
    {"id":"manohara-en-s033-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"No... this is the reward true love has received, Maharaja... I do not wish to remain alive even for a moment longer. I shall close my eyes before your very eyes. That alone is supreme bliss for me, Prabhu!","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s033-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Vasanthi... don't...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Leave me, Prabhu!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":45,"printed_page":44}]},"translation":{"english_text":"Vasanthi... don't... come here.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Leave me—Maharaja—one request at the threshold of death. Please fulfil it. Do not let the slur ‘Vasantha killed herself’ fall upon you. You yourself kill me—here (she shows the dagger). Plunge this into my heart that carries your memories. I shall not think of it as a knife-thrust. I shall think of it as the last kiss given by my beloved. Hmm... do not hesitate—why the hesitation, Swami?...","mode":"semantic-poetic","notes":["The knife/last-kiss reversal is retained without softening its theatrical register."]}},
    {"id":"manohara-en-s033-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Vasanthi... have you lost your senses?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"After losing your love, for whom should I live?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Vasanthi... I said it in anger...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Fine anger... if we had delayed a little, a killing would have happened by now... all who live by deceiving must go to the world of bliss... and you must go to Yama's world... fine justice this is, Amma...","mode":"prose-faithful","notes":["The Inba-lokam/Yama-lokam contrast is retained rather than generalized to heaven/hell."]}},
    {"id":"manohara-en-s033-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Fie... why are you philosophizing, girl... without even the respect to remember that we are speaking to the Maharaja?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"My heart is boiling, Amma... the queen too...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"What...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Shut your mouth... get out of here...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோ","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Beat me... kill me, I don't care. One day or another the truth will come out... the thief of many days, one day...","mode":"prose-faithful","notes":["The proverb is left deliberately incomplete because the source stops after `ஒரு நாள்...`."]}},
    {"id":"manohara-en-s033-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Malini... you will not go......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"I cannot... come and see the queen's inner chamber! What business does Satyaseelar have there at midnight?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Ayyo! Ayyo?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s033-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s033","archival_scene_ordinal":33,"source":{"source_path":"works/manohara/dialogues/records/scene-033.json","canonical_scene_path":"works/manohara/scenes/scene-033.md","source_record_id":"manohara-s033-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Ah!...... Is that so... truly?... (He runs. Vasanthi and the attendant laugh.)","mode":"prose-faithful","notes":["The source-attached exit and conspirators' laughter remain inside the linked turn."]}}
  ]
}