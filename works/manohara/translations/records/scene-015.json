{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source_scene_number":null,"scene_status":"verified","unit_count":26,
  "units":[
    {"id":"manohara-en-s015-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/scenes/scene-015.md","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-parenthetical-stage-direction","ordinal":1,"description":"Night at Manoharan's camp-house."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"(Night. Manoharan's camp-house.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/scenes/scene-015.md","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Bauthayanan raises a dagger to kill the sleeping Manoharan."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Bauthayanan raises a dagger to kill the sleeping Manoharan.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/scenes/scene-015.md","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Vijaya enters in soldier's dress with a drawn sword and involuntarily cries out."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"At that moment Vijaya enters in a soldier's dress, unseen by anyone, with a drawn sword, and without realizing it cries out, ‘Oh!’","mode":"prose-faithful","notes":["The source embeds the cry inside the stage narration rather than printing a speaker label, so no dialogue identity is created."]}},
    {"id":"manohara-en-s015-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/scenes/scene-015.md","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Manoharan wakes and catches Vijaya's hand."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Manoharan wakes, catches Vijaya's hand—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Who are you?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":28,"printed_page":27},{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"I am neither a ghost given another life in the cremation-ground you created, nor a corpse! I am one among the enemies who escaped your sight—a warrior of the Pandiyan land!","english_page_segments":[{"pdf_page":28,"printed_page":27,"english_text":"I am neither a ghost given another life in the cremation-ground you created, nor a corpse! I am one among the enemies who escaped your sight—"},{"pdf_page":29,"printed_page":28,"english_text":"a warrior of the Pandiyan land!"}],"mode":"prose-faithful","notes":["The genuine PDF 28→29 utterance remains one English unit."]}},
    {"id":"manohara-en-s015-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"A warrior of the Pandiyan land! Hmm... it seems the first lesson under Muthu Vijayan's rule is military training in lurking and pouncing at midnight, you spineless fellow. Is one of those men left who carry a sword in the hand and cowardice in the heart? Run away... save your life...","mode":"prose-faithful","notes":["The hand/sword and heart/cowardice antithesis is preserved."]}},
    {"id":"manohara-en-s015-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Manohara!... We must not let him go...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Let the poor fellow go... I have forgiven him.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Ours is not a tradition that begs forgiveness...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"A tradition of attacking from hiding... great warrior!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Those who cut off a sleeping man's head are warriors too—in the schools of the Pandiyan land! Get out, you worthless coward!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Coward... am I a coward! Look here... I shall take my revenge openly, right now....","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/scenes/scene-015.md","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-action","ordinal":1,"description":"Vijaya draws her sword; as Manoharan stops her, her headcloth slips away."},"speaker_label":null,"page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"[She draws her sword. As Manoharan stops her, her headcloth slips away.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Ah! A woman!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Your enemy's daughter... the woman who came for revenge...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Princess!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"A marvellous sight—a sword in hands that wear bangles!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Do not talk!... If you are a warrior, speak after you defeat me!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"History has no record of warriors defeating spear-eyed women, Princess!","mode":"prose-faithful","notes":["The `வேல்விழி` spear-eye image is retained."]}},
    {"id":"manohara-en-s015-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"No need for mockery... draw your sword.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"My sword plays only on the battlefield... it does not bruise fruit!","mode":"prose-faithful","notes":["The source's fruit image is retained rather than domesticated into a generic chivalric phrase."]}},
    {"id":"manohara-en-s015-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"If you have courage—if all that talk about the marks of a warrior was not mere tongue-play—swing your sword... let a good judgement be delivered....","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"A good judgement... will not be delivered by the sword-point. From now on it must be obtained in the court of law! Tender creeper born of the Pandiyan, you are now a prisoner—a prisoner under protection! Rajapriya! Take her away!","mode":"prose-faithful","notes":["The `பைங்கொடி` tender-creeper image is preserved."]}},
    {"id":"manohara-en-s015-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"There is our flag at the fort gate! A flag announcing that Princess Vijaya is Manoharan's slave!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s015-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s015","archival_scene_ordinal":15,"source":{"source_path":"works/manohara/dialogues/records/scene-015.json","canonical_scene_path":"works/manohara/scenes/scene-015.md","source_record_id":"manohara-s015-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Do not speak! I lived as a princess—I will not live as a slave. I roamed like a skylark—I will not be caught in the cruel grip of vultures. I floated in the breeze of freedom—I will not be trapped in the cyclone of slavery. The lap of death is far better than the feet of an enemy.","mode":"prose-faithful","notes":["The skylark/vulture, breeze/cyclone and feet/lap parallel imagery is preserved."]}}
  ]
}
