  "units":[
    {"id":"manohara-en-s037-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/scenes/scene-037.md","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"The palace."},"speaker_label":null,"page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"[The palace.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலாளி","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Maharaja! The prince has escaped.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Ah! Manoharan escaped?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலாளி","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Yes... someone loosened the bonds and saved him; we could not even see them with our eyes.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Disaster has begun to grow, Prabhu! Search the entire city; wherever that destroyer is, seize him and bring him here.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Hmm... go.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/scenes/scene-037.md","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":2,"description":"The cave; Manoharan is there after being rescued."},"speaker_label":null,"page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"[The cave.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Impossible, Amma... impossible... (looking around) What is this... I, who was killed, am alive...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரிவர்மன்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Prince!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Who are you... who are you... Satyaseelar! Who is this man?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்யசீலர்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"I shall tell you the details later... he is the one who saved you.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Saving me...... saving Manoharan... the king's wish... Mother's loving command.... fulfil them at once... kill me... kill me... kill me, Rajapriya! My beloved friend... you at least carry out my mother's command.","mode":"semantic-poetic","notes":["The repeated kill-me cadence and contradictory king/mother commands remain explicit."]}},
    {"id":"manohara-en-s037-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்ய","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Wait, Manohara!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Manohara... because a mother's word must not be broken, will you let the mother who sits in prison die abandoned?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Ah! Amma is in prison...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Not only Amma... Vijaya too...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Ah...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s037-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s037","archival_scene_ordinal":37,"source":{"source_path":"works/manohara/dialogues/records/scene-037.json","canonical_scene_path":"works/manohara/scenes/scene-037.md","source_record_id":"manohara-s037-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"At least now understand...... why you must live.","mode":"prose-faithful","notes":[]}}
  ]
}