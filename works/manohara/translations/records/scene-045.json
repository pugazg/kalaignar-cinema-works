  "units":[
    {"id":"manohara-en-s045-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/scenes/scene-045.md","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Corridor of the prison."},"speaker_label":null,"page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"[Corridor of the prison.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s045-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/dialogues/records/scene-045.json","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":"manohara-s045-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலன்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Hey, don't go that way... Vijaya Amma... she's in labour pains...","mode":"prose-faithful","notes":["The guard's colloquial register is retained."]}},
    {"id":"manohara-en-s045-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/scenes/scene-045.md","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":1,"description":"The source prints `ஆள்......அப்படியா......` without a speaker delimiter after the guard's line."},"speaker_label":null,"page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Man...... is that so......","mode":"prose-faithful","notes":["`ஆள்` remains inside the translated source text rather than being promoted to an inferred speaker label."]}},
    {"id":"manohara-en-s045-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/scenes/scene-045.md","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-transition","ordinal":1,"description":"Inside the prison."},"speaker_label":null,"page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"(Inside the prison.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s045-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/dialogues/records/scene-045.json","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":"manohara-s045-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"(Bending over the child) O treasure of my treasures! You who should have slept in a diamond-studded cradle, listening to Tamil music from a thousand nursemaids—I never even imagined you would be rolling here in a straw-filled pen...","mode":"semantic-poetic","notes":["The thousand nursemaids / Tamil music / diamond cradle versus straw-filled enclosure contrast is retained in full."]}},
    {"id":"manohara-en-s045-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/dialogues/records/scene-045.json","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":"manohara-s045-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Atthe!......","mode":"prose-faithful","notes":["The kinship address is retained rather than flattened to a generic English address."]}},
    {"id":"manohara-en-s045-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/dialogues/records/scene-045.json","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":"manohara-s045-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"My dear... daughter of the Pandiyan king...... did you come as my daughter-in-law to suffer like this......","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s045-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/dialogues/records/scene-045.json","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":"manohara-s045-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Only after I came, Atthe, have so many torments come upon you and your beloved son...... all of it only after this sinner set foot here........","mode":"semantic-poetic","notes":["Vijaya's self-blaming `பாவி` is retained rather than softened."]}},
    {"id":"manohara-en-s045-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s045","archival_scene_ordinal":45,"source":{"source_path":"works/manohara/dialogues/records/scene-045.json","canonical_scene_path":"works/manohara/scenes/scene-045.md","source_record_id":"manohara-s045-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Vijaya!... No, child... wherever your flower-feet touch, even earth turns to gold... you are not the one who turned the golden mansion into a mound of dust... she lives in bliss......","mode":"semantic-poetic","notes":["The flower-feet / earth-to-gold and golden-mansion / dust-mound contrasts are preserved."]}}
  ]
}
