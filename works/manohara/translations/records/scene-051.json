{"work_id":"manohara","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source_scene_number":null,"scene_status":"verified","unit_count":20,"units":[{"id":"manohara-en-s051-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/scenes/scene-051.md","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Palace."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"[Palace.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சிப்பாய்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Maharaja! Akshayan has come. He says he wishes to see you.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"He has come?... Tell him to come here.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/scenes/scene-051.md","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":1,"description":"Colon-only line following Vasantha Sena's order to admit Akshayan."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"He must have come with news of victory. He must have killed Vijaya's child and returned. This reward is for him.","mode":"prose-faithful","notes":["Empty source speaker field; no speaker is inferred."]}},{"id":"manohara-en-s051-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/scenes/scene-051.md","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":2,"description":"Second consecutive colon-only source line."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Your commander is very cunning.","mode":"prose-faithful","notes":["Empty source speaker field; no speaker is inferred."]}},{"id":"manohara-en-s051-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ரசேனன்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"What doubt is there about that? Oh... come... Akshaya, come...","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/scenes/scene-051.md","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":3,"description":"Colon-only question immediately before the real Akshayan enters."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"What is it, Akshaya?","mode":"prose-faithful","notes":["Empty source speaker field; no speaker is inferred."]}},{"id":"manohara-en-s051-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/scenes/scene-051.md","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"The real Akshayan enters."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"[The real Akshayan enters.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Who is he? Akshayan?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Yes.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Ah! No.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"அட்சயன்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"I am the real Akshayan. The one who deceived you all this while was a false Akshayan, madam!","mode":"prose-faithful","notes":["The source semicolon delimiter is preserved in the immutable record; translation does not regularize it."]}},{"id":"manohara-en-s051-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/scenes/scene-051.md","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-line","ordinal":4,"description":"Colon-only continuation after the real Akshayan identifies himself."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Yes... Maharaja! They tied me up. I have only just escaped and come.","mode":"prose-faithful","notes":["Empty source speaker field; no speaker is inferred even though context strongly suggests Akshayan."]}},{"id":"manohara-en-s051-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"They tied you up? Who?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"அட்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Manoharan!","mode":"prose-faithful","notes":["The source semicolon delimiter remains source metadata and is not silently normalized."]}},{"id":"manohara-en-s051-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Ah! Manoharan! Then the Akshayan who is here?","mode":"prose-faithful","notes":["The source semicolon delimiter remains source metadata and is not silently normalized."]}},{"id":"manohara-en-s051-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"அட்","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Manoharan!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Where is he......","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சேனா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"He has gone to the prison.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s051-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s051","archival_scene_ordinal":51,"source":{"source_path":"works/manohara/dialogues/records/scene-051.json","canonical_scene_path":"works/manohara/scenes/scene-051.md","source_record_id":"manohara-s051-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"We must not let him go.","mode":"prose-faithful","notes":[]}}]}