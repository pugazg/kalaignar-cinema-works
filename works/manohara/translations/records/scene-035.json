{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source_scene_number":null,"scene_status":"verified","unit_count":14,
  "units":[
    {"id":"manohara-en-s035-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/scenes/scene-035.md","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Padmavathi's room."},"speaker_label":null,"page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Padmavathi's room.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Mother must go to prison... Manoharan must apologize!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"And that too in the royal hall, before that owl from the rubbish heap!","mode":"prose-faithful","notes":["`குப்பை மேட்டுக் கோட்டான்` is kept close to its concrete comic insult rather than replaced by a generic slur."]}},
    {"id":"manohara-en-s035-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"The one giving the order is Father!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Yes, my dear! Do not forget that—the father who begot you.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Father... he gained a fearless-hearted son... he gained a wife of rare virtue... there is one thing he forgot to gain, Mother! Sense! Sense! That alone he forgot to gain!","mode":"semantic-poetic","notes":["The repeated `அறிவு! அறிவு!` is retained for Rajapriyan's punchline."]}},
    {"id":"manohara-en-s035-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"I shall remind him of what he forgot...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"I am telling you that you cannot, my treasure! Appa may have erred in haste... whatever it is, go and ask the reason!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Ask the reason?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Athai... no... do not send him... no, Athai... do not send him... no, Athai... that is it—you must not go...","mode":"prose-faithful","notes":["The repeated pleading is preserved rather than compressed."]}},
    {"id":"manohara-en-s035-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Brave son... go and return...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"No, Athai!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Vijaya!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s035-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s035","archival_scene_ordinal":35,"source":{"source_path":"works/manohara/dialogues/records/scene-035.json","canonical_scene_path":"works/manohara/scenes/scene-035.md","source_record_id":"manohara-s035-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"I shall go and return. [To the soldiers who have come to arrest Padmavathi] Beware! Until I return, you must not go near my mother...\n[To Vijaya]\nVijaya! Take care of her... I am going.","mode":"prose-faithful","notes":["Both source-attached address cues remain inside the immutable linked record."]}}
  ]
}