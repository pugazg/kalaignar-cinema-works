    {"id":"manohara-en-s020-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"I brought it—the war-sword!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Shabash!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Ammani!... Manoharan returned victorious... and even married Vijaya...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Then...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Listen—they held a swimming game. I made Vijaya a widow and came back with the sword.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Manoharan is dead?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Certainly!... Ammani! The reward money!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Here!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/scenes/scene-020.md","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-action","ordinal":1,"description":"Vasantha Sena gives him the sack of gold."},"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"[She gives him the sack of gold.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s020-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/scenes/scene-020.md","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-dialogue-continuation","ordinal":1,"description":"After handing over the gold, the source prints the next plan without a speaker label; context suggests Vasantha Sena but metadata remains unlabelled."},"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Bauthayanar!... one more task... two hunts with a single aim! If you tell Padmavathi this news, her heart will burst and she will die... after that... I alone am the queen!... you are the Prime Minister!...","mode":"prose-faithful","notes":["No speaker is manufactured because the booklet prints no label on this block."]}},
    {"id":"manohara-en-s020-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s020","archival_scene_ordinal":20,"source":{"source_path":"works/manohara/dialogues/records/scene-020.json","canonical_scene_path":"works/manohara/scenes/scene-020.md","source_record_id":"manohara-s020-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Prime Minister?... Then I'll do anything you want...","mode":"prose-faithful","notes":[]}}
