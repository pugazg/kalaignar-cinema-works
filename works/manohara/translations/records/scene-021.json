{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source_scene_number":null,"scene_status":"verified","unit_count":45,
  "units":[
    {"id":"manohara-en-s021-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-location-heading","ordinal":1,"description":"Padmavathi's inner chamber."},"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Padmavathi's inner chamber.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி 1","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Hmm... weariness from war—delight with a new wife—how will he come quickly, Amma...!","mode":"prose-faithful","notes":["The `களைப்பு / களிப்பு` fatigue/delight pairing is retained."]}},
    {"id":"manohara-en-s021-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"My heart is restless with the desire to see Vijaya!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி 2","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Amma... some renunciant says he must see you, urgently!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-entrance","ordinal":1,"description":"Bauthayanan enters disguised as a renunciant."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"(Bauthayanan enters in the guise of a renunciant.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Greetings...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"துறவி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"May you live in well-being... Maharani... first make your heart into iron...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"What?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"துறவி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"The news I am about to utter is no sugarcane! Hmm... human life is but a straw in the sea, Amma!","mode":"prose-faithful","notes":["The source's `கரும்பு / துரும்பு` sound-play is represented through the literal sugarcane/straw images even though the Tamil rhyme cannot be reproduced exactly."]}},
    {"id":"manohara-en-s021-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"What, Sami; you speak without any connection.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"துறவி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"A renunciant is one without ties, is he not!... How greatly you must have rejoiced on hearing that your son had won...","mode":"prose-faithful","notes":["The `தொடர்பு / தொடர்பற்ற` connection/ties pun is preserved semantically."]}},
    {"id":"manohara-en-s021-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Yes, Swami!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"துறவி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Why does the same heart that embraces happiness refuse to face sorrow?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Swami... what has happened... tell me!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"துறவி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Here... this war-sword will tell you...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"துறவி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Your son has gone... to the world of merit!...","mode":"prose-faithful","notes":["`புண்ணியலோகம்` is kept as the religious image 'world of merit'."]}},
    {"id":"manohara-en-s021-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Ah... Manohara!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-offstage-speech","ordinal":1,"description":"The source prints `வந்துவிட்டேனம்மா` without a speaker label before saying a voice is heard."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"I've come, Amma.","mode":"prose-faithful","notes":["No speaker identity is manufactured despite the immediate dramatic reveal."]}},
    {"id":"manohara-en-s021-u020","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-reaction-stage-direction","ordinal":1,"description":"A voice is heard; Padmavathi, leaning on her companion, starts and turns in disbelief."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"[A voice is heard. Leaning on her companion, she starts and turns, unable to believe her eyes.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-exclamation","ordinal":1,"description":"The source prints `மனோகரா!` in quotation marks without a speaker label."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"‘Manohara!’","mode":"prose-faithful","notes":["Context strongly suggests Padmavathi, but the source prints no label and none is invented."]}},
    {"id":"manohara-en-s021-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"She embraces Manoharan and looks at him in astonishment."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"She embraces Manoharan and looks at him in astonishment...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":34,"printed_page":33},{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Why are you looking at me like this, Amma... what happened...? Who is this Sami?... (Seeing the war-sword in his hand) Ah... my war-sword... it went missing... how did it come here...?","english_page_segments":[{"pdf_page":34,"printed_page":33,"english_text":"Why are you looking at me like this, Amma... what happened...? Who is this Sami?... (Seeing the war-sword in his hand)"},{"pdf_page":35,"printed_page":34,"english_text":"Ah... my war-sword... it went missing... how did it come here...?"}],"mode":"prose-faithful","notes":["The genuine PDF 34→35 dialogue crossing remains one unit; the embedded stage cue stays inside the immutable dialogue-linked record."]}},
    {"id":"manohara-en-s021-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Manohara! This sinner told me you had left me forever...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Thieving rogue!... Not only has he stolen the sword... has he stretched out a tail too? Look at the beard, the beard!","mode":"prose-faithful","notes":["The Tamil `வாள் / வால்` sword/tail sound-play is represented directly."]}},
    {"id":"manohara-en-s021-u026","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-action","ordinal":1,"description":"When the beard is grabbed, it comes away in the hand."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"[When the beard is grabbed, it comes away in the hand.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Bauthayanan...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜ","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"A new chapter in conspiracy—steal the war-sword and bring it to show her... the Maharani will die. A fine plot...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Scorpion's sting!... Whose plan is this, you wretch!... Speak...","mode":"prose-faithful","notes":["The source insult `தேளின் கொடுக்கே` is retained as an image rather than replaced with a generic curse."]}},
    {"id":"manohara-en-s021-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Manohara, poor fellow... let him go...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"We must not let him go, Amma... Rajapriya... lock him in prison!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Vasantha Sena is the cause of everything!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Vasantha Sena! She must not be left alive any longer!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u034","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/scenes/scene-021.md","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-stage-action","ordinal":2,"description":"Manoharan goes."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"(He goes.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Manohara! Stop—where are you running?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Amma, what more now—after I have fulfilled your vow!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"I'll tell you. First, ‘put the sword into its sheath!... swear that without my permission you will do no kind of harm either to the Maharaja or to Vasantha Sena!... swear upon me...","mode":"prose-faithful","notes":["The source's opening quotation mark is retained in the English phrasing without inventing a closing quotation absent from the source record."]}},
    {"id":"manohara-en-s021-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Amma!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Swear upon your mother!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"I will do nothing to the king, Amma.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"No! It must include Vasantha Sena too!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Vasantha Sena... the vulture circling overhead!... the wolf standing with its jaws agape!... the mountain-python that has coiled around us—mercy for her—??? Impossible! Never!...","mode":"prose-faithful","notes":["The source's `???` uncertainty marks are preserved rather than silently repaired.","The vulture/wolf/python accumulation is kept intact."]}},
    {"id":"manohara-en-s021-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"As you wish... let the townspeople laugh that you are a son who does not heed his mother's word!... let the country laugh that I am the mother who bore an ungovernable son!...","mode":"prose-faithful","notes":["The paired townspeople/country and son/mother reproach is preserved."]}},
    {"id":"manohara-en-s021-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Ayyo... it is nothing like that, Amma... here, I swear it now.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s021-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s021","archival_scene_ordinal":21,"source":{"source_path":"works/manohara/dialogues/records/scene-021.json","canonical_scene_path":"works/manohara/scenes/scene-021.md","source_record_id":"manohara-s021-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"My son!...","mode":"prose-faithful","notes":[]}}
  ]
}
