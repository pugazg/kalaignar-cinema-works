{"work_id":"manohara","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source_scene_number":null,"scene_status":"verified","unit_count":30,"units":[{"id":"manohara-en-s053-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/scenes/scene-053.md","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-action","ordinal":1,"description":"Manoharan is tied to a pillar."},"speaker_label":null,"page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"[Manoharan is tied to a pillar.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தசேனை","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Manohara! Everyone has been able to bind only your body; they could not bind your life. Very soon it will gain its freedom and go to another world!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Mother! [Ugrasenan strikes him.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Mother!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ரசேனன்","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Hmm! Ayyo, pity—this babbling child is calling for his mother.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Mother!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"Pitiful creature! Why call your mother until your mouth aches? Wait a little! I shall send you to the very otherworld where your grandmother is.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":80,"printed_page":79}]},"translation":{"english_text":"No. First the child! Then Manoharan! His own jewel must be killed right before his eyes. Nurse! Go! Bring the child;","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/scenes/scene-053.md","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"Vasanthan enters."},"speaker_label":null,"page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"[Vasanthan enters.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Anna, what is this? Who tied you up?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Vasantha...","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"உக்ர","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Come here.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"No... all this is your doing, isn't it! Mother... untie Anna! Hmm!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Vasantha... keep quiet. You know nothing.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"I know everything. You put my beloved father, Periyamma and Anni all in prison; then you tied Anna too and started beating him. I cannot allow this.","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Anna...","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Vasantha...","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Anna!......","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Vasantha, come this way.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Anna, break all those chains...... let me go, Mother!\n\n[She drags him into a room.]\n\nLet me go... let me go.","mode":"prose-faithful","notes":["The source-unlabelled continuation after the dragging action remains inside the preceding explicit Vasanthan record."]}},{"id":"manohara-en-s053-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Keep quiet. I am doing everything only for your good.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Ah! Tying up Anna and killing him—is that for the younger brother's good?","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"My dear, don't you want to be king?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"King? No! No. Then some queen will come to you and throw you in prison! Let me die if I must. I don't want that throne, Mother!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s053-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"It is all my fate! Of all things, you had to be born from my womb!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"That's exactly what I worry about too.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":81,"printed_page":80}]},"translation":{"english_text":"Shut your mouth.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"I can't.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"You can't?","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s053-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s053","archival_scene_ordinal":53,"source":{"source_path":"works/manohara/dialogues/records/scene-053.json","canonical_scene_path":"works/manohara/scenes/scene-053.md","source_record_id":"manohara-s053-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Mother! Mother! [She shuts the door and leaves.]","mode":"prose-faithful","notes":[]}}]}