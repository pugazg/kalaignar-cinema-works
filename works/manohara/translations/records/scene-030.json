  "units":[
    {"id":"manohara-en-s030-u001","kind":"song-reference","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":"manohara-song-006","source_locator":{"kind":"opening-performance-reference","ordinal":1,"description":"Spring-festival celebration; songs; Manoharan and Vijaya sing. No song title or full lyric body is printed."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Spring-festival celebration. Songs... Manoharan and Vijaya sing.","mode":"prose-faithful","notes":["Linked only to the source-visible unnamed performance occurrence `manohara-song-006`; no absent lyrics are supplied."]}},
    {"id":"manohara-en-s030-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"May this love never, ever change...","mode":"semantic-poetic","notes":["The repeated `மாறவே மாறாதே` emphasis is retained."]}},
    {"id":"manohara-en-s030-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"What kind of question is this, Vijaya!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"No... if you too, like Uncle... were to fall under the spell of some Vasantha Sena—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Vasantha Sena. Do not even utter her name to me!......... That dog in the place where my mother should be......... Unless I make her writhe like a worm fallen into burning embers—and seat my mother in the royal hall... I am not Manoharan.","mode":"prose-faithful","notes":["The dog/ember-worm imagery and oath-like ending are preserved at full force."]}},
    {"id":"manohara-en-s030-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"reaction-action","ordinal":1,"description":"Vijaya starts and rises."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Vijaya starts and rises...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"comic-reveal-action","ordinal":1,"description":"Vasanthan rises from beneath the seat."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Vasanthan rises from beneath the seat.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"You stepped on my foot, Anni!","mode":"prose-faithful","notes":["`அண்ணி` is retained as Anni to preserve the family-address register."]}},
    {"id":"manohara-en-s030-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Hey, were you hiding here?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Hmm... if all the women beat you with water and flowers, water-flowers and flower-water, flower-water and water-flowers, you'd hide too!","mode":"prose-faithful","notes":["The intentionally repetitive water/flower word-loop is preserved as comic nonsense rather than rationalized."]}},
    {"id":"manohara-en-s030-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"(Laughing...) Brave man...","mode":"prose-faithful","notes":["The source-attached laugh remains inside the linked utterance."]}},
    {"id":"manohara-en-s030-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"reaction-action","ordinal":2,"description":"Vijaya also laughs."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Vijaya also laughs......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Laugh... laugh...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u016","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"Vasantha Sena approaches with the king."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Vasantha Sena approaches with the king......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Vasantha!... Vasantha!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"I'm here, Amma... what, Amma...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"arrival-cue","ordinal":1,"description":"They come there."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"[They come there.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Amma!... Anna and Anni are laughing at me!...","mode":"prose-faithful","notes":["Family-address terms are retained."]}},
    {"id":"manohara-en-s030-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"The town laughs at your brother because he took the Pandiyan's daughter in marriage. The whole world laughs at your Anni because she became wife to the man who killed her father...\n[Grinding her teeth]......\nThey laugh, do they...... I shall laugh away everything... come, you!...","mode":"prose-faithful","notes":["The source-attached teeth-grinding cue remains within the immutable linked turn."]}},
    {"id":"manohara-en-s030-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"You can't do all that, Amma!... Anna is going to make you writhe like a worm—be careful! He just told Anni that. My Anni!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"delivery-cue","ordinal":1,"description":"Vasantha Sena speaks mockingly."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"[Mockingly]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Hmm... a deed that even the mightiest warriors cannot accomplish is going to be accomplished by this whore's son...","mode":"prose-faithful","notes":["The source insult is translated directly rather than softened."]}},
    {"id":"manohara-en-s030-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Ah! What did you say?\n[He draws the dagger.]\nWatch me cut off that tongue which spat poison!...","mode":"prose-faithful","notes":["The source-attached dagger cue remains inside the linked record."]}},
    {"id":"manohara-en-s030-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Manohara! Let go.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Impossible. Even if you do not protect your wife's honour, I shall protect my mother's honour to the end.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Listen to what I say...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Impossible...... if you have the strength, protect her...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்யசீலர்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Manohara!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Athaan! The promise you gave Athai—","mode":"prose-faithful","notes":["Kinship terms `அத்தான்` and `அத்தை` are retained because a narrower English substitution would flatten the source register."]}},
    {"id":"manohara-en-s030-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Fie......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u033","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"violent-action","ordinal":1,"description":"Manoharan strikes Vijaya."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"[He strikes Vijaya.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Amma!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u035","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/scenes/scene-030.md","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"exit-action","ordinal":1,"description":"Manoharan leaves in confusion."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"[He leaves in confusion.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s030-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s030","archival_scene_ordinal":30,"source":{"source_path":"works/manohara/dialogues/records/scene-030.json","canonical_scene_path":"works/manohara/scenes/scene-030.md","source_record_id":"manohara-s030-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசன்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Vasanthi!... you have crossed the limit.","mode":"prose-faithful","notes":[]}},
