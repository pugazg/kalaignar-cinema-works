  "work_id":"manohara","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source_scene_number":null,"scene_status":"verified","unit_count":15,
  "units":[
    {"id":"manohara-en-s016-u001","kind":"song-reference","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/songs/inventory.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":"manohara-song-003","source_locator":{"kind":"named-song-reference","ordinal":1,"description":"Vijaya's inner chamber; the source names the song `வாழ்வதே மாது நான்`."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Vijaya's inner chamber — the song ‘I, a Woman, Live.’","mode":"semantic-poetic","notes":["Only the source-visible title/location reference is translated; no absent lyrics are supplied.","The occurrence's lyric authorship remains unresolved in the song evidence layer."]}},
    {"id":"manohara-en-s016-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/scenes/scene-016.md","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Vijaya tries to drink poison."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Vijaya tries to drink poison.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Vijaya! Suicide is cowardice!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Entering the women's inner chamber in the dark is greater cowardice still...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Never mind. I have saved a flowering creeper from the storm of death.","mode":"prose-faithful","notes":["The flower-creeper/death-storm image is retained."]}},
    {"id":"manohara-en-s016-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"No one need stop the death of this slave.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Slave? Who is a slave? You are a princess made of beauty itself...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/scenes/scene-016.md","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-entrance","ordinal":1,"description":"Rajapriyan enters as the conversation continues."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"(Rajapriyan enters.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"That is exactly why I say one must not enter the inner chamber at midnight!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Rajapriya! Do you know the news?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"I came knowing your news, didn't I! Manohara! This is a time to be on guard. Do not be deceived! A little while ago the princess was Yama himself coming to kill you!","mode":"prose-faithful","notes":["`எமன்` is retained as Yama rather than generalized to 'death'."]}},
    {"id":"manohara-en-s016-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"I too have a heart. Those who possess a good heart make a mistake only once.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Vijaya! You are one who must live. More than that, you are under my protection... I cannot permit such disastrous acts.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Life is not your slave. It was given by the Lord.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s016-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s016","archival_scene_ordinal":16,"source":{"source_path":"works/manohara/dialogues/records/scene-016.json","canonical_scene_path":"works/manohara/scenes/scene-016.md","source_record_id":"manohara-s016-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"The explanation for that—tomorrow, in the inquiry hall.","mode":"prose-faithful","notes":[]}}
  ]
}
