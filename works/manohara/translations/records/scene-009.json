{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source_scene_number":null,"scene_status":"verified","unit_count":45,
  "units":[
    {"id":"manohara-en-s009-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-bracketed-stage-direction","ordinal":1,"description":"Vasantha Sena's inner chamber; she paces angrily and two soldiers enter."},"speaker_label":null,"page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"[Vasantha Sena's inner chamber. Vasantha Sena rises and paces in fury... Two soldiers enter......]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Where... is the theatre troupe?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"We chased them on and on. They escaped......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Brave men! Shameless. Chi, run!......","mode":"prose-faithful","notes":["The opening `தைரியசாலிகள்!` is preserved as sarcastic praise."]}},
    {"id":"manohara-en-s009-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Why, Amma... the actors;","mode":"prose-faithful","notes":["The source trails off with a semicolon-like interruption; the English does not complete the thought."]}},
    {"id":"manohara-en-s009-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Yes?...... To give them a reward!.....","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"They do deserve one, Amma... even if the story exposed us, the acting was good!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Chi... what is this review of yours... go away, girl! Hmm!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-internal-monologue","ordinal":1,"description":"Source `(தனக்குள்)` block after Vasantha Sena dismisses her maid; no speaker label is printed."},"speaker_label":null,"page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"(To herself) The play... was written around me! Kesari Varman alive... Chee-chee, a corpse coming back to life... perhaps... the poison did not work properly......","mode":"prose-faithful","notes":["Context points to Vasantha Sena, but the source prints no speaker label and none is added to metadata."]}},
    {"id":"manohara-en-s009-u010","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-stage-direction","ordinal":1,"description":"The king enters after Vasantha Sena's internal monologue."},"speaker_label":null,"page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"(The king enters.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Prabhu!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-stage-direction","ordinal":2,"description":"The king sits with a foolish/awkward smile."},"speaker_label":null,"page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"(The king sits down with a foolish smile.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"No usual smile... you look worn... what is the reason, Swami?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Nothing...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Then why has that honeyed word ‘Kanne’ not fallen from your lips? Turmoil in your eyes... Kannala! Milk!...","mode":"prose-faithful","notes":["The source's intimate address words `கண்ணே` and `கண்ணாளா` are retained because Vasantha Sena is consciously performing sweetness."]}},
    {"id":"manohara-en-s009-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":19,"printed_page":18}]},"translation":{"english_text":"Milk?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Why, oh-ho! Has the play come back to mind?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Nothing like that...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Why speak through sighs? Ask me directly. My husband Kesari Varman... I had told you that, unable to bear seeing our love, he ran away from the town...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Yes! Now???","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"In the play Devasena poisons and kills her husband! And you too, believing it to be true......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-action-before-unlabelled-speech","ordinal":1,"description":"Vasantha Sena takes both cups in her hands before an unlabelled quoted fragment."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Taking both cups in her hands...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-dialogue-fragment","ordinal":1,"description":"Quoted fragment after the two-cup action; no speaker label is printed."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"‘Of these, whichever you wish, you may...’","mode":"prose-faithful","notes":["The source leaves the phrase unfinished and unlabelled; the English does the same."]}},
    {"id":"manohara-en-s009-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"No... you give me one...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"No, take whichever you prefer. Suspicion is a troublesome disease. A dagger that cuts a life of love apart... it turns even a warrior into a coward... here, take one... (then, thinking)... no, not even that... I will take both myself.","mode":"prose-faithful","notes":["The disease/dagger/warrior-coward rhetorical chain is preserved.","`சாப்பிடுகிறேன்` is rendered neutrally as `take both` because the source refers to the two offered cup portions rather than supplying a clear modern drinking verb."]}},
    {"id":"manohara-en-s009-u026","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-performance-direction","ordinal":3,"description":"Source `ஆச்சரியமாய்` cue after Vasantha Sena says she will take both."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"(In astonishment)......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Forgive me, Maharaja? For thirteen years I have lived as your chaste wife—I ask on the strength of that. Ornaments—life of luxury—royal pleasures—enough... please give me... saffron robes! A begging bowl in my hand! Do not refuse. Give me leave to go......","mode":"prose-faithful","notes":["The renunciation performance is kept as a sequence of abrupt demands rather than smoothed into a single request."]}},
    {"id":"manohara-en-s009-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Go...... you?...... where, my dear......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"The world is vast, Prabhu! In its crowds I will become a mere drop—I will spend my life chanting your name.","mode":"prose-faithful","notes":["The drop-in-the-crowd image and devotional performance are retained."]}},
    {"id":"manohara-en-s009-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"They have plotted to set fire to my happy life lying at your feet!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"A plot? Who?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"The Maharani herself!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Who... Padmavathi?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரியின் குரல்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"No... a brazen lie?... O king who rules the realm... do not be sacrificed to syrupy speech!","mode":"prose-faithful","notes":["`பச்சைப் புளுகு` / `பாகு மொழி` becomes `brazen lie` / `syrupy speech` to retain the contrast and rhetorical bite."]}},
    {"id":"manohara-en-s009-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Look, Swami, look...... What I heard is true...... They say the Maharani is even holding secret counsel...... to separate me from you......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"It does need looking into! (To the guard) Search and find who spoke here.","mode":"prose-faithful","notes":["The label-attached guard instruction remains inside the dialogue-linked unit."]}},
    {"id":"manohara-en-s009-u037","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/scenes/scene-009.md","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"parenthetical-stage-direction","ordinal":4,"description":"Soldiers run toward the direction from which the sound came."},"speaker_label":null,"page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"(The soldiers run toward the direction from which the sound came.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"A smear of civet on a festering wound! Patience—to sear away that evildoer's false disguise......... Enough, Amma, of all this endurance. Give the order. I will make that woman who ruins the land disappear without a trace!","mode":"prose-faithful","notes":["The source's dense alliterative `ப`-sequence cannot be mechanically reproduced in English, but its wound/perfume/false-mask imagery and accelerating force are retained."]}},
    {"id":"manohara-en-s009-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Manohara! Wait......","mode":"prose-faithful","notes":[]}},
