    {"id":"manohara-en-s009-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Amma! (A sweep of the sword) The masquerader Vasantha is finished!","mode":"prose-faithful","notes":["The source action attached to Manoharan's utterance remains inside the linked unit."]}},
    {"id":"manohara-en-s009-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Wait, my son... I ask you to engage in a holier task than that.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"What is it, Amma?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Do you know what sword this is?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s009-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s009","archival_scene_ordinal":9,"source":{"source_path":"works/manohara/dialogues/records/scene-009.json","canonical_scene_path":"works/manohara/scenes/scene-009.md","source_record_id":"manohara-s009-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Even in the play there was a sword like this... yes, I saw it......","mode":"prose-faithful","notes":[]}}
