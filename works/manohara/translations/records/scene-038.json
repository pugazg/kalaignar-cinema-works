  "work_id":"manohara","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source_scene_number":null,"scene_status":"verified","unit_count":56,
  "units":[
    {"id":"manohara-en-s038-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/scenes/scene-038.md","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Underground prison; Padmavathi and Vijaya."},"speaker_label":null,"page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"[Underground prison. Padmavathi and Vijaya.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"The strong man who could guard his own life and the king's life with the point of his sword ended by fleeing and saving his life. All this ruin has come from your good intention, Athai! Where has he gone? How is he wandering now!","mode":"semantic-poetic","notes":["The life/king's-life/sword contrast is preserved."]}},
    {"id":"manohara-en-s038-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Eat, Vijaya...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"No, Athai!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"A pregnant woman must not remain without eating. At least for the child growing in your womb, you have to eat... eat...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Athai... this gruel?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/scenes/scene-038.md","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":2,"description":"Vasantha Sena and Malini with fruit juice."},"speaker_label":null,"page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"[Vasantha Sena and Malini.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"It is wonderful...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"This fruit juice will make the body shine...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"I chose it knowing that, Malini! They say there was a beauty somewhere; to keep the sheen of her skin from fading, she would bathe in donkey's milk.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"What wonder is this, Amma... if you asked, Purushothaman would bring even tiger's milk...","mode":"prose-faithful","notes":["The donkey-milk/tiger-milk comic escalation is preserved."]}},
    {"id":"manohara-en-s038-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"What doubt is there about that, girl?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Leave that... why are you being so careless... Manoharan has escaped too. Shouldn't Vasanthan's coronation be conducted quickly?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"What great task is that, girl? I am the king's very Veda-book. If I say the moon is the sun, he is bound to believe it... do not worry! With one flick of my eye, Vasanthan's coronation will be finished!","mode":"semantic-poetic","notes":["The `king's Veda-book`, moon/sun and eye-flick boasting images are retained."]}},
    {"id":"manohara-en-s038-u015","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/scenes/scene-038.md","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"comic-durbar-setup","ordinal":1,"description":"The physician, Vikatan and Vasanthan rehearse a mock durbar/coronation."},"speaker_label":null,"page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"[The physician, Vikatan and Vasanthan begin a mock durbar rehearsal.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்தியர்","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"King of kings... Raja Marthanda...","mode":"prose-faithful","notes":["The mock royal honorific chain is retained rather than normalized into one generic title."]}},
    {"id":"manohara-en-s038-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"விகடன்","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Royal majesty... royal splendour...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Royal valour, courage, prowess...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Hero of the battlefield, brave warrior, champion...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Great King Vasantha who drinks thin gruel without salt—paraak! paraak!","mode":"prose-faithful","notes":["The lofty titles collapse into the saltless-gruel punchline; ceremonial `பராக்` is retained as `paraak`."]}},
    {"id":"manohara-en-s038-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Thom... thom... we came......","mode":"prose-faithful","notes":["The rhythmic nonsense is retained."]}},
    {"id":"manohara-en-s038-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"விகடன்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Vasantha! Look here... Amma will scold us, get up... it must look like a real durbar... you must do as I say... hmm... sit here, Maharaja!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/scenes/scene-038.md","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-empty-speaker-line","ordinal":1,"description":"The source prints only `:` before this instruction following Vikatan's setup."},"speaker_label":null,"page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Now you must say exactly as I tell you......","mode":"prose-faithful","notes":["No speaker is invented for the source-empty field."]}},
    {"id":"manohara-en-s038-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Now who are you?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Now who are you?","mode":"prose-faithful","notes":["Vasanthan parrots the prompt exactly, preserving the joke."]}},
    {"id":"manohara-en-s038-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Tch... answer me...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Tch... answer me...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Oh dear... answer me, Maharaja?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Oh dear... answer me, Maharaja!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"You're supposed to answer ‘Maharaja’!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Hmm... all right... all right... Maharaja!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Ah... I am the minister!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Hmm...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"விகட","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"And he is—(pointing to the physician)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"I know... I know...... Maharani...... come... come... sit...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Maharaja... he is the commander...... now who is the Maharani?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"There... we can make Malini the queen... come...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"(To Malini) Listen to me just a little... only for today you are Maharani... go and sit with the Maharaja...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"[Grinning]... Shabash....","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"விகடன்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Next, if a king from another country comes happily, you must speak happily; if he comes angrily, you must speak angrily...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"All right!... Minister!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Hmm—the durbar may begin....","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Commander! Let the dance begin...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"வைத்தியன்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Tell the Maharani to dance...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Yes, O king! Look, there is no one else... so let her dance!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Hmm... dance! In our country everyone is equal... everyone may dance... women who do not know how to dance are not women at all! Isn't that right, Vikata?","mode":"prose-faithful","notes":["The comic pseudo-egalitarian proclamation is preserved as printed."]}},
    {"id":"manohara-en-s038-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"The way women walk these days is itself like a dance, isn't it!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u048","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/scenes/scene-038.md","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"Purushothaman enters during the mock durbar."},"speaker_label":null,"page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"[Purushothaman enters.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Oh-ho! A king from the neighbouring country?... Have you come happily? Have you come angrily?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"புருஷோத்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Enough, man... keep quiet...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Oh! He has come angrily... Hey!... brainless king!... foolish ruler!... where have you come? State the business that brought you... why have you come to Vasanthan's durbar?... Minister!... Is that enough anger!...","mode":"prose-faithful","notes":["Vasanthan follows Vikatan's instruction literally and insults the real king; the comic escalation is retained."]}},
    {"id":"manohara-en-s038-u052","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரசர்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Hey, Vikata, what performance is this!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u053","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d048","source_occurrence_id":null,"source_locator":null,"speaker_label":"விக","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"A coronation rehearsal... Amma asked us to show it!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u054","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d049","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Physician! What medicine are you giving him—are you curing his madness or not!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s038-u055","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/dialogues/records/scene-038.json","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":"manohara-s038-d050","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Madness?... who said that? This is an incurable disease!...","mode":"prose-faithful","notes":["The joke explicitly loops back to scene 28's diagnosis."]}},
    {"id":"manohara-en-s038-u056","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s038","archival_scene_ordinal":38,"source":{"source_path":"works/manohara/scenes/scene-038.md","canonical_scene_path":"works/manohara/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"closing-comic-action","ordinal":1,"description":"The mock durbar breaks off under the king's arrival."},"speaker_label":null,"page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"[The mock durbar breaks off.]","mode":"prose-faithful","notes":[]}}
  ]
