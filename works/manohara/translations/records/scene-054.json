{"work_id":"manohara","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source_scene_number":null,"scene_status":"verified","unit_count":14,"units":[{"id":"manohara-en-s054-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/scenes/scene-054.md","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-action","ordinal":1,"description":"Guards attempt to take Vijaya's child in the prison."},"speaker_label":null,"page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"[In the prison, guards try to take away Vijaya's child.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவலர்","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Orders to bring the child.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Ah! Atthai!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவ","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Come, give the child.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மா","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"What crime has this tiny infant committed, son? This child has committed no crime! No crime at all except being born into a world where the cruel roam!","mode":"semantic-poetic","notes":[]}},{"id":"manohara-en-s054-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவ","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"We know nothing about all that. The Maharani's order!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Who is the Maharani outside there! Who are you to ask for my child? Tell that wretch—the princess of the Pandya country refuses to hand over the tender creeper she herself bore. If she has courage, tell her to fight me face to face and take the child!","mode":"semantic-poetic","notes":["`பைங்கொடி` is retained as the tender-creeper image for the child."]}},{"id":"manohara-en-s054-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Vijaya, be patient!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Atthai! Are you asking me to hand my child over to that murderess, Atthai? Even hens fight the hawk circling to kill their chicks! Am I a woman with less feeling of motherhood than they? Tell them to kill me. After my life is gone, let them take away my living portrait.","mode":"semantic-poetic","notes":["The hen/hawk maternal image and `ஜீவ ஓவியம்` living-portrait image are preserved."]}},{"id":"manohara-en-s054-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Ayyo, Atthai!","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/dialogues/records/scene-054.json","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":"manohara-s054-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"Do nothing to the child—leave the child alone.","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/scenes/scene-054.md","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"child-seizure","ordinal":1,"description":"The guards snatch the child."},"speaker_label":null,"page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"[The guards snatch the child.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/scenes/scene-054.md","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"exit-action","ordinal":1,"description":"The guards run away with the child."},"speaker_label":null,"page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"[The guards run away with the child.]","mode":"prose-faithful","notes":[]}},{"id":"manohara-en-s054-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s054","archival_scene_ordinal":54,"source":{"source_path":"works/manohara/scenes/scene-054.md","canonical_scene_path":"works/manohara/scenes/scene-054.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"pursuit-action","ordinal":1,"description":"Padmavathi follows the guards, crying out."},"speaker_label":null,"page_provenance":[{"pdf_page":82,"printed_page":81}]},"translation":{"english_text":"[Padmavathi follows them, crying out.]","mode":"prose-faithful","notes":[]}}]}