  "units":[
    {"id":"manohara-en-s031-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/scenes/scene-031.md","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Padmavathi's room."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"[Padmavathi's room.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s031-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Amma... Amma... Amma... I have stopped the leaping spear, the sword that gathers up fury. Is this deceitful woman who mocked me greater than all of them? Yet it is she whom I cannot oppose, and I have run back here. Because of whom, Amma? Because of you—because of your command—because of the oath!","mode":"semantic-poetic","notes":["The spear/sword escalation and repeated causal cadence are preserved."]}},
    {"id":"manohara-en-s031-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்மாவதி","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Manohara! Tell me the matter! What happened?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s031-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Self-respect has been levelled to the ground; valour has been put up for price. A symbol of disgrace danced in arrogance! Amma! You must change your command at once.","mode":"semantic-poetic","notes":["The three-part rhetorical escalation is retained."]}},
    {"id":"manohara-en-s031-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"You have sworn an oath, my dear!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s031-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோ","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Must a warrior become a coward? Must throbbing shoulders droop? No... let me not keep that disastrous oath......","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s031-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/scenes/scene-031.md","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"exit-action","ordinal":1,"description":"Manoharan leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"[Manoharan leaves.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s031-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/scenes/scene-031.md","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"entrance-action","ordinal":1,"description":"Vijaya enters."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Vijaya enters...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s031-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பத்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"What happened, Vijaya...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s031-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s031","archival_scene_ordinal":31,"source":{"source_path":"works/manohara/dialogues/records/scene-031.json","canonical_scene_path":"works/manohara/scenes/scene-031.md","source_record_id":"manohara-s031-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"That sinner, Vasantha Sena... (she sobs and weeps)","mode":"prose-faithful","notes":["The source-attached sobbing cue remains inside the linked turn."]}}
  ]
