  "units":[
    {"id":"manohara-en-s012-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/scenes/scene-012.md","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Garden adjoining the palace at night; Vasantha Sena waits in hiding and her companion arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"The garden adjoining the palace. Night...... Vasantha Sena, alone, hides here and there, waiting for someone...... Vasantha Sena's companion arrives.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Where is Bauthayanar?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/scenes/scene-012.md","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-voice-direction","ordinal":1,"description":"The preceding question is spoken in a low, weak voice."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"[In a low voice]......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Softly... there he is...\n[Softly]......","mode":"prose-faithful","notes":["The embedded second `மெதுவாக` direction remains inside the immutable dialogue-linked unit because it is stored there in the source record."]}},
    {"id":"manohara-en-s012-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/scenes/scene-012.md","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"The companion points; Bauthayanan is seen approaching."},"speaker_label":null,"page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"As the companion points him out, Bauthayanan is seen approaching...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"All right... you go ;...","mode":"prose-faithful","notes":["The unusual source punctuation is not smoothed into a new sentence structure."]}},
    {"id":"manohara-en-s012-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Bauthayanar... are you leaving tonight itself?......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Yes... why?...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Act with cunning......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"I'll make sure he does not return. Put aside your worry.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"His head must lie at my feet.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Uh-uh... bringing the head would put us in danger. I'll kill him on the battlefield itself and show you his war-sword.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Yes—we must put the blame on the enemies. Manoharan's death must remain a mystery—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Oh!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"A reward of a thousand gold pieces for you!......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Ammani, I shall bring the war-sword; you, the sack of gold......","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Bring me news that fills me with joy—gold? I'll heap diamonds upon you.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெளத்தாயன்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"All right, Amma...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s012-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s012","archival_scene_ordinal":12,"source":{"source_path":"works/manohara/dialogues/records/scene-012.json","canonical_scene_path":"works/manohara/scenes/scene-012.md","source_record_id":"manohara-s012-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தா","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Be careful......","mode":"prose-faithful","notes":[]}}
  ]
