  "units":[
    {"id":"manohara-en-s043-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s043","archival_scene_ordinal":43,"source":{"source_path":"works/manohara/scenes/scene-043.md","canonical_scene_path":"works/manohara/scenes/scene-043.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Cave."},"speaker_label":null,"page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"[Cave.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s043-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s043","archival_scene_ordinal":43,"source":{"source_path":"works/manohara/dialogues/records/scene-043.json","canonical_scene_path":"works/manohara/scenes/scene-043.md","source_record_id":"manohara-s043-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனோகரன்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Saffron robes! Beneath them, an army bearing knives has poured in as though a sluice had been opened... in the guise of ascetics, without a single barrier! If we delay even half a moment now, the Chola realm will become enslaved. Set out at once.","mode":"semantic-poetic","notes":["`காஷாய உடை`, the knife-bearing army, and the opened-sluice image are all retained rather than compressed into a generic infiltration summary."]}},
    {"id":"manohara-en-s043-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s043","archival_scene_ordinal":43,"source":{"source_path":"works/manohara/dialogues/records/scene-043.json","canonical_scene_path":"works/manohara/scenes/scene-043.md","source_record_id":"manohara-s043-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜப்பிரியன்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Yes, that is right! We must not let this go. Set out immediately.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s043-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s043","archival_scene_ordinal":43,"source":{"source_path":"works/manohara/dialogues/records/scene-043.json","canonical_scene_path":"works/manohara/scenes/scene-043.md","source_record_id":"manohara-s043-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்யசீலர்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Wait. We have the strength of mind to free our motherland! At the same time, we must think a little about the strength of the enemy's army too. Let us send Rajapriyan at once to the Pandiyan country. Once the Pandiyan forces arrive, we shall begin our struggle!","mode":"semantic-poetic","notes":["The contrast between `மன வலிமை` and the enemy's `படை வலிமை` is kept visible."]}},
    {"id":"manohara-en-s043-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s043","archival_scene_ordinal":43,"source":{"source_path":"works/manohara/dialogues/records/scene-043.json","canonical_scene_path":"works/manohara/scenes/scene-043.md","source_record_id":"manohara-s043-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"கேசரிவர்மன்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Good idea! Prince! You must enter the palace at once. Only then can you keep watch so that no danger approaches your mother, father or wife. We shall take care of the rest!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s043-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s043","archival_scene_ordinal":43,"source":{"source_path":"works/manohara/dialogues/records/scene-043.json","canonical_scene_path":"works/manohara/scenes/scene-043.md","source_record_id":"manohara-s043-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சத்","page_provenance":[{"pdf_page":69,"printed_page":68}]},"translation":{"english_text":"Manohara! You set out at once. Rajapriya, you leave immediately for the Pandiyan country!","mode":"prose-faithful","notes":[]}}
  ]
}
