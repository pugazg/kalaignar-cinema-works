{
  "work_id":"manohara","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source_scene_number":null,"scene_status":"verified","unit_count":43,
  "units":[
    {"id":"manohara-en-s039-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/scenes/scene-039.md","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Garden."},"speaker_label":null,"page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"[Garden.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தி","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"You have come, Swami? I was waiting on the garden rock—you have come by way of the palace.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"What does it matter which path... does the light change in your speech, in your honeyed eyes, Vasanthi!","mode":"semantic-poetic","notes":["The speech/eyes/light image is retained."]}},
    {"id":"manohara-en-s039-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"How could it change—Ahalya created for Indra—Tara created for Chandra—Vasantha created for Purushothaman—","mode":"semantic-poetic","notes":["The mythological three-part self-comparison is retained without explanatory substitution."]}},
    {"id":"manohara-en-s039-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Vasanthi! My dear... I do not even know what to say to you—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Remain mute—I enjoy that elegance...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Now... whatever you ask, I shall give—","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"There comes the danger!... Even what I had thought of asking, I am not going to ask now...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Why, Vasanthi!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"You will say, ‘The adventuress waited for the right moment to ask.’ Am I Kaikeyi who deceived Dasaratha?... No... no...","mode":"prose-faithful","notes":["Kaikeyi/Dasaratha remain explicit cultural references."]}},
    {"id":"manohara-en-s039-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"What is it, Vasanthi? Ask!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"No... hmm!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"All right... I am going...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Ayyo!... my life will leave me—sit down.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Then... tell me...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Manoharan has left the country...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Why stir that up...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"No... a country without a prince... is like a painting without beauty!...","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s039-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"What can be done about that...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Why, if we made our Vasanthan prince...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Madness! You are even madder than Vasanthan!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Swami...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"He must not be made prince!... A madman should be crowned a prophet—if we crown him.... first you will be mad—then I will be mad—after that this whole country will be mad...","mode":"prose-faithful","notes":["The mad-you/mad-me/mad-country escalation is retained."]}},
    {"id":"manohara-en-s039-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":62,"printed_page":61}]},"translation":{"english_text":"Enough... enough!... do not describe it—King Vasantha deserves this and still more. I thought you were wise... [angrily] you are a void of wisdom!","mode":"prose-faithful","notes":["`ஞான சூன்யம்` is kept close to its literal `void of wisdom` insult."]}},
    {"id":"manohara-en-s039-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"(Cunningly) Call me a fool three thousand times—I'd be happy!... But... only do not think your Vasanthi a deceiver... Swami!... I merely asked you for an idea—he is not only my son—he is your son too—what desire can I have beyond yours! My aim is your happiness... not self-interest...","mode":"prose-faithful","notes":["The sudden anger-to-cunning reversal remains visible."]}},
    {"id":"manohara-en-s039-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Don't I know that, my dear! But Vasanthan!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"No more of that talk—dangerous talk!... I too know what will happen if madness is crowned... I was teasing you. And you, before I could finish.... Hmm!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Vasanthi!...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Prabhu!... the moon-terrace is seeking us—come...","mode":"semantic-poetic","notes":[]}},
    {"id":"manohara-en-s039-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தசேனை மனதிற்குள்","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"‘There is no profit now in trusting Purushothaman—I must make a new plan. This ungrateful king must be exiled from the country... Manoharan must be killed... Vasanthan must be crowned. The one man who can help in all this is my old lover Ugrasenan.’","mode":"prose-faithful","notes":["The exact source label marks this as Vasantha Sena's inner thought; it is not converted to external speech."]}},
    {"id":"manohara-en-s039-u031","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/scenes/scene-039.md","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"movement-action","ordinal":1,"description":"Vasantha Sena goes into the room; Vasanthan follows."},"speaker_label":null,"page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Vasantha Sena goes into the room. Vasanthan follows.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u032","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/scenes/scene-039.md","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-action","ordinal":1,"description":"Vasantha Sena writes a letter; the invisible figure follows; she trembles."},"speaker_label":null,"page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"[Vasantha Sena writes a letter. The invisible figure follows. Vasantha Sena trembles.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"வ. சே","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Who's there! A wicked man is hiding inside. Do not let him go!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u034","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/scenes/scene-039.md","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-action","ordinal":2,"description":"The invisible figure calls Vasanthan."},"speaker_label":null,"page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"[The invisible figure calls Vasanthan.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Are you a ghost? A god?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரூபம்","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"No, Vasantha... I am a human being.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"A human? I can't see you with my eyes.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரூ","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"You will not see me! It is the fruit of the grace and knowledge of my lord Gurunathar. The work of a medicine.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s039-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s039","archival_scene_ordinal":39,"source":{"source_path":"works/manohara/dialogues/records/scene-039.json","canonical_scene_path":"works/manohara/scenes/scene-039.md","source_record_id":"manohara-s039-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Will you give me a little of that medicine?","mode":"prose-faithful","notes":[]}},
