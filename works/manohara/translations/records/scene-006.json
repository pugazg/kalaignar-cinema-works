  "units": [
    {"id":"manohara-en-s006-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/scenes/scene-006.md","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-parenthetical-stage-direction","ordinal":1,"description":"Opening palace direction introducing the concealed Ugrasena portrait in Vasantha Sena's pendant."},"speaker_label":null,"page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"(Palace. Vasantha Sena is looking at Ugrasena's portrait, hidden inside the pendant on her pearl necklace.)","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Amma... whatever else you may forget day after day, you never forget this, do you? What is there in this pendant that draws your eyes like a magnet?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"No magnet, girl! A god who lends a hand in danger!","mode":"prose-faithful","notes":["The source pivots from the maid's literal `magnet` to Vasantha Sena's metaphorical protector; the abrupt contrast is retained."]}},
    {"id":"manohara-en-s006-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோ","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"A god?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வச","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Look... (She shows the portrait.)","mode":"prose-faithful","notes":["The label-attached source action remains inside the dialogue-linked unit."]}},
    {"id":"manohara-en-s006-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோ","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Amma, the Maharaja is coming!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"புருஷோத்தமன்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Still not finished with your adornment? It is already time for the play...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"There—finished.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"புரு","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Have you forgotten? Today is Manoharan's birthday.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Would I forget—the boy's birthday? Another memory came to me...","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"புருஷோத்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"What is it, Vasanthi?","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"The thirteenth anniversary of our festival of love.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"புருஷோத்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Yes, my dear... I did not even notice the years flying by.","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/scenes/scene-006.md","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"bracketed-stage-direction","ordinal":1,"description":"Purushothaman approaches and touches Vasantha before Vasanthan interrupts."},"speaker_label":null,"page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"[As he comes closer, he touches Vasantha.]","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Do not touch fire! This body will burn you! It may sting a little too—about all this I have no doubt... no doubt.... What is this, Amma, a new lesson today? Amma!... Hey... Appa! Look at Amma's beauty, Appa... If only I got a girl like Amma...","mode":"prose-faithful","notes":["The comic return of `சந்தேகமில்லே` from scene 3 is preserved instead of normalized away.","The colloquial Amma/Appa register is retained to keep Vasanthan's teasing voice distinct."]}},
    {"id":"manohara-en-s006-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Chi... keep quiet!","mode":"prose-faithful","notes":[]}},
    {"id":"manohara-en-s006-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Was Pillaiyar the only one who asked for a girl like his mother Parvati? What is wrong if I ask too, Appa...","mode":"prose-faithful","notes":["`Pillaiyar` and `Parvati` are retained because the joke depends on the culturally specific comparison."]}},
    {"id":"manohara-en-s006-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"புருஷோத்","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"This will never, ever end!","mode":"prose-faithful","notes":["The emphatic repetition in `தீரவே தீராது` is reflected in English."]}},
    {"id":"manohara-en-s006-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வசந்தன்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"No doubt.","mode":"prose-faithful","notes":["The brief punchline carries forward the recurring `சந்தேகமில்லை` joke."]}},
    {"id":"manohara-en-s006-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"manohara-s006","archival_scene_ordinal":6,"source":{"source_path":"works/manohara/dialogues/records/scene-006.json","canonical_scene_path":"works/manohara/scenes/scene-006.md","source_record_id":"manohara-s006-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"புருஷோத்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Vasanthi, I am going... get ready quickly...","mode":"prose-faithful","notes":[]}}
  ]
}
