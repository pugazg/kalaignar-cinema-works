    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 47
      }
    ],
    "text": "திட்டமில்ல உமா!"
  },
  {
    "id": "vandikkaran-magan-s034-d007",
    "scene_id": "vandikkaran-magan-s034",
    "scene_ordinal": 34,
    "source_scene_id": "24-டி",
    "source_heading": "காட்சி-24 டி",
    "speaker_label": "விங்கன் குரல்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 47
