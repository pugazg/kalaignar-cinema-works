[
  {
    "id": "vandikkaran-magan-s032-d001",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 43
      }
    ],
    "text": "அடடா! தச்! தச்!...தச்!..."
  },
  {
    "id": "vandikkaran-magan-s032-d002",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன் குரல்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "சபாஷ்!...ஆரம்பமே பிரமாதம்...எக்ஸ்லெண்ட்!.."
  },
  {
    "id": "vandikkaran-magan-s032-d003",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "என்னது...எக்ஸ்லெண்ட்?..."
  },
  {
    "id": "vandikkaran-magan-s032-d004",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "பின்பகுதி ரொம்பப் பிரமாதம்!...அதாவது இந்தக்கதை போட்ட பின்பகுதி..ரொம்ப நல்லாயிருக்கு!...நான் உன் கிட்ட பேசலே!...எனக்கு நானே படிச்சு ரசிச்சுகிட்டு இருக்கேன்!.."
  },
  {
    "id": "vandikkaran-magan-s032-d005",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "புத்தகத்தை தலைகீழாத்தான் படிப்பீங்களா?"
  },
  {
    "id": "vandikkaran-magan-s032-d006",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "எனக்கு எப்போதும் முடிவு தெரிஞ்சுகிறதிலே இன்ட்ரஸ்ட் அதிகம்! கதையோட ஆரம்பத்தை நான் அப்புறம்தான் படிக்கிறது..."
  },
  {
    "id": "vandikkaran-magan-s032-d007",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "அது என்ன புத்தகம்—அதையாவது சொல்லுங்களேன்!"
  },
  {
    "id": "vandikkaran-magan-s032-d008",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "ஹூஹூம்!...உன்கிட்ட சொல்லக்கூடாது."
  },
  {
    "id": "vandikkaran-magan-s032-d009",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "ஏனும்?"
  },
  {
    "id": "vandikkaran-magan-s032-d010",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "இது செக்ஸ் கதை...!"
  },
  {
    "id": "vandikkaran-magan-s032-d011",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "மழை காலத்துத் தவளை மாதிரி மந்திரத்தை ஜபிக்கிறீங்களே—கொஞ்சம் உரக்க படிச்சா என்னவாம்?"
  },
  {
    "id": "vandikkaran-magan-s032-d012",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "செக்ஸ் கதையை மார்கழி மாதத்து பஜனை மாதிரியா எல்லார் காதிலேயும் விழும்படியா படிக்க முடியுமா?..."
  },
  {
    "id": "vandikkaran-magan-s032-d013",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "அதைத்தான் படிக்கச் சொல்றேன்—இல்லேன்னு இங்க கொடுங்க; நான் படிச்சிக்கிறேன்."
  },
  {
    "id": "vandikkaran-magan-s032-d014",
    "scene_id": "vandikkaran-magan-s032",
    "scene_ordinal": 32,
    "source_scene_id": "24-பி",
    "source_heading": "காட்சி-24-பி",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 44
      }
    ],
    "text": "எங்கப்பா! உனக்கு எவ்வளவு கோபம் வருது. இதிலே என்ன எழுதியிருக்கு தெரியுமா? அதாவது படிக்கிறேன் கேளு!"
  }
]
