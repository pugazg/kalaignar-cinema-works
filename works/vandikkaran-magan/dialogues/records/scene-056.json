    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 69
      }
    ],
    "text": "உமா! புறப்படு!..."
  },
  {
    "id": "vandikkaran-magan-s056-d008",
    "scene_id": "vandikkaran-magan-s056",
    "scene_ordinal": 56,
    "source_scene_id": "43",
