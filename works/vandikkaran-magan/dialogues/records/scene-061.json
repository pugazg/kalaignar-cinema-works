[
  {
    "id": "vandikkaran-magan-s061-d001",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "காளிங்கா! அதையெல்லாம் உள்ளே கொண்டு போய் வை!..."
  },
  {
    "id": "vandikkaran-magan-s061-d002",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "காளிங்க",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "டேய்! அந்த சாமான்களே எல்லாம் குடிசைக்குள்ளே கொண்டு போயி வையுங்கடா.!"
  },
  {
    "id": "vandikkaran-magan-s061-d003",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "என்ன இதெல்லாம்?"
  },
  {
    "id": "vandikkaran-magan-s061-d004",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "காளிங்க",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "சும்மா குழந்தைக்கு... தங்க கிலுகிலுப்பை!... மாணிக்கப் பாலாடை!... அசல் யானைத் தந்தத்திலே செஞ்ச தொட்டில்!..."
  },
  {
    "id": "vandikkaran-magan-s061-d005",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "வேண்டாம்! வேண்டாம்!... இதெல்லாம் இங்கே ஒட்டாது!.... துணியில ஒரு தொட்டில்!... டீன் ஒலியில ஒரு கிலுகிலுப்பை!.. சங்கிலே ஒரு பாலாடை!.. அது போதும் எங்க வீட்டு குழந்தைக்கு!..."
  },
  {
    "id": "vandikkaran-magan-s061-d006",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "மாப்பிளே!... என்ன இருந்தாலும்... ஜமீன்தார் ஜம்புலிங்க பூபதியின் பேரப்பிள்ளே!..."
  },
  {
    "id": "vandikkaran-magan-s061-d007",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "(குழந்தையை வாங்கி... உற்றுப் பார்த்து) அப்படி ஒண்ணும் நெத்தியிலே எழுதலியே!..."
  },
  {
    "id": "vandikkaran-magan-s061-d008",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "காளிங்க",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "மாப்பிளே...கிண்டல் பண்றாரு!..."
  },
  {
    "id": "vandikkaran-magan-s061-d009",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "ஏதம்மா இந்தக்காளைமாடு?"
  },
  {
    "id": "vandikkaran-magan-s061-d010",
    "scene_id": "vandikkaran-magan-s061",
    "scene_ordinal": 61,
    "source_scene_id": "49",
    "source_heading": "காட்சி -- 49",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-061.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 74
      }
    ],
    "text": "அவர் தான் வளர்க்கிறார் அப்பா... ஏதோ ஒரு லட்சியத் தூக்காக வளர்க்கிறாராம்... நான் நாள்தோறும் இதுக்குப் பூஜை செய்கிறேன்!..."
  }
]
