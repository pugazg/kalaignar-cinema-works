    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 11
      }
    ],
    "text": "ஓ...ஐ ஸீ!..நான் பாத்ரூமுக்குப் போனேன்..பாய்!..."
  },
  {
    "id": "vandikkaran-magan-s006-d004",
    "scene_id": "vandikkaran-magan-s006",
    "scene_ordinal": 6,
    "source_scene_id": "5",
