[
  {
    "id": "vandikkaran-magan-s071-d001",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "விங்கன்!.... அய்யோ என்னைக் காப்பாற்று!"
  },
  {
    "id": "vandikkaran-magan-s071-d002",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "உண்மையைச் சொல்லும்!.... என் தாயாரை காளை மாட்டுக் கொம்பின்மீது தள்ளிக் கொலை செய்தது நீர் தானே?"
  },
  {
    "id": "vandikkaran-magan-s071-d003",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "ஆமாம்.... நான்தான்!?"
  },
  {
    "id": "vandikkaran-magan-s071-d004",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "மக்களுக்குப் பயன்படக் கூடிய உணவு தானியங்களைப் பதுக்கி வைத்து, அவர்களைப் பட்டினி போட்டு விட்டு கள்ளக் கடத்தல் மூலம் கருப்புப் பணம் சம்பாரித்தது உண்மைதானே?"
  },
  {
    "id": "vandikkaran-magan-s071-d005",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "உண்மைதான்!.... உண்மைதான்!...."
  },
  {
    "id": "vandikkaran-magan-s071-d006",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "புலவர் மகளைக் கற்பழிச்சு புலவரையும் அவர் மகளையும் தீர்த்துக்கட்டியது உண்மைதானே?"
  },
  {
    "id": "vandikkaran-magan-s071-d007",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "உண்மைதான்! உண்மைதான்! சடையா! என்னை நீயாவது காப்பாற்று!"
  },
  {
    "id": "vandikkaran-magan-s071-d008",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 85
      }
    ],
    "text": "தம்பி! தன் தவறை உணர்ந்து திருந்த நினைக்கிற மனிதனை மன்னிச்சிடுப்பா! ஜமீன்தாரய்யாவைக் காப்பாற்று!"
  },
  {
    "id": "vandikkaran-magan-s071-d009",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 87,
        "printed_page": 86
      }
    ],
    "text": "அழுக்குள்ளம்! அக்கிரம ஆட்டம்! அநியாயச் செயல்கள்! இதனையும் வார்த்தெடுத்த வஞ்சக வடிவங்கொண்ட நீர்... வெளி வேஷத்தாலே! புனிதர்-புண்ணியர்-உத்தமர்-யோகியர்னு இந்த ஊராரை ஏமாற்றியதும் உண்மைதானே?"
  },
  {
    "id": "vandikkaran-magan-s071-d010",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 87,
        "printed_page": 86
      }
    ],
    "text": "எல்லாம் உண்மைதான்!... என்னை மன்னிச்சிடு விங்கன்!...."
  },
  {
    "id": "vandikkaran-magan-s071-d011",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 87,
        "printed_page": 86
      }
    ],
    "text": "நான் உங்களை மன்னிச்சா போதாது அய்யா வாங்க... இதோ இங்கு நிற்கிற எல்லோரிடத்திலும் மன்னிப்புக் கேளும்...."
  },
  {
    "id": "vandikkaran-magan-s071-d012",
    "scene_id": "vandikkaran-magan-s071",
    "scene_ordinal": 71,
    "source_scene_id": "55",
    "source_heading": "காட்சி - 55",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-071.md",
    "page_provenance": [
      {
        "pdf_page": 87,
        "printed_page": 86
      }
    ],
    "text": "“அத்தான்” என அலறுகிறாள். அதற்குள் கண்ணாயிரம் காளையைக் கட்டவிழ்த்து விடவே காளை ஜமீன்தார் மீது பாய்கிறது. ஜமீன்தார் ரத்த வெள்ளத்தில் மிதக்கிறார்."
  }
]
