[
  {
    "id": "vandikkaran-magan-s050-d001",
    "scene_id": "vandikkaran-magan-s050",
    "scene_ordinal": 50,
    "source_scene_id": "38",
    "source_heading": "காட்சி — 38",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 61
      }
    ],
    "text": "எல்லாம் வல்ல இறைவனுக்கு நன்றி கூறி, இந்தப் பிறந்த நாள் விழாவில் நான் என்றும்போல் உத்தம குணத்தோடும், உதார உள்ளத்தோடும் ஒழுக்க சீலனாக விளங்கி உங்களுக்காகப் பாடுபவன் என்று கூறிக் கொள்கிறேன்!...ஆண்டவன் நாமம் வாழ்க!"
  },
  {
    "id": "vandikkaran-magan-s050-d002",
    "scene_id": "vandikkaran-magan-s050",
    "scene_ordinal": 50,
    "source_scene_id": "38",
