      }
    ],
    "text": "இதோ எஜமான்..."
  },
  {
    "id": "vandikkaran-magan-s015-d007",
    "scene_id": "vandikkaran-magan-s015",
    "scene_ordinal": 15,
    "source_scene_id": "13",
    "source_heading": "காட்சி — 13",
