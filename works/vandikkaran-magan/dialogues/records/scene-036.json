    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 49
      }
    ],
    "text": "கோகிலா!"
  },
  {
    "id": "vandikkaran-magan-s036-d008",
    "scene_id": "vandikkaran-magan-s036",
    "scene_ordinal": 36,
    "source_scene_id": "26",
    "source_heading": "காட்சி-26",
    "speaker_label": "கோகிலா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-036.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 50
      }
    ],
    "text": "அய்யோ!...என்னைத் தடுக்காதீங்கம்மா!...எனக்கு சந்தோஷம் தாங்கலேம்மா...நான் தலைகீழா நடக்கிற மாதிரி இருக்கு...வர்றேன்ம்மா!..."
  }
