[
  {
    "id": "vandikkaran-magan-s022-d001",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "மரகதம்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "துளியோண்டு துளியோண்டு.... சின்னச்சின்ன சிராய்ப்புத்தான்!... (ஆறுதலுடன்... விங்கனை நோக்கி) பெருங்காயமே கிடையாது தம்பி!...."
  },
  {
    "id": "vandikkaran-magan-s022-d002",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "டீச்சரம்மா! இவ்வளவு பெரிய ஜமீன் மாளிகையிலே பெருங்காயம் கிடையாதா?... பெருங்காயம் இல்லே, புளி இல்லேன்னு செகரட்டரிகிட்ட வந்து சொல்றீங்களே.... சமையக்காரங்கிட்டே சொல்லுங்க!..."
  },
  {
    "id": "vandikkaran-magan-s022-d003",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "மரகதம்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "தம்பி தமாஷ் பண்ணுதப்பா!:::"
  },
  {
    "id": "vandikkaran-magan-s022-d004",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "உமா!..."
  },
  {
    "id": "vandikkaran-magan-s022-d005",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "மரகதம்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "உமா! வாம்மா டிரஸ் 'சேஞ்ச்' பண்ணிகிட்டு காயத்துக்கு மருந்து போட்டலாம் வா!..."
  },
  {
    "id": "vandikkaran-magan-s022-d006",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "ஏன் சடையா? என்னைக்குமே இல்லாம இன்னைக்கு நம்ம குதிரை வெறிச்சிகிட்டு ஓடக்காரணம்?"
  },
  {
    "id": "vandikkaran-magan-s022-d007",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "காளிங்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "காரணமில்லாமயா நடக்கும்? (அன்று வரும் காளிங்கன் வருவதைக் கவனித்தல். — காலி 'ரம்' பாட்டிலைத் தூக்கிக் காட்டியபடி).... 'ரம்'மை குதிரைக்குள்ள விட்டான்.. அது 'கும்'முன்னு குதிக்க ஆரம்பிச்சிடுச்சி!"
  },
  {
    "id": "vandikkaran-magan-s022-d008",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "என்ன சொல்றே காளிங்கா?...."
  },
  {
    "id": "vandikkaran-magan-s022-d009",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "காளிங்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 30
      }
    ],
    "text": "என்ன சொல்றேனு? பாதியை அவன் குடிச்சான்! மீதியைக் குதிரைக்கு விட்டான்! அந்த அயோக்கியன் இங்கேதான் இருக்கான். அவன் யார் தெரியுமா?"
  },
  {
    "id": "vandikkaran-magan-s022-d010",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "யார் அந்த அயோக்கியன்?::: என் பாதுகாப்பிலே இருக்கிற லாயத்திலே இப்படியொரு அக்கிரமத்தைச் செய்தவன் சொல்லுங்க, அவனைப்பிடிச்சு... சவுக்கடி கொடுக்கிறேன்!..."
  },
  {
    "id": "vandikkaran-magan-s022-d011",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "ஆண்டவனே! எஜமான்! சத்தியமா நான் குடிக்க மாட்டேங்க!..."
  },
  {
    "id": "vandikkaran-magan-s022-d012",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "யாராயிருந்தாலும் சரி... குடிகாரனை நான் மன்னிக்கவே மாட்டேன்!..."
  },
  {
    "id": "vandikkaran-magan-s022-d013",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "காளிங்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "அது உங்க கொள்கையாச்சே!"
  },
  {
    "id": "vandikkaran-magan-s022-d014",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "என் பெத்த பிள்ளை மேல ஆணையா சொல்றேங்க! எனக்கு குடிப்பழக்கமே கிடையாதுங்க!..."
  },
  {
    "id": "vandikkaran-magan-s022-d015",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "காளிங்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "உனக்கு ஏதுடா பெத்த பிள்ளை? அதுதான் தொலைஞ்சு போச்சே! எங்கே போயி பிச்சை எடுக்குதோ? பிள்ளைமேலயா சத்தியம் பண்ணுற? பெரிய சத்தியவானுடா நீ?..."
  },
  {
    "id": "vandikkaran-magan-s022-d016",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "எஜமான்!..."
  },
  {
    "id": "vandikkaran-magan-s022-d017",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "ஐயோ!... செகரட்டரி தம்பி!.... யாரு பெத்த பிள்ளையோ, என்னை நீங்க அடி வாங்கிக்கிட்டீங்களே!..."
  },
  {
    "id": "vandikkaran-magan-s022-d018",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "தன் பிள்ளை மீது ஆணை வைத்து சத்தியம் செய்த ஒரு தகப்பனை தண்டிப்பது தவறு!..."
  },
  {
    "id": "vandikkaran-magan-s022-d019",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "உஸ்.... காளிங்கா!.... வேண்டாம்..."
  },
  {
    "id": "vandikkaran-magan-s022-d020",
    "scene_id": "vandikkaran-magan-s022",
    "scene_ordinal": 22,
    "source_scene_id": "18",
    "source_heading": "காட்சி—18",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 31
      }
    ],
    "text": "(ஜமீன்தார் காலில் விழுந்தவாறு) எஜமான்!... என்னை நம்புங்க! நீங்க அடிச்சாலும் உதைத்தாலும் இந்த அரண்மனை சோத்தை தின்னுகிட்டு கிடக்கிற நன்றியுள்ள நாய்ங்க நான்!"
  }
]
