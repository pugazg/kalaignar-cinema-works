    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 39,
        "printed_page": 38
      }
    ],
    "text": "அப்பா! அப்பா!..."
  },
  {
    "id": "vandikkaran-magan-s026-d007",
    "scene_id": "vandikkaran-magan-s026",
    "scene_ordinal": 26,
    "source_scene_id": "21",
    "source_heading": "காட்சி — 21",
