    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "உமா!"
  },
  {
    "id": "vandikkaran-magan-s044-d008",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "அத்தான்!....."
  },
  {
    "id": "vandikkaran-magan-s044-d009",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "எங்கே உமா?"
  },
  {
    "id": "vandikkaran-magan-s044-d010",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "இருங்கள்! பெட் காபி கொண்டு வருகிறேன்!.."
  },
  {
    "id": "vandikkaran-magan-s044-d011",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "(எழுந்தமர்ந்து) காபி...பிறகு!... உமா!...முதலில் உன் தந்தையின் அறைக்குச் செல்!....."
  },
  {
    "id": "vandikkaran-magan-s044-d012",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "உம்..."
  },
  {
    "id": "vandikkaran-magan-s044-d013",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "அவரிடமுள்ள...ஜமீன் களஞ்சியத்தின் சாவிக்கொத்தை அப்படியே...அவருக்குத் தெரியாமல் எடுத்துவா!..."
  },
  {
    "id": "vandikkaran-magan-s044-d014",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "சாவிக்கொத்தா? ஏன்?"
  },
  {
    "id": "vandikkaran-magan-s044-d015",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "இரவே சொன்னேனே; காரணம் எதுவும் கேட்கக் கூடாதென்று! ஏன், எதற்காக என்ற கேள்வியே எழக் கூடாது என்று!"
  },
  {
    "id": "vandikkaran-magan-s044-d016",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "சரி...அப்பா அறைக்கு எப்படிப் போய்..."
  },
  {
    "id": "vandikkaran-magan-s044-d017",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "உன்னால முடியாது!... பூனையைவிட மிருதுவான உன் பட்டுப் பாதங்களால் ஓசை படாமல் நடந்து...கொண்டுவா அந்த சாவிக்கொத்தை!..."
  },
  {
    "id": "vandikkaran-magan-s044-d018",
    "scene_id": "vandikkaran-magan-s044",
    "scene_ordinal": 44,
    "source_scene_id": "33",
    "source_heading": "காட்சி 33",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-044.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 58
      }
    ],
    "text": "இல்லை...இல்லை..இதோ போகிறேன்!..."
  }
]
