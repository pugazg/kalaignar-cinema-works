    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 51
      }
    ],
    "text": "(கோபமுடன்-உருக்கமுடன்) மெழுகா இருந்ததினால்தான் உருகிப் போயிட்டேன்!.."
  },
  {
    "id": "vandikkaran-magan-s038-d011",
    "scene_id": "vandikkaran-magan-s038",
    "scene_ordinal": 38,
    "source_scene_id": "28",
