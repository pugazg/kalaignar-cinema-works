    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 51
      }
    ],
    "text": "(சாதாரணமாக) உமா!"
  },
  {
    "id": "vandikkaran-magan-s038-d014",
    "scene_id": "vandikkaran-magan-s038",
    "scene_ordinal": 38,
    "source_scene_id": "28",
