    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 51
      }
    ],
    "text": "அதான் அன்னைக்கே உருகிட்டியே; அப்புறம் இப்ப ஏன் உருகுறே!.."
  },
  {
    "id": "vandikkaran-magan-s038-d012",
    "scene_id": "vandikkaran-magan-s038",
    "scene_ordinal": 38,
    "source_scene_id": "28",
    "source_heading": "காட்சி-28",
    "speaker_label": "உமா",
