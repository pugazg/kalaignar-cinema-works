[
  {
    "id": "vandikkaran-magan-s055-d001",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 67
      }
    ],
    "text": "வாங்க மாப்பிள்ளை...வாங்க!...அடடே! புலவரே!...எங்கய்யா போயிட்டீங்க?...நான் சொன்னபடி உமது பெண்ணுக்குத் திருமணம் நடக்குது பார்த்தீரா?"
  },
  {
    "id": "vandikkaran-magan-s055-d002",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "புலவர்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 67
      }
    ],
    "text": "ஜமீன்தாரய்யா! மன்னிக்கணும்-நான் உங்களைப் பத்தி தப்பா நினைச்சுட்டேன்-இதோ, உங்க மருமகப்பிள்ளை விங்கன் பேச்சைக் கேட்டது என் குற்றம்."
  },
  {
    "id": "vandikkaran-magan-s055-d003",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 67
      }
    ],
    "text": "போதும் போதும் அளவுக்கு மீறிப் புகழாதீர் புலவரே இதெல்லாம் என் கடமை!..."
  },
  {
    "id": "vandikkaran-magan-s055-d004",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "சடையன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 67
      },
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "(விங்கனிடம் ஜமீன்தாரைக் காட்டி) என்னப்பா, இப்ப என்ன சொல்றே?...என் தெய்வத்தின் திருவிளையாடலைப் பாத்தியா?...அவசரமும் ஆத்திரமும் உன்\nஅறிவை மறைச்சிட்டே இருக்கு!..இந்தக் கலியுகத்திலே எங்கும் காண முடியாத கருணை வடிவமடா இது!..இப்படாவது காலில் விழுந்து மன்னிப்புக்கேளு!",
    "page_segments": [
      {
        "pdf_page": 68,
        "printed_page": 67,
        "text": "(விங்கனிடம் ஜமீன்தாரைக் காட்டி) என்னப்பா, இப்ப என்ன சொல்றே?...என் தெய்வத்தின் திருவிளையாடலைப் பாத்தியா?...அவசரமும் ஆத்திரமும் உன்"
      },
      {
        "pdf_page": 69,
        "printed_page": 68,
        "text": "அறிவை மறைச்சிட்டே இருக்கு!..இந்தக் கலியுகத்திலே எங்கும் காண முடியாத கருணை வடிவமடா இது!..இப்படாவது காலில் விழுந்து மன்னிப்புக்கேளு!"
      }
    ]
  },
  {
    "id": "vandikkaran-magan-s055-d005",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஊர்ப்பெரியவர்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "(விங்கனிடம்) இந்தப் புண்ணியவான் மேலே புழுதி வாரித் தூற்றுறதே உன் வேலையாப்போச்சு!..உன் பேச்சைக் கேட்டு நாங்களும் பைத்தியக்காரனு ஆயிட்டோம்..எஜமான் எங்களை மன்னிச்சிடுங்க!..."
  },
  {
    "id": "vandikkaran-magan-s055-d006",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "மனிதன் மனிதன் மன்னிப்பதா?..வேண்டாம்! தேவையில்லை!..முதல்ல உங்களை நீங்க திருத்திக்குங்க! அப்புறம் என்னைப் புரிஞ்சுக்குங்க, எல்லோரும் போய் வாருங்கள்!"
  },
  {
    "id": "vandikkaran-magan-s055-d007",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "உமா",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "வாருங்கள்! வணக்கம்!..."
  },
  {
    "id": "vandikkaran-magan-s055-d008",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "(ஒரு பெருமிதச் சிரிப்புடன் அருகே வந்து) என்ன விங்கன்..என் அருமை மாப்பிள்ளை!..."
  },
  {
    "id": "vandikkaran-magan-s055-d009",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "மாயை விலகத்தான் போகிறது! மக்கள் உண்மையை உணரத்தான் போகிறார்கள்!..."
  },
  {
    "id": "vandikkaran-magan-s055-d010",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "மணலைக் கயிறாகத் திரிக்கும் முயற்சி!"
  },
  {
    "id": "vandikkaran-magan-s055-d011",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "விங்கன்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "அதையும் பார்க்கிறேன்!..."
  },
  {
    "id": "vandikkaran-magan-s055-d012",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "புலவர்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "(மணவறைக்கு ஓடி) பூங்கொடி! உன்னை எங்கெல்லாம் தேடி அலைந்தேனம்மா—தேவி சன்னிதானத்திலே நீ மணக்கோலத்தில் இருக்கிற இந்த தெய்வமான காட்சியைப் பார்க்க எனக்கு வரங்கொடுத்த வள்ளலம்மா, இவர்!.....எழுந்திருச்சி அவருக்கு நமஸ்காரம் பண்ணும்மா! வாம்மா!...."
  },
  {
    "id": "vandikkaran-magan-s055-d013",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "புலவர்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "ஆ! பூங்கொடி!..பூங்கொடி!...அய்யய்யோ, மோசம் போயிட்டேனே!..நான் மோசம் போயிட்டேனே"
  },
  {
    "id": "vandikkaran-magan-s055-d014",
    "scene_id": "vandikkaran-magan-s055",
    "scene_ordinal": 55,
    "source_scene_id": "42-எ",
    "source_heading": "காட்சி — 42-எ",
    "speaker_label": "ஜமீன்தார்",
    "source_delimiter": ":—",
    "source_scene_file": "scene-055.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 68
      }
    ],
    "text": "ம்!..இரண்டையும் தூக்கிப்போய்..யார்கண்ணிலும் படாமல் புதையுங்கள்."
  }
]
