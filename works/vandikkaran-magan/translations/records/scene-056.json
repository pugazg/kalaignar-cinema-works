        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சடையன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 70,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "Why, son, have you gone mad? Why are you doing all this? Why are you causing such great pain in master's heart?.. And you say you'll take away a woman who is carrying a child!...",
        "mode": "prose-faithful",
        "notes": []
