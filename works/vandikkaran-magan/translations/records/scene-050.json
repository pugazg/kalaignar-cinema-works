        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஜமீன்தார்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 62
          }
        ]
      },
      "translation": {
        "english_text": "I will conduct it! There is no obstacle... Kalinga! The whole earth knows the regard we show poets!... Take the poet and child Poongodi away and... (signals with his eyes) give them proper hospitality...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s050-u023",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s050",
      "scene_ordinal": 50,
