        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 62
          }
        ]
      },
      "translation": {
        "english_text": "I understand, my lord... I understand! Poet, come!... Child Poongodi, come!... You are a lucky girl! The zamindar's gaze has fallen on you.. What comes next is still ahead—come!...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
