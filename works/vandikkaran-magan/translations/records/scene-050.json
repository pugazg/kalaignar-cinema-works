        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 62
          }
        ]
      },
      "translation": {
        "english_text": "Don't you recognize her? Ten or fifteen years ago! My daughter Poongodi, whom I brought here as a green little baby!...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s050-u020",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s050",
      "scene_ordinal": 50,
      "source_scene_id": "38",
      "source": {
        "source_path": "works/vandikkaran-magan/dialogues/records/scene-050.json",
        "canonical_scene_path": "works/vandikkaran-magan/scenes/scene-050.md",
        "source_record_id": "vandikkaran-magan-s050-d013",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "காளிங்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 62
          }
        ]
      },
      "translation": {
        "english_text": "Have you forgotten? Back then that baby was nice and plump. Tiny.. You would hold her chest to chest and play with her for fun!... She'd wipe her running nose on me!... You've forgotten... She was little then! Now she's grown into a young woman!...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s050-u021",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s050",
      "scene_ordinal": 50,
      "source_scene_id": "38",
      "source": {
        "source_path": "works/vandikkaran-magan/dialogues/records/scene-050.json",
        "canonical_scene_path": "works/vandikkaran-magan/scenes/scene-050.md",
        "source_record_id": "vandikkaran-magan-s050-d014",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "புலவர்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 62
          }
        ]
      },
      "translation": {
        "english_text": "She has now become a woman of marriageable age!... You yourself must take the initiative and arrange her marriage....",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s050-u022",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s050",
      "scene_ordinal": 50,
      "source_scene_id": "38",
      "source": {
