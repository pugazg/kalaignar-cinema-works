        "source_locator": {
          "kind": "source-unlabelled-speech",
          "ordinal": 4,
          "description": "Source block 4: போற்றி! போற்றி!... புனிதனே போற்றி!... புண்ணியனே போற்றி!... கண்ணியனே போற்றி!.. கடையேழு வள்ளல்களே வென்றவனே போற்றி!... கலியுகக் கர்ண மகாராஜனே ப"
        },
        "speaker_label": null,
        "speaker_label_origin": "source-unlabelled",
        "source_delimiter": null,
        "page_provenance": [
          {
            "pdf_page": 62,
            "printed_page": 61
          }
        ]
      },
      "translation": {
        "mode": "prose-faithful",
        "notes": [
          "The source prints no speaker label for this spoken unit; no speaker or immutable dialogue ID is inferred."
        ],
        "english_text": "Praise! Praise!...\nPraise to the holy one!...\nPraise to the virtuous one!...\nPraise to the honourable one!..\nPraise to the one who surpassed\nthe last seven great benefactors!...\nPraise to the Kali-age Maharaja Karna!..."
      }
    },
