        "source_locator": {
          "kind": "stage-direction",
          "ordinal": 2,
          "description": "Source block 2: (உமா போகிறாள். ஜம்புவிடம் கத்தும்படி விங்கன் சைகை காட்ட—ஜம்பு யானைபோல் கத்த—உமா அலறியடித்து ஓடி வந்து விங்கனைக் கட்டிக்கொள்கிறாள்.)"
        },
        "speaker_label": null,
        "speaker_label_origin": null,
        "source_delimiter": null,
        "page_provenance": [
          {
            "pdf_page": 44,
            "printed_page": 43
          }
        ]
      },
      "translation": {
        "mode": "prose-faithful",
        "notes": [],
        "english_text": "(Uma goes away. Vingan signals Jambu to roar; Jambu trumpets like an elephant. Uma screams, runs back and clings to Vingan.)"
      }
    },
