        "source_record_id": "vandikkaran-magan-s031-d006",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "உமா",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 44,
            "printed_page": 43
          }
        ]
      },
      "translation": {
        "english_text": "It is not dharma for a woman either to let a man die without knowing it. Are you coming inside to sleep right now or not?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
