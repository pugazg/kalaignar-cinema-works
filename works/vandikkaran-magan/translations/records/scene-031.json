          }
        ]
      },
      "translation": {
        "english_text": "All the animals are roaring like this!... Aren't you afraid at all?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s031-u004",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
