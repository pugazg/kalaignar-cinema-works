        "source_locator": {
          "kind": "song-body",
          "ordinal": 2,
          "description": "Source block 2: உழைக்கும் இனமே! உடன்பிறப்பே! என்னோடு வாருங்களே! — பகலின் உருவில் ஊரில் உலவும் புலியைக் காட்டுவேன்; பாருங்களே!"
        },
        "speaker_label": null,
        "speaker_label_origin": null,
        "source_delimiter": null,
        "page_provenance": [
          {
            "pdf_page": 60,
            "printed_page": 59
          },
          {
            "pdf_page": 61,
            "printed_page": 60
          }
        ]
      },
      "translation": {
        "mode": "semantic-poetic-source-faithful",
        "notes": [
          "Item-level lyric authorship remains unresolved; the film-level `பாடல்கள்: கவிஞர் வாலி` credit is not promoted to this occurrence."
        ],
        "english_lines": [
          "Working people!",
          "My siblings!",
          "Come along with me! — In broad",
          "daylight, the tiger",
          "that prowls the town—",
          "I will show it; come and see!"
        ]
      }
    },
    {
      "id": "vandikkaran-magan-en-s048-u003",
      "kind": "song",
      "status": "verified",
      "target_language": "en",
