        ],
        "english_lines": [
          "Like an upright man,",
          "he gives advice! — that",
          "outward guise like",
          "the Buddha! — If you",
          "lift away the cloak",
          "worn by these impostors,",
          "bullying; intimidation;",
          "imprisonment! — A drama..."
        ]
      }
