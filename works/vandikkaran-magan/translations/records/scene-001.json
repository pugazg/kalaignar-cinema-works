        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 6
          }
        ]
      },
      "translation": {
        "english_text": "Only within our boundaries, right!... We can enforce that.",
        "mode": "prose-faithful",
        "notes": []
      }
