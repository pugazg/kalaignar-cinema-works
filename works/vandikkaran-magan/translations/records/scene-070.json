            "pdf_page": 85,
            "printed_page": 84
          }
        ]
      },
      "translation": {
        "english_text": "Why this pointless talk? Where have you come? Why have you come?....",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s070-u006",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s070",
