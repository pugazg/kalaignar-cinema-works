      "translation": {
        "english_text": "What, da—have you gone mad?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s070-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s070",
      "scene_ordinal": 70,
