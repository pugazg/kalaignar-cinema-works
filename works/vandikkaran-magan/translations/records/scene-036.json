        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 50,
            "printed_page": 49
          }
        ]
      },
      "translation": {
        "english_text": "What more do you want—should I slap my hand and swear it to you?... Should I light camphor and put it out at the Kaliamman temple? If he were a boy from a high-status family... could he mix so naturally in Sadaiyan's house?... Would he feel like eating old rice?...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
