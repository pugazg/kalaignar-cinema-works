            "printed_page": 49
          }
        ]
      },
      "translation": {
        "english_text": "Then... Uma will give him to me. Her ideal... is a bridegroom whose status is no lower than hers, isn't it!..",
        "mode": "prose-faithful",
        "notes": []
      }
    },
