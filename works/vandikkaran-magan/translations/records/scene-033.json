        ],
        "english_lines": [
          "He came; I joined him;",
          "he gave! — Upon the red",
          "mouth he kissed without pause!",
          "The swan that toys",
          "with colour! In her",
          "flower-jewel intoxications she revelled!"
        ]
      }
    },
