          }
        ]
      },
      "translation": {
        "english_text": "Come, son-in-law... come!... Oh! Poet!... Where did you go, ayya?... See, your daughter's marriage is taking place just as I said!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s055-u004",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s055",
      "scene_ordinal": 55,
      "source_scene_id": "42-எ",
      "source": {
