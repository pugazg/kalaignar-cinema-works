        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "புலவர்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 68,
            "printed_page": 67
          }
        ]
      },
      "translation": {
        "english_text": "Zamindar ayya! Forgive me—I thought wrongly of you. Listening to your son-in-law Vingan's words was my fault.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
