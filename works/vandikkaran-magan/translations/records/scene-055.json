        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஊர்ப்பெரியவர்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 69,
            "printed_page": 68
          }
        ]
      },
      "translation": {
        "english_text": "(to Vingan) Throwing dust and slander on this virtuous man has become your occupation!.. Listening to you, we too became madmen.. Master, forgive us!...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s055-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
