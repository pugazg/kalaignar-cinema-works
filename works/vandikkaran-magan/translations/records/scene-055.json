      },
      "translation": {
        "english_text": "(pointing out the zamindar to Vingan) What do you say now, son?... Did you see my god's divine play?... Haste and anger keep clouding your intelligence!.. This is a form of compassion impossible to find anywhere in this Kali age, da!.. At least now fall at his feet and ask forgiveness!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s055-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s055",
      "scene_ordinal": 55,
      "source_scene_id": "42-எ",
      "source": {
