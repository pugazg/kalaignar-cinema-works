        "source_locator": null,
        "speaker_label": "ஜமீன்தார்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 68,
            "printed_page": 67
          }
        ]
      },
      "translation": {
        "english_text": "Enough, enough, don't praise me beyond measure, poet; all this is my duty!...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
