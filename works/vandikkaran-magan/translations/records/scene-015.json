          }
        ]
      },
      "translation": {
        "english_text": "Ayyo... no!.. Look at your age and look at mine!.. You’re old enough to be my father—how can you do this work?...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "vandikkaran-magan-en-s015-u010",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "vandikkaran-magan-s015",
      "scene_ordinal": 15,
      "source_scene_id": "13",
      "source": {
        "source_path": "works/vandikkaran-magan/dialogues/records/scene-015.json",
        "canonical_scene_path": "works/vandikkaran-magan/scenes/scene-015.md",
        "source_record_id": "vandikkaran-magan-s015-d005",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "காளிங்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":—",
        "page_provenance": [
          {
            "pdf_page": 25,
            "printed_page": 24
          }
        ]
      },
      "translation": {
        "english_text": "What age, what nonsense... Every beggar comes here an old man. If we embrace every one of them crying ‘he’s my father’s age,’ what will become of us? This is why the country gets no rain and goes to ruin! Why talk so meaninglessly? We are all of the zamindar class. The zamindar is God’s representative! I am his representative!! All these are servant fellows! Are you of their caste?... Hey, Sadaiya! Why are you standing there listening to a sermon?... Wipe the boots, da! Don’t touch him—touch only the boots!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
