        "page_provenance": [
          {
            "pdf_page": 77,
            "printed_page": 76
          }
        ]
      },
      "translation": {
        "english_text": "You're going to come and see for yourself anyway; you'll know when you see... Leave that aside!... Kokila!... Why did you send someone asking me to come here urgently?",
        "mode": "prose-faithful",
        "notes": []
      }
