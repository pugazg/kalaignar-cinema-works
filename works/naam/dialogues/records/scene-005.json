[
  {
    "id": "naam-s005-d001",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "என்ன சஞ்சீவி......வா...வா நம்ம வீட்டுக்கு அதிகமாக வர்றதில்லே......"
  },
  {
    "id": "naam-s005-d002",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "வராமல் என்ன...வைத்தியர்கள் அடிக்கடி வீட்டுக்கு வரக்கூடிய நிலமை கூடாது என்பது தான்."
  },
  {
    "id": "naam-s005-d003",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "நம்ம வீட்டுக்கு வியாதி பார்க்கத்தானே வரணும்? விருந்து சாப்பிடவும் வாலாம் சஞ்சீவி!"
  },
  {
    "id": "naam-s005-d004",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "வாலாம்...நாங்கள் சாப்பிட்றதும்......"
  },
  {
    "id": "naam-s005-d005",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "ஆ......"
  },
  {
    "id": "naam-s005-d006",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "நாங்க சாப்பிட்றதும் ஒங்க சாப்பாடு தானே."
  },
  {
    "id": "naam-s005-d007",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "சஞ்சீவி! நீ ரொம்பவும் நன்றி உள்ளவன்தான். ஆனால்...அந்த ஒரு விஷயத்தில் தான் உன்னே நம்ப முடியவில்லை."
  },
  {
    "id": "naam-s005-d008",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "எதில்...? வைத்தியத்திலா?"
  },
  {
    "id": "naam-s005-d009",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "ஹா...ஹூம்...அதில்தான் நீ அசகாய சூரனாச்சே! அந்த உயிரை மட்டும் என்னிடம் கொடுத்து விடு. என் கவலை தீர்ந்து விடும்."
  },
  {
    "id": "naam-s005-d010",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "கவலைப்படாதீங்க! உயிர் இருந்தால் அல்லவா கொடுப்பதற்கு?"
  },
  {
    "id": "naam-s005-d011",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "பிறகு யாரிடம் இருக்கிறது?"
  },
  {
    "id": "naam-s005-d012",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "அது...ரொம்பவும் இரகசியமாக இருக்கு! சங்கேதப் படாதீர்கள்! சஞ்சலமே தேவை இல்லை! சஞ்சீவியை நம்புங்கோ......!"
  },
  {
    "id": "naam-s005-d013",
    "scene_id": "naam-s005",
    "scene_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "டேய்...எங்கடா குமரன்? மாடு மேய்க்க போயிட்டானு?"
  }
]
