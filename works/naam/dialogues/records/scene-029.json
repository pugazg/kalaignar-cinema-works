[
  {
    "id": "naam-s029-d001",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "உயிலை பத்திரமாக வைத்திருப்பாய் என்று தானே உன்னிடம் அனுப்பினேன்! உயிலுடன் நீதிமன்றத்துக்கு அல்லவா போயிருக்க வேண்டும்; அவனிடம் போய் என் காரியம் செய்தாய்? ஆமா...இப்போதாவது உயிலை பத்திரமாக வைத்திருக்கிறாயா?"
  },
  {
    "id": "naam-s029-d002",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "உயில்...உயில்...உயிர்...!"
  },
  {
    "id": "naam-s029-d003",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "ஆம்! உயிர்தான்...எங்கே வைத்திருக்கிறாய்;"
  },
  {
    "id": "naam-s029-d004",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "உயில்...தீயில் எரிந்து சாம்பலாகப் போயிருக்கும் வைத்தியரே!"
  },
  {
    "id": "naam-s029-d005",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "பார் தாயா...என்னிடமே பொய் சொல்லுகிறியே!"
  },
  {
    "id": "naam-s029-d006",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "இல்லாவிட்டால் மலையப்பனிடம் சிக்கி இருக்கும்."
  },
  {
    "id": "naam-s029-d007",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 45
      }
    ],
    "text": "பிரேமா...!"
  },
  {
    "id": "naam-s029-d008",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "எம்ப்பா!"
  },
  {
    "id": "naam-s029-d009",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "இனிமேல் நீ குமரனை மறந்துவிட வேண்டியது தான்."
  },
  {
    "id": "naam-s029-d010",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "எம்ப்பா..."
  },
  {
    "id": "naam-s029-d011",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "தெளிவாகச் சொல்ல வேண்டுமா? இனிமேல் அவன் ஜமீன்தார் வீட்டு வாசல்லே கூட கால் எடுத்து வைக்க முடியாது! இனிமேல் அவனை நம்பிப் பிரயோஜனம் இல்லே! மறந்து விடு!"
  },
  {
    "id": "naam-s029-d012",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "அப்பா...நீங்கள் சொல்வீர்களே பாவத்துக்கு விளக்கம்...அப்படி எத்தனை பாவம் வேண்டுமானாலும் செய்யத் தயார்! அவர் எனக்கு கிடைத்தால் போதும்!"
  },
  {
    "id": "naam-s029-d013",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "(கோபத்துடன்) சீ..."
  },
  {
    "id": "naam-s029-d014",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 46
      }
    ],
    "text": "நாம் தான் அவரை வெளியே அனுப்ப மாட்டோமே..."
  },
  {
    "id": "naam-s029-d015",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 47
      }
    ],
    "text": "அனுப்பமாட்டோம்...நம்மையும் மீறி சந்தித்துவிட்டால்...இதற்கு நீ ஒரு பொய்பிரச்சாரம் செய்ய வேண்டும்."
  },
  {
    "id": "naam-s029-d016",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 47
      }
    ],
    "text": "பிரச்சாரமா?"
  },
  {
    "id": "naam-s029-d017",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 47
      }
    ],
    "text": "ஆம்! குமரன் பிசாசாக மாறிவிட்டான். பேயாகத் திரிகிறான்...என்று."
  },
  {
    "id": "naam-s029-d018",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 47
      }
    ],
    "text": "மனிதனை பிசாசு என்றால் நம்புவார்களாப்பா?"
  },
  {
    "id": "naam-s029-d019",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 47
      }
    ],
    "text": "மரம் செடிகள் அசைவதைப் பார்த்துக் கூட உலகத்தில் பலபேர் செத்திருப்பார்கள்! குமரன் பிசாசாக மாறிவிட்டான் என்று ஒரு பெண்ணிடம் சொல்! போதும் உலகம் பூராவும் தெரிந்து விடும்!"
  },
  {
    "id": "naam-s029-d020",
    "scene_id": "naam-s029",
    "scene_ordinal": 29,
    "source_scene_number": 29,
    "source_heading": "காட்சி 29.",
    "speaker_label": "பெண்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 47
      }
    ],
    "text": "கண்ணங்கரேனு வந்திச்சாம்! காலைக் காணோம்! காவக்கார அண்ணே சப்தம் போட்டுச்சாம்! காத்துப்போல பறந்துச்சாம்!"
  }
]
