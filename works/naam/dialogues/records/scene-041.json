      }
    ],
    "text": "அய்யா......காலணா......போடுங்கய்யா"
  },
  {
    "id": "naam-s041-d003",
    "scene_id": "naam-s041",
    "scene_ordinal": 41,
    "source_scene_number": 41,
    "source_heading": "காட்சி 41",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-041.md",
    "page_provenance": [
      {
        "pdf_page": 66,
        "printed_page": 66
      }
    ],
    "text": "ஆ...இது யார் குழந்தை?"
  },
  {
    "id": "naam-s041-d004",
    "scene_id": "naam-s041",
    "scene_ordinal": 41,
    "source_scene_number": 41,
    "source_heading": "காட்சி 41",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-041.md",
    "page_provenance": [
      {
        "pdf_page": 66,
        "printed_page": 66
      }
    ],
    "text": "என் குழந்தை தானய்யா!"
  },
  {
    "id": "naam-s041-d005",
    "scene_id": "naam-s041",
    "scene_ordinal": 41,
    "source_scene_number": 41,
    "source_heading": "காட்சி 41",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-041.md",
    "page_provenance": [
      {
        "pdf_page": 66,
        "printed_page": 66
      }
    ],
    "text": "அய்யோ...என் மீனு விபச்சாரி! என் மீனு விபச்சாரி!"
  },
  {
    "id": "naam-s041-d006",
    "scene_id": "naam-s041",
    "scene_ordinal": 41,
    "source_scene_number": 41,
    "source_heading": "காட்சி 41",
    "speaker_label": "ஜீவானந்தர்",
