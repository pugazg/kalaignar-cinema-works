[
  {
    "id": "naam-s027-d001",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "குமரன்..."
  },
  {
    "id": "naam-s027-d002",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "மீனு...மீனு...மீனு..."
  },
  {
    "id": "naam-s027-d003",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "ஹா-ம் ......காதல், காதல் என்று கதை சொன்னாயே...இப்போது என்ன செய்வாய்? அதோ கேட்கிறது யார் காதல் கீதம்."
  },
  {
    "id": "naam-s027-d004",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "அப்பா...நான் செய்தது தவறுதான்...என்னே மன்னிச்சிடுங்கப்பா..."
  },
  {
    "id": "naam-s027-d005",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "அழாதே பிரேமா...நீ சந்தோஷமாக இருக்கவேண்டு மென்றுதானே கஷ்டப்பட்டேன்."
  },
  {
    "id": "naam-s027-d006",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "அப்பா...அவர் பிழைத்துக் கொள்வாரா?"
  },
  {
    "id": "naam-s027-d007",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "உன்னைப் பார்த்தால் எனக்கு சிரிப்புதான் வருகிறது."
  },
  {
    "id": "naam-s027-d008",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "அவரைப் பார்த்தால் எனக்கு பாவமாக இருக்கிறது."
  },
  {
    "id": "naam-s027-d009",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 43,
        "printed_page": 43
      }
    ],
    "text": "பாவம்! பாவத்தைப் பார்த்தால் பல மண்டூகங்கள் மாடமாளிகை, கூடகோபுரம் இவைகளே பார்த்திருக்க முடியாது! மலையப்பனைப் பார்! எப்படி வந்தது அவனுக்கு இந்த மந்தகாசமான வாழ்வு? பாவத்தை நினைத்தும் பார்க்காத காரணத்தால்! தோல்விதான் வெற்றிக்கு போடப்படும் முதல் படி! நீ குமரனை அடைய வேண்டுமென்றால் குமரன் மீனுவை மறக்க வேண்டும். குமரன் இறந்து விட்டதாக நினைத்துக் கொண்டிருக்கிறாள் மீனு....குமரனை நாம்வெளியே விடக்கூடாது! குமரன் உயிருடன் இருப்பது வேறு யாருக்குமே தெரியக் கூடாது! தெரிகிறதா? இதிலாவது ஜாக்கிரதையாக இரு!"
  },
  {
    "id": "naam-s027-d010",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "அய்யய்யோ ......நாய்க்குட்டி எங்கே போவுங்க?"
  },
  {
    "id": "naam-s027-d011",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "கண்டிப்பாகச் சொல்றேன்...நீ வேலைக்கு வர வேண்டாம்."
  },
  {
    "id": "naam-s027-d012",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "நாய்க்குட்டி செத்துப் போவுங்க."
  },
  {
    "id": "naam-s027-d013",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "ஒழுங்காக போயிடு!"
  },
  {
    "id": "naam-s027-d014",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "நாய்க்குட்டி போறதுன்னு ஒரு மாத நோட்டீஸ் கொடுக்கணுங்க!"
  },
  {
    "id": "naam-s027-d015",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "எனக்கு உன்னை பிடிக்கலே! உன் மேலே எனக்கு நம்பிக்கை இல்லே!"
  },
  {
    "id": "naam-s027-d016",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "பிடிக்கலேன்னு சொல்லுங்க! நம்பிக்கை இல்லேன்னு சொல்லாதீங்க! நானென்ன காய்ச்சல்காரனுக்கு காலரா மருந்து கொடுத்தேனா? காலராக்காரனுக்கு பேதி மருந்து கொடுத்தேனா? எனக்கும் தெரியும்! நானும் ஒரு போட்டி ஆஸ்பத்திரி வைக்கிறேன்! ஒங்ககிட்டே ஒரு நோயாளியும் வரமாட்டான்! நீங்களே நோயாளியா ஆக வேண்டியதுதான்! சஞ்சீவி வைத்தியரே விரைவில் எதிர்பாருங்கள்! மாத்திரை முன்னேற்ற ஆஸ்பத்திரியை!"
  },
  {
    "id": "naam-s027-d017",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "மாத்திரை பாவம்ப்பா!"
  },
  {
    "id": "naam-s027-d018",
    "scene_id": "naam-s027",
    "scene_ordinal": 27,
    "source_scene_number": 27,
    "source_heading": "காட்சி 27",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 44,
        "printed_page": 44
      }
    ],
    "text": "பாவத்தைப் பற்றித்தான் முன்னே சொன்னேனே...குமரன் உயிருடன் இருப்பது—மாத்திரைக்குக் கூடத் தெரியக்கூடாது! இப்போது யோசி...பாவத்தை எப்படி யெல்லாம் மறக்க வேண்டும் மென்று!"
  }
]
