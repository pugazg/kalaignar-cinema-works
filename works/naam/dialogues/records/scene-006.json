[
  {
    "id": "naam-s006-d001",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "என்ன பிரேமா தேடுறே?"
  },
  {
    "id": "naam-s006-d002",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "அப்பா ஒரு நல்ல மருந்து இருக்குன்னு சொன்னாரு! வலி, காயத்துக்கெல்லாம் போட்டால் உடனே சுகம் ஆகி விடுமாம். அதைத்தான் தேடுறேன்."
  },
  {
    "id": "naam-s006-d003",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 14
      }
    ],
    "text": "வேண்டாம் பிரேமா...இருக்கிற மருந்தைப் போடு! நீ ஏன் கஷ்டப்படுகிறாய்?"
  },
  {
    "id": "naam-s006-d004",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "உங்களுக்காக எவ்வளவு கஷ்டப்பட்டாலும் பரவாயில்லே......"
  },
  {
    "id": "naam-s006-d005",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "இந்த அன்பு உள்ளம் உலகத்தில் எல்லோருக்கும் இருந்தால்......"
  },
  {
    "id": "naam-s006-d006",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "எப்படி இருக்கும்? எல்லோரும் பிரேமா வாகவர் இருக்க முடியுமா? அழகான பூஞ்செடியைப் பற்றி தோட்டக்காரன் தானே கவலைப்படுவான். ஆடுமாடுகளா கவலைப்படும்?"
  },
  {
    "id": "naam-s006-d007",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "நல்ல வேளை...ஞாபகப்படுத்தினாய்...மறந்தே போய் விட்டேன். மாட்டை ஓட்டிக் கிட்டுப் போகணும். இல்லாட்டா அந்த ஜமீன்தாரு கத்துவாரு! நான் வாறேன்."
  },
  {
    "id": "naam-s006-d008",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "ஏன்...இப்படி...கொஞ்சம் கூட ஓய்வு வேண்டாமா?"
  },
  {
    "id": "naam-s006-d009",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "நீ ஒரு பைத்தியம்! ஏழைகளின் ஓய்வுக்கு இந்த உலகத்திலே சோம்பேறி என்று அர்த்தம்."
  },
  {
    "id": "naam-s006-d010",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "“ஓரிடந்தனிலே...நீ யில்லா துலகினிலே...உருண்டோடிடுமே...ப......”"
  },
  {
    "id": "naam-s006-d011",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "என்ன மாத்திரை?"
  },
  {
    "id": "naam-s006-d012",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "ஓட ஓட துரத்தி அந்த உடம்பு எண்ணெயை அவன் தலையிலேயே கட்டிட்டு வந்துட்டேன்."
  },
  {
    "id": "naam-s006-d013",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "அய்யோ...பாவம்......"
  },
  {
    "id": "naam-s006-d014",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "நான் ஓடினது ஒண்ணும் பாவம் இல்லே...ஒரு ரூபாய் கொடுத்து அந்த எண்ணெயை வாங்கிட்டுப் போனேனே...அது தான் பாவம்."
  },
  {
    "id": "naam-s006-d015",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "பிரே",
    "source_delimiter": ":",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "எய்...மாத்திரை!"
  },
  {
    "id": "naam-s006-d016",
    "scene_id": "naam-s006",
    "scene_ordinal": 6,
    "source_scene_number": 6,
    "source_heading": "காட்சி 6",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 15
      }
    ],
    "text": "அய்யய்யோ...நாய்க்குட்டி செத்துடுமே."
  }
]
