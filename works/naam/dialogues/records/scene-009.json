[
  {
    "id": "naam-s009-d001",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "என்னடா?"
  },
  {
    "id": "naam-s009-d002",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "அது எழுந்திருக்காதுங்க."
  },
  {
    "id": "naam-s009-d003",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "அப்புறம்...? என்னே நடந்து போகச்சொல்றியா? ஒரு பக்கத்தை நீ பிடிச்சி இழுடா."
  },
  {
    "id": "naam-s009-d004",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "டேய்! மாடு ரொம்ப களைச்சிருக்கும்! போயி தண்ணி காட்டு! தண்ணி காட்டிட்டு அந்த நொண்டி மாட்டைப் போயி கூட்டிக்கிட்டுவா. என்னே......"
  },
  {
    "id": "naam-s009-d005",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "போதும் கஷ்டம், இனி பொறுக்க முடியாது."
  },
  {
    "id": "naam-s009-d006",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "(அன்பு அன்னையை அணைத்து) அம்மா...என்னம்மா செய்யுது?"
  },
  {
    "id": "naam-s009-d007",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "இந்தப்பாழும் கண்கள் இன்னும் ஏன் இருக்கிறது? வாழ்க்கை வண்டியிலே நீயும்—என் மருமகளும் பூட்டப்பட்டு அந்தச் சோபிதத்தை சுவைக்க வேண்டுமென்று கனவு கண்டேனடா! கனவு மறைந்து கானல் மாடுமே—என் மகனும் வண்டியை இழுப்பார்கள் என்று இந்தக் காதியின் நெஞ்சம் நினைக்கக்கூட இல்லை."
  },
  {
    "id": "naam-s009-d008",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 19
      }
    ],
    "text": "அம்மா...இப்போதே அனுமதி கொடுங்கள்—வெளியேறி விடுவோம்."
  },
  {
    "id": "naam-s009-d009",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "வேண்டாம்டா கண்ணு...உன்னைவிட கொதித்துப் போனதுதான் என்னுடைய இரத்தமும். ஆனால்...அந்த ஒரு விஷயத்துக்காகத்தான் இன்னும் உயிருடன் இருக்கிறேன்."
  },
  {
    "id": "naam-s009-d010",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "அடிக்கடி சொல்கிறீர்களே...என்னம்மா அந்த இரகசியம்?"
  },
  {
    "id": "naam-s009-d011",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "உன்னைச் சீமானாக்கும் இரகசியம் மல்லயப்பனிடம் சிக்கி இருக்கிறது."
  },
  {
    "id": "naam-s009-d012",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்ல",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "விஷயத்தைச் சொல்."
  },
  {
    "id": "naam-s009-d013",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "ஞா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "என்னத்தை சொல்றது? கழுத்துக்கு கத்தி வைக்க காத்திருக்காங்க—தாயும்—பிள்ளையும்."
  },
  {
    "id": "naam-s009-d014",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "விபரமாகச் சொல் ஞானம்!"
  },
  {
    "id": "naam-s009-d015",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "ஞா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "உங்களை குமரன் கொல்லுவதற்கு கொக்கரிக்கிறான். அவன் சீமானாக்கும் இரகசியம் உங்களிடம் சிக்கி இருக்கிறதாம்! இதை நாராயணி குமரனிடம் சொல்வதை இந்தக் காதாலே கேட்டேன்."
  },
  {
    "id": "naam-s009-d016",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "இரகசியம்...இரகசியம் அந்த உயில்தான்...ஞானம்! இவள் நாராயணி அல்ல—வேலைக்காரி வேஷத்திலே வேதவல்லி! விடக்கூடாது இவர்களை—விபரீதம் ஏற்பட்டு விடும்."
  },
  {
    "id": "naam-s009-d017",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "ஞா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "இப்படி என்னையும் மறந்து கவலைப்படுவீர்கள் என்று தெரிந்திருந்தால் சொல்லி இருக்கவே மாட்டேன்."
  },
  {
    "id": "naam-s009-d018",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "போறு ஞானம்! இவர்களை விடக்கூடாது! ஞானம் இதோ பார்!"
  },
  {
    "id": "naam-s009-d019",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "ஞா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 20
      }
    ],
    "text": "பாய்சன்!"
  },
  {
    "id": "naam-s009-d020",
    "scene_id": "naam-s009",
    "scene_ordinal": 9,
    "source_scene_number": 9,
    "source_heading": "காட்சி 9.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-009.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "விஷம் என்னிடம்—விவேகம் உன்னிடம் அந்தப் பிச்சைக்கார குமரனை பிணமாக்கவேண்டும். ஜாக்கிரதை! சதி செய்வது ஒரு ஜாலவித்தை! அதற்கு நீதான் சரியானவள்! இன்று அவசரமாக நான் வெளியூர் போகிறேன். இரவு திரும்பிவருவதற்குள் அந்த நாயின் சவத்திலே தீ பரவ வேண்டும்."
  }
]
