[
  {
    "id": "naam-s017-d001",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "மல்லயப்பர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "குத்துச் சண்டை போட்டி எதற்காக என்று நினைத்தாய்? கிராம மக்கள் குதூகலப்படுத்தவா? இது தான் எங்களுக்கு வேலை? அந்த நாயைக் கொல்ல வேண்டும்?"
  },
  {
    "id": "naam-s017-d002",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "பரமசிவம்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "கொல்றதுன்னு லேசான காரியங்களா? தோற்கடிச்சுட்றேன்."
  },
  {
    "id": "naam-s017-d003",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "மல்லயப்பர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "நீ வீராதிவீரன் என்று வெற்றி மாலை சூடுவதல்ல—எனக்கு வேண்டியது. அவனைக் கொல்லவேண்டும்."
  },
  {
    "id": "naam-s017-d004",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "பரமசிவம்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "அப்படி என்றால்..."
  },
  {
    "id": "naam-s017-d005",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "மல்லயப்பர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "தவறான முறையில் சண்டையிடு!"
  },
  {
    "id": "naam-s017-d006",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "பரமசிவம்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "குத்துச் சண்டை சட்டப்படி குற்ற மாச்சுதுங்களே..."
  },
  {
    "id": "naam-s017-d007",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "மல்லயப்பர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "சட்டம்! என்னிடம் சரணடையும்! தூக்கு மேடையில் இருப்பவனை காப்பாற்றும் துணிவு எனக்கு உண்டு! பாவம், புண்ணியம், நேர்மை, நீதி, இரக்கம், சட்டம், சமூதாயம் இவைகள் என்னிடம் செல்லாது. அனுசரித்தே பரமசிவம்! அவனை நீ கொல்லவேண்டும்! அதைக் கண்டு என் மனம் குளிரவேண்டும்."
  },
  {
    "id": "naam-s017-d008",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "உங்கள் அன்பிற்கும், ஆரவாரத்திற்கும் நான் எப்படி நன்றி தெரிவிக்கப் போகிறேன்?"
  },
  {
    "id": "naam-s017-d009",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "ஒருவன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      }
    ],
    "text": "தம்பி! இன்னிக்குத்தான் நாங்க சந்தோஷத்தைக் கண்டிருக்கிறோம். பசி, பட்டினி, அடி, உதை இவைகள்தான் இங்கு!"
  },
  {
    "id": "naam-s017-d010",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 32
      },
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "என்ன செய்வது? அந்த உயில் மட்டும் அகப்பட்டு விட்டால் இந்த ஜமீனையே உங்களுக்கு சொந்த\nமாக்குவேன். ஜரிகைத் தொப்பி உங்களை ஆளாது! சவுக்கு சவாரிகாரன் செலுத்தாது! அந்தக் காட்டு இராஜாவின் கண் அசைப்பு கட்டளையாக இருக்காது!",
    "page_segments": [
      {
        "pdf_page": 32,
        "printed_page": 32,
        "text": "என்ன செய்வது? அந்த உயில் மட்டும் அகப்பட்டு விட்டால் இந்த ஜமீனையே உங்களுக்கு சொந்த"
      },
      {
        "pdf_page": 33,
        "printed_page": 33,
        "text": "மாக்குவேன். ஜரிகைத் தொப்பி உங்களை ஆளாது! சவுக்கு சவாரிகாரன் செலுத்தாது! அந்தக் காட்டு இராஜாவின் கண் அசைப்பு கட்டளையாக இருக்காது!"
      }
    ]
  },
  {
    "id": "naam-s017-d011",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "ஜீவானந்தர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "ஏழைகள் இன்பலோகத்தை கற்பனை செய்வதில் தனி ஆறுதல்."
  },
  {
    "id": "naam-s017-d012",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "ஜீவானந்தரே! பக்தர்கள் கற்பனை செய்யும் சொர்க்க லோகமல்ல இது! முயன்றால் முடியக்கூடியது! நினைத்தால் நடக்கக்கூடியது! அதை அடைய நெற்றி நிறைய விபூதி அல்ல! நெஞ்சிலே தெளிவு—நேர்மையிலே நாட்டம்—இருந்தால் போதும்."
  },
  {
    "id": "naam-s017-d013",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "ஜீவா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "எதிர் பார்ப்போம்—அந்த நல்ல நாளை."
  },
  {
    "id": "naam-s017-d014",
    "scene_id": "naam-s017",
    "scene_ordinal": 17,
    "source_scene_number": 17,
    "source_heading": "காட்சி 17.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "நல்ல நாள் நம்மை நோக்கி வராது! அதை நோக்கி நாம் கால்கடுக்க நடக்க வேண்டும்."
  }
]
