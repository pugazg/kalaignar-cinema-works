[
  {
    "id": "naam-s032-d001",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "ஒருவன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 52
      }
    ],
    "text": "இருட்டு பேய் இனிமேல் திரும்பக்கூடாதப்பா! பிசாசு அடிச்சிடும்."
  },
  {
    "id": "naam-s032-d002",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "மற்றொருவன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 52
      }
    ],
    "text": "ஆமா...ஆமா...அதுவும் இலேசான பிசாசா? குத்துச்சண்டை தெரிஞ்ச பிசாசு!..."
  },
  {
    "id": "naam-s032-d003",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "ஒரு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 52
      }
    ],
    "text": "ஏ...குட்டி...வண்டியிலே கொஞ்சம் வேப்பிலையை சொருகு...ஊரெல்லாம் பிசாசு பயமா இருக்கு..."
  },
  {
    "id": "naam-s032-d004",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "ஒருவன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 52
      }
    ],
    "text": "ஆமா...இந்தப் பிசாசை ஒழிக்கிறதுக்கு என்ன செய்யுறது?"
  },
  {
    "id": "naam-s032-d005",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 52
      }
    ],
    "text": "அம்பாள் கோவிலுக்கு பூஜைபோட்டு—பிரார்த்தனை செய்தால் சரியாப்போகும்."
  },
  {
    "id": "naam-s032-d006",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "ஒரு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "நேத்து இராத்திரி எங்க வீட்டு கூரையிலே வந்து கூ...கூ...ன்னு கத்துச்சி!"
  },
  {
    "id": "naam-s032-d007",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "ஆந்தையா இருக்கும்."
  },
  {
    "id": "naam-s032-d008",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "ஒரு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "அட...சட சடன்னு எறங்கி போச்சப்பா..."
  },
  {
    "id": "naam-s032-d009",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "ஆமா...ஆமா...இருக்கும். நான்கூட நேத்து இராத்திரி வெளியிலே காத்துவாங்கப் போனேன். கருப்பா...கனமா...கட்டையா வந்துச்சி! எனக்கு உடம்பு வேர்த்து விறுவிறுத்துப்போச்சி! பார்த்தேன்...அதுவும் போச்சி! பின்னாலேயே போனேன்...வைத்தியர் வீட்டு பக்கமா திரும்பிச்சி! என்னடா வைத்தியர் வீட்டு பக்கமா போகுது? பிசாசுக்கு உடம்பு சரியா இல்லையோ...வாற வழியிலே எதுவும் ஆயிடுச்சோ...வைத்தியர் வீடு பக்கமா போகுது? நான் விடலே...பின்னாலேயே போனேன்—நம்ம கோடிவீட்டு கோமளம் இல்லே...அதான் ஒரு மாதிரி...அந்த வீட்டுக் கதவை தட்டுச்சி! பார்த்தேன்...சரிதான்...என்னமோ நடக்கப்போகுது......விளக்கை தூக்கிக்கிட்டு கோமளம் வந்தாள். நான் பார்த்தேன்...யாரு தெரியும்லே...நம்ம அம்பாள் கோவில் பூசாரி...இந்த மூட்டாள் பயல் சிநேகிதன்—சங்காரமூர்த்தி! போங்கடா போக்கத்தவங்களா!"
  },
  {
    "id": "naam-s032-d010",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "டேய்...கிண்டலாபண்றே?"
  },
  {
    "id": "naam-s032-d011",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "ஒருத்தன் கருப்பா வாந்தி எடுப்பான்! அதைப் பார்த்துக்கிட்டு இன்னொருத்தன் காக்கா நிறமா வாந்தி எடுத்தானப்பான்! இன்னொருத்தன் சொல்லுவான்...காக்கா...காக்காயா வாந்தி எடுத்தானப்பான்."
  },
  {
    "id": "naam-s032-d012",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "டேய்! இவன் பேச்சை நம்பாதீங்க ஊர் உருப்படாது."
  },
  {
    "id": "naam-s032-d013",
    "scene_id": "naam-s032",
    "scene_ordinal": 32,
    "source_scene_number": 32,
    "source_heading": "காட்சி-32",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-032.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 53
      }
    ],
    "text": "இவன் பேச்சை நம்புங்க—ஊர் உருப்பட்டுப் போகும்! போங்கடா!"
  }
]
