[
  {
    "id": "naam-s014-d001",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "டேய் தம்பி! இங்கே வா! இந்தப் பெட்டியை தூக்கிட்டு வர்றியா?"
  },
  {
    "id": "naam-s014-d002",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "ஓ—"
  },
  {
    "id": "naam-s014-d003",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "தூக்கு...தலையிலே..."
  },
  {
    "id": "naam-s014-d004",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "ஹல்லோ...இப்போதான் வர்றீங்களா?"
  },
  {
    "id": "naam-s014-d005",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "ஆமா...டேய்...பெட்டி படுக்கையைக் கொண்டு உள்ளே வை ஹூம்...அவன் சத்திய சீலன் வந்தாச்சா?"
  },
  {
    "id": "naam-s014-d006",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "வந்தாச்சி."
  },
  {
    "id": "naam-s014-d007",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "வர்ற வழியிலே பார்த்துக்கிட்டேதான் வந்தேன். விளம்பரம் ரொம்ப தடபுடல்."
  },
  {
    "id": "naam-s014-d008",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "மிஸ்டர் பீமசேனன்! நான் ஒரு காண்டிராக்ட்காரன்! பணத்தை மிச்சம் பண்ணணுங்குற அபிப்பிராயமே எனக்கு கிடையாது. (ஆரஞ்சுப்பழமும் வைக்கப்படுகிறது) சாப்பிடுங்க!"
  },
  {
    "id": "naam-s014-d009",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "பரவாயில்லே...நீங்க கந்தசாமின்னு கந்தசாமிதான்."
  },
  {
    "id": "naam-s014-d010",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "அய்யா...அய்யா..."
  },
  {
    "id": "naam-s014-d011",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "யாரது?"
  },
  {
    "id": "naam-s014-d012",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "மூட்டை தூக்கிட்டு வந்தவன்."
  },
  {
    "id": "naam-s014-d013",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "ஓ...ஹோ...மறந்துட்டேன். இந்தா ஒரு அணா."
  },
  {
    "id": "naam-s014-d014",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "ஒரு அணா!"
  },
  {
    "id": "naam-s014-d015",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 29
      }
    ],
    "text": "பின்னே எவ்வளவுடா?"
  },
  {
    "id": "naam-s014-d016",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "ஏதோ பார்த்துக் கொடுங்க."
  },
  {
    "id": "naam-s014-d017",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "இந்தப் பயல்கிட்டே முதல்லே பேசிக் கிடாததே தவறு! டேய்...மரியாதையா போயிரு."
  },
  {
    "id": "naam-s014-d018",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "எவ்வளவு தூரம் தூக்கிட்டு வந்தேன்."
  },
  {
    "id": "naam-s014-d019",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "அதுக்கு வேறையா பேசுறே? டேய்...போறியா? உதை வேணுமா?"
  },
  {
    "id": "naam-s014-d020",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "கூலி கேட்டா உதையா!"
  },
  {
    "id": "naam-s014-d021",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "டேய்...கொடுக்கிறதை வாங்கிட்டுப்போடா."
  },
  {
    "id": "naam-s014-d022",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "எதை...உதையையா?"
  },
  {
    "id": "naam-s014-d023",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "டேய்...இப்போ போறியா இல்லையா?"
  },
  {
    "id": "naam-s014-d024",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "சிலருக்கு பணக் கொழுப்பு, சிலருக்கு சதைக் கொழுப்பு!"
  },
  {
    "id": "naam-s014-d025",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "டேய்...என்ன சொன்னே? என்னடா சொன்னே...கந்தசாமி தடுக்கிறான்."
  },
  {
    "id": "naam-s014-d026",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "மிஸ்டர் பீமசேனன்! நீங்க இப்பவே குத்துச் சண்டை போட்ட ஆரம்பிச்சுட்டா ஜனங்கள் டிக்கட் இல்லாமே பார்த்துட்டுப் போயிடு வாங்க. எனக்கு வசூல் வசூல்தான்."
  },
  {
    "id": "naam-s014-d027",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "விடுங்க மிஸ்டர் கந்தசாமி! இந்தப் பசங்களே சும்மா விடக்கூடாது."
  },
  {
    "id": "naam-s014-d028",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "கந்தசாமி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "மிஸ்டர் பீமசேனன்! ரொம்பவும் டயர்டா இருக்கீங்க—பாவம் இளைப்பாறுங்க—நான் இதோ வர்றேன்."
  },
  {
    "id": "naam-s014-d029",
    "scene_id": "naam-s014",
    "scene_ordinal": 14,
    "source_scene_number": 14,
    "source_heading": "காட்சி 14",
    "speaker_label": "பீமசேனன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 30
      }
    ],
    "text": "பரவாயில்லே...என் கையை வேறிலே சுமட்டிக் கிட்டான்."
  }
]
