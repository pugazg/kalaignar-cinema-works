[
  {
    "id": "naam-s042-d001",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "என் மீனுவை பார்த்தீர்களா? இந்தக் கொடிய முகத்தை பார்க்கக்கூடாது என்று குருடியாகி விட்டாள்."
  },
  {
    "id": "naam-s042-d002",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "குழந்தையின் முகத்தை பார்க்க முடியாத பாவியாகி விட்டேன்! முத்து...நீ எப்படி இருக்கிறாய்? உன் அப்பாவைப் போல் சிகப்பாகவா இருக்கிறாய்? என் வேஷம் பார்த்தால் உனக்கு பிச்சைக்காரி போலவா தெரிகிறது? நான் பிச்சைக்காரி அல்ல! ஜமீன்தார் மனைவி! ஓங்க அப்பா ஜமீன்தார்!"
  },
  {
    "id": "naam-s042-d003",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "மீனு......அந்தத் தேவையற்ற கிரீடத்தை நான் தேடியதே இல்லை! பொருள் எல்லாம் பொதுவுடமையாக்க எண்ணினேன். ஆனால்......அந்த ஆசை நெருப்பிலே விழுந்து உயிர் சாம்பலாகி விட்டது."
  },
  {
    "id": "naam-s042-d004",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "சாம்பலாகவில்லை. உயிர் இருக்கிறது."
  },
  {
    "id": "naam-s042-d005",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "உயிர் இருக்கிறதா?"
  },
  {
    "id": "naam-s042-d006",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "ஆம்...வைத்தியரிடம் இருக்கிறது."
  },
  {
    "id": "naam-s042-d007",
    "scene_id": "naam-s042",
    "scene_ordinal": 42,
    "source_scene_number": 42,
    "source_heading": "காட்சி 42",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 67
      }
    ],
    "text": "ஜீவானந்தரே! மக்களுக்கு புது வாழ்வு கிடைத்து விட்டது!"
  }
]
