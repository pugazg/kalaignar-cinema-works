[
  {
    "id": "naam-s022-d001",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 36
      }
    ],
    "text": "குமரனுக்கு ஒண்ணும் பிடிவாதம் இல்லே ..எல்லாம் உங்களுக்குத் தான்."
  },
  {
    "id": "naam-s022-d002",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 36
      }
    ],
    "text": "பிரேமா......குமரன் உன்னைத்தான் கல்யாணம் செய்து கொள்வான்—கவலைப்படாதே! பிரேமா! அப்படியே ஏற்பாடுக்கும் போயிட்டு வர்றேன். வீட்டிலே பத்திரமா இரு! டேய் மாத்திரை! அந்தக் கண்ணன் தாயாருக்கு நாம் தானே மருந்து கொடுக்கிறோம்..."
  },
  {
    "id": "naam-s022-d003",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "ஆமாங்க."
  },
  {
    "id": "naam-s022-d004",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "என்ன ஆச்சி!"
  },
  {
    "id": "naam-s022-d005",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "சரியாய்போச்சிங்க! வெளியூருக்கெல்லாம் ஆள அனுப்பி வச்சிட்டாங்களாம்!"
  },
  {
    "id": "naam-s022-d006",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "ஓ......போயி வண்டியை பூட்டுடா!"
  },
  {
    "id": "naam-s022-d007",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "திருமணத்திற்குப் பிறகு நீங்கள் ஏமாற்றிவிட்டால்......?"
  },
  {
    "id": "naam-s022-d008",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "கேடாமல் வருகிற தேவாமிர்தம்! சிரமப்படாமல் வருகிற ஜமீன் மாளிகை! இவற்றை தேவை இல்லே என் பெண்? இதோ பார்......"
  },
  {
    "id": "naam-s022-d009",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "நீங்கள் உயில் இழக்க மாட்டீர்கள்! அவர் உறுதியை இழக்க மாட்டார்! கடைசியாக நான் தான் என் காதலை இழக்க வேண்டும்."
  },
  {
    "id": "naam-s022-d010",
    "scene_id": "naam-s022",
    "scene_ordinal": 22,
    "source_scene_number": 22,
    "source_heading": "காட்சி 22.",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 37
      }
    ],
    "text": "காதல்...இந்த உயில் விடவா உயர்ந்தது? இந்த மாளிகையை விடவா மதிப்பு வாய்ந்தது? பிரேமா! பாரேன்—புயல் உன் பாதத்தில் வந்து விழப்போகிறான். ஜாக்கிரதை! யாரிடமும் உதட்டையும் அசைத்து விடாதே!"
  }
]
