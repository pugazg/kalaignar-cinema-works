        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "உயில்...உயில்...என் உயிர்!"
  },
  {
    "id": "naam-s023-d002",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
    "source_scene_number": 23,
    "source_heading": "காட்சி 23.",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-023.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "மெதுவா..."
  },
  {
    "id": "naam-s023-d003",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
    "source_scene_number": 23,
    "source_heading": "காட்சி 23.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-023.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "பிரேமா...நீயா கொண்டு வந்தாய்?"
  },
  {
    "id": "naam-s023-d004",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
    "source_scene_number": 23,
    "source_heading": "காட்சி 23.",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-023.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "பிறகு யார் கொண்டு வருவார்கள் ஜமீன்தாரே?"
  },
  {
    "id": "naam-s023-d005",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
    "source_scene_number": 23,
    "source_heading": "காட்சி 23.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-023.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "நான் ஜமீன்தார் அல்ல! ஜனங்களின் ஊழியன்—மக்கள் தொண்டன்! இந்த உதவியை மறக்க மாட்டேன் சகோதரி!"
  },
  {
    "id": "naam-s023-d006",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
    "source_scene_number": 23,
    "source_heading": "காட்சி 23.",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-023.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "சகோதரி......"
  },
  {
    "id": "naam-s023-d007",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
    "source_scene_number": 23,
    "source_heading": "காட்சி 23.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-023.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 38
      }
    ],
    "text": "அம்மா! உயில் கிடைத்து விட்டது! நீங்கள் தேடி அலைந்த செல்வம் கிடைத்து விட்டது! புதைந்து கிடந்த பொக்கிஷம் அகப்பட்டு விட்டது. இப்போதே போகிறேன் அந்தப் பொல்லாதவனிடம்."
  },
  {
    "id": "naam-s023-d008",
    "scene_id": "naam-s023",
    "scene_ordinal": 23,
