[
  {
    "id": "naam-s033-d001",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "வைத்தியரே! இந்த மலையங்களாவுக்கு வந்திருப்பது குழந்தையைக் கொல்லும் சூதாக இருக்காதே..."
  },
  {
    "id": "naam-s033-d002",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "சிவ சிவா சிசுஹத்தி...உயிர்கள் காப்பாற்றுவதையே தொழிலாகக் கொண்டவன் நான்...நினைப்பேனு அந்த நாச வேலையை?"
  },
  {
    "id": "naam-s033-d003",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "குழந்தையை வளர்க்க அண்ணன் சம்மதிக்க மாட்டாரே!"
  },
  {
    "id": "naam-s033-d004",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "இதோ......நான் இருக்கிறேன்......பிரேமா இருக்கிறாள்! எனக்குப் பிறக்கும்குழந்தை மாதிரி!"
  },
  {
    "id": "naam-s033-d005",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "என்னமோ...இந்தக் குழந்தை குமரன் குழந்தை! இதைப் பார்க்க குமரனுக்கு கொடுத்து வைக்கலே......"
  },
  {
    "id": "naam-s033-d006",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "அட...அவன் தான் பேய்னு...அந்த உயில்? யாராவது பத்திரமாக காப்பாற்றக் கூடாதா?"
  },
  {
    "id": "naam-s033-d007",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "பத்திரமாக இருக்கிறது வைத்தியரே!"
  },
  {
    "id": "naam-s033-d008",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "இருக்கிறதா?"
  },
  {
    "id": "naam-s033-d009",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "இதோ......! (உயிலைக் கொடுக்கிறாள்)"
  },
  {
    "id": "naam-s033-d010",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "ஆமா...இதை கையோடே எடுத்துக்கிட்டு வந்துட்டியே பிரசவ நேரத்திலே அண்ணன் கையிலே கிடைச்சுட்டா ஆபத்தாச்சே!"
  },
  {
    "id": "naam-s033-d011",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 54
      }
    ],
    "text": "ஹா-ம்! வேண்டாம்...நீயே பத்திரமாகவைச்சிரு! ஆமா....என் மருந்து பெட்டியிலே இருந்தால் யாரும் பார்க்கவே மாட்டாங்க!"
  },
  {
    "id": "naam-s033-d012",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "திருடன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 55
      }
    ],
    "text": "ஏய்...நில்லு"
  },
  {
    "id": "naam-s033-d013",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 55
      }
    ],
    "text": "யார் நீ?"
  },
  {
    "id": "naam-s033-d014",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "திருடன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 55
      }
    ],
    "text": "யாரா? இந்த அழகான உடல் கிணற்றிலே தள்ளி சாகப்போறியே...உனக்கு அறிவு இல்லே..."
  },
  {
    "id": "naam-s033-d015",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 55
      }
    ],
    "text": "அய்யா...என்னால் பேச முடியாது!"
  },
  {
    "id": "naam-s033-d016",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "திருடன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 55
      }
    ],
    "text": "நீ பேச வேண்டாம்! வா என்னோட! என் மேலே நம்பிக்கை இல்லையா உனக்கு? இந்தா பாரு!"
  },
  {
    "id": "naam-s033-d017",
    "scene_id": "naam-s033",
    "scene_ordinal": 33,
    "source_scene_number": 33,
    "source_heading": "காட்சி 33",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 55
      }
    ],
    "text": "ஏய்...விடு என்னை...நான் சாகத்துணிந்தவள்."
  }
]
