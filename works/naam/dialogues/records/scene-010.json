[
  {
    "id": "naam-s010-d001",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "அட...நீதானா...? மாடெல்லே வைக்கோலை திங்கு தின்னு பார்த்தேன்."
  },
  {
    "id": "naam-s010-d002",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "போங்க குமரன்."
  },
  {
    "id": "naam-s010-d003",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "ஆமா...இன்னிக்கு என்ன முன்னாடியே வந்துட்டே?"
  },
  {
    "id": "naam-s010-d004",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "அண்ணன் ஊரில் இல்லை."
  },
  {
    "id": "naam-s010-d005",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "அண்ணி?"
  },
  {
    "id": "naam-s010-d006",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "அந்தப் பிசாசு தூங்கி இருக்கும்."
  },
  {
    "id": "naam-s010-d007",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "ஆமா...இப்படி வர்றியே...யாராவது பார்த்தால் என்ன ஆகிறது?"
  },
  {
    "id": "naam-s010-d008",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "யாரைப்பற்றியும் கவலை இல்லே! எனக்கு வேண்டியது உங்கள் அழியாத அன்புதான்."
  },
  {
    "id": "naam-s010-d009",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "ஆமா...ஒரு நாளைக்கு பால் இல்லேன்னு என்ன? ஏன் இப்படி அவசரமாக ஓடணும்?"
  },
  {
    "id": "naam-s010-d010",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 21
      }
    ],
    "text": "எனக்கு ஒண்ணும் கஷ்டம் இல்லே."
  },
  {
    "id": "naam-s010-d011",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "ஹூம்...எல்லா ஏழைகளுக்கும் இப்படி பாலா கிடைக்குது?"
  },
  {
    "id": "naam-s010-d012",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "எல்லோருக்கும் இப்படி ஒரு மீனுவா கிடைச்சிருக்கா? குடிங்கண்ணு..."
  },
  {
    "id": "naam-s010-d013",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "முதல்லே நீ குடி."
  },
  {
    "id": "naam-s010-d014",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "நீங்கதான்."
  },
  {
    "id": "naam-s010-d015",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "முடியாது...நீதான்."
  },
  {
    "id": "naam-s010-d016",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "அம்மா..."
  },
  {
    "id": "naam-s010-d017",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "படுத்திட்டியான்னு பார்க்கவந்தேன். இன்னுமா தூங்கலே?"
  },
  {
    "id": "naam-s010-d018",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "பால் குடிங்கம்மா..."
  },
  {
    "id": "naam-s010-d019",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "பால் ஏதுடா கண்ணு?"
  },
  {
    "id": "naam-s010-d020",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "குடிங்கம்மா...அதை இன்னொரு நாளைக்கு சொல்றேன்."
  },
  {
    "id": "naam-s010-d021",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "கண்ணே...நீ குடி."
  },
  {
    "id": "naam-s010-d022",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "ஒங்க பாலிலே வளர்ந்தவன்—இந்தப்பாலிலே யாவது பாசத்தை பார்க்கக்கூடாதா?"
  },
  {
    "id": "naam-s010-d023",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "என் கண்ணே...பாலிலா இருக்கிறது பாசம்? உன் பார்வையிலே இருக்கிறது வற்றாத பாசம்."
  },
  {
    "id": "naam-s010-d024",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "குடிங்கம்மா."
  },
  {
    "id": "naam-s010-d025",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "இனிமேல் நீ குடி."
  },
  {
    "id": "naam-s010-d026",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 22
      }
    ],
    "text": "இன்னும் கொஞ்சம்!"
  },
  {
    "id": "naam-s010-d027",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "அம்மா..."
  },
  {
    "id": "naam-s010-d028",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "குமரா...ஏதோ சதி நடந்திருக்கிறது. அதில் குறி வைக்கப்பட்டவன் நீ—கொலை செய்யப்பட்டவள் நான், தம்பி! பல நாளாக மறைத்து வைத்திருந்த பரம இரகசியத்தை இன்று வெளியிட்டுப்போகிறேன்."
  },
  {
    "id": "naam-s010-d029",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "ஞானம்!"
  },
  {
    "id": "naam-s010-d030",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "ஞா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "வெற்றி! வந்து பாருங்களேன்...விபரத்தை பிறகு சொல்லுகிறேன்."
  },
  {
    "id": "naam-s010-d031",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "அப்படியானால் இந்த மல்லயப்பர் யார்?"
  },
  {
    "id": "naam-s010-d032",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "நாரா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "உன் அப்பாவின் தூர பந்து! மலேயாவில் இருந்து வந்தவன். சூழ்ச்சியால் நம் சொத்தை கவர்ந்தவன். குமரா...எப்படியாவது அந்த உயிலை கண்டுபிடித்து விடு."
  },
  {
    "id": "naam-s010-d033",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "அம்மா...அம்மா..."
  },
  {
    "id": "naam-s010-d034",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "டேய்...குமரா...அங்கே என்னடா சப்தம்?"
  },
  {
    "id": "naam-s010-d035",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "அம்மா..."
  },
  {
    "id": "naam-s010-d036",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மல்லயப்ப",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "காலராவா? ஜன்னியா? தூக்கிட்டுப்போடா எங்கேயாச்சிலும்."
  },
  {
    "id": "naam-s010-d037",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 23
      }
    ],
    "text": "குமரன்...இதென்ன விபரீதம்..."
  },
  {
    "id": "naam-s010-d038",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "(கோபத்துடன்) சீ...தொடாதே என் தாயை! பால் கொண்டு வருகிறேன் என்று அவசர அவசரமாக ஓடுனியே...இப்போது தெரிகிறது எதற்கு என்று."
  },
  {
    "id": "naam-s010-d039",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "குமரன்...என்னை நம்புங்கள்."
  },
  {
    "id": "naam-s010-d040",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "முதலில் நீங்கள் குடியுங்கள் என்று கொஞ்சினாயே...அப்போது தெரியாதடி—நீ நஞ்சை கொண்டு வந்து குடிப்பாய் என்று..."
  },
  {
    "id": "naam-s010-d041",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "குமரன்...நான் கொடுத்ததில் தவறு ஒன்றும் இல்லே."
  },
  {
    "id": "naam-s010-d042",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "நீ சரியாகத்தான் கொடுத்தாய்...நான்தான் தவறி என் தாயாரிடம் கொடுத்து விட்டேன்."
  },
  {
    "id": "naam-s010-d043",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "மீனு",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "குமரன்...இவ்வளவு நாள் பழகியும் இன்னும் என்னை புரிந்து கொள்ளவில்லையா?"
  },
  {
    "id": "naam-s010-d044",
    "scene_id": "naam-s010",
    "scene_ordinal": 10,
    "source_scene_number": 10,
    "source_heading": "காட்சி-10.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 24
      }
    ],
    "text": "புரிந்து கொண்டேனடி புரிந்து கொண்டேன். ஏழையின் இரத்தத்திலே நீச்சல் அடிப்பவன்—உன் அண்ணன்! அதிலே ஜலக்கிரீடை செய்பவள் தங்கை. பாட்டாளியின் எலும்பை சிலம்பாகச் செய்பவன்—உன் அண்ணன்! அதை அணிந்து கொண்டு நாட்டியம் ஆடுபவள்—தங்கை! இவளிடம் எனக்கு அன்பு, பாசம், காதல்..."
  }
]
