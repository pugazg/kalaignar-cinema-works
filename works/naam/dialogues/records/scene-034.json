[
  {
    "id": "naam-s034-d001",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 56
      }
    ],
    "text": "ஏ......முட்டாள்களே! யாரு பிசாசு?"
  },
  {
    "id": "naam-s034-d002",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "ஒருவன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 56
      }
    ],
    "text": "இவன் தாண்டா பிசாசு!"
  },
  {
    "id": "naam-s034-d003",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "விடாதிங்க இவனை!"
  },
  {
    "id": "naam-s034-d004",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "இது ஜமீனுக்கு அடிமை பிசாசு! இது மக்களை (பூசாரி) ஏமாற்றுகிற பிசாசு! இந்த இரண்டுக்கும் பெரியது ஜமீன்தார் பிசாசு!"
  },
  {
    "id": "naam-s034-d005",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "இவன் பேச்சை நம்பாதிங்க!"
  },
  {
    "id": "naam-s034-d006",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "இவன் பேச்சை நம்புங்க! ஊரு உருப்பட்டுப் போகும்! குமரன் பிசாசு இல்லே .."
  },
  {
    "id": "naam-s034-d007",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "ஜீவானந்தர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "மாத்திரை! எப்பா இந்த வம்பு? நீ தான் நிரூபிச்சிக் காட்டேன்."
  },
  {
    "id": "naam-s034-d008",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "இவரு வேற...ரெண்டும் கெட்டான். இப்ப நிரூபிச்சிக் காட்டுறேன் பாருங்க. (போகிறான்)"
  },
  {
    "id": "naam-s034-d009",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "ஓடிட்டான்டோ..."
  },
  {
    "id": "naam-s034-d010",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "மாத்திரை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "அய்யோ..."
  },
  {
    "id": "naam-s034-d011",
    "scene_id": "naam-s034",
    "scene_ordinal": 34,
    "source_scene_number": 34,
    "source_heading": "காட்சி 34",
    "speaker_label": "குமரன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 57
      }
    ],
    "text": "ஏன் பயப்படுகிறீர்கள்? நான் பேய் இல்லை! பேய் என்று ஒன்று இல்லவே இல்லை! பேய்க்கு சொல்லப்படும் இலட்சணங்கள் மனித சமுதாயத்தில் தான் நடமாடுகின்றன! வீரர்கள் உலாவுகின்ற பூமியிலே வாழ்ந்த நாம்... விவேகிகளின் மண்ணிலே வாழ்ந்த நாம்...வெறும் கற்பனைக் கதைக்கு—விஷமக்காரர்கள் கட்டி விடும் கட்டுக் கதைகளுக்கு அடிமையாவது? அறிவை இழப்பது? ஆண்மையை பலியிடுவது? எச்சில் பணத்துக்காக இனத்தை காட்டிக் கொடுத்தவன் ஒரு பேய்! சொந்த வாழ்க்கையை நந்தவனமாக்கிக் கொண்ட நயவஞ்சகன் ஒரு பேய்! சூது செய்து சுரண்டிப் பிழைப்பவன் ஒரு பேய்! நண்பர்களே...சிந்தித்துப் பாருங்கள்.... நானு பேய்? உங்களில் வீரர்கள் ஒருவருமே இல்லையா?"
  }
]
