    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "சும்மா வா! வெட்கப்படாதே!"
  },
  {
    "id": "naam-s018-d002",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "என்ன மாத்திரை!"
  },
  {
    "id": "naam-s018-d003",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "உன் கிட்டே சொல்லாமலே...சிக்கணமா...உன் விலாசம் வேற எனக்குத் தெரியலே."
  },
  {
    "id": "naam-s018-d004",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "விஷயத்தைச் சொல் மாத்திரை."
  },
  {
    "id": "naam-s018-d005",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "இவரு எனக்கு மாமனாராகவும் (ஜீவானந்தர்) நான் அவருக்கு மருமகனாகவும் ஆயிட்டோம்! என் மனைவி தைலம்!"
  },
  {
    "id": "naam-s018-d006",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 33,
        "printed_page": 33
      }
    ],
    "text": "அட...மாத்திரை—தைலம்! ரொம்ப நல்லா இருக்கு!"
  },
  {
    "id": "naam-s018-d007",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 34,
        "printed_page": 34
      }
    ],
    "text": "ஜாதகப் பொருத்தம் இல்லாவிட்டாலும், மருந்து முறைப்படி ரொம்பவும் பொருத்தம்."
  },
  {
    "id": "naam-s018-d008",
    "scene_id": "naam-s018",
    "scene_ordinal": 18,
    "source_scene_number": 18,
    "source_heading": "காட்சி 18.",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 34,
        "printed_page": 34
      }
    ],
    "text": "அப்போ...... இதை உங்களுக்கு பரிசாக அளிக்கிறேன்."
  }
]
