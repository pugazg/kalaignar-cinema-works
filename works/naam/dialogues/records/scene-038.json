[
  {
    "id": "naam-s038-d001",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 60
      }
    ],
    "text": "டேய்! அண்ணுமலை! என்னடா திமிர் இந்த ஊருப்பயல்களுக்கு! நான் அமெரிக்காவில் இருந்து வந்திருக்கிறேன். வரவேற்கிறதுக்கு ஒரு பயலும் காணோம்!"
  },
  {
    "id": "naam-s038-d002",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "அமெரிக்கா என்னங்க? சொர்க்க லோகத்திலே இருந்து வந்தாலும் கவனிக்க மாட்டாங்க! முன்னேற்றம் தலைவிரித்தாடுது! ஜனங்கள் பூராவும் குமரன் பேச்சைத்தான் கேட்குது."
  },
  {
    "id": "naam-s038-d003",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "குமரன்! போய் கூட்டிவாடா!"
  },
  {
    "id": "naam-s038-d004",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "யாருங்க?"
  },
  {
    "id": "naam-s038-d005",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "பூசாரி, புரோகிதர். வைத்தியர் எல்லோரையுமே."
  },
  {
    "id": "naam-s038-d006",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "பூசாரி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "கிணத்துத் தவளையா இருந்தவங்களே...பேப்பர், புத்தகம் படிக்கவைச்சி கெடுத்துட்டான்."
  },
  {
    "id": "naam-s038-d007",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "புரோகிதர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "படிக்க ஆரம்பித்தாலே—விழிக்க ஆரம்பித்தது மாதிரிதானே!"
  },
  {
    "id": "naam-s038-d008",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "முட்டாள்களே; இத்தனை நாளும் விட்டு விட்டு இப்போது வந்து முறையிடுகிறீர்கள். நான் இருக்கிறேன்—எனது பணம் இருக்கிறது."
  },
  {
    "id": "naam-s038-d009",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "புரோகிதர்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "பகவானும் இருக்கான்."
  },
  {
    "id": "naam-s038-d010",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "ஏய்...பூசாரி...நீயும் கூடப்போ."
  },
  {
    "id": "naam-s038-d011",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "பூசாரி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "உத்தரவு!"
  },
  {
    "id": "naam-s038-d012",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "டேய்! நம்ம மாளிகையின் வாசலை இடித்தெறி!"
  },
  {
    "id": "naam-s038-d013",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 61
      }
    ],
    "text": "இடிக்கவா?"
  },
  {
    "id": "naam-s038-d014",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 62
      }
    ],
    "text": "இவ்வளவு பெரிய மாளிகைக்கூடாது என் பதற்காக இல்லேடா இளிச்ச வாயா! இடித்தெறி! சொல்கிறேன்."
  },
  {
    "id": "naam-s038-d015",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 62
      }
    ],
    "text": "ஆச்சிங்க."
  },
  {
    "id": "naam-s038-d016",
    "scene_id": "naam-s038",
    "scene_ordinal": 38,
    "source_scene_number": 38,
    "source_heading": "காட்சி 38",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 62
      }
    ],
    "text": "டவுனுக்குப் போயி போலீஸை கூட்டிவா! வண்டிலே போ......ரெண்டு மணிநேரத்திலே சீக்கிரம் வரணும்!"
  }
]
