[
  {
    "id": "naam-s004-d001",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 11
      }
    ],
    "text": "(கதவை தட்டிக்கொண்டு) வைத்தியரே...வைத்தியரே..."
  },
  {
    "id": "naam-s004-d002",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரேமா",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 11
      }
    ],
    "text": "(வைத்தியரின் மகள் — கதவைத் திறந்து) வாங்க! ஆ...இதென்ன அக்கிரமம்..."
  },
  {
    "id": "naam-s004-d003",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "அப்பா இல்லே..."
  },
  {
    "id": "naam-s004-d004",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "அய்யோ...இரத்தம் இரத்தமா தளிர்ச்சிருக்கே"
  },
  {
    "id": "naam-s004-d005",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "எங்களை புலியா மாத்துறுங்க—இப்படி சிகப்பு கோடு போட்டு. அப்பா எங்கே...?"
  },
  {
    "id": "naam-s004-d006",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "இதோ கூப்பிட்றேன் ஏ அப்பா...சீக்கிரம் வாங்கோ...”"
  },
  {
    "id": "naam-s004-d007",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "தங்கையன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "வைத்தியர் இல்லே?"
  },
  {
    "id": "naam-s004-d008",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "இல்லே."
  },
  {
    "id": "naam-s004-d009",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "தங்",
    "source_delimiter": ":",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "கொஞ்சம் உடம்பு எண்ணெய் வேணும்."
  },
  {
    "id": "naam-s004-d010",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "இப்போ இல்லே."
  },
  {
    "id": "naam-s004-d011",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "தங்",
    "source_delimiter": ":",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "பணம் கொண்டு வந்திருக்கேன்."
  },
  {
    "id": "naam-s004-d012",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "அப்புறம் வாய்யா! இப்போதான் வேலையா இருக்கே."
  },
  {
    "id": "naam-s004-d013",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "ஏன்...பிரேமா அதை கொடுத்தனுப்புறதானே"
  },
  {
    "id": "naam-s004-d014",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "டேரப்பை போறவன்...அப்புறம் வருவான். இதை விட அது ஒண்ணும் முக்கியம் இல்லே..."
  },
  {
    "id": "naam-s004-d015",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "ஏன்...பிரேமா...யார் குமரா?"
  },
  {
    "id": "naam-s004-d016",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "இந்தக் கொடுமையை பாருங்கப்பா—அந்தச் சண்டாளன் சவுக்காலே அடிச்சிருக்கான்."
  },
  {
    "id": "naam-s004-d017",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "என்ன குமரா இது?"
  },
  {
    "id": "naam-s004-d018",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 12
      }
    ],
    "text": "இது என் எஜமான் கொடுத்த முத்தங்கள்."
  },
  {
    "id": "naam-s004-d019",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "ஏன் பிரேமா......அந்தக் கீல்வலிக்கார தங்கையன் உடம்பு எண்ணெய் கேட்டானுமே......ஏன் கொடுத்தனுப்பலே?"
  },
  {
    "id": "naam-s004-d020",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "அது இல்லேப்பா!"
  },
  {
    "id": "naam-s004-d021",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "சும்மா கெட! டேய் மாத்திரை! அவன் கோபிச்சிக்கிட்டு போறான். இதைக் கொடுத்திட்டு பணத்தை வாங்கிட்டு வா."
  },
  {
    "id": "naam-s004-d022",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "மாத்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "(வைத்தியரது வேலைக்காரன்) இப்போ எதுங்க முக்கியம்? அவன் கோபிக்கக் கூடாதுங்குறதா? பணமா?"
  },
  {
    "id": "naam-s004-d023",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "சீ......கொண்டு போயி கொடுத்திட்டு வாடா."
  },
  {
    "id": "naam-s004-d024",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "சரி........இவரைக் கவனிங்கப்பா!"
  },
  {
    "id": "naam-s004-d025",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "குமரா...நல்ல வேளை...உடனே வந்தாய்...இல்லேன்னு சீர் கெட்டிடும்."
  },
  {
    "id": "naam-s004-d026",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "நான்......எனக்காக வரவில்லே! என்னை அடிச்சதிலே ஜமீன்தார் கை சுளுக்கிடுச்சி...அதுக்காக உங்களை கூட்டிட்டு போக வந்தேன்."
  },
  {
    "id": "naam-s004-d027",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "பிரே",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "கடவுள் கூலி கொடுக்காமலா விடுவாரு?"
  },
  {
    "id": "naam-s004-d028",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "கும",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "கொடுப்பாரு......கொடுப்பாரு!......"
  },
  {
    "id": "naam-s004-d029",
    "scene_id": "naam-s004",
    "scene_ordinal": 4,
    "source_scene_number": 4,
    "source_heading": "காட்சி 4",
    "speaker_label": "சஞ்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 13
      }
    ],
    "text": "பிரேமா...இந்தா...இந்த மருந்தைப் போடு! நான் போயி அந்த கொம்பேறி மூக்கனை பார்த்துட்டு வர்றேன்."
  }
]
