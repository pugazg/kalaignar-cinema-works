[
  {
    "id": "naam-s040-d001",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "மந்தமாகி விட்டது மக்கள் அறிவு! மனிதனுக்கும், மாட்டுக்கும் வித்தியாசம் தெரியாத அளவுக்கு மாறிவிட்டது! இனி மலையப்பர் ஜமீன்தார் மட்டுமல்ல! இந்த உலகத்தையே ஆளக் கூடியவர்! மனிதனே கடவுளாகுகிறதும், கடவுள் மனிதனாகுகிறதும் பிரச்சாரம் தான்!"
  },
  {
    "id": "naam-s040-d002",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "பூசாரி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "எசமான்!"
  },
  {
    "id": "naam-s040-d003",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "என்ன பூசாரி?"
  },
  {
    "id": "naam-s040-d004",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "பூசாரி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "என்மகன் ஒருத்தன் இருக்கான். பெயர் காளி பாபா! வயது பத்து இருக்கும். சர்வ மூலிகைகளுக்கும் பச்சிலை தாருண்ணு நல்ல வருமானம் இருக்கும்."
  },
  {
    "id": "naam-s040-d005",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "காளிபாபா! நம்புவாங்களா?"
  },
  {
    "id": "naam-s040-d006",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "சஞ்சீவி",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "அதான் சொன்னேனே! கடவுள் மனிதனாகுவதும், மனிதனே கடவுளாகுவதும் பிரச்சாரம் தான் என்று."
  },
  {
    "id": "naam-s040-d007",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "அண்ணுமலை",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "அந்த வருமானத்திலேபாதி அம்பாள் கோவிலுக்கு, பாதி ஜமீன்தாருக்கு!"
  },
  {
    "id": "naam-s040-d008",
    "scene_id": "naam-s040",
    "scene_ordinal": 40,
    "source_scene_number": 40,
    "source_heading": "காட்சி 40",
    "speaker_label": "மலையப்பன்",
    "source_delimiter": ":-",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 65,
        "printed_page": 65
      }
    ],
    "text": "சரி! அப்படியே செய்!"
  }
]
