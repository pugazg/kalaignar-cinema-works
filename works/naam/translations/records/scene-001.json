        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "நாராயணி",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "(Kumaran's mother) We're from out of town. We came to see Physician Sanjeevi. His house......", "mode": "prose-faithful", "notes": ["The parenthetical identity is source-owned inside the immutable dialogue record and remains inside this translation unit."]}
    },
    {
      "id": "naam-en-s001-u014",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
