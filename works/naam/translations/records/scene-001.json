        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "It's not a quarrel, Amma... just a small explanation about the connection between rain and Mari......!", "mode": "prose-faithful", "notes": ["The `மழை / மாரி` contrast is preserved without expanding the wordplay beyond what the source supports."]}
