        "source_occurrence_id": null,
        "source_locator": {"kind": "scene-narrative", "ordinal": 3, "description": "Departure at his mother's request and transition to the journey."},
        "speaker_label": null,
        "speaker_label_origin": null,
        "source_delimiter": null,
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "At his mother's request, he left for another town. On the way........", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u004",
      "kind": "narrative",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
