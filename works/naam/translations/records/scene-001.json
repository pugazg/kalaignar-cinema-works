        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d003",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "A puja......!", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d004",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஜீவா",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "There has been no rain in the village, so there is no harvest. With no harvest, we have no means to pay the zamindar's tax. That's why we're conducting a puja for Mariatha.", "mode": "prose-faithful", "notes": ["`மாரியாத்தாள்` is transliterated as `Mariatha` to retain the source's local deity register."]}
    },
    {
      "id": "naam-en-s001-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d005",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "Oh... ho... sir... careful! Keep increasing the puja and a storm and rain may come together.", "mode": "prose-faithful", "notes": ["The teasing cause-and-effect in `பூஜை அதிகமாகி` is preserved rather than rationalized into neutral prose."]}
    },
    {
      "id": "naam-en-s001-u010",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d006",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஜீவா",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "What can we do, son? We have to go the way the people go.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u011",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d007",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "If Mari, who shows no compassion at the sight of your tears, can be bewitched by rosewater... then doesn't that mean you are deceiving her?", "mode": "prose-faithful", "notes": ["The tears / rosewater contrast is retained as the core satirical image."]}
    },
    {
      "id": "naam-en-s001-u012",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d008",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஜீவா",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "That's true too! What you say is true! Yes... who are you? What place are you from?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u013",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
