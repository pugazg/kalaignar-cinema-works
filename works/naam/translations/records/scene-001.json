        "speaker_label": "நாரா",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "Son... wasn't it after talking like this there that we came to this town? Even here, why are you picking quarrels with everyone who comes and goes?", "mode": "prose-faithful", "notes": ["The mother's colloquial rebuke is kept colloquial; the verified Tamil is not repaired to a smoother modern form."]}
    },
    {
      "id": "naam-en-s001-u017",
      "kind": "dialogue",
      "status": "verified",
