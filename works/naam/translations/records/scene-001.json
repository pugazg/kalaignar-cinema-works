        "speaker_label": "ஜீவா",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "Physician Sanjeevi......? He'll be at home! If not, there's a hut where he prepares poisonous herbs! He may be there! In any case, go a little that way and ask around.", "mode": "prose-faithful", "notes": ["`விஷமூலிகை` is rendered literally as `poisonous herbs`; the English does not silently modernize the source wording into a generic medical formulation."]}
    },
    {
      "id": "naam-en-s001-u015",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
