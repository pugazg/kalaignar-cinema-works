        "source_locator": {"kind": "scene-narrative", "ordinal": 2, "description": "Threat against Kumaran."},
        "speaker_label": null,
        "speaker_label_origin": null,
        "source_delimiter": null,
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "Some traitors set out to do away with him.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u003",
      "kind": "narrative",
      "status": "verified",
