      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/scenes/scene-001.md",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": null,
        "source_occurrence_id": null,
        "source_locator": {"kind": "scene-narrative", "ordinal": 4, "description": "Village puja setting and Jeevanandar encounter."},
        "speaker_label": null,
        "speaker_label_origin": null,
        "source_delimiter": null,
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "In a village, a puja to Mari is underway. Kumaran arrives there with his mother. Jeevanandar, one of the villagers who comes their way, meets Kumaran.", "mode": "prose-faithful", "notes": ["The village-goddess name is retained as `Mari` rather than generalized away."]}
    },
    {
      "id": "naam-en-s001-u005",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d001",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "Hmm... what's that celebration...?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u006",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d002",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஜீவானந்தர்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 5, "printed_page": null}]
      },
      "translation": {"english_text": "It's no celebration, son... We're conducting a puja for the goddess to put an end to our hardship.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "naam-en-s001-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
