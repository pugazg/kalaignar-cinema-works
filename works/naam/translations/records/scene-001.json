        "canonical_scene_path": "works/naam/scenes/scene-001.md",
        "source_record_id": "naam-s001-d011",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [{"pdf_page": 6, "printed_page": 6}]
      },
      "translation": {"english_text": "We'll be going, then! (Jeevanandar leaves.)", "mode": "prose-faithful", "notes": ["The parenthetical exit remains within the immutable dialogue-linked unit because it is source-owned inside that record."]}
    },
    {
      "id": "naam-en-s001-u016",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s001",
      "scene_ordinal": 1,
      "source_scene_number": 1,
      "source": {
