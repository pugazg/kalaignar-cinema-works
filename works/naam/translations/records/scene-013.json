      "translation": {
        "english_text": "I'm not shaken! I've taken an oath of duty. I am a rich man... I am a zamindar....",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s013-u008",
      "kind": "dialogue",
      "status": "verified",
