      "translation": {
        "english_text": "What did you think the boxing match was for? To entertain the villagers? Is that our work? That dog must be killed!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s017-u002",
      "kind": "dialogue",
