        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஜீவானந்தர்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 33,
            "printed_page": 33
          }
        ]
      },
      "translation": {
        "english_text": "For the poor there is a special comfort in imagining a world of happiness.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
