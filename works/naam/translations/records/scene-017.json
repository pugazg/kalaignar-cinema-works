        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 32,
            "printed_page": 32
          },
          {
            "pdf_page": 33,
            "printed_page": 33
          }
        ]
      },
      "translation": {
        "english_text": "What can I do? If only that will comes into my hands, I will make this entire zamindari yours. The zari cap will not rule you! The whip-rider will not drive you! A flick of that jungle king's eye will no longer be an order!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s017-u012",
      "kind": "dialogue",
      "status": "verified",
