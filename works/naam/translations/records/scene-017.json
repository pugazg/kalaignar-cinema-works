          }
        ]
      },
      "translation": {
        "english_text": "Jeevanandar! This is not the heaven devotees imagine! It can be achieved if we strive! It can happen if we will it! To attain it, you don't need a forehead full of sacred ash! Clarity in the heart—and a commitment to honesty—are enough.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
