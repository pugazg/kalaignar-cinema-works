            "pdf_page": 32,
            "printed_page": 32
          }
        ]
      },
      "translation": {
        "english_text": "The law! It will surrender to me! I have the courage to save a man standing on the gallows! Sin, merit, honesty, justice, mercy, law, society—none of these work on me. Act accordingly, Paramasivam! You must kill him! I want my heart cooled by seeing it.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
