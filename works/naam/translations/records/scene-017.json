        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ஒருவன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 32,
            "printed_page": 32
          }
        ]
      },
      "translation": {
        "english_text": "Brother! Only today have we seen happiness. Hunger, starvation, blows and kicks—that is all there is here!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s017-u011",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s017",
      "scene_ordinal": 17,
