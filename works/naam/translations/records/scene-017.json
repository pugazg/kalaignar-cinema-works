          }
        ]
      },
      "translation": {
        "english_text": "Is killing such an easy matter? I'll defeat him.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s017-u003",
      "kind": "dialogue",
