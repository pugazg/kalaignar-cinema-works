        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 33,
            "printed_page": 33
          }
        ]
      },
      "translation": {
        "english_text": "Let us await—that good day.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
