        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மலையப்பன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 63
          }
        ]
      },
      "translation": {
        "english_text": "Did you hear... how even his language reeks of violence?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s039-u010",
      "kind": "dialogue",
