          {
            "pdf_page": 63,
            "printed_page": 63
          }
        ]
      },
      "translation": {
        "english_text": "What, man, are you putting an exclamation mark!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s039-u013",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s039",
      "scene_ordinal": 39,
