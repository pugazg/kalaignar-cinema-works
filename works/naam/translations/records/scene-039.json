          }
        ]
      },
      "translation": {
        "english_text": "Why did you stop? Your dictionary still has thief, rogue, reviler of God, tear-drop, scoundrel and so on!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s039-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s039",
      "scene_ordinal": 39,
      "source_scene_number": 39,
      "source": {
