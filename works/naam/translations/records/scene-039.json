        "canonical_scene_path": "works/naam/scenes/scene-039.md",
        "source_record_id": "naam-s039-d005",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மலையப்பன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 62,
            "printed_page": 62
          }
        ]
      },
      "translation": {
        "english_text": "With your magic tricks you ruined my zamindari; using those caught in your spell, you have had the entrance of my mansion torn down! Why... if these men hadn't come, you would have killed me yourself!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s039-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s039",
      "scene_ordinal": 39,
      "source_scene_number": 39,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-039.json",
        "canonical_scene_path": "works/naam/scenes/scene-039.md",
        "source_record_id": "naam-s039-d006",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 63
          }
        ]
      },
      "translation": {
        "english_text": "Do you expect the police to believe all this? Here are those who lost their homes, those standing in the street—those whose eyes have become pools of tears. Let them count their accounts! Then let them say... who are the only sons born of violence and frenzy?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s039-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s039",
      "scene_ordinal": 39,
