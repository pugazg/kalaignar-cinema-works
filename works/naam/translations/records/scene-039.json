        "canonical_scene_path": "works/naam/scenes/scene-039.md",
        "source_record_id": "naam-s039-d011",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 63
          }
        ]
      },
      "translation": {
        "english_text": "An exclamation mark indeed! Let it grow a little and it will become a question mark! Remember, there isn't much difference between a question mark and an intellectual! And when I say arivaal, I don't mean a sickle that cuts people; I mean the sickle that cuts your authority, arrogance and the tree of ignorance! Hear this! The scholar's pen itself is a sickle!",
        "mode": "prose-faithful",
        "notes": [
          "The source's question-mark / அறிவாளன் / அரிவாள் wordplay is carried with `intellectual` / `sickle`; Tamil remains authoritative."
        ]
      }
    },
    {
      "id": "naam-en-s039-u014",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s039",
      "scene_ordinal": 39,
      "source_scene_number": 39,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-039.json",
        "canonical_scene_path": "works/naam/scenes/scene-039.md",
        "source_record_id": "naam-s039-d012",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சப் இன்ஸ்.",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 63,
            "printed_page": 63
          }
        ]
      },
      "translation": {
        "english_text": "Kumaran! You may be innocent. But from the evidence the zamindar has given, we have to arrest you. The truth can be proved in court. Until then, we must keep you in custody.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
