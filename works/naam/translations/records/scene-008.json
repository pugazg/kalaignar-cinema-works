            "pdf_page": 17,
            "printed_page": 17
          }
        ]
      },
      "translation": {
        "english_text": "Don't you know? Tomorrow your brother is going to collect taxes! Look at this cruelty, Meenu... with no seasonal rain, hunger and famine are dancing with their hair loose... and your brother is going out to collect tax—tax collection.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s008-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s008",
      "scene_ordinal": 8,
      "source_scene_number": 8,
