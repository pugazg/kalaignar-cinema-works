        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 17,
            "printed_page": 17
          }
        ]
      },
      "translation": {
        "english_text": "Brother gets angry because he knows you talk like this!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s008-u009",
      "kind": "dialogue",
      "status": "verified",
