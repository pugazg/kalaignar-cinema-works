        "page_provenance": [
          {
            "pdf_page": 40,
            "printed_page": 40
          }
        ]
      },
      "translation": {
        "english_text": "Don't be afraid... not now! I'll wait.",
        "mode": "prose-faithful",
        "notes": []
      }
