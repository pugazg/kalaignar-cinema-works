          }
        ]
      },
      "translation": {
        "english_text": "Interim Zamindar, greetings! Why are you stunned? The man who should have come bowing and calling you master—has somehow come like this... are you wondering what nonsense I'm babbling?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u003",
      "kind": "dialogue",
      "status": "verified",
