        "page_provenance": [
          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Grinding your teeth—and glaring—will be no use from now on.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
