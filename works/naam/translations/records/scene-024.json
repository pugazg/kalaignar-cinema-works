        "page_provenance": [
          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Respect! From now on you'll have to buy it for a price! Leave the mansion before respect itself is lost!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
