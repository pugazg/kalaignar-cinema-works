        "canonical_scene_path": "works/naam/scenes/scene-024.md",
        "source_record_id": "naam-s024-d034",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மல்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 41,
            "printed_page": 41
          }
        ]
      },
      "translation": {
        "english_text": "Go! Go away! Don't stand here!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
