        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 40,
            "printed_page": 40
          }
        ]
      },
      "translation": {
        "english_text": "Malayappa! I'll say it plainly! I'm going to settle my vengeance on you.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
