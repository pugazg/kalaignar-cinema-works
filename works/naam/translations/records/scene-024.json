        "page_provenance": [
          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Kumara! Don't talk like a madman!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u010",
      "kind": "dialogue",
      "status": "verified",
