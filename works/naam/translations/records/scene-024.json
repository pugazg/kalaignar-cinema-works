        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "The zamindar himself has caught janni, afflicted by the frosty wind of pomp—the sun of intrigue—and the rain of arrogance. Yes, I am mad! Because I don't have a heart that clears!",
        "mode": "prose-faithful",
        "notes": [
          "`ஜன்னி` is retained as `janni` rather than silently forced into a modern medical diagnosis."
        ]
      }
    },
    {
      "id": "naam-en-s024-u011",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
