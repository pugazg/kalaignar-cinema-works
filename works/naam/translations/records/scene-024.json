        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மல்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Those who oppose me are left with nothing but bones!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s024",
      "scene_ordinal": 24,
      "source_scene_number": 24,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-024.json",
        "canonical_scene_path": "works/naam/scenes/scene-024.md",
        "source_record_id": "naam-s024-d007",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "கும",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Even those bones will not remain for arrogant men like you who fight Yama! The bones you left behind... those bones themselves have become spears and come to oppose you!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s024",
      "scene_ordinal": 24,
