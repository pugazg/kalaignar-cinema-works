      "translation": {
        "english_text": "That's exactly where you're wrong!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u027",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s024",
      "scene_ordinal": 24,
      "source_scene_number": 24,
      "source": {
