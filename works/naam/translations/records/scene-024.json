          {
            "pdf_page": 39,
            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Hey, Kumara! (Grinding his teeth)",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u004",
      "kind": "dialogue",
