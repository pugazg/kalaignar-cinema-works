            "printed_page": 39
          }
        ]
      },
      "translation": {
        "english_text": "Don't speak without respect!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s024-u006",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s024",
