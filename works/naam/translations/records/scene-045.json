    },
    {
      "id": "naam-en-s045-u022",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s045",
      "scene_ordinal": 45,
      "source_scene_number": 45,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-045.json",
        "canonical_scene_path": "works/naam/scenes/scene-045.md",
        "source_record_id": "naam-s045-d018",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 70,
            "printed_page": 70
          },
          {
            "pdf_page": 71,
            "printed_page": 71
          }
        ]
      },
      "translation": {
        "english_text": "Not for yourself! For the children! Jeevanandar! I make my properties the property of the people! I alone am dying. But my ideas have not died. They will not die... with that satisfaction in my heart, I leave you. Long live self-respect; may rationalism triumph.",
        "mode": "prose-faithful",
        "notes": []
      }
