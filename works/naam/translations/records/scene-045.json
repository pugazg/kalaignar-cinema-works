      },
      "translation": {
        "english_text": "(A fight breaks out between them. The priest standing outside runs away. Kumaran carries the child and comes out. Malayappan, struck by Kumaran, collapses. This is Kumaran's last breath.)",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u016",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s045",
      "scene_ordinal": 45,
