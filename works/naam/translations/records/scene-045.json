          {
            "pdf_page": 69,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "Who are you to ask? Who am I to give? This is the people's property!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s045",
      "scene_ordinal": 45,
      "source_scene_number": 45,
      "source": {
        "source_path": "works/naam/dialogues/records/scene-045.json",
        "canonical_scene_path": "works/naam/scenes/scene-045.md",
        "source_record_id": "naam-s045-d006",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மலையப்பன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 69,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "The people! Fool! They are not your people now! They are bullets flying at you from Malayappan's gun!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s045",
      "scene_ordinal": 45,
