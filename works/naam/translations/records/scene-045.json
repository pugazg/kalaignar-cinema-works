        "canonical_scene_path": "works/naam/scenes/scene-045.md",
        "source_record_id": "naam-s045-d009",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 69,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "Kill me! But, cruel man, do not think that killing a man will destroy an ideology!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u012",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s045",
      "scene_ordinal": 45,
      "source_scene_number": 45,
      "source": {
