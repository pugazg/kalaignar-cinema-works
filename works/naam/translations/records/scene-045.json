        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "குமரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 69,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "That is exactly why I say—the gun must be smashed and thrown away.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u010",
      "kind": "dialogue",
      "status": "verified",
