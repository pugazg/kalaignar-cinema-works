          }
        ]
      },
      "translation": {
        "english_text": "Malayappa! They say a tiger told a hunter, ‘Put down that bow and arrow! Then I will hunt you.’ You are an even more ridiculous man than that!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u006",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
