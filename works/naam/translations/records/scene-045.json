          {
            "pdf_page": 69,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "Will you give it? Or not?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
