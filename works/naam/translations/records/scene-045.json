        "page_provenance": [
          {
            "pdf_page": 70,
            "printed_page": 70
          }
        ]
      },
      "translation": {
        "english_text": "Leave it! Otherwise this very house will become your cremation ground.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u015",
      "kind": "stage-direction",
      "status": "verified",
