        "page_provenance": [
          {
            "pdf_page": 69,
            "printed_page": 69
          }
        ]
      },
      "translation": {
        "english_text": "Kumara! You have laid your head on the sacrificial altar.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "naam-en-s045-u011",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "naam-s045",
      "scene_ordinal": 45,
