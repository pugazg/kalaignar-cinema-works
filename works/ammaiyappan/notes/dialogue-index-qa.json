  "reviewed_dash_candidates": [
    {
      "scene_id": "ammaiyappan-s011",
      "pdf_page": 26,
      "line": 103,
      "raw": "தவறு...போம்மா-போகிறாயா இல்லையா? உம்...போ...",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s012",
      "pdf_page": 27,
      "line": 19,
      "raw": "வருது—அதைப் படிக்கும் போது நீங்க பொறந்திருப்பீங்க",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s013",
      "pdf_page": 29,
      "line": 46,
      "raw": "பாவம் அனாதை—அவன் எங்கு போவான்.",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s015",
      "pdf_page": 32,
      "line": 56,
      "raw": "களே—அப்பேற்பட்ட தாங்களா இந்த அக்கிரமத்துக்குத்",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s016",
      "pdf_page": 33,
      "line": 9,
      "raw": "இனிமேல்—; அரண்மனையில் மட்டுமல்ல—பாளையக்காரர்",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s016",
      "pdf_page": 34,
      "line": 34,
      "raw": "கிறார்-நானும் கைநீட்டி வாங்கியிருக்கிறேன்-அன்றைக்குக்",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s017",
      "pdf_page": 35,
      "line": 35,
      "raw": "காட்டாகவும் மாற்றுவ—ஏய்!...யாரப்பா நீங்கவெல்லாம், ம்...",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s017",
      "pdf_page": 36,
      "line": 92,
      "raw": "நல்லவன் கேட்டுப் போகாதே—நான் போகிறேன்...பிரசங்",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s018",
      "pdf_page": 38,
      "line": 67,
      "raw": "தொடாதே—வைகுந்தவாசனை தொழு...கையிலே கேட",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s018",
      "pdf_page": 38,
      "line": 68,
      "raw": "யம் ஏந்தாதே—கைலாச நாதனின் திருநீறு ஏந்து...அது",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s026",
      "pdf_page": 56,
      "line": 37,
      "raw": "என் நாடு—எனக்குத் தேன்கூடு—நீரோ தீக்காடு—சாக்காடு வரினும் சரியென்பேனே தவிர, பூக்காட்டில் புகுந்துவிட்ட புயலாம் உன்பின்னால் நான் நடக்க மாட்டேன்! சுந்தர பூமியின் பிரஜை நான்—அதைச் சுரண்டி வாழும் பிரபு நீர்; புத்தி சுவாதீனம் அற்றவனும் கூட ஒத்துக் கொள்ள மாட்டான், புலியைத் தொடர்ந்து மான் நடக்கலாம் என்று உமது புதிய திட்டத்தை—தத்துவத்தை!",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s035",
      "pdf_page": 71,
      "line": 22,
      "raw": "மிகவும் அழகானவர்—உனக்குப் பிடித்தமானவர் என்று கூறுகிறாய்......",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s037",
      "pdf_page": 81,
      "line": 16,
      "raw": "தான் என்ன—சுகதேவ், முத்தாயி இருவரும் தங்கள் காதல் சுற்றுப் பயணத்தை முடித்துக்கொண்டு விரைவில் வந்து விடுவார்கள்.",
      "decision": "not-a-speaker-label"
    },
    {
      "scene_id": "ammaiyappan-s056",
      "pdf_page": 100,
      "line": 96,
      "raw": "நாள்—இரண்டு நாள் உலகத்தைப் பற்றிப் பேசினான். பிறகு உலகைப் படைத்தவனின் உத்தம குணங்களை விளக்கினான். கடவுள் அவதாரங்களும் காதல் லீலைகள் புரிந்ததாக வர்ணித்தான். மாயக் கண்ணன்—மன்மதன்—ரதி தேவி—மகேசன் பார்வதி—வள்ளி மணவாளன்—பிரம்மா. திலோத்தமை—மே னகா விசுவாமித்தான்—இப்படி எல்லாம் புராணக் கதைகள் சொன்னான்—போதை நிறைந்த இவன் வார்த்தைகள் என் புத்தியைத் தடுமாற வைத்து விட்டன...விவரிப்பானேன்—வீழ்ந்தேன்...வீழ்ந்தேன்...தமிழச்சி கட்டிக் காக்கும் கற்பு நெறியிலிருந்து வீழ்ந்தேன்...சந்நியாச சத்தை விட்டுவிடுகிறேன்—சம்சார வாழ்வு தொடங்குகிறேன் என்றான். கடைசியில் கருவிலே முத்தனும் வந்தான்! ஊர் கை கொட்டிச் சிரிக்கும் உன்னை மணந்தால் என்று காரணம் கூறி, என்னை கை விட்டு விட்டான்! முத்தனின் தந்தை இவன்! நான் தான் தாய்!",
      "decision": "not-a-speaker-label"
    }
  ],
