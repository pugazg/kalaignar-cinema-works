inted_page":85}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Wait, my son!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s046-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s046","archival_scene_ordinal":46,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-046.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-046.md","source_record_id":"ammaiyappan-s046-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":87,"printed_page":85}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I'm waiting...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s046-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s046","archival_scene_ordinal":46,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-046.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-046.md","source_record_id":"ammaiyappan-s046-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":87,"printed_page":85}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Come... come... let us go back to our place... We now know where Muthayi is. It is my duty now to unite her with the man she ought to join...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s046-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s046","archival_scene_ordinal":46,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-046.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-046.md","source_record_id":"ammaiyappan-s046-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":87,"printed_page":85}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"