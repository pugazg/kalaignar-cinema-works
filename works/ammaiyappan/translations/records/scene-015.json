{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source_scene_number":null,"scene_status":"verified","unit_count":19,"units":[{"id":"ammaiyappan-en-s015-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"குரல்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29},{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"What lives here! Confusion here too! Love-stricken... a cow seeking its calf... a tiger in deerskin! How splendid the thought—how beautiful the art... Are those works of thought merely consolation to her?... Poongavanam has seen those living paintings... Yet now she keeps looking at them. Her eyes repeatedly circle back toward the doorway, listening for the sound of footsteps. Her heart beats with the longing: will Muthan come?... Ah!... there he is. (Muthan has come.)","english_page_segments":[{"pdf_page":31,"printed_page":29,"english_text":"What lives here! Confusion here too! Love-stricken... a cow seeking its calf... a tiger in deerskin! How splendid the thought—how beautiful the art... Are those works of thought merely consolation to her?..."},{"pdf_page":32,"printed_page":30,"english_text":"Poongavanam has seen those living paintings... Yet now she keeps looking at them. Her eyes repeatedly circle back toward the doorway, listening for the sound of footsteps. Her heart beats with the longing: will Muthan come?... Ah!... there he is. (Muthan has come.)"}],"mode":"prose-faithful","notes":["The fragmentary opening `காதல்புறு ... கன்றைநாடும் பசு ... மான்தோல் வேங்கை!` is translated fragmentarily and is not reconstructed into a smoother external or remembered text."]}},{"id":"ammaiyappan-en-s015-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/scenes/scene-015.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan enters hesitantly."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"[Muthan enters hesitantly.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Come... Mutha, come...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Why did you call me?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"I'll tell you—come!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"No, I'll stay right here...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/scenes/scene-015.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Poongavanam runs to Muthan."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"[She runs to him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"My dear; come near me!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Mutha... Mutha...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Young queen! This does not become your station... You, who vowed to live as an unmarried maiden, refusing marriage—are you calling me, 'My dear, come'?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Mutha!... my dear!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"Enough, Yuva Rani! Don't you remember?... When my mother left me alone and devoted herself to palace work—you used to comb and adorn me as a little boy, gather me into your arms and delight in me—are you, of all people, now daring to commit this wrong?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":32,"printed_page":30}]},"translation":{"english_text":"My joy!... listen to this...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":33,"printed_page":31}]},"translation":{"english_text":"I don't want to hear it... You are the ruler's sister... and I am a horseman... Amma, I have heard the story of Raja Bhartrhari... this is even stranger than that...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":33,"printed_page":31}]},"translation":{"english_text":"Mutha?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":33,"printed_page":31}]},"translation":{"english_text":"All right, all right... If I stay here any longer, I may be swept into some dangerous corner by this flood of desire that has lain restrained and now surges like this... Hm... If you showed this uncontrollable affection to the king of Vengai Nadu—who, unable to attain you, suffers and has taken a vow of brahmacharya—perhaps this country would at least gain freedom... I am going...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":33,"printed_page":31}]},"translation":{"english_text":"Mutha... stop...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s015-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s015","archival_scene_ordinal":15,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-015.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-015.md","source_record_id":"ammaiyappan-s015-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":33,"printed_page":31}]},"translation":{"english_text":"No... a storm has entered Poongavanam; I cannot stand against it, amma, I cannot. I'm leaving!","mode":"prose-faithful","notes":["The source wordplay can invoke both the character name Poongavanam and its literal flower-garden sense; the English retains the name rather than choosing one sense and erasing the other."]}}]}