{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source_scene_number":null,"scene_status":"verified","unit_count":41,"units":[{"id":"ammaiyappan-en-s020-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Men stand in a line to join the army; one signs before Thanapathi; Vedalam and Kurumban stand nearby."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":null},"translation":{"english_text":"[Men are standing in a line to join the army. One man signs before Thanapathi. Vedalam stands nearby, with Kurumban opposite him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறும்பன்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm... the signature is done. It means you have joined the army.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The next man comes forward to sign."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":null},"translation":{"english_text":"[The next man comes forward to sign.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If you withdraw after this, you must pay a fine of one hundred gold coins.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஆள்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why would I withdraw!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What is your name?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஆள்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Samasam!","mode":"prose-faithful","notes":["The source name `சமாசம்` is transliterated."]}},{"id":"ammaiyappan-en-s020-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Are you joining the fighting?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஆள்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறும்பன்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father's name?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஆள்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Dina Dayalar; mother, Anbukarasi.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sign! (Thanapathi rises; as he looks toward the others, the line of men is shown.)","mode":"prose-faithful","notes":["The parenthetical action is embedded inside the immutable source dialogue record and remains in this dialogue unit."]}},{"id":"ammaiyappan-en-s020-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sabash! Vedalam! You have brought quite a lot of men today.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes! Those who make the effort do not suffer disgrace, my lord.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u015","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Vedalam points to and touches one man."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam points to a man and touches him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"He is very brave.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Is that so! A proper place is waiting in the army.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Have you seen this fellow, my lord? A skull that will not crack even after a hundred blows. Plenty of head-weight.","mode":"prose-faithful","notes":["`தலைக்கனம்` carries the joke between a heavy head and conceit; `head-weight` retains the wordplay rather than choosing only one sense."]}},{"id":"ammaiyappan-en-s020-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"A man nearby speaks."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":null},"translation":{"english_text":"[A man nearby.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஆள்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Then he could even become war minister.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u021","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Vedalam strikes him on the chest."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam strikes him on the chest.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"His firmness of heart is tremendous, my lord.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":6,"description":"They laugh; Vedalam suddenly sees Muthan and is startled."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":null},"translation":{"english_text":"[The two keep laughing. Suddenly Vedalam looks over. Muthan is standing there. Vedalam is startled.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Who—Muthan?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I have come to join the army.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Besh! Besh! Pride is overflowing, my lord! He is a very good man. Him too... Mutha! Come... come... sign.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u029","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/scenes/scene-020.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":7,"description":"Vedalam runs to the table, brings the registers to be signed, and holds them out to Muthan."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam runs to the table, brings the registers that must be signed, and holds them out to Muthan.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-020.md","source_record_id":"ammaiyappan-s020-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":43,"printed_page":41}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm... sign here.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s020-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s020","archival_scene_ordinal":20,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-020.json","canonical_scene_path":"works/