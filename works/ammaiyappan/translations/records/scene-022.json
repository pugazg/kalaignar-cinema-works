{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source_scene_number":null,"scene_status":"verified","unit_count":55,"units":[{"id":"ammaiyappan-en-s022-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Velazhagan and Vedalam are talking."},"speaker_label":null,"page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan and Vedalam are talking.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Your suspicion was perfectly right. After all, isn't he a commander of a country? You said that when he signed, he mistakenly wrote 'Muthayi'; that was not a mere slip. There really is something behind it.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"See? I knew it then itself. My Vedalam; there must be some connection between the two, mustn't there?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"There will be, there will be; certainly there will be!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"This woman he is connected with—is she a beauty with a slender waist?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"She is beautiful. Very beautiful.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"When I was staying in Chandanacheri, an intimate friend once introduced me to a beauty just like that.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Is that so?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Though he was a friend, for arranging that fine opportunity we rewarded him with twenty gold coins, my lord,","mode":"prose-faithful","notes":["`சேரி` is retained as `cheri` rather than replaced with a modern administrative label."]}},{"id":"ammaiyappan-en-s022-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Gold alone? I made him the head of that very cheri.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Oh-ho!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If possible, let's try to meet Muthayi once. What do you say, Vedalam?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"That is exactly what I have been thinking.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","page_provenance":[{"pdf_page":48,"printed_page":46}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"His face itself says he's thinking, my lord.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam; when it comes to understanding a hint and acting on it, you have no equal.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u016","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Muthan enters."},"speaker_label":null,"page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan enters.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What is it, man? What do you want?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You must forgive me.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Tell me the matter.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The circumstances are not right; I came to withdraw from the army...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Are you playing games? Who do you think I am? You cannot join the army and leave it whenever you please here! Look at the fellow—built like a wrestler... afraid like a rat, coward...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Please do not use that word. I may be poor. But I am not a coward.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't stretch out your tail! The sword will stretch out. Stand respectfully! Speak respectfully.","mode":"prose-faithful","notes":["The source wordplay `வால் நீட்டாதே! வாள் நீளும்` is preserved through the tail/sword contrast."]}},{"id":"ammaiyappan-en-s022-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"There is no compulsion to join the army, is there?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"There is no compulsion to join, but once you have joined, leaving is not up to you.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"That is why there is a condition that one must pay a fine of one hundred gold coins.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":49,"printed_page":47}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"[To Vedalam] This arrogant fellow is reminding me of the condition. [To Muthan] What are you going to do by building up that body? I asked for a sacrifice for the country.","mode":"prose-faithful","notes":["The source's embedded address cues `[வேதாளத்திடம்]` and `(முத்தனிடம்)` remain inside the immutable dialogue unit."]}},{"id":"ammaiyappan-en-s022-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":49,"printed_page":47},{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I can sacrifice myself—if we had a country of our own! If war broke out to defend our land, Muthan's name would be first in the front line. Pazhuthar is enslaved soil; you are the commander of the country that guards it, tramples it, and exacts tribute from it;\nfor me to serve in that army is all the same...","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":49,"printed_page":47,"english_text":"I can sacrifice myself—if we had a country of our own! If war broke out to defend our land, Muthan's name would be first in the front line. Pazhuthar is enslaved soil; you are the commander of the country that guards it, tramples it, and exacts tribute from it;"},{"pdf_page":50,"printed_page":48,"english_text":"for me to serve in that army is all the same..."}]}},{"id":"ammaiyappan-en-s022-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What did you say, traitor to the king?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Even a betrayer of his own brethren has been given the title `Alvar`. Commander, I am no traitor! Is it treason to say that I will not serve in the ranks of those who seized our land?","mode":"prose-faithful","notes":["The source title `ஆழ்வார்` is transliterated as `Alvar`; the English does not supply an external historical interpretation."]}},{"id":"ammaiyappan-en-s022-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! He is the first man who has spoken against me. I will not let him go without finding an end for him. Poison-seeds like this, sprouting against the rule of Vengaipuram, must be plucked out at the very shoot; he says he has a country of his own, and that he will work only for that country's freedom. He wanders outside when he ought to be in a madhouse.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"So that people like you can be treated;","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Tch! Savage!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Savage! Say that word to yourself while looking in a full-length mirror!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u035","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Velazhagan becomes agitated and trembles."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan becomes agitated and trembles.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Please come this way for a moment.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u037","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Velazhagan and Vedalam move aside to speak privately."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":null},"translation":{"english_text":"[The two move aside to speak privately.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't let the fellow go. If you do, he'll pay the fine and escape. Then we won't be able to get hold of Muthayi.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What can we do?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Put the donkey under guard... but one thing... I will behave as though I am kind to this puppy. I mean, I'll act the part.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u041","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Velazhagan and Vedalam return to Muthan, speaking as they approach."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":48}],"speaker_label_origin":null},"translation":{"english_text":"[The two return to Muthan, speaking as they approach.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam! This is a military matter; there is no place here for your recommendation.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Please forgive him... Muthan is poor.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam! I keep telling you again and again. You must not interfere in this.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why shouldn't I interfere? Once he gives you the hundred gold coins he owes, what can you do to Muthan? Why, Mutha! Give the hundred gold coins.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I'll put them into your hands.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! Commander! Muthan may go now, may he not?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"No... until the fine money arrives, he must remain right here.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sir! Honoured lord! Let him go. I myself will bring the gold tomorrow morning.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Impossible... Velazhagan gives the order. Hey, who's there! Put him under guard.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Is this what your government's camp-justice says? Very fine.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u052","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do not let him speak. Put this rascal in the cage and lock it.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u053","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":6,"description":"Muthan is handcuffed; Vedalam covers his face and starts to leave, looking sorrowfully at Muthan."},"speaker_label":null,"page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan is handcuffed. Vedalam covers his face and starts to leave, looking sorrowfully at Muthan as he goes.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u054","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-022.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":"ammaiyappan-s022-d048","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":51,"printed_page":49}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mutha! Karma from a previous birth does not spare even a crowned king.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s022-u055","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s022","archival_scene_ordinal":22,"source":{"source_path":"works/ammaiyappan/scenes/scene-022.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-022.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":7,"description":"Vedalam leaves; Muthan is locked in a room of Thendral Palace with a guard posted outside."},"speaker_label":null,"page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam leaves. Muthan is locked in a room of Thendral Palace, with a guard posted outside.]","mode":"prose-faithful","notes":[]}}]}