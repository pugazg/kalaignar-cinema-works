{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source_scene_number":null,"scene_status":"verified","unit_count":32,"units":[{"id":"ammaiyappan-en-s033-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறும்பன்","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam has come...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam?... Tell him to come, tell him to come...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Come in, Vedalam... I assume you have come with victory...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Only the beginning of victory, my lord!—our new quarry is caught by a brand-new hunter!","mode":"prose-faithful","notes":["The source's hunting metaphor is retained without attempting to normalize the compact phrase `புது புதிய வேடனிடம்`."]}},{"id":"ammaiyappan-en-s033-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What?... what?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I will tell you... Sukhadev and Muthayi—their wedding is at Kannagi Mansion in Anandapuram...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I arranged it myself...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"(Angrily) What?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Come now... I began this plot only to deliver Muthayi to you...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Explain it so I can understand...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You must do exactly as I say... Sukhadev and Muthayi are going to be married... You must send Muthan there immediately... If Muthan goes, Muthayi will run away with him... While the two of them are escaping, we will drive Muthan off and abduct Muthayi alone...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Good plan... What if Muthan understands our plot?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm... In the intoxication of love he will not think about anything... a horseman comes in.","mode":"prose-faithful","notes":["The source-owned arrival cue remains inside this immutable Vedalam dialogue record."]}},{"id":"ammaiyappan-en-s033-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"My lord! Muthan escaped from prison... We have caught him and brought him back...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Where?... Bring him in... Vedalam, hide yourself for a while...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/scenes/scene-033.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan is dragged in."},"speaker_label":null,"page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan is dragged in.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right! You may go... hee... hee... hee... Mutha!... Even if you had not escaped from prison, I was already thinking of releasing you myself... good young man!... I have put you through a great deal... I am sorry for that....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":68,"printed_page":66}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sir! You have suddenly changed... How did you realize that I am without refuge?...... Even a god could not have come and told you!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":68,"printed_page":66},{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"A human being has something called conscience. When a man becomes a beast, that conscience turns into a worm and lies subdued. When beastliness is defeated, the wormlike conscience rises as a spotted peacock and dances... It is in that dance that the beauty of truth begins to shine.","english_page_segments":[{"pdf_page":68,"printed_page":66,"english_text":"A human being has something called conscience. When a man becomes a beast, that"},{"pdf_page":69,"printed_page":67,"english_text":"conscience turns into a worm and lies subdued. When beastliness is defeated, the wormlike conscience rises as a spotted peacock and dances... It is in that dance that the beauty of truth begins to shine."}],"mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! A splendid thought sprouts even here, like a red lotus sprouting from mud...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mutha! Do you know what news opened my eyes?... That Sukhadev is going to force your beloved Muthayi into marriage...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Really?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes! The wedding is at Kannagi Mansion in Anandapuram... Run before her life leaves her... Mutha! You may wonder why I suddenly care so much... You have read the story of Layla-Majnun, have you not?... There is not much difference between this and the episode in which Layla's husband sent her back to her lover Qays... Mutha, let me tell you one thing... you and Muthayi may live as a family under my protection... but why worry about that now?...... Go at once... save your life-companion... [goes inside and returns with fine clothes] Here! Run this instant... regain your lost love... here are fine clothes. Put them on... go and complete your wedding happily!...","mode":"prose-faithful","notes":["The Layla-Majnun/Qays reference is translated only as printed; no external narrative detail is imported.","Frozen `இஞ்ஞுனே` is handled contextually as a deictic urging interjection; the Tamil source remains unchanged.","The bracketed clothes-fetching action remains inside the immutable source dialogue record."]}},{"id":"ammaiyappan-en-s033-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I am deeply grateful to you, sir...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u027","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/scenes/scene-033.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Muthan rushes away, hears laughter and watches from hiding."},"speaker_label":null,"page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":null},"translation":{"english_text":"[He rushes away. Then he hears laughter and watches from hiding.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":69,"printed_page":67}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Bravo, my lord! You played it very well.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The fellow was thoroughly fooled...\n\nVedalam!... What is the next arrangement?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The next arrangement!... Send five or six horsemen under my command. I will return with that beauty.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I will give you a thousand gold coins... if you come back with her...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s033-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s033","archival_scene_ordinal":33,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-033.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-033.md","source_record_id":"ammaiyappan-s033-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"[To himself] They are plotting.... I will turn that plot to my advantage.","mode":"prose-faithful","notes":["The source-owned `[தனியாக]` aside remains inside the immutable dialogue unit."]}}]}