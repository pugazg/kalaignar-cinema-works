{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source_scene_number":null,"scene_status":"verified","unit_count":49,"units":[{"id":"ammaiyappan-en-s011-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"You are gold that cannot be found even by searching... Father is trying to separate me from you.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"Your father is right to think that way, isn't he? Where is Prince Sukhadev—and where am I? I am a man who rubs down horses in the palace... motherless... not knowing who my father is... without kin or relatives... a man alone.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"Man alone... The stars may gather in crowds. The moon stands alone. But isn't it the moon that the water-lily waits for?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"My lily—your father dreams of becoming kin to the Palayakkarar. Is he going to give you to this paari? A dream... a dream...","mode":"prose-faithful","notes":["The frozen source word `பாரிக்கா` is not silently repaired; `paari` is retained because its exact intended sense is not independently resolved by the source layer."]}},{"id":"ammaiyappan-en-s011-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"I will make even the dream come true. My dear... leave your worries... look at me; won't you look? Isn't my face medicine that can cure your worry?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan looks at her; both smile."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"[Muthan looks at her. Both smile.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"Medicine indeed... my Manikkavalli! Medicine that cures worry... this guileless silver moon. How many cruel nights, drunk on the taste of sorrow, have slipped away without a word, Sundari... simply because I thought of your radiant face... I would pine, thinking, 'Am I not poor?' Then my eyes, still unable to know the limits of your beauty, would ask: 'Are you poor—you who possess a jewel no pauper or mansion-dweller could ever obtain?' My joy! You are medicine that cures my pain... a feast without equal....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The lovers embrace."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"[They embrace.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"Shh... don't go flying.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"Would a skylark not fly at the touch of spring?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"One wing is not enough to fly.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"That is why I am inviting you too.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"Yes! Where shall we fly?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"To the edge of the blue sky, between the beautifully arrayed clouds—above the waterfall—around the lovely grove—","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u015","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Muthayi laughs."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"[She laughs.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-r001","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":1,"description":"Unlabelled question after Muthayi's laugh continues Muthan's turn."},"speaker_label":"முத்தன்","speaker_label_origin":"source-context-attributed","page_provenance":[{"pdf_page":24,"printed_page":22}]},"translation":{"english_text":"Why are you laughing, Muthayi?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"I have heard it said... that poet... lover... madman... all three are one kind. A poet looks at the sky and the lotus and picks a quarrel: 'Hey, stars! At whom are you winking?' A lover looks at the white moon, laments, 'Where is my beloved?' and asks the moon to carry a message. People joke that both of them are mad... Looking at you, it really does seem true...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Muthayi touches Muthan."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"[She touches him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Hush... don't touch me... I'm the madman, after all.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Even if you are mad, aren't you my Muthan? Piththa! Pirai-kudi! Perumane!","mode":"prose-faithful","notes":["The devotional-sounding source phrase `பித்தா! பிறைகுடி! பெருமானே!` is translated partly by transliteration and is not repaired to a more familiar hymn wording."]}},{"id":"ammaiyappan-en-s011-u021","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Muthayi touches him again."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"[She touches him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Shh... amma. Wait, Muthayi.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Why! If I touch you, will it turn into sacred ash?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u024","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":6,"description":"Muthayi touches him once more."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"[She touches him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Shh... amma. Wait, Muthayi.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"That's it!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u027","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":7,"description":"Sukhadev and Tirisangu appear."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"[Sukhadev and Tirisangu.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Ah! Right... right... maal nannoram... at the edge of the grove...","mode":"prose-faithful","notes":["The frozen phrase `மால் நன்னோரம்` is left in transliteration rather than silently reconstructed."]}},{"id":"ammaiyappan-en-s011-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Prince! Please don't misunderstand. This fellow has started forcing himself on my girl. Hey, brainless wretch! What are you doing?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Father!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"Don't be afraid, girl—he won't do anything to me. He's just a lazy fellow who frightens women.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"No, father.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u033","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":8,"description":"Source action word `திருக்கிட்டு` after Muthayi's denial."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":25,"printed_page":23}]},"translation":{"english_text":"[Tirukkittu.]","mode":"prose-faithful","notes":["The frozen action word `திருக்கிட்டு` is retained in transliteration because the source layer does not establish a single safe English action."]}},{"id":"ammaiyappan-en-s011-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"I understand everything myself... Why do you come to places like this alone?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Listen to what I have to say.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"You needn't say anything; go home, girl... Don't stand in front of this sinner... it's wrong... go, girl—are you going or not? Hm... go...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u037","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":9,"description":"Muthayi leaves distressed."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"[Muthayi leaves, distressed.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-r002","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":2,"description":"Prayer/address after Muthayi leaves continues Tirisangu's preceding turn."},"speaker_label":"திரிசங்கு","speaker_label_origin":"source-context-attributed","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"God! You have saved my daughter's honour... a crore salutations to you... Prince! Did you see this fellow's outrage?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u039","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":10,"description":"Source cue: Muthan is struck/tapped on the back."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"[Muthan is struck on the back.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Hey, Mutha! Is your back muttering? You half-starved mendicant brat! You whining donkey.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Had enough, agathi?","mode":"prose-faithful","notes":["The insult/term `அகாதி` is retained as `agathi`; the frozen source does not authorize a confident normalization."]}},{"id":"ammaiyappan-en-s011-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Don't talk... you cowardly dog! You have no way even to get half a belly of gruel, and yet you go about loving—love indeed.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Rich man's son! You who do not know the difference between the heart and the stomach! I'll teach you the grammar of love... listen... Love is not saying, 'I will bathe in rosewater, swim in fruit juice, and go to and fro from a bedchamber surrounded by maidens'... Love is a moon... a breeze... It comes not only to the mansion but to the mud hut too... Love is not money; it does not stop at your marble hall...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"That's right, fellow; you cannot hide your villainy behind too much clever talk.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"How could I? For that, one would have to be born the son of a Palayakkarar...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Shut up! You father-name-unknown mistake.","mode":"prose-faithful","notes":["The source's unusual insult `தகப்பன் பெயர் தெரியாத தவறுதலில்` is kept deliberately awkward rather than normalized into a smoother invented epithet."]}},{"id":"ammaiyappan-en-s011-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-011.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":"ammaiyappan-s011-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"Do you know your father's name?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u048","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":11,"description":"Muthan and Sukhadev fight."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":26,"printed_page":24}]},"translation":{"english_text":"[The two of them fight.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s011-u049","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s011","archival_scene_ordinal":11,"source":{"source_path":"works/ammaiyappan/scenes/scene-011.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":12,"description":"Narrated fight outcome and Sukhadev's fall into the water."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"Sukhadev's cap flies upward and falls. A blow from Muthan knocks Sukhadev down. He gets up, bravely takes the walking stick Tirisangu is holding, advances as though to strike Muthan, retrieves his cap caught on a tree, warns Muthan, 'Hey, Mutha—careful; be careful!', and falls into the water.","mode":"prose-faithful","notes":["The warning remains embedded in the source narration because it is not a separate immutable labelled-dialogue record."]}}]}