  "units": [
    {"id":"ammaiyappan-en-s010-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"Thambi! Thambi! Ever since you came to my house... goodness! From that moment Muthayi has talked of nothing but you.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"What—what—wait, wait—is that so? Here, Tirisangu! Here—here! There are a hundred gold coins in this... keep it... hmm... what does she say—what does she say—","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"திருசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"Muthayi says, thambi, that there is bravery in your walk—a majesty in your gaze—sweetness in your speech—and she said there's something in your hand.","mode":"prose-faithful","notes":["The exact source speaker-label spelling `திருசங்கு` is retained in provenance."]}},
    {"id":"ammaiyappan-en-s010-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"A finger—a finger!","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"No, thambi...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"There's a ring on the finger...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"Not that, thambi—oh, go on—what do I know about all this wretched love-description business?","mode":"prose-faithful","notes":["The frozen source form `இந்த எழவு காதல் வாணமெல்லாமா தெரியுது` is translated by immediate contextual sense without changing the Tamil wording."]}},
    {"id":"ammaiyappan-en-s010-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"Then Muthayi is in love with me. Ah, Tirisangu! If there were a father like you, and that father had a daughter like Muthayi, the world would very soon become a grove of love without opposition. Muthayi! You and I... Ayyo, I don't even know how to describe it, Tirisangu! Is there a Kamba Ramayanam in our library?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"What, thambi! What connection is there between love and the Kamba Ramayanam?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s010-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s010","archival_scene_ordinal":10,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-010.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-010.md","source_record_id":"ammaiyappan-s010-d010","source_occurrence_id":"ammaiyappan-song-002","source_locator":{"kind":"quoted-literary-verse-fragment-within-dialogue","ordinal":1,"description":"Immutable Sukhadev dialogue containing the source-attributed Kambar verse fragment; linked to song/performance inventory occurrence without duplicating source ownership."},"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":23,"printed_page":21}]},"translation":{"english_text":"Ayyayyo! Three-quarters of the Ramayanam is just that. Ah! Do you know how the emperor of poets, Kambar, described love?... Listen to a song, Tirisangu...\n\n‘After “the cloud-dark one who came with the great sage”... by the fact that he was lotus-eyed... yes... her doubt fell away: “Could it be he?”... vāmamēkalaiyi vaḷarntatu...’\n\nHmm, gone—I forgot beyond that... Come, come, let's look it up.","mode":"prose-faithful","notes":["The immediate source dialogue explicitly attributes the quotation to Kambar. Only the fragment printed in this booklet is translated; no canonical Kambar verse is reconstructed from outside material.","The final frozen source cluster `வாமமேகலையி வளர்ந்தது` is retained in transliteration because this printed quotation is fragmentary and the source itself immediately says the rest has been forgotten.","This one unit owns both the immutable dialogue record and `ammaiyappan-song-002` occurrence linkage, preventing duplicate source-span ownership."]}}
  ]
}
