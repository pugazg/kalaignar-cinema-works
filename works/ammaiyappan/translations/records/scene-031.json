{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source_scene_number":null,"scene_status":"verified","unit_count":8,"units":[{"id":"ammaiyappan-en-s031-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/scenes/scene-031.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Vedalam and Sukhadev are present."},"speaker_label":null,"page_provenance":[{"pdf_page":66,"printed_page":64}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam and Sukhadev are present.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s031-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","page_provenance":[{"pdf_page":66,"printed_page":64}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam! As you told me, I have finished all the arrangements. I have spent two thousand gold coins... jewels... clothes, this and that... bought everything... Will my Muthayi come?... Vedalam... this Kannagi Mansion is waiting for my beloved... will that maiden come?...","mode":"prose-faithful","notes":["Source `கண்ணுடி` is rendered contextually as an affectionate `beloved`; the Tamil form is not changed."]}},{"id":"ammaiyappan-en-s031-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"(Holding them apart) Certainly, brother!... Touch one of the two! (He touches one.)","mode":"prose-faithful","notes":["Both source-owned parenthetical actions remain inside the immutable dialogue unit."]}},{"id":"ammaiyappan-en-s031-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!... She will definitely come, brother...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s031-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Will she come?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s031-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right!... Name a flower, brother!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s031-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"A flower!... This one? Tamarind blossom...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s031-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s031","archival_scene_ordinal":31,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-031.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-031.md","source_record_id":"ammaiyappan-s031-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":67,"printed_page":65}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why all this fuss!... I will go myself and bring Muthayi... You stay right here... I will be back at once.","mode":"prose-faithful","notes":[]}}]}