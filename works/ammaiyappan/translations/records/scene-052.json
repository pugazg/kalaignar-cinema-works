{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source_scene_number":null,"scene_status":"verified","unit_count":41,"units":[{"id":"ammaiyappan-en-s052-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"A covered figure is inside; Vedalam arrives with Muthayi."},"speaker_label":null,"page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":null},"translation":{"english_text":"[Inside, a figure is covered with a blanket... Vedalam arrives with Muthayi.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"There... your beloved!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Muthayi pulls away the blanket calling Aththan; Velazhagan rises."},"speaker_label":null,"page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":null},"translation":{"english_text":"[Eagerly crying 'Aththan,' she pulls away the blanket. Velazhagan rises.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"...Ah!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi!... Full moon!... you've fallen into my hands?... You called 'Aththan'; that is not dear Muthan, but Commander Velazhagan! Do you recognize me?...","mode":"prose-faithful","notes":["`அத்தான்` is retained as `Aththan` because the kinship/lover address matters to the scene's register."]}},{"id":"ammaiyappan-en-s052-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Commander Velazhagan! You, who ought to protect the country, have become a wanderer like this... No. I am your sister...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Only fools would believe that the flower and the bee are brother and sister, dear!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Velazhagan grabs Muthayi's hand."},"speaker_label":null,"page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":null},"translation":{"english_text":"[He grabs her hand.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Fie!... Let go of me! Shameless man!... Poisonous storm! I am not a tree that will topple in the cyclone of your lust...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Scold me! Scold me well! Every letter tastes sweet... A caged parrot cries not from anger!... from fear! Even that will become normal with habit...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't come near me!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The commander of this country's army calls you... Do you know what happens to those who do not obey my command?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":91,"printed_page":89}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You'll kill me! That's all, isn't it?... I won't fear death! Is death more terrible than you? No... no... never!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":91,"printed_page":89}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi!—No flower has ever escaped from my iron-like arms!... Remember that!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":91,"printed_page":89}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Let me go, you wrongdoer!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":91,"printed_page":89}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The whole world turns on the axle called injustice!... Muthayi!... You can no longer escape... Yield of your own accord!... [He comes closer—Muthayi tries to run.] Where are you running? Wherever you go, I will not let you go... If you fly as a skylark, I will become the hawk circling you!... If you leap as a spotted deer, I will roar as a tiger! Even if at last you become a corpse, I will become the sandalwood log that touches your body and burns with it! My delight!... Yield... fragrant new blossom flowering in spring! Come to me. Coloured lotus! Bouquet of dazzling flowers!... I will sweep you into my powerful arms... Leap upon me, green parrot!...","mode":"prose-faithful","notes":["The source-owned parenthetical approach/escape cue remains inside this immutable dialogue record. The coercive rhetoric is translated as printed and is not euphemized."]}},{"id":"ammaiyappan-en-s052-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":91,"printed_page":89}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do not ruin yourself in vain; stand away...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":91,"printed_page":89}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"[With a terrifying laugh.] Now no one will come forward to offer you refuge by destroying me!... You've read in stories: the beloved is in danger... the hero runs in and saves her! None of that will happen here!... Even that Sita could not be easily rescued from Ashoka Vanam by the divine-incarnate Ramachandra Murthi! Remember! Pitiful woman!... Someone has taught you that you must conduct yourself with chastity like Kannagi!... That was the age of the Silappathikaram... literature that ought to be banned... a philosophy this army commander cannot permit... O maiden! Come near...","mode":"prose-faithful","notes":["The parenthetical terrifying laugh remains dialogue-owned. Sita, Ashoka Vanam, Ramachandra Murthi, Kannagi and Silappathikaram are translated only as printed references; no external narrative is added."]}},{"id":"ammaiyappan-en-s052-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Warrior who bears spear and sword in battle! Do not behave so cowardly toward a woman...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Shall I behave heroically then?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Let me go...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Even fruit that comes to the hand—a bird that comes within sight—people will not let go! Muthayi! I warn you; don't test my patience......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Velazhagan approaches to embrace Muthayi."},"speaker_label":null,"page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":null},"translation":{"english_text":"[He comes near to embrace her.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Fie! [She slaps him.]","mode":"prose-faithful","notes":["The slap is printed inside the immutable dialogue record and remains dialogue-owned."]}},{"id":"ammaiyappan-en-s052-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u026","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Velazhagan draws his sword; Muthan jumps down from above."},"speaker_label":null,"page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":null},"translation":{"english_text":"[He draws his sword. Muthan jumps down from above.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mutha!... Don't die in vain! Think carefully about who your enemy is...","mode":"prose-faithful","notes":["Frozen source syntax in `நீ யார் என் பகை நிதானித்துக் கொள்` is rendered only by the immediate threat sense; the Tamil is not repaired."]}},{"id":"ammaiyappan-en-s052-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Me? I am the warrior who was trapped and ruined in the `kāppāri` of your arbitrary rule—in the hall of dictatorship!... But today that warrior has not come... I have come to reward you for the blood I shed—for the tortures I endured—I have come to reward you, man, reward you! Madman who hunts women! Liquor and the pleasures of women may hide in the shadow of your delusion... but you are intoxicated madmen who cannot realize that a revolutionary force will surge up and smash that delusion to dust...","mode":"prose-faithful","notes":["Frozen `காப்பாரியிலே` is retained by transliteration as `kāppāri`; its exact lexical force is not silently repaired from context."]}},{"id":"ammaiyappan-en-s052-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't forget whom you're talking to, Mutha!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I am playing with you, who are playing with my life!","mode":"prose-faithful","notes":["Frozen spacing in `உன் னோடு` is not repaired upstream."]}},{"id":"ammaiyappan-en-s052-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":92,"printed_page":90}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If I move my forefinger, you'll be smashed to pieces...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":92,"printed_page":90},{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ha, ha!... Will your pointing finger shoot me?—No... smash me to pieces... The age in which you lived by intimidation is over, Commander! Now an age of rationalism is coming, making room for people of character alone to live. You are my enemy. Keep your longbow... The seats of power of those who, like you, sped along in the footprints of dictatorship have become hollows and mounds, then graveyards with no trace of where they once stood!","mode":"prose-faithful","notes":["The frozen clusters `சுட்டு தியுமா`, `என்ன கண்ணைப் பார்த்திராமா` and `நீளவில்வைத்துக் கொள்ளும்` are irregular. English follows only the immediately recoverable rhetorical sense and does not claim a Tamil repair."],"english_page_segments":[{"pdf_page":92,"printed_page":90,"english_text":"Ha, ha!... Will your pointing finger shoot me?—No... smash me to pieces... The age in which you lived by intimidation"},{"pdf_page":93,"printed_page":91,"english_text":"is over, Commander! Now an age of rationalism is coming, making room for people of character alone to live. You are my enemy. Keep your longbow... The seats of power of those who, like you, sped along in the footprints of dictatorship have become hollows and mounds, then graveyards with no trace of where they once stood!"}]}},{"id":"ammaiyappan-en-s052-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do you know what is in my hand?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I know very well... What is the glitter of a knife in a coward's hand before the roughness of a warrior's palm? You have a knife!... Here is my weapon! A weapon forged in the camp of Duty, Dignity and Discipline! A weapon that stands against scoundrels—knife-thrusts—dishonourable acts!...","mode":"prose-faithful","notes":["`கடமை, கண்ணியம், கட்டுப்பாடு` is rendered as the source's rhetorical triad `Duty, Dignity and Discipline`."]}},{"id":"ammaiyappan-en-s052-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Such a great warrior?... A warrior who will face a knife bare-handed?... Here, let us see that too...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u036","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":6,"description":"Muthan and Velazhagan fight; Kurumban sees it and runs; Velazhagan dies."},"speaker_label":null,"page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":null},"translation":{"english_text":"[The two fight fiercely. Kurumban arrives. Seeing the situation, he runs away. The fight ends with the commander's death.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Aththan!...","mode":"prose-faithful","notes":["`அத்தான்` is retained as `Aththan` because the kinship/lover address matters to the scene's register."]}},{"id":"ammaiyappan-en-s052-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u039","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":7,"description":"Kurumban arrives with soldiers."},"speaker_label":null,"page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":null},"translation":{"english_text":"[Kurumban arrives with soldiers.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-052.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":"ammaiyappan-s052-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறும்பன்","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!... Commander!... Ayyo, are you dead? Hey, carry him away. Hey Mutha! You killed him, didn't you?... Hey, arrest this fellow too.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s052-u041","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s052","archival_scene_ordinal":52,"source":{"source_path":"works/ammaiyappan/scenes/scene-052.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":8,"description":"Soldiers fight Muthan; he is captured; Muthayi cries out and faints."},"speaker_label":null,"page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":null},"translation":{"english_text":"[The soldiers fight Muthan. In the end Muthan is captured... Muthayi cries out and faints.]","mode":"prose-faithful","notes":[]}}]}