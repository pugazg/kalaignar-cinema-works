  "unit_count": 36,
  "units": [
    {"id":"ammaiyappan-en-s007-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/scenes/scene-007.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Opening action before Sukhadev's first labelled utterance."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"[Sukhadev admires his beauty in the mirror. Tirisangu comes there with a letter.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"This mirror isn't enough to behold my beauty, haa-m—Tirisangu! A palm-leaf letter for me?","mode":"prose-faithful","notes":["The immutable Tamil record itself contains the string `திரிசங்கு:` inside Sukhadev's labelled turn. English treats it as Sukhadev calling to Tirisangu rather than splitting or repairing the locked source record."]}},
    {"id":"ammaiyappan-en-s007-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"No, thambi. It's for me.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"From whom?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"He's an idle fellow. Once day breaks, his one job is to take my life.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"Take your life? Who is that Yama, man?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"Ask me, thambi. I have a good-for-nothing nephew. Says he wants a woman.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"Why? Are all those being born nowadays male?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"No, thambi, no. He wants a woman for marriage.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"For marriage, of course you need a woman. What else do you need? That's the raw material of a wedding, isn't it?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Thambi! The mango fruit itself is calling, ‘Bats, come!’","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Yes! Yes! A ripe mango and a ruined hall don't need to call, ‘Bat, come.’ All right, likewise......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"My daughter has come of age. Fellows are shooting their bows; that's why I've written a palm-leaf letter to this useless fellow. My daughter's beauty, her character—can this fellow claim a right over her merely because of the aththan kinship, thambi?","mode":"prose-faithful","notes":["`அத்தான் முறை` is retained as `aththan kinship` rather than forcing a modern relationship gloss beyond what the frozen source itself establishes."]}},
    {"id":"ammaiyappan-en-s007-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Oh-ho! Is your daughter that beautiful—","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Haven't you ever seen her?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"No. What's your daughter's name?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Muthayi—Muthayi means Muthayi.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Hmm—even a crow thinks its chick is a golden chick.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"No, thambi. This is a koel's chick that a crow has brooded.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Tirisangu! Come, let's go to your house.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Don't joke—the prince coming to a palace guard's house... what a joke, what a joke.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Don't you know I have none of that high-and-low with me? You're a servant only to my younger sister. To me, you're an elderly friend. Right?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"I am fortunate.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":17,"printed_page":15}]},"translation":{"english_text":"Come, let's go.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u025","kind":"song-reference","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/songs/inventory.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":"ammaiyappan-song-001","source_locator":{"kind":"song-performance-reference","ordinal":1,"description":"Source cue that the Muthan–Muthayi love-song performance is nearing its end; no title or lyric body is printed."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"[As the Muthan–Muthayi love-song performance is nearing its end, Sumathi arrives carrying two water pots, one on either side at her waist. She sets the pots at a distance, looks at Muthan and Muthayi, covers both her eyes with her hands, and comes toward them.]","mode":"prose-faithful","notes":["The booklet prints no title or lyric lines for this occurrence. The unresolved item-level authorship state is preserved and no soundtrack lyric is reconstructed."]}},
    {"id":"ammaiyappan-en-s007-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"Muthayi! Shall we go?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"What, Sumathi! Why have you closed your eyes?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u028","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/scenes/scene-007.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Bracketed cue that Sumathi opens her eyes."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"[Opening her eyes.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"For a reason. It's getting late. Come, let's go.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"Shall I go and come back?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"You won't get just that permission over there.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"Well, your friend seems to be quite a clever-handed woman.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"Not just a ‘handy one’—a foot one, a neck one, a head one too.","mode":"prose-faithful","notes":["The source deliberately piles up `கைக்காரி / கால்காரி / கழுத்துக்காரி / தலைக்காரி`; the English keeps the comic body-part sequence rather than normalizing it away."]}},
    {"id":"ammaiyappan-en-s007-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"Enough! Enough! Don't keep spitting ‘kaari, kaari’ in my face.","mode":"prose-faithful","notes":["The phonetic joke on repeated `காரி` is retained in transliteration rather than replaced with a different English pun."]}},
    {"id":"ammaiyappan-en-s007-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-007.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":"ammaiyappan-s007-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"All right! I'm coming. Hey, Sumathi! Turn that way for a moment. I'll be right there.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s007-u036","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s007","archival_scene_ordinal":7,"source":{"source_path":"works/ammaiyappan/scenes/scene-007.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Final source cue while Sumathi stands turned away."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"[As Sumathi stands turned away, a sound—‘ich’—echoes on Sumathi's face.]","mode":"prose-faithful","notes":["The source's theatrical image is preserved without adding an explicit kissing action that the printed cue itself does not state."]}}
