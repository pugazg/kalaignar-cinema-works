{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source_scene_number":null,"scene_status":"verified","unit_count":43,"units":[{"id":"ammaiyappan-en-s029-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi and I were joined in a love marriage. She swore on God that she would never forget me.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Is that so!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"We ran in the pleasure garden—we bathed in the river—I said, 'Muthayi'—she called, 'My lord'—she moved her eyes... a diamond necklace at her throat—her waist swayed... I fastened a gem-studded ottiyanam around her... wearing jewels, she smiled... Singari! Oyyari! My dear! Peacock! I said, 'Come to the bedchamber'—she agreed to come... and then I woke up... it was all a dream, Tirisangu! All a dream!","mode":"prose-faithful","notes":["`ஒட்டியானம்` is retained as `ottiyanam` for the jeweled waist ornament; the dream's ornamental repetitions are preserved."]}},{"id":"ammaiyappan-en-s029-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It won't remain a dream, brother—not while this Tirisangu is here!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The gold and diamonds are ready... but my father must agree to turn them into a chain....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"That's where we have to struggle a little.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Struggle?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes!... For Arjunan to marry Pambarani Alli... for Velan, as an old man, to marry Valli...","mode":"prose-faithful","notes":["The source's mythic/name sequence is carried without external reconstruction."]}},{"id":"ammaiyappan-en-s029-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I don't know what I'll have to become!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You must become the next Palayakkarar... what doubt is there?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hey! Vedalam! You've come at just the right time, like Vandi Rappa Nadhar... sit down there.","mode":"prose-faithful","notes":["The frozen source form around `வந்தி ரப்பா நாதர்` is transliterated rather than silently normalized or externally identified."]}},{"id":"ammaiyappan-en-s029-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"No matter—it's all right—what secret consultation is going on?","mode":"prose-faithful","notes":["The clipped source `பாவா இல்ல—பரவாயில்ல` is rendered by immediate conversational sense without changing the Tamil evidence."]}},{"id":"ammaiyappan-en-s029-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I'll put it briefly; Tirisangu's daughter Muthayi and I are in love! It has become very serious now!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You can tell just by looking.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father won't agree to my marrying Muthayi—do you know why?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"She's your father... that's why!","mode":"prose-faithful","notes":["The frozen comic/irregular source says `அவள் உங்க அப்பா...அதனால்!`; the English does not silently repair it."]}},{"id":"ammaiyappan-en-s029-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Vedalam! At this important moment, give me a first-rate idea.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Every road of this Vedalam is a shortcut. Prince! I'll arrange the marriage. If we somehow finish the wedding by trickery, won't father have to accept it afterward? Hm... yes, that's right... Prince! Take out five hundred gold... hm... quickly, Yuvraj!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm... here you are. (He gives it.)","mode":"prose-faithful","notes":["The parenthetical action is embedded in the immutable source dialogue record and remains in the same unit."]}},{"id":"ammaiyappan-en-s029-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sabash! Now it's as good as the marriage is done... Tirisangu! Come with me. I'll explain all the arrangements—what must happen and how. I'm leaving, Kumar Raj!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":61,"printed_page":59}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I'm coming, brother!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":61,"printed_page":59},{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Tirisangu! Vedalam! Hm... in the hurry, don't forget to make the thali. Do that first, then let the other arrangements proceed; yes!","mode":"prose-faithful","notes":["`தாலி` is retained as `thali`; the cross-page source record remains one dialogue unit."],"english_page_segments":[{"pdf_page":61,"printed_page":59,"english_text":"Tirisangu! Vedalam! Hm... in the hurry, don't forget to make the thali. Do that first,"},{"pdf_page":62,"printed_page":60,"english_text":"then let the other arrangements proceed; yes!"}]}},{"id":"ammaiyappan-en-s029-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/scenes/scene-029.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthayi sits sadly; Tirisangu arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi is sitting sadly. Tirisangu arrives.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi! Muthayi! My girl, why are you sitting so sadly?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You're asking the reason?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I'm going through all this trouble so that you can be happy.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father! Enough! [She cries.]","mode":"prose-faithful","notes":["The bracketed crying cue is embedded inside the immutable source dialogue record and remains in this unit."]}},{"id":"ammaiyappan-en-s029-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What has happened now, my girl? Take heart!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What is the use, father, of cutting the root of the jasmine vine and then watering its flower?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I won't cut the root, my girl. Cheer up; there is also going to be a guru-puja at the monastery. The whole town will be in celebration. You too should be joyful...","mode":"prose-faithful","notes":["`குருபூஜை` is rendered as `guru-puja` to preserve the source ritual term."]}},{"id":"ammaiyappan-en-s029-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Even beside the light, a shadow remains dark. However many joyous events there are, what medicine is there for my broken heart, father?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't worry! Everything will happen as you wish. Forget the wrongs I committed. Ruined by greed for wealth, I behaved like a madman. Forgive this traitor who tried to tear apart your pure love, my girl.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father! Father!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't cry! I've decided to unite you and Muthan.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":62,"printed_page":60}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What are you saying, father?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":62,"printed_page":60},{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Listen, my girl—the Palayakkarar has learned that you love Muthan. The Palayakkarar, who does not want a marriage between Sukhadevan and you, has ordered that you be married to Muthan at once.","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":62,"printed_page":60,"english_text":"Listen, my girl—the Palayakkarar has learned that you love Muthan. The Palayakkarar, who does not want a marriage between Sukhadevan and"},{"pdf_page":63,"printed_page":61,"english_text":"you, has ordered that you be married to Muthan at once."}]}},{"id":"ammaiyappan-en-s029-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! Their selfish interest has wiped away my sorrow.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The Palayakkarar has asked for Muthan to be released. They too will let him go.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Will he come?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"He won't come here... know why? Sukhadevan has decided to abduct you and marry you. To escape that, the Palayakkarar's idea is that the two of us should immediately go to a town called Anandapuram. Muthan will come there. Your marriage will be completed at once. The Palayakkarar's men are taking care of all the arrangements for your good.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father! I can't believe it myself! I bow to you for bringing such joyful news. If I spoke rashly in any way, forgive me, father.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right, my girl! Let's immediately make arrangements to leave for Anandapuram...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s029-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s029","archival_scene_ordinal":29,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-029.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-029.md","source_record_id":"ammaiyappan-s029-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":63,"printed_page":61}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What other work do I have that matters more than that, father?","mode":"prose-faithful","notes":[]}}]}