{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s054","archival_scene_ordinal":54,"source_scene_number":null,"scene_status":"verified","unit_count":4,"units":[{"id":"ammaiyappan-en-s054-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s054","archival_scene_ordinal":54,"source":{"source_path":"works/ammaiyappan/scenes/scene-054.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-054.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Vedalam sits in a ruined mandapam with one thousand gold coins."},"speaker_label":null,"page_provenance":[{"pdf_page":95,"printed_page":93}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam sits in a ruined mandapam with one thousand gold coins.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s054-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s054","archival_scene_ordinal":54,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-054.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-054.md","source_record_id":"ammaiyappan-s054-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":95,"printed_page":93}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I got a thousand gold coins! God! A thousand salutations to you... Somehow make me the Palaiyakkaran of Pazhuthar... a crore salutations to you! A thousand gold coins for bringing Muthayi... From now on we don't need this disguise... We are subjects to none; we fear Yama not!","mode":"prose-faithful","notes":["The printed `நாமார்க்கும் குடியல்லோம்: நமனை அஞ்சோம்!` line remains embedded in Vedalam's immutable dialogue. English translates only the printed line and does not create a new literary-verse or song occurrence."]}},{"id":"ammaiyappan-en-s054-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s054","archival_scene_ordinal":54,"source":{"source_path":"works/ammaiyappan/scenes/scene-054.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-054.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Sukhadev arrives, becomes enraged, pushes down a stone and kills Vedalam."},"speaker_label":null,"page_provenance":[{"pdf_page":96,"printed_page":94}],"speaker_label_origin":null},"translation":{"english_text":"[Sukhadev arrives there. Enraged, he pushes down a stone from the mandapam and kills Vedalam.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s054-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s054","archival_scene_ordinal":54,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-054.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-054.md","source_record_id":"ammaiyappan-s054-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":96,"printed_page":94}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"This is the end for the wrongdoer!... In this world, only the man who reforms survives!","mode":"prose-faithful","notes":[]}}]}