  "units": [
    {"id":"ammaiyappan-en-s008-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/scenes/scene-008.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Opening source cue before the first labelled dialogue."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":18,"printed_page":16}]},"translation":{"english_text":"[Muthayi comes carrying a water pot.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Muthayi!... Muthayi!","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"What is it, appa?......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Where did you go, girl? How many places am I supposed to search for you... See who's come... Thambi, come in. Shoo... shoo... who called you in...?","mode":"prose-faithful","notes":["The abrupt `சீ...சீ...` is carried as a shooing interjection rather than normalized into explanatory prose."]}},
    {"id":"ammaiyappan-en-s008-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/scenes/scene-008.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Source cue: a goat enters, followed by Sukhadev."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"[A goat comes in; Sukhadev follows it.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-r001","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":1,"description":"Unlabelled invitation after the goat/Sukhadev arrival cue; resolved to Tirisangu by the closed source-role review."},"speaker_label":"திரி","speaker_label_origin":"source-context-attributed","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Come in, thambi!... Don't be shy, girl... there's no one else... This is Prince Sukhadev.","mode":"prose-faithful","notes":["Speaker identity comes from the closed source-role supplement; no printed label is invented in the Tamil evidence layer."]}},
    {"id":"ammaiyappan-en-s008-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Greetings!...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Long life!... Long life!... Ah!... The way those hands fold and unfold looks like a lotus flower. Tirisangu, everything you said is true... Oh, poor thing! Her cheeks have reddened with shyness, like ripe chillies—","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/scenes/scene-008.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Muthayi goes inside after Sukhadev's teasing."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"[Muthayi goes inside.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Should you tease her like this the moment you see her, thambi?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Eh... what did I say?... Did I say something without realizing it?... Hmm... Tirisangu, I want to ask you one thing... you won't refuse, will you...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"You are Palayakkarar Baladevar's son... the prince... I am merely your servant. You have the right to take without even asking....","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Aha-ha... tch... tch... my eyes are spinning... my ears refuse to hear... my tongue says it won't move... ayyayyo! My heart isn't beating at all......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17}]},"translation":{"english_text":"Thambi!... Thambi!... What is this... Shall I go bring the physician....?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":19,"printed_page":17},{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"No, no. This is an illness with no medicine... ‘when eye looks with eye...’... that is, I have fallen like a fly into the toddy-pot called love!","english_page_segments":[{"pdf_page":19,"printed_page":17,"english_text":"No, no. This is an illness with no medicine... ‘when eye looks with eye...’... that—"},{"pdf_page":20,"printed_page":18,"english_text":"—is, I have fallen like a fly into the toddy-pot called love!"}],"mode":"prose-faithful","notes":["The source itself prints only the fragmentary `கண்ணொடு கண்ணோக் கொக்கின் ...`; English preserves that incompleteness and does not repair the quotation from an external text."]}},
    {"id":"ammaiyappan-en-s008-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Thambi!... Go today and come tomorrow; the matter will succeed......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"‘Go today, come tomorrow’... Ah! I feel I've heard those words somewhere... Hmm... yes, in the Kamba Ramayanam... Rama says exactly that to Ravana... Ayyo! Ravana came back the next day and did not get victory; didn't he get death instead......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"But the Rama who came the next day won, didn't he, thambi...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Oh!... Then this Rama will definitely come tomorrow...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Do come for certain...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Would I stay away?—Tirisangu's house is a lotus pond; the bee that flies there is this Sukhadev... I'm going now, Tirisangu...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"All right, thambi!...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/scenes/scene-008.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Sukhadev leaves; Tirisangu turns angry."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"[He leaves. Tirisangu, angrily:]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Muthayi!... Muthayi!...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"What, appa! Has that man gone?...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Man?...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"No... no... forgive me; I misspoke...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Forgive you?... The prince himself came to the house... Is this how you insult him?...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"The prince... hmm... a bad young man...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":20,"printed_page":18}]},"translation":{"english_text":"Who is bad? Is he lacking in beauty?... Lacking in status?... Foolish girl—you cannot grasp his intelligence...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"Perhaps this noble man's intelligence is smaller than the point of a needle—too small to grasp! Isn't that so, appa?...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"Enough, stop. If he wished, even Urvashi and Rambha would come running...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"What's surprising about that, appa? Those who came running even to the sages of the royal court—would they say no if palace men called them? They'll come, appa, they'll come—","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"Shut your mouth, you chatterbox! I begged and coaxed him and brought him home; you sent him away with soot smeared on his face.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"No—he left too soon! Appa! Appa! If you smeared soot on his face he'd look even more handsome, like the dark-cloud-hued one.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"திருசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"Careful—if that reaches his ears, he'll pluck out your eyes.","mode":"prose-faithful","notes":["The exact Tamil speaker label is `திருசங்கு` here; it is retained as source provenance rather than normalized to another spelling."]}},
    {"id":"ammaiyappan-en-s008-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"Is he Kannappa Nayanar?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-008.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":"ammaiyappan-s008-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"திருசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"Tch! An answer for every word.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s008-u039","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s008","archival_scene_ordinal":8,"source":{"source_path":"works/ammaiyappan/scenes/scene-008.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-008.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Final source action: Muthayi laughs and runs inside."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"[Muthayi laughs and runs inside.]","mode":"prose-faithful","notes":[]}}
  ]
}
