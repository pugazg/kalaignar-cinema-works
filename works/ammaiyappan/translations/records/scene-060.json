{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source_scene_number":null,"scene_status":"verified","unit_count":8,"units":[{"id":"ammaiyappan-en-s060-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/scenes/scene-060.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"The Vengaiyur king and Poongavanam are nearby while Boopathi speaks looking at a golden lotus."},"speaker_label":null,"page_provenance":[{"pdf_page":106,"printed_page":104}],"speaker_label_origin":null},"translation":{"english_text":"[The king of Vengaiyur is there, with Poongavanam nearby. Physician Boopathi speaks while looking at a lotus made of gold.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s060-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":106,"printed_page":104}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"A beautiful lotus flower—the sculptor has made it wonderfully... Its golden petals glitter as though they would seize the eye.... Yet this flower has no fragrance, Maharaja!... That is what Princess Poongavanam's life has become!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s060-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்காவனம்","page_provenance":[{"pdf_page":106,"printed_page":104}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Maharaja!... After Physician Boopathi has told you so much, do you now understand why I refused to marry you?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s060-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"அரச","page_provenance":[{"pdf_page":106,"printed_page":104}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I understand, Poongavanam! If you had revealed this reason earlier, how much more peaceful my life would have been!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s060-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","page_provenance":[{"pdf_page":107,"printed_page":105}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Maharaja! Forgive me. I have done you a great wrong. Not only to you; I have wronged womankind itself! Maharaja, somehow set my son free!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s060-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":107,"printed_page":105}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Poongavanam! For the love I bore you alone, I could release Muthan. But Muthan is an enemy of Vengai Nadu!... a seeker of freedom!... There is no law by which I can release him......","mode":"prose-faithful","notes":["`விடுதலை விரும்பி` is preserved as `seeker of freedom`, retaining the source's political charge rather than reducing it to a generic offender label."]}},{"id":"ammaiyappan-en-s060-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","page_provenance":[{"pdf_page":107,"printed_page":105}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Maharaja!... Must Muthan die?... Must my son die?... Then kill me too...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s060-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s060","archival_scene_ordinal":60,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-060.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-060.md","source_record_id":"ammaiyappan-s060-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"அர","page_provenance":[{"pdf_page":107,"printed_page":105}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do not grieve! Muthan is being released because he is the son of the woman who has lived in my heart all this time!...","mode":"prose-faithful","notes":[]}}]}