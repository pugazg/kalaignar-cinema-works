{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source_scene_number":null,"scene_status":"verified","unit_count":17,"units":[{"id":"ammaiyappan-en-s013-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/scenes/scene-013.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Baladevar's wife and Poongavanam play sokkattan; Sukhadev comes down from upstairs; Tirisangu is at work."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"[Baladevar's wife and Poongavanam are playing sokkattan. Sukhadev comes down from upstairs. Tirisangu is occupied with some work.]","mode":"prose-faithful","notes":["The game name `சொக்கட்டான்` is retained as `sokkattan`."]}},{"id":"ammaiyappan-en-s013-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"Tirisangu! Success! Victory... victory upon victory!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"What is it, thambi?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"Father has agreed. He has given the order to dismiss Muthan from his job.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்காவனம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"What! Dismiss Muthan? Why? What for?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Tch... what for? He grabbed and pulled the hand of our Tirisangu's daughter, Muthayi. I rebuked him. A proper slap on the cheek.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Ah! Ah! I gave it to him.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்காவனம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Are you boasting about that? Does beating a poor man give you some thrill?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u010","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/scenes/scene-013.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Sukhadev rubs his back."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"[He rubs his back.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Hm—you don't know what happened, aunt. If you knew, you wouldn't talk like this.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்காவனம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Sukhadev! Don't dismiss Muthan. Who does he have apart from us? Poor orphan—where will he go?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Aunt! You, who chose not to marry and remain a maiden—why don't you think of God and roll your japa beads? Why get into all this trouble?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்காவனம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Sister-in-law, did you hear the way your son speaks?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Sukhadev! Be quiet.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-013.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":"ammaiyappan-s013-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுகதேவ்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"All right, all right! Come, Tirisangu.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s013-u017","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s013","archival_scene_ordinal":13,"source":{"source_path":"works/ammaiyappan/scenes/scene-013.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Poongavanam's face falls."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"[Poongavanam looks crestfallen.]","mode":"prose-faithful","notes":[]}}]}