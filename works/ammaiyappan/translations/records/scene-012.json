{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source_scene_number":null,"scene_status":"verified","unit_count":17,"units":[{"id":"ammaiyappan-en-s012-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"Come... come... you're Vedalam, aren't you?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"Yes.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"Why have you got a name like Vedalam? Did your father and mother read the story of Vikramaditya?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"They did; they did—why?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"There is a vedalam in the story of Vikramaditya—you must have been born while they were reading it, so they named you Vedalam. Good thing you weren't born while they were reading the Kishkindha Kandam. Come! Come!","mode":"prose-faithful","notes":["`வேதாளம்` is both the character's name and the legendary being in the Vikramaditya story; the wordplay is preserved."]}},{"id":"ammaiyappan-en-s012-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/scenes/scene-012.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Velazhagan enters; Vedalam and the warrior bow."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"[Velazhagan enters; Vedalam and the warrior bow.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"My lord! This is Vedalam, whom you sent for.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"Oh! Vedalam! Come. I have heard a great deal about you. Baladevar too said you were very capable. You know why I have come—to recruit men for the army. For that, you too...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"Me? Ayyo! I don't even have the strength to lift a sword.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":27,"printed_page":25}]},"translation":{"english_text":"You needn't join the army, man... Just catch and bring us some men. There must be plenty of people without work.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"But people will be afraid to join the army.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"Even a goat is afraid to come to the sacrificial altar. That is why they sprinkle turmeric-water, scatter flowers, hold food out in front and tempt it; one has to make an effort.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"Exactly right; I'll begin the work as you order. One more request.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"There is a great holy man in this town. Everyone regards his words as divine speech. If we ask him to campaign for men to join the army, our work will become easy.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"Do we have to give him anything to receive his grace?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s012-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s012","archival_scene_ordinal":12,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-012.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-012.md","source_record_id":"ammaiyappan-s012-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":28,"printed_page":26}]},"translation":{"english_text":"Anything? He will never accept it. He does not even touch material wealth with his hand. There is a donation box at the monastery. It has to be put in there.","mode":"prose-faithful","notes":[]}}]}