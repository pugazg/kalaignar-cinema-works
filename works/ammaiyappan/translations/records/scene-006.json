  "unit_count": 24,
  "units": [
    {"id":"ammaiyappan-en-s006-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"I am a hero among heroes—let enemies come from any side; I will face them and crush them... Let armies come by the akroni count! I will smash them like pots. Let them lay siege to forts... let them enter the audience hall itself... I will resist... drive them off... strike... pound the enemies of the world to dust... reduce all the chariots, elephants, cavalry and infantry to powder. Hmm... yes... which hand holds the shield, and which hand holds the sword... Hey, just tell me that much, will you?\n\n(Muthan enters.\n\nAh!... He'll know. Mutha!... Within two days I must become a great swordsman.","mode":"prose-faithful","notes":["The frozen source record itself contains the parenthetical Muthan-arrival cue inside Sukhadev's immutable dialogue span; English preserves it inside this one linked unit rather than splitting or duplicating the source record.","The source form `அக்ரோணிக்` is carried as `akroni` rather than silently repaired to a familiar epic military term."]}},
    {"id":"ammaiyappan-en-s006-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"Oh... we can make you into a swordsman.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"What! A swordsman?...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"Ah, it slipped out wrong. Never mind... You've heard of the sword-hero Hanuman, haven't you?......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Yes... yes, the one who went to Sita in Ashoka Grove...\n\nAll right... all right... come...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Parenthetical sword-practice action after Sukhadev tells Muthan to come."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"[They begin swordplay; Muthan starts whirling his sword a little faster......]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-r001","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":1,"description":"Unlabelled line after the first sword-practice cue; resolved to Sukhadev by the closed source-role review."},"speaker_label":"சுக","speaker_label_origin":"source-context-attributed","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Hmm.... Will this work with him?","mode":"prose-faithful","notes":["Speaker identity comes from the closed source-role supplement; no printed speaker label is invented."]}},
    {"id":"ammaiyappan-en-s006-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Parenthetical cue that the fight resumes."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"[They fight again.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-r002","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":2,"description":"Unlabelled speech after the renewed fight; resolved to Sukhadev by the closed source-role review."},"speaker_label":"சுக","speaker_label_origin":"source-context-attributed","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Hey... wait... wait! It'll strike somewhere it shouldn't and somebody will get killed... Give me that...","mode":"prose-faithful","notes":["Speaker identity is derivative provenance only; the Tamil evidence remains unlabelled at this point."]}},
    {"id":"ammaiyappan-en-s006-u010","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Bracketed action fetching a long sword and dagger."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"[He himself goes and brings a long sword and a dagger, looking at the warrior standing there.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Hey... you go.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Parenthetical addressee cue before the next source-role-resolved Sukhadev line."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"[To Muthan.]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-r003","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":3,"description":"Unlabelled line immediately after the `(முத்தனிடம்)` cue; resolved to Sukhadev by the closed source-role review."},"speaker_label":"சுக","speaker_label_origin":"source-context-attributed","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Here... hold this... Now let's see who wins...","mode":"prose-faithful","notes":["The preceding addressee cue is preserved separately; it does not become a printed speaker label."]}},
    {"id":"ammaiyappan-en-s006-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Wait. This is no way to conduct a fight......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"I don't need any rules.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u016","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Sword strike hits Muthan and Poongavanam runs over."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"[He swings the sword at Muthan. It strikes him. Seeing this, Poongavanam runs over......]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Sukhadev!...... What is this reckless game?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Swordplay. Why are you interfering in this, aunt? Mutha! Put medicine on the wound; I'm going.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":6,"description":"Sukhadev leaves and Poongavanam immediately tears cloth to bandage Muthan."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"[Sukhadev leaves. At once Poongavanam tears a strip of cloth and binds the wound....]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"(திகிலுடன்) முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":15,"printed_page":13}]},"translation":{"english_text":"Young Queen...","mode":"prose-faithful","notes":["The exact Tamil speaker label includes the source parenthetical `(திகிலுடன்)`; it remains unchanged in provenance rather than being normalized to `முத்`."]}},
    {"id":"ammaiyappan-en-s006-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"It's all right, Mutha. I'll bandage it myself.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/scenes/scene-006.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":7,"description":"Poongavanam's eyes fill with tears."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"[Tears well in her eyes....]","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s006-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"Yuva Rani, you seem somehow different...","mode":"prose-faithful","notes":["The period address `யுவராணி` is retained as `Yuva Rani` instead of being flattened into a generic modern title."]}},
    {"id":"ammaiyappan-en-s006-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s006","archival_scene_ordinal":6,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-006.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-006.md","source_record_id":"ammaiyappan-s006-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":16,"printed_page":14}]},"translation":{"english_text":"It's nothing, Mutha... Here, eat this. I'm going—someone may come...\n\n[She gives him the fruit she had kept hidden and leaves. Muthan stands bewildered with the fruit.]","mode":"prose-faithful","notes":["The frozen immutable dialogue record includes the trailing unlabelled action prose; English keeps it inside this one linked unit rather than duplicating source ownership as a second stage-direction unit."]}}
  ]
