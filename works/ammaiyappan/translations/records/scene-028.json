{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source_scene_number":null,"scene_status":"verified","unit_count":12,"units":[{"id":"ammaiyappan-en-s028-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/scenes/scene-028.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthayi is in the backyard; Sumathi arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi is in the backyard. Sumathi arrives.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Who? What brought you here?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sinner! If you had asked for it, why only a hundred—I would somehow have found even five hundred gold for you......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சும","page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What—what are you saying?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do I have to say it even more plainly? You act well, actress! For the sake of a miserable hundred gold, you've cut our love to pieces!","mode":"prose-faithful","notes":["`கூறு போட்டு விட்டாயே எங்கள் காதல்` is rendered as cutting the lovers' bond to pieces, preserving the accusation rather than normalizing the source phrasing."]}},{"id":"ammaiyappan-en-s028-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சும","page_provenance":[{"pdf_page":59,"printed_page":57}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Was I greedy for gold? Me? Muthayi! Listen to me... Just as you said, I went looking for Muthan at the post-house. He wasn't there.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"He wasn't there—you swallowed what you did get.","mode":"prose-faithful","notes":["The accusation `கிடைத்ததை வாயில் போட்டுக் கொண்டாய்` is translated by its immediate sense of having swallowed/kept the money."]}},{"id":"ammaiyappan-en-s028-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சும","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Let me speak a little too.......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough talking. Talking is useless. Go... go away... hm... go away, sinner... go......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சும","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Even if you don't understand me now, will you never understand someday? I'm leaving.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s028-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s028","archival_scene_ordinal":28,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-028.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-028.md","source_record_id":"ammaiyappan-s028-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":60,"printed_page":58}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't ever come back—traitor!","mode":"prose-faithful","notes":[]}}]}