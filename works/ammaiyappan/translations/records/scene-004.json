  "unit_count": 30,
  "units": [
    {
      "id": "ammaiyappan-en-s004-u001", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s004", "archival_scene_ordinal": 4,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-004.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-004.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 1, "description": "Opening scene-setting prose after the decorative star."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 10, "printed_page": 8}]},
      "translation": {"english_text": "[Maykainatha Swami is seated on a gold-polished dais. Nearby are Baladevar, his wife and Sukhadev; the guard Tirisangu; the others stand.]", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "ammaiyappan-en-s004-u002", "kind": "dialogue", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s004", "archival_scene_ordinal": 4,
      "source": {"source_path": "works/ammaiyappan/dialogues/records/scene-004.json", "canonical_scene_path": "works/ammaiyappan/scenes/scene-004.md", "source_record_id": "ammaiyappan-s004-d001", "source_occurrence_id": null, "source_locator": null, "speaker_label": "மாய்கைநாதர்", "speaker_label_origin": "source-explicit-colon", "page_provenance": [{"pdf_page": 10, "printed_page": 8}, {"pdf_page": 11, "printed_page": 9}]},
      "translation": {"english_text": "Didn't I tell you about great saints yesterday? Great saints do not appear often. But when such saints do appear, there is nothing they cannot do... They will dry up the sea; they will float in kasanthi... They will speak with God... They will make sugarcane taste bitter; they will make even a crow sing a Gandharva melody... Such are those endowed with divine grace. Warriors and men of wisdom have fame only on earth... But great saints have fame even in heaven. That is why I say: do not touch sword or spear; worship the fragrance of Vaikuntha. Do not bear a shield in your hand. Bear the sacred ash of the Lord of Kailasa... Who are you? Who am I? Mother, father, elder brother, younger brother—all are vain; in the end, a handful of earth.", "english_page_segments": [{"pdf_page": 10, "printed_page": 8, "english_text": "Didn't I tell you about great saints yesterday? Great saints do not appear often. But when such saints do appear, there is nothing they cannot do... They will dry up the sea; they will float in kasanthi... They will speak with God... They will make sugarcane taste bitter; they will make even a crow sing—"}, {"pdf_page": 11, "printed_page": 9, "english_text": "a Gandharva melody... Such are those endowed with divine grace. Warriors and men of wisdom have fame only on earth... But great saints have fame even in heaven. That is why I say: do not touch sword or spear; worship the fragrance of Vaikuntha. Do not bear a shield in your hand. Bear the sacred ash of the Lord of Kailasa... Who are you? Who am I? Mother, father, elder brother, younger brother—all are vain; in the end, a handful of earth."}], "mode": "prose-faithful", "notes": ["The verified Tamil `கசந்திலே` is not silently repaired; `kasanthi` is retained in transliteration because the frozen source layer does not authorize collapsing it to a guessed English object."]}
    },
    {
      "id": "ammaiyappan-en-s004-u003", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s004", "archival_scene_ordinal": 4,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-004.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-004.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 2, "description": "Bracketed departure after Maykainatha's sermon."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 11, "printed_page": 9}]},
      "translation": {"english_text": "[Everyone receives sacred ash and leaves.]", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "ammaiyappan-en-s004-u004", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s004", "archival_scene_ordinal": 4,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-004.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-004.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 3, "description": "Bracketed arrival of Boopathi."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 11, "printed_page": 9}]},
      "translation": {"english_text": "[Boopathi enters.]", "mode": "prose-faithful", "notes": []}
    },
    {"id":"ammaiyappan-en-s004-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"Come, Boopathi... come. It has been many years since I saw you! Your beard has gone completely white.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"A tender leaf becomes a dry leaf, after all. What is surprising about a beard turning white?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"You said one thing—and said it well. True; as clear as a gooseberry in the palm...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"Well, Boopathiyar, how were your travels abroad? I imagine your medical practice has improved many times over since before—your travels were useful for that, weren't they?—","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"Certainly they were. Twenty years of ceaseless wandering did not go to waste—the truth that what cannot be cured by magic and mantra can be cured by medicine......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"Ammaiyappa—there is nothing God cannot do.","mode":"prose-faithful","notes":[]}},
    {
      "id": "ammaiyappan-en-s004-u012", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s004", "archival_scene_ordinal": 4,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-004.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-004.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 4, "description": "Bracketed arrival of Vedalam."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 11, "printed_page": 9}]},
      "translation": {"english_text": "[Vedalam enters.]", "mode": "prose-faithful", "notes": []}
    },
    {"id":"ammaiyappan-en-s004-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"Swami, namaste.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":11,"printed_page":9}]},"translation":{"english_text":"What is it, Vedalam?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Many offerings have come for Swamigal. I brought them...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Offerings... Long live the devotees! How much, Vedalam?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Countless gold coins.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்கை","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Delightful! There is the offering box.","mode":"prose-faithful","notes":[]}},
    {
      "id": "ammaiyappan-en-s004-u019", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s004", "archival_scene_ordinal": 4,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-004.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-004.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 5, "description": "Bracketed departure of Vedalam."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 12, "printed_page": 10}]},
      "translation": {"english_text": "[Vedalam leaves.]", "mode": "prose-faithful", "notes": []}
    },
    {"id":"ammaiyappan-en-s004-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Does the Swami never touch gold?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாமி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Poison—poison!!......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"And isn't this tree growing in that very poison!... Swami! I have returned from abroad; you must give me a gift—will you?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாமி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"A gift? What, Boopathi?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"You must show that treasure to my eyes.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாமி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Treasure?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Not gold or diamonds, Swami... I'm asking for the secret buried within you...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாமி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Secret!","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Yes. Won't you tell me at least now?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாமி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"Don't take my life; you were away for twenty years—why have you come here now, man...?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s004-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s004","archival_scene_ordinal":4,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-004.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-004.md","source_record_id":"ammaiyappan-s004-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":12,"printed_page":10}]},"translation":{"english_text":"I'll tell you why I came. You too have been living for twenty years hiding that secret! Ha—ha—ha—Swami, even if a horse hides its feed in a sack while it eats, does that mean we won't know it is kol, the horse gram? Ha—ha—ha!","mode":"prose-faithful","notes":["The source's `கொள்` feed term is retained as `kol` with an inline gloss; the joke is not replaced by an invented English pun."]}}
  ]
}
