{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source_scene_number":null,"scene_status":"verified","unit_count":9,"units":[{"id":"ammaiyappan-en-s038-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பலதேவர்","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Tirisangu! That fellow! He acted like a good man and carried out a jackal's trick—the traitor!","mode":"prose-faithful","notes":["Frozen `வாட்டும் அவன்` is handled contextually; the Tamil source is not repaired."]}},{"id":"ammaiyappan-en-s038-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It is the good people one must not trust in these times, my lord.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s038-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பல","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Who's there? (A servant enters.) Go at once, bind Tirisangu hand and foot, and drag him here. No matter how much wealth is lost—only bring my son back to me. If he does not return, the queen will die.","mode":"prose-faithful","notes":["The servant-arrival action remains inside the immutable source dialogue record."]}},{"id":"ammaiyappan-en-s038-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"No one should learn that Sukhadev is missing. I myself will find him by stratagem and bring him back to you.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s038-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பல","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Thank you very much. I will give you five hundred gold coins—if Sukhadev is found, I will give you five hundred gold coins as a reward. Wait here—I will be back.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s038-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/scenes/scene-038.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Baladevar leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":null},"translation":{"english_text":"[Baladevar leaves.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s038-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"They say sorrow comes with company and happiness comes alone—that is wrong! Is happiness not marching upon Vedalam like a line of ants? Hmm... one man can seek comfort only by striking another! The fly is food for the spider—the spider is food for the lizard—the lizard is food for the cat—the cat is food for the Kuravan—the Kuravan is food for Yama—that is my path too! At the speed of my rise, perhaps I may even become the Palayakkarar of Pazhuthar!...","mode":"prose-faithful","notes":["The source's predatory food-chain rhetoric is preserved. `குறவன்` is retained as `Kuravan`, a source social/community label, without euphemistic substitution; `எமன்` is rendered as Yama."]}},{"id":"ammaiyappan-en-s038-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பல","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"(Coming back from inside) Vedalam! Here, take this!","mode":"prose-faithful","notes":["The return/action remains inside the immutable dialogue record."]}},{"id":"ammaiyappan-en-s038-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s038","archival_scene_ordinal":38,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-038.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-038.md","source_record_id":"ammaiyappan-s038-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":82,"printed_page":80}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Most honoured lord! I will somehow bring your precious son back. May the Lord be my aid! Ammaiyappa!","mode":"prose-faithful","notes":[]}}]}