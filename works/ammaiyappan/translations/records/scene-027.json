{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source_scene_number":null,"scene_status":"verified","unit_count":38,"units":[{"id":"ammaiyappan-en-s027-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Velazhagan and Vedalam are riding in a chariot when they spot Muthayi."},"speaker_label":null,"page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan and Vedalam are riding in a chariot when they spot Muthayi.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Kurumba!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Stop!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The chariot stops."},"speaker_label":null,"page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":null},"translation":{"english_text":"[The chariot stops.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"My lord! There... that golden duck is the Muthayi I told you about!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!... You call her a golden duck... in a poet's tongue, call her a swan... say sornam, Vedalam—I must possess her somehow... Muthayi and I must soon sing a love song together!","mode":"prose-faithful","notes":["`சொர்ணம்` is transliterated as `sornam` to preserve the source's ornamental wordplay rather than flattening all three images into `gold`."]}},{"id":"ammaiyappan-en-s027-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't worry... I'll be the rhythm for your song!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"The chariot goes on; Muthan is dragged along behind it."},"speaker_label":null,"page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":null},"translation":{"english_text":"[The chariot goes on. Muthan is dragged along behind it.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Muthayi runs up and addresses Kurumban."},"speaker_label":null,"page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi runs up and looks at Kurumban.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sir... sir!... You're a soldier of Vengai Nadu, aren't you?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறு","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes... what do you want?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Have they released him?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறு","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Whom?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthan!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"குறு","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Oh!... They've released him all right!... They've released him and are bringing him there with magnificent honours!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!... What?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u017","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Muthayi runs toward them happily; Muthan is lying on the ground after being beaten."},"speaker_label":null,"page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi runs toward them joyfully. Muthan is lying on the ground after being beaten.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Beat me!... Beat me well!... Beat me till the spark of uprising surges and surges in my heart!... It is by beating people who committed no wrong, again and again, that the durbar halls of many self-made tyrants have been levelled to the ground, sir!... Beat me, you sinners, beat me!...","mode":"prose-faithful","notes":["`தான் தோன்றிகள்` is rendered as `self-made tyrants`, preserving the contemptuous political force."]}},{"id":"ammaiyappan-en-s027-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":6,"description":"Muthayi parts the crowd and looks at Muthan."},"speaker_label":null,"page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi parts the crowd and sees Muthan.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Aththan!...","mode":"prose-faithful","notes":["`அத்தான்` is retained as `Aththan` because the kinship/lover address has no exact single English equivalent."]}},{"id":"ammaiyappan-en-s027-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":57,"printed_page":55}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Aththan... Aththan!... What have they done to you?... Even after I told you so much, you didn't listen!... Alas, Aththan... how many days had you been waiting for me to see this disfigured sight?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":57,"printed_page":55},{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't cry, Muthayi, don't cry!... This is no disfigured sight... In the killing hall of savages who live by trusting knife-points and dagger-swings, how many heroes have offered up their very lives... With swelling shoulders and the sword of freedom, never lowering the raised hand, even knowing they might perish... not a drop of fear touching their light-filled eyes, declaring, 'Either the sweet fragrance of marriage will be ours—or our corpses will stink on that field,' vowing against the enemy, showing the army the way and setting forth—how many, how many princes of freedom... sleep in the lap of Mother Freedom as children of the tomb, treasures of the grave! When I think of the scars borne by those heroic martyrs, my dear, this punishment is very little!....","mode":"prose-faithful","notes":["The `மணம்` / `நாறும்` contrast is carried as marriage-fragrance versus the stench of corpses; the political and martyrdom rhetoric is not softened."],"english_page_segments":[{"pdf_page":57,"printed_page":55,"english_text":"Don't cry, Muthayi, don't cry!... This is no disfigured sight... In the killing hall of savages who live by trusting knife-points and dagger-swings, how many heroes have offered up their very lives..."},{"pdf_page":58,"printed_page":56,"english_text":"With swelling shoulders and the sword of freedom, never lowering the raised hand, even knowing they might perish... not a drop of fear touching their light-filled eyes, declaring, 'Either the sweet fragrance of marriage will be ours—or our corpses will stink on that field,' vowing against the enemy, showing the army the way and setting forth—how many, how many princes of freedom... sleep in the lap of Mother Freedom as children of the tomb, treasures of the grave! When I think of the scars borne by those heroic martyrs, my dear, this punishment is very little!...."}]}},{"id":"ammaiyappan-en-s027-u024","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":7,"description":"Velazhagan arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan arrives.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What's this here... who is this moonlike maiden? Who are you, girl?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Traitor... don't touch her!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why, are you the owner of this peacock-plumed beauty?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Madman!... uncultured beast who doesn't know how to behave with women!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What? (He slaps him)—Muthayi? Aththan!...","mode":"prose-faithful","notes":["The immutable source record under exact label `வேல` contains the parenthetical slap and the additional printed tokens `முத்தாயி? அத்தான்!...`; they remain one source-owned unit and are not reassigned."]}},{"id":"ammaiyappan-en-s027-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-027.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Dishonourable man who barged into our blissful life where love and duty are woven together!... Mighty hero who takes pleasure in beating a man who lies bound!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u031","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/scenes/scene-027.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":8,"description":"The others laugh."},"speaker_label":null,"page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":null},"translation":{"english_text":"[They laugh.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s027-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s027","archival_scene_ordinal":27,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-027.md","source_record_id":"ammaiyappan-s027-r001","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":1,"description":"After the others laugh, the unlabelled lines continue Muthan's sarcastic denunciation."},"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":58,"printed_page":56}],"speaker_label_origin":"source-context-attributed"},"translation":{"english_text":"Laughter!... laughter!... Laugh well!... Laugh loudly, loudly!... Velazhagan's gang that has spun a spiderweb over a painted grove... pack of wastrels... laugh well!... Ha...ha...","mode":"prose-faithful","notes":["This is a closed source-context-attributed supplement; no printed speaker label is invented."]}},{"id":"ammaiyappan-en-s027-u033","kind":"stage-direction","status":"verified","target_language":"en","s