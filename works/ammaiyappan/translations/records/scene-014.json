{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source_scene_number":null,"scene_status":"verified","unit_count":28,"units":[{"id":"ammaiyappan-en-s014-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/scenes/scene-014.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan checks a sword; Poongavanam arrives."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Muthan is checking a sword. Poongavanam comes there....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Mutha!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Young queen! What do you want?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Nothing... about you and Sukhadev...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":29,"printed_page":27}]},"translation":{"english_text":"Yes, Rani... in a fit of anger, something happened....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Hm... who is that Muthayi?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"[Startled; silent...]","mode":"prose-faithful","notes":["The immutable dialogue record itself consists of a parenthetical reaction; it remains dialogue-kind because source ownership is locked to `ammaiyappan-s014-d006`."]}},{"id":"ammaiyappan-en-s014-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Won't you tell me?... Who is she who has stolen your heart?... Is she beautiful?... a woman of rare virtue?... a beauty suited to you?... Won't you tell me?... Mutha!... For that girl—have you and the prince fought a great war?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"My lady!....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Do you know what your quarrel has led to?... Your very job is in danger... This sinner is going to lose even the blessing of being able to look at you...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Young queen!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Don't call me that...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/scenes/scene-014.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Sukhadev's voice is heard; Poongavanam hides; Tirisangu arrives."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"[Sukhadev's voice is heard. Poongavanam hides. Tirisangu enters.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"What—oppose me?... Are there human beings in all the fourteen—sixteen worlds who can oppose me? What, Tirisangu...","mode":"prose-faithful","notes":["The source's comic `ஈரேழு பதினறு லோகத்திலும்` is preserved as the odd 'fourteen—sixteen worlds' formulation rather than normalized."]}},{"id":"ammaiyappan-en-s014-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Uh-uh...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Why stop at eleven worlds? There are no humans in the lunar sphere... none in the solar sphere... none in the realm of the stars...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"None, thambi... none... there isn't a single person who can oppose you...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"There is one—he too is finished; ...who?... this Muthan... Hey, Mutha!... For the crime you committed there will be no case... inquiry... judgment... none of it... accept the punishment...... You have no job here anymore...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":30,"printed_page":28}]},"translation":{"english_text":"Thank you...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"Thank you?... I cannot accept it. Take it back... Tirisangu... not just palace work—announce it throughout the town!... No one anywhere under our authority is to give this fellow work... If they do—I'll cut off the tail... skin the hide... break the leg... tear up the palm-leaf...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"Why!... Is there no more 'O' left to say?... You could say, 'I'll tear apart the garland'!","mode":"prose-faithful","notes":["The source runs a comic chain of threats and wordplay; the English keeps the literal escalation without inventing a replacement pun."]}},{"id":"ammaiyappan-en-s014-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"What... what... tear apart the garland?... Am I a monkey? Hm... hey, Mutha! Another great war between you and me is about to begin... Leave the palace immediately and respectfully!... You donkey who doesn't know your father's name!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/scenes/scene-014.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Seeing Muthan's anger, Sukhadev quickly leaves."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"[Seeing Muthan's anger, Sukhadev quickly leaves.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"Come!... Tirisangu!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u025","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/scenes/scene-014.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Muthan stands stunned; Poongavanam comes forward."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"[Muthan stands stunned. Poongavanam comes forward.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"Mutha!... Before you go, come by my mansion and then leave!... Don't forget... you must come... you absolutely must come...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u027","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/scenes/scene-014.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Poongavanam leaves; Muthan remains confused as her words echo repeatedly."},"speaker_label":null,"speaker_label_origin":null,"page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"[She leaves. Muthan is thoroughly confused... Poongavanam's words echo again and again in his mind...]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s014-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s014","archival_scene_ordinal":14,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-014.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-014.md","source_record_id":"ammaiyappan-s014-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":31,"printed_page":29}]},"translation":{"english_text":"My whole life has become a confusion...","mode":"prose-faithful","notes":[]}}]}