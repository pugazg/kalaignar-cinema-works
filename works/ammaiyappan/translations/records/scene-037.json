{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source_scene_number":null,"scene_status":"verified","unit_count":16,"units":[{"id":"ammaiyappan-en-s037-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hmm... two young birds—blossoming flowers—where have you gone to sing your love-song? Tirisangu! Don't worry. You have found a Manmatha fit for your daughter. Now let her sing her song—and him his!","mode":"prose-faithful","notes":["The source plays on `பாடு` after `காதல் கீதம்`; English keeps the song/plight echo as far as possible."]}},{"id":"ammaiyappan-en-s037-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It was not because he was a Manmatha that I got tangled up in all this trouble and arranged this marriage. I, who lie in a leaky hut......","mode":"prose-faithful","notes":["Frozen `பொல்லாம் கட்டப்பட்டு` is rendered from the immediate context without altering the Tamil source."]}},{"id":"ammaiyappan-en-s037-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":80,"printed_page":78},{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You thought you could stroll on an upper storey as the Palayakkarar's relative by marriage—that is it, isn't it! What of it now—Sukhadev and Muthayi will soon return after finishing their romantic tour.","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":80,"printed_page":78,"english_text":"You thought you could stroll on an upper storey as the Palayakkarar's relative by marriage—that is it, isn't it! What of it"},{"pdf_page":81,"printed_page":79,"english_text":"now—Sukhadev and Muthayi will soon return after finishing their romantic tour."}]}},{"id":"ammaiyappan-en-s037-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"When? When I am on my way to the cremation ground?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"So what if it is then? The grandson who will light your funeral pyre will be a future Palayakkarar, won't he? Hee... hee... hee... Tirisangu! Leave all that. I gave you the idea for such a magnificent wedding arrangement—where is my reward?","mode":"prose-faithful","notes":["The funeral-pyre joke and `Palayakkarar` social title are preserved."]}},{"id":"ammaiyappan-en-s037-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Reward?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Shall I call it wages?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do not play with my pain.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Play? This Vedalam does not play, Tirisangu... The reward you owe me must come, respectfully. Otherwise......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Otherwise what will you do?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What will I do? I will tell the Palayakkarar that you deceived Sukhadev and ruined him. Be careful!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do not frighten me. The Palayakkarar is not a fool who will simply believe your unsupported lie.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"No proof? The fact that Muthayi is not in your house is itself strong proof for me, do you understand?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough! Stop! You were the one who gave the idea too.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"That will not help you in this case, man! Wait... wait, I will deal with you. If you behave properly, you will survive. Otherwise.....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s037-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s037","archival_scene_ordinal":37,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-037.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-037.md","source_record_id":"ammaiyappan-s037-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரி","page_provenance":[{"pdf_page":81,"printed_page":79}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Otherwise—I will die. That is all, isn't it! Do not threaten me. Do whatever you can.","mode":"prose-faithful","notes":[]}}]}