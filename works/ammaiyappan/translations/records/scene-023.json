{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source_scene_number":null,"scene_status":"verified","unit_count":9,"units":[{"id":"ammaiyappan-en-s023-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/scenes/scene-023.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthayi enters with a bag of gold and sees Sumathi."},"speaker_label":null,"page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi enters with a bag of gold and sees Sumathi.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s023-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sumathi! Come, come! You have come at a good time!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s023-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What—is it Amrita Yoga?","mode":"prose-faithful","notes":["`அமிர்த யோகம்` is retained as `Amrita Yoga`, preserving the source's auspicious-time expression."]}},{"id":"ammaiyappan-en-s023-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hey, Rahu Kalam! Listen to what I'm saying!... There are one hundred gold coins in this. Somehow they must reach him...","mode":"prose-faithful","notes":["`ராகு காலம்` is retained as `Rahu Kalam`, preserving the comic contrast with `Amrita Yoga` in the preceding line."]}},{"id":"ammaiyappan-en-s023-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"To Muthan, of course...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s023-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Who else—? Go quickly, Sumathi!......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s023-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah... ah!... What a hurry!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s023-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/scenes/scene-023.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Sumathi leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":null},"translation":{"english_text":"[Sumathi leaves.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s023-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s023","archival_scene_ordinal":23,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-023.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-023.md","source_record_id":"ammaiyappan-s023-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"[To herself] Once he gets the gold, my beloved will leave the army... once he leaves, somehow we will plead with Father and have our marriage performed. After the marriage... ah! My heart grows sweet just thinking of that feast...","mode":"prose-faithful","notes":["The source's parenthetical `(தனக்குள்)` is retained as `[To herself]` inside the immutable dialogue record."]}}]}