{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source_scene_number":null,"scene_status":"verified","unit_count":16,"units":[{"id":"ammaiyappan-en-s024-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/scenes/scene-024.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan is confined in Thendral Palace; Vedalam enters."},"speaker_label":null,"page_provenance":[{"pdf_page":52,"printed_page":50}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan is confined in Thendral Palace. Vedalam enters.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":52,"printed_page":50},{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mutha! What foolishness you have done! Couldn't you have thought first before acting? Did I force you into the army? Velazhagan is a brute. You, poor fellow, are very good. By rights you should not be kept under guard. Who asked for this injustice? I ran to the Palayakkarar and told him. He paid no heed to what I said.\nHow can a poor man's voice be heard in a seven-storied palace?","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":52,"printed_page":50,"english_text":"Mutha! What foolishness you have done! Couldn't you have thought first before acting? Did I force you into the army? Velazhagan is a brute. You, poor fellow, are very good. By rights you should not be kept under guard. Who asked for this injustice? I ran to the Palayakkarar and told him. He paid no heed to what I said."},{"pdf_page":53,"printed_page":51,"english_text":"How can a poor man's voice be heard in a seven-storied palace?"}]}},{"id":"ammaiyappan-en-s024-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/scenes/scene-024.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Velazhagan enters."},"speaker_label":null,"page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan enters.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What, Vedalam! What are you muttering? If you wish, you may look at him and then go. You have no permission to speak with him. Muthan is now a caged bird.","mode":"prose-faithful","notes":["The frozen source form `மிலக்கிறீர்` is interpreted contextually as `muttering` in English without altering the Tamil authority."]}},{"id":"ammaiyappan-en-s024-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthan used to be with me, my lord. Exalted sir! Old affection is a terribly binding thing, isn't it! Somehow forgive him......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழ","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ha... ha... forgive him? Look at this government order. The king has commanded that I leave immediately for Tilankar with the soldiers enlisted so far. We must leave today.","mode":"prose-faithful","notes":["The place name `திலங்கர்` is transliterated as `Tilankar`; no external identification is supplied."]}},{"id":"ammaiyappan-en-s024-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthan too?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழ","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes! But if the hundred-gold fine arrives, he can be released... Hm... where would he get a hundred gold coins... a man who lies in the rubbish!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/scenes/scene-024.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Velazhagan leaves; Vedalam acts so that Muthan will trust him."},"speaker_label":null,"page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan leaves. Vedalam acts so that Muthan will trust him.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm. Mutha! It pains me even to look at you, man.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sir! Will you do me a favour?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What favour? Tell me... I'll see it done.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"A hundred gold coins will be sent to me. Take them, pay the fine, and somehow get me released.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":53,"printed_page":51}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What other work have I? The gold will certainly come, won't it?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":54,"printed_page":52}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It will certainly come.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s024-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s024","archival_scene_ordinal":24,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-024.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-024.md","source_record_id":"ammaiyappan-s024-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":54,"printed_page":52}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mutha! There is nothing to fear now. Stay without worry. Whatever happens, let the gold come. I will take care of everything.","mode":"prose-faithful","notes":[]}}]}