{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source_scene_number":null,"scene_status":"verified","unit_count":16,"units":[{"id":"ammaiyappan-en-s026-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/scenes/scene-026.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Velazhagan's soldiers prepare to leave for Vengaipuram with their baggage; Muthan sees his cage door being opened and looks at the soldier."},"speaker_label":null,"page_provenance":[{"pdf_page":54,"printed_page":52}],"speaker_label_origin":null},"translation":{"english_text":"[Velazhagan's soldiers are preparing to leave for Vengaipuram with bundles and chests. Seeing the door of his cage being opened, Muthan looks at the soldier.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What! Am I being released?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"(Coming in laughing) Yes, release—release from here for you, you wastrel! Do you know where you must go after this release? Not home—Vengaipuram!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What! Why are you treating me so cruelly? Isn't it only just that you take your fine and release me?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Fine money—you who have no way to get even half a coin, where would you get fine money? Ha...ha...ha...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If you keep me locked in prison like this, how can I pay your fine? Let me out... I'll bring it quickly.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Impossible—it has to come here! Even if it comes now, fine; I'll let you go.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/scenes/scene-026.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Vedalam arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam arrives.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"(To Vedalam) What happened? Did you get it? Has it arrived?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ha ha—hm! Waiting and waiting, my legs are worn out. My eyes too are weary. Nothing came of it. (Turning toward Velazhagan) My lord! The fine money may arrive soon. Delay a little....","mode":"prose-faithful","notes":["`கண்ணும் பூத்துவிட்டது` is rendered by its waiting-context sense without changing the frozen Tamil wording."]}},{"id":"ammaiyappan-en-s026-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":55,"printed_page":53}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The red sun does not wait because the rooster has not crowed. I must do my duty—or the ruler will rage... hm... we must leave. Freedom fighter! You too, walk behind.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":55,"printed_page":53},{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I will not walk! Freedom fighters who have resolved to turn your very heads into red-lotus buds in the mire of blood will not walk like sheep behind tyrants drunk on domination! Pazhuthar is my land—a honeycomb to me; you are a forest of fire. Even if a charnel ground comes, I will say so be it; I will not follow behind you, a storm that has entered a flower garden! I am a citizen of this beautiful land—you are a lord who lives by plundering it; even a man deprived of reason would not accept your new scheme—your philosophy—that a deer should walk behind a tiger!","mode":"prose-faithful","notes":["The source's honeycomb/fire-forest, flower-garden/storm and tiger/deer political metaphors are preserved."],"english_page_segments":[{"pdf_page":55,"printed_page":53,"english_text":"I will not walk! Freedom fighters who have resolved to turn your very heads into red-lotus buds in the mire of blood will not walk like sheep behind tyrants drunk on domination! Pazhuthar"},{"pdf_page":56,"printed_page":54,"english_text":"is my land—a honeycomb to me; you are a forest of fire. Even if a charnel ground comes, I will say so be it; I will not follow behind you, a storm that has entered a flower garden! I am a citizen of this beautiful land—you are a lord who lives by plundering it; even a man deprived of reason would not accept your new scheme—your philosophy—that a deer should walk behind a tiger!"}]}},{"id":"ammaiyappan-en-s026-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough talk... Who's there! Shackle this mightiest of heroes! Let the massed army march in front as our column moves on—and let this slave-dog be dragged behind.","mode":"prose-faithful","notes":["The frozen form `தோற்ப்பும்வரை` is irregular; the English follows the immediate marching context without altering the Tamil record."]}},{"id":"ammaiyappan-en-s026-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-026.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":"ammaiyappan-s026-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm... at once...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s026-u016","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s026","archival_scene_ordinal":26,"source":{"source_path":"works/ammaiyappan/scenes/scene-026.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-026.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Muthan is shackled."},"speaker_label":null,"page_provenance":[{"pdf_page":56,"printed_page":54}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan is shackled.]","mode":"prose-faithful","notes":[]}}]}