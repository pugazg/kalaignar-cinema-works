{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source_scene_number":null,"scene_status":"verified","unit_count":24,"units":[{"id":"ammaiyappan-en-s019-u001","kind":"song-reference","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/songs/inventory.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":null,"source_occurrence_id":"ammaiyappan-song-003","source_locator":{"kind":"singing-performance-cue","ordinal":1,"description":"The source says Muthan is singing while the post-runner carries bags out and Tirisangu arrives; no title or lyric body is printed."},"speaker_label":null,"page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":null},"translation":{"english_text":"[While Muthan is singing, the post-runner carries some bags out. Tirisangu enters.]","mode":"prose-faithful","notes":["The booklet prints only the performance cue. No song title, lyric body, or authorship is reconstructed."]}},{"id":"ammaiyappan-en-s019-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Where is Muthan? Mutha!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't be afraid, Mutha.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why fear! The palace must have issued some new order.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The palace has nothing to do with my coming... Mutha, there is no one here, is there?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"No... what is it?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I know that there is true love between you and my daughter.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"At least you know it now!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Listen, Mutha! Muthayi has said she cannot marry anyone but you. She has fallen to the bow you shot.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I did not shoot, and she did not fall... We are both doves caught in the net of love!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"That net must be cut and my daughter freed. Even after she is freed, you must not remain a vulture chasing her.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":40,"printed_page":38}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"She will not be at a distance that needs chasing. Muthayi is a parrot perched on my shoulder! Are you thinking, 'What is this—this son-in-law speaks to his father-in-law without any shyness?' Forgive me.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":40,"printed_page":38}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Listen, Mutha; you are the one who must save my honour. Do you know how I wish my daughter to live?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":40,"printed_page":38}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Our life will go exactly as you wish!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":40,"printed_page":38},{"pdf_page":41,"printed_page":39}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It will not, Mutha. It will not. Do not ruin a family for nothing. You have no means to live; you cannot live. Leave me aside... Would any father, however mad, agree to give his daughter to a poor man like you? Can you run a family? You are a man too; have you lost all shame, to marry and then lie waiting upon your father-in-law's house? Muthayi is a young girl. She does not know the world...... She talks of love now. After marriage, all those love-songs will become stories of the past. Diamond earrings for the ears, a pearl necklace for the neck—that is how women's minds change. Can you buy those for my daughter? Leave running a family aside—do you even have one gold coin to fix the marriage and give the priest dakshina? Mutha! Don't think I am speaking in anger; I will tell you one more thing. You worked at the post-house. That too is gone... You groomed horses for the post-house and, as wages for that, lived in this palm-sized room. You cannot do even that work anymore; the palace order forbids it. From now on the shade of houses and the shade of cattle—those are your dwellings! Mutha! Do not grieve that I am examining your poverty; along with all this grief I will tell you one more thing, so that you may understand. Suppose you were older, used to living in step with the world, and suppose you too had a daughter. Would you give that daughter in marriage to a bridegroom whose father's name was unknown? Perhaps you might. Could I? Would my orthodox mind allow it? Think! You know only that your mother was Kaveri; whom she bore you to is......","english_page_segments":[{"pdf_page":40,"printed_page":38,"english_text":"It will not, Mutha. It will not. Do not ruin a family for nothing. You have no means to live; you cannot live. Leave me aside... Would any father, however mad, agree to give his daughter to a poor man like you? Can you run a family? You are a man too; have you lost all shame, to marry and then lie waiting upon your father-in-law's house? Muthayi is a young girl. She does not know the world...... She talks of love now. After marriage, all those love-songs will become stories of the past. Diamond earrings for the ears, a pearl necklace for the neck—that is how women's minds change. Can you buy those for my daughter? Leave running a family aside—do you even have one gold coin to fix the marriage and give the priest dakshina? Mutha! Don't think I am speaking in anger; I will tell you one more thing. You worked at the post-house. That too is gone... You groomed horses for the post-house and, as wages for that, lived in this palm-sized room. You cannot do even that work anymore;"},{"pdf_page":41,"printed_page":39,"english_text":"the palace order forbids it. From now on the shade of houses and the shade of cattle—those are your dwellings! Mutha! Do not grieve that I am examining your poverty; along with all this grief I will tell you one more thing, so that you may understand. Suppose you were older, used to living in step with the world, and suppose you too had a daughter. Would you give that daughter in marriage to a bridegroom whose father's name was unknown? Perhaps you might. Could I? Would my orthodox mind allow it? Think! You know only that your mother was Kaveri; whom she bore you to is......"}],"mode":"prose-faithful","notes":["The source's class, gender, ritual and parentage arguments are translated without endorsement or euphemism."]}},{"id":"ammaiyappan-en-s019-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":41,"printed_page":39}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough! Enough, sir, enough!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":41,"printed_page":39}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Covering your ears is no use. Opening your eyes wide is no use. Open the door of thought... open it just a little; that is enough. Prosperity, distinction, and a splendid mansion are calling my daughter. Will you make her forget them? Will you, Mutha? If you refuse, that is not a sign of your love for her; it is a sign of your cruel wish to ruin her. Mutha! I beg you. If need be, I will fall at your feet. Forget her... forget her.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":41,"printed_page":39}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"[Crying] Ah! Ayyo! A jewel that cannot be forgotten, a treasure that cannot be lost.... am I to forget that?","mode":"prose-faithful","notes":["The bracketed crying cue is embedded in the immutable dialogue record and is therefore kept inside this dialogue unit."]}},{"id":"ammaiyappan-en-s019-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":41,"printed_page":39}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If you do not forget her, Muthayi must forget her father. If she forgets him like that, the corpse of this Tirisangu, hanging orphaned in mid-air from a tree branch, will curse you... the corpse will curse you!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":41,"printed_page":39}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sir! You ask me to forget my very life. I will forget it.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mutha!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-019.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":"ammaiyappan-s019-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Go on, then.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s019-u024","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s019","archival_scene_ordinal":19,"source":{"source_path":"works/ammaiyappan/scenes/scene-019.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-019.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Tirisangu leaves pleased; Muthan is thrown into confusion."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":40}],"speaker_label_origin":null},"translation":{"english_text":"[Tirisangu leaves, pleased. Muthan is thrown into confusion.]","mode":"prose-faithful","notes":[]}}]}