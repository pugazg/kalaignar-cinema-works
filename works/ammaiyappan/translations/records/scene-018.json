{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source_scene_number":null,"scene_status":"verified","unit_count":20,"units":[{"id":"ammaiyappan-en-s018-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/scenes/scene-018.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Townspeople are gathered; Thanapathi, Velazhagar, doctor Boopathi, Vedalam and others are present; Maykkai Natha Swamigal's speech is in progress."},"speaker_label":null,"page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":null},"translation":{"english_text":"[The townspeople are gathered. Thanapathi, Velazhagar, Doctor Boopathi, Vedalam and many others are present. Maykkai Natha Swamigal's speech is in progress.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை நாதர்","page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Friends! Until now Thanapathi Velazhagar has delivered an instructive speech about the benefits of the army. I too am going to say the same thing. Bhagavan Paranthaman himself told Parthan to take part in the Bharata war. Those who preach today that war must not be fought, that it is a path of frenzy—let them read the Bhagavad Gita. Then they will see how much that flute-player has said about the necessity of war. What do the trident in Siva's hand, the spear of Siva's son, and Vishnu's discus signify? Peace? Or battle? Therefore, friends! All of you become warriors... do not fear death. It is not only by taking up a sword that people die; many have ended their lives by slipping on a banana peel. For a warrior, there is fame not only on earth but in heaven too. Bear the garland of victory upon those bent shoulders. For that, bear swords in your hands. Strike your strong shoulders and set out saying that God is your support... Ammaiyappa! Long live the path of virtue!...","mode":"prose-faithful","notes":["Religious and martial rhetoric is preserved as source rhetoric; no external theological correction is introduced."]}},{"id":"ammaiyappan-en-s018-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மக்கள்","page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ammaiyappa! Ammaiyappa!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/scenes/scene-018.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The crowd disperses; Thanapathi and the Swamiyar meet in private."},"speaker_label":null,"page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":null},"translation":{"english_text":"[The crowd disperses. Thanapathi and the Swamiyar meet in a private place.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I offer you my deepest thanks.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை","page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I did my duty.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If heads of monasteries like you set out to serve the country, both worlds will be illuminated. I will meet you later. I take my leave.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை","page_provenance":[{"pdf_page":37,"printed_page":35}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ammaiyappa! Long live the path of grace.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/scenes/scene-018.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Maykkai Nadhar returns near his seat; Doctor Boopathi alone remains seated; seeing him, Maykkai Nadhar is startled."},"speaker_label":null,"page_provenance":[{"pdf_page":37,"printed_page":35},{"pdf_page":38,"printed_page":36}],"speaker_label_origin":null},"translation":{"english_text":"[Maykkai Nadhar comes back near his seat. Doctor Boopathi alone is still sitting there. Seeing him, Maykkai Nadhar is startled.]","english_page_segments":[{"pdf_page":37,"printed_page":35,"english_text":"[Maykkai Nadhar comes back near his seat. Doctor Boopathi alone is still sitting there."},{"pdf_page":38,"printed_page":36,"english_text":"Seeing him, Maykkai Nadhar is startled.]"}],"mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை நாதர்","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What, Boopathi! You still haven't left?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I forgot myself, Swamiyare! I lost my very heart in your speech. Hee... hee... hee... 'Do not touch sword or spear—worship the Lord of Vaikuntha... do not bear a shield in your hand—bear the sacred ash of the Lord of Kailasa...' Where is all that now? 'Bear the garland of victory on bent shoulders... for that, bear spears in your hands...' And where is this? Everything is maya... magic illusion... isn't it, Swamiyare?","mode":"prose-faithful","notes":["Boopathi's mocking quotation and contrast are preserved as such."]}},{"id":"ammaiyappan-en-s018-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை நாதர்","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Boopathi! Enough, please go.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I am praising you, Swamiyare, praising you! Ahaha! Lord! What all they use you for. Every great man who appears in the world, they say, is your incarnation. They say you incarnated as the Paramatma and told Arjuna to wage war. Then, they say, you yourself incarnated as Bhagavan Buddha and showed Ashoka the good path, saying war is evil. When they have made even you contradict yourself like this, what does this Swamiyar amount to?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை நாதர்","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Boopathi! If a sadhu is enraged, even the forest cannot contain it, Boopathi!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It is not the sadhu that is trembling... it is deceit, argument, and evil that are trembling.","mode":"prose-faithful","notes":["The rhyming source sequence `சூது, வாது, தீது` is translated semantically; its sound-play is only partly recoverable in English."]}},{"id":"ammaiyappan-en-s018-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை நாதர்","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why should there be any quarrel between us, man....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What is there between us? Tell me that secret.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"மாய்க்கை நாதர்","page_provenance":[{"pdf_page":38,"printed_page":36}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Boopathi: I bow to you. Please go away. Just don't ask about that secret!","mode":"prose-faithful","notes":["The immutable source record is labelled `மாய்க்கை நாதர்` but its text itself begins `பூபதி:`. That repeated source token is retained in translation rather than silently deleted or reassigned."]}},{"id":"ammaiyappan-en-s018-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-018.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":"ammaiyappan-s018-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Swamiyare! I'm going. Swamiyare! Remember just one thing. A lie slowly, little by little, grows and blossoms... but truth suddenly explodes... Ha... ha... ha... I'm going.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s018-u020","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s018","archival_scene_ordinal":18,"source":{"source_path":"works/ammaiyappan/scenes/scene-018.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-018.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Boopathi leaves; the Swamiyar sighs deeply and goes to sit on the seat."},"speaker_label":null,"page_provenance":[{"pdf_page":39,"printed_page":37}],"speaker_label_origin":null},"translation":{"english_text":"[Boopathi leaves. The Swamiyar lets out a deep sigh and goes to sit on the seat.]","mode":"prose-faithful","notes":[]}}]}