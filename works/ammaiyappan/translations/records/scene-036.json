{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source_scene_number":null,"scene_status":"verified","unit_count":28,"units":[{"id":"ammaiyappan-en-s036-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":78,"printed_page":76}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi! Am I the only one waiting for you?... Look, even the moonlight in that sky is waiting... Angry girl! Maiden of cool speech! Why have you still not come?... Are those horsemen blockheads?... Or are these steeds themselves unable to understand my urgency? How long... how long... I told them then itself... that a shortcut should be laid between Anandapuram and the capital... If this foolish king had listened, how quickly my Muthayi could have arrived by now!...","mode":"prose-faithful","notes":["The source's repeated waiting/urgency rhetoric is preserved rather than smoothed away."]}},{"id":"ammaiyappan-en-s036-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/scenes/scene-036.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Soldiers bring Sukhadev dressed as a woman."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":76}],"speaker_label_origin":null},"translation":{"english_text":"[The soldiers bring Sukhadev dressed as a woman.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"தனபதி","page_provenance":[{"pdf_page":78,"printed_page":76}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi! You've come?... Muthayi, won't you speak?... Ah! Who has closed those lips that pour out golden words?... These horsemen are fools!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/scenes/scene-036.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The gag is removed; Sukhadev cries out and Velazhagan becomes angry."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":null},"translation":{"english_text":"[The gag is removed. Sukhadev cries out, and Velazhagan grows angry.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sir, my lord! Don't hit me...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேல","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"How did you come here?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi and I—she as a woman and I as a man... no... no... she as a man... I as a woman... we put on disguises and went to the riverbank to play happily... and then, my lord, this danger befell me!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Fool! Get out of here without telling anyone outside...","mode":"prose-faithful","notes":["Exact source label `தன` is retained; downstream character identity must not rewrite the printed label."]}},{"id":"ammaiyappan-en-s036-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/scenes/scene-036.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"A proclamation is beaten on the drum; Muthan and Muthayi enter in disguise."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":null},"translation":{"english_text":"[A proclamation is beaten out on the drum. Muthan and Muthayi enter in disguise.]","mode":"prose-faithful","notes":["The intervening source `* * *` is structural and is not translated as prose."]}},{"id":"ammaiyappan-en-s036-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பறையடிப்பவன்","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"This is to inform everyone that... a man named Muthan has escaped from the Vengai-country army... His identifying marks are—a budding moustache—a handsome young man—a ruddy complexion—a bronze voice—whoever catches and hands him over will receive a proper reward!... This is the order of Velazhagar, commander of Vengai country!... Dum!... dum!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/scenes/scene-036.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"Muthan and Muthayi approach a merchant's house; the merchant is with a child."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan and Muthayi come toward a merchant's house. The merchant is with a child.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வணி","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"See that, little one! Dum... duma... duma... will you catch the runaway and hand him over?...... [The child cries.] Hey!... don't cry... lovely sight... sacred ornament of a beautiful gem-studded mansion... an indelible painting... a dancing golden lamp... aararo...","mode":"prose-faithful","notes":["The child-cry cue is embedded inside this immutable dialogue record and stays there.","`ஆராரோ` is retained as the source-visible lullaby-like vocable. The closed song/performance inventory does not retain this span as a separate occurrence, so no song unit or authorship claim is created."]}},{"id":"ammaiyappan-en-s036-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/scenes/scene-036.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Muthan and Muthayi are seen approaching."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan and Muthayi are seen approaching.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":79,"printed_page":77}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Who? Who... are you? What do you want? I can't give you any alms... I have an infant to care for...","mode":"prose-faithful","notes":["Exact source label `தன` is preserved. In this record the closed record-aware character layer resolves it to the merchant role; that identity aid does not rewrite the Tamil label."]}},{"id":"ammaiyappan-en-s036-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"We're looking for some kind of work...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Have brother and younger sister set out together?.......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Oh no!... we're husband and wife, master...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hmm... what work can you do?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"We'll do whatever work we're given without refusing. He isn't well... only I...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right... can you raise this child?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Oh!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Do you have experience?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Even the child is reaching for me... come here, little one!......","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The child has no mother—has come into the world, as the source puts it, like a banana bunch... you must look after it... there are no wages... just food for the two of you... here is a thatched hut... you can live in it...","mode":"prose-faithful","notes":["Frozen spacing in `வாழைக்குல ைமாதிரி` is not silently repaired. The unusual banana-bunch simile is retained conservatively rather than normalized away."]}},{"id":"ammaiyappan-en-s036-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"தன","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What's your name?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"My name is Ponni... and he...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s036-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s036","archival_scene_ordinal":36,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-036.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-036.md","source_record_id":"ammaiyappan-s036-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":80,"printed_page":78}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mm... don't say your husband's name... poor thing... my name is Ponnan, master!","mode":"prose-faithful","notes":["The disguise names Ponni/Ponnan are source-visible and are not normalized into character aliases."]}}]}