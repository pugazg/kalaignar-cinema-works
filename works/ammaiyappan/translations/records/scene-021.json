{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source_scene_number":null,"scene_status":"verified","unit_count":42,"units":[{"id":"ammaiyappan-en-s021-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/scenes/scene-021.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthayi and Sumathi enter carrying water pots."},"speaker_label":null,"page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi and Sumathi enter carrying water pots.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Poor thing... after not seeing her beloved for two or three days, she must have been in terrible distress... Come, let's see whether her bangles are slipping off.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sumathi, enough!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why—does it hurt more the more I talk about it?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You would know what kind of pain it is only if you experienced it yourself.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Lord! Let experiences like this never come to me.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Even the Lord has had such an experience, girl.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/scenes/scene-021.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Muthan enters."},"speaker_label":null,"page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan enters.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"There—your lover has come.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right, all right... Sumathi, run along.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Let it be... I'm not ashamed of anything.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"We are, girl... go away.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":44,"printed_page":42}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right! I'm going... come back before I finish bathing.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I'll keep bathing only until you return... Is your body made of jaggery, that it will dissolve in the water?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுமதி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"My body isn't jaggery... Just wait till he comes and describes it; then you'll know whose body is jaggery.... [in a man's voice] Rock candy! Honey! Boiled milk!","mode":"prose-faithful","notes":["The source's embedded cue `(ஆண்போல்)` is retained as `[in a man's voice]` inside the immutable dialogue unit."]}},{"id":"ammaiyappan-en-s021-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Go away, chatterbox.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u017","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/scenes/scene-021.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Muthayi raises her hand; Sumathi runs off; Muthan arrives looking dejected."},"speaker_label":null,"page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":null},"translation":{"english_text":"[Muthayi raises her hand. Sumathi runs off. Muthan arrives looking dejected.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why do you look troubled? Eat this.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"No.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Oh! You haven't come for two days—are you getting in first because you think I'll be angry?\n\nI'm not angry at all. They say that when the ink-writing stylus in one's hand comes close to the eyebrow, it disappears from sight. In the same way, once you come close to me, all the wrongs you have done disappear from my sight.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi! You grieve like this over only two days apart—I'm afraid even to think of those dark days when we may not be able to meet at all.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What... what are you saying?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"My grove-cuckoo! I have become a desert where you cannot sing.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":45,"printed_page":43}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If you become a desert, I will be the date palm that grows in it.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":45,"printed_page":43},{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Don't play, Muthayi, don't play... blinking your eyes like stars, showing pearly white teeth, showing the gait of a spotted peacock that comes sweeping in,\nplaying your games, playing in my lap, O `magame` dancing in my eyes! Cluster of gem-like flowers! The time has come when all that play must be buried under the earth, my dear.","mode":"prose-faithful","notes":["The frozen source form `மாகமே` is not silently normalized; `magame` is transliterated in English."],"english_page_segments":[{"pdf_page":45,"printed_page":43,"english_text":"Don't play, Muthayi, don't play... blinking your eyes like stars, showing pearly white teeth, showing the gait of a spotted peacock that comes sweeping in,"},{"pdf_page":46,"printed_page":44,"english_text":"playing your games, playing in my lap, O `magame` dancing in my eyes! Cluster of gem-like flowers! The time has come when all that play must be buried under the earth, my dear."}]}},{"id":"ammaiyappan-en-s021-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What... who is talking like this... my Muthan? My Muthan?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Not your Muthan... Muthan is not speaking; the warrior of Vengaipuram is speaking, my dear—the warrior of Vengaipuram is speaking.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! A warrior of Vengaipuram!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What do you mean, yes?... Whom did you ask before turning yourself into a warrior of Vengaipuram?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":46,"printed_page":44}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Whom did I ask?... I asked poor Muthan... He said Muthayi is meant to be queen of a palace... give up thoughts of her.... The Muthan in love shed tears... then, in a `kāgaratha` voice, in a `kambiya` tone, poor Muthan gave the order: forget Muthayi... I forgot her... I forgot my beauty... I forgot the treasure that had taken residence in my thoughts... There was no other way to keep the promise I gave your father... If there had been another way, would I have joined the army of the enemy that keeps Pazhuthar enslaved?","mode":"prose-faithful","notes":["The frozen forms `காகரத்த` and `கம்பிய` are transliterated rather than silently repaired."]}},{"id":"ammaiyappan-en-s021-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":46,"printed_page":44},{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What crime did I commit that you should forget me, other than being born the daughter of a greedy father?... What is love? A mirror that reflects the form of whoever stands before it? A picture scratched with a line? I thought love was an indelible painting—an unmoving Himalaya. Was that only madness? What difference is there between my father, who has treated me as market goods, and you? Have they made me into a statue?\nMy story will not end with, 'The lover forgot; the beloved flew elsewhere,' my lord... You are trying to rewrite the Ambikapathi epic. It is not only the king's daughter Amaravathi who has a heart for love; the slave's daughter Muthayi has one too! I will show it to you as a spectacle—there, on that swaying tree branch... in that rushing flood... be ready to see my corpse in one of the two!","mode":"prose-faithful","notes":["The irregular source clause `என் சிலையாகி விட்டார்கள்?` is rendered literally rather than normalized or rewritten."],"english_page_segments":[{"pdf_page":46,"printed_page":44,"english_text":"What crime did I commit that you should forget me, other than being born the daughter of a greedy father?... What is love? A mirror that reflects the form of whoever stands before it? A picture scratched with a line? I thought love was an indelible painting—an unmoving Himalaya. Was that only madness? What difference is there between my father, who has treated me as market goods, and you? Have they made me into a statue?"},{"pdf_page":47,"printed_page":45,"english_text":"My story will not end with, 'The lover forgot; the beloved flew elsewhere,' my lord... You are trying to rewrite the Ambikapathi epic. It is not only the king's daughter Amaravathi who has a heart for love; the slave's daughter Muthayi has one too! I will show it to you as a spectacle—there, on that swaying tree branch... in that rushing flood... be ready to see my corpse in one of the two!"}]}},{"id":"ammaiyappan-en-s021-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi; I have already registered my name in the army... what can I do?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"So what? I know you can withdraw by paying a fine of one hundred gold coins.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"A fine?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why—do you say paying a fine is shameful? It is no greater shame than going as a mercenary soldier for an enemy country... This is not a fine paid out of fear of prison.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Listen to me; Father has put aside one hundred gold coins for my marriage and locked them away without anyone knowing. What else are they for, if not this? I'll send them through Sumathi. Take them, pay the fine, and withdraw.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Listen to this...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I won't listen to anything... you must withdraw... otherwise I...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi! Withdraw?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s021-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s021","archival_scene_ordinal":21,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-021.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-021.md","source_record_id":"ammaiyappan-s021-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":47,"printed_page":45}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Not from me... from the army. Eat this.","mode":"prose-faithful","notes":[]}}]}