{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source_scene_number":null,"scene_status":"verified","unit_count":18,"units":[{"id":"ammaiyappan-en-s039-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/scenes/scene-039.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan is talking with his friends while Muthayi watches from a crack in the doorway."},"speaker_label":null,"page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan is talking with his friends. Muthayi stands at a crack in the doorway and watches.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Pazhuthar must win freedom somehow... This thought must take root in the people's hearts... If the feeling of liberation spreads like wildfire, then in a single day we can raise the flag of freedom in Pazhuthar and drive out Vengai country's domination!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழன் 1","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If we are to change the people's minds...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழன் 2","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Thinking alone will not do... we must act...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழன் 3","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes... that is my opinion too...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Wherever the people direct their attention, we must spread our ideas through every such sphere...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"தோழ 2","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!... what anna says is right!...","mode":"prose-faithful","notes":["Exact source label `தோழ 2` and frozen spacing in `அண்ண ாசொல்வது` remain unchanged in provenance."]}},{"id":"ammaiyappan-en-s039-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You go... I will come after attending to the rest...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/scenes/scene-039.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The friends leave; Muthayi enters."},"speaker_label":null,"page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":null},"translation":{"english_text":"[They leave. Muthayi enters.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi...!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes; what is all this?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The beginning of the liberation struggle! They are my comrades... I am gathering an entire force like this so that Pazhuthar may be liberated...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I am afraid...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Foolish girl! Afraid?... Purananuru will laugh at you!...","mode":"prose-faithful","notes":["The source only invokes Purananuru rhetorically; no external poem or passage is imported."]}},{"id":"ammaiyappan-en-s039-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"If you wage a liberation struggle and your life is put in danger...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":83,"printed_page":81}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What else—will they lay a feast for a freedom fighter?... Look here... even this child keeps looking at me... Hey!... if only we had one like this....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s039-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Wait another eight or nine months...","mode":"prose-faithful","notes":["The source statement is translated directly; no explanatory pregnancy prose is added."]}},{"id":"ammaiyappan-en-s039-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s039","archival_scene_ordinal":39,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-039.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-039.md","source_record_id":"ammaiyappan-s039-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah... is that so? You did not tell me...","mode":"prose-faithful","notes":[]}}]}