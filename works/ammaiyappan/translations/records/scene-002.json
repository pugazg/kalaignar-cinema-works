      },
      "translation": {
        "english_text": "Looks as though Maykainatha Swami has had quite a haul.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s002-u003",
      "kind": "dialogue",
      "status": "verified",
