  "archival_scene_ordinal": 5,
  "source_scene_number": null,
  "scene_status": "verified",
  "unit_count": 15,
  "units": [
    {
      "id": "ammaiyappan-en-s005-u001", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s005", "archival_scene_ordinal": 5,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-005.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-005.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 1, "description": "Opening action prose after the decorative star."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 13, "printed_page": 11}]},
      "translation": {"english_text": "A horse is eating horse gram. A boy slowly approaches, glancing around furtively... Then he puts his hand into the feed sack, takes some horse gram and eats it himself... Tirisangu comes there... A blow lands on the boy's head...", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "ammaiyappan-en-s005-u002", "kind": "dialogue", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s005", "archival_scene_ordinal": 5,
      "source": {"source_path": "works/ammaiyappan/dialogues/source-role-resolved-records.json", "canonical_scene_path": "works/ammaiyappan/scenes/scene-005.md", "source_record_id": "ammaiyappan-s005-r001", "source_occurrence_id": null, "source_locator": {"kind": "source-explicit-noncolon-dialogue", "ordinal": 1, "description": "Exact source form begins `திரு;`; the semicolon is evidence and is not normalized."}, "speaker_label": "திரு", "speaker_label_origin": "source-explicit-noncolon-delimiter", "page_provenance": [{"pdf_page": 13, "printed_page": 11}]},
      "translation": {"english_text": "You thieving donkey—who the hell are you! What are you staring at—spit it out... mm... spit!... Will you come here again, eh...", "mode": "prose-faithful", "notes": ["The rough abuse is retained without euphemism. The Tamil evidence remains the exact source form `திரு; ...`, not a normalized colon-labelled record."]}
    },
    {
      "id": "ammaiyappan-en-s005-u003", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s005", "archival_scene_ordinal": 5,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-005.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-005.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 2, "description": "Bracketed action as Muthan arrives during the beating."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 13, "printed_page": 11}]},
      "translation": {"english_text": "[Muthan comes and catches hold.]", "mode": "prose-faithful", "notes": ["The source does not require an English object for `பிடித்துக் கொள்கிறான்`; none is invented."]}
    },
    {"id":"ammaiyappan-en-s005-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"Why... are you hitting him?......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s005-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"So you've come to plead for him, have you... Mutha—what a fine way you look after the horses! Every little thieving brat is coming right inside the palace to steal!","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s005-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"If this hungry boy, unable to bear his hunger, ate a little horse gram—is that theft? In this world, all sorts of people steal all sorts of things...","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s005-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"Right, then. Looks as though you'll divide up the Palayakkarar's property and hand it to the hungry yourself.","mode":"prose-faithful","notes":["`பாளையக்காரர்` is retained as the period title `Palayakkarar` rather than flattened into a generic modern office."]}},
    {"id":"ammaiyappan-en-s005-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"Even if I don't, that time is bound to come. Here, little brother—you run along......","mode":"prose-faithful","notes":[]}},
    {
      "id": "ammaiyappan-en-s005-u009", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s005", "archival_scene_ordinal": 5,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-005.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-005.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 3, "description": "Parenthetical action after Muthan tells the boy to run."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 13, "printed_page": 11}]},
      "translation": {"english_text": "[He takes some horse gram and gives it to him.]", "mode": "prose-faithful", "notes": []}
    },
    {"id":"ammaiyappan-en-s005-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரு","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"Kaveri is such a good woman—and a boy like this had to be born from her belly!......","mode":"prose-faithful","notes":[]}},
    {
      "id": "ammaiyappan-en-s005-u011", "kind": "stage-direction", "status": "verified", "target_language": "en", "scene_id": "ammaiyappan-s005", "archival_scene_ordinal": 5,
      "source": {"source_path": "works/ammaiyappan/scenes/scene-005.md", "canonical_scene_path": "works/ammaiyappan/scenes/scene-005.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-stage-direction", "ordinal": 4, "description": "Parenthetical departure followed by the arrival of a warrior."}, "speaker_label": null, "speaker_label_origin": null, "page_provenance": [{"pdf_page": 13, "printed_page": 11}]},
      "translation": {"english_text": "[He leaves. A warrior enters.]", "mode": "prose-faithful", "notes": []}
    },
    {"id":"ammaiyappan-en-s005-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீர","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":13,"printed_page":11}]},"translation":{"english_text":"Mutha!... Kumar Raja is coming—to learn swordsmanship.......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s005-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"Who's that! Kumar Raja? All right!......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s005-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீர","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"Yes! Prince Sukhadev......","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s005-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s005","archival_scene_ordinal":5,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-005.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-005.md","source_record_id":"ammaiyappan-s005-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":14,"printed_page":12}]},"translation":{"english_text":"Prince, Kumar Raja!... As if he's someone different—he just keeps flinging out new titles...... Hey, at least look at the merit before showering him with titles; what now... is he going to learn swordplay and win freedom for Pazhuthar?...... What a mighty hero of heroes... All right... all right... go... I'm coming.","mode":"prose-faithful","notes":["The exaggerated honorific pile-up and Muthan's sarcasm are preserved rather than normalized into neutral narration."]}}
  ]
}
