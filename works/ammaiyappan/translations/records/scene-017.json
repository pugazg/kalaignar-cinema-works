{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source_scene_number":null,"scene_status":"verified","unit_count":27,"units":[{"id":"ammaiyappan-en-s017-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/scenes/scene-017.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan and his friends are present."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan and his friends are there.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Remember this—today it is me; tomorrow it may be you; this is how we can be struck in the stomach.","mode":"prose-faithful","notes":["The bodily image in `வயிற்றில் அடிக்கப்படலாம்` is preserved rather than reduced to an abstract economic paraphrase."]}},{"id":"ammaiyappan-en-s017-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"நண்பன்","page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What other way is there for this?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":34,"printed_page":32},{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"As long as we are all slaves, there will always be a new authority each day and a petty rule for each man... After making room for the honey, can we still hope for drops of honey?... The man from Vengai Nadu threatens the Pazhuthar Palayakkarar... the Palayakkarar threatens us and vents that anger... the Palayakkarar's son crushes the roses of the house and throws them away, then conducts a king's durbar... Is it wrong for me to question that?... I am a horseman! They are lofty minds atop towers! Hm... slaves a little higher up; that is all!","english_page_segments":[{"pdf_page":34,"printed_page":32,"english_text":"As long as we are all slaves, there will always be a new authority each day and a petty rule for each man..."},{"pdf_page":35,"printed_page":33,"english_text":"After making room for the honey, can we still hope for drops of honey?... The man from Vengai Nadu threatens the Pazhuthar Palayakkarar... the Palayakkarar threatens us and vents that anger... the Palayakkarar's son crushes the roses of the house and throws them away, then conducts a king's durbar... Is it wrong for me to question that?... I am a horseman! They are lofty minds atop towers! Hm... slaves a little higher up; that is all!"}],"mode":"prose-faithful","notes":["The source's political metaphors and class contrast are preserved without modernization."]}},{"id":"ammaiyappan-en-s017-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/scenes/scene-017.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"The friends laugh."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":null},"translation":{"english_text":"[The friends laugh...]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-r001","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":1,"description":"Unlabelled speech after the friends laugh continues Muthan's political address."},"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-context-attributed"},"translation":{"english_text":"Laughter is no use, friends—we must think. We must turn our Pazhuthar, which has become a spider's web, into a splendid flower garden!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/scenes/scene-017.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Vedalam arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":null},"translation":{"english_text":"[Vedalam comes in.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Change it, man; change it!... You can't even pay the rent for this palm-sized place... and you'll turn Pazhuthar into a flower garden!... turn it into a pushpa forest too—Hey!... who are all you fellows, hm?... what work have you got here?... Hm... uff... go... go...","mode":"prose-faithful","notes":["The comic repetition `பூக்காடு / புஷ்பக் காடு` is kept rather than collapsed."]}},{"id":"ammaiyappan-en-s017-u009","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/scenes/scene-017.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":4,"description":"The friends leave."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":null},"translation":{"english_text":"[They leave.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/source-role-resolved-records.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-r002","source_occurrence_id":null,"source_locator":{"kind":"source-context-attributed-dialogue","ordinal":2,"description":"After sending the others away, Vedalam immediately asks Muthan for the rent."},"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-context-attributed"},"translation":{"english_text":"Hey... Mutha! First give me my rent....","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Rent? You're asking at a time like this?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"When else am I to ask?.... When you have money, you give it yourself; when you don't, I have to ask and get it...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I haven't found a single job...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes!.... You won't get one hereafter either... so...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":35,"printed_page":33}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Wait a little.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hey, Mutha! Brainless young man! Is there no way to seek wealth in this world?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"By stealing?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Tch! You're a sturdy fellow... there's good strength in your body...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I could knock Baladevar down with one blow; is that it?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Madman!... That's not what I mean—I mean join the army of the people of Vengaipuram!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What? The army?!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes! The Palayakkarar's authority cannot stop it... the renowned spear... Vel the warrior...","mode":"prose-faithful","notes":["The clipped source wordplay around `வேல்` is preserved without expanding an uncertain intended reference."]}},{"id":"ammaiyappan-en-s017-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough... enough... Me, in the army of the overlord who has enslaved us? Tch! Better to die!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Everyone in town is a fool and you're the only wise man?... Maykkainatha Swamiyar himself is going to campaign for the war...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The Swamiyar! Of course he will. He isn't the one who will die in the fighting... that's why!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-017.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":"ammaiyappan-s017-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough... don't join the army either. I don't want anything. What is it to me? Just somehow pay my rent. Don't make a good man keep asking—I'm going... to hear the sermon.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s017-u027","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s017","archival_scene_ordinal":17,"source":{"source_path":"works/ammaiyappan/scenes/scene-017.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":5,"description":"Vedalam leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":36,"printed_page":34}],"speaker_label_origin":null},"translation":{"english_text":"[He leaves.]","mode":"prose-faithful","notes":[]}}]}