{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s051","archival_scene_ordinal":51,"source_scene_number":null,"scene_status":"verified","unit_count":5,"units":[{"id":"ammaiyappan-en-s051-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s051","archival_scene_ordinal":51,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-051.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-051.md","source_record_id":"ammaiyappan-s051-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":89,"printed_page":87}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I abandoned my beloved in pitch darkness and am crying out. How will I rescue you... my precious beloved! He came in the guise of a holy man and tricked me! Muthayi! Muthayi! How will I rescue you from that brute?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s051-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s051","archival_scene_ordinal":51,"source":{"source_path":"works/ammaiyappan/scenes/scene-051.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-051.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Muthan passes that way."},"speaker_label":null,"page_provenance":[{"pdf_page":89,"printed_page":87}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan passes that way.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s051-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s051","archival_scene_ordinal":51,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-051.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-051.md","source_record_id":"ammaiyappan-s051-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":89,"printed_page":87},{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hey, Mutha! Stop—stop—you came at just the right time! There is no time now to ask where you are, how you are, and all that... Vedalam, dressed as an ascetic, has deceived my dearest beloved Muthayi and is taking her somewhere.","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":89,"printed_page":87,"english_text":"Hey, Mutha! Stop—stop—you came at just the right time! There is no time now to ask where you are—how you are—"},{"pdf_page":90,"printed_page":88,"english_text":"and all that... Vedalam, dressed as an ascetic, has deceived my dearest beloved Muthayi and is taking her somewhere."}]}},{"id":"ammaiyappan-en-s051-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s051","archival_scene_ordinal":51,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-051.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-051.md","source_record_id":"ammaiyappan-s051-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! Where?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s051-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s051","archival_scene_ordinal":51,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-051.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-051.md","source_record_id":"ammaiyappan-s051-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":90,"printed_page":88}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"He must have gone to his rest-house...","mode":"prose-faithful","notes":[]}}]}