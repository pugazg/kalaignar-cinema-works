ish_text":"Muthaa...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s063-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Princess...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s063-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthaa!... The princess is your mother!... The mother who gave birth to you!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s063-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s063-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தா","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes, Aththan! She is your mother!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s063-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"My mother?.... Amma!... How wrongly I thought of you in every way—forgive me, Amma! Forgive me!...","mode":"prose-faithful","notes":["`அம்மா` is retained as `Amma` in the recognition scene to preserve the sudden intimate shift from `Princess` to mother-address."]}},{"id":"ammaiyappan-en-s063-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூங்","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthaa!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s063-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூபதி","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthaa!... Love and motherhood have won!... Now you must win in duty!... Karmaveeran, raised together with tears! You are the commander worthy of fighting for the liberation of the motherland!... Muthayi, you and your husband must labour for the liberation of Pazhuthar... Luxury in the grove, in the breeze! Then—swing the sword to defend your own country!","mode":"prose-faithful","notes":["`கர்ம வீரனே` is retained as `Karmaveeran` rather than assigned a doctrinal gloss unsupported by the immediate source.","The closing imperative preserves the source's turn from private love/family reunion toward Pazhuthar and motherland liberation."]}},{"id":"ammaiyappan-en-s063-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s063","archival_scene_ordinal":63,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-063.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-063.md","source_record_id":"ammaiyappan-s063-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":109,"printed_page":107}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I know, sir!\n\nIn love, in its ripening,\nthe talk is of going to battle!...\nFor husband and wife,\nthe motherland itself is breath!...\n\nDear comrades! Beloved younger brothers!... Everyone, set out!... Let us break Annal's shackles! Let us redeem Pazhuthar! Come! He who has a younger brother fears no army! If this army is defeated, what army can win!... Come! Come!","mode":"semantic-poetic","notes":["The four-line stanza remains inside immutable dialogue record `ammaiyappan-s063-d012`; the closed song/performance inventory authorizes no separate song or literary-verse occurrence in scene 63.","Frozen `அண்ணலின் விலங்கொடிப்ப ோம்` is rendered with `Annal` retained as a transliterated source term because the immediate referent is not secure enough for a stronger English gloss; no Tamil normalization is claimed.","The compact martial saying `தம்பி உடையான்படைக்கஞ்சான்! இப்படை தோற்கின் எப்படை ஜெயிக்கும்!` is translated as printed rhetoric rather than replaced by an external proverb text."]}}]}