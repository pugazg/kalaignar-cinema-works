{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source_scene_number":null,"scene_status":"verified","unit_count":20,"units":[{"id":"ammaiyappan-en-s053-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/scenes/scene-053.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"The commander's corpse is carried away; Sukhadev sees it."},"speaker_label":null,"page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":null},"translation":{"english_text":"[They carry away the commander's corpse. Sukhadev sees it.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":93,"printed_page":91}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/scenes/scene-053.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Muthan is dragged in."},"speaker_label":null,"page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":null},"translation":{"english_text":"[Muthan is dragged in.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hey, Mutha! You killed the commander?... Bravo, bravo... thank you... thank you... Where is Vedalam? Didn't he die?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/scenes/scene-053.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":3,"description":"Sukhadev goes inside."},"speaker_label":null,"page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":null},"translation":{"english_text":"[He goes inside.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah!... Muthayi!... Muthayi!... Open your eyes and look... the warrior Sukhadev has come... Open your eyes and look, Muthayi! Get up...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"[Coming out of her faint.] Are you the grove criminal?","mode":"prose-faithful","notes":["The parenthetical recovery from fainting is printed inside the immutable dialogue record and remains dialogue-owned. `சோலைக் குற்றவாளி` is translated literally from the frozen source phrase."]}},{"id":"ammaiyappan-en-s053-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I am no criminal... that Muthan is the criminal!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ayyo, my god of love! In your hands...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It's nothing... only a water cup, dear... Don't be afraid, dear... get up...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sinner! So you alone have come?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Why are you angry, Muthayi? Is this some lovers' sulking?...","mode":"prose-faithful","notes":["`ஊடல்` is rendered as lovers' sulking/quarrel, preserving the intimate register rather than flattening it to generic anger."]}},{"id":"ammaiyappan-en-s053-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What are you saying now?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What else would I say? About our marriage, of course!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You scoundrel!... You have come to speak a heroic epic to me while I stand at the edge of agony? Is this the lesson they taught you in your palace? Go... get out! Hmm, are you going or not?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Uh-uh... no one is going anywhere... Muthayi, do you know who I am? The son of the future emperor!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":94,"printed_page":92}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"The emperor's son! Hmm... you have no eyes... no human feeling... They say a woman's reproach is terrible. Haven't you read that?...","mode":"prose-faithful","notes":["`பெண் பழி பொல்லாது` is rendered as the source's warning that a woman's reproach/curse is dangerous; no external proverb text is imported."]}},{"id":"ammaiyappan-en-s053-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":95,"printed_page":93}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hmm... why would I read all that... Muthayi, now you simply must marry me... dear Muthayi!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s053-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":95,"printed_page":93}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hmm... I am ready... It is this body you want, isn't it?... You were bewitched by the sheen of my body, weren't you?..... Hmm... feast your eyes on my beauty! Someone said: only the body was soiled; the heart was not. Not so with me... I am ready to lay my chastity at your feet... You donkey charging in lust! Rake my heart with your cruel claws!..... Hmm... don't delay! Plunder my life!... Shatter my resolve to pieces! Representative of fiends who think of women as objects of prostitution!... Why should I hesitate? Here I am ready! My corpse is speaking to you! My dead body calls you! Come... come... deceiver! Here I am—Muthayi—Muthan's wife—your `vellatti`!","mode":"prose-faithful","notes":["The speech's bitterly sarcastic sexual-violence rhetoric is translated without euphemism. Frozen `வெள்ளாட்டி` is retained as `vellatti` because its exact social/sexual nuance is not silently normalized."]}},{"id":"ammaiyappan-en-s053-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s053","archival_scene_ordinal":53,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-053.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-053.md","source_record_id":"ammaiyappan-s053-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":95,"printed_page":93}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"What? You are Muthan's wife?... Muthayi, forgive me!... Listening to your father's words, I became corrupted like this! Trusting household life, I went as far as the boundary of ascetic life! Muthayi! I had carried my love for you toward marriage. Dear sister! I will go right now and save your beloved.","mode":"prose-faithful","notes":["Frozen `திருமணப் பெட்டுக்கு கொண்டிருக்கிறேன்` is irregular; English follows only its immediate marriage-directed sense and does not claim an upstream Tamil repair."]}}]}