{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s034","archival_scene_ordinal":34,"source_scene_number":null,"scene_status":"verified","unit_count":4,"units":[{"id":"ammaiyappan-en-s034-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s034","archival_scene_ordinal":34,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-034.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-034.md","source_record_id":"ammaiyappan-s034-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தன்","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Comrades! Thanapathi is using me as a tool to abduct Muthayi. I will use this opportunity and disappear.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s034-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s034","archival_scene_ordinal":34,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-034.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-034.md","source_record_id":"ammaiyappan-s034-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Then what will become of us, anna?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s034-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s034","archival_scene_ordinal":34,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-034.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-034.md","source_record_id":"ammaiyappan-s034-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"You too, somehow escape from here and come to me. Then all of us together will work for Pazhuthar's liberation. Vāṭṭamā nāṉ?","mode":"prose-faithful","notes":["Frozen source `வாட்டமா நான்?` is retained by transliteration rather than silently repaired or guessed from context."]}},{"id":"ammaiyappan-en-s034-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s034","archival_scene_ordinal":34,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-034.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-034.md","source_record_id":"ammaiyappan-s034-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வீரன்","page_provenance":[{"pdf_page":70,"printed_page":68}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Go carefully, anna! We will somehow come and join you.—We must get out by cunning.","mode":"prose-faithful","notes":[]}}]}