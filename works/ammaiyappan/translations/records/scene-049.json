{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s049","archival_scene_ordinal":49,"source_scene_number":null,"scene_status":"verified","unit_count":3,"units":[{"id":"ammaiyappan-en-s049-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s049","archival_scene_ordinal":49,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-049.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-049.md","source_record_id":"ammaiyappan-s049-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It seems the escaped Muthan too is gathering a liberation force and plotting to free Pazhuthar. Like two mangoes with one stone, we must catch that fellow Muthan as well.","mode":"prose-faithful","notes":["Frozen source spacing in `சேர்த்து க்கொண்டு` is not repaired in the Tamil evidence."]}},{"id":"ammaiyappan-en-s049-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s049","archival_scene_ordinal":49,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-049.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-049.md","source_record_id":"ammaiyappan-s049-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"தள","page_provenance":[{"pdf_page":89,"printed_page":87}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Let that be, Vedalam! Why talk pointlessly to me now about a liberation force when I am wandering in search of where my pleasure lies? First bring that beautiful-bodied woman somehow!","mode":"prose-faithful","notes":["`சுகம்` is kept in its immediate sense of pleasure/comfort; the source's wording can also resonate with the name Sukhadev, but English does not force an identification.","Frozen `வீணுக` is rendered contextually as `pointlessly` without changing the Tamil source."]}},{"id":"ammaiyappan-en-s049-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s049","archival_scene_ordinal":49,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-049.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-049.md","source_record_id":"ammaiyappan-s049-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":89,"printed_page":87}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Wait. I will return victorious.","mode":"prose-faithful","notes":[]}}]}