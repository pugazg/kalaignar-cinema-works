{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source_scene_number":null,"scene_status":"verified","unit_count":19,"units":[{"id":"ammaiyappan-en-s040-u001","kind":"japa","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/songs/inventory.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":"ammaiyappan-song-004","source_locator":{"kind":"japa-performance-cue","ordinal":1,"description":"Young ascetic Sukhadev is in nishta with a `Muthayi` japa when Vedalam enters disguised as an ascetic."},"speaker_label":null,"page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":null},"translation":{"english_text":"[Young ascetic Sukhadev sits in nishta, performing japa of “Muthayi.” Vedalam enters disguised as an ascetic.]","mode":"prose-faithful","notes":["The booklet explicitly marks this as a character japa/performance cue, not a soundtrack song. `japa` and `nishta` are retained as source religious-practice terms; no lyric or authorship is inferred."]}},{"id":"ammaiyappan-en-s040-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதாளம்","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Om Shakti! Chamundi, Mahakali, Parameswari, Renukamba, Sundari, Soundari, Niranthari, Duranthari, O Uma who stands as radiance!.... You remove the suffering of those who behold and worship sukha varttiyinai!... Ambike! Jagadambike! Kali!...","mode":"prose-faithful","notes":["The invocation preserves the printed goddess-name sequence. Frozen `சுக வார்த்தியினைக்` is not silently repaired; `sukha varttiyinai` is retained transliteratively where the source sense is uncertain."]}},{"id":"ammaiyappan-en-s040-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/scenes/scene-040.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Vedalam looks at Sukhadev."},"speaker_label":null,"page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":null},"translation":{"english_text":"[He looks at Sukhadev.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d002","source_occurrence_id":"ammaiyappan-song-004","source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Muthayi... Muthayi...","mode":"prose-faithful","notes":["This labelled spoken japa token is the dialogue-layer span linked to `ammaiyappan-song-004`; the separate japa unit owns only the preceding performance cue."]}},{"id":"ammaiyappan-en-s040-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Young ascetic! First, my greetings...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"White-bearded elder!... The world is false! What do you want?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"In this false world, a true jnani!... What place are you from?... Looking at you, it seems as though you have lost something that captured your heart!...","mode":"prose-faithful","notes":["Frozen `இஞ்ஞானி` is rendered contextually as `jnani` without changing the Tamil evidence."]}},{"id":"ammaiyappan-en-s040-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ha... ha... ha! You are an extraordinary man! How did you see what was in my heart? How did you reveal it? Are you the sage who knows the three times—Devarishi Narada himself?...","mode":"prose-faithful","notes":["The Narada reference is translated only as printed; no external narrative detail is added."]}},{"id":"ammaiyappan-en-s040-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேதா","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Brother!... My eye of wisdom tells me that you are a man defeated in love... Is that true?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes! How do you know?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":84,"printed_page":82}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"For the virtuous, every corner of the world is visible... You are a palace-dweller!... Through the enchantment of a woman, you have become an ashram-dweller! Isn't that so?...","mode":"prose-faithful","notes":["Exact source label `வே` is preserved. `ஆணங்கு` is rendered from the immediate romantic context without altering the Tamil source."]}},{"id":"ammaiyappan-en-s040-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Yes, Swami! They say only those who have escaped the enchantment of women can become ashram-dwellers... I myself have been bound by that enchantment and become a mendicant!...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Nothing surprising... Viswamitra left the palace and came to the ashram... Even there, the trouble from beauties did not leave him... he, a very summit of the greatness of penance... the child Menaka bore...","mode":"prose-faithful","notes":["The Viswamitra–Menaka reference is translated only to the extent printed; the elliptical source wording is not externally completed."]}},{"id":"ammaiyappan-en-s040-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! Most excellent ascetic, rich in ripened experience and abundant devotion! Through you alone I seek the end I desire. Grant me the boon...","mode":"prose-faithful","notes":["Frozen `தன் பயனை` is rendered from the immediate boon-seeking context without an upstream Tamil correction."]}},{"id":"ammaiyappan-en-s040-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I understand! You want to attain that four-letter maiden... that is all, isn't it?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s040-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Mu—th—tha—yi! Ah!... taccu... taccu... You said it exactly right, true guru!... That jewel of a woman's name has only four letters!...","mode":"prose-faithful","notes":["The source's frozen `தச்சு...தச்சு...` is retained as `taccu... taccu...` rather than guessed into a normalized expression; the printed four-letter joke is preserved."]}},{"id":"ammaiyappan-en-s040-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I will arrange your marriage with her... You do not need this guise at such a young age!... Do all that must be done in worldly life first, and in the years when age no longer lets you go on, say ‘Siva, Siva’—that is the proper course for human beings...","mode":"prose-faithful","notes":["Frozen `செய்யவேண்டிய அகமெல்லாம்` is handled from the immediate worldly-life/renunciation contrast without changing the source."]}},{"id":"ammaiyappan-en-s040-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Will I get my Muthayi?... My god who came to me without my seeking!... Just as Narada came between Murugan and Valli, you have come between Muthayi and me—my father blessed with the Lord's divine grace! Praise!... praise!...","mode":"prose-faithful","notes":["The Murugan–Valli–Narada reference is translated only as printed."]}},{"id":"ammaiyappan-en-s040-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s040","archival_scene_ordinal":40,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-040.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-040.md","source_record_id":"ammaiyappan-s040-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":85,"printed_page":83}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"All right, come... let us go to my place... You will have Muthayi soon...","mode":"prose-faithful","notes":[]}}]}