{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source_scene_number":null,"scene_status":"verified","unit_count":10,"units":[{"id":"ammaiyappan-en-s016-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":33,"printed_page":31}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hm... Muthan... from now on he is only a lifeless husk—; not merely in the palace—he will get no work anywhere under the Palayakkarar's authority.","mode":"prose-faithful","notes":["The unusual source punctuation `—;` is not silently normalized."]}},{"id":"ammaiyappan-en-s016-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":33,"printed_page":31}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father! What if he stays in our house until he finds work?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":33,"printed_page":31}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Exactly! I tell you not to play with your food; you say you'll bring that very thing and put it around my neck as a garland. Muthayi! Listen to me. No one would dare walk through a cactus wilderness with his eyes open.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":33,"printed_page":31}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It isn't a cactus wilderness, Father—it's a grove of love.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":33,"printed_page":31},{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Shut your mouth—or I'll close my own ears. Love, love, before Tirittira Narayanan; please, girl, have a little mercy. Ours is a family in debt. And that is not all. I am indebted in duty to the prince too—whenever I needed it he gave me money, and I stretched out my hand and took it—even the other day he gave a little gold for the preliminary wedding expenses.","english_page_segments":[{"pdf_page":33,"printed_page":31,"english_text":"Shut your mouth—or I'll close my own ears. Love, love, before Tirittira Narayanan;"},{"pdf_page":34,"printed_page":32,"english_text":"please, girl, have a little mercy. Ours is a family in debt. And that is not all. I am indebted in duty to the prince too—whenever I needed it he gave me money, and I stretched out my hand and took it—even the other day he gave a little gold for the preliminary wedding expenses."}],"mode":"prose-faithful","notes":["The frozen form `திரித்திர நாராயணனிடம்` is retained as `Tirittira Narayanan` rather than silently repaired."]}},{"id":"ammaiyappan-en-s016-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/scenes/scene-016.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Tirisangu points to the box."},"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":null},"translation":{"english_text":"[Pointing to the box.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father! Must my life be ruined for the sake of wealth? Don't I have the right to choose a man suited to my life, Father?","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"I have chosen a man suited to your life—with mansions and lofty towers. An iron strongbox itself is coming in search of us—and you run after a beggar's bowl.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Father! I was raised in freedom. Don't turn me into a gambler grasping for the Palayakkarar's property, or into collateral used to pay off your debt, Father.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s016-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s016","archival_scene_ordinal":16,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-016.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-016.md","source_record_id":"ammaiyappan-s016-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"திரிசங்கு","page_provenance":[{"pdf_page":34,"printed_page":32}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Enough, Muthayi, enough—I will never consent, while I am alive, to your garlanding that annakkavadi. If you refuse me, your wedding procession can set out only after my funeral procession has gone. Yes! Remember that.","mode":"prose-faithful","notes":["`அன்னக் காவடி` is retained as `annakkavadi`; the source's insult is not replaced with a smoother modern equivalent."]}}]}