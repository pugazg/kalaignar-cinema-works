  "units": [
    {"id":"ammaiyappan-en-s009-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பலதேவர்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"When there are thousands of soldiers, and when a brave commander like you, Velazhagar, is here, whom is the king of Vengai city afraid of that he is increasing the army still further?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s009-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":21,"printed_page":19}]},"translation":{"english_text":"The army is being enlarged not out of fear... but for protection, Baladevar. Siruthaiyuran is waiting for when he can pounce on Vengai city, for whatever pretext will give him a battlefield. That is why our king has ordered us to set about enlarging the army and build a barrier.","mode":"prose-faithful","notes":["The frozen source phrase `தடைகட்டாடென` is rendered by its immediate sentence sense; the Tamil source itself is not corrected or normalized."]}},
    {"id":"ammaiyappan-en-s009-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பலதேவர்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"I am waiting to do whatever I can.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s009-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"You will. But your townspeople may dislike joining the forces on the Vengai side. After all, is he not the king who has made them slaves?","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s009-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பலதேவர்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"That's nothing. I, the first slave, prostrate full-length before him. With all my heart I pray to God that he may live. As you expect, many will join the army. There is no doubt.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s009-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"All right! I must go to your place.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s009-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பலதேவர்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"The Thendral Palace on South Raja Street has been arranged for you.","mode":"prose-faithful","notes":[]}},
    {"id":"ammaiyappan-en-s009-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s009","archival_scene_ordinal":9,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-009.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-009.md","source_record_id":"ammaiyappan-s009-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலழகன்","speaker_label_origin":"source-explicit-colon","page_provenance":[{"pdf_page":22,"printed_page":20}]},"translation":{"english_text":"Excellent.","mode":"prose-faithful","notes":[]}}
  ]
}
