locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":86,"printed_page":84}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Seems what we're searching for itself can't be found. And now this fellow too... Come, swami, let's go.","mode":"prose-faithful","notes":[]}}]}