{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source_scene_number":null,"scene_status":"verified","unit_count":8,"units":[{"id":"ammaiyappan-en-s048-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/scenes/scene-048.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":1,"description":"Sukhadev knocks at the door while Vedalam is inside speaking with the commander."},"speaker_label":null,"page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":null},"translation":{"english_text":"[Sukhadev knocks at the door. Inside, Vedalam is talking with the commander.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s048-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-048.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":"ammaiyappan-s048-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Swami! Swami!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s048-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-048.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":"ammaiyappan-s048-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Wait. My nishta is not over yet.","mode":"prose-faithful","notes":["`நிஷ்டை` is retained as `nishta`, the source's ascetic/meditative term."]}},{"id":"ammaiyappan-en-s048-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-048.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":"ammaiyappan-s048-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Sukhadev has come, Swami! Open the door.","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s048-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-048.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":"ammaiyappan-s048-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வே","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Blind devotee! Wait. I am talking with God—about Muthayi...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s048-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-048.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":"ammaiyappan-s048-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"(To himself) Aha! Is he talking with God? We cannot see Bhagavan ourselves. Sinful soul that I am! At least while the Swami speaks, let me hide and watch!","mode":"prose-faithful","notes":["The source-owned `(தனக்குள்)` cue remains inside the immutable dialogue record."]}},{"id":"ammaiyappan-en-s048-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/scenes/scene-048.md","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-stage-direction","ordinal":2,"description":"Sukhadev opens the window shutter, looks inside and is badly startled."},"speaker_label":null,"page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":null},"translation":{"english_text":"[He opens the window shutter and looks inside. He is badly startled.]","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s048-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s048","archival_scene_ordinal":48,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-048.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-048.md","source_record_id":"ammaiyappan-s048-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சுக","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Ah! Ayyo! The commander!... Vedalam is climbing the drumstick tree again. Appa! Good thing—I escaped... (He runs.)","mode":"prose-faithful","notes":["The source proverb-like image `வேதாளம் மறுபடியும் முருங்க மரம் ஏறுகிறது` is preserved literally rather than replaced by an English idiom.","The printed `(ஓடுகிறான்.)` action remains inside the immutable dialogue record."]}}]}