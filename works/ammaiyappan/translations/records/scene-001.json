        "source_record_id": "ammaiyappan-s001-d013",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "முத்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 6,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "What, is this some land of freedom for us to live in comfort? The man of comfort is right inside this monastery—Maykainatha Swami.",
        "mode": "prose-faithful",
        "notes": [
          "The verified Tamil prints `சுந்திர பூமி`; the English carries the evident freedom/comfort wordplay without altering that Tamil reading.",
          "The second `சுக` image is retained as `man of comfort`, keeping the satirical wordplay before Maykainatha Swami is named."
        ]
      }
    },
    {
      "id": "ammaiyappan-en-s001-u017",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
