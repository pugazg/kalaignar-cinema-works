            "pdf_page": 5,
            "printed_page": 3
          }
        ]
      },
      "translation": {
        "english_text": "Oh!... Mutha! I remember seeing a picture like this somewhere two or three weeks ago!...",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
