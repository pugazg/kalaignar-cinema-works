        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மாய்கை",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 6,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "May Ammaiyappan's grace reach the entire universe... O servants of the servants! O devotees filled with love!....... If you have questions of doubt, ask and gain clarity........",
        "mode": "prose-faithful",
        "notes": [
          "The devotional proclamation and extended pauses are preserved; `அய்ய வினைகள்` is translated by sense as questions of doubt without repairing the Tamil source."
        ]
      }
    },
    {
      "id": "ammaiyappan-en-s001-u018",
