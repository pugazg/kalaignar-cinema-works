          }
        ]
      },
      "translation": {
        "english_text": "Amma...... Appa...... Ammaiyappa.",
        "mode": "prose-faithful",
        "notes": [
          "The Tamil mother/father wordplay is preserved by transliteration; replacing it with a fully English compound would erase the title's sound-play."
        ]
      }
    },
    {
      "id": "ammaiyappan-en-s001-u024",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d021",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுகதேவ்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 6,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "Oh! Then is it my mother and father whose hides you are wearing!",
        "mode": "prose-faithful",
        "notes": [
          "The source's satirical `தோலத் தரிப்பது` image is translated literally rather than doctrinally softened."
        ]
      }
    },
    {
      "id": "ammaiyappan-en-s001-u025",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d022",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மாய்கை",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 6,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "Listen: just as you have an Ammaiyappan, the people of the world too have an Ammaiyappan.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u026",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d023",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுகதேவ்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "Where are they, I wonder?—",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u027",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d024",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மாய்கை",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "They cannot be seen by the eye!—",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u028",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d025",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுகதேவ்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "When we, their children, can be seen by the eye, shouldn't the parents be visible too?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u029",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d026",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மாய்கை",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "Wrong!... Those divine parents cannot be seen—they are formless—possessed of the power to create and destroy all the cosmic spheres... bearers of a thousand names... praised in many an invocatory verse... this world and the next, pleasure and pain... pillar and speck... there... here... shining everywhere... What, Sukhadev... has your confusion ended?...",
        "mode": "prose-faithful",
        "notes": [
          "The source's accumulating devotional catalogue and paired fragments are preserved rather than reorganized into systematic theology.",
          "`பாயிரம்` is rendered as `invocatory verse` for readability while retaining its literary function."
        ]
      }
    },
    {
      "id": "ammaiyappan-en-s001-u030",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d027",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுகதேவ்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "It is only now beginning.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u031",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d028",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "மாய்கை",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "Oh, Ammaiyappa—",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u032",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d029",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "பலதேவர்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "Sukhadev, don't ask mischievous questions like this; trying to trip up holy men in this way is a great sin......",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u033",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d030",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுகதேவ்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 5
          }
        ]
      },
      "translation": {
        "english_text": "No, Father, I only asked because I did not know. I take it back.......",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
