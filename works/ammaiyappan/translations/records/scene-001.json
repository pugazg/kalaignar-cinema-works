        "speaker_label": "முத்",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 5,
            "printed_page": 3
          }
        ]
      },
      "translation": {
        "english_text": "What you are about to see... this picture is my dream of an ideal... the dawn-star of joy... The picture you saw a week or two ago was another copy of this picture—an unfinished drawing...",
        "mode": "prose-faithful",
        "notes": [
          "The source's `லட்சியக் கனவு / இன்ப விடிவெள்ளி` image sequence is preserved rather than compressed into a plain description of the portrait."
        ]
      }
    },
    {
      "id": "ammaiyappan-en-s001-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
      "archival_scene_ordinal": 1,
      "source": {
        "source_path": "works/ammaiyappan/dialogues/records/scene-001.json",
        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d006",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுக",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 5,
            "printed_page": 3
          }
        ]
      },
      "translation": {
        "english_text": "Oh-ho! Was that yours too?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "ammaiyappan-en-s001-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "ammaiyappan-s001",
