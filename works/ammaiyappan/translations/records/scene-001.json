            "pdf_page": 6,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "What, Muthanna, all well?",
        "mode": "prose-faithful",
        "notes": [
          "`முத்தண்ணா` is retained as `Muthanna`; `சுகந்தானா?` is rendered as the colloquial `all well?`."
        ]
