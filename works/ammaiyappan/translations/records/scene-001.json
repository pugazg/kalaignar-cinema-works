        "canonical_scene_path": "works/ammaiyappan/scenes/scene-001.md",
        "source_record_id": "ammaiyappan-s001-d010",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "சுக",
        "speaker_label_origin": "source-explicit-colon",
        "page_provenance": [
          {
            "pdf_page": 6,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "True enough—what people talk about in this world is what does not exist... All right, aren't you coming to the monastery?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
