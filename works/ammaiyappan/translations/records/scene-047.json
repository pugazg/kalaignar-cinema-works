{"work_id":"ammaiyappan","target_language":"en","scene_id":"ammaiyappan-s047","archival_scene_ordinal":47,"source_scene_number":null,"scene_status":"verified","unit_count":5,"units":[{"id":"ammaiyappan-en-s047-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s047","archival_scene_ordinal":47,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-047.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-047.md","source_record_id":"ammaiyappan-s047-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்தாயி","page_provenance":[{"pdf_page":87,"printed_page":85}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"That day, without understanding you, I spoke angrily. Forgive me...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s047-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s047","archival_scene_ordinal":47,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-047.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-047.md","source_record_id":"ammaiyappan-s047-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சும","page_provenance":[{"pdf_page":87,"printed_page":85}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Let us forget all that!","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s047-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s047","archival_scene_ordinal":47,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-047.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-047.md","source_record_id":"ammaiyappan-s047-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"After your marriage, where did all your mischievous talk run off and hide?...","mode":"prose-faithful","notes":[]}},{"id":"ammaiyappan-en-s047-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s047","archival_scene_ordinal":47,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-047.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-047.md","source_record_id":"ammaiyappan-s047-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சும","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"It has not hidden anywhere... Let him regain his health... then listen to me talk! Muthayi, you call my speech kurumbu—mischief; do you know what he calls it?... karumbu—sugarcane!","mode":"prose-faithful","notes":["The source wordplay `குறும்பு` / `கரும்பு` is retained through transliteration plus gloss because the sound contrast carries the joke."]}},{"id":"ammaiyappan-en-s047-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"ammaiyappan-s047","archival_scene_ordinal":47,"source":{"source_path":"works/ammaiyappan/dialogues/records/scene-047.json","canonical_scene_path":"works/ammaiyappan/scenes/scene-047.md","source_record_id":"ammaiyappan-s047-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"முத்","page_provenance":[{"pdf_page":88,"printed_page":86}],"speaker_label_origin":"source-explicit-colon"},"translation":{"english_text":"Hmm, all right, all right... do not keep talking only about your man... pay a little attention to mine too...","mode":"prose-faithful","notes":["Frozen source wording `என்னுடைய வரையும்` is rendered from the immediate contrast without altering the Tamil evidence."]}}]}