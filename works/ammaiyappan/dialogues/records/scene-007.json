[
  {
    "id": "ammaiyappan-s007-d001",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "என் அழகைக் காண இந்தக் கண்ணாடி போதாதே ஹா-ம்---திரிசங்கு: எனக்கா ஓலை?"
  },
  {
    "id": "ammaiyappan-s007-d002",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "இல்ல ைதம்பி. எனக்குத்தான்."
  },
  {
    "id": "ammaiyappan-s007-d003",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "யாரிடமிருந்து?"
  },
  {
    "id": "ammaiyappan-s007-d004",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "அவன் ஒரு வேலையற்றவன். பொழுது விடிந்தால் என் உயிரை வாங்குவதே அவனுக்கு வேலை."
  },
  {
    "id": "ammaiyappan-s007-d005",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "உயிரை வாங்குறானா? யாரப்பா அந்த எமன்?"
  },
  {
    "id": "ammaiyappan-s007-d006",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "அதை என் தம்பி கேட்டறிங்க. எனக்கு ஒரு மருமகப் பயல் இருக்கிறான். அவனுக்குப் பெண் வேண்டுமாம்."
  },
  {
    "id": "ammaiyappan-s007-d007",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "ஏன்? பிறப்ப தெல்லாம் ஆணாகப் பிறக்கிறதோ?"
  },
  {
    "id": "ammaiyappan-s007-d008",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "இல்ல ைதம்பி இல்லை. கல்யாணத்துக்குப் பெண் வேண்டுமாம்."
  },
  {
    "id": "ammaiyappan-s007-d009",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "கல்யாணத்துக்குப் பெண்ணுதான் வேணும். வேறே என்ன வேணும்; அதுதானே திருமணத்துக்கு மூலப் பொருள்."
  },
  {
    "id": "ammaiyappan-s007-d010",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "தம்பி! மாம் பழத்தால் வெளவால்களே வா என்று அழைக்கிறது."
  },
  {
    "id": "ammaiyappan-s007-d011",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "ஆமாம்! ஆமாம்! பழுத்த மாம்பழமும், பாழடைந்த மண்டபமும் வெளவாலே வா என்று அழைப்பதில்லை. சரி அதுபோல......"
  },
  {
    "id": "ammaiyappan-s007-d012",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "என் மகள் பருவமடைந்து விட்டாள். பயல்கள் வில் வீசுகிறார்கள், அதற்குத்தான் ஓலை எழுதி இருக்கிறேன் இந்த உதவாக்கரை. என் மகளின் அழகென்ன, குணமென்ன—அத்தான் முறைக்காக மட்டும் இந்தப் பயல் உரிமை கொண்டாடி விட முடியுமா தம்பி."
  },
  {
    "id": "ammaiyappan-s007-d013",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "ஓஹோ! அவ்வளவு அழகா உன் மகள்—"
  },
  {
    "id": "ammaiyappan-s007-d014",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "நீங்கள் பார்த்ததே இல்லையா?"
  },
  {
    "id": "ammaiyappan-s007-d015",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "இல்லையே உன் மகளின் பெயரென்ன?"
  },
  {
    "id": "ammaiyappan-s007-d016",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "முத்தாயி — முத்தாயி என்றால் முத்தாயிதான்."
  },
  {
    "id": "ammaiyappan-s007-d017",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "உம்—காக்கைக்கும் தன் குஞ்சு பொன் குஞ்சுதானே."
  },
  {
    "id": "ammaiyappan-s007-d018",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "இல்ல ைதம்பி. இது காக்கை அடை காத்த குயிலின் குஞ்சு."
  },
  {
    "id": "ammaiyappan-s007-d019",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "திரிசங்கு! வாயேன் உன் வீட்டுக்குப் போகலாம்."
  },
  {
    "id": "ammaiyappan-s007-d020",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "விளையாடாதீங்க—அரண்மனைக் காவல்காரன் வீட்டுக்கு இளவரசர் வருவதாவது ... வேடிக்கை வேடிக்கை."
  },
  {
    "id": "ammaiyappan-s007-d021",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "என்னிடத்திலே அந்த உயர்வு, தாழ்வு இல்லையென்பது உனக்குத் தெரியாதாக்கும். நீ என் தங்கைக்குத்தான் வேலைக்காரன். எனக்கு ஒரு வயதான தோழன். சரிதானா?"
  },
  {
    "id": "ammaiyappan-s007-d022",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "நான் பாக்கியசாலி."
  },
  {
    "id": "ammaiyappan-s007-d023",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 15
      }
    ],
    "text": "வா போவோம்."
  },
  {
    "id": "ammaiyappan-s007-d024",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "முத்தாயி! போகலாமா?"
  },
  {
    "id": "ammaiyappan-s007-d025",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "என்ன சுமதி! கண்ணை மூடிக்கொண்டாய்?"
  },
  {
    "id": "ammaiyappan-s007-d026",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "கார்யமாகத்தான். நேரமாகிறது. வா போகலாம்"
  },
  {
    "id": "ammaiyappan-s007-d027",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "போய் வாட்டுமா?"
  },
  {
    "id": "ammaiyappan-s007-d028",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "அந்த உத்திரவுமட்டும் அங்கே கிடைக்காது."
  },
  {
    "id": "ammaiyappan-s007-d029",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "ஏது உன் தோழி பெரிய கைக்காரிதான் போலிருக்கு."
  },
  {
    "id": "ammaiyappan-s007-d030",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "கைக்காரி மட்டுமல்ல—கால்காரி—கழுத்துக்காரி—தலைக்காரி."
  },
  {
    "id": "ammaiyappan-s007-d031",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 16
      }
    ],
    "text": "போதும்! போதும்! நீ வேறு காரி காரி முகத்திலே துப்பாதே."
  },
  {
    "id": "ammaiyappan-s007-d032",
    "archive_scene_id": "ammaiyappan-s007",
    "archive_scene_ordinal": 7,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் அறை.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-007.md",
    "page_provenance": [
      {
