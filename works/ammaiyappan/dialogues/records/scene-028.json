[
  {
    "id": "ammaiyappan-s028-d001",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 57
      }
    ],
    "text": "யார்? எங்கே வந்தாய்?"
  },
  {
    "id": "ammaiyappan-s028-d002",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 57
      }
    ],
    "text": "முத்தாயி!"
  },
  {
    "id": "ammaiyappan-s028-d003",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 57
      }
    ],
    "text": "பாவி! வேண்டுமென்று கேட்டிருந்தால் நூறு என்ன, ஐநூறு பொன் எப்படியாவது தேடித் தந்திருப்பேனே......"
  },
  {
    "id": "ammaiyappan-s028-d004",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "சும",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 57
      }
    ],
    "text": "என்ன—நீ என்ன சொல்லுகிறாய்?"
  },
  {
    "id": "ammaiyappan-s028-d005",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 57
      }
    ],
    "text": "இன்னும் புரியும்படியாக சொல்லவேண்டுமா? நன்றாக நடிக்கிறாய், நாடகக்காரி! கேவலம் நூறு பொன்னுக்கு ஆசைப்பட்டு கூறு போட்டு விட்டாயே எங்கள் காதல்!"
  },
  {
    "id": "ammaiyappan-s028-d006",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "சும",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 59,
        "printed_page": 57
      }
    ],
    "text": "பொன்னுக்கு ஆசைப்பட்டேனா? நானா? முத்தாயி! சொல்வதைக் கேள்...நீ கூறியபடி முத்தனை அஞ்சல் மனையில் போய் தேடினேன். கிடைக்கவில்லை."
  },
  {
    "id": "ammaiyappan-s028-d007",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "கிடைக்கவில்லை-கிடைத்ததை வாயில் போட்டுக் கொண்டாய்."
  },
  {
    "id": "ammaiyappan-s028-d008",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "சும",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "என்னையும் கொஞ்சம் பேசவிடேன்......."
  },
  {
    "id": "ammaiyappan-s028-d009",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "பேசியது போதும். பேசியும் பலனில்ல. போ...போய்விடு...உம்...போய்விடு பாவி...போ......"
  },
  {
    "id": "ammaiyappan-s028-d010",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "சும",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "இப்போது என்னை உணராவிட்டாலும், எப்போதாவது உணராமலா இருக்கப் போகிறாய்? நான் வருகிறேன்."
  },
  {
    "id": "ammaiyappan-s028-d011",
    "archive_scene_id": "ammaiyappan-s028",
    "archive_scene_ordinal": 28,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீடு",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-028.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "வரவே வேண்டாம்—வஞ்சகி!"
  }
]
