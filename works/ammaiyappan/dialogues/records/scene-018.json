[
  {
    "id": "ammaiyappan-s018-d001",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை நாதர்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 35
      }
    ],
    "text": "அன்பர்களே! இதுவரை தனபதி\nவேலழகர் படையின் பயன்கள் பற்றி அறியதோர் உரை\nநிகழ்த்தினார். நானும் அதைத்தான் சொல்லப்போகிறேன்.\nபகவான் பரந்தாமனே பார்த்திபனை பாரதப் போரில்\nகலந்து கொள்ளச் சொல்லியிருக்கிறார். போர்கூடாது, அது\nஒரு வெறிநெறெல்லாம் போதனை செய்கிறார்களே இன்று,\nஅவர்கள் பகவத் கீதையைப் படிக்கட்டும். போரின் அவ\nசியம் பற்றி அந்தப் புல்லாங்குழலூதி எவ்வளவு கூறியிருக்\nகிறார் என்பது புலனாகும். சிவன் கை சூலமும், சிவ குமார\nனின் வேலும், விஷ்ணுவின் சக்கரமும் எதைக் குறிக்\nகின்றன? சமாதானத்தையா? சமரையா? ஆகவே, அன்பர்\nகளே! எல்லோரும் போர் வீரர்களாக மாறுங்கள்...சாவுக்\nகுப் பயப்படாதீர்கள். வாள் பிடிப்பதால் மட்டுமல்ல;\nவாழைப் பழத்தோல் சறுக்கி விழுந்து வாழ்வு முடிந்தோர்\nபலருண்டு; வீரனுக்கு மண்ணில் மட்டுமல்ல விண்ணிலும்\nபுகழ்தான். வளாந்து போன தோள்களிலே வாகைமாலை\nஏந்துங்கள். அதற்காகக் கைகளில் வாளேந்துங்கள். தெய்\nவமே துணையென திண் தோள் தட்டிக் கிளம்புங்கள்...\nஅம்மையப்பா! அறநெறி வாழ்க!..."
  },
  {
    "id": "ammaiyappan-s018-d002",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மக்கள்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 35
      }
    ],
    "text": "அம்மையப்பா! அம்மையப்பா!"
  },
  {
    "id": "ammaiyappan-s018-d003",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "தனபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 35
      }
    ],
    "text": "மிகவும் நன்றி செலுத்துகிறேன்."
  },
  {
    "id": "ammaiyappan-s018-d004",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 35
      }
    ],
    "text": "கடமையைச் செய்தேன்."
  },
  {
    "id": "ammaiyappan-s018-d005",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "தனபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 35
      }
    ],
    "text": "தங்களைப் போன்ற மடாதிபர்கள் நாட்டுத்\nதொண்டு செய்யக் கிளம்பி விட்டால் இரண்டு உலகு\nவெளிச்ச மடைந்துவிடும். பின்னர் சந்திக்கிறேன். வரு\nகிறேன்."
  },
  {
    "id": "ammaiyappan-s018-d006",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 37,
        "printed_page": 35
      }
    ],
    "text": "அம்மையப்பா! அருள் நெறிவாழ்க."
  },
  {
    "id": "ammaiyappan-s018-d007",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை நாதர்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "என்ன பூபதி! நீ இன்னும் போக\nவில்லையா?"
  },
  {
    "id": "ammaiyappan-s018-d008",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "என்னையே நான் மறந்து விட்டேன், சாமி\nயாரே! உமது சொற்பொழிவில் உள்ளத்தையே தொலைத்து\nவிட்டேன். ஹி...ஹி...ஹி...வாளையும், வேலையும்\nதொடாதே—வைகுந்தவாசனை தொழு...கையிலே கேட\nயம் ஏந்தாதே—கைலாச நாதனின் திருநீறு ஏந்து...அது\nஎங்கே இப்போது? வளைந்து போன தோள்களிலே வாகை\nமாலை ஏந்துங்கள்...அதற்காகக் கைகளிலே வேலேந்துங்\nகள்...இது எங்கே? எல்லாம் மாயை...மாயாஜாலம்...இல்\nலையா சாமியாரே?"
  },
  {
    "id": "ammaiyappan-s018-d009",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை நாதர்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "பூபதி! போதும், போய்வாரும்."
  },
  {
    "id": "ammaiyappan-s018-d010",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "புகழ்கிறேன் சாமியாரே, புகழ்கிறேன்!\nஆகாகா! ஆண்டவனே! உன்னை எது எதற்கெல்லாந்தான்\nபயன்படுத்துகிறார்கள். உலகத்திலே தோன்றும் மாகான்\nகள் எல்லாம், உன் அவதார மென்கிறார்கள். பரமாத்மாவாக\nஅவதரித்து அர்ச்சுனனை போர் புரியச் சொன்னாயாம். பிறகு\nபகவான் புத்தராகவும் நீயே அவதரித்து போர் புரிவது தீது\nஎன்று அசோகனுக்கு நல்வழி காட்டினாயாம். உன்னையே\nஇப்படி முரண்படுத்தி இருக்கும்போது இந்தச் சாமியார்\nஎம்மாத்திரம்?"
  },
  {
    "id": "ammaiyappan-s018-d011",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை நாதர்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "பூபதி! சாது மிரண்டால் காடு\nகொள்ளாது பூபதி!"
  },
  {
    "id": "ammaiyappan-s018-d012",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "மிரள்வது சாது அல்ல...சூது, வாது, தீது\nஇவைகள் தான் மிரள்கின்றன."
  },
  {
    "id": "ammaiyappan-s018-d013",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை நாதர்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "நமக்குள் என்னப்பா வம்பு...."
  },
  {
    "id": "ammaiyappan-s018-d014",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "நமக்குள் என்ன, அந்த ரகசியத்தைச்\nசொல்லி விடுமே."
  },
  {
    "id": "ammaiyappan-s018-d015",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "மாய்க்கை நாதர்",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 38,
        "printed_page": 36
      }
    ],
    "text": "பூபதி: உம்மைக் கும்பிடுகிறேன்.\nபோய்விடும். அந்த ரகசியத்தை மட்டும் கேட்காதீர்!"
  },
  {
    "id": "ammaiyappan-s018-d016",
    "archive_scene_id": "ammaiyappan-s018",
    "archive_scene_ordinal": 18,
    "source_scene_number": null,
    "source_heading": "மடாலயம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-018.md",
    "page_provenance": [
      {
        "pdf_page": 39,
        "printed_page": 37
      }
    ],
    "text": "சாமியாரே! போகிறேன். சாமியாரே!\nஒன்றுமட்டும் நினைவிருக்கட்டும். பொய் கொஞ்சம்\nகொஞ்சமாகப் போதாகி மலரும்...ஆனால் உண்மை\nதிடீரென்று வெடித்துவிடும்...ஹா...ஹா...ஹா...வருகிறேன்."
  }
]
