[
  {
    "id": "ammaiyappan-s035-d001",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "என்னப்பா யாருமே காணவில்லை? எங்கேயப்பா அவர்?..."
  },
  {
    "id": "ammaiyappan-s035-d002",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "அடடடா! அதற்குள் அவசரமா? இலை போட்ட பிறகு சோறு போடாமலா இருந்து விடுவார்கள்? வாம்மா வா......"
  },
  {
    "id": "ammaiyappan-s035-d003",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "ஆமாம் ...திருமணத்திற்கான ஏற்பாடுகள் எல்லாம்..."
  },
  {
    "id": "ammaiyappan-s035-d004",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "மேளதாள மில்லையே; பந்தல் இல்லையே; பந்தி இல்லையே; என்று பார்க்கிறாயா?...இது பெண் வீடுதான். முகூர்த்தம் நடைபெறுகிற இடம் வேறிடம். அதுவுமில்லாமல்...இந்தத் திருமணம் சுகதேவுக்குத் தெரியாமல் நடைபெற வேண்டுமே..."
  },
  {
    "id": "ammaiyappan-s035-d005",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "ஆமாம்....ஆமாம்...அந்த சுகதேவ..."
  },
  {
    "id": "ammaiyappan-s035-d006",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "அப்பா...என்ன உளறுகிறீர்கள்...!"
  },
  {
    "id": "ammaiyappan-s035-d007",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "என்ன?...என்ன?..."
  },
  {
    "id": "ammaiyappan-s035-d008",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "ஒன்றுமில்ல ை...ஒன்றுமில்ல ை...உங்களைப் பார்த்த அதிர்ச்சியில் மயக்கம் வந்துவிட்டது...சந்தோஷத்தால் இருதயம் படபடக்குமல்லவா...தம்பி...?"
  },
  {
    "id": "ammaiyappan-s035-d009",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "ஆமாம்!...ஆமாம்! எனக்குக்கூட இப்போது அப்படித்தான் அடித்துக்கொள்கிறது..."
  },
  {
    "id": "ammaiyappan-s035-d010",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "சரி; நீங்கள் மேலே போங்கள். நான் பிறகு வருகிறேன்."
  },
  {
    "id": "ammaiyappan-s035-d011",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "முத்தாயி! இவைகளேப் பார்...முத்தும், பவளமும், ரத்தினமும், வைரமும் பதித்திட்ட ஆபரணங்கள்! பளபளக்கும் பட்டாடை!...ஜொலிக்கும் வைரம்! மதிப்பு வாய்ந்த ரத்தினம்! ஆஹா...ஹா...இவைகள் எல்லாம்...."
  },
  {
    "id": "ammaiyappan-s035-d012",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "உங்கள் மனத்திற்கு தாப்படும் விலை! உங்கள் மகள் மீது வீசப்படும் வலை!..."
  },
  {
    "id": "ammaiyappan-s035-d013",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      }
    ],
    "text": "சொல்வதைக் கேள்..."
  },
  {
    "id": "ammaiyappan-s035-d014",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 71,
        "printed_page": 69
      },
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "எதுவும் சொல்லவேண்டாம். எல்லாம் விளங்கி விட்டது. சிப்பியே முத்தைக் கொண்டு வந்து சேற்றில்\nபோடுகிறது!...செந்தாமரைக் கொடியே இதழ்களின் உதிர்த்து எருமைக்குத் தருகிறது! அப்பா உங்கள் மகளிடமா இப்படி சூழ்ச்சி செய்வது!...",
    "page_segments": [
      {
        "pdf_page": 71,
        "printed_page": 69,
        "text": "எதுவும் சொல்லவேண்டாம். எல்லாம் விளங்கி விட்டது. சிப்பியே முத்தைக் கொண்டு வந்து சேற்றில்"
      },
      {
        "pdf_page": 72,
        "printed_page": 70,
        "text": "போடுகிறது!...செந்தாமரைக் கொடியே இதழ்களின் உதிர்த்து எருமைக்குத் தருகிறது! அப்பா உங்கள் மகளிடமா இப்படி சூழ்ச்சி செய்வது!..."
      }
    ]
  },
  {
    "id": "ammaiyappan-s035-d015",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "மகள்!...மகளா இருந்தால் ஒரு தகப்பனுடைய மனதை இப்படி எரியவிடுவாளா? நீ மகளா இருந்தால்—ஒரு வயதான தகப்பன்—வாஞ்சையுள்ள தகப்பன்—வறுமையிலே பலநாள் கஷ்டப்பட்டவன்—இப்போது வாழ்ந்து பார்க்கலாம் என நினைக்கிறேனே, அதற்கு துணைபுரிவோமென்று எண்ணமாட்டாயா?...நான் வாழ்வதற்காக உன்னையென்ன தீயிலா குதிக்கச் சொல்கிறேன்? பெரிய தியாகமா பண்ணச் சொல்கிறேன்?....தேடக் கிடக்காத இடம்...அந்த இடத்து தெய்வமாக வைத்துப் போற்றுகிறேன் என்கிறான்...நீ தேம்புகிறாய்; விம்முகிறாய்; புலம்புகிறாய்; புத்தியற்றவளே! எத்தனையோ ஆசைகள் உனக்கு நான் நிறைவேற்றித் தந்திருக்கிறேன், நீ எனது முதலும் கடைசியுமான இந்த ஆசையை பூர்த்தி செய்யக் கூடாதா?...."
  },
  {
    "id": "ammaiyappan-s035-d016",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "பல முறை உனக்கு நான் இளநீர் வழங்கி இருக்கிறேன்; ஒரு முறை உன் தலையில் விழுகிறேன் என்று தென்னைமரம் சொல்வதற்கும், நீங்கள் சொல்வதற்கும் என்னப்பா வித்தியாசம்?..."
  },
  {
    "id": "ammaiyappan-s035-d017",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "சீ, அதிகப்பிரசங்கி! அடங்கிக்கிட! காலையிலே உனக்கும் இளவரசருக்கும் திருமணம்!...தயாராகிக் கொள் அதற்கு..."
  },
  {
    "id": "ammaiyappan-s035-d018",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "வாருங்கள்...நல்ல சமயத்தில் வந்தீர்கள்..."
  },
  {
    "id": "ammaiyappan-s035-d019",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "என்ன திரிசங்கு? எப்படி எனது ஏற்பாடுகள் எல்லாம்......"
  },
  {
    "id": "ammaiyappan-s035-d020",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "ஏற்பாடுகள் எல்லாம் சரி! ஒரே ஒரு குறை தான்"
  },
  {
    "id": "ammaiyappan-s035-d021",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "என்ன அது?"
  },
  {
    "id": "ammaiyappan-s035-d022",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 72,
        "printed_page": 70
      }
    ],
    "text": "சுகதேவை மணந்திட முத்தாயி மறுக்கிறாள்..."
  },
  {
    "id": "ammaiyappan-s035-d023",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "சரிதான் போ! சாப்பாடு தயார்; சோறு தான் இல்ல ைஎன்பது போல் இருக்கிறதே! என்னப்பா...இருவருமே ஒன்றுபட்ட காதலர்கள் என்றீர்களே முன்பு..."
  },
  {
    "id": "ammaiyappan-s035-d024",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "முத்தாயி ஒரு முட்டுப்பெண். அவள் பிடிவாதத்தை என்னால் மாற்ற முடியவில்லை...நீங்கள் தான் எப்படியாவது..."
  },
  {
    "id": "ammaiyappan-s035-d025",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "உம்...முயற்சிக்கிறேன்...இப்போது அவள் எங்கே இருக்கிறாள்?"
  },
  {
    "id": "ammaiyappan-s035-d026",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "உள்ளேதான் இருக்கிறாள்."
  },
  {
    "id": "ammaiyappan-s035-d027",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "சரி நீங்கள் யாரும் வாருங்கள்; நான் அவளோடு சரி செய்கிறேன்!..."
  },
  {
    "id": "ammaiyappan-s035-d028",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "முட்டாள் பெண்ணே! எழுந்திரு! ஏன் இப்படி உட்கார்ந்திருக்கிறாய்?...பேசமாட்டாயா?...ம்...தகப்பன் இது தான் நேரம் போவிருக்கிறது...கடல் குமுறிக் கொண்டிருக்கிறது...நீ என்னமோ கட்டுமரத்தில் இருந்து ஒப்பாரி பாடிக்கொண்டிருக்கிறாய்!...ஆ! வேண்டியதைப் பார், அன்புள்ள சிறுமியே! அழுவதால் ஆபத்தை தடுத்து விட முடியாது......ஏன் அழுகிறாய்?"
  },
  {
    "id": "ammaiyappan-s035-d029",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "ஊர் சிரிக்கிறது; நான் அழுகிறேன்..."
  },
  {
    "id": "ammaiyappan-s035-d030",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "உண்மை தான். ஆனாலும் கொழுந்து மனம் படைத்த கோதையே! கொந்தளிப்பிலிருந்து மீள்வதற்கு இன்னும் வாய்ப்பு இருக்கிற தென்பதை உணருவாய்..."
  },
  {
    "id": "ammaiyappan-s035-d031",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "மீள்வதற்கு வாய்ப்பா!..."
  },
  {
    "id": "ammaiyappan-s035-d032",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "ஆமாம்...வாய்ப்புத்தான்...உன் விடுதலை தான்...வேதனை விலகுகிறது என்ற அறிகுறிதான், வேதாளத்தின் வடிவத்திலே வந்திருக்கிறது..."
  },
  {
    "id": "ammaiyappan-s035-d033",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      }
    ],
    "text": "என்ன சொல்கிறீர்கள்?...."
  },
  {
    "id": "ammaiyappan-s035-d034",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 73,
        "printed_page": 71
      },
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "முத்தனும் நானும் எவ்வளவு நேசமுடன் பழகினோம் என்பது உனக்குத் தெரியாது...நீ கொடுத்த பொண்ணு சுமதி வாயில் போட்டுக் கொண்டு விட்டாள்...முத்தன் பாசறைச் சிறையில் அடைக்கப்பட்டு விட்டான்...நான் வெகு நாளாக அரும்பாடுபட்டு சேமித்து வைத்\nதிருந்த திரவியத்தை கொடுத்து இப்போது அவனை மீட்டு விட்டேன்.",
    "page_segments": [
      {
        "pdf_page": 73,
        "printed_page": 71,
        "text": "முத்தனும் நானும் எவ்வளவு நேசமுடன் பழகினோம் என்பது உனக்குத் தெரியாது...நீ கொடுத்த பொண்ணு சுமதி வாயில் போட்டுக் கொண்டு விட்டாள்...முத்தன் பாசறைச் சிறையில் அடைக்கப்பட்டு விட்டான்...நான் வெகு நாளாக அரும்பாடுபட்டு சேமித்து வைத்"
      },
      {
        "pdf_page": 74,
        "printed_page": 72,
        "text": "திருந்த திரவியத்தை கொடுத்து இப்போது அவனை மீட்டு விட்டேன்."
      }
    ]
  },
  {
    "id": "ammaiyappan-s035-d035",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "ஆ!...என் முத்தன் விடுதலை யடைந்து விட்டாரா?"
  },
  {
    "id": "ammaiyappan-s035-d036",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "அய்யோ! பரிதாபத்துக்குரிய பாவையே!...இன்னும்கேள் இன்பச் சேதியை. உன் தகப்பன் கொடியவன்; உன்னை ஏமாற்றி இந்தத் திருமணத்தை ஏற்பாடு செய்தான் என்பது எனக்குத் தெரிந்து...உடனே ஓடிவந்தேன், உன்னைக் காப்பாற்ற!...கலியாண விருந்தினன்போல் வந்து என் நண்பனின் காதலியை விடுவிக்க நான் முயலுகிறேன்."
  },
  {
    "id": "ammaiyappan-s035-d037",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "அய்யா! நீங்கள் பல்லாண்டு வாழ்க!"
  },
  {
    "id": "ammaiyappan-s035-d038",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "இந்த அக்கிரம உலகத்தில் என்னம்மா ஆயுள் நீடிக்க வேண்டும்? அது கிடக்கட்டும்...இதைக் கேள், இளஞ் சிட்டே!...இன்றிரவே முத்தன் இங்கு வருவான்; நீ அவனுடன் புறப்பட்டு வந்துவிடு."
  },
  {
    "id": "ammaiyappan-s035-d039",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "அவர் வருவாரா?..."
  },
  {
    "id": "ammaiyappan-s035-d040",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "வராமல் இருப்பானா?...ஜாக்கிரதை, நீங்கள் இருவரும்!"
  },
  {
    "id": "ammaiyappan-s035-d041",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "அத்தான்! நீங்கள் வருவீர்கள் என்று வேதாளம் சொன்னார்."
  },
  {
    "id": "ammaiyappan-s035-d042",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "வேதாளம்! விஷப்பாம்பு அவன்! முத்தாயி, எப்படியாவது சுகதேவனை நீ இங்கே வரும்படி செய்ய வேண்டும்."
  },
  {
    "id": "ammaiyappan-s035-d043",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "சுகதேவனா? ஏன்?"
  },
  {
    "id": "ammaiyappan-s035-d044",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 74,
        "printed_page": 72
      }
    ],
    "text": "ஏன் தெரியுமா? நாம் இப்போது வெளியேறுவது என்பதென்றால் சாதாரணமல்ல, நம்மைச்சுற்றி ஆபத்து காத்திருக்கிறது!"
  },
  {
    "id": "ammaiyappan-s035-d045",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "முத்தாயி! இன்னும் தூங்கவில்லை?..."
  },
  {
    "id": "ammaiyappan-s035-d046",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "தூக்கம் வரவில்லையப்பா!... யோசனையில் ஆழ்ந்திருக்கிறேன்."
  },
  {
    "id": "ammaiyappan-s035-d047",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "என்னம்மா யோசனை?..."
  },
  {
    "id": "ammaiyappan-s035-d048",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "அந்த வேதாளம் வந்து எனக்கு அறிவு புகட்டிவிட்டார்...இத்தனை நாளும் புத்திகெட்டுப் போய் அந்த முத்தனை நம்பி இருந்தேன்..."
  },
  {
    "id": "ammaiyappan-s035-d049",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "மகளே! நீதான் பேசுகிறாயா?...ஆகா! வேதாளம் சொன்னது சரிதான்...முத்தாயி உன்னைப் பெற்ற பயன் இப்போதே அடைந்தேன்..."
  },
  {
    "id": "ammaiyappan-s035-d050",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "அப்பா ஒரு உதவி செய்வீர்களா?..."
  },
  {
    "id": "ammaiyappan-s035-d051",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "ஆயிரம் செய்வேன், சொல்லு!"
  },
  {
    "id": "ammaiyappan-s035-d052",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "காலையில் எனக்கும் சுகதேவருக்கும் திருமணம், இப்போது நான் அவரை சந்தித்து சில விஷயங்கள் பேசவேண்டும்! அவரைப் பார்க்க வேண்டும் என்று மனமும் துடிக்கிறது..."
  },
  {
    "id": "ammaiyappan-s035-d053",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "என் ஆசை மகளே!...இதுவா பிரமாதம்? இப்போதே அனுப்புகிறேன்..."
  },
  {
    "id": "ammaiyappan-s035-d054",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "ஆகா! என் காதல் தேவி! இதோ வருகிறேன். நெருப்பும் பஞ்சும் நெருங்கி இருந்தால் சும்மா இருக்குமா? மாமா! நீர் போய் நன்றாகத் தூங்கலாம்—நான் இன்று முத்தாயியைத் தூங்கவிடப் போவதில்லை—பேசிக்கொண்டே இருக்கப் போகிறேன்!..."
  },
  {
    "id": "ammaiyappan-s035-d055",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "கண்ணே! என்னை ஏன் அழைத்தாய்? அடடா! பேசமாட்டாயா? இவ்வளவு வெட்கமா உனக்கு?..."
  },
  {
    "id": "ammaiyappan-s035-d056",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "ஒரு சேதி பேசவேண்டும்."
  },
  {
    "id": "ammaiyappan-s035-d057",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 75,
        "printed_page": 73
      }
    ],
    "text": "சேதியா? காதலன்—காதலி—கட்டிலறை சிற்றின்பக் கூடாரமே தவிர சேதி பேசும் இடமல்ல கண்ணே!..."
  },
  {
    "id": "ammaiyappan-s035-d058",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "இந்தக் கிண்டல் எல்லாம் செய்யக் கூடாது..."
  },
  {
    "id": "ammaiyappan-s035-d059",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "என்ன பேசவேண்டும்? பேசு!..."
  },
  {
    "id": "ammaiyappan-s035-d060",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "ஆண் பெண் சமத்துவத்தைப்பற்றி தங்கள் அபிப்ராயம் என்ன?"
  },
  {
    "id": "ammaiyappan-s035-d061",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "ஆண்பாதி—பெண்பாதி—ஆணும் பெண்ணும் அர்த்தநாரீஸ்வரர்களாகவே சிருஷ்டிக்கப்பட வேண்டுமென்பதே என் கொள்கை—நான் ஆண்டவனாய் இருந்தால் அப்படித்தான் செய்வேன்!..."
  },
  {
    "id": "ammaiyappan-s035-d062",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "ஆகா...சுருக்கமாகச் சொல்லிவிட்டார்கள், சிக்கலான பெரும் விஷயத்தை!...உங்களேஅடை யும் பாக்கியம் பெற்ற பெண் அதிர்ஷ்டசாலிதான்—இன்னும் ஒன்று கேட்க வேண்டும்."
  },
  {
    "id": "ammaiyappan-s035-d063",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "இப்படி எல்லாம் சில்லறையாகக் கேட்காதே—மொத்தமாகவே கேள்!"
  },
  {
    "id": "ammaiyappan-s035-d064",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "அதை நான் கேட்டு நீங்கள் உடனே சொல்ல முடியாது. நீண்ட நேரம் பேசவேண்டும்."
  },
  {
    "id": "ammaiyappan-s035-d065",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "பேசுவோம்—பரவா இல்லை—உன்னுடன் பேசுவதைத் தவிர எனக்கு வேறென்ன இன்பம் இருக்கிறது!"
  },
  {
    "id": "ammaiyappan-s035-d066",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "அருமையான நிலவு — இருவரும் ஆற்றங்கரைப் பக்கம் போய் சுவையான க்கதைகள் பேசுவோமே!"
  },
  {
    "id": "ammaiyappan-s035-d067",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "ஆகா!...நீண்டதைச் சொன்னாய் வா, புறப்படு என் கண்ணே!..."
  },
  {
    "id": "ammaiyappan-s035-d068",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "உஸ்...தொட்டுக்கூடாது...அதெல்லாம் நாளைக்கு! வாருங்கள் போகலாம்..."
  },
  {
    "id": "ammaiyappan-s035-d069",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "தயாராய் இருக்கிறேன்..."
  },
  {
    "id": "ammaiyappan-s035-d070",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "ஆணும் பெண்ணும் சமம் என்கிறீர்களே, நீங்கள் பெண் உடையிலும், நான் ஆண் உடையிலும்..."
  },
  {
    "id": "ammaiyappan-s035-d071",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "அய்யோ, பெண் உடையிலா?"
  },
  {
    "id": "ammaiyappan-s035-d072",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "பார்த்தீர்களா! பெண் என்றால் இழிவு..."
  },
  {
    "id": "ammaiyappan-s035-d073",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      }
    ],
    "text": "இல்ல...இல்ல...பரவாது ஆண் பிள்ளைகள் பார்த்தால் வெட்கமா இருக்கும்..."
  },
  {
    "id": "ammaiyappan-s035-d074",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 76,
        "printed_page": 74
      },
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "யாருக்கும் தெரியாமல் ரகசியமாகத்தானே போகப் போகிறோம்? நீங்களும் நானும் ஓர் உயிரும் ஈருடலும் என்ற போது, நீங்கள் என் ஆடைகளையும் நான்\nஉங்கள் ஆடைகளையும் அணிந்து கொள்வதில் என்ன தவறு?...",
    "page_segments": [
      {
        "pdf_page": 76,
        "printed_page": 74,
        "text": "யாருக்கும் தெரியாமல் ரகசியமாகத்தானே போகப் போகிறோம்? நீங்களும் நானும் ஓர் உயிரும் ஈருடலும் என்ற போது, நீங்கள் என் ஆடைகளையும் நான்"
      },
      {
        "pdf_page": 77,
        "printed_page": 75,
        "text": "உங்கள் ஆடைகளையும் அணிந்து கொள்வதில் என்ன தவறு?..."
      }
    ]
  },
  {
    "id": "ammaiyappan-s035-d075",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "தவறே இல்லை, தங்கக் கட்டியே! நீ சொல்வது போலவே செய்கிறேன்..."
  },
  {
    "id": "ammaiyappan-s035-d076",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "கண்மணி, முத்தாயி! எவ்வளவு இனிமையான நேரம்!...எவ்வளவு அருமையான காட்சி!...ஆகா! என்னருகே நீ இருப்பது...அய்யோ, நாம் எங்கு போய்க் கொண்டிருக்கிறோம் என்றே புரியவில்லையே!..."
  },
  {
    "id": "ammaiyappan-s035-d077",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "புரியாது...புரியாது!...நீ...பேசாமல் வர வேண்டும்."
  },
  {
    "id": "ammaiyappan-s035-d078",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "டேய்! யார் அது?..."
  },
  {
    "id": "ammaiyappan-s035-d079",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "ஆ!..."
  },
  {
    "id": "ammaiyappan-s035-d080",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "அதுதான்—நமது அடுத்த திட்டம் என்ன?"
  },
  {
    "id": "ammaiyappan-s035-d081",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "அடுத்த திட்டமா? உன் கணையாழியை இப்படிக் கொடு...உப்...விரலில் போடு!...இந்தா!...விரல் நீட்டு..."
  },
  {
    "id": "ammaiyappan-s035-d082",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "என்ன இது?..."
  },
  {
    "id": "ammaiyappan-s035-d083",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "காதலிருவர் கருத்தொருமித்து கணையாழி மாற்றிக் கொள்வதே கல்யாணம்..."
  },
  {
    "id": "ammaiyappan-s035-d084",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "சரி...கல்யாணமாகிவிட்டது...இனிமேல்?..."
  },
  {
    "id": "ammaiyappan-s035-d085",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "இனிமேல்...கு...கு...குடும்பம் நடத்த வேண்டியதுதான்..."
  },
  {
    "id": "ammaiyappan-s035-d086",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      }
    ],
    "text": "குடும்பம், காட்டிலேயே நடத்துவதா?..."
  },
  {
    "id": "ammaiyappan-s035-d087",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 77,
        "printed_page": 75
      },
      {
        "pdf_page": 78,
        "printed_page": 76
      }
    ],
    "text": "நடத்தக் கூடாதா?...ராமனும் சீதையும் பதினான்கு வருஷங்கள் காட்டில் வாழவில்லையா? ஆணும் பெண்ணும் தனியாக இருந்தால் ஆரண்ய வாசத்தைவிட\nஆனந்தமான வாசம் எதுவுமே கிடையாது...களிப்பில் ஆடும் மயிலைப்பார்! காதாரப் பண்பாடும் குயிலைப்பார்! ஆறுபார்!—அருவிபார்!—அதன் அழகுபார்!—கொஞ்சும் அருகே வந்துபார்!",
    "page_segments": [
      {
        "pdf_page": 77,
        "printed_page": 75,
        "text": "நடத்தக் கூடாதா?...ராமனும் சீதையும் பதினான்கு வருஷங்கள் காட்டில் வாழவில்லையா? ஆணும் பெண்ணும் தனியாக இருந்தால் ஆரண்ய வாசத்தைவிட"
      },
      {
        "pdf_page": 78,
        "printed_page": 76,
        "text": "ஆனந்தமான வாசம் எதுவுமே கிடையாது...களிப்பில் ஆடும் மயிலைப்பார்! காதாரப் பண்பாடும் குயிலைப்பார்! ஆறுபார்!—அருவிபார்!—அதன் அழகுபார்!—கொஞ்சும் அருகே வந்துபார்!"
      }
    ]
  },
  {
    "id": "ammaiyappan-s035-d088",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 78,
        "printed_page": 76
      }
    ],
    "text": "உம்..."
  },
  {
    "id": "ammaiyappan-s035-d089",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 78,
        "printed_page": 76
      }
    ],
    "text": "என்றெல்லாம் சீதையிடம் ராமன் பேசியிருப்பான்...காட்டு வாழ்க்கை அவர்களுக்கு கசப்பாகவா இருந்திருக்கும்?...லட்சுமணருக்கு வேண்டுமானால் கசப்பாக இருந்திருக்கலாம்...பாவம், அவர் கல்யாணம் பண்ணியும் பிரமச்சாரி!"
  },
  {
    "id": "ammaiyappan-s035-d090",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 78,
        "printed_page": 76
      }
    ],
    "text": "குறும்பு!"
  },
  {
    "id": "ammaiyappan-s035-d091",
    "archive_scene_id": "ammaiyappan-s035",
    "archive_scene_ordinal": 35,
    "source_scene_number": null,
    "source_heading": "கண்ணகி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-035.md",
    "page_provenance": [
      {
        "pdf_page": 78,
        "printed_page": 76
      }
    ],
    "text": "சரி, முத்தாயி வா! நாம் மாறு வேடத்திலேதான் மறைந்து வாழ வேண்டும்...இல்லாவிட்டால் வேலழகன் எப்படியும் பிடித்து விடுவான்...வா...வா!..."
  }
]
