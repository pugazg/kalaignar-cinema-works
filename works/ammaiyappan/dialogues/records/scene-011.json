[
  {
    "id": "ammaiyappan-s011-d001",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "தேடக் கிடைக்காத தங்கம் நீங்கள்...உங்களிடமிருந்து என்னைப் பிரித்துவிட முயலுகிறார் அப்பா."
  },
  {
    "id": "ammaiyappan-s011-d002",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "உன் அப்பா நினைப்பதும் சரிதானே. இளவரசன் சுகதேவ் எங்கே! நான் எங்கே! அரண்மனையிலே குதிரை தேய்ப்பவன் நான்... தாயை இழந்தவன்...தகப்பன் யாரெனத் தெரியாதவன்...உற்றார், உறவினர் அற்றவன்...தனி மனிதன்."
  },
  {
    "id": "ammaiyappan-s011-d003",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "தனி மனிதா...நட்சத்திரங்கள் கூட்டமாய்த்தான் இருக்கின்றன. நிலவு தனியாகத் தானிருக்கிறது. ஆனால் அல்லி மலர் எதிர்பார்ப்பது நிலவைத்தானே?"
  },
  {
    "id": "ammaiyappan-s011-d004",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "என் அல்லி-பாளையக்காரர் சம்பந்தியாக ஆசைப்படும் உன் அப்பா—இந்தப் பாரிக்கா உன்னை அளிக்கப் போகிறார்? கனவு...கனவு.."
  },
  {
    "id": "ammaiyappan-s011-d005",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "கனவையும் பலிக்க வைக்கிறேன். கண்ணா...கவலையை விடுங்கள்...எங்கே என்னைப் பாருங்கள்; பார்க்க மாட்டீர்களா? என் முகம் உங்கள் கவலையைத் தீர்க்கும் மருந்தாக இல்லையா?"
  },
  {
    "id": "ammaiyappan-s011-d006",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "மருந்துதான்...என் மாணிக்கவல்லி! கவலை தீர்க்கும் மருந்துதான்...இந்தக் கள்ளமிலா வெள்ளி நிலவு. துன்பச் சுவை குடித்துவிட்ட எத்தனை எத்தனை பொல்லாத இரவுகள் சொல்லாமல் ஓடியிருக்கின்றன, சுந்தரி...உன் சோபித முகத்தை நினைப்பதாலேயே...ஏழைதானே நான் என எண்ணி ஏங்குவேன்...ஏழைக்கு மாளிகைக்காரனுக்கும் கிடைக்காத ரத்தினத்தைப் பெற்றிருக்கும் நீயா ஏழை என்று அடுத்துக் கேட்கும் உன் அழகின் எல்லையை இன்னும் அறிய முடியாத என் கண்கள். இன்பமே! நீ எனக்கு வேதனை தீர்க்கும் மருந்துதான்...இணையில்லா விருந்துதான்...."
  },
  {
    "id": "ammaiyappan-s011-d007",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "ஸ...பறக்காதீர்கள்."
  },
  {
    "id": "ammaiyappan-s011-d008",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "வசந்தத்தின் ஸ்பரிசத்திலே வானம்பாடி பறக்காமலிருக்குமா?"
  },
  {
    "id": "ammaiyappan-s011-d009",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "பறப்பதற்கு ஒரு இறக்கை போதாது."
  },
  {
    "id": "ammaiyappan-s011-d010",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "அதற்குத்தான் உன்னையும் அழைக்கிறேன்."
  },
  {
    "id": "ammaiyappan-s011-d011",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "ஆமாம்! எங்கே பறப்பது?"
  },
  {
    "id": "ammaiyappan-s011-d012",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 24,
        "printed_page": 22
      }
    ],
    "text": "நீலநிற வானத்தின் விளிம்பிலே, கோலஞ்செய் மேகக் கூட்டத்தின் இடையிலே—அருவியின் மேலே—அழகுச் சோலையின் சுற்றப் புறங்களிலே—"
  },
  {
    "id": "ammaiyappan-s011-d013",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "கேள்விப்பட்டிருக்கிறேன்....கவிஞன்...\nகாதலன்...பித்தன்...மூவரும் ஒரே வகை என்று. கவிஞன்\nவானத்தைத் தாமரையைப் பார்த்து 'ஏ, விண்மீன்களே!\nயாரைப்பார்த்து கண் சிமிட்டுகிறீர்கள்' என்று சண்டைக்கு\nபோவானும். காதலனோ வெண்ணிலவைப் பார்த்து-'என்\nகாதலி எங்கே என்று' கேட்டுப் புலம்புவானும். நிலவைத்\nதூது போகச் சொல்லுவானும். அந்த இருவருமே பித்தர்கள்\nஎன்பார்கள் வேடிக்கைக்கு...அது உண்மையாகத்தான்\nதெரிகிறது, உங்களைப் பார்க்கும்போது..."
  },
  {
    "id": "ammaiyappan-s011-d014",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "உஸ்...தொடாதே...நான் தான் பித்தனா\nயிற்றே."
  },
  {
    "id": "ammaiyappan-s011-d015",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "பித்தனானும் என் முத்தனல்லவா?\nபித்தா! பிறைகுடி! பெருமானே!"
  },
  {
    "id": "ammaiyappan-s011-d016",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "ஸ்...அம்மா. இரு முத்தாயி."
  },
  {
    "id": "ammaiyappan-s011-d017",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "ஏன்! தீண்டினால் திருநீறுகண்டமா?"
  },
  {
    "id": "ammaiyappan-s011-d018",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "ஸ்...அம்மா. இரு முத்தாயி."
  },
  {
    "id": "ammaiyappan-s011-d019",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "அதுதான்!"
  },
  {
    "id": "ammaiyappan-s011-d020",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "ஆ! சரிதான்..சரிதான்..மால் நன்னோரம்..\nசோலையின் ஓரம்..."
  },
  {
    "id": "ammaiyappan-s011-d021",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "இளவரசே! நீங்கள் தவறாக நினைக்காதீர்கள்,\nஎன் பெண்ணை பலாத்காரம் செய்ய ஆரம்பித்திருக்கிறான்\nஇந்தப் பயல். ஏ அறிவு கெட்ட பயலே! என்ன காரியமடா?"
  },
  {
    "id": "ammaiyappan-s011-d022",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "அப்பா!"
  },
  {
    "id": "ammaiyappan-s011-d023",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "நீ பயப்படாதேயம்மா-அவன் என்னை\nஒன்றும் செய்துவிடமாட்டான்-சும்மா பெண்கள் மிரட்டுகிற\nசோம்பேறிப் பயல்."
  },
  {
    "id": "ammaiyappan-s011-d024",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 25,
        "printed_page": 23
      }
    ],
    "text": "இல்லையப்பா."
  },
  {
    "id": "ammaiyappan-s011-d025",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "எனக்குத்தான் எல்லாம் புரிகிறதே...நீ\nஏன் இங்கெல்லாம் தனியாக வருகிறாய்?"
  },
  {
    "id": "ammaiyappan-s011-d026",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "சொல்லவதைக் கேளுங்கள்."
  },
  {
    "id": "ammaiyappan-s011-d027",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "நீ ஒன்றும் சொல்ல வேண்டாம்; நீ\nபோம்மா வீட்டுக்கு...இந்தப் பாவிக்கு நேராக நிற்காதே...\nதவறு...போம்மா-போகிறாயா இல்லையா? உம்...போ..."
  },
  {
    "id": "ammaiyappan-s011-d028",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "ஏ முத்தா! முணு முணுக்கிறதா முதுகு?\nஅரைப்பட்டினி ஆண்டிப் பயலே! அழுதைக் கழுதை."
  },
  {
    "id": "ammaiyappan-s011-d029",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "தீர்ந்ததா அகாதி?"
  },
  {
    "id": "ammaiyappan-s011-d030",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "பேசாதே...பேடி நாயே! அரை வயிற்றுக்\nகஞ்சிக்கு வழி இல்லை. காதல் பண்ணுகிறானும் காதல்."
  },
  {
    "id": "ammaiyappan-s011-d031",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "சீமான் மகனே! இருதயத்துக்கும்,\nஇரைப்பைக்கும் வித்தியாசம் தெரியாதவனே! உனக்கு\nகாதல் இலக்கணம் சொல்லித் தருகிறேன்...கேள்...\n\nபன்னீரிலே குளித்து, பழரசத்திலே நீந்தி, கன்னியர்\nபுடைசூழ கட்டிலறைக்கு சென்றுவந்தான் வருவேன்\nஎன்று சொல்லவதல்ல காதல்...காதல் ஒரு நிலவு...அது\nஒரு தென்றல்...மாளிகைக்கு மட்டுமல்ல. மண் குடிசைக்கும்\nவரும்...காதல் பணமல்ல; உன் பளிங்கு மண்டபத்தோடு\nநின்றுவிட..."
  },
  {
    "id": "ammaiyappan-s011-d032",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "சரிதாண்டா; அதிகப் பிரசங்கித்தனத்\nதிலே அயோக்கியத்தனத்தை மறைக்க முடியாது."
  },
  {
    "id": "ammaiyappan-s011-d033",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "அது எப்படி முடியும்...அதற்கு பாளையக்\nகார மகனைப் பிறக்க வேண்டுமே..."
  },
  {
    "id": "ammaiyappan-s011-d034",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "சீ! தகப்பன் பெயர் தெரியாத தவறுதலில்."
  },
  {
    "id": "ammaiyappan-s011-d035",
    "archive_scene_id": "ammaiyappan-s011",
    "archive_scene_ordinal": 11,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-011.md",
    "page_provenance": [
      {
        "pdf_page": 26,
        "printed_page": 24
      }
    ],
    "text": "உனக்குத் தெரியுமா தகப்பன் பெயர்?"
  }
]
