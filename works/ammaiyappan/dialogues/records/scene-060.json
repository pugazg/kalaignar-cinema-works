[
  {
    "id": "ammaiyappan-s060-d001",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 106,
        "printed_page": 104
      }
    ],
    "text": "அழகான தாமரை மலர்—அருமையாக செய்திருக்கிறான் சிற்பி...பொன்னிற இதழ்கள் கண்ணைப் பறிப்பது போல் மின்னுகின்றன....ஆனாலும் இந்த மலருக்கு வாசனை கிடையாதே மகாராஜா!...அப்படித்தான் ஆகிவிட்டது இளவராணி பூங்காவனத்தின் வாழ்வு!..."
  },
  {
    "id": "ammaiyappan-s060-d002",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "பூங்காவனம்",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 106,
        "printed_page": 104
      }
    ],
    "text": "மகாராஜா!...பூபதி வைத்தியர் இவ்வளவு சொன்ன பிறகாவது நான் ஏன் தங்களைத் திருமணம் செய்து கொள்ள மறுத்தேன் என்ற காரணத்தை புரிந்து கொண்டீர்களா"
  },
  {
    "id": "ammaiyappan-s060-d003",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "அரச",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 106,
        "printed_page": 104
      }
    ],
    "text": "புரிந்து கொண்டேன் பூங்காவனம்! இந்தக் காரணத்தை நீ முன்பே வெளியிட்டிருந்தால், என்னுடைய வாழ்க்கை எவ்வளவோ நிம்மதியாக இருந்திருக்கும்!"
  },
  {
    "id": "ammaiyappan-s060-d004",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 107,
        "printed_page": 105
      }
    ],
    "text": "மகாராஜா! என்னை மன்னித்து விடுங்கள். நான் தங்களுக்கு பெரிய தவறுதான் செய்து விட்டேன். தங்களுக்கு மட்டுமல்ல; மாதர் குலத்துக்கே நான் தவறு செய்து விட்டேன்! மகாராஜா, என் மகனை எப்படியாவது விடுதலை செய்யுங்கள்!"
  },
  {
    "id": "ammaiyappan-s060-d005",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "அர",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 107,
        "printed_page": 105
      }
    ],
    "text": "பூங்காவனம்! நான் உன்மீது வைத்திருந்த அன்புக்காக மட்டுமே முத்தனை விடுவிக்கலாம். ஆனால் முத்தன் வேங்கை நாட்டின் விரோதி!...விடுதலை விரும்பி!... அவனை விடுவிக்க சட்டம் கிடையாது......"
  },
  {
    "id": "ammaiyappan-s060-d006",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 107,
        "printed_page": 105
      }
    ],
    "text": "மகாராஜா!...முத்தன் சாக வேண்டியது தானா?...என் மகன் சாகவேண்டியதுதானா?...அப்படியானால் என்னையும் கொன்று விடுங்கள்..."
  },
  {
    "id": "ammaiyappan-s060-d007",
    "archive_scene_id": "ammaiyappan-s060",
    "archive_scene_ordinal": 60,
    "source_scene_number": null,
    "source_heading": "வேங்கையூர்",
    "speaker_label": "அர",
    "source_scene_file": "scene-060.md",
    "page_provenance": [
      {
        "pdf_page": 107,
        "printed_page": 105
      }
    ],
    "text": "கவலைப்படாதே! முத்தன் இதுவரையில் என் இதயத்திலே குடியிருந்தவளின் மகன் என்பதற்காக விடுதலை செய்யப்படுகிறான்!..."
  }
]
