[
  {
    "id": "ammaiyappan-s037-d001",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 80,
        "printed_page": 78
      }
    ],
    "text": "உம்...இரண்டும் புதிய பறவைகள்—பருவ மலர்கள்—எங்கே போய் காதல் கீதம் பாடுகிறீர்களோ? திரிசங்கு! கவலைப் படாதே. உன் மகளுக்கேற்ற மன்மதனை தேடிப் பிடித்துவிட்டாய். இனி அவள் பாடு! அவன் பாடு!"
  },
  {
    "id": "ammaiyappan-s037-d002",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 80,
        "printed_page": 78
      }
    ],
    "text": "மன்மதன் என்பதற்காக அல்லவே, நான் இப்படி பொல்லாம் கட்டப்பட்டு இந்த திருமணத்தை ஏற்பாடு செய்தது. ஒட்டைக் குடிசையிலே கிடக்கும் நான்......"
  },
  {
    "id": "ammaiyappan-s037-d003",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 80,
        "printed_page": 78
      },
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "உப்பரிகையிலே உலவலாம் பாளையக்காரர் சம்மந்தியாக என்று எண்ணினாய்—அதுதானே! இப்போது\nதான் என்ன—சுகதேவ், முத்தாயி இருவரும் தங்கள் காதல் சுற்றுப் பயணத்தை முடித்துக்கொண்டு விரைவில் வந்து விடுவார்கள்.",
    "page_segments": [
      {
        "pdf_page": 80,
        "printed_page": 78,
        "text": "உப்பரிகையிலே உலவலாம் பாளையக்காரர் சம்மந்தியாக என்று எண்ணினாய்—அதுதானே! இப்போது"
      },
      {
        "pdf_page": 81,
        "printed_page": 79,
        "text": "தான் என்ன—சுகதேவ், முத்தாயி இருவரும் தங்கள் காதல் சுற்றுப் பயணத்தை முடித்துக்கொண்டு விரைவில் வந்து விடுவார்கள்."
      }
    ]
  },
  {
    "id": "ammaiyappan-s037-d004",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "எப்போது? நான் சுடுகாட்டுக்குப் போகும் போது?"
  },
  {
    "id": "ammaiyappan-s037-d005",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "அப்படியானால்தான் என்ன? உனக்கு கொள்ளி வைக்கப் போகிற பேரன் எதிர்கால பாளையக்காரராக அல்லவா இருப்பான். ஹி...ஹி...ஹி...திரிசங்கு! அதெல்லாம் இருக்கட்டும். இவ்வளவு மகத்தான திருமண ஏற்பாட்டுக்கு யோசனை சொன்னேனே—எனக்கு எங்கே பரிசு?"
  },
  {
    "id": "ammaiyappan-s037-d006",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "பரிசா?"
  },
  {
    "id": "ammaiyappan-s037-d007",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "ஊதியம் என்று கேட்கட்டுமா?"
  },
  {
    "id": "ammaiyappan-s037-d008",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "விளையாடாதீர், என் வேதனையோடு."
  },
  {
    "id": "ammaiyappan-s037-d009",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "விளையாட்டா? இந்த வேதாளம் விளையாட்டமாட்டான் திரிசங்கு...மரியாதையாக எனக்குத் தரவேண்டிய பரிசு வரவேண்டும். இல்லாவிட்டால்,......"
  },
  {
    "id": "ammaiyappan-s037-d010",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "இல்லாவிட்டால் என்ன செய்வீர்கள்?"
  },
  {
    "id": "ammaiyappan-s037-d011",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "என்ன செய்வேன்? சுகதேவை ஏமாற்றிநீ கெடுத்து விட்டாய் என்று பாளையக்காரரிடம் கூறுவேன். ஜாக்கிரதை!"
  },
  {
    "id": "ammaiyappan-s037-d012",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "பயமுறுத்தாதீர். பாளையக்காரர் முட்டாள் அல்ல ஆதாரமில்லாத உன் பொய்யை அப்படியே நம்பிவிட."
  },
  {
    "id": "ammaiyappan-s037-d013",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "ஆதாரமா இல்லை? முத்தாயி உன் வீட்டில் இல்லாததே எனக்கு பெரிய ஆதாரம் தெரியுமா?"
  },
  {
    "id": "ammaiyappan-s037-d014",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "போதும்! நிறுத்தும்! நீரும்தான் யோசனை சொன்னீர்."
  },
  {
    "id": "ammaiyappan-s037-d015",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "அது வாராது அப்பனே இந்த வழக்குக்கு! இரு...இரு உன்னைப் பேசிக் கொள்கிறேன். ஒழுங்காக நடந்து கொண்டால் பிழைத்தாய். இல்லை....."
  },
  {
    "id": "ammaiyappan-s037-d016",
    "archive_scene_id": "ammaiyappan-s037",
    "archive_scene_ordinal": 37,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-037.md",
    "page_provenance": [
      {
        "pdf_page": 81,
        "printed_page": 79
      }
    ],
    "text": "இல்லை—செத்துவிடுவேன். அவ்வளவுதானே! ஒன்றும் மிரட்டாதீர். உம்மால் ஆனதைச் செய்யும்."
  }
]
