[
  {
    "id": "ammaiyappan-s027-d001",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "குறும்பா!..."
  },
  {
    "id": "ammaiyappan-s027-d002",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "நிறுத்து!"
  },
  {
    "id": "ammaiyappan-s027-d003",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "பிரபு! அதோ;....அந்தப் பொன் வாத்து தான் நான் கூறிய முத்தாயி!..."
  },
  {
    "id": "ammaiyappan-s027-d004",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேல",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "ஆகா!...பொன் வாத்து என்று கூறுகிறீரே...புலவர் மொழியில் அன்னம் என்று கூறும்:....சொர்ணம் என்று சொல்லும், வேதாளம்—இவளை நான் எப்படியும் அடையவேண்டும்...நானும் முத்தாயியும் விரைவில் காதல் கீதம் பாடவேண்டும்!"
  },
  {
    "id": "ammaiyappan-s027-d005",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "கவலையை விடுங்கள்...உங்கள் கீதத்துக்கு நான் தான் தாளம்!"
  },
  {
    "id": "ammaiyappan-s027-d006",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "அய்யா...அய்யா!...நீங்கள் வேங்கை நாட்டு வீரர்தானே?"
  },
  {
    "id": "ammaiyappan-s027-d007",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "குறு",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "ஆமாம்...என்ன வேண்டும்?..."
  },
  {
    "id": "ammaiyappan-s027-d008",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "அவரை விடுதலை செய்து விட்டார்களா?..."
  },
  {
    "id": "ammaiyappan-s027-d009",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "குறு",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "யாரை?"
  },
  {
    "id": "ammaiyappan-s027-d010",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "முத்தன்!"
  },
  {
    "id": "ammaiyappan-s027-d011",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "குறு",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "ஓ!...விடுதலை செய்து விட்டார்களே!...அவனை விடுதலை செய்து, பிரமாதமான மரியாதைகளோடு அதோ அழைத்து வருகிறார்கள்!..."
  },
  {
    "id": "ammaiyappan-s027-d012",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "ஆ!...என்ன?..."
  },
  {
    "id": "ammaiyappan-s027-d013",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "அடியுங்கள்!...நன்றாக அடியுங்கள்!...என் இருதயத்தில் எழுச்சிக் கனல் பொங்கப் பொங்க அடியுங்கள்!...இப்படித் தவறு செய்யாதவர்களே அடித்து அடித்துத் தானய்யா தரைமட்டமாகப் போயிருக்கிறது பல தான் தோன்றிகளின் தர்பார் மண்டபங்கள்!...அடியுங்கள்; பாதகர்களே அடியுங்கள்!..."
  },
  {
    "id": "ammaiyappan-s027-d014",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "அத்தான்!..."
  },
  {
    "id": "ammaiyappan-s027-d015",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "முத்தாயி!..."
  },
  {
    "id": "ammaiyappan-s027-d016",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      }
    ],
    "text": "அத்தான்...அத்தான்!...என்னைத்தான் இப்படிச் செய்து விட்டார்கள்?...நான் அவ்வளவு சொல்லியும் கேட்கவில்லையே!...ஐயோ, அத்தான்...இந்த அலங்கோலக் காட்சியை நான் காணவேண்டுமென்று எத்தனை நாளாகக் காத்திருந்தீர்கள் அத்தான்?..."
  },
  {
    "id": "ammaiyappan-s027-d017",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 57,
        "printed_page": 55
      },
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "அழாதே முத்தாயி, அழாதே!...இது ஒன்றும் அலங்கோலக் காட்சியல்ல...கத்திமுனைகளையும்,...கட்டாரி வீச்சுக்களையும் நம்பி வாழும் காட்டு மிராண்டிகளின் கொலுமண்டபத்திலே எத்தனை எத்தனை வீரர்கள் தங்கள் உயிர்களையே காணிக்கையாக தந்திருக்கிறார்கள்...\nவீங்கிய தோளும், விடுதலை வாளும் கொண்டு, ஓங்கிய கையைத் தாழ்த்தாமல், ஒழிந்திடுவோம் எனத் தெரிந்திடினும்...ஒளி சிந்தும் விழியில் ஒருதுளி பயமும் படாமல், ‘இன்பமணம் பெற்ற திருமணமும் கூடும்—அல்லது எங்கள் பிணம் அந்தக் களத்திலே நாறும்’, என்ற மொழியுரைத்து...எதிரியை வெல்லப் பழியுரைத்து—படையினர்க்கு வழியுரைத்துக் கிளம்பிய எத்தனை எத்தனை விடுதலைக் குமார்கள்......சுதந்திர அன்னையின் மடியிலே சமாதிக் குழந்தைகளாய்—கல்லறை செல்வங்களாய்—தூங்கிக் கொண்டிருக்கிறார்கள்! அந்த வீரத் தியாகிகள் ஏற்றிருக்கும் தழும்புகளே நினைத்தால், என் தங்கமே; இந்தத் தண்டனை மிகக் குறைவு!....",
    "page_segments": [
      {
        "pdf_page": 57,
        "printed_page": 55,
        "text": "அழாதே முத்தாயி, அழாதே!...இது ஒன்றும் அலங்கோலக் காட்சியல்ல...கத்திமுனைகளையும்,...கட்டாரி வீச்சுக்களையும் நம்பி வாழும் காட்டு மிராண்டிகளின் கொலுமண்டபத்திலே எத்தனை எத்தனை வீரர்கள் தங்கள் உயிர்களையே காணிக்கையாக தந்திருக்கிறார்கள்..."
      },
      {
        "pdf_page": 58,
        "printed_page": 56,
        "text": "வீங்கிய தோளும், விடுதலை வாளும் கொண்டு, ஓங்கிய கையைத் தாழ்த்தாமல், ஒழிந்திடுவோம் எனத் தெரிந்திடினும்...ஒளி சிந்தும் விழியில் ஒருதுளி பயமும் படாமல், ‘இன்பமணம் பெற்ற திருமணமும் கூடும்—அல்லது எங்கள் பிணம் அந்தக் களத்திலே நாறும்’, என்ற மொழியுரைத்து...எதிரியை வெல்லப் பழியுரைத்து—படையினர்க்கு வழியுரைத்துக் கிளம்பிய எத்தனை எத்தனை விடுதலைக் குமார்கள்......சுதந்திர அன்னையின் மடியிலே சமாதிக் குழந்தைகளாய்—கல்லறை செல்வங்களாய்—தூங்கிக் கொண்டிருக்கிறார்கள்! அந்த வீரத் தியாகிகள் ஏற்றிருக்கும் தழும்புகளே நினைத்தால், என் தங்கமே; இந்தத் தண்டனை மிகக் குறைவு!...."
      }
    ]
  },
  {
    "id": "ammaiyappan-s027-d018",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேல",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "என்னடா இங்கே...யார் இந்த நிலாப் பதுமை? யாரம்மா நீ?..."
  },
  {
    "id": "ammaiyappan-s027-d019",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "துரோகி...தொடாதே!"
  },
  {
    "id": "ammaiyappan-s027-d020",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேல",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "ஏன், இந்தத் தோகை மயிலுக்கு நீ தான் சொந்தக்காரனோ?..."
  },
  {
    "id": "ammaiyappan-s027-d021",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "வெறியனே!...பெண்களிடம் பழகத் தெரியாத பண்பற்ற மிருகமே!..."
  },
  {
    "id": "ammaiyappan-s027-d022",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "வேல",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "என்ன? (அறைகிறான்)-முத்தாயி? அத்தான்!..."
  },
  {
    "id": "ammaiyappan-s027-d023",
    "archive_scene_id": "ammaiyappan-s027",
    "archive_scene_ordinal": 27,
    "source_scene_number": null,
    "source_heading": "பழுதார் வீதி",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-027.md",
    "page_provenance": [
      {
        "pdf_page": 58,
        "printed_page": 56
      }
    ],
    "text": "காதலும் கடமையும் ஒன்றுக பின்னிக் கிடக்கும் எங்கள் ஆனந்த வாழ்விலே குறுக்கிட்ட கண்ணியமற்றவனே!...கட்டுண்டு கிடப்பவனை அடித்து மகிழும் வீராதி வீரனே!..."
