[
  {
    "id": "ammaiyappan-s015-d001",
    "archive_scene_id": "ammaiyappan-s015",
    "archive_scene_ordinal": 15,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "குரல்",
    "source_scene_file": "scene-015.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      },
      {
        "pdf_page": 32,
        "printed_page": 30
      }
    ],
    "text": "இங்கென்ன வாழ்கிறது! இங்கேயும் குழப்\nபம்தான்! காதல்புறு ... கன்றைநாடும் பசு ... மான்தோல்\nவேங்கை! எத்துணைச் சிறப்பான கருத்து கலையின் அழகே\nஅழகு...அந்தக் கருத்துக் கலைகள் அவளுக்கு ஒரு ஆறு\nதலா என்ன?...அந்த உயிர்நிறை ஓவியங்களே பூங்காவனம்\nபார்த்திருக்கிறாள்...\n\n—ஆனாலும் இப்போது அவைகளே அவள் பார்த்துக்\nகொண்டே இருக்கிறாள்...அவள் கண்கள் அடிக்கடி வாயிற்\nபுறத்தை வட்டமிட்டு திருப்பியபடி இருக்கின்றன. காலடி\nஓசை கேட்கிறதா என்று கவனித்தபடி இருக்கின்றன\n\nமுத்தன் வருவானா என்ற ஆவல் வெளிப்பட்டபடி துடிக்\nகிறது இருதயம்...ஆ!...அதோ வந்து விட்டான். (முத்தன்\nவந்தே விட்டான்.)",
    "page_segments": [
      {
        "pdf_page": 31,
        "printed_page": 29,
        "text": "இங்கென்ன வாழ்கிறது! இங்கேயும் குழப்\nபம்தான்! காதல்புறு ... கன்றைநாடும் பசு ... மான்தோல்\nவேங்கை! எத்துணைச் சிறப்பான கருத்து கலையின் அழகே\nஅழகு...அந்தக் கருத்துக் கலைகள் அவளுக்கு ஒரு ஆறு"
      },
      {
        "pdf_page": 32,
        "printed_page": 30,
        "text": "தலா என்ன?...அந்த உயிர்நிறை ஓவியங்களே பூங்காவனம்\nபார்த்திருக்கிறாள்...\n\n—ஆனாலும் இப்போது அவைகளே அவள் பார்த்துக்\nகொண்டே இருக்கிறாள்...அவள் கண்கள் அடிக்கடி வாயிற்\nபுறத்தை வட்டமிட்டு திருப்பியபடி இருக்கின்றன. காலடி\nஓசை கேட்கிறதா என்று கவனித்தபடி இருக்கின்றன\n\nமுத்தன் வருவானா என்ற ஆவல் வெளிப்பட்டபடி துடிக்\nகிறது இருதயம்...ஆ!...அதோ வந்து விட்டான். (முத்தன்\nவந்தே விட்டான்.)"
      }
    ]
  },
