    "page_provenance": [
      {
        "pdf_page": 32,
        "printed_page": 30
      }
    ],
    "text": "ஏன் கூப்பிட்டீர்கள்?..."
  },
  {
    "id": "ammaiyappan-s015-d004",
    "archive_scene_id": "ammaiyappan-s015",
