[
  {
    "id": "ammaiyappan-s051-d001",
    "archive_scene_id": "ammaiyappan-s051",
    "archive_scene_ordinal": 51,
    "source_scene_number": null,
    "source_heading": "கோவில் மண்டபம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-051.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "காதலியை காரிருளில் கைவிட்டுக் கதறுகின்றேன். எப்படி மீட்பேனோ...என் அருமைக் காதலி, உன்னை! சாதுவேடத்தில் வந்து சூது செய்து விட்டானே! முத்தாயி! முத்தாயி! அந்த மூர்க்கனிடமிருந்து எப்படி மீட்பேன் உன்னை?..."
  },
  {
    "id": "ammaiyappan-s051-d002",
    "archive_scene_id": "ammaiyappan-s051",
    "archive_scene_ordinal": 51,
    "source_scene_number": null,
    "source_heading": "கோவில் மண்டபம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-051.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      },
      {
        "pdf_page": 90,
        "printed_page": 88
      }
    ],
    "text": "ஏ முத்தா! நில்லு—நில்லு—நல்ல சமயத்தில் வந்தாய்! நீ எங்கிருக்கிறாய்—எப்படி இருக்கிறாய்—என்\nறெல்லாம் கேட்பதற்கு நேரமில்லை இப்போது...என் ஆருயிர் காதலி முத்தாயியை ஆண்டிவேடம் போட்ட வேதாளம் எங்கேயோ ஏமாற்றி அழைத்துப் போகிறான்.",
    "page_segments": [
      {
        "pdf_page": 89,
        "printed_page": 87,
        "text": "ஏ முத்தா! நில்லு—நில்லு—நல்ல சமயத்தில் வந்தாய்! நீ எங்கிருக்கிறாய்—எப்படி இருக்கிறாய்—என்"
      },
      {
        "pdf_page": 90,
        "printed_page": 88,
        "text": "றெல்லாம் கேட்பதற்கு நேரமில்லை இப்போது...என் ஆருயிர் காதலி முத்தாயியை ஆண்டிவேடம் போட்ட வேதாளம் எங்கேயோ ஏமாற்றி அழைத்துப் போகிறான்."
      }
    ]
  },
