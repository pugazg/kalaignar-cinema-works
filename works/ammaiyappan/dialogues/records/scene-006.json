[
  {
    "id": "ammaiyappan-s006-d001",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "வீராதி வீரன் நான்—எதிரிகள் எந்தப் பக்கம் இருந்து வந்தாலும் சரி—அவர்களை எதிர்த்து முறியடிப்பேன்...அக்ரோணிக் கணக்கிலே சேனைகள் வந்தாலும் சரி! அவைகளைப் பானைகளைப் போல் அடித்து நொறுக்குவேன், கோட்டைகள் முற்றுகையிட்டாலும் சரி...கொலு மண்டபத்தில் நுழைந்துவிட்டாலும் சரி...எதிர்த்து...விரட்டி...அடித்து...உலகத்து பகைவர்களைத் தாக்கித் தவிடு பொடியாக்கி...ரத கஜ துரக பதாதிகள் எல்லாவற்றையும் படு சூரணமாக்கி விடுவேன், உம்...ஆமாம்...எந்தக் கையிலே கேடயம் வசிக்கிறது, எந்தக்கையிலே கத்திவசிக்கிறது...அடேய் அதை மட்டும் சொல்லிவிடடா,\n\n(முத்தன் வருகிறான்\n\nஆ!...இவனைக் கேட்டால் தெரியும்...முத்தா!...இன்னும் இரண்டு நாளில் நான் பெரிய வாள் வீரனாகிவிட வேண்டும்."
  },
  {
    "id": "ammaiyappan-s006-d002",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "ஓ...வாள் வீரனா விடலாம்."
  },
  {
    "id": "ammaiyappan-s006-d003",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "என்ன! வாள் வீரனா?..."
  },
  {
    "id": "ammaiyappan-s006-d004",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "அடடே தவறி வந்துவிட்டது. பரவா இல்லை...வாள் வீரர் அனுமாரைப் பற்றி கேள்விப் பட்டிருப்பீர்களே?......"
  },
  {
    "id": "ammaiyappan-s006-d005",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "ஆமாம்...ஆமாம் அசோக வனத்தில் சீதையிடம் போனவர்...\n\nசரி...சரி...வா..."
  },
  {
    "id": "ammaiyappan-s006-d006",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "டேய்...நீ போ,"
  },
  {
    "id": "ammaiyappan-s006-d007",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "இருங்கள் இது போர் செய்யும் இலக்கணமே அல்ல......"
  },
  {
    "id": "ammaiyappan-s006-d008",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "இலக்கணமே எனக்குத் தேவை இல்லை."
  },
  {
    "id": "ammaiyappan-s006-d009",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "சுகதேவ்!......என்ன இது விபரீதமான விளையாட்டு."
  },
  {
    "id": "ammaiyappan-s006-d010",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "கத்தி விளையாட்டு. நீ ஏன் அத்தை இதில் தலை யிடுகிறாய்! முத்தா! காயத்துக்கு மருந்து போடு நான் வருகிறேன்."
  },
  {
    "id": "ammaiyappan-s006-d011",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "(திகிலுடன்) முத்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 13
      }
    ],
    "text": "இளையராணி..."
  },
  {
    "id": "ammaiyappan-s006-d012",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "பரவா இல்ல ைமுத்தா, நானே கட்டி விடுகிறேன்."
  },
  {
    "id": "ammaiyappan-s006-d013",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "யுவராணி என் ஒரு மாதிரி இருக்கிறீர்கள்..."
  },
  {
    "id": "ammaiyappan-s006-d014",
    "archive_scene_id": "ammaiyappan-s006",
    "archive_scene_ordinal": 6,
    "source_scene_number": null,
    "source_heading": "வாள் பயிற்சிக் கூடம்",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-006.md",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 14
      }
    ],
    "text": "ஒன்றுமில்ல ைமுத்தா...இந்தா இதை சாப்பிடு நான் வருகிறேன்—யாராவது வந்து விடுவார்கள்...\n\nமறைத்து வைத்திருந்த பழங்கள் கொடுத்துவிட்டு போய் விடுகிறாள் முத்தன் பழங்களுடன் திகைத்து நிற்கிறான்."
  }
]
