[
  {
    "id": "ammaiyappan-s002-d001",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "மாய்கை நாதஸ்வாமிகள்......\n\nமாய்கை நாதஸ்வாமிகள்......\n\nமாய்கை நாதஸ்வாமிகள்......"
  },
  {
    "id": "ammaiyappan-s002-d002",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "மாய்கை நாதஸ்வாமிகளுக்கு சரியான வேட்டைதான் போலிருக்கிறது."
  },
  {
    "id": "ammaiyappan-s002-d003",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "எல்லாம் பக்தர்கள் அனுப்பும் காணிக்கைகள் ......"
  },
  {
    "id": "ammaiyappan-s002-d004",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "காணிக்கை!... ஆமாம் உழைக்காமல் கிடைக்கிற ஊதியத்துக்கு அப்படியும் ஒருபெயர் உண்டு ..."
  },
  {
    "id": "ammaiyappan-s002-d005",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "அடா—அடா—அடா இவ்வளவு பெரிய உண்மையை எங்கேயப்பா நீ கற்றுக் கொண்டாய். நீ படிக்கிற பதினெட்டு சித்தர் சொன்னாரா? ... குதம்பை சித்தர் சொன்னாரா?\n\nமுத்தா ஆரம்பித்து விடாதே உன் அதிமேதாவித் தனமான பிரசங்கத்தை......"
  },
  {
    "id": "ammaiyappan-s002-d006",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "நான் சாமியாரைச் சொன்னால் தங்களுக்கு ஏன் கோபம் வருகிறது"
  },
  {
    "id": "ammaiyappan-s002-d007",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "ஏ முத்தா! இது அஞ்சல் மனை. பலரும் வரும் இடம் போகும் இடம் ... நீ இப்படி உளருவது எனக்கு ஆபத்து ... இதுமாதிரி எதுவும் வருமென்று தெரிந்துதான் உனக்கு என் வீட்டில் அந்த அறையை வாடகைக்குத்தர அவ்வளவு தயங்கினேன்...."
  },
  {
    "id": "ammaiyappan-s002-d008",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "சரி—சரி—வாயை மூடிக் கொண்டேன்..."
  },
  {
    "id": "ammaiyappan-s002-d009",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "போதாது! ... வாலையும் சுருட்டிக் கொள்..."
  },
  {
    "id": "ammaiyappan-s002-d010",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "இது என்ன ராமாயணம்? ராவண தர்பாரா?......"
  },
  {
    "id": "ammaiyappan-s002-d011",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "சரி ஏன் நிற்கிறாய் அரண்மனைக்குப் போகவில்லையா குதிரை தேய்க்க......"
  },
  {
    "id": "ammaiyappan-s002-d012",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "ஏன், நான் இங்கிருந்தால் இன்னும் ஏதாவது பேசிக்கொண்டே இருப்பேன் என்ற பயமா?..."
  },
  {
    "id": "ammaiyappan-s002-d013",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "இல்ல ைஊதியம் வாங்குகிற இடத்தில் ஒழுங்காக வேலை பார்க்க வேண்டாமா? அதற்காகச் சொன்னேன். ... நீ நல்ல பிள்ளை எப்படியாவது கெட்டுப்போ. எனக்கு என் கடமை பெரிது, சாமியாரை மட்டும் ஒன்றும் சொல்லாதே. அவர் உன்னைப்போல சத்திரத்துப் பேர்வழி அல்ல; ஜகப்புகழும் மகான்."
  },
  {
    "id": "ammaiyappan-s002-d014",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 6
      }
    ],
    "text": "ஜகப்புகழும் மகான் அப்பேர்ப்பட்ட மகான் அடிமையாய் இருக்கும் இந்த பழுதாருக்கு விடுதலை வாங்கித்தர சக்தி பெறவில்லை போலும்...?..."
  },
  {
    "id": "ammaiyappan-s002-d015",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "பழுதார் விடுதலையைப் பற்றி அவருக்கென்ன கவலை ... அவர் என்ன உன்னைப்போல குறுகிய நோக்கம் படைத்தவரா? இந்தப் பாப லோகத்திலிருந்து மக்கள் விடுதலை பெற்று பரலோகம் செல்ல வேண்டுமென்ற பரந்த நோக்கம் படைத்தவர் அவர்...பழுதார் விடுதலையாம் விடுதலை......\n\nஇன்றைக்கே இளையராணி பூங்காவனம், வேங்கை நாட்டாரை விவாகம் செய்து கொள்ளட்டும் நாளைக்கே பழுதாருக்கு விடுதலை,"
  },
  {
    "id": "ammaiyappan-s002-d016",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "விருப்பமற்ற விவாகம் விடுதலைக்கு தரும் விலையா?"
  },
  {
    "id": "ammaiyappan-s002-d017",
    "archive_scene_id": "ammaiyappan-s002",
    "archive_scene_ordinal": 2,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-002.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "சரி—சரி—உன்னோடு பேச என்னால் முடியாது! அப்பா! விடுதலை வீரனே!...வேலையைப் பார்...நான் வருகிறேன்,"
  }
]
