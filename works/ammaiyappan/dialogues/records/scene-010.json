[
  {
    "id": "ammaiyappan-s010-d001",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 20
      }
    ],
    "text": "தம்பி! தம்பி! நீங்கள் என் வீட்டுக்கு வந்ததும் போதும்...அப்பப்பா! அதிலிருந்து முத்தாயிக்கு உங்கள் பேச்சேதான்."
  },
  {
    "id": "ammaiyappan-s010-d002",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 20
      }
    ],
    "text": "என்னா-எது-இருஇரு-அப்படியா இந்தா திரிசங்கு! இந்தா-இந்தா! இதிலே நூறு பொன் இருக்கு...வச்சுக்க...ம்...என்ன சொல்லுது-என்ன சொல்லுது—"
  },
  {
    "id": "ammaiyappan-s010-d003",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "திருசங்கு",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 20
      }
    ],
    "text": "முத்தாயி சொல்லுது தம்பி, உங்க நடையிலே ஒரு வீரம் இருக்கிறதாம்-கண் பார்வையிலே ஒரு கம்பீரம் இருக்கிறதாம்-பேச்சிலே இனிமை இருக்கிறதாம்-கையிலே என்னமோ இருக்குதுன்னு சொல்லுச்சே."
  },
  {
    "id": "ammaiyappan-s010-d004",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 20
      }
    ],
    "text": "விரல்—விரல்!"
  },
  {
    "id": "ammaiyappan-s010-d005",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 20
      }
    ],
    "text": "இல்ல ைதம்பி..."
  },
  {
    "id": "ammaiyappan-s010-d006",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 22,
        "printed_page": 20
      }
    ],
    "text": "விரல்லே மோதிரம் இருக்கு..."
  },
  {
    "id": "ammaiyappan-s010-d007",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "அது இல்ல ைதம்பி-போங்க நீங்க-எனக்கென்ன இந்த எழவு காதல் வாணமெல்லாமா தெரியுது."
  },
  {
    "id": "ammaiyappan-s010-d008",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "அப்படியானால் முத்தாயிக்கு என் மீது காதல். ஆஹா! திரிசங்கு! உன்னைப்போல ஒரு அப்பனும் அந்த அப்பனுக்கு முத்தாயி போல ஒரு மகளும் இருந்தால் உலகம் வெகு விரைவில் எதிர்ப்பில்லாத காதல் சோலையாக மாறிவிடும். முத்தாயி! நீயும் நானும்....அய்யோ எப்படி வாணிக்கிறதுன்னே தெரியலியே திரிசங்கு! நம்ப நூல் நிலையத்திலே கம்பராமாயணம் இருக்கிறதா?"
  },
  {
    "id": "ammaiyappan-s010-d009",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "என்ன தம்பி! காதலுக்கும், கம்பராமாயணத்துக்கும் என்ன சம்பந்தம்?"
  },
  {
    "id": "ammaiyappan-s010-d010",
    "archive_scene_id": "ammaiyappan-s010",
    "archive_scene_ordinal": 10,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-010.md",
    "page_provenance": [
      {
        "pdf_page": 23,
        "printed_page": 21
      }
    ],
    "text": "அய்யய்யோ! முக்கால் வாசி ராமாயணமே அது தான், ஆஹா! கவிச்சக்கரவர்த்தி கம்பர் காதலைப் பற்றி எப்படி வாணித்திருக்கிறார் தெரியுமா... ஒரு பாட்டு கேளு திரிசங்கு...\n\nகோமுனியுடன் வரு கொண்டல் என்றபின் தாமரைக் கண்ணினன் என்ற தன்மையால்...ஆம்...அவனே கொல் என்று ஐய நீங்கினள்...வாமமேகலையி வளர்ந்தது...\n\nம் போச்சு, அதற்கு மேல் மறந்து விட்டேன்...வா வா அதைத் தேடலாம்."
  }
]
