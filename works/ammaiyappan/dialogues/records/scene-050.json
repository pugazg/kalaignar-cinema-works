[
  {
    "id": "ammaiyappan-s050-d001",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "வே",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "அம்மா!...அம்மா!..."
  },
  {
    "id": "ammaiyappan-s050-d002",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "யாரய்யா நீங்கள்?...என்ன வேண்டும்?..."
  },
  {
    "id": "ammaiyappan-s050-d003",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "வே",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "இங்கு முத்தாயி என்பது யார்?"
  },
  {
    "id": "ammaiyappan-s050-d004",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "ஏன்!...என்ன விசேஷம்?"
  },
  {
    "id": "ammaiyappan-s050-d005",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "வே",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "முத்தன் என்பவருக்கு பகைவர்களால் தாக்குதல் ஏற்பட்டு மரணவஸ்தையில் இருக்கிறார்."
  },
  {
    "id": "ammaiyappan-s050-d006",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "ஆ!...அத்தான்!..."
  },
  {
    "id": "ammaiyappan-s050-d007",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "வே",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "நீங்கள்தானா முத்தாயி? என்னுடன் வந்தால் அவரை உயிரோடு பார்க்கலாம்..."
  },
  {
    "id": "ammaiyappan-s050-d008",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "அய்யா!...அவர் எங்கே இருக்கிறார்? என்னை அழைத்துப் போங்கள்..."
  },
  {
    "id": "ammaiyappan-s050-d009",
    "archive_scene_id": "ammaiyappan-s050",
    "archive_scene_ordinal": 50,
    "source_scene_number": null,
    "source_heading": "சுமதி வீடு",
    "speaker_label": "வே",
    "source_scene_file": "scene-050.md",
    "page_provenance": [
      {
        "pdf_page": 89,
        "printed_page": 87
      }
    ],
    "text": "சரி வாருங்கள்; காட்டுகிறேன்."
  }
]
