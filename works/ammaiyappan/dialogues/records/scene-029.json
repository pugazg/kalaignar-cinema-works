[
  {
    "id": "ammaiyappan-s029-d001",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "நானும், முத்தாயியும் காதல மணம் புரிந்து கொண்டோம். என்னை மறக்கமாட்டேன் என்று கடவுள் மேல் சத்தியம் செய்தாள்."
  },
  {
    "id": "ammaiyappan-s029-d002",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "அப்படியா!"
  },
  {
    "id": "ammaiyappan-s029-d003",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "நந்தவனத்திலே ஓடினோம்—நதியிலே நீராடினோம்—‘முத்தாயி’ என்றேன்—அவள் ‘நாதா’ என்று கூப்பிட்டாள்—கண்ணை அசைத்தாள்...கழுத்துக்கு வைர மாலை—அவள் இடை நெளிந்தது...இரத்தின ஒட்டியானம் பூட்டினேன்—நகைகள் போட்டுக் கொண்டு ஒரு சிரிப்பு சிரித்தாள்...சிங்காரி! ஒய்யாரி! கண்ணே! மயிலே! கட்டிலறைக்கு வாடி என்றேன்—வரவும் இசைந்தாள்...அதற்குள் விழித்துக் கொண்டேன்...எல்லாம் கனவு திரிசங்கு! எல்லாம் கனவு!"
  },
  {
    "id": "ammaiyappan-s029-d004",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "கனவாகாது தம்பி; இந்தத் திரிசங்கு இருக்கும் வரையில்!"
  },
  {
    "id": "ammaiyappan-s029-d005",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "தங்கமும், வைரமும் தயாரா......அதை சங்கிலியாக்குவதற்கு என் தகப்பனார் சம்மதிக்க வேண்டுமே...."
  },
  {
    "id": "ammaiyappan-s029-d006",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "அதற்குத்தான் கொஞ்சம் கஷ்டப்படவேண்டும்."
  },
  {
    "id": "ammaiyappan-s029-d007",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "கஷ்டமா?"
  },
  {
    "id": "ammaiyappan-s029-d008",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 60,
        "printed_page": 58
      }
    ],
    "text": "ஆமாம்!...அர்ச்சுனன் பாம்பரணை அல்லியை மணக்க...வேலன் கிழவனை வள்ளியை மணக்க..."
  },
  {
    "id": "ammaiyappan-s029-d009",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "நான் என்ன ஆகவேண்டுமோ தெரியவில்லை யே!"
  },
  {
    "id": "ammaiyappan-s029-d010",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "நீங்கள் அடுத்த பாளையக்காரர் ஆக வேண்டும்...அதிலென்ன சந்தேகம்?"
  },
  {
    "id": "ammaiyappan-s029-d011",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "அடே! வேதாளமா! நல்ல சமயத்தில் வந்தி ரப்பா நாதர் போல...அப்படி உட்காரும்."
  },
  {
    "id": "ammaiyappan-s029-d012",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "பாவா இல்ல—பரவாயில்ல—என்ன மந்திராலோசனை நடைபெறுகிறது,"
  },
  {
    "id": "ammaiyappan-s029-d013",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "சுருக்கமாகச் சொல்லி விடுகிறேனே; திரிசங்குவின் மகள் முத்தாயிக்கும், எனக்கும் காதல்! அது இப்போது ரொம்ப முற்றிவிட்டது!"
  },
  {
    "id": "ammaiyappan-s029-d014",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "பார்க்கும் போதே தெரியும்."
  },
  {
    "id": "ammaiyappan-s029-d015",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "முத்தாயியை நான் மணக்க அப்பா சம்மதிக்க மாட்டார்—ஏன் தெரியுமா?"
  },
  {
    "id": "ammaiyappan-s029-d016",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "அவள் உங்க அப்பா...அதனால்!"
  },
  {
    "id": "ammaiyappan-s029-d017",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "வேதாளம்! இந்த முக்கியமான நேரத்தில் ஒரு முதல் தரமான வழி சொல்லும்."
  },
  {
    "id": "ammaiyappan-s029-d018",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "இந்த வேதாளத்தின் வழி எல்லாமே குறுக்கு வழி தான். இளவரசே! நான் திருமண ஏற்பாட்டை செய்கிறேன், எப்படியாவது திருட்டுத்தனம் செய்து கல்யாணத்தை முடித்துவிட்டால் அப்புறம் அப்பா ஒத்துக் கொள்ளத் தானே வேண்டும்? உம்...அது தான் சரி...இளவரசே! ஐநூறு பொன் எடுங்கள்...உம்...சீக்கிரம் எடுங்கள் யுவராஜ்!"
  },
  {
    "id": "ammaiyappan-s029-d019",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "உம்...இந்தாரும் (கொடுக்கிறான்)"
  },
  {
    "id": "ammaiyappan-s029-d020",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "சபாஷ்! இனி திருமணம் முடிந்த மாதிரி தான்...திரிசங்கு! என் கூட வா. எல்லா ஏற்பாடுகளையும் எது எது எப்படி நடக்க வேண்டுமென்பதை நான் சொல்லித் தருகிறேன். வருகிறேன் குமார ராஜ்!"
  },
  {
    "id": "ammaiyappan-s029-d021",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      }
    ],
    "text": "வருகிறேன் தம்பி!"
  },
  {
    "id": "ammaiyappan-s029-d022",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "சுக",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 61,
        "printed_page": 59
      },
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "திரிசங்கு! வேதாளம்! உம்....அவசரத்தில் தாலி செய்ய மறந்துவிடாதீர்கள். முதலில் அதைச் செய்து\nவிட்டு பிறகு மற்ற ஏற்பாடு நடக்கட்டும்; ஆமாம்!",
    "page_segments": [
      {
        "pdf_page": 61,
        "printed_page": 59,
        "text": "திரிசங்கு! வேதாளம்! உம்....அவசரத்தில் தாலி செய்ய மறந்துவிடாதீர்கள். முதலில் அதைச் செய்து"
      },
      {
        "pdf_page": 62,
        "printed_page": 60,
        "text": "விட்டு பிறகு மற்ற ஏற்பாடு நடக்கட்டும்; ஆமாம்!"
      }
    ]
  },
  {
    "id": "ammaiyappan-s029-d023",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "முத்தாயி! முத்தாயி! என்னம்மா இப்படி வருத்தப்பட்டுக் கொண்டே இருக்கிறாய்?"
  },
  {
    "id": "ammaiyappan-s029-d024",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "காரணமா கேட்கிறீர்கள்?"
  },
  {
    "id": "ammaiyappan-s029-d025",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "நீ சந்தோஷமாக இருக்க வேண்டுமென்பதற்காகத் தானே நான் இவ்வளவு கஷ்டப்படுகிறேன்."
  },
  {
    "id": "ammaiyappan-s029-d026",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "அப்பா! போதும்! [அழுகிறாள்]"
  },
  {
    "id": "ammaiyappan-s029-d027",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "இப்போது என்னம்மா வந்து விட்டது? ஆறுதலாக இரு!"
  },
  {
    "id": "ammaiyappan-s029-d028",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "மல்லிகைக் கொடியின் வேரை அறுத்து விட்டு அதன் மலருக்கு நீர் ஊற்றி என்னப்பா பயன்?"
  },
  {
    "id": "ammaiyappan-s029-d029",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "வேரை நான் அறுக்க மாட்டேனம்மா. உற்சாகமாயிரு, மடத்திலே குருபூஜை வேறு நடக்கப் போகிறது. ஊரெல்லாம் ஒரே கொண்டாட்டமாயிருக்கும். நீயும் குதூகலமாயிரம்மா..."
  },
  {
    "id": "ammaiyappan-s029-d030",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "ஒளிக்குப் பக்கத்திலே இருந்தாலும் நிழல் இருளாகத்தானே இருக்கும். உற்சாக நிகழ்ச்சிகள் எவ்வளவு இருந்தாலும் என் உடைந்த உள்ளத்திற்கு மருந்தேது தந்தையே?"
  },
  {
    "id": "ammaiyappan-s029-d031",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "கவலைப்படாதே! எல்லாம் உன் இஷ்டப்படியே நடக்கும். நான் செய்த தவறுகளை மறந்துவிடு. பாழும் பொருளாசையால் பைத்தியக்காரன் போல் நடந்துவிட்டேன். உங்கள் தூய்மையான அன்பைத் துண்டாட நினைத்த இந்த துரோகியை மன்னித்துவிடம்மா."
  },
  {
    "id": "ammaiyappan-s029-d032",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "அப்பா! அப்பா!"
  },
  {
    "id": "ammaiyappan-s029-d033",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "அழாதே! உன்னையும், முத்தனையும் சேர்த்து வைக்கத் தீர்மானித்துவிட்டேன்."
  },
  {
    "id": "ammaiyappan-s029-d034",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      }
    ],
    "text": "என்னப்பா சொல்கிறீர்கள்?"
  },
  {
    "id": "ammaiyappan-s029-d035",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 62,
        "printed_page": 60
      },
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "கேளம்மா-நீ முத்தனைக் காதலிக்கிற விஷயம் பாளையக்காரருக்கு தெரிந்துவிட்டது. சுகதேவனுக்கும்,\nஉனக்கும் திருமணம் நடக்க விரும்பாத பாளையக்காரர், உன்னை உடனே முத்தனுக்கு மணமுடிக்கும்படி கட்டளை யிட்டு விட்டார்.",
    "page_segments": [
      {
        "pdf_page": 62,
        "printed_page": 60,
        "text": "கேளம்மா-நீ முத்தனைக் காதலிக்கிற விஷயம் பாளையக்காரருக்கு தெரிந்துவிட்டது. சுகதேவனுக்கும்,"
      },
      {
        "pdf_page": 63,
        "printed_page": 61,
        "text": "உனக்கும் திருமணம் நடக்க விரும்பாத பாளையக்காரர், உன்னை உடனே முத்தனுக்கு மணமுடிக்கும்படி கட்டளை யிட்டு விட்டார்."
      }
    ]
  },
  {
    "id": "ammaiyappan-s029-d036",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "ஆகா! அவர்கள் சுயநலம் என் சோகத்தைத் துடைத்துவிட்டது."
  },
  {
    "id": "ammaiyappan-s029-d037",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "முத்தனை விடுதலை செய்யுமாறு பாளையக்காரர் கேட்டுக் கொண்டிருக்கிறார். அவர்களும் அவனை விட்டுவிடுவார்கள்."
  },
  {
    "id": "ammaiyappan-s029-d038",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "வந்துவிடுவாரா அவர்?"
  },
  {
    "id": "ammaiyappan-s029-d039",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "இங்கு வரமாட்டான்...ஏன் தெரியுமா? சுகதேவன் உன்னைத் தூக்கிப்போய் கல்யாணம் செய்து கொள்ள முடிவு செய்திருக்கிறான். அதிலிருந்து தப்புவதற்கு உடனே நாமிருவரும் ஆனந்தபுரம் என்ற ஊருக்குச் செல்ல வேண்டும் என்பது பாளையக்காரர் யோசனை. அங்கே முத்தன் வருவான். உங்கள் திருமணம் உடனே முடிந்துவிடும். எல்லா ஏற்பாடுகளையும் உன் நன்மைக்காக பாளையக்காரர் ஆட்களே கவனிக்கிறார்கள்."
  },
  {
    "id": "ammaiyappan-s029-d040",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "அப்பா! என்னையே என்னால் நம்பமுடியவில்லையே! இன்பமான செய்தியைக் கொண்டுவந்த உங்களை வணங்குகிறேன். நான் ஏதாவது வேகத்தில் பேசியிருந்தால் என்னை மன்னித்து விடுங்கள் அப்பா."
  },
  {
    "id": "ammaiyappan-s029-d041",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "திரி",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "சரியம்மா! உடனே ஆனந்தபுரம் புறப்பட ஏற்பாடுகளைக் கவனிப்போம்..."
  },
  {
    "id": "ammaiyappan-s029-d042",
    "archive_scene_id": "ammaiyappan-s029",
    "archive_scene_ordinal": 29,
    "source_scene_number": null,
    "source_heading": "சுகதேவன் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-029.md",
    "page_provenance": [
      {
        "pdf_page": 63,
        "printed_page": 61
      }
    ],
    "text": "வேறு என்ன வேலையப்பா அதைவிட எனக்கு?"
  }
]
