[
  {
    "id": "ammaiyappan-s025-d001",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "அடே நாய்க்குட்டிப் பயலே, வெளியிலே என்னடா வேலை...போ...உள்ளே!...யாரம்மா நீ என்ன வேண்டும்?"
  },
  {
    "id": "ammaiyappan-s025-d002",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "ஓ...நீங்களா!...ம். முத்தனை பார்த்தீர்களா?"
  },
  {
    "id": "ammaiyappan-s025-d003",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "நானும் முத்தனுக்காகத்தான் அலைந்து கொண்டிருக்கிறேன்."
  },
  {
    "id": "ammaiyappan-s025-d004",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "சும",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "அவரை நான் பார்க்க வேண்டுமே."
  },
  {
    "id": "ammaiyappan-s025-d005",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "ஊகும். அவனைப் பார்க்கவே முடியாது...அவன் பாசறைச் சிறையில் போட்டுவிட்டார்கள். அவன் விடுவிப்பதாயின் நூறு பொன் வேண்டும்..."
  },
  {
    "id": "ammaiyappan-s025-d006",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "சும",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "அதைத்தான் கொண்டு வந்திருக்கிறேன்...இதோ இதை தயவு செய்து அவரிடம் கொடுக்க முடியுமா?..."
  },
  {
    "id": "ammaiyappan-s025-d007",
    "archive_scene_id": "ammaiyappan-s025",
    "archive_scene_ordinal": 25,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-025.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "கொடுக்க முடியுமாவா?...அதைவிட எனக்கு வேறு வேலை? அன்பான பெண்ணே! நல்லகாரியம் செய்தாய்...முத்தன் சார்பாக உனக்கு என் நன்றி...இதோ இப்போதே போய் அவனை மீட்கிறேன்..."
  }
]
