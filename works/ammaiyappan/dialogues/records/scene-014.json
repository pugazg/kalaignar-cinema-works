[
  {
    "id": "ammaiyappan-s014-d001",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "முத்தா!..."
  },
  {
    "id": "ammaiyappan-s014-d002",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "இளையராணி! என்னவேண்டும் தங்களுக்கு?..."
  },
  {
    "id": "ammaiyappan-s014-d003",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "ஒன்று மில்லை...உனக்கும் சுகதேவனுக்கும்..."
  },
  {
    "id": "ammaiyappan-s014-d004",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "ஆமாம் ராணி...ஏதோ ஆத்திரத்தில்...."
  },
  {
    "id": "ammaiyappan-s014-d005",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "உம்...யார் அந்த முத்தாயி...?"
  },
  {
    "id": "ammaiyappan-s014-d006",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "(திகைப்பு; மெளனம்...)"
  },
  {
    "id": "ammaiyappan-s014-d007",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "சொல்ல மாட்டாயா?...உன் உள்ளத்தைக்\nகொள்ளை கொண்ட அவள்யார்?....அழகிதானா?....அருங்\nகுணவதியா?...உனக் கேற்ற சுந்தரிதானா?...சொல்ல மாட்\nடாயா?...முத்தா!....அந்தப் பெண்ணுக்காக—நீயும் இள\nவரசனும் பெரிய யுத்தமே நடத்தி இருக்கிறீர்களா?...."
  },
  {
    "id": "ammaiyappan-s014-d008",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "அம்மணி!...."
  },
  {
    "id": "ammaiyappan-s014-d009",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "உங்கள் தகராறின் விளைவு என்ன ஆகி விட்\nடது தெரியுமா...? உன்னுடைய வேலைக்கே ஆபத்து வந்து\nவிட்டது...\n\nஉன்னைப் பார்த்துக் கொண்டிருக்கும் பாக்கியத்தை\nயும் இந்தப் பாவி இழந்து விட்டேன்..."
  },
  {
    "id": "ammaiyappan-s014-d010",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "இளையராணி!..."
  },
  {
    "id": "ammaiyappan-s014-d011",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "அப்படி அழைக்காதே..."
  },
  {
    "id": "ammaiyappan-s014-d012",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "சுக",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "என்ன எதிர்ப்பதா?...என்னை எதிர்க்க ஈரேழு பதினறு லோகத்திலும் மனிதர்கள் உண்டா? என்ன திரு\nசங்கு..."
  },
  {
    "id": "ammaiyappan-s014-d013",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "திரி",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "ஊகூம்..."
  },
  {
    "id": "ammaiyappan-s014-d014",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "சுக",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "பதினொரு லோகத்தில் என்ன? சந்திரமண்ட\nலத்திலும் மனிதர் கிடையாது..சூரியமண்டலத்திலும் கிடை\nயாது...நட்சத்திர மண்டலத்திலும் கிடையாது..."
  },
  {
    "id": "ammaiyappan-s014-d015",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "திரி",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "கிடையாது தம்பி...கிடையாது...உங்களே\nஎதிர்க்க ஒருத்தரும் கிடையாது..."
  },
  {
    "id": "ammaiyappan-s014-d016",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "சுக",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "ஒருத்தன் இருக்கான்—அவனும் அழிஞ்சான்;\n...யாரு?...அவன்தான் இந்த முத்தன்...ஏ, முத்தா!...நீ\nசெய்த குற்றத்திற்காக வழக்கு...விசாரணை...தீர்ப்பு...எது\nவும் கிடையாது...தண்டனையை ஏற்றுக் கொள்......\nஉனக்கு இனி இங்கு வேலை கிடையாது..."
  },
  {
    "id": "ammaiyappan-s014-d017",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 30,
        "printed_page": 28
      }
    ],
    "text": "நன்றி..."
  },
  {
    "id": "ammaiyappan-s014-d018",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "சுக",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      }
    ],
    "text": "நன்றியா?...அங்கீகரிக்க முடியாது. திருப்பப்\nபெற்றுக் கொள்...திரிசங்கு...அரண்மனை வேலை மட்டு\nமல்ல ஊர்முழுதும் அறிவித்து விடு!...நமது அதிகாரத்திற்கு\nஉட்பட்ட எந்த இடத்திலும் யாரும் இந்தப் பயலுக்கு\nவேலை கொடுக்கக் கூடாது...வேலை கொடுத்தால்—வால்\nநறுக்கி விடுவேன்...தோல் உரித்து விடுவேன்...கால்\nமுறித்து விடுவேன்...ஓலை கிழித்து விடுவேன்..."
  },
  {
    "id": "ammaiyappan-s014-d019",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      }
    ],
    "text": "ஏன்!...இனிமேல் சொல்ல 'ஓ' கிடை\nயாதா?...மாலையைப் பிய்த்து விடுவேன் என்று சொல்லுமே!"
  },
  {
    "id": "ammaiyappan-s014-d020",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "சுக",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      }
    ],
    "text": "என்ன...என்ன...மாலையைப் பிய்க்கிறதா?...\nநான் என்ன குரங்கா? உம்...டேய் முத்தா! மறுபடியும்\nஉனக்கும் எனக்கும் பெரிய போர் ஆரம்பமாகப் போகிறது\n...மரியாதையாக உடனே அரண்மனையை விட்டு வெளியே\nபோ!...தகப்பன் பெயர் தெரியாதக் கழுதை!..."
  },
  {
    "id": "ammaiyappan-s014-d021",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "சுக",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      }
    ],
    "text": "வா!...திருசங்கு!..."
  },
  {
    "id": "ammaiyappan-s014-d022",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      }
    ],
    "text": "முத்தா!...போகும்போது என் மாளிகைப்\nபக்கம் வந்து விட்டுப் போ!...மறந்து விடாதே...அவசியம்\nவரவேண்டும்...கட்டாயம் வா..."
  },
  {
    "id": "ammaiyappan-s014-d023",
    "archive_scene_id": "ammaiyappan-s014",
    "archive_scene_ordinal": 14,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-014.md",
    "page_provenance": [
      {
        "pdf_page": 31,
        "printed_page": 29
      }
    ],
    "text": "என் வாழ்க்கையே குழப்பமாகி விட்டது..."
  }
]
