[
  {
    "id": "ammaiyappan-s021-d001",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "வரும் வரையில்தான் குளித்துக் கொண்டிரேன்...வெல்லத்தாலா செய்திருக்கிறது உன் உடம்பு...தண்ணீரில் கரைந்துவிட..."
  },
  {
    "id": "ammaiyappan-s021-d002",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "சுமதி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "என் உடம்பு வெல்லமல்ல...இப்போ வந்து வர்ணிப்பார் பார்...அப்போ தெரியும் யார் உடம்பு வெல்லமென்று....(ஆண்போல்) கற்கண்டே! தேனே! காய்ச்சிய பாலே!"
  },
  {
    "id": "ammaiyappan-s021-d003",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "போடி வாயாடி."
  },
  {
    "id": "ammaiyappan-s021-d004",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "ஏன் வருத்தமாக இருக்கிறீர்கள்? இதை சாப்பிடுங்கள்."
  },
  {
    "id": "ammaiyappan-s021-d005",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "வேண்டாம்."
  },
  {
    "id": "ammaiyappan-s021-d006",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "ஓ! இரண்டு நாட்களாக வரவில்லையே—நான் கோபித்துக் கொள்வேன் என்று முந்திக் கொள்கிறீர்களா?\n\nஎனக்கொன்றும் கோபமில்லை. கையிலே இருக்கும் மை எழுதும் கோல் புருவத்துக்கருகே வந்துவிட்டால் கண்ணுக்குத் தெரியாமல் மறைந்து விடுமாம். அதுமாதிரி நீங்கள் என்னருகே வந்துவிட்டதும் நீங்கள் செய்த தவறெல்லாம் எனக்கு மறைந்து விடுகிறது."
  },
  {
    "id": "ammaiyappan-s021-d007",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "முத்தாயி! இரண்டு நாள் வாரத்திற்கே இப்படி வருந்துகிறாயே—நாம் சந்திக்கவே முடியாத அந்த இருண்ட நாட்களை நினைக்கவே பயமாக இருக்கிறது."
  },
  {
    "id": "ammaiyappan-s021-d008",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "என்ன...என்ன சொல்கிறீர்கள்?"
  },
  {
    "id": "ammaiyappan-s021-d009",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "என் சோலைக் குயிலே! நீ கூவமுடியாத பாலைவனமாகிவிட்டேன் நான்."
  },
  {
    "id": "ammaiyappan-s021-d010",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      }
    ],
    "text": "நீங்கள் பாலைவனமானால் நான் அதிலே வளரும் பேரிச்ச மரம்."
  },
  {
    "id": "ammaiyappan-s021-d011",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 45,
        "printed_page": 43
      },
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "விளையாடாதே முத்தாயி விளையாடாதே...விண்மீன்போல் கண்சிமிட்டி, வெள்ளி முத்துப் பல் காட்டி, அள்ளிவரும் புள்ளி மயில் சாயல் காட்டி,\nவேடிக்கை காட்டி, என் மடியில் விளையாடி, என் விழியில் சதிராடும் மாகமே! மாணிக்க மலர்க் கொத்தே! அந்த விளையாட்டெல்லாம் மண்மூடிப் போக வேண்டிய காலம் வந்துவிட்டது கண்மணி.",
    "page_segments": [
      {
        "pdf_page": 45,
        "printed_page": 43,
        "text": "விளையாடாதே முத்தாயி விளையாடாதே...விண்மீன்போல் கண்சிமிட்டி, வெள்ளி முத்துப் பல் காட்டி, அள்ளிவரும் புள்ளி மயில் சாயல் காட்டி,"
      },
      {
        "pdf_page": 46,
        "printed_page": 44,
        "text": "வேடிக்கை காட்டி, என் மடியில் விளையாடி, என் விழியில் சதிராடும் மாகமே! மாணிக்க மலர்க் கொத்தே! அந்த விளையாட்டெல்லாம் மண்மூடிப் போக வேண்டிய காலம் வந்துவிட்டது கண்மணி."
      }
    ]
  },
  {
    "id": "ammaiyappan-s021-d012",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "என்ன...யார் பேசுவது இப்படி...என் முத்தனா? என் முத்தனா?"
  },
  {
    "id": "ammaiyappan-s021-d013",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "உன் முத்தனில்லை...முத்தன் பேசவில்லை; வேங்கை புரத்து வீரன் பேசுகிறான் கண்ணே, வேங்கை புரத்து வீரன் பேசுகிறான்."
  },
  {
    "id": "ammaiyappan-s021-d014",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "ஆ! வேங்கைபுரத்து வீரன்!"
  },
  {
    "id": "ammaiyappan-s021-d015",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "ஆமாம்!"
  },
  {
    "id": "ammaiyappan-s021-d016",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "என்ன ஆமாம்?...யாரைக் கேட்டுக் கொண்டு வேங்கைபுரத்து வீரனாக மாறினீர்கள்?"
  },
  {
    "id": "ammaiyappan-s021-d017",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      }
    ],
    "text": "நான் யாரைக் கேட்டது?...ஏழை முத்தனைக் கேட்டேன்...முத்தாயி மாளிகை ராணியாக வேண்டியவள்....அவள் எண்ணத்தை விட்டு விடு என்றான்...காதல் முத்தனே கண்ணீர் விட்டான்...காகரத்த குரலிலே, கம்பிய தொனியிலே ஏழை முத்தன் கட்டளை யிட்டான்...முத்தாயியை மறந்துவிடு என்று...மறந்து விட்டேன்...என் சிங்காரியை மறந்துவிட்டேன்...என் சிந்தையில் குடியேறிய செல்வத்தை மறந்துவிட்டேன்...உன் தந்தைக்கு அளித்த வாக்குறுதியை நிறைவேற்ற வேறு வழி இல்லை...வழி இருந்தால் பழுதாரை அடிமையாக்கி இருக்கும் பகைவனின் படையிலே சேருவேனா நான்."
  },
  {
    "id": "ammaiyappan-s021-d018",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 46,
        "printed_page": 44
      },
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "நீங்கள் மறக்கும்படியாக நான் என்ன குற்றம் செய்துவிட்டேன், பேராசைக்காரத் தகப்பனுக்குப் பெண்ணாகப் பிறந்ததைத் தவிர,...காதல் என்றால் என்ன? கண்டவர் உருவத்தையும் பிரதிபலிக்கும் கண்ணாடியா? கீற்று எழுதும் சித்திரமா? அழியாத ஓவியம்—அசையாத இமயம் காதல் என்று எண்ணியிருந்தேன்—அது பைத்தியக்காரத்தனந்தானா? சந்தைப் பொருளென என்னை எண்ணிவிட்ட தந்தைக்கும் உங்களுக்கும் என்னதான் வித்தியாசம்? என் சிலையாகி\nவிட்டார்கள்? காதலன் மறந்துவிட்டான். காதலி வேறிடம் பறந்துவிட்டாள்; என்று என் சரித்திரம் முடியாது துரையே...அம்பிகாபதி காவியத்தை அழித்தெழுத எண்ணுகிறீர்கள். அரசன் மகள் அமராவதி மட்டுமல்ல காதலே; அடிமையின் மகள் முத்தாயிக்கும் காதல் உள்ளம் இருக்கிறது! அதைக் காட்சியாக்கிக் காட்டுகிறேன் அதோ, அந்த ஆடும் மரக் கிளையில்...ஓடும் வெள்ளத்தில்...இரண்டிலொன்றில் என் பிணத்தைப் பார்க்கத் தயாராகிக் கொள்ளுங்கள்!",
    "page_segments": [
      {
        "pdf_page": 46,
        "printed_page": 44,
        "text": "நீங்கள் மறக்கும்படியாக நான் என்ன குற்றம் செய்துவிட்டேன், பேராசைக்காரத் தகப்பனுக்குப் பெண்ணாகப் பிறந்ததைத் தவிர,...காதல் என்றால் என்ன? கண்டவர் உருவத்தையும் பிரதிபலிக்கும் கண்ணாடியா? கீற்று எழுதும் சித்திரமா? அழியாத ஓவியம்—அசையாத இமயம் காதல் என்று எண்ணியிருந்தேன்—அது பைத்தியக்காரத்தனந்தானா? சந்தைப் பொருளென என்னை எண்ணிவிட்ட தந்தைக்கும் உங்களுக்கும் என்னதான் வித்தியாசம்? என் சிலையாகி"
      },
      {
        "pdf_page": 47,
        "printed_page": 45,
        "text": "விட்டார்கள்? காதலன் மறந்துவிட்டான். காதலி வேறிடம் பறந்துவிட்டாள்; என்று என் சரித்திரம் முடியாது துரையே...அம்பிகாபதி காவியத்தை அழித்தெழுத எண்ணுகிறீர்கள். அரசன் மகள் அமராவதி மட்டுமல்ல காதலே; அடிமையின் மகள் முத்தாயிக்கும் காதல் உள்ளம் இருக்கிறது! அதைக் காட்சியாக்கிக் காட்டுகிறேன் அதோ, அந்த ஆடும் மரக் கிளையில்...ஓடும் வெள்ளத்தில்...இரண்டிலொன்றில் என் பிணத்தைப் பார்க்கத் தயாராகிக் கொள்ளுங்கள்!"
      }
    ]
  },
  {
    "id": "ammaiyappan-s021-d019",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "முத்தாயி; பட்டாளத்தில் பெயரைப்பதிவு செய்து விட்டேனே...என்ன செய்வது?"
  },
  {
    "id": "ammaiyappan-s021-d020",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "செய்தால் என்ன? நூறு பொன் அபராதம் செலுத்தினால் விலகிக் கொள்ளலாம் என்பது எனக்குத் தெரியும்."
  },
  {
    "id": "ammaiyappan-s021-d021",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "அபராதமா?"
  },
  {
    "id": "ammaiyappan-s021-d022",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "ஏன் அபராதங் கட்டுவது அவமானம் என்கிறீர்களா? எதிர்நாட்டுக்குக் கூலிப்பட்டாளமாகச் செல்வதைவிட இது ஒன்றும் அவமானம் அல்ல...சிறைச்சாலைக்குப் பயந்து கட்டும் அபராதம் அல்லவே இது."
  },
  {
    "id": "ammaiyappan-s021-d023",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "முத்தாயி!"
  },
  {
    "id": "ammaiyappan-s021-d024",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "நான் சொல்வதைக் கேளுங்கள்; என் திருமணத்துக்காக நூறு பொன் அப்பா சேர்த்து வைத்து யாருக்கும் தெரியாமல் பூட்டி வைத்திருக்கிறார். அது இதற்கில்லாமல் வேறு எதற்கு? சுமதியிடம் கொடுத்து அனுப்புகிறேன். அதை வாங்கி கட்டி விலகிக் கொள்ளுங்கள்."
  },
  {
    "id": "ammaiyappan-s021-d025",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "இதைக் கேள்..."
  },
  {
    "id": "ammaiyappan-s021-d026",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "எதையும் கேட்க மாட்டேன்...நீங்கள் விலகவேண்டும்...இல்லாவிட்டால் நான்..."
  },
  {
    "id": "ammaiyappan-s021-d027",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "முத்தாயி! விலகி விடவா?"
  },
  {
    "id": "ammaiyappan-s021-d028",
    "archive_scene_id": "ammaiyappan-s021",
    "archive_scene_ordinal": 21,
    "source_scene_number": null,
    "source_heading": "ஆற்றங்கரை சோலையோரம்",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-021.md",
    "page_provenance": [
      {
        "pdf_page": 47,
        "printed_page": 45
      }
    ],
    "text": "என்னிடம் இருந்தல்ல...படையிலிருந்து இதை சாப்பிடுங்கள்."
  }
]
