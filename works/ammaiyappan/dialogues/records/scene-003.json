[
  {
    "id": "ammaiyappan-s003-d001",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பல",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "பூங்காவனம்-பூங்காவனம்.......\n\nபூங் ; என்ன அண்ணா...என்ன விசேஷம்......."
  },
  {
    "id": "ammaiyappan-s003-d002",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பல",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "விசேஷமா! உனக்கு அண்ணனைப் பிறந்து விட்டு, விசேஷம் வேறு எனக்கு. இதோ பார் வேங்கை நாட்டரசன் ஓலையனுப்பி இருக்கிறான்......"
  },
  {
    "id": "ammaiyappan-s003-d003",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "எப்போதும் போல என் திருமணத்தைப் பற்றித்தானே......"
  },
  {
    "id": "ammaiyappan-s003-d004",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பல",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "திருமணமா? அதைத்தான் அவன் மறந்து விட்டானே...இப்போது வந்திருக்கும் ஓலை...அரை லட்சம் பொன்னுக்கு...அவசர உத்திரவு. கப்பம் கட்டித்தீர வேண்டும் பூங்காவனம்...கப்பம் கட்டித் தீரவேண்டும்..."
  },
  {
    "id": "ammaiyappan-s003-d005",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 7
      }
    ],
    "text": "வழக்கம் தானே அண்ணா இது!..."
  },
  {
    "id": "ammaiyappan-s003-d006",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பல",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 10,
        "printed_page": 8
      }
    ],
    "text": "வழக்கமா? பூங்காவனம் யோசித்துப்பார்....நீ அந்த வேங்கைபுரத்தாரை விவாகம் செய்து கொள்ள ஒப்புக் கொண்டிருந்தால் இந்த பதினைந்து வருட காலமாக எத்தனை லட்சம் பொன் மீதமாயிருக்கும்—கொட்டிக் கொட்டி அழுதிருக்கிறேனே அந்த கொடுமையாளர் ஆட்சி பீடத்துக்கு......"
  },
  {
    "id": "ammaiyappan-s003-d007",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 10,
        "printed_page": 8
      }
    ],
    "text": "அதற்காக...என் அபிப்பிராயத்தை மாற்றிக் கொள்ள முடியுமா?......"
  },
  {
    "id": "ammaiyappan-s003-d008",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பல",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 10,
        "printed_page": 8
      }
    ],
    "text": "அபிப்பிராயம், பெரிய அபிப்பிராயம்!....பல வருஷ காலமாக உன்னைத் திருமணம் செய்து கொள்ள முயற்சித்து கடைசியில் பிரமச்சரிய விரதம் பூண்டிருக்கிறான்....வேங்கை நகர் மன்னன்...நீயோ அவனை வெறுக்கிறாய்......"
  },
  {
    "id": "ammaiyappan-s003-d009",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பூங்",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 10,
        "printed_page": 8
      }
    ],
    "text": "அண்ண...திருமணப் பேச்சு பேச வேண்டிய நேரமோ, பருவமோ இல்ல ைஎனக்கு...தயவு செய்து என்னை நிம்மதியாக இருக்க விடுங்கள்...அந்தப் பாழும் கல்யாணப் பேச்சு வேண்டாம்! வேண்டவே வேண்டாம்."
  },
  {
    "id": "ammaiyappan-s003-d010",
    "archive_scene_id": "ammaiyappan-s003",
    "archive_scene_ordinal": 3,
    "source_scene_number": null,
    "source_heading": "பூங்காவனம் அறை",
    "speaker_label": "பல",
    "source_scene_file": "scene-003.md",
    "page_provenance": [
      {
        "pdf_page": 10,
        "printed_page": 8
      }
    ],
    "text": "இப்படி அழுது அழுது தான் பழுதாரையே பாழ்படுத்திவிட்டாய் நீ...உன்னோடு பேசி என்ன பயன் எனக்கு......"
  }
]
