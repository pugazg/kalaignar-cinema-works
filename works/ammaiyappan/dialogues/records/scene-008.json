[
  {
    "id": "ammaiyappan-s008-d001",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "முத்தாயி!...முத்தாயி!"
  },
  {
    "id": "ammaiyappan-s008-d002",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "என்னப்பா?......"
  },
  {
    "id": "ammaiyappan-s008-d003",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "ஏங்கம்மா போயிட்டே? உன்னை நான் எங்கெல்லாம் தேடறது...யாரு வந்திருக்கான்னு பாரு ... தம்பி வாங்க. சீ...சீ...உன்னையாரு கூப்பிட்டது...?"
  },
  {
    "id": "ammaiyappan-s008-d004",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "வணக்கம் !..."
  },
  {
    "id": "ammaiyappan-s008-d005",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "வாழ்க!... வாழ்க!... ஆஹா!... கைகள் குவிவதும் விரிவதும் கமல மலர்போல் காட்சியளிக்கிறது. திரிசங்கு; நீ சொன்னது அவ்வளவும் உண்மைதான் ... ஐயோ பாவம்! வெட்கத்தால் கண்ணங்கள் சிவந்தே விட்டன, மிளகாய் பழம்போல்—"
  },
  {
    "id": "ammaiyappan-s008-d006",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "பார்த்த உடனேயே இப்படி பரிகாசம் செய்யலாமா தம்பி நீங்கள்."
  },
  {
    "id": "ammaiyappan-s008-d007",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "ஆங்...என்ன சொன்னேன்?...எனக்குத் தெரியாமலே ஏதாவது சொல்லிவிட்டேனா என்ன? ...ம்... திரிசங்கு உன்னை ஒன்று கேட்கிறேன்...மறுக்க மாட்டாயே..."
  },
  {
    "id": "ammaiyappan-s008-d008",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "நீங்கள் பாளையக்காரர் பலதேவரின் மகன் ... இளவரசர்...நான் கேவலம் உங்கள் வேலைக்காரன். கேட்காமலேயே எடுத்துப் போகும் உரிமை இருக்கிறது உங்களுக்கு ...."
  },
  {
    "id": "ammaiyappan-s008-d009",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "ஆஹாஹா ... த்சு...த்சு...கண்கள் சுழலுகின்றன...காது கேட்க மறுக்கிறது ... நா அசைய மாட்டேன் என்கிறது...அய்யய்யோ! இருதயம் ஓடவே இல்லை......"
  },
  {
    "id": "ammaiyappan-s008-d010",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      }
    ],
    "text": "தம்பி!... தம்பி!... என்ன இது ... நான்போய் வைத்தியரை அழைத்து வாட்டுமா ....?"
  },
  {
    "id": "ammaiyappan-s008-d011",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 17
      },
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "வேண்டாம் வேண்டாம், இது வைத்தியமில்லாத வியாதி...கண்ணொடு கண்ணோக் கொக்கின் ... அதா\nவது காதல் எனும் கள்ளமொந்தையில் ஒரு ஈ போல வீழ்ந்து விட்டேன்!",
    "page_segments": [
      {
        "pdf_page": 19,
        "printed_page": 17,
        "text": "வேண்டாம் வேண்டாம், இது வைத்தியமில்லாத வியாதி...கண்ணொடு கண்ணோக் கொக்கின் ... அதா"
      },
      {
        "pdf_page": 20,
        "printed_page": 18,
        "text": "வது காதல் எனும் கள்ளமொந்தையில் ஒரு ஈ போல வீழ்ந்து விட்டேன்!"
      }
    ]
  },
  {
    "id": "ammaiyappan-s008-d012",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "தம்பி!...இன்றுபோய் நாளை வாருங்கள்; காரியம் வெற்றி......"
  },
  {
    "id": "ammaiyappan-s008-d013",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "“இன்றுபோய் நாளைவா” ... அடடே! இந்த வார்த்தையை எங்கேயோ கேட்டமாதிரி இருக்கிறதே ... உம்...ஆமாம், கம்பராமாயணத்தில் ... இராமன் இராவணனை அப்படித்தான் வாய்சொல்லுகிறான் ... அய்யோ! மறுநாள் வந்த இராவணனுக்கு வெற்றி கிடைக்கவில்லையே; மரணமல்லவா கிடைக்கிறது......"
  },
  {
    "id": "ammaiyappan-s008-d014",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "மறுநாள் வந்த ராமனுக்கு வெற்றிதானே... தம்பி..."
  },
  {
    "id": "ammaiyappan-s008-d015",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "ஓ!...அப்படியானால் இந்த ராமன் கட்டாயம் நாளை வருவான்..."
  },
  {
    "id": "ammaiyappan-s008-d016",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "கட்டாயம் வாருங்கள்..."
  },
  {
    "id": "ammaiyappan-s008-d017",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "சுக",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "வாராமல் இருப்பேனோ?—திருசங்கு வீடு ஒரு தாமரைத் தடாகம்; அங்கு பறந்து வரும் வண்டு இந்த சுகதேவ்...வருகிறேன். திருசங்கு..."
  },
  {
    "id": "ammaiyappan-s008-d018",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "சரி தம்பி!..."
  },
  {
    "id": "ammaiyappan-s008-d019",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "முத்தாயி!...முத்தாயி!..."
  },
  {
    "id": "ammaiyappan-s008-d020",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "என்னப்பா! போய்விட்டாரா அந்த மனிதர்?..."
  },
  {
    "id": "ammaiyappan-s008-d021",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "மனிதரா?..."
  },
  {
    "id": "ammaiyappan-s008-d022",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "இல்லை...இல்லை...மன்னிக்கவும்; தவறிச் சொல்லி விட்டேன்..."
  },
  {
    "id": "ammaiyappan-s008-d023",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "மன்னிப்பதா...இளவரசரே வீட்டுக்கு வந்திருக்கிறார்...இப்படித்தான் அவமானப் படுத்துவதா?..."
  },
  {
    "id": "ammaiyappan-s008-d024",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "இளவரசர்...ம்...மோசமான வாலிபன்..."
  },
  {
    "id": "ammaiyappan-s008-d025",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 20,
        "printed_page": 18
      }
    ],
    "text": "யார் மோசம்? அவனுக்கென்ன அழகிலே குறைவா?...அந்தஸ்திலே குறைவா?...அசட்டுப் பெண்ணே—அவனுடைய அறிவை நீ உணரமாட்டாய்.."
  },
  {
    "id": "ammaiyappan-s008-d026",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "உணர முடியாத அளவுக்கு இந்த உத்தமரின் அறிவு ஊசி முனையைவிடச் சிறியது போலும்! இல்லையா அப்பா?..."
  },
  {
    "id": "ammaiyappan-s008-d027",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "போதும் நிறுத்து-அவன் நினைத்தால் ஊர்வசி ரம்பையெல்லாம் ஓடிவருவார்கள்..."
  },
  {
    "id": "ammaiyappan-s008-d028",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "இதிலென்னப்பா ஆச்சரியம்? ஆஸ்தானத்து முனிவர்களிடமே ஓடிவந்தவர்கள் அரண்மனைக்காரர்கள் அழைத்தால் அட்டியா சொல்லப் போகிறார்கள்! வருவார்கள் அப்பா வருவார்கள்—"
  },
  {
    "id": "ammaiyappan-s008-d029",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "வாயைமூடு வாயாடி! நான் கெஞ்சிக் கூத்தாடி அவனை வீட்டுக்கு அழைத்து வந்தேன்; நீ அவர் முகத்தில் கரி பூசி அனுப்பிவிட்டாய்."
  },
  {
    "id": "ammaiyappan-s008-d030",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "இல்லையே—அதற்குள்ளதான் போய் விட்டாரே—அப்பா! அப்பா! அவர் முகத்தில் கரி பூசினால் இன்னும் அழகாக இருப்பார் கார்மேக வண்ணன் போல."
  },
  {
    "id": "ammaiyappan-s008-d031",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திருசங்கு",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "ஜாக்கிரதை—காதில் விழுந்தால் கண்ணைப் பிடுங்கி விடுவார்."
  },
  {
    "id": "ammaiyappan-s008-d032",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "கண்ணப்ப நாயனாரோ?"
  },
  {
    "id": "ammaiyappan-s008-d033",
    "archive_scene_id": "ammaiyappan-s008",
    "archive_scene_ordinal": 8,
    "source_scene_number": null,
    "source_heading": "திரிசங்கு வீட்டின் கொல்லைப்புறம்.",
    "speaker_label": "திருசங்கு",
    "source_scene_file": "scene-008.md",
    "page_provenance": [
      {
        "pdf_page": 21,
        "printed_page": 19
      }
    ],
    "text": "சீ! பேச்சுக்குப் பேச்சு பதில் பேசிக் கொண்டு."
  }
]
