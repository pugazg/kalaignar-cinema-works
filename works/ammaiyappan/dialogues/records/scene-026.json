[
  {
    "id": "ammaiyappan-s026-d001",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "என்ன! எனக்கு விடுதலையா?"
  },
  {
    "id": "ammaiyappan-s026-d002",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "(சிரித்தபடி வந்து கொண்டு) விடுதலை தான், இங்கிருந்து உனக்கு விடுதலைதான், வீணனே! இந்த விடுதலைக்குப் பிறகு நீ போகவேண்டிய இடம் எது தெரியுமா? வீட்டல்ல—வேங்கைபுரம்!"
  },
  {
    "id": "ammaiyappan-s026-d003",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "என்ன! ஏன் இப்படி கொடுமை புரிகிறீர்கள்? உங்கள் அபராதத் தொகையை வாங்கிக்கொண்டு என்னை விடுதலை செய்யவேண்டியதுதானே நியாயம்?"
  },
  {
    "id": "ammaiyappan-s026-d004",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "அபராதப் பணம்—அரைக்காசுக்கு வழியற்ற உன்னிடம் எது அபராதப் பணம்? ஹ...ஹ...ஹ..."
  },
  {
    "id": "ammaiyappan-s026-d005",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "என்னை இப்படி சிறையிலே அடைத்து வைத்தால் எப்படி செலுத்த முடியும் உங்கள் அபராதத்தை? வெளியில் விடுங்கள்...விரைவில் கொண்டு வருகிறேன்."
  },
  {
    "id": "ammaiyappan-s026-d006",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "முடியாது—இங்கே வரவேண்டும்! இப்போது வந்தாலும் சரி; உன்னை விட்டுவிடுவேன்."
  },
  {
    "id": "ammaiyappan-s026-d007",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "(வேதாளத்திடம்) என்ன ஆயிற்று? கிடைத்ததா? வந்து சேர்ந்ததா?"
  },
  {
    "id": "ammaiyappan-s026-d008",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "ஹஹா—ம்! காத்துக் காத்து காலும் ஒடிந்து விட்டது. கண்ணும் பூத்துவிட்டது. காரியம் ஆகவில்லை. (வேலழகன் பக்கம் திரும்பி) பிரபு அவர்களே! அபராதப் பணம் விரைவில் வந்துவிடலாம். கொஞ்சம் தாமதித்து...."
  },
  {
    "id": "ammaiyappan-s026-d009",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      }
    ],
    "text": "சேவல் கூவவில்லையே என்று செங்கதிரோன் காத்திருப்பதில்லை. கடமையை நான் செய்ய வேண்டும்—இல்லையேல் காவலன் சீறுவார்...ம்...புறப்பட வேண்டும். விடுதலை வீரனே! நீயும் நட பின்னால்."
  },
  {
    "id": "ammaiyappan-s026-d010",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 55,
        "printed_page": 53
      },
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "நடக்கமாட்டேன்! ரத்தச் சகதியிலே தங்கள் தலைகளே செந்தாமரை மொட்டுகளாக ஆக்கிவிடத் தீர்மானித்து விட்ட விடுதலை வீரர்கள், ஆதிக்க வெறியர்களின் பின்னால் ஆடுபோல் நடக்கமாட்டார்கள்! பழுதார்\nஎன் நாடு—எனக்குத் தேன்கூடு—நீரோ தீக்காடு—சாக்காடு வரினும் சரியென்பேனே தவிர, பூக்காட்டில் புகுந்துவிட்ட புயலாம் உன்பின்னால் நான் நடக்க மாட்டேன்! சுந்தர பூமியின் பிரஜை நான்—அதைச் சுரண்டி வாழும் பிரபு நீர்; புத்தி சுவாதீனம் அற்றவனும் கூட ஒத்துக் கொள்ள மாட்டான், புலியைத் தொடர்ந்து மான் நடக்கலாம் என்று உமது புதிய திட்டத்தை—தத்துவத்தை!",
    "page_segments": [
      {
        "pdf_page": 55,
        "printed_page": 53,
        "text": "நடக்கமாட்டேன்! ரத்தச் சகதியிலே தங்கள் தலைகளே செந்தாமரை மொட்டுகளாக ஆக்கிவிடத் தீர்மானித்து விட்ட விடுதலை வீரர்கள், ஆதிக்க வெறியர்களின் பின்னால் ஆடுபோல் நடக்கமாட்டார்கள்! பழுதார்"
      },
      {
        "pdf_page": 56,
        "printed_page": 54,
        "text": "என் நாடு—எனக்குத் தேன்கூடு—நீரோ தீக்காடு—சாக்காடு வரினும் சரியென்பேனே தவிர, பூக்காட்டில் புகுந்துவிட்ட புயலாம் உன்பின்னால் நான் நடக்க மாட்டேன்! சுந்தர பூமியின் பிரஜை நான்—அதைச் சுரண்டி வாழும் பிரபு நீர்; புத்தி சுவாதீனம் அற்றவனும் கூட ஒத்துக் கொள்ள மாட்டான், புலியைத் தொடர்ந்து மான் நடக்கலாம் என்று உமது புதிய திட்டத்தை—தத்துவத்தை!"
      }
    ]
  },
  {
    "id": "ammaiyappan-s026-d011",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "பேசாதே...யாரங்கே! இந்த வீராதி வீரனுக்கு விலங்கிடுங்கள்! நமது அணி தோற்ப்பும்வரை, ஆட்பெரும் படை முன்னே செல்லட்டும்—இந்த அடிமை நாயும் பின்னே இழுத்து வரப்படட்டும்."
  },
  {
    "id": "ammaiyappan-s026-d012",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "என்ன?"
  },
  {
    "id": "ammaiyappan-s026-d013",
    "archive_scene_id": "ammaiyappan-s026",
    "archive_scene_ordinal": 26,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-026.md",
    "page_provenance": [
      {
        "pdf_page": 56,
        "printed_page": 54
      }
    ],
    "text": "உம்...உடனே..."
  }
]
