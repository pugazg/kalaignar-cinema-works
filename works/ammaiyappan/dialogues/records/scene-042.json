        "pdf_page": 86,
        "printed_page": 84
      }
    ],
    "text": "பெண்ணை வந்தொரு மாயப் பிசாசு பிடித்துண்ணே...கண்ணுல மயக்கி..."
  },
  {
    "id": "ammaiyappan-s042-d002",
    "archive_scene_id": "ammaiyappan-s042",
    "archive_scene_ordinal": 42,
    "source_scene_number": null,
    "source_heading": "மண்டபம்",
    "speaker_label": "வணிகர்",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 84
      }
    ],
    "text": "அய்யா...அய்யா! ஒரு பெண்ணையும் குழந்தையையும் பார்த்தீர்களா அய்யா?..."
  },
  {
    "id": "ammaiyappan-s042-d003",
    "archive_scene_id": "ammaiyappan-s042",
    "archive_scene_ordinal": 42,
    "source_scene_number": null,
    "source_heading": "மண்டபம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 84
      }
    ],
    "text": "என்ன! பெண்ணும் குழந்தையுமா?...கடற்கரையிலே எத்தனையோ ஆணும் எத்தனையோ பெண்ணும்..."
  },
  {
    "id": "ammaiyappan-s042-d004",
    "archive_scene_id": "ammaiyappan-s042",
    "archive_scene_ordinal": 42,
    "source_scene_number": null,
    "source_heading": "மண்டபம்",
    "speaker_label": "வணி",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 84
      }
    ],
    "text": "இல்ல ைஅய்யா! வழக்கம்போல என் குழந்தையைத் தூக்கிக் கொண்டு கடற்கரைக்கு வந்தாள் வேலைக்காரி..."
  },
  {
    "id": "ammaiyappan-s042-d005",
    "archive_scene_id": "ammaiyappan-s042",
    "archive_scene_ordinal": 42,
    "source_scene_number": null,
    "source_heading": "மண்டபம்",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-042.md",
    "page_provenance": [
      {
        "pdf_page": 86,
        "printed_page": 84
      }
    ],
    "text": "போ...போ...போய்த் தேடு!"
  },
  {
    "id": "ammaiyappan-s042-d006",
    "archive_scene_id": "ammaiyappan-s042",
    "archive_scene_ordinal": 42,
    "source_scene_number": null,
    "source_heading": "மண்டபம்",
