[
  {
    "id": "ammaiyappan-s001-d001",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "ஏ!—முத்தா! என்ன படம் இது?"
  },
  {
    "id": "ammaiyappan-s001-d002",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "ஒன்றுமில்லை..."
  },
  {
    "id": "ammaiyappan-s001-d003",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "ஏ!...சும்மா காட்டு; பார்க்கலாம்..."
  },
  {
    "id": "ammaiyappan-s001-d004",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "அடேடே!...முத்தா! நான் இதுமாதிரி ஒரு படம் இரண்டு மூன்று வாரங்களுக்கு முன்னால் எங்கேயோ பார்த்தது போலே ஞாபகம்!..."
  },
  {
    "id": "ammaiyappan-s001-d005",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "இப்போது நீங்கள் காணப்போகும்...இந்தப் படம் என் லட்சியக் கனவு...இன்ப விடிவெள்ளி...இரண்டொரு வாரங்களுக்கு முன் நீங்கள் பார்த்த படம் இந்தப் படத்தின் இன்னொரு பிரதி—முற்றுப் பெறாத சித்திரம்..."
  },
  {
    "id": "ammaiyappan-s001-d006",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "ஓகோ! அதுவும் உன்னுடையதுதானா?"
  },
  {
    "id": "ammaiyappan-s001-d007",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 3
      }
    ],
    "text": "ஆமாம் முன்னது கை தவறிப்போய் களவாடப்பட்டு விட்டது....! நான் வேறு எழுதிக் கொண்டேன். அது...இது..."
  },
  {
    "id": "ammaiyappan-s001-d008",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "சரி; சரி; ஆளு முத்தா இந்தப்படத்திலே இருக்கிறமாதிரி ஒரு பெண்ணு உலகத்திலே இருந்தா நான் தான் அதை கல்யாணம் பண்ணிக்குவேன்."
  },
  {
    "id": "ammaiyappan-s001-d009",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "உம்; இல்லாததைப்பற்றிப் பேசவானேன்."
  },
  {
    "id": "ammaiyappan-s001-d010",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "சரிதான், உலகத்திலே பேசறதே இல்லாததைப் பற்றித்தான்...சரி நீ வரவில்லையா மடத்துக்கு."
  },
  {
    "id": "ammaiyappan-s001-d011",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "ஊர் கூடம்."
  },
  {
    "id": "ammaiyappan-s001-d012",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "நண்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "என்ன முத்தண்ணா சுகந்தானா?"
  },
  {
    "id": "ammaiyappan-s001-d013",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "இது என்ன சுந்திர பூமியா சுகமாயிருக்க? சுகவாசி இதோ இந்த மடத்துக்குள்ளே இருக்கிறார் மாய்கைநாத சாமியார்."
  },
  {
    "id": "ammaiyappan-s001-d014",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அகில ஜெகத்திற்கும் அம்மையப்பன் அருள் சித்திக் கட்டும்...அடியார்க்கு அடியார்களே! அன்பு நிறைந்த பக்தர்களே!.......அய்ய வினைகள் ஏதேனும் இருப்பின் கேட்டுத் தெளிவு பெறுக........"
  },
  {
    "id": "ammaiyappan-s001-d015",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அம்மையப்பன் என்பதற்கு அர்த்தம் என்ன ஸ்வாமி........."
  },
  {
    "id": "ammaiyappan-s001-d016",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அடடா, இதுவா புரிய வில்லை—இளவரசே. இதோ இருக்கும் பாளையக்கார பலதேவர் உமக்கு..."
  },
  {
    "id": "ammaiyappan-s001-d017",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அப்பா!......"
  },
  {
    "id": "ammaiyappan-s001-d018",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "சரி, அவர்கள்.......?"
  },
  {
    "id": "ammaiyappan-s001-d019",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அம்மா!......."
  },
  {
    "id": "ammaiyappan-s001-d020",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அம்மா......அப்பா......அம்மையப்பா."
  },
  {
    "id": "ammaiyappan-s001-d021",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "அடடே! அப்படியானால் நீங்கள் தோலத் தரிப்பது என் அம்மாவையும் அப்பாவையும் தானா!"
  },
  {
    "id": "ammaiyappan-s001-d022",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 4
      }
    ],
    "text": "கேளும் உமக்கு ஒரு அம்மையப்பன் இருப்பது போலவே, உலக மக்களுக்கும் ஒரு அம்மையப்பன் இருக்கிறார்கள்."
  },
  {
    "id": "ammaiyappan-s001-d023",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "அவர்கள் எங்கு இருக்கிறார்களோ?—"
  },
  {
    "id": "ammaiyappan-s001-d024",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "கண்ணுக்குத் தெரிய மாட்டார்கள்!—"
  },
  {
    "id": "ammaiyappan-s001-d025",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "பிள்ளைகளாகிய நாம் கண்ணுக்குத் தெரியும் போது, பெற்றவர்களும் தெரிய வேண்டியது தானே."
  },
  {
    "id": "ammaiyappan-s001-d026",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "தவறு!...தெரிய மாட்டார்கள் அந்த தெய்வப் பெற்றோர்கள் — அவர்கள் அரூபிகள் — அண்ட சராசரங்களையும் படைத்து அழிக்கும் ஆற்றல் பெற்றவர்கள்...ஆயிரம் நாமம் படைத்தோர்...பாயிரம் பலவற்றுள் பாராட்டப் பெற்றோர்...இகபரம் சுகதுக்கம் ... தூண் துரும்பு...அங்கு...இங்கு எங்கும் பிரகாசமாய் இருப்போர்...என்ன சுகதேவ் ... குழப்பம் முடிவுற்றதா?..."
  },
  {
    "id": "ammaiyappan-s001-d027",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "இப்போது தானே ஆரம்பமே ஆகிறது"
  },
  {
    "id": "ammaiyappan-s001-d028",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
    "text": "அட அம்மையப்பா—"
  },
  {
    "id": "ammaiyappan-s001-d029",
    "archive_scene_id": "ammaiyappan-s001",
    "archive_scene_ordinal": 1,
    "source_scene_number": null,
    "source_heading": "மடாலய வெளிப்புறம்",
    "speaker_label": "பலதேவர்",
    "source_scene_file": "scene-001.md",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 5
      }
    ],
