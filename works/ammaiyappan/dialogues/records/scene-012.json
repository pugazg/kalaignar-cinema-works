[
  {
    "id": "ammaiyappan-s012-d001",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "வாங்க...வாங்க...நீங்க தானே வேதாளம்?"
  },
  {
    "id": "ammaiyappan-s012-d002",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "ஆமாம்."
  },
  {
    "id": "ammaiyappan-s012-d003",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "அது என்ன, வேதாளம் என்று பெயர் வச்\nசிருக்கீங்க. உங்க அப்பா, அம்மா விக்கிரமாதித்தன் கதை\nபடிக்கிறது உண்டா?"
  },
  {
    "id": "ammaiyappan-s012-d004",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "உண்டு; உண்டு—ஏன்?"
  },
  {
    "id": "ammaiyappan-s012-d005",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "விக்கிரமாதித்தன் கதையிலே ஒரு வேதாளம்\nவருது—அதைப் படிக்கும் போது நீங்க பொறந்திருப்பீங்க\nஅதனாலே உங்களுக்கு வேதாளம்னு பேரு வச்சிருப்பாங்க.\nநல்ல வேளையா கிஷ்கிந்தா காண்டம் படிக்கும்போது\nநீங்க பொறக்காமே இருந்தீங்களே. வாங்க! வாங்க!"
  },
  {
    "id": "ammaiyappan-s012-d006",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "பிரபு! இவர்தான் தாங்கள் கூப்பிட்டு\nஅனுப்பிய வேதாளம்."
  },
  {
    "id": "ammaiyappan-s012-d007",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "ஓ! வேதாளம்! வாரும். உம்மைப்பற்றி\nநான் நிரம்பக் கேள்விப்பட்டிருக்கிறேன். பலதேவரும்\nசொன்னார் மிகுந்த திறமைசாலி என்று. நான் வந்திருக்கிற\nகாரியம் உமக்குத் தெரியும்; படைக்கு ஆள் திரட்ட என்று.\nஅதற்கு நீரும்..."
  },
  {
    "id": "ammaiyappan-s012-d008",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "நானா! அய்யோ! எனக்கு வாளைத் தூக்\nகக்கூட சக்தியில்லை."
  },
  {
    "id": "ammaiyappan-s012-d009",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 27,
        "printed_page": 25
      }
    ],
    "text": "நீர் படையில் சேர வேண்டாமய்யா...\nகொஞ்சம் ஆட்கள் பிடித்துக் கொடும். வேலையில்லாதவர்\nகள் எத்தனையோ பேர் இருப்பார்கள்."
  },
  {
    "id": "ammaiyappan-s012-d010",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "படையில் சேருவதென்றால் பயப்படு\nவார்களே."
  },
  {
    "id": "ammaiyappan-s012-d011",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "பலி பீடத்திற்கு வருவதற்கு ஆடு\nகூடத்தான் பயப்படும். அதற்காகத்தான் மஞ்சள் நீர்\nதெளித்து, மலர் தூவி, ஆகாரத்தையும் எதிரே நீட்டி\nஆசை காட்டுவது; முயற்சி பண்ண வேண்டும்."
  },
  {
    "id": "ammaiyappan-s012-d012",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "சரியான பேச்சு; தங்கள் உத்தரவுப்\nபடியே வேலையை ஆரம்பிக்கிறேன். இன்னொரு விண்\nணப்பம்."
  },
  {
    "id": "ammaiyappan-s012-d013",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "என்ன?"
  },
  {
    "id": "ammaiyappan-s012-d014",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "இந்த ஊரில் ஒரு பெரிய சாமியார்\nஇருக்கிறார். அவர் பேச்சை தெய்வப் பேச்சாக எல்லோரும்\nஎண்ணுவார்கள். அவரிடம் சொல்லி படைக்கு ஆள் சேர்க்\nகும் பிரச்சாரத்தைச் செய்யச் சொன்னால் நமது வேலை சுலப\nமாக முடிந்து விடும்."
  },
  {
    "id": "ammaiyappan-s012-d015",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "பொருள் எதுவும் தர வேண்டுமோ\nஅவர் அருளைப் பெற."
  },
  {
    "id": "ammaiyappan-s012-d016",
    "archive_scene_id": "ammaiyappan-s012",
    "archive_scene_ordinal": 12,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-012.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "பொருளா? அவர் வாங்கவே மாட்டார்.\nஅவர் கையால் பொருளைத் தொடுவதேயில்லை. மடத்தில்\nஒரு உண்டியல் இருக்கிறது. அதில் போட்டுவிட வேண்டும்."
  }
]
