[
  {
    "id": "ammaiyappan-s038-d001",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பலதேவர்",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "திரிசங்கு! வாட்டும் அவன்! நல்லவனைப் போல நடந்து நரிவேலை நடத்தி இருக்கிறானே, துரோகி!"
  },
  {
    "id": "ammaiyappan-s038-d002",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "நல்லவர்களே இந்தக் காலத்தில் நம்பக் கூடாது பிரபு."
  },
  {
    "id": "ammaiyappan-s038-d003",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பல",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "யாரங்கே? (சேவகன் வருகிறான்) உடனே போய் திரிசங்குவை கைகால்களைக் கட்டி இழுத்து வாருங்கள். எவ்வளவு பொருள் அழிந்தாலும் சரி—என் மகன் என்னிடம் அழைத்து வந்தால்போதும். அவன் வராவிட்டால் ராணி இறந்தே விடுவாள்."
  },
  {
    "id": "ammaiyappan-s038-d004",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "சுகதேவ் காணாமற் போன செய்தி யாருக்கும் தெரியவேண்டாம். நானே அவரைத் தந்திரமாக கண்டுபிடித்து வந்து தங்களிடம் ஒப்படைக்கிறேன்."
  },
  {
    "id": "ammaiyappan-s038-d005",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பல",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "மிகவும் நன்றி. ஐநூறு பொன் தருகிறேன்—சுகதேவ் கிடைத்துவிட்டால் உமக்கு பரிசாக ஐநூறு பொன் தருகிறேன் இரும்—வருகிறேன்."
  },
  {
    "id": "ammaiyappan-s038-d006",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "துன்பம் துணையோடு வரும், இன்பம், தனியாக வரும் என்பார்களே, அது தவறு! வேதாளத்தின் மீது இன்பம் எறும்பு வரிசைபோல் அல்லவா படை எடுக்கிறது! உம்...ஒருவன் அடித்துத்தான் ஒருவன் சுகம் தேடமுடிகிறது! ஈ சிலந்திக்கு ஆகாரம்—சிலந்தி பல்லிக்கு ஆகாரம்—பல்லி பூனைக்கு ஆகாரம்—பூனை குறவனுக்கு ஆகாரம்—குறவன் எமனுக்கு ஆகாரம்—அதே வழிதான் என் வழியும்! வேகமாகப் போகும் என் வளர்ச்சி ஒருவேளை என்னை பழுதார் பாளையக்காரராகக்கூட ஆக்கி விடலாம்!..."
  },
  {
    "id": "ammaiyappan-s038-d007",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பல",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "(உள்ளிருந்து வந்து) வேதாளம்! இந்தாரும்!"
  },
  {
    "id": "ammaiyappan-s038-d008",
    "archive_scene_id": "ammaiyappan-s038",
    "archive_scene_ordinal": 38,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-038.md",
    "page_provenance": [
      {
        "pdf_page": 82,
        "printed_page": 80
      }
    ],
    "text": "பெருமை மிகு பிரபுவே! உங்கள் அருமை மிகு மகன் எப்படியும் அழைத்து வருகிறேன். ஆண்டவனே துணை! அம்மையப்பா!"
  }
]
