[
  {
    "id": "ammaiyappan-s034-d001",
    "archive_scene_id": "ammaiyappan-s034",
    "archive_scene_ordinal": 34,
    "source_scene_number": null,
    "source_heading": "பாசறை சமையல் கூடம்",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "தோழர்களே! முத்தாயியை அபகரிப்பதற்காக என்னை கருவியாக உபயோகிக்கிறான் தனபதி. நான் இந்த சந்தர்ப்பத்தை பயன்படுத்திக் கொண்டு மறைந்து விடுகிறேன்."
  },
  {
    "id": "ammaiyappan-s034-d002",
    "archive_scene_id": "ammaiyappan-s034",
    "archive_scene_ordinal": 34,
    "source_scene_number": null,
    "source_heading": "பாசறை சமையல் கூடம்",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "அப்படியானால் நாங்கள் என்ன ஆவது அண்ணே?"
  },
  {
    "id": "ammaiyappan-s034-d003",
    "archive_scene_id": "ammaiyappan-s034",
    "archive_scene_ordinal": 34,
    "source_scene_number": null,
    "source_heading": "பாசறை சமையல் கூடம்",
    "speaker_label": "முத்",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "நீங்களும் எப்படியாவது இங்கிருந்து தப்பி என்னிடம் வந்து விடுங்கள். பிறகு எல்லோரும் சேர்ந்து பழுதார் விடுதலைக்கு பாடுபடுவோம். வாட்டமா நான்?"
  },
  {
    "id": "ammaiyappan-s034-d004",
    "archive_scene_id": "ammaiyappan-s034",
    "archive_scene_ordinal": 34,
    "source_scene_number": null,
    "source_heading": "பாசறை சமையல் கூடம்",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-034.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "ஜாக்கிரதையாகப் போங்கள் அண்ணே! நாங்கள் எப்படியும் வந்து சேருகிறோம்.—தந்திரமாக வெளியேற வேண்டும்."
  }
]
