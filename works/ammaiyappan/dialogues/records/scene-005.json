[
  {
    "id": "ammaiyappan-s005-d001",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "ஏன்...அவனை அடிக்கிறீர்கள்......"
  },
  {
    "id": "ammaiyappan-s005-d002",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "திரு",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "நீ வந்துட்டியா—சிபார்சுக்கு...முத்தா—நீ குதிரை பார்த்துக் கொள்கிற லட்சணம் நன்றாயிருக்கிறது திருட்டுப்பய பிள்ளைகள் எல்லாம் அரண்மனைக் குள்ளேயே வந்துட்டுதுங்க திருடுரத்துக்கு!"
  },
  {
    "id": "ammaiyappan-s005-d003",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "பசி பொறுக்காமல் இந்தப் பசிப் பையன் கொஞ்சம் கொள்ளை சாப்பிட்டு விட்டால் அது திருட்டா? உலகத்தில் யார் யாரோ எதை எதையோ திருடுகிறார்கள்..."
  },
  {
    "id": "ammaiyappan-s005-d004",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "திரு",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "சரிதான் பாளையக்காரர் சொத்தை நீயே பசி காரர்களுக்கு பங்கு போட்டு கொடுத்திடுவே போலிருக்கு."
  },
  {
    "id": "ammaiyappan-s005-d005",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "நான் கொடுக்காவிட்டாலும். அந்தக் காலம் வந்துதான் போகிறது. இந்தா தம்பி நீ ஓடிப்போ......"
  },
  {
    "id": "ammaiyappan-s005-d006",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "திரு",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "காவேரி எவ்வளவு நல்லவ, அவ வயத்திலே வந்து இப்படி ஒரு புள்ளே பொறந்துதே!......"
  },
  {
    "id": "ammaiyappan-s005-d007",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "வீர",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 11
      }
    ],
    "text": "முத்தா!...வாள் வித்தை கற்றுக் கொள்ள—குமார ராஜா வருகிறார்......."
  },
  {
    "id": "ammaiyappan-s005-d008",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "யாரது! குமார ராஜாவா? அது சரி!......"
  },
  {
    "id": "ammaiyappan-s005-d009",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "வீர",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "ஆமாம்! இளவரசன் சுகதேவ்......"
  },
  {
    "id": "ammaiyappan-s005-d010",
    "archive_scene_id": "ammaiyappan-s005",
    "archive_scene_ordinal": 5,
    "source_scene_number": null,
    "source_heading": "குதிரைக் கொட்டடி",
    "speaker_label": "முத்",
    "source_scene_file": "scene-005.md",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 12
      }
    ],
    "text": "இளவரசன், குமாரராஜன்!...இவன் வேறல்ல புதுப் புது பட்டமா அள்ளி வீசுகிறான்......எப்பா கொஞ்சம் தகுதி பார்த்து கொட்டப்பா பட்டத்தை; ஏது...இப்ப என்னா வாள் பயிற்சி கத்துகிட்டு பழுதாருக்கு விடுதலை வாங்கித் தரப் போகிறாருக்கும்......பெரிய வீராதி வீரா...சரி...சரி...போ...இதோ வரேன்."
  }
]
