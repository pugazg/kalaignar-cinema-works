[
  {
    "id": "ammaiyappan-s053-d001",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 93,
        "printed_page": 91
      }
    ],
    "text": "ஆ!..."
  },
  {
    "id": "ammaiyappan-s053-d002",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "ஏ, முத்தா! நீ தான் தளபதியைக் கொன்றாயா?...பலே பலே...நன்றி...நன்றி...அவன் எங்கே வேதாளம், அவன் சாகலையா?..."
  },
  {
    "id": "ammaiyappan-s053-d003",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "ஆ!...முத்தாயி!...முத்தாயி!...கண்ணை முழிச்சுப் பாரேன்...வீரன் சுகதேவ் வந்திருக்கிறேன்...கண்ணை முழிச்சி பாரேன் முத்தாயி! எழுந்திரேன்..."
  },
  {
    "id": "ammaiyappan-s053-d004",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "(மூர்ச்சை தெளிந்து) நீங்கள் சோலைக் குற்றவாளியா?"
  },
  {
    "id": "ammaiyappan-s053-d005",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "நான் ஒன்றும் குற்றவாளி இல்லை...அந்த முத்தன்தான் குற்றவாளி!"
  },
  {
    "id": "ammaiyappan-s053-d006",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "அய்யோ என் காதல் தெய்வமே! உங்கள் கைகளிலே..."
  },
  {
    "id": "ammaiyappan-s053-d007",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "ஒன்றுமில்லை...தண்ணீர்க்குவளைதான் கண்ணே...பயப்படாதே கண்ணே...எழுந்திரு..."
  },
  {
    "id": "ammaiyappan-s053-d008",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "பாவி! நீ ஒருத்தன் வந்து விட்டாயா?..."
  },
  {
    "id": "ammaiyappan-s053-d009",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "ஏன் முத்தாயி கோபித்துக் கொள்கிறாய்? ஏதாவது ஊடலா?..."
  },
  {
    "id": "ammaiyappan-s053-d010",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "இப்போது நீ என்ன சொல்கிறாய்?"
  },
  {
    "id": "ammaiyappan-s053-d011",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "என்ன சொல்லுவேன்; நமது திருமணத்தைப் பற்றித்தான்!"
  },
  {
    "id": "ammaiyappan-s053-d012",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "அட அயோக்கியா!...வேதனையின் விளிம்பிலே நிற்கும் என்னிடம் வீரகாப்பியம் பேசவந்து விட்டாயா, நீ ஒருவன்? இதுதானா உன் மாளிகையில் கற்றுக் கொடுத்த பாடம்? போ...வெளியே! உம் போகிறாயா இல்லையா?..."
  },
  {
    "id": "ammaiyappan-s053-d013",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "ஊகூம்...அதெல்லாம் யாரும் போகமுடியாது...முத்தாயி, நான் யார் தெரியுமா? வருங்கால சக்ரவர்த்தியின் திருமகன்!"
  },
  {
    "id": "ammaiyappan-s053-d014",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 94,
        "printed_page": 92
      }
    ],
    "text": "சக்ரவர்த்தித் திருமகன்! உம்...உனக்குக் கண்ணில்லை...மனித உணர்ச்சி இல்லை...பெண் பழி பொல்லாது என்பார்களே. அதை நீ படித்ததில்லை?..."
  },
  {
    "id": "ammaiyappan-s053-d015",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 95,
        "printed_page": 93
      }
    ],
    "text": "உம்...நான் ஏன் அதெல்லாம் படிக்கிறேன்...முத்தாயி, இப்போது நீ என்னைத் திருமணம் செய்து கொண்டுதான் தீரவேண்டும்...கண்ணே முத்தாயி!..."
  },
  {
    "id": "ammaiyappan-s053-d016",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "முத்",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 95,
        "printed_page": 93
      }
    ],
    "text": "உம்...நான் தயாராக இருக்கிறேன்...இந்த சரீரம்தானே உனக்கு வேண்டும்?...என் மேனியின் மெறுகிலேதானே நீ மயங்கிவிட்டாய்?.....உம்...அழகைப் பார்த்துக் கொள் என்னை! யாரோ சொன்ன வார்த்தை உடல்தான் அழுக்குப்பட்டது; உள்ளம் அழுக்குப்படவில்லை என்று! அப்படியல்ல நான்...என் கற்பை உன் காலடியில் வைக்கத் தயாராகிவிட்டேன்...காமவெறியில் பாய்ந்துவரும் கழுதே! உன் கொடிய நகங்களால் என் இருதயத்தைப் பிராண்டி விடு!.....உம்...தாமதிக்காதே! சூறையாடு என் வாழ்க்கையை!...சுக்கு நூறாக்கிவிடு என் வைராக்கியத்தை! பெண்களை விபசாரப் பதுமைகளாக நினைத்துவிட்ட பேயர்களின் பிரதிநிதியே!...என் தயக்கம்? இதோ நான் தயார்! என் பிணம் பேசுகிறது உன்னோடு! என் சவம் அழைக்கிறது உன்னை! வா...வா...வஞ்சகனே! இதோ நான் முத்தாயி—முத்தனின் மனைவி—உனக்கு வெள்ளாட்டி!"
  },
  {
    "id": "ammaiyappan-s053-d017",
    "archive_scene_id": "ammaiyappan-s053",
    "archive_scene_ordinal": 53,
    "source_scene_number": null,
    "source_heading": "வெளியே",
    "speaker_label": "சுக",
    "source_scene_file": "scene-053.md",
    "page_provenance": [
      {
        "pdf_page": 95,
        "printed_page": 93
      }
    ],
    "text": "என்ன? நீ முத்தனின் மனைவியா?...முத்தாயி, என்னை மன்னித்துவிடு!...உன் தகப்பனார் பேச்சைக் கேட்டு இப்படி எல்லாம் கெட்டுவிட்டேன்! இல்லறத்தை நம்பி துறவறத்தின் எல்லை வரையில் போய்விட்டேன்! முத்தாயி! உன் மேல் வைத்த காதலே திருமணப் பெட்டுக்கு கொண்டிருக்கிறேன். அன்புள்ள சகோதரி! இப்போதே போய் உன் காதலனைக் காப்பாற்றுகிறேன்."
  }
]
