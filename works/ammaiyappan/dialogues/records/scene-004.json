[
  {
    "id": "ammaiyappan-s004-d001",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கைநாதர்",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 10,
        "printed_page": 8
      },
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "மகான்களைப் பற்றி நேற்றுச் சொன்னேனல்லவா? மகான்கள் அடிக்கடித் தோன்றுவதில்லை. ஆனால் அப்படித் தோன்றும் மகான்களால் ஆகாதது எதுவுமே இல்லை...கடலை வற்ற வைப்பார்; கசந்திலே மிதந்திடுவர்...கடவுளுடன் பேசுவர்...கரும்பிலே கசப்புக் காட்டுவர்; காகத்தையும் கந்தர்வ கானம் எழுப்பச்\nசெய்வர்...அத்தகைய அருட்சக்தி பெற்றவர்கள் அவர்கள். வீரர்கட்கும் விவேகிகட்கும் மண்ணிலே தான் புகழ்...ஆனால் மகான்கட்கோ விண்ணிலும் புகழ். ஆகவே தான் சொல்லுகிறேன். வாளையும் வேலையும் தொடாதே வைகுந்த வாசனைத் தொழு. கையிலே கேடயம் ஏந்தாதே. கைலாச நாதரின் திரு நீறை ஏந்து...நீ யார்? நான் யார்? தாய் தந்தை அண்ணன், தம்பி எல்லாம் வீண்; முடிவில் ஒரு பிடி மண்.",
    "page_segments": [
      {
        "pdf_page": 10,
        "printed_page": 8,
        "text": "மகான்களைப் பற்றி நேற்றுச் சொன்னேனல்லவா? மகான்கள் அடிக்கடித் தோன்றுவதில்லை. ஆனால் அப்படித் தோன்றும் மகான்களால் ஆகாதது எதுவுமே இல்லை...கடலை வற்ற வைப்பார்; கசந்திலே மிதந்திடுவர்...கடவுளுடன் பேசுவர்...கரும்பிலே கசப்புக் காட்டுவர்; காகத்தையும் கந்தர்வ கானம் எழுப்பச்"
      },
      {
        "pdf_page": 11,
        "printed_page": 9,
        "text": "செய்வர்...அத்தகைய அருட்சக்தி பெற்றவர்கள் அவர்கள். வீரர்கட்கும் விவேகிகட்கும் மண்ணிலே தான் புகழ்...ஆனால் மகான்கட்கோ விண்ணிலும் புகழ். ஆகவே தான் சொல்லுகிறேன். வாளையும் வேலையும் தொடாதே வைகுந்த வாசனைத் தொழு. கையிலே கேடயம் ஏந்தாதே. கைலாச நாதரின் திரு நீறை ஏந்து...நீ யார்? நான் யார்? தாய் தந்தை அண்ணன், தம்பி எல்லாம் வீண்; முடிவில் ஒரு பிடி மண்."
      }
    ]
  },
  {
    "id": "ammaiyappan-s004-d002",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "வாரும் பூபதி...வாரும். உம்மைப் பார்த்து பல ஆண்டுகளாகி விட்டனவே! தாடியெல்லாம் வெளுப்பேறி விட்டதே."
  },
  {
    "id": "ammaiyappan-s004-d003",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "ஆமாம்!"
  },
  {
    "id": "ammaiyappan-s004-d004",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "தளிர் சருகாகத்தானே மாறும். தாடி வெளுப்பாவதிலே என்ன ஆச்சரியம்."
  },
  {
    "id": "ammaiyappan-s004-d005",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "ஒன்று சொன்னீர். அதுவும் நன்று சொன்னீர். உண்மை; உள்ளங்கை நெல்லிக்கனி..."
  },
  {
    "id": "ammaiyappan-s004-d006",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "என்ன பூபதியாரே வெளிநாட்டுப் பிரயாணங்கள் எப்படியிருந்தன. உமது மருத்துவத் தொழில் முன்னிலும் பன்மடங்கு சிறப்படைந்திருக்குமென்று எண்ணுகிறேன்—அதற்கு உமது சுற்றுப் பயணம் பயன்பட்டதல்லவா!—"
  },
  {
    "id": "ammaiyappan-s004-d007",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "நிச்சயமாகப் பயன்பட்டது. இருபது ஆண்டு இடைவிடாத அலச்சல் வீண் போகவில்லை—மாயத்தாலும் மந்திரத்தாலும் தீர்க்க முடியாதவைகளை மருத்துவத்தால் தீர்க்கலாம் என்ற உண்மையை......"
  },
  {
    "id": "ammaiyappan-s004-d008",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "அம்மையப்பா—தெய்வத்தால் ஆகாத தொன்றில்லை."
  },
  {
    "id": "ammaiyappan-s004-d009",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "ஸ்வாமி நமஸ்தே"
  },
  {
    "id": "ammaiyappan-s004-d010",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 11,
        "printed_page": 9
      }
    ],
    "text": "என்ன வேதாளம்."
  },
  {
    "id": "ammaiyappan-s004-d011",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "ஸ்வாமிகளுக்கு காணிக்கைகள் வந்திருக்கிறது நிறைய. அதை எடுத்து வந்தேன்..."
  },
  {
    "id": "ammaiyappan-s004-d012",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "காணிக்கை...வாழ்க பக்தர்கள்! எவ்வளவு வேதாளம்."
  },
  {
    "id": "ammaiyappan-s004-d013",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "கணக்கற்ற பொன் நாணயங்கள்."
  },
  {
    "id": "ammaiyappan-s004-d014",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "மாய்கை",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "சந்தோஷம்! அதோ இருக்கிறது உண்டியல்."
  },
  {
    "id": "ammaiyappan-s004-d015",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "சாமிகள் பொன்னைத் தொடுவது கிடையாதோ"
  },
  {
    "id": "ammaiyappan-s004-d016",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "சாமி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "விஷம்—விஷம்!!......"
  },
  {
    "id": "ammaiyappan-s004-d017",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "அந்த விஷத்திலே வளருவது தானே இந்த விருக்ஷம்!...சாமியாரே! வெளிநாடு சென்று திரும்பியிருக்கும் எனக்கு நீர் ஓர் வெகுமதி தரவேண்டும்—தருவீரா?"
  },
  {
    "id": "ammaiyappan-s004-d018",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "சாமி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "வெகுமதியா? என்ன பூபதி."
  },
  {
    "id": "ammaiyappan-s004-d019",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "அந்த புதையலை என் கண்ணிலே காட்ட வேண்டும்."
  },
  {
    "id": "ammaiyappan-s004-d020",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "சாமி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "புதையல்?"
  },
  {
    "id": "ammaiyappan-s004-d021",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "பொன்னோ வைரமோ அல்ல சாமியாரே...உம்மிடம் புதைந்து கிடக்கும் அந்த ரகசியத்தைத்தான் கேட்கிறேன்..."
  },
  {
    "id": "ammaiyappan-s004-d022",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "சாமி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "ரகசியம்!"
  },
  {
    "id": "ammaiyappan-s004-d023",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "ஆமாம் இப்போதாவது சொல்லக் கூடாதா?"
  },
  {
    "id": "ammaiyappan-s004-d024",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "சாமி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "உயிரை வாங்காதீர்; இருபது வருடமாய் போய் இருந்தீரே இப்போது இங்கு ஏனய்யா வந்தீர்...?"
  },
  {
    "id": "ammaiyappan-s004-d025",
    "archive_scene_id": "ammaiyappan-s004",
    "archive_scene_ordinal": 4,
    "source_scene_number": null,
    "source_heading": "மாடம்",
    "speaker_label": "பூபதி",
    "source_scene_file": "scene-004.md",
    "page_provenance": [
      {
        "pdf_page": 12,
        "printed_page": 10
      }
    ],
    "text": "ஏன் வந்தேன்—சொல்கிறேன், நீரும் இருபது ஆண்டுகளாகத்தான் அந்த ரகசியத்தை மறைத்துக் கொண்டு வாழ்கிறீர்! ஹ—ஹ—ஹ—சாமியாரே குதிரை தன் ஆகாரத்தை கோணியிலே மறைத்துக் கொண்டு சாப்பிட்டாலும் அது கொள் என்று தெரியாமலா போய் விடுகிறது. ஹ—ஹ—ஹ!"
  }
]
