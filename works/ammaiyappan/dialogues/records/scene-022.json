[
  {
    "id": "ammaiyappan-s022-d001",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "தாங்கள் சந்தேகப்பட்டது மிகவும் சரிதான். என்ன இருந்தாலும் ஒரு நாட்டுக்குத் தளபதி அல்லவா? அவன் கையொப்பமிடும்போது “முத்தாயி” என்று தவறாக எழுதினான் என்றீர்களே, அது தவறுதல் அல்ல. அப்படி ஒரு தப்பல் இருப்பது உண்மை."
  },
  {
    "id": "ammaiyappan-s022-d002",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "பார்த்தீரா? எனக்குத் தெரியும் அப்போதே. என் வேதாளம்; இருவருக்கும் ஏதாவது தொடர்பு இருக்குமல்லவா?"
  },
  {
    "id": "ammaiyappan-s022-d003",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "இருக்கும், இருக்கும்; நிச்சயம் இருக்கும்!"
  },
  {
    "id": "ammaiyappan-s022-d004",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "தொடர்பு இருக்கிற அவளுக்கு துடியிடை உடைய அழகியோ அவள்?"
  },
  {
    "id": "ammaiyappan-s022-d005",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "அழகிதான். நல்ல அழகு."
  },
  {
    "id": "ammaiyappan-s022-d006",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "சந்தனச் சேரியிலே நான் தங்கியிருக்கும்போது இப்படித்தான் ஒரு அழகியை எனக்கு அறிமுகப்படுத்தி வைத்தான் ஒரு அந்தரங்க நண்பன்."
  },
  {
    "id": "ammaiyappan-s022-d007",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "அப்படியா?"
  },
  {
    "id": "ammaiyappan-s022-d008",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "நண்பனிருந்தாலும் அந்த நல்ல வாய்ப்பை ஏற்படுத்திக் கொடுத்ததற்காக அவனுக்கு இருபது பொன் பரிசளித்தோம் பிரபு,"
  },
  {
    "id": "ammaiyappan-s022-d009",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "பொன் மட்டுமா; அந்தச் சேரிக்கே அவனைத் தலைவனாக்கிவிட்டேன்."
  },
  {
    "id": "ammaiyappan-s022-d010",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "ஓஹோ!"
  },
  {
    "id": "ammaiyappan-s022-d011",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "முடியுமானால் முத்தாயியை ஒரு முறை சந்திக்க முயற்சிப்போம், என்ன வேதாளம்?"
  },
  {
    "id": "ammaiyappan-s022-d012",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "அதைத்தான் நானும் யோசித்துக் கொண்டுவிட்டேன்."
  },
  {
    "id": "ammaiyappan-s022-d013",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 48,
        "printed_page": 46
      }
    ],
    "text": "யோசிக்கிறானு முகமே சொல்லுதே பிரபு."
  },
  {
    "id": "ammaiyappan-s022-d014",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "வேதாளம்; குறிப்பறிந்து செயல் புரிவதில் உமக்கு நிகர் நீரேதான்."
  },
  {
    "id": "ammaiyappan-s022-d015",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "என்னப்பா! என்ன வேண்டும்?"
  },
  {
    "id": "ammaiyappan-s022-d016",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "என்னை மன்னிக்க வேண்டும்."
  },
  {
    "id": "ammaiyappan-s022-d017",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "விஷயத்தைச் சொல்."
  },
  {
    "id": "ammaiyappan-s022-d018",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "சந்தர்ப்பம் சரியில்லை, படையிலிருந்து விலகிக் கொள்வதற்காக..."
  },
  {
    "id": "ammaiyappan-s022-d019",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "என்ன விளையாடுகிறாய்? என்ன யாரென்று எண்ணிவிட்டாய்? படையில் சேரவும், விலகவும் உன் இஷ்டப்படி நடக்கவும் அனுமதி கிடையாது இங்கே! ஆளைப்பார் மல்லேபோல் இருக்கிறான்...எலிபோல் பயப்படுகிறான் கோழை..."
  },
  {
    "id": "ammaiyappan-s022-d020",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "தயவு செய்து அந்த வார்த்தை சொல்லாதீர்கள். நான் ஏழையாய் இருக்கலாம். ஆனால் கோழையல்ல."
  },
  {
    "id": "ammaiyappan-s022-d021",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "வால் நீட்டாதே! வாள் நீளும் மரியாதையாக நில்! மரியாதையாகப் பேசு."
  },
  {
    "id": "ammaiyappan-s022-d022",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "படையில் சேருவதற்கு கட்டாயம் எதுவுமில்லையல்லவா?"
  },
  {
    "id": "ammaiyappan-s022-d023",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "சேருவதற்குக் கட்டாயமில்லை ஆனால் சேர்ந்துவிலகுவது உன் இஷ்டமில்லை."
  },
  {
    "id": "ammaiyappan-s022-d024",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "அதற்குத்தான் நூறு பொன் தண்டம் செலுத்திட வேண்டுமென்று நிபந்தனையிருக்கிறதே."
  },
  {
    "id": "ammaiyappan-s022-d025",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      }
    ],
    "text": "[வேதாளத்திடம்] நிபந்தனையை இவன் எனக்கு நினைவூட்டுகிறான் திமிர் பிடித்தவன். (முத்தனிடம்) இந்த தேகத்தை வளர்த்து என்ன செய்யப்போகிறாய்? தேசத்திற்காகத்தான் பலிகேட்டேன்."
  },
  {
    "id": "ammaiyappan-s022-d026",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 49,
        "printed_page": 47
      },
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "பலிகொடுக்கலாம்; எமக்கென்று ஒரு தேசம் இருந்தால்! எமது நாட்டைக் காக்க வேண்டுமென்று போர் மூளுமானால் அந்த முன்னணியிலே முத்தனின் பெயர்தான் முதல் இடம்பெறும். பழுதார் அடிமை பூமி; அதைக் காவல் போட்டு மிதித்து கப்பம் வாங்கும் நாட்டுக்குத்\nதளபதி நீர். அந்தப் படையிலே நான் இருப்பதும் ஒன்று தான்...",
    "page_segments": [
      {
        "pdf_page": 49,
        "printed_page": 47,
        "text": "பலிகொடுக்கலாம்; எமக்கென்று ஒரு தேசம் இருந்தால்! எமது நாட்டைக் காக்க வேண்டுமென்று போர் மூளுமானால் அந்த முன்னணியிலே முத்தனின் பெயர்தான் முதல் இடம்பெறும். பழுதார் அடிமை பூமி; அதைக் காவல் போட்டு மிதித்து கப்பம் வாங்கும் நாட்டுக்குத்"
      },
      {
        "pdf_page": 50,
        "printed_page": 48,
        "text": "தளபதி நீர். அந்தப் படையிலே நான் இருப்பதும் ஒன்று தான்..."
      }
    ]
  },
  {
    "id": "ammaiyappan-s022-d027",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "என்ன சொன்னாய், ராஜதுரோகி?"
  },
  {
    "id": "ammaiyappan-s022-d028",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "சகோதரத் துரோகிக்கே ஆழ்வார் பட்டம் கிடைத்திருக்கிறது. தளபதி அவர்களே; நான் துரோகி இல்லை! எமது நாட்டை அபகரித்தவரின் அணிவகுப்பில் பணிபுரிய மாட்டேன் என்பது துரோகமா?"
  },
  {
    "id": "ammaiyappan-s022-d029",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "ஆ! என்னை எதிர்த்துப் பேசிய முதல் ஆள் இவன்தான். இவனுக்கு ஒரு முடிவு தேடாமல் விடமாட்டேன். வேங்கை புரத்து அரசாட்சிக்கு எதிராகக் கிளம்பும் இம்மாதிரி விஷவித்துக்களை முளையிலேயே கிள்ளி எறியவேண்டும்; இவனுக்கென்று ஒரு தேசமாம்; அந்த தேசத்தின் விடுதலைக்குத்தான் பாடுபடுவதாம். வெளியிலே உலவுகிறான், பைத்தியக்கார விடுதியிலே இருக்க வேண்டியவன்."
  },
  {
    "id": "ammaiyappan-s022-d030",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "உங்களைப் போன்றவர்களுக்கு வைத்தியம் செய்வதற்காக;"
  },
  {
    "id": "ammaiyappan-s022-d031",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "சீ! காட்டுமிராண்டி!"
  },
  {
    "id": "ammaiyappan-s022-d032",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "காட்டுமிராண்டி! நிலைக்கண்ணாடியைப் பார்த்து நீரே சொல்லிக்கொள்ளும் அந்த வார்த்தையை!"
  },
  {
    "id": "ammaiyappan-s022-d033",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "கொஞ்சம் இப்படி வாருங்களேன்."
  },
  {
    "id": "ammaiyappan-s022-d034",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "பயல விடாதீர்கள். விட்டால் தண்டப் பொருளைக் கட்டித் தப்பிவிடுவான். பிறகு முத்தாயியைப் பிடிக்க முடியாது,"
  },
  {
    "id": "ammaiyappan-s022-d035",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "என்ன செய்யலாம்?"
  },
  {
    "id": "ammaiyappan-s022-d036",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 50,
        "printed_page": 48
      }
    ],
    "text": "காவலில் போடுங்கள் கழுதையை...ஆனால் ஒன்று...நான் இந்த நாய்க்குட்டியிடம் நல்லவனாக நடந்துகொள்கிறேன். அதாவது நடிக்கிறேன் என்கிறேன்."
  },
  {
    "id": "ammaiyappan-s022-d037",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "வேதாளம்! இது பட்டாளத்து விஷயம், உமது சிபார்சுக்கு இங்கு இடமேயில்லை."
  },
  {
    "id": "ammaiyappan-s022-d038",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "தயவு செய்து மன்னித்து விடுங்கள்...முத்தன் ஏழை."
  },
  {
    "id": "ammaiyappan-s022-d039",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "வேதாளம்! திரும்பத் திரும்ப சொல்லுகிறேன். நீர் இதில் தலையிடக்கூடாது."
  },
  {
    "id": "ammaiyappan-s022-d040",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "ஏன் தலையிடக்கூடாது? தங்களுக்குத் தரவேண்டிய நூறு பொன்னைக் கொடுத்துவிட்டால் முத்தனை நீங்கள் என்ன செய்யமுடியும்? ஏன் முத்தா! நூறு பொன் கொடுத்துவிடேன்."
  },
  {
    "id": "ammaiyappan-s022-d041",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "கையில் தந்து விடுகிறேன்."
  },
  {
    "id": "ammaiyappan-s022-d042",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "ஆங்! தளபதி அவர்களே! முத்தன் போகலாமல்லவா இப்போது!"
  },
  {
    "id": "ammaiyappan-s022-d043",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "கூடாது...தண்டப் பொன்கள் வந்து சேரும் வரையில் அவன் இங்கேயேதான் இருக்கவேண்டும்."
  },
  {
    "id": "ammaiyappan-s022-d044",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "அய்யா! பெருமைக்குரிய பிரபு அவர்களே! அவனை விட்டு விடுங்கள். நானே நாளை காலையில் பொன்களத் தந்து விடுகிறேன்."
  },
  {
    "id": "ammaiyappan-s022-d045",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "முடியாது...வேலழகன் உத்தரவு விடுகிறேன். ஏய், யாரங்கே! இவனைக் காவலில் வையுங்கள்."
  },
  {
    "id": "ammaiyappan-s022-d046",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "இப்படித்தான் சொல்லுகிறதா உங்கள் அரசாங்கத்தின் பாசறை நீதி? நன்றாயிருக்கிறது."
  },
  {
    "id": "ammaiyappan-s022-d047",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "பேசவிடாதீர்கள். கூண்டுக்குள் போட்டு மூடுங்கள் இந்தக் குறும்பன்."
  },
  {
    "id": "ammaiyappan-s022-d048",
    "archive_scene_id": "ammaiyappan-s022",
    "archive_scene_ordinal": 22,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-022.md",
    "page_provenance": [
      {
        "pdf_page": 51,
        "printed_page": 49
      }
    ],
    "text": "முத்தா! முன் ஜென்ம கர்ம வினை முடி சூடிய மன்னனையும் விடாது."
  }
]
