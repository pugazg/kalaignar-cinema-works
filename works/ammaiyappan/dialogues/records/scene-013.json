[
  {
    "id": "ammaiyappan-s013-d001",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "திரிசங்கு! காரியம் வெற்றி! ஜெயம்...\nஜெயமே ஜெயம்"
  },
  {
    "id": "ammaiyappan-s013-d002",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "திரிசங்கு",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "என்ன தம்பி?"
  },
  {
    "id": "ammaiyappan-s013-d003",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "அப்பா சம்மதித்து விட்டார். முத்தனை\nவேலையை விட்டு விலக்க உத்திரவு கொடுத்து விட்டார்."
  },
  {
    "id": "ammaiyappan-s013-d004",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பூங்காவனம்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 28,
        "printed_page": 26
      }
    ],
    "text": "என்ன! முத்தனை விலக்கவா? ஏன்?\nஎதற்காக?"
  },
  {
    "id": "ammaiyappan-s013-d005",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "உட்...எதற்காகவா? நமது திரிசங்குவின்\nமகள் முத்தாயியின் கையைப் பிடித்து இழுத்தான். நான்\nஅதைக் கண்டித்தேன். கன்னத்திலே சரியான அறை."
  },
  {
    "id": "ammaiyappan-s013-d006",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "ராணி",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "என்ன?"
  },
  {
    "id": "ammaiyappan-s013-d007",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "ஆ! ஆ! நான் கொடுத்தேன் அவனுக்கு."
  },
  {
    "id": "ammaiyappan-s013-d008",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பூங்காவனம்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "அதைப் பெருமையாகச் சொல்லிக்\nகொள்கிறாயா? ஏழையை அடிப்பதில் ஒரு உற்சாகமா\nஉனக்கு?"
  },
  {
    "id": "ammaiyappan-s013-d009",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "உம்—நடந்த விஷயம் உனக்குத் தெரி\nயாது அத்தை. தெரிந்தால் இப்படியெல்லாம் பேச\nமாட்டாய்."
  },
  {
    "id": "ammaiyappan-s013-d010",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பூங்காவனம்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "சுகதேவ்! முத்தனை விலக்க வேண்\nடாம். அவனுக்கு நம்மைத் தவிர வேறுயார் இருக்கிறார்கள்?\nபாவம் அனாதை—அவன் எங்கு போவான்."
  },
  {
    "id": "ammaiyappan-s013-d011",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "அத்தே! கல்யாணமே வேண்டாமென்று\nகன்னியாக இருக்கும் நீ கடவுளை நினைத்துக் கொண்டு ஜப\nமாலை உருட்டுவியா? இந்த வம்புக் கெல்லாம் ஏன்\nவருகிறாய்?"
  },
  {
    "id": "ammaiyappan-s013-d012",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "பூங்காவனம்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "பார்த்தீர்களா அண்ணி உங்கள் மகன்\nபேசுவதை."
  },
  {
    "id": "ammaiyappan-s013-d013",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "ராணி",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "சுகதேவ்! சும்மா இரு."
  },
  {
    "id": "ammaiyappan-s013-d014",
    "archive_scene_id": "ammaiyappan-s013",
    "archive_scene_ordinal": 13,
    "source_scene_number": null,
    "source_heading": "பலதேவர் மாளிகை",
    "speaker_label": "சுகதேவ்",
    "source_scene_file": "scene-013.md",
    "page_provenance": [
      {
        "pdf_page": 29,
        "printed_page": 27
      }
    ],
    "text": "சரிசரி! வா; திரிசங்கு"
  }
]
