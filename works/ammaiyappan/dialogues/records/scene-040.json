[
  {
    "id": "ammaiyappan-s040-d001",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "ஓம் சக்தி! சாமுண்டி, மகாகாளி, பரமேஸ்வரி, ரேணுகாம்பா, சுந்தரி, சவுந்தரி, நிரந்தரி, துரந்தரி, ஜோதியாய் நின்ற உமையே!....சுக வார்த்தியினைக் கண்டு தரிசித்தவர்கள் துன்பத்தை நீக்கி விடுவாய்!...அம்பிகே! ஜெகதம்பிகே! காளி!..."
  },
  {
    "id": "ammaiyappan-s040-d002",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "முத்தாயி...முத்தாயி..."
  },
  {
    "id": "ammaiyappan-s040-d003",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "இளந்துறவியே! முதலில் என்னுடைய வாழ்த்துக்கள்..."
  },
  {
    "id": "ammaiyappan-s040-d004",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "வெண்தாடிப் பெரியவரே!...உலகம் பொய்! உமக்கென்ன வேண்டும்?..."
  },
  {
    "id": "ammaiyappan-s040-d005",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "பொய்யான இந்த உலகத்தில் மெய்யான இஞ்ஞானி!...உமக்கு எவ்வூர்?...உம்மைப் பார்த்தால் ஏதோ உள்ளங் கவர்ந்த ஒரு பொருளை பறி கொடுத்தவர்போல் தெரிகிறதே!..."
  },
  {
    "id": "ammaiyappan-s040-d006",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "ஹா...ஹா...ஹா! அதிசய மனிதர் நீர்! அகத்தில் உள்ளதை எப்படிக் கண்டீர்? எவ்வாறு விண்டீர்? திரிகால முனிவர் தேவரிஷி நாரதமா உம்மவர்?..."
  },
  {
    "id": "ammaiyappan-s040-d007",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "தம்பி!...காதலில் தோற்றவன் நீ என்பது என் ஞானக் கண்ணிலே தெரிகிறது...மெய் தானே?..."
  },
  {
    "id": "ammaiyappan-s040-d008",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "ஆமாம்! எப்படித் தெரியும் உமக்கு?..."
  },
  {
    "id": "ammaiyappan-s040-d009",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வே",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "உத்தமர்களுக்கு உலகின் ஒவ்வொரு கோடியும் தெரியும்...நீர் ஓர் அரண்மணிவாசி!...ஆணங்கின் மயக்கத்தால் ஆசிரமத்துவாசியாகி விட்டீர்! இல்லையா?..."
  },
  {
    "id": "ammaiyappan-s040-d010",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "ஆமாம், ஸ்வாமி! ஆரணங்குகளின் மயக்கம் விட்டவர்களே. ஆஸ்ரமவாசியாக முடியும் மென்பார்கள்... நானே அந்த மயக்கத்தாலே கட்டுண்டு ஆண்டியாகி இருக்கிறேன்!..."
  },
  {
    "id": "ammaiyappan-s040-d011",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வே",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "அதிசயமில்லை...அரண்மனையை விட்டு ஆசிரமம் வந்தான் விசுவாமித்திரன்...அங்கும் விட்டபாடில்லை, அழகிகளின் தொல்லை...அவன், தவத்தின் மேன்மைக்கோர் எல்லை...மேனகா பெற்ற பிள்ளை..."
  },
  {
    "id": "ammaiyappan-s040-d012",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "ஆகா! பழுத்த அனுபவமும், கொழுத்த பக்தியும் கொண்ட தவசிரேஷ்டரே! தங்களால்தான் நான் தன் பயனை வேண்டும். வரத்தைத் தாருங்கள்..."
  },
  {
    "id": "ammaiyappan-s040-d013",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வே",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "புரிகிறது! அந்த நாலெழுத்து நங்கையை நீ அடையவேண்டும்...அவ்வளவுதானே...?"
  },
  {
    "id": "ammaiyappan-s040-d014",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "மு—த்—தா—யி! ஆகா!...தச்சு...தச்சு...சரியாக சொன்னீர், சற்குருவே!...நாலே எழுத்துதான் அந்தச் நாரீமணியின் பெயர்!..."
  },
  {
    "id": "ammaiyappan-s040-d015",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வே",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "அவளை உனக்கு நான் திருமணம் முடித்து வைக்கிறேன்...இளப்பவயதில் இந்தக் கோலம் வேண்டாம் உமக்கு!...செய்யவேண்டிய அகமெல்லாம் செய்துவிட்டு, தள்ளாத காலத்திலே ‘சிவசிவா’ என்று கூறுவதே மனிதர்க்குத் தகுதியான செய்கை..."
  },
  {
    "id": "ammaiyappan-s040-d016",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "சுக",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "என் முத்தாயி கிடைத்துவிடுவாளா?...தேடாமல் வந்த என் தெய்வமே!...முருகனுக்கும், வள்ளிக்கும் நடுவிலே வந்த நாரதனைப் போல எனக்கும் முத்தாயிக்கும் இடையிலே வந்து இறைவனது திருவருள் பெற்ற என்னப்பனே! போற்றி!...போற்றி!..."
  },
  {
    "id": "ammaiyappan-s040-d017",
    "archive_scene_id": "ammaiyappan-s040",
    "archive_scene_ordinal": 40,
    "source_scene_number": null,
    "source_heading": "அடைக்கலபுரி தேவாலயம்",
    "speaker_label": "வே",
    "source_scene_file": "scene-040.md",
    "page_provenance": [
      {
        "pdf_page": 85,
        "printed_page": 83
      }
    ],
    "text": "சரி வா...என்னுடைய இருப்பிடத்திற்குப் போவோம்...விரைவில் முத்தாயி கிடைப்பாள்..."
  }
]
