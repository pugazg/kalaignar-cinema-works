[
  {
    "id": "ammaiyappan-s024-d001",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 52,
        "printed_page": 50
      },
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "முத்தா! என்ன முட்டாள்தனம் செய்து விட்டாய்! முதலிலேயே யோசித்துச் செய்யக்கூடாது? உன்னை என்ன பலவந்தமாகவா படையில் சேர்த்தேன் நான். வேலழகன் ஒரு முரடன். நீயோ பாபம் மிகவும் நல்லவன். நியாயப்படி உன்னைக் காவலில் வைக்கக்கூடாது. இந்த அநியாயத்தை யார் கேட்டது? பாளையக்காரிடம் ஓடிப்போய் சொன்னேன். அவர் என் பேச்சை லட்சியம்\nசெய்யவே இல்லை. ஏழையின் குரல் ஏழடுக்கு மாளிகையில் எப்படிக் கேட்கும்?",
    "page_segments": [
      {
        "pdf_page": 52,
        "printed_page": 50,
        "text": "முத்தா! என்ன முட்டாள்தனம் செய்து விட்டாய்! முதலிலேயே யோசித்துச் செய்யக்கூடாது? உன்னை என்ன பலவந்தமாகவா படையில் சேர்த்தேன் நான். வேலழகன் ஒரு முரடன். நீயோ பாபம் மிகவும் நல்லவன். நியாயப்படி உன்னைக் காவலில் வைக்கக்கூடாது. இந்த அநியாயத்தை யார் கேட்டது? பாளையக்காரிடம் ஓடிப்போய் சொன்னேன். அவர் என் பேச்சை லட்சியம்"
      },
      {
        "pdf_page": 53,
        "printed_page": 51,
        "text": "செய்யவே இல்லை. ஏழையின் குரல் ஏழடுக்கு மாளிகையில் எப்படிக் கேட்கும்?"
      }
    ]
  },
  {
    "id": "ammaiyappan-s024-d002",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "என்ன வேதாளம்! என்ன மிலக்கிறீர்? நீர் பார்த்து விட்டுத்தான் போகலாம் ஆசையிருந்தால். அவனுடன் நீர் பேசுவதற்கு அனுமதியில்லை. முத்தன் இப்போது கூண்டுப் பறவை."
  },
  {
    "id": "ammaiyappan-s024-d003",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "முத்தன் என்னுடனேயே இருந்தவன் பிரபு. மேன்மை தங்கியவரே! பழகிய பாசம் மிகவும் பொல்லாதது அல்லவா! எப்படியாவது மன்னித்து......"
  },
  {
    "id": "ammaiyappan-s024-d004",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழ",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "ஹா...ஹா...மன்னிப்பதா? இதோ பாரும் அரசாங்க உத்தரவை. இதுவரை சேர்ந்துள்ள படைவீரர்களோடு நான் உடனே திலங்கருக்குப் புறப்படவேண்டு மென்று கட்டளை பிறப்பித்துள்ளார் மன்னவர். இன்றே புறப்படவேண்டும்."
  },
  {
    "id": "ammaiyappan-s024-d005",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "முத்தனுமா?"
  },
  {
    "id": "ammaiyappan-s024-d006",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேலழ",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "ஆமாம்! ஆனால் தண்டப்பணம் நூறு பொன் வந்துவிட்டால் இவன் விடுதலை பெறலாம்...ஹூம்...இவனுக்கேது நூறு பொன்...குப்பையில் கிடப்பவன்!"
  },
  {
    "id": "ammaiyappan-s024-d007",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "ஹூம். முத்தா! உன்னைப் பார்க்கவே எனக்குக் கஷ்டமாக இருக்கிறது அப்பா."
  },
  {
    "id": "ammaiyappan-s024-d008",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "ஐயா! எனக்கு ஒரு உதவி செய்கிறீர்களா?"
  },
  {
    "id": "ammaiyappan-s024-d009",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "என்ன உதவி? சொல்...செய்து முடிக்கிறேன்."
  },
  {
    "id": "ammaiyappan-s024-d010",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "என்னிடம் கொடுக்கச் சொல்லி நூறு பொன் வரும். அதை வாங்கி கட்டி எப்படியாவது என்னை விடுதலை செய்து விடுங்கள்."
  },
  {
    "id": "ammaiyappan-s024-d011",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 53,
        "printed_page": 51
      }
    ],
    "text": "அதைவிட எனக்கு வேறு வேலை? பொன் கட்டாயம் வருமல்லவா?"
  },
  {
    "id": "ammaiyappan-s024-d012",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "கட்டாயம் வரும்."
  },
  {
    "id": "ammaiyappan-s024-d013",
    "archive_scene_id": "ammaiyappan-s024",
    "archive_scene_ordinal": 24,
    "source_scene_number": null,
    "source_heading": "தென்றல் மாளிகை",
    "speaker_label": "வே",
    "source_scene_file": "scene-024.md",
    "page_provenance": [
      {
        "pdf_page": 54,
        "printed_page": 52
      }
    ],
    "text": "முத்தா! இனி பயமில்லை. நீ கவலை இல்லாமல் இரு. எது நடந்தாலும் சரி. பொன் வரட்டும். எல்லாவற்றையும் நான் பார்த்துக் கொள்கிறேன்."
  }
]
