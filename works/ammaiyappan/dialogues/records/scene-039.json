[
  {
    "id": "ammaiyappan-s039-d001",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "எப்படியும் பழுதார் விடுதலை பெறவேண்டும்...இந்த எண்ணம் மக்கள் உள்ளத்திலே பதிய வேண்டும்...விடுதலை உணர்ச்சி காட்டுத்தீபோல் பரவிவிடுமானால் பிறகு ஒரே நாளில் பழுதாரில் சுதந்திரக் கொடியை பறக்க விட்டு வேங்கை நாட்டு ஆதிக்கத்தை விரட்டிவிடலாம்!"
  },
  {
    "id": "ammaiyappan-s039-d002",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "தோழன் 1",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "மக்கள் மனதை மாற்றுவதென்றால்..."
  },
  {
    "id": "ammaiyappan-s039-d003",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "தோழன் 2",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "யோசித்தால் நடக்காது...செயலில் இறங்க வேண்டும்..."
  },
  {
    "id": "ammaiyappan-s039-d004",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "தோழன் 3",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "ஆமாம்...அதுதான் என் அபிப்பிராயமும்..."
  },
  {
    "id": "ammaiyappan-s039-d005",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "மக்கள் எங்கெங்கே தங்கள் கவனத்தை செலுத்துகிறார்களோ, அத்தகைய எல்லாத் துறைகளிலும் நமது கருத்தைப் பரப்ப வேண்டும்..."
  },
  {
    "id": "ammaiyappan-s039-d006",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "தோழ 2",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "ஆங்!...அண்ண ாசொல்வதுதான் சரி!..."
  },
  {
    "id": "ammaiyappan-s039-d007",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "நீங்கள் போங்கள்...மற்றவைகளை கவனிக்க நான் வருகிறேன்..."
  },
  {
    "id": "ammaiyappan-s039-d008",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "முத்தாயி...!"
  },
  {
    "id": "ammaiyappan-s039-d009",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "ஆமாம்; இதெல்லாம் என்ன?"
  },
  {
    "id": "ammaiyappan-s039-d010",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "விடுதலைப் போருக்கு ஆரம்பம்! அவர்கள் என் தோழர்கள்...பழுதார் விடுதலையடைய இது போல ஒரு படையே சேர்க்கிறேன்..."
  },
  {
    "id": "ammaiyappan-s039-d011",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "எனக்கு பயமாயிருக்கிறது..."
  },
  {
    "id": "ammaiyappan-s039-d012",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "பைத்தியம்! பயமா?...புறநானூறு சிரிக்கப் போகிறது உன்னைப் பார்த்து!..."
  },
  {
    "id": "ammaiyappan-s039-d013",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "விடுதலைப் போர் நடத்தினால் உங்கள் உயிருக்கு ஆபத்து வந்து விட்டால்..."
  },
  {
    "id": "ammaiyappan-s039-d014",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 83,
        "printed_page": 81
      }
    ],
    "text": "பிறகென்ன-விடுதலை வீரனுக்கு விருந்தா வைப்பார்கள்?...இத பார்...இந்தக் குழந்தைகூட என்னையே பார்க்கிறது...டேய்!...இதுபோல நமக்கு ஒன்று...."
  },
  {
    "id": "ammaiyappan-s039-d015",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்தாயி",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "இன்னும் எட்டு, ஒன்பது மாதங்கள் பொறுத்திருங்கள்..."
  },
  {
    "id": "ammaiyappan-s039-d016",
    "archive_scene_id": "ammaiyappan-s039",
    "archive_scene_ordinal": 39,
    "source_scene_number": null,
    "source_heading": "தனவணிகர் வீடு",
    "speaker_label": "முத்",
    "source_scene_file": "scene-039.md",
    "page_provenance": [
      {
        "pdf_page": 84,
        "printed_page": 82
      }
    ],
    "text": "ஆ...அப்படியா? நீ சொல்லவில்லையே என்னிடம்..."
  }
]
