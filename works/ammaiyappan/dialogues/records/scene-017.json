[
  {
    "id": "ammaiyappan-s017-d001",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 34,
        "printed_page": 32
      }
    ],
    "text": "ஞாபகத்தில் வைத்துக் கொள்ளுங்கள்—\nஇன்று; நான் நாளை நீங்கள்; இப்படி வயிற்றில் அடிக்கப்\nபடலாம்."
  },
  {
    "id": "ammaiyappan-s017-d002",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "நண்பன்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 34,
        "printed_page": 32
      }
    ],
    "text": "இதற்கு வேறு என்னதான் வழி...?"
  },
  {
    "id": "ammaiyappan-s017-d003",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 34,
        "printed_page": 32
      },
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "நாமெல்லாம் அடிமைகளாய் இருக்கும்\nவரையில் நாளுக்கு ஒரு அதிகாரம் ஆளுக்கு ஒரு நாட்\nடாண்மை இருக்கத்தான் செய்யும்...தேனுக்கு இடம் தேடிக் கொடுத்துவிட்டு தேன் துளிகளுக்கு ஆசைப்பட முடியுமா?...வேங்கை நாட்டான் பழுதார் பாளையக்காரரை மிரட்டுகிறான்... பாளையக்காரர் நம்மை மிரட்டி அந்த ஆத்திரத்தைத் தீர்த்துக் கொள்கிறார்...வீட்டு ரோஜாக்களைக் கசக்கி எறியப் பட்டு ராஜா தர்பார் நடத்துவானும் பாளையக்காரரின் மகன்...அதை நான் கேட்பது தவறுமா?...குதிரைக் காரனும் நான்! கோபுர மேதைகளாம் அவர்கள்! உம்...கொஞ்சம் உயர்ந்த அடிமைகள்; அவ்வளவுதான்!",
    "page_segments": [
      {
        "pdf_page": 34,
        "printed_page": 32,
        "text": "நாமெல்லாம் அடிமைகளாய் இருக்கும்\nவரையில் நாளுக்கு ஒரு அதிகாரம் ஆளுக்கு ஒரு நாட்"
      },
      {
        "pdf_page": 35,
        "printed_page": 33,
        "text": "டாண்மை இருக்கத்தான் செய்யும்...தேனுக்கு இடம் தேடிக் கொடுத்துவிட்டு தேன் துளிகளுக்கு ஆசைப்பட முடியுமா?...வேங்கை நாட்டான் பழுதார் பாளையக்காரரை மிரட்டுகிறான்... பாளையக்காரர் நம்மை மிரட்டி அந்த ஆத்திரத்தைத் தீர்த்துக் கொள்கிறார்...வீட்டு ரோஜாக்களைக் கசக்கி எறியப் பட்டு ராஜா தர்பார் நடத்துவானும் பாளையக்காரரின் மகன்...அதை நான் கேட்பது தவறுமா?...குதிரைக் காரனும் நான்! கோபுர மேதைகளாம் அவர்கள்! உம்...கொஞ்சம் உயர்ந்த அடிமைகள்; அவ்வளவுதான்!"
      }
    ]
  },
  {
    "id": "ammaiyappan-s017-d004",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "மாற்றுவப்பா; மாற்றுவ!...இந்த உள்ளங்கை\nஇடத்துக்கு உள்ள வாடகையைக் கொடுக்க உன்னால் முடிய\nவில்லை...நீ பழுதாரை பூக்காடாவும் மாற்றுவ!...புஷ்பக்\nகாட்டாகவும் மாற்றுவ—ஏய்!...யாரப்பா நீங்கவெல்லாம், ம்...\nஉங்களுக்கு இங்க என்ன வேலை?...உம்...உப்...போங்க...\nபோங்க..."
  },
  {
    "id": "ammaiyappan-s017-d005",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "வாடகையா? இந்த சமயத்திலா கேட்\nகிறீர்கள்?..."
  },
  {
    "id": "ammaiyappan-s017-d006",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "வேறு எப்போது கேட்பது?....\nபொருள் இருக்கும்போதுதான் நீயே கொடுத்துவிடுவாயே,\nஇல்லாதபோது கேட்டுத்தானே வாங்க வேண்டும்..."
  },
  {
    "id": "ammaiyappan-s017-d007",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "ஒரு வேலையும் கிடைக்கவில்லை..."
  },
  {
    "id": "ammaiyappan-s017-d008",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "ஆமாம்!.... இனிமேலும் கிடைக்காது...\nஅதற்காக..."
  },
  {
    "id": "ammaiyappan-s017-d009",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 35,
        "printed_page": 33
      }
    ],
    "text": "கொஞ்சம் பொறுங்கள்."
  },
  {
    "id": "ammaiyappan-s017-d010",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "ஏ. முத்தா! புத்தியற்ற வாலிபனே! இந்த\nஉலகத்தில் பொருள் தேடவா வழி இல்லை..."
  },
  {
    "id": "ammaiyappan-s017-d011",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "திருடவா?..."
  },
  {
    "id": "ammaiyappan-s017-d012",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "சே! ஆள் திடகாத்திரமாய் இருக்கிறாய்...\nதேகத்தில் நல்ல வலு இருக்கிறது..."
  },
  {
    "id": "ammaiyappan-s017-d013",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "பலதேவரை ஒரேயடியாக அடித்து வீழ்த்தி\nவிடலாம்; இல்லையா?..."
  },
  {
    "id": "ammaiyappan-s017-d014",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "பைத்தியக்காரா!...அதுவல்ல நான் சொல்வது—\nவேங்கைபுரத்தாரின் படையில் சேர்ந்து விடு என்கிறேன்!"
  },
  {
    "id": "ammaiyappan-s017-d015",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "என்ன? படையிலா?!..."
  },
  {
    "id": "ammaiyappan-s017-d016",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "ஆமாம்! பாளையக்காரர் அதிகாரம் தடுக்க\nமுடியாது...புகழ் வாய்ந்த வேல்...போர் வீரன் வேல்..."
  },
  {
    "id": "ammaiyappan-s017-d017",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "போதும்...போதும்...நம்மை அடிமைப்\nபடுத்தி இருக்கும் ஆதிக்கக்காரரின் சேணையிலே நான். சே!\nஅதைவிட சாகலாம்!"
  },
  {
    "id": "ammaiyappan-s017-d018",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "ஊரில் இருப்பவர்கள் எல்லோரும் முட்டாள்\nகள். நீதான் அறிவாளியா?...மாய்க்கைநாத சாமியாரே யுத்தப்\nபிரச்சாரம் செய்யப் போகிறார்..."
  },
  {
    "id": "ammaiyappan-s017-d019",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "சாமியார்! செய்வார். சண்டையில் சாகப்\nபோவது அவர் அல்லவே...அதனால்!"
  },
  {
    "id": "ammaiyappan-s017-d020",
    "archive_scene_id": "ammaiyappan-s017",
    "archive_scene_ordinal": 17,
    "source_scene_number": null,
    "source_heading": "அஞ்சல் மனை",
    "speaker_label": "வே",
    "source_scene_file": "scene-017.md",
    "page_provenance": [
      {
        "pdf_page": 36,
        "printed_page": 34
      }
    ],
    "text": "போதும்...நீ படையிலும் சேர வேண்டாம்.\nஒன்றும் வேண்டாம். எனக்கென்ன வந்தது? என்\nவாடகையை மாத்திரம் எப்படியாவது கொடுத்து விடு.\nநல்லவன் கேட்டுப் போகாதே—நான் போகிறேன்...பிரசங்\nகம் கேட்க."
  }
]
