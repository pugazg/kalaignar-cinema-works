[
  {
    "id": "ammaiyappan-s033-d001",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேலழகன்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "என்ன?..."
  },
  {
    "id": "ammaiyappan-s033-d002",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "குறும்பன்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "வேதாளம் வந்திருக்கிறான்..."
  },
  {
    "id": "ammaiyappan-s033-d003",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "வேதாளமா?...வாச் சொல் வாச் சொல்..."
  },
  {
    "id": "ammaiyappan-s033-d004",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "வாரும் வேதாளம்...வெற்றியோடுதான் வந்திருப்பீர் என எண்ணுகிறேன்..."
  },
  {
    "id": "ammaiyappan-s033-d005",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "வெற்றியின் ஆரம்பந்தான் பிரபு!—நமது புது புதிய வேடனிடம் சிக்கி இருக்கிறது!"
  },
  {
    "id": "ammaiyappan-s033-d006",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "என்ன?...என்ன?..."
  },
  {
    "id": "ammaiyappan-s033-d007",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "சொல்கிறேன்...சுகதேவனுக்கும் முத்தாயிக்கும்—ஆனந்தபுரம் கண்ணகி மாளிகையிலே திருமணம்..."
  },
  {
    "id": "ammaiyappan-s033-d008",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 67,
        "printed_page": 65
      }
    ],
    "text": "ஆ!..."
  },
  {
    "id": "ammaiyappan-s033-d009",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "நான்தான் ஏற்பாடு செய்தேன்..."
  },
  {
    "id": "ammaiyappan-s033-d010",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "(கோபமாக) என்ன?..."
  },
  {
    "id": "ammaiyappan-s033-d011",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "வாருங்கள்......முத்தாயியை உங்களிடம் சேர்ப்பதற்காகவே இந்த சூழ்ச்சியை ஆரம்பித்திருக்கிறேன்..."
  },
  {
    "id": "ammaiyappan-s033-d012",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "புரியும்படி சொல்லும்..."
  },
  {
    "id": "ammaiyappan-s033-d013",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "நான் சொல்கிறபடி நீங்கள் செய்ய வேண்டும்...சுகதேவனுக்கும் முத்தாயிக்கும் திருமணம் நடக்கப் போகிறது...தாங்கள் முத்தனை உடனே அங்கு அனுப்ப வேண்டும்...முத்தன் போனால் முத்தாயி அவனுடன் ஓடி வருவாள்...இருவரும் தப்பி வரும்போது நாம் முத்தனை துரத்தி விட்டு முத்தாயியை மட்டும் அபகரித்துவிட வேண்டும்..."
  },
  {
    "id": "ammaiyappan-s033-d014",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "நல்ல யோசனை...முத்தன் நம் சூழ்ச்சியைப் புரிந்து கொண்டால்?..."
  },
  {
    "id": "ammaiyappan-s033-d015",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "உம்...காதல் மயக்கத்தில் எதையும் யோசிக்க மாட்டான்...ஒருவன் குதிரை வீரன் (வருகிறான்.)"
  },
  {
    "id": "ammaiyappan-s033-d016",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வீரன்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "பிரபு! முத்தன் சிறையிலிருந்து தப்பியோடினான்...பிடித்து வந்திருக்கிறோம்..."
  },
  {
    "id": "ammaiyappan-s033-d017",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "எங்கே?...கொண்டு வாருங்கள்...வேதாளம்; நீர் சற்று மறைந்திரும்..."
  },
  {
    "id": "ammaiyappan-s033-d018",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "சரி! நீங்கள் போகலாம்...ஹி...ஹி...ஹி...முத்தா!...நீ சிறையிலிருந்து தப்பி ஓடாவிட்டாலும் நானே உன்னை விடுவித்து அனுப்புவதாக யோசித்துக் கொண்டிருந்தேன்...நல்ல வாலிபனே!...உன்னை நான் மிகவும் கஷ்டப்படுத்திவிட்டேன்...வருந்துகிறேன், அதற்காக...."
  },
  {
    "id": "ammaiyappan-s033-d019",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      }
    ],
    "text": "அய்யா! திடமென்று மாறிவிட்டீர்களே...நான் திக்கற்றவன் என்பதை எப்படி உணர்ந்தீர்கள்?......தெய்வமும் வந்து சொல்லி இருக்க முடியாதே!"
  },
  {
    "id": "ammaiyappan-s033-d020",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 68,
        "printed_page": 66
      },
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "மனிதனுக்கு மனச்சாட்சி என்று ஒன்று இருக்கிறது. மனிதன் மிருகமாக மாறும் போது அந்த\nமனச்சாட்சி புழுவாக மாறி அடங்கிக் கிடக்கும். மிருகத் தன்மை தோல்வி அடையும் நேரத்தில் புழுவாகிப்போன மனச்சாட்சி புள்ளி மயிலாக எழுந்து நடனமாடும்...அந்த ஆட்டத்திலேதான் உண்மையின் அழகு ஒளிவிட ஆரம்பிக்கிறது.",
    "page_segments": [
      {
        "pdf_page": 68,
        "printed_page": 66,
        "text": "மனிதனுக்கு மனச்சாட்சி என்று ஒன்று இருக்கிறது. மனிதன் மிருகமாக மாறும் போது அந்த"
      },
      {
        "pdf_page": 69,
        "printed_page": 67,
        "text": "மனச்சாட்சி புழுவாக மாறி அடங்கிக் கிடக்கும். மிருகத் தன்மை தோல்வி அடையும் நேரத்தில் புழுவாகிப்போன மனச்சாட்சி புள்ளி மயிலாக எழுந்து நடனமாடும்...அந்த ஆட்டத்திலேதான் உண்மையின் அழகு ஒளிவிட ஆரம்பிக்கிறது."
      }
    ]
  },
  {
    "id": "ammaiyappan-s033-d021",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "ஆகா! சிறப்பான கருத்து இந்த இடத்திலேயும் முளைக்கிறது, சேற்றிலே செந்தாமரை முளைப்பதைப் போல..."
  },
  {
    "id": "ammaiyappan-s033-d022",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "முத்தா! என் கண்ணைத் திறந்துவிட்ட செய்தி எது தெரியுமா?...உன் அன்புக் காதலி முத்தாயியை அந்த சுகதேவன் பலவந்தமாக மணம் புரியப் போகிறான்..."
  },
  {
    "id": "ammaiyappan-s033-d023",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "உண்மையாகவா?..."
  },
  {
    "id": "ammaiyappan-s033-d024",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "ஆமாம்! ஆனந்தபுரம் கண்ணகி மாளிகையிலே திருமணம்...அவள் ஆவி பிரிவதற்கு முன்னாள் நீ ஓடு...முத்தா! எனக்கேனு இப்போது இவ்வளவு அக்கறை என்று கருதுவாய்...லைலாமஜ்னு கதை படித்திருப்பாயே நீ...லைலாவின் கணவன் அவளின் அவன் காதலன் கயசிடம் திருப்பி அனுப்பிய நிகழ்ச்சிக்கும் இதற்கும் அதிக வேறுபாடில்லை...முத்தா! ஒன்று சொல்கிறேன்...நீயும் முத்தாயியும் என் பாதுகாப்பிலேயே குடும்பம் நடத்தலாம்...அதற்கென்ன இப்போது, அவசரம்!......உடனே போ...உன் உயிரிணையாளைக் காப்பாற்று...[உள்ளேபோய் சிறந்த ஆடைகள் எடுத்து வந்து] இஞ்ஞுனே! இப்போதே ஓடு...இழந்த காதலைப் பெற்றிடு...இந்தா அழகான உடைகள். அணிந்து கொள்...ஆனந்தமாக திருமணத்தை முடித்துக் கொண்டுவா!..."
  },
  {
    "id": "ammaiyappan-s033-d025",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "முத்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "மிகவும் நன்றி உடையவனய்யா நான்..."
  },
  {
    "id": "ammaiyappan-s033-d026",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதாளம்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 69,
        "printed_page": 67
      }
    ],
    "text": "சபாஷ் பிரபுவே! மிகவும் நன்றாக நடித்துவிட்டார்கள்."
  },
  {
    "id": "ammaiyappan-s033-d027",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "சரியானபடி ஏமாந்து விட்டான் பயல்...\n\nவேதாளம்!...அடுத்த ஏற்பாடு என்ன?..."
  },
  {
    "id": "ammaiyappan-s033-d028",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேதா",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "அடுத்த ஏற்பாடு!...ஐந்தாறு குதிரை வீரர்களே அடியேனுடைய தலைமையில் அனுப்புங்கள். அந்த அழகியுடன் வந்து சேருகிறேன்."
  },
  {
    "id": "ammaiyappan-s033-d029",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "வேல",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "ஆயிரம் பொன் தருவேன்...அவளுடன் வந்தால்..."
  },
  {
    "id": "ammaiyappan-s033-d030",
    "archive_scene_id": "ammaiyappan-s033",
    "archive_scene_ordinal": 33,
    "source_scene_number": null,
    "source_heading": "தனபதி மாளிகை",
    "speaker_label": "முத்தன்",
    "source_scene_file": "scene-033.md",
    "page_provenance": [
      {
        "pdf_page": 70,
        "printed_page": 68
      }
    ],
    "text": "[தனியாக] சதி செய்கிறார்கள்....அந்தச் சதியை எனக்குச் சாதகமாக்கிக் கொள்கிறேன்."
  }
