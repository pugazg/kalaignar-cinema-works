[
  {
    "id": "maruthanattu-ilavarasi-s003-d001",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "அப்பா!",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d002",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணிபல்லவர்",
    "source_delimiter": ":",
    "text": "அப்பா! இதோ பார் அப்பாவுக்கு நீ தேடித் தந்த அருமையான பரிசை. நாடு, நகரம் எல்லாம் துறந்து காட்டுக்குப் போக வேண்டும் உன் அப்பா.",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d003",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "(கடிதத்தைப் பார்க்கிறாள்) மணிபல்லவ, மன்னவா! பெண் அல்லது போர்! இதற்கு உன் சம்மதம் தேவை.\nகோபதிவர்மன்.\nஆஹா! என்ன வீரமான எச்சரிக்கை. அப்பா! பதில் எழுதுங்கள் போர்! போர் என்று எழுதுங்கள்.",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d004",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "போதும், உன் வாயால் வந்த வினை! குஞ்சு செய்த குற்றம் கோழியின் தலையில் விடிந்தது.",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d005",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "ஏனப்பா ஏங்குகிறீர்கள். எறும்புகூட தன் பகையை எதிர்க்கிறதே!",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d006",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "ராணி! காவேரியின் தண்ணீரை சிவப்பாக்க நான் விரும்பவில்லை. மருதநாட்டு வீரர்கள் பிணமாக்க எனக்கு மனமில்லை, நாட்டின் அமைதிக்காக நீ ரௌத்ரனை மணந்து கொள்ளத்தான் வேண்டும்.",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d007",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "அப்பா!",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d008",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "எனக்காக நீ இந்த தியாகம்கூடவா செய்யக் கூடாது?",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d009",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "தங்களுக்காக உயிரைத் தியாகம் செய்கிறேன். மானம் தியாகம் செய்யும் பொருள் அல்ல தந்தையே!",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d010",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "ராணி! வெற்றி அவர்கள் பக்கமென்றால் நம் மானம் என்னாவது?",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d011",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "வெற்றி! அது வீரர்களின் ரத்தம் நிர்ணயிக்க வேண்டிய முடிவு! அதைப்பற்றி இப்போது என்ன கவலை.",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d012",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "வீரர்களின் பலமும், என் பலமும் எனக்குத் தெரியும். உன் உபதேசம் வேண்டாம்.",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d013",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "அப்பா! தாங்களா இப்படிப் பேசுகிறீர்கள்! வேலும், வாளும், வாழ்க்கையில் தோழனென்று கூறும் வம்சத்தில் பிறந்த தாங்களா இப்படிப் பேசுகிறீர்கள்! வெண்கொடுமை சாக்காட்டில், விளையாடும் தோளெங்கள் வெற்றித் தோள்கள் என்று வீரப்பாண்டிய பரம்பரையில் பிறந்த தாங்களா இப்படிப் பேசுகிறீர்கள்? ஈட்டியின் பாய்ச்சல் கண்டு இமை கொட்டியவன் கோழை! இதை இதய கீதமாக்கிக்கொண்ட தமிழனுக்குப் பிறந்த தாங்களா இப்படிப் பேசுகிறீர்கள்? வெட்கம், இழிவு, நம் நாட்டு சரித்திரத்திற்கே இழிவு. களம், பலகண்ட கதிரவன் சிரிப்பான்! வீரர்களைத் தாங்கிய இந்த பூமி சிரிக்கும். வேண்டாமப்பா! வீர வரலாற்றில் களங்கம் வேண்டாம். மரணத்திற்குப் பயந்து, மாற்றானுக்கு மகளை கப்பமாக அளித்தார் மணிபல்லவர் என்று மாநிலம் சிரிக்கும். அந்த மாசு படிய வேண்டாம்.",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      }
    ],
    "source_scene_file": "scene-003.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s003-d014",
    "segment_id": "maruthanattu-ilavarasi-s003",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 3,
    "source_scene_number": 3,
    "source_heading": "காட்சி 3.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "வேண்டாம் ராணி! உணர்ச்சியற்ற என் உள்ளத்தை சம்மட்டியால் அடிக்க வேண்டாம். புழுவாய் நெளிந்த என்னைப் புலியாக மாற்றிவிட்டாய்! கண்ணைப்போல் காப்பதை, அந்தக் கரடிவாயில் தள்ள மாட்டேன்! கொக்\nகரிக்கும் குறிஞ்சி நாடே! பெண் கிடையாது! உன் கொட்டத்தை அடக்கப் போர்!",
    "page_provenance": [
      {
        "pdf_page": 7,
        "printed_page": 6
      },
      {
        "pdf_page": 8,
        "printed_page": 7
      }
    ],
    "source_scene_file": "scene-003.md",
    "page_segments": [
      {
        "pdf_page": 7,
        "printed_page": 6,
        "text": "வேண்டாம் ராணி! உணர்ச்சியற்ற என் உள்ளத்தை சம்மட்டியால் அடிக்க வேண்டாம். புழுவாய் நெளிந்த என்னைப் புலியாக மாற்றிவிட்டாய்! கண்ணைப்போல் காப்பதை, அந்தக் கரடிவாயில் தள்ள மாட்டேன்! கொக்"
      },
      {
        "pdf_page": 8,
        "printed_page": 7,
        "text": "கரிக்கும் குறிஞ்சி நாடே! பெண் கிடையாது! உன் கொட்டத்தை அடக்கப் போர்!"
      }
    ]
  }
]
