[
  {
    "id": "maruthanattu-ilavarasi-opening-d001",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதிவர்மன்",
    "source_delimiter": ":-",
    "text": "கொலைகாரி. போதும் உன் கும்மாளம். அங்கே நாசவேலை நடத்திவிட்டு அதை மறைக்க இங்கே நடனம்.",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d002",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "என்ன?",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d003",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "சிங்காரியின் வாழ்வைச் சிதைக்க நீ போட்டாயே திட்டம், அது செத்துவிட்டது தெரியுமா? சண்டாளி.",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d004",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "திட்டமா? என்ன?",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d005",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "ஆஹா! என்ன நடிப்பு அக்கிரமக்காரி, உன்னை அக்கினியில் தள்ளிப் பொசுக்கினாலும் போதாது.",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d006",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பானந்தர்",
    "source_delimiter": ":-",
    "text": "அரசே, கோபம் நீதியை மறைத்து விடும், நிதானமாக....",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d007",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "நிதானம், அன்பானந்தரே! நீரே கேளும் இந்த நீலியை!",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d008",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பா",
    "source_delimiter": ":-",
    "text": "மகாராணி, இளையராணி கர்ப்பமுற்றிருப்பதில் தங்களுக்குப் பொறாமை, அந்தக்குழந்தை ராஜ்யத்தில் பங்கு கேட்குமே என்ற பயம். அதன் காரணமாய் இளைய ராணிக்கு அனுப்பப்பட்ட மருந்தில் தாங்கள் விஷம் கலந்து விட்டார்கள்.",
    "page_provenance": [
      {
        "pdf_page": 2,
        "printed_page": 1
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d009",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "ஆ!",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d010",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பா",
    "source_delimiter": ":-",
    "text": "இது இளைய மகாராணியின் குற்றச்சாட்டு",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d011",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "இதை நம்புகிறீர்களா?",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d012",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "நன்றாக நம்புகிறேன், சித்ரா சிங்காரியை மட்டுமென்ன, உன் சுயநலத்திற்காக என்னையே கொலை செய்யவும் துணிவாய்!",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d013",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "அக்கிரமமான கட்டுக்கதை. நான் நிரபராதி! என் நெஞ்சைப் பிளக்காதீர்கள்.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d014",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "சீ! தொடாதே. (கீழே தள்ளிவிடுகிறான்)",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d015",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பா",
    "source_delimiter": ":-",
    "text": "அரசே! பூரண கர்ப்பவதி.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d016",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "கர்ப்பவதி! சிங்காரியும் கர்ப்பவதிதான்.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d017",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "சுவாமி, சிங்காரியை என் தங்கையாக மதிக்கிறேன்.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d018",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "பொய், சுத்தப்பொய்!",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d019",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "எனக்காக வாதாட யாருமில்லை. சிங்காரியின் பக்கம் அவள் அண்ணன். அவள், அன்புக்குரிய மன்னர். எனக்கு சத்தியம் மாத்திரந்தான் சாட்சி!",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d020",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பா",
    "source_delimiter": ":-",
    "text": "மகாராஜா! விஷய விளக்கத்திற்கு வாதி, பிரதிவாதி இருவரையும் விசாரிக்க வேண்டும்.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d021",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "வீண் நம்பிக்கை, இருந்தாலும் குறிஞ்சிநாட்டுக் கொற்றவன் அவசரப்பட்டான் என்ற அவச் சொல் வேண்டாம். நீதிமன்றத்திற்கு நீரே ஏற்பாடு செய்யும்.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d022",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "காளிங்கா, காரியம் கெட்டு விட்டது. எதிர்பார்த்தது நடக்கவில்லை. நாளை நீதிமன்றத்தில் நமது சூழ்ச்சிகள் அம்பலமாகிவிடும். இந்த துர்ஜயன் ஏகபோக அதிகாரத்திற்கு சமாதி அமைக்கப்பட்டுவிடும். இந்தத்தரணியை என் தங்கையின் மகன் ஆளவேண்டுமென்ற ஆசை அழிபட்டுப்போகும். இதிலிருந்து நாம் மீள வேண்டுமானால் மகாராணி மாளவேண்டும்.",
    "page_provenance": [
      {
        "pdf_page": 3,
        "printed_page": 2
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d023",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "காளிங்கன்",
    "source_delimiter": ":-",
    "text": "ஆமாம்!",
    "page_provenance": [
      {
        "pdf_page": 4,
        "printed_page": 3
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d024",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "இன்றிரவே நமது திட்டம் நிறைவேறியாகவேண்டும்.",
    "page_provenance": [
      {
        "pdf_page": 4,
        "printed_page": 3
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d025",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பா",
    "source_delimiter": ":-",
    "text": "இன்றிரவே நமது திட்டம் நிறைவேறியாகவேண்டும்.",
    "page_provenance": [
      {
        "pdf_page": 4,
        "printed_page": 3
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d026",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "அப்படியானால், நான் அரண்மனையைவிட்டு ஓடவேண்டுமா?",
    "page_provenance": [
      {
        "pdf_page": 4,
        "printed_page": 3
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d027",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "அன்பா",
    "source_delimiter": ":-",
    "text": "ஆம் அம்மணி! இந்த ஆபத்திலிருந்து விடுதலை பெற வெளியேறித்தான் ஆகவேண்டும்.",
    "page_provenance": [
      {
        "pdf_page": 4,
        "printed_page": 3
      }
    ],
    "source_scene_file": "opening.md"
  },
  {
    "id": "maruthanattu-ilavarasi-opening-d028",
    "segment_id": "maruthanattu-ilavarasi-opening",
    "segment_kind": "unnumbered-opening",
    "derivative_ordinal": 1,
    "source_scene_number": null,
    "source_heading": null,
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "வெளியேறி அரசருக்கு வருத்தத்தை அதிகமாக்குவதைவிட உயிர் விடுவது மேல்.",
    "page_provenance": [
