[
  {
    "id": "maruthanattu-ilavarasi-s005-d001",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "ரௌத்ரன்",
    "source_delimiter": ":-",
    "text": "கொக்கரிக்கும் குறிஞ்சிநாடே பெண் கிடையாது. போர்! மணிபல்லவரே உமது மாளிகையில், குறிஞ்சிநாட்டுக் கொடி பறக்கிறது.",
    "page_provenance": [
      {
        "pdf_page": 8,
        "printed_page": 7
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d002",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அதோடு மருதநாட்டு மானமும் சேர்ந்து பறக்கிறது.",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d003",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "மார் தட்டிக்கொள்ளாதீர்கள். நின்று எதிர்க்க முடியாத கோழைகள்!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d004",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அன்று கடல்மடை திறந்தாற்போல் கர்ஜித்தாயே! இதோ பார் நீ அலட்சியப்படுத்திய ஆணழகன்! உன்னை அடிமையாக்க வந்திருக்கிறான்! வீராதிவீரனாக! வெற்றிச் சிங்கமாக! (சிரிப்பு) உன் வாழ்க்கைத் துணைவனாக!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d005",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "வஞ்சக நரிகள்! புலியைக் கூண்டில்போட்டு பூட்டிவிட்டு போர் பிரசங்கம் செய்யும் சோதாக்கள்!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d006",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "உன் புலம்பலைக் கேட்க நேரமில்லை. மணத்திற்கு உன் சம்மதம் அல்லது மணிபல்லவனின் மரணம்!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d007",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "மணி",
    "source_delimiter": ":-",
    "text": "ராணி! சம்மதிக்காதே, என்னைச் சித்திரவதை செய்தாலும் சரி! என்னை நெருப்பில் தள்ளி பொசுக்கினாலும் சரி! என் பிணத்தை காக்கைக்கும் கழுகிற்கும் விருந்தாக்கி, அந்தக் காட்சியை உனக்குக்காட்டினாலும் சரி இந்த சண்டாளனை மணக்கச் சம்மதிக்காதே.",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d008",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "சம்மதிக்க வைக்கிறேன்! இப்போது என்ன சொல்கிறாய்!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d009",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "வேண்டாம், விடுங்கள்.",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d010",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "முடியாது! நீ மணத்திற்கு சம்மதித்தாலன்றி விடமுடியாது.",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d011",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "ராணி",
    "source_delimiter": ":-",
    "text": "சம்மதித்தேன். அவரை விடுங்கள்!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s005-d012",
    "segment_id": "maruthanattu-ilavarasi-s005",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 5,
    "source_scene_number": 5,
    "source_heading": "காட்சி 5.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "நாளைக்கு பயணம், தயாராகிக்கொள்! அதற்குள் நீ தப்ப முயன்றால் உன் தந்தையின் தலை தரையில் உருளும் ஜாக்கிரதை! இவனைப் பாதுகாப்பில் வையுங்கள்!",
    "page_provenance": [
      {
        "pdf_page": 9,
        "printed_page": 8
      }
    ],
    "source_scene_file": "scene-005.md"
  }
]
