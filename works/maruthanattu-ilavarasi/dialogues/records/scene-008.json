[
  {
    "id": "maruthanattu-ilavarasi-s008-d001",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "நீ குற்றவாளி. இதை ஒப்புக்கொள்ளுகிறாயா?",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 12
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d002",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "என்னை ஏன் கேட்க வேண்டும். நேர்மையான விசாரணைக்குப் பிறகு நீங்கள் நிர்ணயிக்க வேண்டிய முடிவு அது.",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 12
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d003",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "விசாரணை மகாராஜா வெளிச்சத்தில் விளக்கு தேவை இல்லை. இந்த வழக்கிற்கு விசாரணையே தேவை இல்லை.",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 12
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d004",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "இருக்கலாம், சொந்த கண்களையே நம்ப முடியாத இந்தக்காலத்தில் அவசரப்பட்டு நீதியை அழித்து விடக்கூடாது. காண்டிபா மனச் சாட்சிக்கு விரோதமின்றிச் சொல். நீ கொலை செய்தது உண்மைதானே?",
    "page_provenance": [
      {
        "pdf_page": 13,
        "printed_page": 12
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d005",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "உங்கள் மன ஆறுதலுக்காக நான் கொலைக் குற்றத்தை ஒப்புக்கொள்ள வேண்டுமா? மகாராஜா நீதியின் சாயாத பண்பு தங்களிடம் இருந்தால் தயவுசெய்து ஆலோசியுங்கள். மகனின் பிரிவு மனப்பதட்டத்தை அதிகப்படுத்தும். ஆனால் ஒரு கொலை மற்றொரு கொலைக்கு சாந்தி ஆகாது.",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d006",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "இது குற்றவாளிக் கூண்டு, குருநாதர் பீடமில்லை. இளவரசனைக் கொன்றது நீ, இதற்கு உன் ஆட்சேபம்.",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d007",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "நிறைய இருக்கிறது. ஆண்கள் நுழையக் கூடாத காளி கோவிலில் துர்ஜயனுக்கும் ரௌத்திரனுக்கும் அந்த நேரத்தில் அங்கு வேலை.",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d008",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "பொய், சுத்தப்பொய். அரசே இவனை கைது செய்த அத்தனை சிப்பாய்களையும் கேளுங்கள். என்னை காளிகோயிலில் பார்த்தவர்கள் யாராவது இங்கு இருக்கிறார்களா? உயிர் பிழைப்பதற்காக உழுத்த வாதங்கள் அள்ளி வீசுகிறான் உன்மத்தன்! மன்னரின் நீதிமன்றத்தை அவ்வளவு மட்டமாக நினைத்துவிட்டான் மண்டூகம்!",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d009",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "நீதியை வரவழைக்க நேரம் தெரியாமல் இவன் வாட்டுக் கூச்சலுக்கு ஒதுக்கியிருக்கும் இந்த இடத்திற்கு பெயர் நீதிமன்றமா? இங்கு வழங்குவதற்குப் பெயர் தான் நீதியா?",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d010",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "என்ன?",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d011",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "தெய்வ நீதி வேண்டுமென்கிறான் தகிடு தத்தக்காரன்.",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d012",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "இல்லை. மனித நீதி போதும் என்கிறேன் மன்னர். மன்னர் மகனைக் கொன்றதாக நான் இதற்கு நீதி தேவன் ஸ்தானத்தில் வீற்றிருக்க வேண்டியது மன்னரல்ல இந்த மாநிலத்து மக்கள்.",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d013",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "சபையோர்",
    "source_delimiter": ":-",
    "text": "ஆம் மகாராஜா குற்றவாளியின் வாதமும் பொருத்தமானதுதான்,",
    "page_provenance": [
      {
        "pdf_page": 14,
        "printed_page": 13
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d014",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "பொருத்தமானது. மன்னரையே ஒரு பிரஜை கொன்றுவிட்டு அந்தக்கொலை விசாரணைக்கு பிரஜைகளே தீர்ப்புக் கூறுவது அதைவிட பொருத்தமானது.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d015",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "சரியாகச் சொன்னீர். சட்டத்தை மீறி நீ காளிகோவிலில் நுழைந்தது ஒரு குற்றம்.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d016",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "இல்லை சட்டத்தை மீறினது நான் அல்ல. தங்கள் மகன்.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d017",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "இறந்துபோன இளவரசனைப்பற்றி இங்கு பேச்சில்லை.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d018",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "அப்படியானால் இந்த விசாரணையே தேவை இல்லை.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d019",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "சபையோர்",
    "source_delimiter": ":-",
    "text": "கேள்விக்குப் பதில். உன் கேலிக்கு நேரமில்லை.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d020",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "நேர்மை கேலியாகத் தோன்றுகிறது. நீதி இருட்டிலிருப்பதால் அறிவு குருடாகிவிட்டதா? மகாராஜா கேளுங்கள்! சபையோர்களே கேளுங்கள்!",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d021",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "கேளுங்கள்! கேளுங்கள்! நன்றாகக் கேளுங்கள்!",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d022",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்",
    "source_delimiter": ":-",
    "text": "என் காதலியைக் கைப்பற்ற துர்ஜயனும் ரௌத்திரனும் முயன்றார்கள். அதற்காக கள்ளர்கள் நடுங்கும் நள்ளிரவில் காளி கோயிலுக்குள் நுழைந்தார்கள். நானும் தொடர்ந்தேன் அங்கு, என் தோகைமயிலாளை இந்த துரோகிகள் தொட்டு இழுத்தனர். நான் ஏழைதான், ஏழை என்றால் இதயம் இருக்காதா! பாவையர் வேட்டையாடும் இந்த பாபிகள்மேல் பாய்ந்தேன். இந்த பயந்தாங்கொள்ளி எங்கேயோ பதுங்கிவிட்டான். பிறகு போர், வாள்ப்போர், மல்ப்போர், எங்கிருந்தோ ஒரு கட்டாரி எனக்கும் தெரியாமல் ரௌத்திரன் உயிரைக் குடித்துவிட்டது. இந்தக் கொலையைப்பற்றி எனக்குத் தெரிந்தது இதுதான்.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d023",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "சபையோர்",
    "source_delimiter": ":-",
    "text": "இதற்கு எல்லாம் சாட்சியங்கள்?",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d024",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "கிடையாது.",
    "page_provenance": [
      {
        "pdf_page": 15,
        "printed_page": 14
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d025",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜ",
    "source_delimiter": ":-",
    "text": "சாட்சியம் இல்லாத வாக்குமூலம், சாரீரமில்லாத சங்கீதம் அம்பலத்திற்கு வர முடியாது அரசே! நானும் ரௌத்திரனும் காளிகோயிலில் நுழைந்தோம். இது காண்டிபனின் வாதம். இவனை கைது செய்த அத்தனை சிப்பாய்களுக்கும் தெரியாமல் நான் எங்கே பதுங்கிவிட்டேன். நான் என்ன கண்கட்டி வித்தைக்காரனா? அல்லது கடவுள் அவதாரமா? உண்மை அதுவல்ல. ராணி காளி கோயிலில் இருந்திருக்கிறாள், காண்டிபன் அவளைச் சந்திக்கச் சென்றிருக்கிறான் கள்ளக் காதலின் காமவேட்கை அது. ரௌத்திரன் அதைக்கவனித்திருக்கலாம். ஆனால் அதற்கும் கொலைக்கும் என்ன சம்பந்தமென்பீர்கள்? ஏன் இவனே ரௌத்திரனை காளி கோயிலுக்கு இழுத்துச்சென்றிருந்தால்! இவன் வலையில் சிக்கி அந்த சுத்தவீரனை இவனே கொன்றிருந்தால்!",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 15
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d026",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "நான் கொன்றிருந்தாலும் அது அநியாயமல்ல. இந்த நாட்டுக்குச் செய்த நல்ல காரியத்தைச் செய்து முடித்ததாக எண்ணுவேன்.",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 15
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d027",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "என்ன?",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 15
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d028",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்",
    "source_delimiter": ":-",
    "text": "இறந்துபோன இளவரசன் இந்நாட்டு மக்கள் காட்டு மிருகம்போல் நடத்தியது உங்களுக்குத் தெரியாதா?",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 15
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d029",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "சபையோர்",
    "source_delimiter": ":-",
    "text": "இது அவன் ராஜ்யம்",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 15
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d030",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்",
    "source_delimiter": ":-",
    "text": "ஆண்டவன் ராஜ்யமாக இருக்கட்டுமே! அநீதியை எதிர்க்க பிரஜைகளுக்கு உரிமை உண்டு. எத்தனை இளம் பெண்களின் கற்பு உங்கள் இளவரசன் லீலாவிநோதங்களுக்கு பலி கொடுக்கப்பட்டிருக்கிறது, ஏன் என்று கேட்ட எத்தனை ஏழை மக்களின் ரத்தத்தைப் பார்த்து கோர சிரிப்புச் சிரித்திருக்கிறான் உங்கள் இளவரசன். அவனை விட்டிருந்தால், அவன் பட்டத்திற்கு வந்திருந்தால் பெண்களின் கரங்களை செங்கோலாக்கிக்கொண்டு அந்தப்புரத்தை சபாமண்டபமாக்கிக்கொண்டு, சரசசல்லாபங்களை சட்டப் புத்தகமாக்கிக்கொண்டு ரதி மதன ஆட்சியல்லவா நடத்தியிருப்பான். நல்லாட்சியா நடைபெறும்\nஇந்த நாட்டில், நாட்டு மக்கள் செய்த பாக்கியம் ரௌத்திரன் படுகொலை செய்யப்பட்டான்.",
    "page_provenance": [
      {
        "pdf_page": 16,
        "printed_page": 15
      },
      {
        "pdf_page": 17,
        "printed_page": 16
      }
    ],
    "source_scene_file": "scene-008.md",
    "page_segments": [
      {
        "pdf_page": 16,
        "printed_page": 15,
        "text": "ஆண்டவன் ராஜ்யமாக இருக்கட்டுமே! அநீதியை எதிர்க்க பிரஜைகளுக்கு உரிமை உண்டு. எத்தனை இளம் பெண்களின் கற்பு உங்கள் இளவரசன் லீலாவிநோதங்களுக்கு பலி கொடுக்கப்பட்டிருக்கிறது, ஏன் என்று கேட்ட எத்தனை ஏழை மக்களின் ரத்தத்தைப் பார்த்து கோர சிரிப்புச் சிரித்திருக்கிறான் உங்கள் இளவரசன். அவனை விட்டிருந்தால், அவன் பட்டத்திற்கு வந்திருந்தால் பெண்களின் கரங்களை செங்கோலாக்கிக்கொண்டு அந்தப்புரத்தை சபாமண்டபமாக்கிக்கொண்டு, சரசசல்லாபங்களை சட்டப் புத்தகமாக்கிக்கொண்டு ரதி மதன ஆட்சியல்லவா நடத்தியிருப்பான். நல்லாட்சியா நடைபெறும்"
      },
      {
        "pdf_page": 17,
        "printed_page": 16,
        "text": "இந்த நாட்டில், நாட்டு மக்கள் செய்த பாக்கியம் ரௌத்திரன் படுகொலை செய்யப்பட்டான்."
      }
    ]
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d031",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அப்படிச் சொல்! இளவரசன் செய்தது அநீதி அதைத்தடுக்க அவனைக் கொலை செய்தாய்!",
    "page_provenance": [
      {
        "pdf_page": 17,
        "printed_page": 16
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d032",
