  },
  {
    "id": "maruthanattu-ilavarasi-s008-d049",
    "segment_id": "maruthanattu-ilavarasi-s008",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "காண்டி",
    "source_delimiter": ":-",
    "text": "அம்மா!",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 17
      }
    ],
    "source_scene_file": "scene-008.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s008-d050",
    "segment_id": "maruthanattu-ilavarasi-s008",
