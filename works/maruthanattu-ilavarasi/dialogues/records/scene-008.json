    "derivative_ordinal": 8,
    "source_scene_number": 8,
    "source_heading": "காட்சி 8.",
    "speaker_label": "சித்ரா",
    "source_delimiter": ":-",
    "text": "கலங்காதே, கண்ணே! இனி நமக்கு நல்ல காலம் தான்.",
    "page_provenance": [
      {
        "pdf_page": 18,
        "printed_page": 17
      }
    ],
