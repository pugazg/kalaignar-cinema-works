[
  {
    "id": "maruthanattu-ilavarasi-s002-d001",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "சேவகன்",
    "source_delimiter": ":-",
    "text": "மகாராஜா! எங்கு தேடியும் மகாராணியைக் காணவில்லை.",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d002",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "ஆ! காணவில்லையா?",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d003",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அது மட்டுமல்ல, மகாராஜா மந்திரியையும் காணவில்லை!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d004",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "தேடிப் போனவர் திரும்பவில்லையா?",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d005",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "தேடிப்போனாலல்லவா திரும்ப!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d006",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "துர்ஜயா நீ என்ன சொல்கிறாய்?",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d007",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "சொல்லவேண்டிய விஷயமா இது! மகாராஜா! மகாராணி என்றாலேயே, மந்திரிக்கு தனிப்பாசம்!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d008",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "ஆம்! அதுதான் நாம் சொல்லாமலேயே தேடப் புறப்பட்டிருக்கிறார்.",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d009",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அமைச்சருக்கு அரசாங்கத்தில் தனி ஆசை! அதைவிட மகாராணிமீது அபாரமான அன்பு!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d010",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "நான்கூடத்தான் அந்த அரக்கியிடம் அன்பு காட்டினேன்.",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d011",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "மன்னரின் அன்பு மாற்றுக் குறைந்து, மந்திரியின் அன்பு, மகாராணியை மயக்கியது!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d012",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "என்ன?",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d013",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அரண்மனை வாழ்வையும், அமைச்சர் பதவியையும், துச்சமாக மதிக்கக்கூடியது அவருடைய அன்பு!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d014",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "ஆ! நினைக்க முடியாத அக்கிரமம்!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d015",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "ஆனாலும் நடந்திருக்கிறது.",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d016",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "அவமானம், பெருத்த அவமானம்!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d017",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "துர்ஜயன்",
    "source_delimiter": ":-",
    "text": "அயல்நாட்டுக்குத் தெரிந்தால் அதைவிட அவமானம்!",
    "page_provenance": [
      {
        "pdf_page": 5,
        "printed_page": 4
      }
    ],
    "source_scene_file": "scene-002.md"
  },
  {
    "id": "maruthanattu-ilavarasi-s002-d018",
    "segment_id": "maruthanattu-ilavarasi-s002",
    "segment_kind": "source-numbered-scene",
    "derivative_ordinal": 2,
    "source_scene_number": 2,
    "source_heading": "காட்சி 2.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "சிங்கத்தின் குகையிலே சதி நடத்திவிட்டனர் சிறு நரிகள்! வாள் முனையிலே விளையாடிவிட்டனர் வைக்கோல் துரும்புகள், கோபதிவர்மன் யார் என்று தெரிந்தும் அவன் அரண்மனையிலே அக்கிரம அநியாயக்காரர்கள், சண்டாளர்கள். துர்ஜயா அந்த துரோகிகளைத் தேடும் வேலை திடமாக நடக்கட்டும். நாடெங்கும் பறை சாட்டுங்கள். அந்த விபசாரியை கண்டதுண்டமாக்கி என் கண் எதிரில் காட்டுங்கள். அந்த ஊதாரிகளின் ரத்தத்தால் குறிஞ்சி நாட்டிற்கு ஏற்பட்ட களங்கத்தைக் கழுவுங்கள். அந்த மாபாதகர்கள் மறைத்து வைத்திருப்பவர்கள் யாராயிருந்தாலும் சரி! மரண தண்டனை! சித்ரவதை! ஊம் நடக்கட்டும்.",
    "page_provenance": [
      {
        "pdf_page": 6,
        "printed_page": 5
      }
    ],
    "source_scene_file": "scene-002.md"
  }
]
