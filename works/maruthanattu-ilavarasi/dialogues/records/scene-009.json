    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "ரௌத்திரன் உம்முடைய மகனா? எவ்வளவு பெரிய அக்கிரமம்!",
    "page_provenance": [
      {
        "pdf_page": 19,
        "printed_page": 18
      }
    ],
