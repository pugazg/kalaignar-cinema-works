    "source_heading": "காட்சி 9.",
    "speaker_label": "கோபதி",
    "source_delimiter": ":-",
    "text": "எத்தனை பயங்கரச் சூழ்ச்சிகள்!",
    "page_provenance": [
      {
        "pdf_page": 19,
