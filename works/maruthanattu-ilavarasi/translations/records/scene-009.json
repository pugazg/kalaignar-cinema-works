            "pdf_page": 19,
            "printed_page": 18
          }
        ]
      },
      "translation": {
        "english_text": "Raudhran is your son? What a monstrous injustice!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s009-u003",
      "kind": "dialogue",
