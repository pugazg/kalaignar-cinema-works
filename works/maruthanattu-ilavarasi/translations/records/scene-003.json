      "translation": {
        "english_text": "Rani! I do not want to redden the waters of the Kaveri. I have no heart to turn the warriors of Marutha country into corpses. For the peace of the country, you must marry Raudhran.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
