        "speaker_label": "மணி",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 7,
            "printed_page": 6
          },
          {
            "pdf_page": 8,
            "printed_page": 7
          }
        ]
      },
      "translation": {
        "english_text": "No, Rani! Do not hammer my unfeeling heart with a sledgehammer. You have turned me, who wriggled like a worm, into a tiger! I will not throw what I guard like my own eye into that bear's mouth! O crowing Kurinji country! No woman for you! War—to curb your swagger!",
        "mode": "prose-faithful",
        "notes": [
          "This is one immutable utterance spanning PDF 7–8; the English keeps it as one unit."
        ]
      }
