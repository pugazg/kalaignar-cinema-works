      },
      "translation": {
        "english_text": "Victory! That is a decision the blood of warriors must determine! Why worry about it now?",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s003-u012",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
