        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 5,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "Yes! That is why he set out to search without our even telling him.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
