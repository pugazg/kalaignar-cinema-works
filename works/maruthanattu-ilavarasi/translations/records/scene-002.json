            "pdf_page": 5,
            "printed_page": 4
          }
        ]
      },
      "translation": {
        "english_text": "Is this something that even needs saying! Maharaja! When it comes to the Maharani, the minister has a special affection!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
