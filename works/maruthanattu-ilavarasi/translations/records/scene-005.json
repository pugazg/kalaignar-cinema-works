        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 9,
            "printed_page": 8
          }
        ]
      },
      "translation": {
        "english_text": "There is no time to hear your lament. Your consent to the marriage—or Maniballavan's death!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s005-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
