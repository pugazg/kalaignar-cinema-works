        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 9,
            "printed_page": 8
          }
        ]
      },
      "translation": {
        "english_text": "I will make you agree! What do you say now!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
