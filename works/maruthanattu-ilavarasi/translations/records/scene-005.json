        "page_provenance": [
          {
            "pdf_page": 9,
            "printed_page": 8
          }
        ]
      },
      "translation": {
        "english_text": "And the honour of Marutha country is flying away with it.",
        "mode": "prose-faithful",
        "notes": [
          "The repeated `பறக்கிறது` image is retained as flag and honour both `flying`."
        ]
      }
    },
