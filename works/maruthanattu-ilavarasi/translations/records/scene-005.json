        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 9,
            "printed_page": 8
          }
        ]
      },
      "translation": {
        "english_text": "That day you roared as though the sea-gate had burst open! Look—here is the handsome man you scorned! He has come to enslave you! As a warrior of warriors! As a lion of victory! (Laughter) As your life-partner!",
        "mode": "prose-faithful",
        "notes": [
          "The source-owned `(சிரிப்பு)` remains inside this immutable dialogue-linked unit."
        ]
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s005-u005",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "segment_id": "maruthanattu-ilavarasi-s005",
      "segment_kind": "source-numbered-scene",
