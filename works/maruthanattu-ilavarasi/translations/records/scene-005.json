          }
        ]
      },
      "translation": {
        "english_text": "O crowing Kurinji country—no woman for you. War! Maniballavar, the flag of Kurinji country is flying over your palace.",
        "mode": "prose-faithful",
        "notes": [
          "The opening deliberately echoes the preceding declaration in scene 3."
        ]
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s005-u002",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "segment_id": "maruthanattu-ilavarasi-s005",
