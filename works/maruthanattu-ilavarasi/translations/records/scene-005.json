        "page_provenance": [
          {
            "pdf_page": 9,
            "printed_page": 8
          }
        ]
      },
      "translation": {
        "english_text": "Do not beat your chests. Cowards who could not stand and face us!",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s005-u004",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "segment_id": "maruthanattu-ilavarasi-s005",
