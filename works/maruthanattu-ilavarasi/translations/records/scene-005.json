        "canonical_scene_path": "works/maruthanattu-ilavarasi/scenes/scene-005.md",
        "source_record_id": "maruthanattu-ilavarasi-s005-d005",
        "source_occurrence_id": null,
        "source_locator": null,
        "speaker_label": "ராணி",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 9,
            "printed_page": 8
          }
        ]
      },
      "translation": {
        "english_text": "Treacherous foxes! Frauds who lock the tiger in a cage and then preach of war!",
        "mode": "prose-faithful",
        "notes": [
          "The colloquial insult `சோதாக்கள்` is rendered as `frauds`; no stronger identity claim is added."
        ]
      }
    },
    {
      "id": "maruthanattu-ilavarasi-en-s005-u006",
      "kind": "dialogue",
      "status": "verified",
