            "pdf_page": 8,
            "printed_page": 7
          }
        ]
      },
      "translation": {
        "english_text": "Gladly! Destroy the border fort of Marutha country. Make the flag of Kurinji country fly over Maniballavan's palace.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
