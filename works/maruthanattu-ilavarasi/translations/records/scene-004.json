        "source_locator": null,
        "speaker_label": "ரௌத்ரன்",
        "speaker_label_origin": "source-explicit",
        "source_delimiter": ":-",
        "page_provenance": [
          {
            "pdf_page": 8,
            "printed_page": 7
          }
        ]
      },
      "translation": {
        "english_text": "I ask it right now: I shall be the commander of this invasion.",
        "mode": "prose-faithful",
        "notes": []
      }
    },
