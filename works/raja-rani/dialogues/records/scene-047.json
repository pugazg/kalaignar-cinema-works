{"work_id":"raja-rani","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","source_scene_number":null,"source_scene_file":"works/raja-rani/scenes/scene-047.md","record_count":10,"records":[{"id":"raja-rani-s047-d001","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ராசா","speaker_delimiter":":","text":"ராணி!...ராணி! ராணி...!","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d002","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ஞான","speaker_delimiter":":","text":"(கதவைத் திறந்து) யாரு?...","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d003","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ராசா","speaker_delimiter":":","text":"ராணி இல்லே?...","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d004","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ஞான","speaker_delimiter":":","text":"ராணி இல்லை, நீங்க யாரு?","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d005","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ராசா","speaker_delimiter":":","text":"நான்தான் ராசா.","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d006","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ஞான","speaker_delimiter":":","text":"ராசாவா? அடப்பாவி. என் குடும்பத்தைக் கெடுத்த துரோகி. என் மகளோட மனதைக் கலைச்சி அவளை பாபாத்மாவாகச் செய்துவிட்டாயே. பாதகா. துரோகி.","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d007","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ராசா","speaker_delimiter":":","text":"பெரியவரே, ஆத்திரப்படாதீங்க—என்னுடைய குற்றம் எதுவுமில்லை.","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d008","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ஞான","speaker_delimiter":":","text":"ஆமாம். குற்றமெல்லாம் என்னுடையதுதான் ஒரு ஏழைக்கு உதவி செய்வதுபோல நடித்து, அப்பாவிப் பெண்ணை ஏமாற்றி, சாஸ்திரோத்தமான சம்பிரதாயத்தையே அழித்துவிட்டாயே, சண்டாளா. கொலைகாரப் பாதகா,","page_provenance":[{"pdf_page":65,"printed_page":64}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d009","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ராசா","speaker_delimiter":":","text":"பெரியவரே! கொஞ்சம் பொறுமையோடு பேசுங்கள். உண்மையைத் தெரிந்துகொள்ளத்தான் நான் இங்கு வந்தேன்!","page_provenance":[{"pdf_page":66,"printed_page":65}],"source_scene_file":"scene-047.md"},{"id":"raja-rani-s047-d010","scene_id":"raja-rani-s047","scene_ordinal":47,"transition_audit_id":"T047","speaker_label":"ஞான","speaker_delimiter":":","text":"உண்மை! என்ன உண்மை? ராணி விதவை! அவள் உனக்கு கிட்டாத பொருள்! இதுதான், நீ தெரிஞ்சுக்க வேண்டிய உண்மை! போய்விடு! என் முன்னால் நிற்காதே! போய்விடு...போ!","page_provenance":[{"pdf_page":66,"printed_page":65}],"source_scene_file":"scene-047.md"}]}
