{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raja-rani-song-inventory-schema",
  "title": "Raja Rani song / singing-performance inventory record",
  "description": "Source-led derivative for the 11 numbered song blocks and source-visible screenplay singing references. The Raja Rani booklet remains canonical; later anthologies and external witnesses may support item identity/authorship but never rewrite source text.",
  "type": "object",
  "required": ["id", "occurrence_kind", "source_text_ta", "pdf_pages", "canonical_source_files", "printed_text_extent", "authorship"],
  "properties": {
    "id": {"type": "string", "pattern": "^raja-rani-song-(?:[0-9]{3}|perf-[0-9]{3})$"},
    "occurrence_kind": {"enum": ["numbered-song-block", "screenplay-singing-reference"]},
    "numbered_song_number": {"type": ["integer", "null"], "minimum": 1, "maximum": 11},
    "source_text_ta": {"type": "string", "minLength": 1},
    "pdf_pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 80}},
    "printed_pages": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "canonical_source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "archival_scene": {"type": ["integer", "null"], "minimum": 1, "maximum": 58},
    "scene_file": {"type": ["string", "null"]},
    "printed_text_extent": {"enum": ["full-bounded-lyric-body", "performance-reference-only"]},
    "full_lyrics_printed": {"type": "boolean"},
    "tamil_derivative_file": {"type": ["string", "null"]},
    "performance_context": {"type": "string"},
    "linked_numbered_song_id": {"type": ["string", "null"], "pattern": "^raja-rani-song-[0-9]{3}$"},
    "linked_song_status": {"enum": ["verified", "review", "not-applicable"]},
    "authorship": {
      "type": "object",
      "required": ["status", "lyricist_ta", "evidence_basis", "evidence_reference", "notes"],
      "properties": {
        "status": {"enum": ["verified", "review", "unresolved"]},
        "lyricist_ta": {"type": ["string", "null"]},
        "evidence_basis": {"enum": ["printed-item-credit", "anthology-attributed", "canonical-context-linked-item", "none"]},
        "evidence_reference": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
