{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source_scene_number":null,"scene_status":"verified","unit_count":8,"units":[{"id":"raja-rani-en-s058-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/scenes/scene-058.md","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-heading","ordinal":1,"description":"Garden."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Garden.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s058-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/dialogues/records/scene-058.json","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":"raja-rani-s058-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Let go of my hand, Raja...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s058-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/dialogues/records/scene-058.json","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":"raja-rani-s058-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"I won't let go, dear! I have placed you as a lamp of light along the streets of my heart. My heart's ears can hear your little blue eyes, famous for their mischief, speaking the language of love. Your ruby lips, showing the colour of the pomegranate, open and show me your heart. In the lightning that appears on your cheeks, red as the evening sky, I can see the tenderness of your heart. Enough of testing me, beautiful one!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s058-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/dialogues/records/scene-058.json","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":"raja-rani-s058-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Oh, go on, Raja...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s058-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/dialogues/records/scene-058.json","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":"raja-rani-s058-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Rani! I'll tell you just one thing. You may hide anything else—but this love can never, ever be hidden. Do you know?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s058-u006","kind":"performance-cue","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/scenes/scene-058.md","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":null,"source_occurrence_id":"raja-rani-song-perf-004","source_locator":{"kind":"song-performance-cue","ordinal":1,"description":"The source states that both of them sing."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"(They both sing.)","mode":"prose-faithful","notes":["The song inventory associates this occurrence with numbered song 11 at review level only. The scene prints no lyrics, so no lyric body is imported and the link is not promoted to verified."]}},{"id":"raja-rani-en-s058-u007","kind":"written-text","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/scenes/scene-058.md","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"closing-benediction","ordinal":1,"description":"Source-visible closing text `நலம் வாழ்க!`."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"May well-being flourish!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s058-u008","kind":"written-text","status":"verified","target_language":"en","scene_id":"raja-rani-s058","archival_scene_ordinal":58,"source":{"source_path":"works/raja-rani/scenes/scene-058.md","canonical_scene_path":"works/raja-rani/scenes/scene-058.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"printer-line","ordinal":2,"description":"Source-visible terminal printer line."},"speaker_label":null,"page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Anbu Press, Madurai:-- 56","mode":"prose-faithful","notes":["The terminal `56` is preserved as printed and is not interpreted as a publication year."]}}]}