{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source_scene_number":null,"scene_status":"verified","unit_count":31,"units":[{"id":"raja-rani-en-s055-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Rani... Rani... Ayya!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Who is it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Where is Rani? I'm Samarasam.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Samarasam? Ayya, have you heard the news?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Disgrace has come upon my family...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Rani is lost to us.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Ayya... what are you saying?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Some fellow called Raja... by joining with him she has brought an enduring shame upon my honourable family. All my dignity has been ground into the dust.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Ayyo—Rani herself is in danger! Look, she has written this letter saying she means to take poison and die.","mode":"prose-faithful","notes":["Faithful translation of the fictional source dialogue; no detail is added."]}},{"id":"raja-rani-en-s055-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Ah! Rani!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u013","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/scenes/scene-055.md","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Calling Rani, he rushes inside."},"speaker_label":null,"page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"[Calling 'Rani,' he rushes inside.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Rani... Rani... where is my Rani?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Sir! Your cries will no longer reach that girl's ears.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Ayyo! If I had known all this would happen, I would have agreed to your marriage, amma.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"What use is saying that now? No use at all. The world has made a habit of destroying people while they are alive, only to wail over them afterward!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/scenes/scene-055.md","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Raja arrives quickly."},"speaker_label":null,"page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"[Raja arrives quickly.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Rani... Rani... Ayya! Where is Rani? Rani... Rani...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Don't panic, Raja. Everything is over. Your love has remained only a dream that could never come true.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Ayya! What are you saying? Sir, where is my Rani?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"Between you and this elder, you've reduced a woman to this state! You swear and vow that love will never part in life or death, and in the end young women are driven to poison. Love has become a game of hide-and-seek for you! Go—go and see your beloved! Go!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/scenes/scene-055.md","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Raja breaks the door and goes inside; Rani is lying on the floor."},"speaker_label":null,"page_provenance":[{"pdf_page":75,"printed_page":74}]},"translation":{"english_text":"[Raja breaks the door and goes inside. Rani is lying on the floor.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/scenes/scene-055.md","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Long unlabelled lament over Rani, contextually spoken in Raja's presence but without a printed speaker label."},"speaker_label":null,"page_provenance":[{"pdf_page":75,"printed_page":74},{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Rani... Rani... You came from somewhere into the garden of my heart—as a skylark singing, a beautiful peacock dancing with joy, a bounding deer, a fondling parrot. You flew and wandered and filled me with delight; at the end, without even calling me, you began your journey. O maiden who speaks ancient Tamil, delicious fruit, lovely moon, beautiful-eyed one who sings love-poetry and dances through all my dreams—what did you think of at the end? Did you think of me? Of this sinner's merciless words? My cuckoo! I raged at you though you were innocent; must you punish me like this? My emerald, was the generosity to forgive this inhuman man never born with you? Ayyo! Rather than see these cruelties, I should have closed my eyes on the theatre stage itself—and you spoiled even that. Sir! Elder! Rani was never truly married. What you conducted in her infancy was not a marriage but a wooden-doll game. Give me permission to cry out, with mouth and heart, that Rani is my wife, my life-companion. As a sign that you agree to remarriage, give me permission to place a garland upon her. Why are you silent, elder? Rani, open your beautiful eyes and look at me once. See me place a garland around your neck and call you my wife; open your nectar-filled lips and call me 'athaan' just once—then die, Rani! Rani!","english_page_segments":[{"pdf_page":75,"printed_page":74,"english_text":"Rani... Rani... You came from somewhere into the garden of my heart—as a skylark singing, a beautiful peacock dancing with joy, a bounding deer, a fondling parrot. You flew and wandered and filled me with delight; at the end, without even calling me, you began your journey."},{"pdf_page":76,"printed_page":75,"english_text":"O maiden who speaks ancient Tamil, delicious fruit, lovely moon, beautiful-eyed one who sings love-poetry and dances through all my dreams—what did you think of at the end? Did you think of me? Of this sinner's merciless words? My cuckoo! I raged at you though you were innocent; must you punish me like this? My emerald, was the generosity to forgive this inhuman man never born with you? Ayyo! Rather than see these cruelties, I should have closed my eyes on the theatre stage itself—and you spoiled even that. Sir! Elder! Rani was never truly married. What you conducted in her infancy was not a marriage but a wooden-doll game. Give me permission to cry out, with mouth and heart, that Rani is my wife, my life-companion. As a sign that you agree to remarriage, give me permission to place a garland upon her. Why are you silent, elder? Rani, open your beautiful eyes and look at me once. See me place a garland around your neck and call you my wife; open your nectar-filled lips and call me 'athaan' just once—then die, Rani! Rani!"}],"mode":"prose-faithful","notes":["The source gives no speaker label to this lament; contextual ownership is not promoted into metadata.","The speech crosses PDF 75→76 and remains one unit."]}},{"id":"raja-rani-en-s055-u025","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/scenes/scene-055.md","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Raja turns around in surprise."},"speaker_label":null,"page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"[Raja turns around in surprise.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம் குரல்","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Devotee, do not fear! Rise! We have granted your wish that Rani may remain alive for a little while and then die afterward...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"What are you saying? I don't understand anything!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":76,"printed_page":75}]},"translation":{"english_text":"Rani, get up.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u029","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/scenes/scene-055.md","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Rani gets up."},"speaker_label":null,"page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"(Rani gets up.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"What—Rani is alive?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s055-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s055","archival_scene_ordinal":55,"source":{"source_path":"works/raja-rani/dialogues/records/scene-055.json","canonical_scene_path":"works/raja-rani/scenes/scene-055.md","source_record_id":"raja-rani-s055-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Yes! Why are you amazed? Rani is alive. Do you know how I saved Rani when she was about to die? She had taken the poison and was about to consume it; fortunately I arrived at that very moment.","mode":"prose-faithful","notes":[]}}]}