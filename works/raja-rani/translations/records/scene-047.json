{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source_scene_number":null,"scene_status":"verified","unit_count":12,"units":[{"id":"raja-rani-en-s047-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/scenes/scene-047.md","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-heading","ordinal":1,"description":"Rani's house."},"speaker_label":null,"page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Rani's house.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/scenes/scene-047.md","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Raja knocks on the door."},"speaker_label":null,"page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"(Raja knocks on the door.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Rani!... Rani! Rani...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"(Opening the door) Who is it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Isn't Rani here?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Rani isn't here. Who are you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"I'm Raja.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Raja? You sinner! Traitor who ruined my family! You disturbed my daughter's mind and made her sinful. Wretch! Traitor!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Sir, don't be angry. I have done nothing wrong.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":65,"printed_page":64}]},"translation":{"english_text":"Yes, every fault is mine! Pretending to help a poor man, you deceived an innocent girl and destroyed sacred custom itself—you outcast, murderous sinner!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Sir! Please speak with a little patience. I came here precisely to learn the truth!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s047-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s047","archival_scene_ordinal":47,"source":{"source_path":"works/raja-rani/dialogues/records/scene-047.json","canonical_scene_path":"works/raja-rani/scenes/scene-047.md","source_record_id":"raja-rani-s047-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Truth? What truth? Rani is a widow! She is beyond your reach! That is the truth you need to know. Go away! Don't stand before me. Go away... go!","mode":"prose-faithful","notes":[]}}]}