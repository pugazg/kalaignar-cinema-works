{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source_scene_number":null,"scene_status":"verified","unit_count":32,"units":[{"id":"raja-rani-en-s052-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-heading","ordinal":1,"description":"Prison."},"speaker_label":null,"page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Prison.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாக்ரடீஸ்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"My dear! Do you see? You used to be angry that I wasted my time in useless philosophical inquiry and troubled myself with argument. Now look—your husband has become a hero praised by the world, a martyr praised by the nation. Xanthippe, you are fortunate: you are the wife of a man who stood against military strength and wealth, bowed to no one, and will close his eyes with pride. Look after the children carefully. If, when they grow, they depart from honesty, try to correct them as I tried to correct you. It is getting late; the guards will be angry. Crito, send them away.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"After she leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"[After she leaves.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Unlabelled address to Crito after Xanthippe leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Crito! You know, don't you? My thirty days in prison end today—and today is the good day appointed by the court for me to drink the poison and die.","mode":"prose-faithful","notes":["The source prints no speaker label here; contextual ownership is not promoted into metadata."]}},{"id":"raja-rani-en-s052-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"கிரீட்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Dear friend! Hero whose mind does not shake even if a mountain does—will I ever again see in the form of a Socrates your radiant eyes, your broad trembling brows, and those passionate lips that pour out philosophy without faltering even before crowds of enemies?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"A guard enters with the poison cup."},"speaker_label":null,"page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"[A guard enters with the poison cup.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாக்","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Don't cry, friend! There—the nectar has arrived! Prison guard, what must I do with it? Tell me the procedure.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"காவ","page_provenance":[{"pdf_page":70,"printed_page":69}]},"translation":{"english_text":"Sir, the whole cup must be drunk. Then you must keep walking about. When your legs grow numb, you may sit; little by little the body will grow cold, and then when you lie down—","mode":"prose-faithful","notes":["This is translation of the source's dramatic dialogue, not procedural advice."]}},{"id":"raja-rani-en-s052-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாக்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"A blissful sleep—a sleep even the maiden of dreams cannot disturb. Prison guard, give it here.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u010","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"He takes the poison cup."},"speaker_label":null,"page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"[He takes the poison cup.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"கிரி","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Friend, you may wait a little before taking it. The prison allows that.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாக்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Crito, yours is a very petty wish. Suppose I delay for two more nazhigai, and before then my heart suddenly fails and I die—how will the Greek court carry out its sentence? Will a new Socrates be born? Crito, this poison is not going to destroy me—only my body.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"கிரி","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Rising lion of Athens, our treasure, elder of Greece—is this poison going to separate us? Ayyo, my heart trembles even to think of it. Friend, tell me something one last time.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாக்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"What new thing can I say? Know thyself. Ask of everything: why, how and for what reason. By asking so, this sculptor of statues became a sculptor of thought. Do not lose your reason and stumble simply believing 'he said it' or 'this man said it.' Whoever says a thing, examine it with your own natural reason. That is what I wish to tell you and this world.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"கிரிட்","page_provenance":[{"pdf_page":71,"printed_page":70}]},"translation":{"english_text":"Socrates, how should your body be laid to rest?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாக்","page_provenance":[{"pdf_page":71,"printed_page":70},{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"If you bury me, bury with me the sacks of worms that wander this country and turn them to earth. If you burn me, burn the records of deceivers with me, make them ash and dissolve them in water. Farewell—the poison calls. I am going to take leave of the people of my country. My dear people of Athens, Socrates is going happily toward death. The Greek court has poured baskets of accusations upon him, filled a cup with poison, and ordered him to drink this pudding that drinks life. In a few moments these lips that shed teachings will touch the rim. Then this body and life called Socrates will sever their connections and place a full stop to life's serial story. Farewell, Greece; farewell, beloved Athens; farewell, beautiful streets where I ran and spoke with passion, roadside shade trees and house-front platforms. Young men with proud stride and proud gaze, good brothers who guard the country, beloved elders, mothers, young lions—Socrates's final salute to you all. If anyone truly believes this old man corrupted Greek youth, let them forgive me. Farewell. O world, do not fail to think. Think about yourself. Think about yourself.","english_page_segments":[{"pdf_page":71,"printed_page":70,"english_text":"If you bury me, bury with me the sacks of worms that wander this country and turn them to earth. If you burn me, burn the records of deceivers with me, make them ash and dissolve them in water. Farewell—the poison calls. I am going to take leave of the people of my country. My dear people of Athens, Socrates is going happily toward death. The Greek court has poured baskets of accusations upon him, filled a cup with poison, and ordered him to drink this pudding that drinks life. In a few moments these lips that shed teachings will touch the rim—"},{"pdf_page":72,"printed_page":71,"english_text":"Then this body and life called Socrates will sever their connections and place a full stop to life's serial story. Farewell, Greece; farewell, beloved Athens; farewell, beautiful streets where I ran and spoke with passion, roadside shade trees and house-front platforms. Young men with proud stride and proud gaze, good brothers who guard the country, beloved elders, mothers, young lions—Socrates's final salute to you all. If anyone truly believes this old man corrupted Greek youth, let them forgive me. Farewell. O world, do not fail to think. Think about yourself. Think about yourself."}],"mode":"prose-faithful","notes":["One source speech crosses PDF 71→72 and remains one unit."]}},{"id":"raja-rani-en-s052-u017","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"As Socrates is about to drink, Samarasam becomes emotionally carried away by the play, rises and runs onto the stage."},"speaker_label":null,"page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"[As Socrates is about to drink, Samarasam becomes emotionally carried away by the play, rises and runs onto the stage.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"No... no! Socrates must not drink it. Socrates is innocent. No, no—Socrates, you must not die. How can a treasury of learning die? Why should Socrates die? What crime did he commit? He told people to think—to ask why and for what reason. If thinking is a crime, then having a brain is a crime! I won't let him die. I will do what this Greek court failed to do. If we lose this great man, will we find such wisdom even after searching a thousand years? Is this the mouth meant to drink that? There is a mouth for it—I will show you. That mouth must drink it. Melitus! Melitus!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":6,"description":"Babu, in the Melitus role, is startled."},"speaker_label":null,"page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"[Babu, in the Melitus role, is startled.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":72,"printed_page":71}]},"translation":{"english_text":"Athaan...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Athaan? Me? I'm not your athaan now. You're Melitus before the judge!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"மக்கள்","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"That's right! That's right!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Exactly! I said drink it—here, drink! Hmm. I am changing Socrates's ending. Why are you staring?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u024","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":7,"description":"Babu hesitates; Geetha's mother runs in from inside."},"speaker_label":null,"page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"(Babu hesitates. Geetha's mother runs in.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாய்","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Ayyo! No, no! It's real poison!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Ah?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாய்","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"If Babu drinks it, he will die!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Real poison? Then don't drink it. If you die after drinking it, I'll become a killer. That won't do. Police—come here!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u029","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":8,"description":"Police arrive."},"speaker_label":null,"page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"(Police arrive.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":2,"description":"Unlabelled line addressing Santham about her brother."},"speaker_label":null,"page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Santham, did you see what your brother has done?","mode":"prose-faithful","notes":["The source supplies no speaker label; contextual ownership is not promoted into metadata."]}},{"id":"raja-rani-en-s052-u031","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/scenes/scene-052.md","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":9,"description":"Babu is arrested."},"speaker_label":null,"page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"(Babu is arrested.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s052-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s052","archival_scene_ordinal":52,"source":{"source_path":"works/raja-rani/dialogues/records/scene-052.json","canonical_scene_path":"works/raja-rani/scenes/scene-052.md","source_record_id":"raja-rani-s052-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"My brother? He's a murderous fellow—put the handcuffs on him!","mode":"prose-faithful","notes":[]}}]}