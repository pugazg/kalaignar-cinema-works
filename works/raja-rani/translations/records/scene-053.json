{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source_scene_number":null,"scene_status":"verified","unit_count":12,"units":[{"id":"raja-rani-en-s053-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/scenes/scene-053.md","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-heading","ordinal":1,"description":"Mental struggle."},"speaker_label":null,"page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"(Mental struggle.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/scenes/scene-053.md","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Rani is with the poison cup."},"speaker_label":null,"page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"(Rani is with the poison cup.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞானக்கண் குரல்","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"If you want this father, give up the desire for marriage in your heart. Live as an unmarried woman.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜாவின் குரல்","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"I don't have a heart that melts for false tears, Babu.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்மா","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Hey, lightning-vine! Are you scattering magic powder—magic powder?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"Rani, if he learns you are a widow, even the man you love will not want you; even he will not want you...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":73,"printed_page":72}]},"translation":{"english_text":"I do not even care that you are a widow. But you hid it from me all these days and deceived me. No one can forgive that—no one can forgive it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"You are a widow.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Widow.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Cunning cheat! Destroyer!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/dialogues/records/scene-053.json","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":"raja-rani-s053-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பல குரல்கள்","page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"Widow! Widow! Widow! Widow!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s053-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s053","archival_scene_ordinal":53,"source":{"source_path":"works/raja-rani/scenes/scene-053.md","canonical_scene_path":"works/raja-rani/scenes/scene-053.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Unlabelled condemning voice-collage after the repeated widow cries."},"speaker_label":null,"page_provenance":[{"pdf_page":74,"printed_page":73}]},"translation":{"english_text":"A veena flung into the dust! Music shattered! A statue broken apart! A crushed flower! A scorched bud! A ruined painting! Widow! Widow!","mode":"prose-faithful","notes":["The source prints no speaker label for this closing voice-collage."]}}]}