{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source_scene_number":null,"scene_status":"verified","unit_count":33,"units":[{"id":"raja-rani-en-s011-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"(To Santhammal) Amma! Ayya's babbling as though he's a little mad. Early in the morning, has he had something... hmm?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Heh heh! Nothing like that, da! What's the matter?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"No; he told me to collect the arrears. I brought 300 rupees to give him, and he calls it flowers, calls it buds, says to string it into a garland and put it on the picture!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Oh-ho! There's something going on; how much money is there?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Three hundred!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Bring it here!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/scenes/scene-011.md","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-location","ordinal":1,"description":"Source bracket marks the downstairs continuation."},"speaker_label":null,"page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"(Downstairs.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Athaan! If you won't give me 200 rupees, won't I at least get two cubits of rope?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Hmm. The rope you're twisting—not just two cubits, you'll get twenty!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Athaan. You won't give it...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"What will you do?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"I'll wrap the cloth around my neck and pull it like this, you know?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Good! Pull, pull. It's good for the nerves!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Athaan!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"I'll pull it, athaan.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Pull, pull!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Athaan, athaan...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"(Coming there) Thambi... thambi! Put on this garland! (She strings the money like a garland and puts it on him.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Hey, the money... what? What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"This is a new kind of flower garland!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"A flower garland?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Ah, ah! Athaan, this is the garland I've been waiting for all this time, you know?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Thambi! There are 200 flowers in it. Put that garland around the theatre man's neck!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Hey, come here! Give me that, give it here! You don't know the value of money and you're tying it into a garland! Go.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"I'm coming, athaan! Is this a sevanti flower? Is this a bud? I'm coming, athaan, I'm coming!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"What is it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Go... that...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Why are you getting angry like this? He asked for 200 rupees. You sent him off calling them flowers and buds!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Ayyo! Santhamma, don't get angry! Santhamma, we shouldn't get angry like this! I only thought he'd go and spend it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"So what if he spends it! Who else but us will give him?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"I tell you not to get angry and you won't listen; look, we should always be happy; no anger! Come on, smile a little!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s011-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s011","archival_scene_ordinal":11,"source":{"source_path":"works/raja-rani/dialogues/records/scene-011.json","canonical_scene_path":"works/raja-rani/scenes/scene-011.md","source_record_id":"raja-rani-s011-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"I can't smile!","mode":"prose-faithful","notes":[]}}]}