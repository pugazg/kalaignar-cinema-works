{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source_scene_number":null,"scene_status":"verified","unit_count":27,"units":[{"id":"raja-rani-en-s057-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Now do you understand the secret of how Rani came back to life?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Somehow my Rani survived.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Appa...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Rani...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Appa! Forgive all the wrongs I have done. (She falls at his feet.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Get up, amma. At this helpless age I feared you might leave me to suffer alone somewhere.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Now everything has ended well at last.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"I was also the reason trouble arose in your family. Please forgive me too.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Let us forget; let us forgive!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Rani, there is still one more pair of feet you have to fall at. This amma is very angry with you. Look—first fall at her feet!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்மா","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Live like a queen, amma! When two lovers are united in thought and support one another, that is joy...","mode":"prose-faithful","notes":["The source gives only this Kural-like fragment; no missing text is supplied."]}},{"id":"raja-rani-en-s057-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Hee... hee... you said it? I was going to say it. All right—the Kural belongs to everyone. Leave it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/scenes/scene-057.md","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Unlabelled speech printed with a hearing-noise parenthetical."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"(Hearing a noise) Who is it... what is it?","mode":"prose-faithful","notes":["No speaker label is printed; contextual ownership is not inferred."]}},{"id":"raja-rani-en-s057-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/scenes/scene-057.md","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Current, Sankaran and Kannamma enter."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"(Current, Sankaran and Kannamma enter.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Ahahaha—quarrel! A big quarrel... a big quarrel!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/scenes/scene-057.md","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":2,"description":"Malformed/unlabelled source line beginning `சம...` before Current explains the quarrel."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Sa... hey, hey—what is it, what quarrel?","mode":"prose-faithful","notes":["The source does not print a normal speaker-label delimiter here, so no speaker is assigned."]}},{"id":"raja-rani-en-s057-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"They've fallen in love. The quarrel is over who should put the garland on first!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"They've fallen in love, haven't they? Then don't leave a 'gap'! If you make it 'late' in this matter, afterward it may go as far as poison. Put the garland on first.","mode":"prose-faithful","notes":["The source-visible English-derived `கேப்` and `லேட்` are retained as code-switching."]}},{"id":"raja-rani-en-s057-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/scenes/scene-057.md","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Current stretches out his neck."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"(Current stretches out his neck.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சங்","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Me, sir...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Girl, come here! Is it this fellow?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/scenes/scene-057.md","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"She nods yes."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"(She nods yes.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/scenes/scene-057.md","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":3,"description":"Unlabelled instruction immediately after the nod."},"speaker_label":null,"page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Hey! Give it here. Look at the fellow... put it on!","mode":"prose-faithful","notes":["The source prints no speaker label here."]}},{"id":"raja-rani-en-s057-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":78,"printed_page":77}]},"translation":{"english_text":"Then all right, all right. Everything has ended well.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Yes, it has ended well.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Then would all of you move aside a little?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s057-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s057","archival_scene_ordinal":57,"source":{"source_path":"works/raja-rani/dialogues/records/scene-057.json","canonical_scene_path":"works/raja-rani/scenes/scene-057.md","source_record_id":"raja-rani-s057-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":79,"printed_page":78}]},"translation":{"english_text":"Hmm... understood. We'll go.","mode":"prose-faithful","notes":[]}}]}