_page":29}]},"translation":{"english_text":"Appa!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"What is it, amma? You seem to be in full celebration?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"The hardship of unemployment is over, Appa!","mode":"prose-faithful","notes":["The line answers the immediately preceding singing cue with the source's unemployment wordplay."]}},{"id":"raja-rani-en-s016-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Is that so? You've got a job? What present am I going to give you for this happy news!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u007","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/scenes/scene-016.md","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Rani gives Gnanakkan the flower she was holding."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"(Rani gives him the flower she was holding.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Here, Appa. This rose—will you yourself put it in my hair...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"What?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Ha, no, Appa! No! Why do I need an adornment that you cannot look at and enjoy, Appa?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/scenes/scene-016.md","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"The source bracket says she throws the flower down before the following unlabelled speech."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"(She throws the flower down.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s016-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/scenes/scene-016.md","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Unlabelled speech immediately after `[பூவை கீழே எறிந்து]`."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Hmm, are you eating, Appa?","mode":"prose-faithful","notes":["The dramatic context is not promoted into speaker metadata."]}},{"id":"raja-rani-en-s016-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s016","archival_scene_ordinal":16,"source":{"source_path":"works/raja-rani/dialogues/records/scene-016.json","canonical_scene_path":"works/raja-rani/scenes/scene-016.md","source_record_id":"raja-rani-s016-d009","source_occurren