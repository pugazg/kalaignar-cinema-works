{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source_scene_number":null,"scene_status":"verified","unit_count":34,"units":[{"id":"raja-rani-en-s024-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/scenes/scene-024.md","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"embedded-drama-heading","ordinal":1,"description":"The source marks this passage as an Ahalya play rehearsal."},"speaker_label":null,"page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"(Ahalya play rehearsal.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"இந்திரன்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Don't worry, Ahalya. Don't you know me? I am the king of the gods who came running in search of this beautiful rose that lay unworn! My name is Indra.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்யா","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Ah. Indra.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"இந்தி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Yes—the lord of the immortals—the one who possesses Airavata.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Wicked man! You sinner—you have destroyed my imperishable chastity. Is plundering helpless women's chastity becoming of the king of the immortals? Are you the god of gods? The hero beyond heroes? Ayyyo, I was deceived. This villain disguised himself as my husband and deceived me. O God! Could even your eyes not see through the disguise of this false actor who came to deceive a queen of chastity?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"இந்தி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"When even your own chaste eyes could not see it, whose eyes could? Let what is past be past, flower-vine. Come this way.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Again? You great sinner—can this outrage be allowed?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனிவர்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"It cannot... it cannot! O lightning-vine who speaks so boldly. Woman of the ashram. You who lay with Indra of the celestial world. Was this sacred ashram the only place you could find for your hunt of love and your wicked sport?... You wretches! Little insects! Lowly creatures!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"இந்தி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Great sage!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Ah...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"இந்தி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Forgive me. Should one who is the very form of love become angry?... You are a gentle sage...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"What you did was deceit. From now on my ears will hear nothing. Lord of the immortals, this will not do. This sin will not leave you for fourteen births. Sinners! Spirits of transgressors!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"Swami...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"What...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"I did not know that Indra was such a great deceiver...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Why didn't you know? Didn't you know that Tilottama, Menaka, Urvashi and Rambha are the courtesans of this god of gods? Didn't you understand even the Tirukkural saying, ‘The base are like the gods’? You erred though you knew. You understood and still erred.","mode":"prose-faithful","notes":["The source quotes only the fragment `தேவரனையர் கயவர்`; the English preserves it as a fragment rather than supplying the rest of the Kural."]}},{"id":"raja-rani-en-s024-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"No, Swami, no. He transformed himself to look just like you and praised me with words like ‘my dear, my gold, my undying love’...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"When have I ever called you that? At least then shouldn't you have understood that it was someone else?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"அகல்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"I thought it was you—and fell into the fire. Ah... I made a mistake.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"முனி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Ah. You made a mistake, wife of a great ascetic. Clever woman who cannot tell another man from the man of your own house. I cannot believe that ‘property’ reason of yours... nor can I believe this schemer. Hey, Indra! For destroying another man's wife's chastity, let your whole body become... this... this... Ahalya, here—you take a curse too...","mode":"prose-faithful","notes":["The source phrase `உன் சொத்தைக் காரணத்தை` is unusual; the English stays conservative rather than silently repairing it.","The curse wording after `உன் உடம்பெல்லாம்` is visibly incomplete/elliptical in the source; no missing transformation is supplied."]}},{"id":"raja-rani-en-s024-u021","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/scenes/scene-024.md","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"At those words Rani lifts the end of her sari."},"speaker_label":null,"page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"(At those words Rani lifts the end of her sari.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Come on, Rani—you can't act like this, yes...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Shall I tell you the truth? Somehow I don't like this play at all. I can't play the role of Ahalya...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Then do one thing—you play the sage. I'll play Ahalya...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"You know what the people in the theatre will throw, don't you!","mode":"prose-faithful","notes":["The source does not name the object people would throw; the English does not supply one."]}},{"id":"raja-rani-en-s024-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Do I need you to tell me that! All right, Leela. Let's stop the Ahalya play here and put on a different new play.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"What play?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"We'll stage a comedy—‘Padukkaip Puratchi’...","mode":"prose-faithful","notes":["The play title is retained in transliteration rather than normalized into a different source title."]}},{"id":"raja-rani-en-s024-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"A play—we'll stage it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"Then what about Ahalya?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":41,"printed_page":40}]},"translation":{"english_text":"She's already turned to stone!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s024-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராமர் வேஷ ராமன்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"She's turned to stone? Then my stepping on her is still pending!...","mode":"prose-faithful","notes":["The line refers to the Ahalya/Rama stage action without adding absent explanatory narration."]}},{"id":"raja-rani-en-s024-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s024","archival_scene_ordinal":24,"source":{"source_path":"works/raja-rani/dialogues/records/scene-024.json","canonical_scene_path":"works/raja-rani/scenes/scene-024.md","source_record_id":"raja-rani-s024-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Hey, who is this fellow? The play has stopped here, and Rama has arrived to grant release from the curse! Get lost. Come, Leela, I'll take you home and come back... Hey, put everything away, da.","mode":"prose-faithful","notes":[]}}]}