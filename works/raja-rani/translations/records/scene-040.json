{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source_scene_number":null,"scene_status":"verified","unit_count":18,"units":[{"id":"raja-rani-en-s040-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"(To herself) They say there is no harm in lying so long as it causes no harm to others!—Ayyo! Because of my lies, confusion in Samarasam's house—Raja suspicious—me in trouble—if Appa learns all this, he'll ask, ‘Is it because I'm blind, amma, that you've deceived me like this?’ and split my heart with an axe! Rani... you've got yourself properly trapped!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u002","kind":"performance-cue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/scenes/scene-040.md","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":null,"source_occurrence_id":"raja-rani-song-perf-003","source_locator":{"kind":"song-performance-cue","ordinal":1,"description":"Source stage direction states that Raja enters singing."},"speaker_label":null,"page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"[Raja comes in singing.]","mode":"prose-faithful","notes":["The verified song inventory links this cue to numbered song 8 (`raja-rani-song-008`); no front-matter lyric is imported into this scene."]}},{"id":"raja-rani-en-s040-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"The world hasn't gone dark for me—your mind went dark the moment you first saw a new girl!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"That's true—you are a rich man's daughter, aren't you? You'll say this—and more...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Who told you that? You read the newspaper and said it yourself... when did you ever let me tell the truth! Fine—I agreed to let it be that way too! If I'd said I was a poor family's girl, would I have got this typist job? You tell me...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"That's all right... Rani...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Even so, you shouldn't have lied to me!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":58,"printed_page":57},{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"What do you care? My condition—my hardship—the tears I've shed—what do you know about any of it? In a world full of theft and deceit—do you know how many sorrows a helpless woman living with a blind father endures? Appappa! That Samarasam house... there... one sinner... Babu! Another Kali—Santham!","english_page_segments":[{"pdf_page":58,"printed_page":57,"english_text":"What do you care? My condition—my hardship—the tears I've shed—what do you..."},{"pdf_page":59,"printed_page":58,"english_text":"know about any of it? In a world full of theft and deceit—do you know how many sorrows a helpless woman living with a blind father endures? Appappa! That Samarasam house... there... one sinner... Babu! Another Kali—Santham!"}],"mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Aha! Enough... enough! Don't go on cursing everyone and end up starting on me too! I know you well—you don't have to say anything—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Do you know how many dangers an honest woman faces in this wicked world? If lies are a weapon against troubles that march in wave after wave, is it a crime to use them?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"I didn't say it was a crime—there's nothing wrong with lying for a good purpose... but you shouldn't have lied to me! That's the 'point'!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Yes... yes... you're the boss, aren't you!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Ayyo! Why are you making this dangerous, amma? There's no boss-shoss about it; just Raja...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"So what if I told you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"If you ask like that, what can I say? I meant, can you lie to your lover—what else? Leave that, Rani. The elders themselves say you can tell a thousand lies to bring about one marriage... I think by now you've already told more than about a thousand lies. So...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"So...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s040-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s040","archival_scene_ordinal":40,"source":{"source_path":"works/raja-rani/dialogues/records/scene-040.json","canonical_scene_path":"works/raja-rani/scenes/scene-040.md","source_record_id":"raja-rani-s040-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"So what now... nothing! What am I supposed to say! Until now you've been Leela Rani—Leela Rani! From now on I'm thinking we can become Raja-Rani! Ah...","mode":"prose-faithful","notes":[]}}]}