{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source_scene_number":null,"scene_status":"verified","unit_count":70,"units":[{"id":"raja-rani-en-s009-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Rani, drugged by the tea, lies down in Raja's car and is discovered when he reaches home."},"speaker_label":null,"page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"(Rani comes out. Because she has drunk tea mixed with a sedative, she lies down in Raja's car parked on the street. When Raja reaches his house, he sees her.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Aha! A woman! How did she get into our car? What is this—this has become dangerous! Ayyayyo, hey madam, who is that? Hey, I'm talking to you! This, this—hey girl, get up, come down—come. Get down, get down. Hey, hey! Here. Here, get up! Hey, get up, amma, get up—who are you? Who are you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Sleep... mm-mm.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Who? What—sleep? I'm asking who you are. She says sleep, sleep. Hey, is this the place to sleep? Hey madam, I'm talking to you—what a predicament this is! Is this really sleep? Or something else? Looking at the girl, it doesn't seem like that; she looks like a good girl. What a fix this is. How can I leave this girl alone in the middle of the night? Someone might take what's on her hands and neck. Hey madam, come and sleep over there. Come, come, here, here. Step, step—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"[Dazed] What am I supposed to read?","mode":"prose-faithful","notes":["The source plays on `படி` as step/read; the next line preserves Raja's clarification."]}},{"id":"raja-rani-en-s009-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Ah! The staircase! Steps! Step—the step you climb up on.","mode":"prose-faithful","notes":["The source explicitly code-switches to `ஸ்டெப்ஸ்` while explaining the `படி` wordplay."]}},{"id":"raja-rani-en-s009-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"How?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Ah! Like this; come! Is this sleep? Hmm.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Hmm, hmm. (She mutters.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Oh dear! Hey madam, hey! You—I'm talking to you! Hey! Girl, get up. Hey. What is this? Here, get up, get up, get up—slowly, slowly, slowly. Come here, don't push—tch! Nuisance.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"[Thinking] Tch, what madness is this! Not a goddess—right, right—then who could she be? The way she sleeps, she looks like Kumbhakarna's big sister. If all women slept like this, the town would really prosper. (He picks up a daily newspaper and reads.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u012","kind":"written-text","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"newspaper-headlines","ordinal":1,"description":"Three newspaper headline fragments after Raja picks up the daily paper."},"speaker_label":null,"page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"The man who called her Moodevi had his nose cut off—The misery of unemployment has ended for one and a quarter million people—Baghdad thieves who fooled even the policemen—","mode":"prose-faithful","notes":["The source-visible newspaper fragments remain written text rather than receiving an invented dialogue record."]}},{"id":"raja-rani-en-s009-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Unlabelled reaction immediately after the newspaper headline fragments."},"speaker_label":null,"page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"english_text":"Hmm, ayyayyo! Hmm, nothing is going to happen for us.","mode":"prose-faithful","notes":["The source prints no speaker label; context is not promoted into speaker metadata."]}},{"id":"raja-rani-en-s009-u014","kind":"written-text","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"newspaper-letter","ordinal":2,"description":"Printed letter to Leela in the newspaper, crossing PDF 22→23."},"speaker_label":null,"page_provenance":[{"pdf_page":22,"printed_page":21},{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"To my dear daughter Leela, from your father.\n\nHow could you leave like this, abandoning me, your dear mother, and all this property? As you asked, we have dropped the arrangements to get you married. When you yourself feel willing, you may decide about marriage. Give up your anger and please return home. We certainly will not insist on marriage. We are deeply distressed at not seeing you. Come at once.\n\nYours lovingly,\nFather.","english_page_segments":[{"pdf_page":22,"printed_page":21,"english_text":"To my dear daughter Leela, from your father.\n\nHow could you leave like this, abandoning me, your dear mother, and all this property? As you asked, we have dropped the arrangements to get you married. When you yourself feel willing, you may decide about marriage. Give up your anger and please"},{"pdf_page":23,"printed_page":22,"english_text":"return home. We certainly will not insist on marriage. We are deeply distressed at not seeing you. Come at once.\n\nYours lovingly,\nFather."}],"mode":"prose-faithful","notes":["The letter remains written text and preserves the physical PDF 22→23 boundary."]}},{"id":"raja-rani-en-s009-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":2,"description":"Unlabelled utterance following the printed letter."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Hmm, Leela...","mode":"prose-faithful","notes":["The source supplies no speaker label."]}},{"id":"raja-rani-en-s009-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":3,"description":"Unlabelled quotation/repetition from the letter immediately before Raja's next labelled line."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"“When you yourself feel willing, you may decide about marriage. Leaving me, your dear mother, and all that property...”","mode":"prose-faithful","notes":["The source supplies no speaker label; the quoted written material is not converted into an immutable dialogue link."]}},{"id":"raja-rani-en-s009-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Oh! Looks like she's a girl from a very rich family. Tch, tch! Not the kind of bad girl we thought she was, hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Raja immediately runs inside and gives Rani a pillow."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"(He immediately runs inside and gives Rani a pillow.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":4,"description":"Unlabelled speech while Raja gives Rani a pillow."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Oh dear, amma. Look here, please get up a little—here. Amma. Ha... slowly, slowly, ayyayyo, it's all right.","mode":"prose-faithful","notes":["The source prints no speaker label; no immutable dialogue ID is manufactured."]}},{"id":"raja-rani-en-s009-u020","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Raja sleeps outside the room; at daybreak the servant brings coffee."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"(Then he goes outside the room and sleeps. At daybreak the servant brings coffee.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Sir! Sir! It's nine-thirty, sir, wake up, sir, si—! (He pulls away the blanket, sees Rani)... who?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"The servant runs outside and falls onto Raja."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"(He runs outside and falls onto Raja.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Hey, hey! Who's that?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Sir, sir. It's me, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"You? Why did you come and fall on top of me like that?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Sir! Who is that, sir? Someone who 'acted' in last night's 'drama'?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u027","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Rani wakes and listens to them talking."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"(Rani wakes and listens to their conversation.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Donkey! You came running like this just for that? She's a girl from a big family! Her name is Leela! She quarrelled with her mother and father and left home!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"What was she angry about, sir?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"How would I know? I read it in the newspaper.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"She's a very beautiful girl, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"english_text":"Ah...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Sir, this girl...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"What? What about that girl?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"I have a great wish, sir...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"What did you say?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"I want to see you marry her with my own eyes, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Get lost! She's a girl from a big family! Would she marry people like us? Hey, why did you go there? Get over to that side—'monkey brand!'","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u039","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/scenes/scene-009.md","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":6,"description":"Rani runs away and lies down again."},"speaker_label":null,"page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"(Rani runs away and lies down again.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Hmm! It's all right, it's all right! There's nothing to be afraid of. No one's here; last night, in your sleepy daze, somehow...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Oh! I am sorry! I caused you a lot of trouble!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"It's all right. What of it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Hmm... last night...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"You were lying right here—right in this place!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"How did I get here?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Our car...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Oh, car. Right; right!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Yes, the car...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"You?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"I am Raja!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Raja of which place?","mode":"prose-faithful","notes":["The source makes a name/title joke around `ராஜா`; the English keeps the ambiguity explicitly."]}},{"id":"raja-rani-en-s009-u052","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Ayyayyo! What is this, amma, you're making it dangerous? That's it—looks like sister still hasn't fully woken up! Amma, I'm not a raja of any place; my name... my name is Raja!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u053","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Oh, excuse me!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u054","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"It's all right, it's all right!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u055","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Hmm, this...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u056","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"It's our house; our house! Yesterday I 'acted' in the play, remember. Cheran Senguttuvan... you didn't come and see the play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u057","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"No, at the play, tickets...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u058","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":24,"printed_page":23}]},"translation":{"english_text":"Yes, yes. You must not have got one... you must not have got a ticket! Huge crowd—house-full!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u059","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Yes; yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u060","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d048","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Yes, yes! Ah, amma, even though you're a girl from such a big family, should you behave in a way that hurts your father and mother's hearts?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u061","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d049","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Do you know who I am?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u062","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d050","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Oh! It's all printed right here in this newspaper. Yes, Leela! If your father's name and address were printed in the paper, everyone would know who you are; so, to keep a bad name from coming to the family, he's given the 'news' very cleverly! Your father is a very smart man!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u063","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d051","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"(Covering) Yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u064","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d052","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Yes! Ah, haven't you had coffee!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u065","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d053","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"(After drinking coffee) Then... I'll be going!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u066","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d054","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Mm-mm... wait, amma! Stop... hey, stop! Hmm; I won't send you alone. I'll come all the way to your house and leave you there!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u067","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d055","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"No, no! At home they may unnecessarily think something wrong!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u068","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d056","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Leela! You're trying to fool me! I'll come with you and leave you at the gate of your bungalow before I return; no one will think wrongly.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u069","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d057","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Hmm. Why should you take needless trouble! My anger has cleared now! I'll go by myself!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s009-u070","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s009","archival_scene_ordinal":9,"source":{"source_path":"works/raja-rani/dialogues/records/scene-009.json","canonical_scene_path":"works/raja-rani/scenes/scene-009.md","source_record_id":"raja-rani-s009-d058","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":25,"printed_page":24}]},"translation":{"english_text":"Even so, a girl from a very rich house... walking when we have a car! Wait a little. I'll be right back!","mode":"prose-faithful","notes":[]}}]}
