        "page_provenance": [
          {"pdf_page": 10, "printed_page": 9}
        ]
      },
      "translation": {
        "english_text": "Amma! The doctor is calling you...",
        "mode": "prose-faithful",
        "notes": [
          "`Amma` is retained as the boy's respectful form of address; it is not interpreted as a literal mother-child relationship."
        ]
      }
    },
