        "speaker_label": "ராணி",
        "page_provenance": [
          {"pdf_page": 10, "printed_page": 9}
        ]
      },
      "translation": {
        "english_text": "Appa!...",
        "mode": "prose-faithful",
        "notes": [
          "The kinship vocative is retained as `Appa` to preserve the emotional force of the one-word cry."
        ]
      }
    }
