        "source_locator": null,
        "speaker_label": "டாக்டர்",
        "page_provenance": [
          {"pdf_page": 10, "printed_page": 9}
        ]
      },
      "translation": {
        "english_text": "He'll recover soon; don't worry... come this way, dear.",
        "mode": "prose-faithful",
        "notes": [
          "The soft address in `வாம்மா` is carried as `dear` without changing the doctor's informal reassuring register."
        ]
      }
    },
    {
      "id": "raja-rani-en-s001-u005",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
