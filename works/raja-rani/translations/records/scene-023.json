{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source_scene_number":null,"scene_status":"verified","unit_count":37,"units":[{"id":"raja-rani-en-s023-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Who's that—Leela? What, Leela, why are you so late today?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Nothing. Today's \"date\" is the first, isn't it—that's why I'm a little late!","mode":"prose-faithful","notes":["The source code-switches to `டேட்` while referring to the first of the month; English retains the visible 'date' wording."]}},{"id":"raja-rani-en-s023-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Yes, yes. The milkman, the curd man... that... servant... you have to pay all of them their wages, don't you? That's why you must have come late.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Yes... yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/scenes/scene-023.md","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Current puts the valve down carelessly."},"speaker_label":null,"page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"(Current sets the valve down carelessly.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Here, Current! Don't leave the 'valve' carelessly like that! Look, I carelessly lost two hundred rupees somewhere, and now I'm at a loss, not knowing what to tell them at home. Don't you also drop this, break it, and then stand there not knowing what to tell the boss!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Yes, da, the valve is very 'costly'... don't keep dropping it down! Otherwise, just as we're wandering around unable to find a heroine for our play, we'll have to wander around looking for a valve!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"You still haven't found a heroine for your play?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"No!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Sir! Don't get angry if I say something!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Why are you getting angry, da? What is it—say it...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"What if our Leela amma herself acts as the heroine?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Tch, tch. That wouldn't be good!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Why, sir—do you think she doesn't know how to act?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Hey, I didn't say that! Leela doesn't even need to act; if she simply comes and stands on the 'stage', it'll look as though she's acting!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Then what is it, sir...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"She's a girl from a big family. If we casually ask her to act in some drama-shrama like this, her family might...","mode":"prose-faithful","notes":["The source's playful `ட்ராமா, கீமா` echo is represented as 'drama-shrama' rather than flattened into plain 'drama'."]}},{"id":"raja-rani-en-s023-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"No! I used to act well even at our school!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"At school anyone can act. That's no great thing. But you have to act in a real drama; only then will you know how hard it is. But Current, if Leela says she'll act in our play, I don't think they'll say anything against her wish. What do you say, Leela...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Then we've found the heroine we searched and searched for, for our play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Found her... found her! What, Leela, you agree, don't you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Mm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Those who strive will not be put to shame!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Yes—those who strive... that's all just talk! I've been searching and wandering since seven in the morning; I still haven't found the money I lost!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"The money got lost... how much?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Just 200 rupees!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Only 200! Don't worry... I'll give it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"I'll give it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"No, no. It's not one or two—it's 200 rupees!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"It's all right, keep it! Here, Leela, keep it! No need for the people at home even to know the money was lost!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"Here you are...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"What is this?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":39,"printed_page":38}]},"translation":{"english_text":"The heroine's lesson—that's the lesson! This is money! Keep that... read this!...","mode":"prose-faithful","notes":["The source plays with `பாடம்` (lesson/part) and `பணம்` (money) while using demonstratives; the English keeps the contrast without inventing which physical item each gesture points to."]}},{"id":"raja-rani-en-s023-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"All right. I'll learn the part and have it ready!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s023-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s023","archival_scene_ordinal":23,"source":{"source_path":"works/raja-rani/dialogues/records/scene-023.json","canonical_scene_path":"works/raja-rani/scenes/scene-023.md","source_record_id":"raja-rani-s023-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":40,"printed_page":39}]},"translation":{"english_text":"The rehearsal is tomorrow!","mode":"prose-faithful","notes":[]}}]}
