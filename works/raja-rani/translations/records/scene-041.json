{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source_scene_number":null,"scene_status":"verified","unit_count":43,"units":[{"id":"raja-rani-en-s041-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமையல்காரன்","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Amma, why are you sitting here so worried? At least have some coffee.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Oh, go on, Muruga—come here, sit down here! You told me about that girl...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":59,"printed_page":58}]},"translation":{"english_text":"Oh! It's gone very far now... they're even making arrangements for the wedding...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"What! A wedding? A second marriage?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Yes... no, amma! He hasn't even been married once yet...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Who, da?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Our Sankaram fellow!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Sankaram? You're a fine one! All this time, were you talking only about him?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Yes, amma... who else would I be talking about?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"And that girl you mentioned—who is she?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Our servant girl, amma! The maid who works here...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Tch! You said 'Ayya' was going around with a girl, da...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"I meant him, amma—the mistake that fellow was making. Thinking of him, I called him 'Ayya'... and Ayya is coming too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/scenes/scene-041.md","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Samarasam enters."},"speaker_label":null,"page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"(Samarasam enters.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"What's this—an inquiry going on here?... Hmm?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Hmm... there's only visaaram—worry—here; no 'nai' to make visaaranai, an inquiry!","mode":"prose-faithful","notes":["The English keeps the source's wordplay on `விசாரம்` / `விசாரணை` visible through transliteration."]}},{"id":"raja-rani-en-s041-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"All right, all right... You go and look after the cooking.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"The cooking's done, ayya.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Done? It's done, is it? Then go put some on a plate and eat, you dog... (to Santham) Listen, I've withdrawn the suspicion I had about you. Shouldn't you do the same?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Look, Raja is a good man; you're a good woman! In the same way, think of me as a good man too...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Hmm! Raja isn't a good man, and I'm not a good woman either. Think the way you did before—that's all!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Oh, oh! Listen! You think I'm doing something wrong, and now you're acting as if you're doing something wrong too... Ah! That girl, you know...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"A beautiful girl! Attractive! A young woman in her prime!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"That's not what I meant! She's very poor, but she's intelligent...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Ah! If she weren't intelligent, could she 'cover' an old man?","mode":"prose-faithful","notes":["Source-visible English-derived `கவர்` is retained as the comic code-switch `cover`."]}},{"id":"raja-rani-en-s041-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Tch, tch! This won't work... Hmm... I'll have to look for some river or pond somewhere!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"Why—to have a swimming game with her? A water frolic?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u029","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/scenes/scene-041.md","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Babu enters."},"speaker_label":null,"page_provenance":[{"pdf_page":60,"printed_page":59}]},"translation":{"english_text":"(Babu enters.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Akkaaa...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"What is it, thambi?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Akka! Because Raja and I had that unnecessary quarrel, the whole town has a bad opinion of me now, akka...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"So what now?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Somehow I have to join Raja again, act in the play, and wipe out the bad name I've got, akka!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"But Raja has to agree to that!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Who would agree? Look at all the wrongs he's done that hurt Raja! They won't take him back because of that.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Why wouldn't they? Raja listens to whatever I say! Thambi, come with me—I'll get you admitted.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Listen, listen—don't boast and go there only to be humiliated. That's all I'm saying!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Ah! If I don't get you into that company and get that girl thrown out of it, my name isn't Santhamma!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Ayyo, ayyo! That poor girl, poor thing!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Ayyo, ayyo—look at him suffering! Oh, go away! Come, thambi...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Athaan! I'm coming...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s041-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s041","archival_scene_ordinal":41,"source":{"source_path":"works/raja-rani/dialogues/records/scene-041.json","canonical_scene_path":"works/raja-rani/scenes/scene-041.md","source_record_id":"raja-rani-s041-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":61,"printed_page":60}]},"translation":{"english_text":"Hmm. 'I'm coming, athaan, I'm coming.' Hmm... Ayyo! This Raja and Rani came and scattered this family like a house of cards!","mode":"prose-faithful","notes":[]}}]}