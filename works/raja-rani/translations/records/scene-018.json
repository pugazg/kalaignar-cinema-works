{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source_scene_number":null,"scene_status":"verified","unit_count":43,"units":[{"id":"raja-rani-en-s018-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"It's not anger, sir—heartburn... jealousy. Look, people in town say that without you that drama company is nothing. Babu owns the company!... but the name goes to you! Wouldn't he get angry?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Why should he, unnecessarily?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"How can you say that... Look here... you own this electric company... s