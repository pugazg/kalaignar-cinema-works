, whatever happens, we absolutely have to stage a play...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"We'll do it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"But who will act as the heroine?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"I'll take the part, sir.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/s