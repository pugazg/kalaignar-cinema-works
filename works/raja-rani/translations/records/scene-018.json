ourse...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"But there'll be plenty of income!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"There'll be plenty coming in from the plays and from the company! How are you going to show all that in the 'income tax' accounts?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"How am I going to show it? The same way I've shown it till now; we don't have any 'duplicate' accounts!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Not that! If you put down some salary for me too, the income tax will come down a little, see... that's why I said it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Oh! You're going that way? I've never used that route till now! I understand only now—fine, put it down!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"How much?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Hmm... three hundred!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Three hundred?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Why, is it too little? Put down 500... put down 500!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"What, what? Sir, sir... what is this, sir? I've been working in this company since the day current was discovered. My salary never rose above fifty. And this madam who came yesterday gets five hundred rupees?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Hey, what kind of fellow is he—pure current! Are we actually going to pay the salary we put down for Leela? It's only for income tax! Just for 'adjustment', man! Who is this fellow... she's a girl from a big rich family; ours is a small company! Is she going to stretch out her hand for this beggar's sum of 500 rupees? She's only working to pass the time. If we write 'salary and all that', it'll lower her dignity, man! Isn't that right, Leela?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Ah, is that so? All right, sir... whatever it is, I don't like writing this false account, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Yes; I don't like it either!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s018-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s018","archival_scene_ordinal":18,"source":{"source_path":"works/raja-rani/dialogues/records/scene-018.json","canonical_scene_path":"works/raja-rani/scenes/scene-018.md","source_record_id":"raja-rani-s018-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"The moment you said it, I didn't like it either! I only said it might be good if we did as you suggested! Then all right, don't write down salary we aren't paying... no; Leela has no salary, man! You go! Get back to work, Leela!","mode":"prose-faithful","notes":[]}}]}
