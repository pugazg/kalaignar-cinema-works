{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source_scene_number":null,"scene_status":"verified","unit_count":62,"units":[{"id":"raja-rani-en-s033-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Leela... Leela... what, Leela, did you get frightened?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"I don't like any of this at all!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"The play! That play you staged!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":46,"printed_page":45}]},"translation":{"english_text":"Oh-ho! Worried because a riot broke out? That's all quite normal, Leela!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"It may be normal to you; it frightens me! What if a stone or stick had struck your head in that commotion?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"What would have happened? A little blood would have come out! That's all, Leela! Do you know how many scars of sacrifice this body has borne? You see the disturbance happening in our play now? I'm not afraid of any of this; one has to be ready to accept many scars of sacrifice! Stones will fall; sticks will be swung; wild streams will block the way. You mustn't lose heart over all that, Leela! Do you think the path of love is an ordinary path?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"What? What? What path?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Path... path... footpath... road.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"What road?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Road... Erode! Erode!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"What Erode?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"No, Leela! I was trying to say you're still wet! In the cold my tongue slipped and 'Erode' came out! Never mind... Kanchi! Kanchi...!","mode":"prose-faithful","notes":["The English preserves the source's wet/Erode/Kanchi sound-play rather than replacing it with a new joke."]}},{"id":"raja-rani-en-s033-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"What Kanchi...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"I mean, dry your head... You're wet, Leela; you might get fever and all... I'll give you a sari—will you wear it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Where is it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"If you need one, I'll tear open my belly and take it out... Here!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/scenes/scene-033.md","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Raja takes the sari out from inside his clothing and gives it to Rani."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"(He takes it out from inside his shirt/belly area and gives it to her.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"And for you...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"I took only one and kept it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u021","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/scenes/scene-033.md","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Rani changes her clothes."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"[Rani changes her clothes.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Leela... hmm... come, come! It's cold, isn't it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"You're cold too...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Ye...s...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"I'm cold too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u027","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/scenes/scene-033.md","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Rani is startled on seeing a statue there."},"speaker_label":null,"page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"(Seeing a statue there, Rani starts in fright.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"Don't be afraid! Don't be afraid!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"What is this?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":47,"printed_page":46}]},"translation":{"english_text":"This... that... this thing... oh dear, this—it's in my mouth but the word won't come out...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Then spit it out...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Can't do that! Yes... love meter! Love meter!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"What meter?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"A device that measures love!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"What device?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Ah! That is, if someone with a stain in their heart touches it, it'll go 'bak!' and bite them! If someone has no stain, it does nothing! Ah!... I think you don't have anything, I think you have no stain! Put your hand on it!","mode":"prose-faithful","notes":["The source's comic bite-noise `பக்கு` is represented as the sound `bak!`; the Tamil is not normalized."]}},{"id":"raja-rani-en-s033-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Hmm... I won't.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Then you have a stain! You have a stain!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"I have no stain at all.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u041","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/scenes/scene-033.md","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Rani places her hand on the love meter."},"speaker_label":null,"page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"(She places her hand on it.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Aha! It didn't do anything—so you have no stain. Why should I be any different? I'll put mine on it too.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u043","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/scenes/scene-033.md","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Raja deliberately cries out; Rani grabs and pulls his hand."},"speaker_label":null,"page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"(He deliberately cries out “Ah!” She grabs his hand and pulls it.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Leela... Leela... did you see the fish? The fish?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Where?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"In your eyes.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"All right... all right... stop it. I understand your ways now.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Aha... you understand my ways? But I still don't understand yours. I'm beginning to understand a little, though...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Nothing. That day, you left that sari-jacket packet behind in my car... forgot it... and went, didn't you? I took it... I came to give it to you, didn't I? When I came, suddenly—Samarasam's house...","mode":"prose-faithful","notes":["The direct-scan-resolved source form `வந்தனா` is preserved as a conversational false-start/question rather than silently regularized."]}},{"id":"raja-rani-en-s033-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Samarasam's house?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u052","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Yes. That dog there chased and chased me... kept driving me and driving me... and I ran and ran...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u053","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d048","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":48,"printed_page":47}]},"translation":{"english_text":"Oh-ho! So after all that running you finally dashed into Samarasam's house, the one next to ours?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u054","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d049","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":48,"printed_page":47},{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Yes! I put that packet in that amma's room and came away!","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":48,"printed_page":47,"english_text":"Yes! I put that packet in that amma's room"},{"pdf_page":49,"printed_page":48,"english_text":"and came away!"}]}},{"id":"raja-rani-en-s033-u055","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d050","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Yes, yes! That amma gave it to me!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u056","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d051","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"She must have said I gave it! She would have told you I gave it...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u057","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d052","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Yes, all right! Let's go. The cold seems to have eased a little too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u058","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d053","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Yes. Of course the cold will ease—because the words are heating things up, aren't they...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u059","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d054","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Hmm, let's go.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u060","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d055","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Wait, Leela... let's talk a little before we go.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u061","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d056","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Look here. None of this is right. If you behave like this, I won't even be able to come to work afterward. Yes, they won't let me out from home...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s033-u062","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s033","archival_scene_ordinal":33,"source":{"source_path":"works/raja-rani/dialogues/records/scene-033.json","canonical_scene_path":"works/raja-rani/scenes/scene-033.md","source_record_id":"raja-rani-s033-d057","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Ayyo! You won't come to work? They won't let you out? Then that's enough for today... let's go. Slowly, slowly. Careful, careful.","mode":"prose-faithful","notes":[]}}]}