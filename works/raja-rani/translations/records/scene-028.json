otes":[]}},{"id":"raja-rani-en-s028-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Sit down. Ah... Muruga, bring coffee!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Ah!... no, it's all right. I had coffee just before I came. I came here... that is, yesterday, when I was coming here... that dog, it... b...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"So you came yesterday and went away because you were afraid of the dog?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Ah!... no...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"It's all right... sit down!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"No! You shouldn't think strangely of me at all... it was only because this dog came to bite me...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"That dog doesn't bite; it only barks.","mode":"prose-faithful","notes":["The source prints the unusual form `கொலைக்கும்`; the English renders the immediate dog-action sense without altering the Tamil."]}},{"id":"raja-rani-en-s028-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Ayyayye! No! Because that dog came to bite me, I ran here and there, went around and around, and at last...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"You went all the way back home?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Ah! Ayyyo! Ayyyo, this!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"You don't need to be afraid of anything; you should have come straight in!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/scenes/scene-028.md","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Samarasam enters at that moment."},"speaker_label":null,"page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"(Samarasam enters at that moment.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"