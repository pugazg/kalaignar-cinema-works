[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Oh man... ayyo! Ahalya, is it? First, stage the play—stage a good play well! Cast her herself as Ahalya...","mode":"prose-faithful","notes":["The source's English-derived `பஷ்ட்டு` is retained semantically as ‘first’ without changing the Tamil record."]}},{"id":"raja-rani-en-s028-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Ah! He'll play sage Gautama!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Yes! Then you're Indra! The play is over!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s028-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s028","archival_scene_ordinal":28,"source":{"source_path":"works/raja-rani/dialogues/records/scene-028.json","canonical_scene_path":"works/raja-rani/scenes/scene-028.md","source_record_id":"raja-rani-s028-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":44,"printed_page":43}]},"translation":{"english_text":"Yes... yes! Ah... all right! What is it, sir—you seem very angry?","mode":"p