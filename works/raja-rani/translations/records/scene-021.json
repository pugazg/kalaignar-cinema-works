{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source_scene_number":null,"scene_status":"verified","unit_count":56,"units":[{"id":"raja-rani-en-s021-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/scenes/scene-021.md","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Raja brings Rani and leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"(Raja brings Rani and leaves.)","mode":"prose-faithful","notes":["The source stage direction prints Raja as `ராசா`; the exact Tamil form remains in the verified source."]}},{"id":"raja-rani-en-s021-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Who was that? It sounded as though someone had come!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/scenes/scene-021.md","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"A pigeon flies from him, lands on Rani's head, and visibly moves as she walks."},"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":34},{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"(At that moment a pigeon flies from him and lands on Rani's head; as Rani walks, it can be seen moving.)","mode":"prose-faithful","notes":["The source stage direction crosses PDF 35→36 and remains one translation unit."],"english_page_segments":[{"pdf_page":35,"printed_page":34,"english_text":"(At that moment a pigeon flies from him and lands on Rani's head"},{"pdf_page":36,"printed_page":35,"english_text":"; as Rani walks, it can be seen moving.)"}]}},{"id":"raja-rani-en-s021-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hmm... do you think I'd let you go? I'm so fond of you—and you're trying to run away!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/scenes/scene-021.md","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Samarasam tries to catch the pigeon; Shanthammal sees this from upstairs, and Rani gets away."},"speaker_label":null,"page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"(He tries to catch the pigeon. Shanthammal sees this from upstairs, and Rani gets away.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"What's the matter?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலைக்காரன்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Nothing, amma!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமையல்காரன்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hey, keep quiet. Ayya has been going around with that girl...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Ah! You saw it too?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"If you're asking whether I saw it with my own eyes—is this something that started today or yesterday? It's been going on for so long...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"He's just saying things. There's nothing, amma!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hey, you keep quiet. You're ayya's man, aren't you? He's the one who saw it directly! Hmm... so that's the news! All right, all right, go and see to your work... Why are you still standing there?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"It hasn't been going on for very long. Only today!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hmm... only today, is it? Let him come; I'll talk to him!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u015","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/scenes/scene-021.md","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Samarasam comes in looking distressed."},"speaker_label":null,"page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"(Samarasam comes in looking distressed.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Mm. Come, sir! Come... come... sit here. Are all your games over?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Oh, be quiet for a bit.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Oh-ho! I suppose you're worried because she went away so soon!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Why wouldn't I be? Right while I was playing...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Yes, yes! If she left halfway through, of course you'd be upset!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Did you see?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Mm, I was watching that eyesore the whole time!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"A wretched creature? Tch, you donkey! The one that ran away was very beautiful!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Uh-huh... so is the one who's here inferior?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"I didn't say anything was inferior! It's not the same! Ah, it ran away!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Oh! Shall I go and ask her to come back for you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Ask her to come back...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hey! Your mind is getting worse and worse!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hey... hey... what's this—you've changed today?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Things have changed over there, haven't they? Then things here have to change too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hey! Why are you rattling on and on like this?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"I'm not rattling on; I'm only telling the truth!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"What truth?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Why, my man is a big shot!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Ah! Did you just call me 'nee'—'you'? Hmm...","mode":"prose-faithful","notes":["The exchange hinges on the source pronoun `நீ`; `nee` is retained so the repeated form and comic escalation remain visible."]}},{"id":"raja-rani-en-s021-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Nee...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"'Nee,' is it? Come on, say it once more.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Nee... r...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Nee...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Nee...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"You're calling your husband 'nee'. Go on, say 'nee' once more.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Nee.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Wait, I'm coming right now.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலைக்காரன்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Master...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u045","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/scenes/scene-021.md","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"The servant brings a board; Samarasam takes it and raises it to strike his wife."},"speaker_label":null,"page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"(He brings a board. Samarasam takes it and raises it to strike his wife.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Give it here...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Ayyayyo! That says, \"Let peace flourish!\" Peace.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"I got it written and brought it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Oh-ho-ho, \"Let peace flourish,\" is it? All right, peace. Shanthamma, all right then, come—come this way... come and sit.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hmm... bring that pigeon and make it sit here.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u052","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"What is this, master?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u053","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d048","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":37,"printed_page":36},{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"That's what I don't understand. I brought a pigeon for world peace, and it has stirred up a quarrel at home. Hmm... all right, take it and hang it over there.","mode":"prose-faithful","notes":["This is one immutable dialogue record crossing PDF 37→38; the English page segments preserve that physical source boundary."],"english_page_segments":[{"pdf_page":37,"printed_page":36,"english_text":"That's what I don't understand. I brought a pigeon for world peace, and it has stirred up a quarrel at"},{"pdf_page":38,"printed_page":37,"english_text":"home. Hmm... all right, take it and hang it over there."}]}},{"id":"raja-rani-en-s021-u054","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d049","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"Then shall I turn this around and hang it like this?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u055","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/scenes/scene-021.md","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":6,"description":"The servant turns the board around and shows it."},"speaker_label":null,"page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"(He turns the board around and shows it.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s021-u056","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s021","archival_scene_ordinal":21,"source":{"source_path":"works/raja-rani/dialogues/records/scene-021.json","canonical_scene_path":"works/raja-rani/scenes/scene-021.md","source_record_id":"raja-rani-s021-d050","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":38,"printed_page":37}]},"translation":{"english_text":"What? \"Let quarrel flourish.\" \"Let quarrel flourish,\" is it? Ah... did you write that? Erase it, man—erase, erase, erase.","mode":"prose-faithful","notes":["The source prints the slogan as `சண்டை ஓங்குஹ`; English renders the slogan's sense without normalizing the Tamil source."]}}]}
