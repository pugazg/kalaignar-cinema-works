{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source_scene_number":null,"scene_status":"verified","unit_count":29,"units":[{"id":"raja-rani-en-s045-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/scenes/scene-045.md","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Raja comes outside and finds Rani standing there."},"speaker_label":null,"page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"[As he comes outside, Rani is standing there.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Oh, Rani! Why do you look so worn, Rani? Hmm?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Nothing.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Hmm... Rani! Today I'm going to ask you something. You must answer without getting angry, understand?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Ask me!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Hmm... yes... ah... ha... all right! Here—wear this flower in your hair!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"No!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Why, don't you like flowers, Rani? Hmm... I've been noticing all these days—you never wear a flower in your hair, not even for one day. Why? Fine, no flower; at least wear a pottu! Show me your forehead... a javvadhu pottu!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"No! What do I need all this adornment for?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"What's this, Rani? Like a widow, you keep saying no, no to everything. Eh?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Ah! [Cries.]","mode":"prose-faithful","notes":["The source bracket is retained neutrally; its Tamil grammatical form is not silently corrected."]}},{"id":"raja-rani-en-s045-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Are you angry, Rani? What I asked... Ah! I only asked it as a joke...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"A joke indeed! A marriage-game played in the age of childhood games! And the result of that game is this—Rani's widow's garb!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Ah.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"What use is there in hiding it any longer? My life has been cut short. This world has fenced me in with thorns and sent me to a corner. You call me a round moon, a stalk of sweet sugarcane—but your Rani is a barren tree!... A barren tree.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"A barren tree will not sprout; spoiled milk will not taste sweet. Ha... ha... ha, Raja! At least now do you see the plain green truth hidden in Babu's words?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"A widow. My Rani is a widow. Rani, why didn't you tell me this all these days?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":63,"printed_page":62}]},"translation":{"english_text":"Is that even a question? As long as there are people who can be deceived, deceivers profit. Now you've found out... and she's begun using the arrow of tears.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"I don't have a heart that melts for false tears, Babu.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Don't say such things! When I was at an age called an unopened bud—a little deer that had not yet leapt—they say a marriage thread was tied around my neck. Only today did I myself learn that I am a woman who lost that marriage thread!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Then why, all these days, was there no flower in your hair? No pottu on your forehead? Hmm... If you could hide such a great truth and steal my heart, what else wouldn't you do!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"She'd even kill!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Ayyo! Believe me... listen to what I'm saying... (She holds his hand.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"I've heard enough. Let go of me...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Is this my punishment simply because I lost my thali? Are you a soldier in the force that awakens a fallen society, gives strength to bodies whose springs are broken, and works to turn the country into a garden of renaissance? Has your heart become so stony that the word 'widow' makes you mock even my tears? Look at me. Must this young vine be caught and ruined in the storm called the cruel restrictions of widowhood? Tell me—answer me!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"I don't even care that you lost your thali. But you've hidden this from me all these days and deceived me. That is something no one can forgive...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"I didn't hide it—I never hid it. They hid it from me, those great sinners.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Tch! Tch...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s045-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s045","archival_scene_ordinal":45,"source":{"source_path":"works/raja-rani/dialogues/records/scene-045.json","canonical_scene_path":"works/raja-rani/scenes/scene-045.md","source_record_id":"raja-rani-s045-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரா","page_provenance":[{"pdf_page":64,"printed_page":63}]},"translation":{"english_text":"Listen to this—listen to this. (Raja leaves.)","mode":"prose-faithful","notes":[]}}]}