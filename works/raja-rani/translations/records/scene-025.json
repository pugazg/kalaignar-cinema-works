phrase `மென்ஷன்...நோமென்ஷன்`; it is retained rather than silently regularized."]}},{"id":"raja-rani-en-s025-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/scenes/scene-025.md","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Raja drives away, notices Rani's forgotten parcel on the back seat, returns to give it back, is chased by the dog, climbs a creeper through the window and lands in Shanthammal's room while she is asleep."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"(Raja drives away. After going a little distance he notices the parcel Rani has accidentally left on the car's back seat. He drives back to return it. A dog chases him at the entrance to Samarasam's house; gripping a creeper spread along the window, he climbs up and jumps into Shanthammal's room. Shanthammal is asleep.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜ","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Shanthamma! Isn't this Samarasam's house? Ayyayyo. What am I going to do?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u006","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/scenes/scene-025.md","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"He knocks down a flowerpot, replaces it, leaves the parcel there by mistake and runs away."},"speaker_label":null,"page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"(He knocks down a flowerpot. While putting it back, he leaves the parcel in his hand there and runs away.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Catch the thief—don't let him go!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Sir... sir...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Hey, Raja! Raja—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Sir... sir... ayyayyo!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Hey, Muruga, Sankara—everybody come! Hey Babu... brother-in-law. Hey... my wife's brother!... Catch him, don't let him go!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"What? What's happening here?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Don't let him get away.","mode":"prose-faithful","notes":["The source prints the unusual form `உடி புடாதே`; English renders the immediate action without changing the Tamil record."]}},{"id":"raja-rani-en-s025-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"What... what?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"There... there... hey, did any of you see someone running here?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Didn't see anyone, sir.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"You didn't see anyone...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலை","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Didn't see anyone.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"All right, go and lie down. He must have gone... around the back, toward the kitchen. Go on, hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Athaan, what happened?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Hmm—did you ask that Raja to come?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Raja? I didn't. Why?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"You didn't tell him?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"I didn't...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"But he came!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Where...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"He came here!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"When?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"He ran out from upstairs—I saw him!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Ah!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"I saw him with my own eyes! Don't let him get away... Brother-in-law, it's finished; finished... You go catch him and kill him!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Athaan...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Kill him—catch him!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Athaan, just watch... today is the end of it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Brother-in-law... ah... peace. Kill him peacefully. Catch him and bring him to me... ah, sinner.","mode":"prose-faithful","notes":["The contradiction between `peace` and `kill` is printed comic dialogue and is preserved."]}},{"id":"raja-rani-en-s025-u036","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/scenes/scene-025.md","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Samarasam goes to Shanthammal's room and picks up Rani's parcel left there by Raja."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"(He goes to Shanthammal's room. There he picks up Rani's parcel, which Raja had left behind when he fled.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/dialogues/records/scene-025.json","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":"raja-rani-s025-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"What's this? A jacket! A sari! Ah, I didn't buy this for her! How did this get here? Ah... hmm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s025-u038","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s025","archival_scene_ordinal":25,"source":{"source_path":"works/raja-rani/scenes/scene-025.md","canonical_scene_path":"works/raja-rani/scenes/scene-025.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Suspicious, Samarasam puts the parcel in the bureau and leaves."},"speaker_label":null,"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"(Suspicious, he puts it in the bureau and leaves.)","mode":"prose-faithful","notes":[]}}]}