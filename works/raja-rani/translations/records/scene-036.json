{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source_scene_number":null,"scene_status":"verified","unit_count":56,"units":[{"id":"raja-rani-en-s036-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Raja drops Rani off; after he leaves, Babu stands before her as she tries to go out."},"speaker_label":null,"page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"(Raja drops Rani off. After he leaves, as Rani tries to go out, Babu stands before her.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Who's that? Rani?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Hmm... yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Ha... hey! Didn't you tell me you wouldn't act in the play at all... you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"That... that... I came to tell you...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"All right, all right! Return all the 'presentations' I bought you right now!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Ayyo! I've already used all of them! Tell me how much they cost. I'll repay exactly what you paid!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"The price I paid? Do I have to tell you? I may buy it... or steal it... what is that to you? Are you mocking me? Am I a beggar to take money from you? Respectfully return the sari and blouse I bought you. Even if they're old clothes now, never mind... give them!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"You say you're not a beggar, but you sound like a proper kudukuduppai fortune-teller!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Keep all this teasing and mockery for your lover Raja! In place of my presentation, at least take off this bangle and give it to me now!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Babu grabs Rani's hand."},"speaker_label":null,"page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"[He grabs her hand.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Ah... ee!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Give it...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u014","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Samarasam sees what is happening."},"speaker_label":null,"page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"[Then Samarasam sees them.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Hey... hey... hey... Babu!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Athaan, I didn't...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Don't talk! Did I build this garden for this sort of thing? Nothing like this should happen in Samarasam's house, da... get out... get out... Here, amma!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Babu leaves and comes back."},"speaker_label":null,"page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"[Babu leaves and comes back.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Here, amma!... you come...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Hey... go! Why did the brother-in-law who left come back? Run!... go! Ah... amma, you're the one who played a role in that drama, aren't you?... What brought you here?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Yes; I came thinking I could tell you something.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Nonsense! I saw you talking with that fellow...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Ayyo! I didn't do anything... he was the one who behaved improperly with me... look, my hand...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Ayyo!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u025","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Santham arrives with Babu."},"speaker_label":null,"page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"[Santham arrives with Babu.]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்","page_provenance":[{"pdf_page":54,"printed_page":53}]},"translation":{"english_text":"Aha! So this is what's going on? There's no limit to this indecency!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Exactly!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Hmm... I'm not some madwoman; I'm not going to let this go; hey, lightning-vine! Sprinkling magic powder, are you, magic powder!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Here, here... no use talking to that girl; ask him!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Ah... ah! Yes, I should ask him! Hey, are you really the younger brother born with me? All this is happening and you're just watching!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Why... this, because of me?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Day after day she comes here, running and playing in this flower garden—ayyo!... ayyo!... karma... karma! My fate... at this old age...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Hey... hey! Why are you calling him an old man...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Hmm, hmm... I didn't mean him, ayya! I didn't mean him at all!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Then... who else is the old man here?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Hmm... I'm talking about you, ayya!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Me? Me? You called me old? Am I old... hey, machaan?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"But there's nothing old about his actions!...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Hey girl! Was my husband the only man you could find to run around and play with?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"What is this, amma? You're just going on saying all sorts of things...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"What did you say?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u042","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":6,"description":"Santham strikes Rani."},"speaker_label":null,"page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"(She strikes Rani.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Hey! Look, you're not a ghost; you're a woman!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Get out, girl! If you set foot inside this compound one more time, I'll break your leg! Be warned!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Here... here... look, half this compound belongs to me! You can come into my half!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Ah...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u047","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":7,"description":"Santham starts fighting again."},"speaker_label":null,"page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"(Santham starts the quarrel again.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Here... here... you come with me!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u049","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/scenes/scene-036.md","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":8,"description":"Samarasam takes Rani away with him."},"speaker_label":null,"page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"(He takes Rani away with him.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-036.json","canonical_scene_path":"works/raja-rani/scenes/scene-036.md","source_record_id":"raja-rani-s036-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"english_text":"Aha! Has it gone that far? We mustn't leave them alone!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s036-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s036","archival_scene_ordinal":36,"source":{"source_path":"works/raja-rani/dialogues/records/scene-03