{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source_scene_number":null,"scene_status":"verified","unit_count":47,"units":[{"id":"raja-rani-en-s039-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"Hmm... thambi! That woman who played the courtesan Annam—who is she?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"I came to ask you about that because I had my doubts!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"You have doubts too? Why, everyone already knows!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"Hmm... is there something between our Samarasam and that woman?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"There is... there is... there is... why are you asking so timidly and secretly?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"No... at first I thought there was no connection between that woman and your house. But now I saw that woman and our Samarasam go together into that woman's house!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"They went?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"Yes.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"They went together?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"Yes, I just saw it and came.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"You saw it with your own eyes, thambi?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"Yes, amma.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"english_text":"Thambi, don't be hurt because I'm saying this. He preaches to the whole town. Can he behave like this? I trusted him so much. Thambi, you're like my own brother... why hide it from you? Somehow reform him.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"What are you saying?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"That's it, thambi. At this age, should he be roaming around with that actress?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Ayyo. Is that what you suspected? Don't think anything like that, amma.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"I see it with my own eyes, thambi! She comes to the garden every single day...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"What the eye sees may be false—what the ear hears may be false—only thorough inquiry is truth, amma.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u019","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/scenes/scene-039.md","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Samarasam enters."},"speaker_label":null,"page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"(Samarasam enters.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Once more....","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Sir... greetings, sir....","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Greetings, once more....","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"What, sir—you don't know it, sir?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"I know; someone else needs to know.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Ah... no, sir...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Didn't I say, say it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Ah... all right, sir... What the eye sees may be false—what the ear hears may be false—only thorough inquiry is truth. Sir...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Bravo... bravo....","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Bravo... bravo....","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Everything seen by the eye is true. Nothing is false. Come, let's go and talk.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Amma... I'm leaving, amma.... Then sir, I'm leaving, sir...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u032","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/scenes/scene-039.md","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Santhammal goes into the room; the cook enters."},"speaker_label":null,"page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"(Santhammal goes into the room. The cook enters.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Hey, where are you off to?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"All the work is finished, ayya... I was just setting out to go outside and lie down.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Muruga....","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Ayya.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"That day, you said he bought that sari and gave it, didn't you...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"Yes... he himself bought it and gave it. What doubt is there in that? He was the one who bought it and gave it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"english_text":"What is this—it's getting more and more contradictory, front to back?...","mode":"prose-faithful","notes":["This translation follows the user's direct-scan resolution `முன்னுக்கு பின் முரணாயிகிட்டே போவது?`; the Tamil source form is not normalized."]}},{"id":"raja-rani-en-s039-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"What, ayya... why are you saying 'contradictory'! It was this fellow... our Sankaran fellow who bought it and gave it... I saw it with my own eyes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Sankaran bought it and gave it to whom?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"He gave it to her!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"To which woman...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"To our maid!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Damn it! Were you talking only about that sari business?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமை","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Then what else did you think I was talking about... you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s039-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s039","archival_scene_ordinal":39,"source":{"source_path":"works/raja-rani/dialogues/records/scene-039.json","canonical_scene_path":"works/raja-rani/scenes/scene-039.md","source_record_id":"raja-rani-s039-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":58,"printed_page":57}]},"translation":{"english_text":"Nothing, appa! Go lie down and sleep, appa! Suspicion is a terrible disease!","mode":"prose-faithful","notes":[]}}]}