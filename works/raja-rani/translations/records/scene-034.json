{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source_scene_number":null,"scene_status":"verified","unit_count":77,"units":[{"id":"raja-rani-en-s034-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Babu tries to climb up at Rani's house."},"speaker_label":null,"page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"(Babu tries to climb up at Rani's house.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Hey, stop! Who's there—Babu? Why, Babu, how did you come to this state? Why are you climbing up this house now?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Stop it. Climbing onto houses—climbing walls and jumping over—that's all your habit.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"What are you saying?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Why did you sneak into our house that night?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"That?... That was the dog.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Who are you calling a dog, da?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Babu hits Raja."},"speaker_label":null,"page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"(He hits him.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Babu...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"What Babu... Babu, he says... such a great righteous man!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Babu, what did I just ask you...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u012","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"The two men fight; Rani sees it."},"speaker_label":null,"page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"(The two fight; Rani sees them.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞானக்கண்","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"What is that, amma?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"Nothing, appa. Some two men are fighting in the street.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":49,"printed_page":48}]},"translation":{"english_text":"That's quite ordinary, amma. Some rowdies drink without knowing how and roll around fighting...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"No, appa—they're fighting right in front of our house.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞா","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"What is our house, a sub-inspector's house? Let them roll around as they like. Why are you going over there, amma? Go, lie down and sleep...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Rani, dressed as a man, attacks Babu; she and Raja count one, two, and at ten Babu runs; the stick she raises at Babu lands on Raja's head."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"(Rani, dressed as a man, attacks Babu. Together with Raja she counts ‘one’, ‘two’; when they reach ‘ten’, Babu runs away. Rani raises a stick to strike Babu, but it lands on Raja's head.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Thambi, did you see? Did you see? He ran away—but why, thambi, you hit me yourself!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u020","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Raja sits down; Rani lifts him."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"(He sits down; Rani lifts him.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Unlabelled spoken line as the wounded Raja is helped up."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Slowly, slowly—hold that hand. He bit me on this hand, thambi. I need some water...","mode":"prose-faithful","notes":["The source supplies no speaker label; contextual ownership is not promoted into metadata."]}},{"id":"raja-rani-en-s034-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Wait, I'll bring it.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u023","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":6,"description":"The two enter the house."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"(The two enter the house.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Who is it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Nobody, appa—hey, you've come right inside the house?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Hee... hee...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Who? What?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Mm... some wretched fellow beat him up and left him. He says he's very exhausted; he asked for a little water.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"All right... all right. Give him water quickly and send him outside—why buy all this trouble for nothing?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"All right, all right—sit down, appa.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Was the blow hard, ayya?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Ah! The blow wasn't very hard—the bite was a little hard...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"He bit you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Mm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Ayyyo, poor fellow. These days even dogs don't use their teeth—it's man who's become very bad, tch... tch... tch...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Yes, if these fellows don't get food... they'll bite people instead...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u037","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":7,"description":"Raja notices Rani's picture."},"speaker_label":null,"page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"(Raja notices Rani's picture.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":50,"printed_page":49}]},"translation":{"english_text":"Mm. Here, ayya—water.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Ayyayyo, what's this... in the water...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":2,"description":"Unlabelled exclamation immediately after Raja's water line."},"speaker_label":null,"page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Ah... a bug, a bug...","mode":"prose-faithful","notes":["The source prints no speaker label; the line remains unlabelled in translation metadata."]}},{"id":"raja-rani-en-s034-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"A bug?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"What bug, appa?...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Ah. I can't tell; it won't show its face... it must be because it works at night.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"All right, look carefully and drink.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Ah. I am looking carefully. (He pours it on his face.)","mode":"prose-faithful","notes":["The parenthetical action is printed inside the labelled source utterance and remains inside the linked unit."]}},{"id":"raja-rani-en-s034-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"What was that?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Water...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u048","kind":"dialogu