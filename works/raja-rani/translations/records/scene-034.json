-rani-s034-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"A person's eyes have plenty of poison too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u052","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஞான","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Who is this young fellow—an eye-hospital doctor?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u053","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/scenes/scene-034.md","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":8,"description":"Rani dresses Raja's wound."},"speaker_label":null,"page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"(Rani dresses the wound.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u054","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Ah... thambi!... what are you doing? Slowly... ayyyo, slowly, thambi. How was that knockout in the fight?","mode":"prose-faithful","notes":["The source visibly code-switches to the English-derived `நாக்கவுட்`."]}},{"id":"raja-rani-en-s034-u055","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Who gave it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u056","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"He gave it! There... he's kept it there, hasn't he! By the way, thambi, are just the two of you living alone?","mode":"prose-faithful","notes":["The source phrase `அதா...வச்சிருக்கானே!` is retained conservatively; no absent referent is supplied."]}},{"id":"raja-rani-en-s034-u057","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s034","archival_scene_ordinal":34,"source":{"source_path":"works/raja-rani/dialogues/records/scene-034.json","canonical_scene_path":"works/raja-rani/scenes/scene-034.md","source_record_id":"raja-rani-s034-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":51,"printed_page":50}]},"translation":{"english_text":"Yes...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s034-u058","kind":"dialogue","status":"verified","target_la