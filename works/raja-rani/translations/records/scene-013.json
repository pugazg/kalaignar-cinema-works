{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source_scene_number":null,"scene_status":"verified","unit_count":9,"units":[{"id":"raja-rani-en-s013-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/scenes/scene-013.md","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Rani's inner struggle as she walks toward the house."},"speaker_label":null,"page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"(Rani's inner struggle as she walks toward the house.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"மனம்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"What kind of world is this... hmm... Babu, acting compassionate while stooping to a vile deed—Raja, who warmly received a stranger like me and believed I was a wealthy man's daughter—Appa, who is going to ask, ‘Where were you all night, amma?’... Ayyo! Where was I last night...? How did I fall asleep like that? What answer can I give Appa? I understand nothing...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"நிழல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Why don't you understand, Rani? Why are you bewildered? Why be afraid when I am here? I am Leela! I am that Leela you lied about to Raja.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/scenes/scene-013.md","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"Source-unlabelled spoken line between the Shadow's first and second utterances."},"speaker_label":null,"page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Rani—Leela?","mode":"prose-faithful","notes":["The source supplies no speaker label; contextual ownership is not promoted into metadata."]}},{"id":"raja-rani-en-s013-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"நிழல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Yes, Rani. Don't worry. This is a world that turns helpless women into sugarcane fed into a mill—a world where only the clever survive. There is nothing wrong in lying so long as it harms no one, girl; nothing wrong!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Lie even to Appa?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"நிழல்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"You spent the whole night in the house of a man you did not know. If you say, ‘I slept there without any dishonour, Appa,’ can he believe you? In any case, you did no wrong; so there is nothing wrong in lying.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"How am I to lie?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s013-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s013","archival_scene_ordinal":13,"source":{"source_path":"works/raja-rani/dialogues/records/scene-013.json","canonical_scene_path":"works/raja-rani/scenes/scene-013.md","source_record_id":"raja-rani-s013-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"நிழல்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Why worry when this Leela is here? Come, let's go!","mode":"prose-faithful","notes":[]}}]}