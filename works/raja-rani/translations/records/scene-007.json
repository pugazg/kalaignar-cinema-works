{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source_scene_number":null,"scene_status":"verified","unit_count":36,"units":[{"id":"raja-rani-en-s007-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/scenes/scene-007.md","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"location-heading","ordinal":1,"description":"Source parenthetical `மேடையில்`."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"(On stage.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Members of the audience! Now Mr Samarasam, who has presided over this play, who is also chairman of the Peace Committee and my brother-in-law, will say a few words about the play.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u003","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/scenes/scene-007.md","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Babu garlands Samarasam."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"(Babu places a garland on him.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Put it on; put it on! Hmm—you could have had someone else put the garland on me. You put it on yourself; never mind. They'll say brother-in-law and brother-in-law, you know. [He takes the paper; it falls to the floor.] Members of the audience! Mothers! Ah! You've come, have you? Except my wife! Ah: this Cheran. That is, you saw the play Cheran Senguttuvan—from it you would have understood how much valour the Tamils had in ancient times—hmm, that is, in the old days when kings fought, two armies would come—some would die there—some would die here—and somebody would get the victory. These days, war—after setting the war going, that is, the fellow who set it going just goes off happily on his own. They drop these, these bombs on people who have nothing to do with it, making everyone die and die, dead and dead—ah! Innocent people die. Ah. Ah. Vanakkam.","mode":"prose-faithful","notes":["The source's deliberately rambling comic anti-war speech, repetitions and embedded paper-drop action are retained rather than regularized."]}},{"id":"raja-rani-en-s007-u005","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/scenes/scene-007.md","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Santham comes up onto the stage."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"(Santham comes up onto the stage.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Nothing. The man who played Cheran Senguttuvan—I want to see him for a moment.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u008","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/scenes/scene-007.md","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"plot-stage-direction","ordinal":3,"description":"Some rowdies plot to steal the play collection by mixing a sleeping drug into tea."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"(Some rowdies, planning to steal the play's collection, mix a sleeping drug into the tea.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ரெள 2","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Madam, Babu sir asked me to give you this tea!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Thanks. Leave it there.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u011","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/scenes/scene-007.md","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Rani drinks the tea."},"speaker_label":null,"page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"(Rani drinks the tea.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"சமரசம்","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"This is Mr Raja!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்தம்","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Vanakkam.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"This is my wife, Santham.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":20,"printed_page":19}]},"translation":{"english_text":"Vanakkam.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Your acting was really magnificent. You gave new life to the very history of Tamil Nadu. I never expected this much.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Many thanks.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Where's our Babu?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"He'll have gone to the booking office to look after the collections.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"What do you say—shall we give thambi a present—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Then give one...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u022","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/scenes/scene-007.md","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":5,"description":"Samarasam reaches for his angavastram; Santham shows the ring."},"speaker_label":null,"page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"(As he reaches for his angavastram, Santham shows the ring.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Thambi! Please keep this. Hmm, if you have time, you must come by our house.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"I don't know where your house is!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Ask thambi and he'll tell you!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"All right, I'll ask around and come.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"சாந்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Then shall we go?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"All right!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதாவின் தாய் தாயம்மாள்","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"You're leaving without saying anything about us!","mode":"prose-faithful","notes":["The unusual long source label and its semicolon delimiter remain immutable in the linked dialogue record."]}},{"id":"raja-rani-en-s007-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"About you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"தா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Hmm! Daughter!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Oh! Doctor? He's a very good man—who is ours?","mode":"prose-faithful","notes":["The source's comic `டாட்டர்` / `டாக்டர்` daughter-doctor misunderstanding is preserved rather than silently clarified."]}},{"id":"raja-rani-en-s007-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"தா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"I was asking about my child.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Oh! Daughter!—this one? Very nice, pretty. A good girl—has she studied?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"தா","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Hmm—and the acting?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s007-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s007","archival_scene_ordinal":7,"source":{"source_path":"works/raja-rani/dialogues/records/scene-007.json","canonical_scene_path":"works/raja-rani/scenes/scene-007.md","source_record_id":"raja-rani-s007-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":21,"printed_page":20}]},"translation":{"english_text":"Did she act? I didn't notice—oh, pesh! pesh! pesh—good acting. Pesh pesh—magnificent! Magnificent!","mode":"prose-faithful","notes":[]}}]}
