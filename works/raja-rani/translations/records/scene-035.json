{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source_scene_number":null,"scene_status":"verified","unit_count":27,"units":[{"id":"raja-rani-en-s035-u001","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Current, where is the boss? Still no sign of him?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"(Coming in) Why, Leela, looks like I've got a hundred-year life!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"What's this bandage on your hand?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"That... a bite...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Hmm... don't you know? Last night our sir and Babu had a 'terrible fight.' Haam... a fight means a fight—Tiger Olden fight!","mode":"prose-faithful","notes":["The source-visible comic English-derived phrase `டைகர் ஓல்டன் பயிட்டாம்` is retained rather than silently corrected."]}},{"id":"raja-rani-en-s035-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Hey! Say it in Tamil and be done with it—'sandai'!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Ah! There wasn't any news in the paper...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Exactly! Was it a world war that it should appear in the newspaper?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Ah... there are papers that print even this kind of matter, sir... if you want, shall I go give them the news right now?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Oh man, keep quiet for a bit! We don't need that sort of publicity.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":52,"printed_page":51}]},"translation":{"english_text":"Yes; why did Babu pick an unnecessary fight with you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":52,"printed_page":51},{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Heh heh... why ask like that? Does a dog that's going to bite announce, 'I'm going to bite,' and then bite? Do all the quarrels in the town and the world happen with cause and reason? Something like that... he came looking for a fight; he got a solid beating and left!","english_page_segments":[{"pdf_page":52,"printed_page":51,"english_text":"Heh heh... why ask like that? Does a dog that's going to bite announce, 'I'm going to bite,' and then bite? Do all the quarrels in the town and the world..."},{"pdf_page":53,"printed_page":52,"english_text":"happen with cause and reason? Something like that... he came looking for a fight; he got a solid beating and left!"}],"mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Did you hit him?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Hmm... would I hit him? If I hit him, could he bear it? Wouldn't he break apart... A boy ran in to save me... ah, you should've seen him hit—what a beating... not your-house beating, not our-house beating... such a beating! Hmm—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Good heavens! Sounds like a great wrestler!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Hmm... a boy... a small boy, but seeing that boy you'd have to call him a woman, Leela!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"(Startled) What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Yes, such a tender heart... such a tender heart! Poor boy, he has an aged blind father—it looks as though the whole family's burden is on that boy's head!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Good thing that in his old age the blind old man at least had a son born to help him... and not a girl!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Hey, what's wrong if a girl is born? Haven't there been great queens among women... right, Leela?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Yes!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Jhansi Rani... that Rani... this Rani...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Current! There was an order for four radios—have all of them been delivered?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Oh, delivered!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"Aha! The word 'radio' reminded me. Leela, for the help that boy gave me, I'm thinking of presenting him a radio too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"You should.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s035-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s035","archival_scene_ordinal":35,"source":{"source_path":"works/raja-rani/dialogues/records/scene-035.json","canonical_scene_path":"works/raja-rani/scenes/scene-035.md","source_record_id":"raja-rani-s035-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராசா","page_provenance":[{"pdf_page":53,"printed_page":52}]},"translation":{"english_text":"What, Leela, is it time? Leaving? Come, come... I'll come with you!","mode":"prose-faithful","notes":[]}}]}