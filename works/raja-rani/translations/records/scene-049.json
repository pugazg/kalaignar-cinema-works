":66,"printed_page":65}]},"translation":{"english_text":"The word 'poison' tastes sweeter than the word 'widow'! I trust that you will not consider it a crime that a woman who has reached a state in which she cannot live in this world has chosen such an end. I take my leave...\n\nWith affection,\nRani.","mode":"prose-faithful","notes":["The letter is preserved as written text, not converted into dialogue."]}},{"id":"raja-rani-en-s049-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s049","archival_scene_ordinal":49,"source":{"source_path":"works/raja-rani/scenes/scene-049.md","canonical_scene_path":"works/raja-rani/scenes/scene-049.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Current enters."},"speaker_label":null,"page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"(Current enters.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s049-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s049","archival_scene_ordinal":49,"source":{"source_path":"works/raja-rani/dialogues/records/scene-049.json","canonical_scene_path":"works/raja-rani/scenes/scene-049.md","source_record_id":"raja-rani-s049-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Amma! What's this—why haven't you come to the play?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s049-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s049","archival_scene_ordinal":49,"source":{"source_path":"works/raja-rani/dialogues/records/scene-049.json","canonical_scene_path":"works/raja-rani/scenes/scene-049.md","source_record_id":"raja-rani-s049-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"Current! You've come at the right time. Here—take these letters and give them to Raja and Samarasam.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s049-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s049","archival_scene_ordinal":49,"source":{"source_path":"works/raja-rani/dialogues/records/scene-049.json","canonical_scene_path":"works/raja-rani/scenes/scene-049.md","source_record_id":"raja-rani-s049-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"கர","page_provenance":[{"pdf_page":66,"printed_page":65}]},"translation":{"english_text":"[Taking them] Aren't you coming to the play? Come, amma—the play is wonderful!","mode":"prose-faithful","notes":[]}}]}