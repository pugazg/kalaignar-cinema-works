{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source_scene_number":null,"scene_status":"verified","unit_count":7,"units":[{"id":"raja-rani-en-s056-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/scenes/scene-056.md","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-flashback-marker","ordinal":1,"description":"The source marks this as earlier: `(முன்)`."},"speaker_label":null,"page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"(Earlier.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s056-u002","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/scenes/scene-056.md","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Rani is about to drink poison; Samarasam arrives."},"speaker_label":null,"page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"(Rani is about to drink the poison. Samarasam arrives.)","mode":"prose-faithful","notes":["Faithful translation of the source flashback; no procedural detail is added."]}},{"id":"raja-rani-en-s056-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/dialogues/records/scene-056.json","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":"raja-rani-s056-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Rani... Rani... what is this?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s056-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/dialogues/records/scene-056.json","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":"raja-rani-s056-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Let me die. What use is there in my living in this world any longer? I cannot live... I should not live...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s056-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/dialogues/records/scene-056.json","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":"raja-rani-s056-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Rani, I will make you live. Look—if everyone defeated in life began killing themselves, three-quarters of the world's population would have disappeared long ago. Don't worry.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s056-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/dialogues/records/scene-056.json","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":"raja-rani-s056-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"No...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s056-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s056","archival_scene_ordinal":56,"source":{"source_path":"works/raja-rani/dialogues/records/scene-056.json","canonical_scene_path":"works/raja-rani/scenes/scene-056.md","source_record_id":"raja-rani-s056-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"சம","page_provenance":[{"pdf_page":77,"printed_page":76}]},"translation":{"english_text":"Ayyo, no! Listen to me. Bolt the door and lie down as though you had taken the poison and died. I'll take care of the rest. Quickly!","mode":"prose-faithful","notes":["This reproduces a fictional deception in the source; it is not presented as real-world guidance."]}}]}