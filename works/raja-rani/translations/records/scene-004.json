{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source_scene_number":null,"scene_status":"verified","unit_count":26,"units":[{"id":"raja-rani-en-s004-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/scenes/scene-004.md","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"embedded-play-heading","ordinal":1,"description":"Source-visible embedded-play heading after the structural divider."},"speaker_label":null,"page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"(Play: “Cheran Senguttuvan”)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u002","kind":"performance-cue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/scenes/scene-004.md","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":null,"source_occurrence_id":"raja-rani-song-perf-001","source_locator":{"kind":"opening-performance-stage-direction","ordinal":1,"description":"Opening source stage direction describing Rani singing while selling tickets."},"speaker_label":null,"page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"[Rani sells tickets while singing. Inside, Samarasam and his wife Santham are seated.]","mode":"prose-faithful","notes":["This source performance occurrence is securely linked by the song inventory to numbered song 3; no front-matter lyric is imported into this scene."]}},{"id":"raja-rani-en-s004-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"நாடகத் துவக்கத்திற்கு முன்பு குரல்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"“A golden page from the Silappathikaram fashioned by Ilango Adigal, younger brother of Senguttuvan!...\nThe tale of bringing stone from the northern land to erect a statue of Kannagi!\nHeroic lines that tell the ancient history of Tamilakam!\nOne day, when we sat upon the royal throne with ornamented chariot-horses and a vast army!\nThen, in the northern land...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u004","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/scenes/scene-004.md","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"embedded-play-location-heading","ordinal":1,"description":"Source-visible heading `கனக விசயர் சபை` between the opening voice and the court dialogue."},"speaker_label":null,"page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Court of Kanaka and Vijaya","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"மன்னர்கள்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Namaskar!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"கனகர்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Namaskar!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜயர்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Namaskar!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"கன","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"It seems you are waiting for the maiden of the swayamvara, hee...... hee...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"மன்","page_provenance":[{"pdf_page":13,"printed_page":12},{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Yes, now that both of you have arrived, if one of you wins the swayamvara contest, how will the two of you divide that woman between yourselves?","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":13,"printed_page":12,"english_text":"Yes, now that both of you have arrived, if one of you wins the swayamvara contest,"},{"pdf_page":14,"printed_page":13,"english_text":"how will the two of you divide that woman between yourselves?"}]}},{"id":"raja-rani-en-s004-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"தமிழ்நாட்டுப் புலவர்","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Then it will be a Bharata indeed.","mode":"prose-faithful","notes":["The exact source label `தமிழ்நாட்டுப் புலவர்` and its non-colon period delimiter remain source metadata; `Bharata` is retained rather than expanded into an external literary explanation."]}},{"id":"raja-rani-en-s004-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Who are you, man? What are you saying?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"புல","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Tamil! Chaste Tamil! Tamil born with the world! Tamil that arose first and grew ancient in the age before stone arose and earth arose!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"What business do you have in the swayamvara hall?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"புல","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Hmm... strange question, king! If elderly men like you have business in the swayamvara hall... the meaning must be that young men like me have none...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"No mischief; tell us who you are!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"புல","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"I am a Tamil poet—I have come on pilgrimage to the northern land.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"கன","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"A poet? Do you know how to compose poetry?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"புல","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"A poet who cannot compose verse—a warrior who cannot lift a sword—Tamilakam has never seen either of them...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"கன","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"We'll see that too. Come on, recite a poem at once!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"புல","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"On the banks of the Ganga he fought—the Tamilan;\nOn the banks of the Kaveri he sang his fame.\nAll the surging seas he bound and ruled—the Tamilan;\nOn earth he won the higher seat, for the world to praise...","mode":"semantic-poetic","notes":["The four source verse lines remain a poetic utterance; no external literary wording is substituted."]}},{"id":"raja-rani-en-s004-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"கன","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Stop, stop!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Stop, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"கன","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Madman... He fought on the banks of the Ganga—the Tamilan—let him fight, let him! If he comes and fights in the time of this Kanaka Vijaya, we'll break his leg... beware!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"மன்னர்கள்","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Ha... ha... ha...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"விஜ","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"What Kanakar said is worth a thousand lakhs. Poet! When your kings engraved the tiger—bow—fish emblems on the brow of the Himalaya, perhaps kings like us were not here...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s004-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s004","archival_scene_ordinal":4,"source":{"source_path":"works/raja-rani/dialogues/records/scene-004.json","canonical_scene_path":"works/raja-rani/scenes/scene-004.md","source_record_id":"raja-rani-s004-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"புல","page_provenance":[{"pdf_page":14,"printed_page":13},{"pdf_page":15,"printed_page":14}]},"translation":{"english_text":"Why? To fall at your feet and pay tribute? You deranged men! Listen: today itself I return to the south. “Kanaka and Vijaya, with tongues that knew no restraint, joined with the feasting kings and, not knowing the strength of rare Tamil, uttered words—I shall tell them to the Cheran. Drunken madmen! Tamil valour has not died. We shall meet again. The one who rules is Cheran Senguttuvan! Cheran Senguttuvan!!...","mode":"prose-faithful","notes":[],"english_page_segments":[{"pdf_page":14,"printed_page":13,"english_text":"Why? To fall at your feet and pay tribute? You deranged men! Listen: today itself I return to the south. “Kanaka and Vijaya, with tongues that knew no restraint, joined with the feasting kings and, not knowing the strength of rare Tamil, uttered words—"},{"pdf_page":15,"printed_page":14,"english_text":"I shall tell them to the Cheran. Drunken madmen! Tamil valour has not died. We shall meet again. The one who rules is Cheran Senguttuvan! Cheran Senguttuvan!!..."}]}}]}