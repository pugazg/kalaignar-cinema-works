n this company! What do you want?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/scenes/scene-015.md","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":1,"description":"The source prints `ராணி வெளியிலே போர்டு பார்த்தேன்.` without a speaker delimiter."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Rani... I saw the board outside.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Oh!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"I came to see your boss!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"What's the matter?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"That your company needs a 'typist'...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"That? Our company doesn't need a woman typist! We need a man!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"The board doesn't say anything like that!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Oh dear! I told them right then; would that fellow who writes the boards listen? Never mind, we'll have it changed.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Here, please! Arrange for me to see your boss!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"You can't see him, amma! He's a Maruti...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Won't?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"I won't. I won't get caught in this useless trouble!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u016","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/scenes/scene-015.md","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Rani goes inside."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"(Rani goes inside.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Amma, amma! Here! Here! Oh dear, oh dear!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Who is it, Leela? Hey!... Come, Leela, come, come! Sit, sit...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"கரண்ட்","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Sir, sir, this madam came in even though I kept telling her, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Get out, rascal! Hey, I'm talking to you! Go on, babbling without even knowing who she is; go get coffee, soda, refreshment and bring them. Look at his face... You sit down, Leela. Well, Leela, how are things? No quarrel at home, is there? Were your father and mother happy with you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Oh!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Yes, how did you find our shop? I was wondering where we'd ever see you again. That's all right... hmm, never mind... so, how far off is the wedding now?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"That's it... the wedding... I told you I'm not going to get married now!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Yes. Yes. I saw it in the paper that day... so, without getting married...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"I'd like to get some kind of job!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Hey, what's this! That's new! You, working... pesh, pesh! This is the first time in my life I've heard a rich-house girl say she wants to work!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"I don't like living idly. Some respectable job—why, even in your company it looks as if there's a vacancy for a 'typist'...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Yes... that job... you, you—Leela, are you joking? My company is a very small company; you're a girl from a big family. Will this kind of job suit you?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"It's all right. What of it? Isn't it good to be in a place I'm familiar with?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"That's true... that's true!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Then I'll start work today itself. Give me an 'appointment'.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/dialogues/records/scene-015.json","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":"raja-rani-s015-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"'Appointment'... why do we need all that between us? You start the job... the rest I'll...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u033","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/scenes/scene-015.md","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"The door is knocked."},"speaker_label":null,"page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"(There is a knock at the door.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/scenes/scene-015.md","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":2,"description":"Source-unlabelled `எஸ் கமின்...` immediately after the door-knock bracket."},"speaker_label":null,"page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Yes, come in...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u035","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/scenes/scene-015.md","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":4,"description":"Current brings tea."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"(Current brings tea.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u036","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s015","archival_scene_ordinal":15,"source":{"source_path":"works/raja-rani/scenes/scene-015.md","canonical_scene_path":"works/raja-rani/scenes/scene-015.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-spoken-text","ordinal":3,"description":"Unlabelled spoken span before the next printed `கரண்டு:` label."},"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Have some... Hey, Current! Why are you just standing there staring? From today, she's the 'typist' for our company... understand?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s015-u037","kind":"dialogue","status":"ve