          }
        ]
      },
      "translation": {
        "english_text": "‘Here I am, Appa,",
        "mode": "prose-faithful",
        "notes": []
      }
    },
    {
      "id": "raja-rani-en-s002-u003",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "scene_id": "raja-rani-s002",
