{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source_scene_number":null,"scene_status":"verified","unit_count":51,"units":[{"id":"raja-rani-en-s017-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/scenes/scene-017.md","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":1,"description":"Raja comes in."},"speaker_label":null,"page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"(Raja comes in.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Come... come!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Isn't Babu here?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்மாள்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"He'll be here. Come, thambi, come, sit down. We were just talking about you!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"About me?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Yes.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"What?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Your acting in the play that day was splendid—I myself got carried away!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Ha... ha... thanks!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"You cut Geetha's 'portion' down so much, thambi... hmm... not even one full scene!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"What can I do? Babu is responsible for all that. Hmm... the story too is like that! Never mind, in the next new play...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலைக்கார சிறுமி பிரேமா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Could I get a chance in the new play too?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Ah—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Shoo, go away! Did you see this little thing, amma! Hmm—even I apparently don't get a chance—and she wants a chance, a chance!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Prema! Shut your mouth! While these youngsters are joking among themselves—Geetha, shouldn't you take thambi upstairs?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Ayyayyo, no! I'll stay right here!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"All right! Come, girl, let's go!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u018","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/scenes/scene-017.md","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":2,"description":"Thayammal and Prema leave."},"speaker_label":null,"page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"(Thayammal and Prema leave.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"What could the new play be?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Didn't Babu tell you? There are two or three stories! Laila Majnu, Anarkali, Ahalya Devi...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"It would be wonderful if it were a complete love story. I really want the two of us to act as lover and beloved in a 'full' play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"What's the problem—just act and that's that!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Hmm, at least let my wish come true in the play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"What are you saying?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Don't you understand?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Uh-uh...!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Looks like you only know how to deliver dialogues smartly and beautifully—you can't understand their inner meaning!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Oh-ho... by the time I understand the inner meaning, the property in my hands itself will be in danger, amma!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u029","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Sacred love does not arise expecting material wealth!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u030","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d028","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Look here, amma! I came here to see Babu and talk about a new play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u031","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d029","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"That's what I'm saying too—let's stage a love play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u032","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d030","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"The play I'm talking about is one with a beautiful stage before a thousand people...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u033","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d031","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"With fire as witness...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u034","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d032","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"What is this, amma—you are making it dangerous—okay, okay, I'm going... if Babu comes...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u035","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d033","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"[Pulling his shirt] Stay. You can go later!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u036","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/scenes/scene-017.md","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"stage-action","ordinal":3,"description":"Babu comes in while looking at `அகல்யா`; no external identity or object is supplied beyond the source wording."},"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"(Babu comes in, looking at Ahalya.)","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u037","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d034","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"What is this, Mr Raja? Where to?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u038","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d035","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Come, Babu! I came to see you about our new play! The whole forest set is ready for the Ahalya play!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u039","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d036","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"I don't intend to stage any new play now.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u040","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d037","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Why, man?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u041","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d038","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Some fellows spin stories saying they'll support art and develop drama, and in the end they set out to 'develop' the art itself!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u042","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d039","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"There isn't anyone like that in our amateur company!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u043","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d040","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Why not? Every fellow who puts on a king's costume goes around thinking he's a king...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u044","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d041","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"What are you saying?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u045","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d042","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Need any more explanation? Look here, Raja! From now on, you must not come here saying drama and all that! There's no work for you in my drama company!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u046","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d043","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Hey, look here! I didn't come to you looking for a job! At our 'Electric Stores' I give jobs to seven people—do you know that? I only came because of my fondness for theatre. That's all! I know how to put on a play too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u047","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d044","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"And I know how to stop it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u048","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d045","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Hey, you were fine—why have you suddenly got this brain disorder?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u049","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d046","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"There's nothing sudden about it!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u050","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d047","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராஜா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Oh-ho! So you've always been like this?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s017-u051","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s017","archival_scene_ordinal":17,"source":{"source_path":"works/raja-rani/dialogues/records/scene-017.json","canonical_scene_path":"works/raja-rani/scenes/scene-017.md","source_record_id":"raja-rani-s017-d048","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Raja! I'm forgiving you for the first time. Please get out!","mode":"prose-faithful","notes":[]}}]}
