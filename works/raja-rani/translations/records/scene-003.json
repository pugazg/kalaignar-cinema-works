{"work_id":"raja-rani","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source_scene_number":null,"scene_status":"verified","unit_count":28,"units":[{"id":"raja-rani-en-s003-u001","kind":"stage-direction","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/scenes/scene-003.md","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"opening-stage-direction","ordinal":1,"description":"Opening source direction before Babu's first labelled utterance."},"speaker_label":null,"page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"[Geetha dances. (When it is over)]","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u002","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Ha... ha...! Bravo, Geetha! Bravo! You wriggled like a worm and danced like a spotted peacock... Ayyo, ayyo... ayyo... Such an excess of abhinaya, such fluid facial play, movement and rhythm, bend and sway—splendid! Splendid!!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u003","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்மாள்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Appappa! What an evil eye, hmm!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u004","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"You must be very tired. Hey, who's there!... Will you have coffee?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u005","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Mm-mm.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u006","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Cool drink...?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u007","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Mm-mm...","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u008","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Girls these days jump four jumps and start panting for breath. In our days, once we started dancing, either a leg had to break or the stage had to break! Hee... hee... That's how we would dance, thambi!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u009","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Why, what's different now? Even without you dancing, the whole stage would fly to pieces!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u010","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Hmm... that's an old story. Whatever it is, thambi, my daughter is counting on you!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u011","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Let her; let her!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u012","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"It is your responsibility to make something of her.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u013","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"வேலைக்காரி","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"(Coming there) Some woman has come; she says she wants to see you.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u014","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Ah! A woman? Who is it?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u015","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Hmm, greetings! My name is Rani.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u016","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Who? What do you want?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u017","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"I heard you need a woman to sell tickets for your play.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u018","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Yes, yes. We do; we do. Sit down here!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u019","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Hmm, it's all right, sir; if you give me that job—","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u020","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Hmm, can you sing?","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u021","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"தாயம்","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"My daughter can dance too!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u022","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":12,"printed_page":11}]},"translation":{"english_text":"Oh! Now this has barged in like a bear into a Shiva puja.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u023","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d022","source_occurrence_id":null,"source_locator":null,"speaker_label":"கீதா","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Amma, you keep quiet!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u024","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d023","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"It's all right, Rani! The play is going to be tomorrow—and after that we're going to keep staging plays continuously! We're all 'amateurs'—don't expect a high salary.","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u025","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d024","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"What about salary, sir,","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u026","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d025","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Hmm, we'll see how well you sell tickets tomorrow and then set your pay,","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u027","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d026","source_occurrence_id":null,"source_locator":null,"speaker_label":"ராணி","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Many thanks, sir!","mode":"prose-faithful","notes":[]}},{"id":"raja-rani-en-s003-u028","kind":"dialogue","status":"verified","target_language":"en","scene_id":"raja-rani-s003","archival_scene_ordinal":3,"source":{"source_path":"works/raja-rani/dialogues/records/scene-003.json","canonical_scene_path":"works/raja-rani/scenes/scene-003.md","source_record_id":"raja-rani-s003-d027","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாபு","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Jai, jai!","mode":"prose-faithful","notes":[]}}]}