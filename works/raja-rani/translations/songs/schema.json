{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raja-rani-numbered-song-english-translation.schema.json",
  "title": "Raja Rani source-linked English numbered-song translation record",
  "type": "object",
  "required": [
    "id",
    "song_id",
    "numbered_song_number",
    "target_language",
    "status",
    "mode",
    "source",
    "translation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^raja-rani-song-en-[0-9]{3}$"
    },
    "song_id": {
      "type": "string",
      "pattern": "^raja-rani-song-[0-9]{3}$"
    },
    "numbered_song_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 11
    },
    "target_language": {
      "const": "en"
    },
    "status": {
      "enum": ["draft", "review", "verified"]
    },
    "mode": {
      "const": "semantic-poetic-source-faithful"
    },
    "source": {
      "type": "object",
      "required": [
        "tamil_song_file",
        "tamil_status",
        "pdf_pages",
        "printed_pages",
        "tamil_title",
        "authorship_status",
        "lyricist_ta",
        "authorship_evidence_basis",
        "performance_links"
      ],
      "properties": {
        "tamil_song_file": {"type": "string", "minLength": 1},
        "tamil_status": {"const": "verified"},
        "pdf_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 80}
        },
        "printed_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "tamil_title": {"type": "string", "minLength": 1},
        "authorship_status": {
          "enum": ["anthology-attributed", "unresolved"]
        },
        "lyricist_ta": {
          "type": ["string", "null"]
        },
        "authorship_evidence_basis": {"type": "string", "minLength": 1},
        "performance_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["occurrence_id", "status", "scene"],
            "properties": {
              "occurrence_id": {"type": "string", "pattern": "^raja-rani-song-perf-[0-9]{3}$"},
              "status": {"enum": ["verified", "review"]},
              "scene": {"type": "integer", "minimum": 1, "maximum": 58}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": ["english_title", "sections", "translator_notes"],
      "properties": {
        "english_title": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ordinal",
              "source_label",
              "english_label",
              "pdf_pages",
              "source_tamil_lines",
              "english_lines",
              "notes"
            ],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "source_label": {"type": ["string", "null"]},
              "english_label": {"type": ["string", "null"]},
              "pdf_pages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1, "maximum": 80}
              },
              "source_tamil_lines": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "english_lines": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "notes": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          }
        },
        "translator_notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
