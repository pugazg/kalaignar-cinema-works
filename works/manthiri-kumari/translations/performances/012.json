      {"ordinal": 1, "source_label": "மந்திரிகுமாரி", "english_label": "Manthirikumarī", "source_pdf_pages": [12], "source_tamil_lines": ["மனம்போல் வாழ்வு பெறுவோமே!", "இணைந்தே நேசமுடன் எந்நாளும்", "நாம்—மகிழ்வோம் மெய்யன்பாலே", "என்னுயிர் நாதன் குணமே—மாறி", "நேர்மையாகினார் புவிமேல்!"], "english_lines": ["Let us gain a life as our hearts desire!", "United in love, forever,", "We shall rejoice in true love;", "My beloved lord's nature has changed—", "He has become upright in this world!"], "notes": []},
      {"ordinal": 2, "source_label": "ராஜகுமாரி", "english_label": "Rajakumarī", "source_pdf_pages": [12], "source_tamil_lines": ["இந்த நாளுன் வாழ்வில் சுபதினமே!", "இன்பமே கொள்ளுவோம்! (மனம்)"], "english_lines": ["This day is an auspicious day in your life!", "Let us embrace happiness! (மனம்)"], "notes": []},
      {"ordinal": 3, "source_label": "மந்திரிகுமாரி", "english_label": "Manthirikumarī", "source_pdf_pages": [12], "source_tamil_lines": ["பெண் மனம் ஒன்றை நினைத்தால்—அதை", "திண்ணமாக செய்து முடிப்பாள்!"], "english_lines": ["If a woman's heart resolves upon one thing—", "She will surely bring it to completion!"], "notes": []},
      {"ordinal": 4, "source_label": "ராஜகுமாரி", "english_label": "Rajakumarī", "source_pdf_pages": [12], "source_tamil_lines": ["உயர் காதல் வாழ்வு......", "உயர் காதல் வாழ்வு பெறத்துடிப்பாள்!", "உண்மை சேர் அன்பினால் (மனம்)"], "english_lines": ["A lofty life of love......", "She yearns to attain a lofty life of love!", "Through love joined with truth. (மனம்)"], "notes": []}
