{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manthiri-kumari-performance-english-translation.schema.json",
  "title": "Manthiri Kumari source-linked English song/performance translation record",
  "type": "object",
  "required": ["id", "source_performance_id", "sequence", "heading_ta", "heading_en", "target_language", "status", "mode", "source", "translation"],
  "properties": {
    "id": {"type": "string", "pattern": "^manthiri-kumari-performance-en-(?:00[1-9]|01[0-5])$"},
    "source_performance_id": {"type": "string", "pattern": "^manthiri-kumari-performance-(?:00[1-9]|01[0-5])$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 15},
    "heading_ta": {"type": "string", "minLength": 1},
    "heading_en": {"type": "string", "minLength": 1},
    "target_language": {"const": "en"},
    "status": {"enum": ["draft", "review", "verified"]},
    "mode": {"const": "semantic-poetic-source-faithful"},
    "source": {
      "type": "object",
      "required": ["record_path", "tamil_status", "pdf_pages", "cross_witness_status", "anthology_record_id", "authorship_status"],
      "properties": {
        "record_path": {"type": "string", "minLength": 1},
        "tamil_status": {"const": "complete-verified"},
        "pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 6, "maximum": 13}},
        "cross_witness_status": {"enum": ["confirmed-existing-anthology-witness", "source-only-in-current-anthology"]},
        "anthology_record_id": {"type": ["string", "null"]},
        "authorship_status": {"const": "unresolved"}
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": ["sections", "translator_notes"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ordinal", "source_label", "english_label", "source_pdf_pages", "source_tamil_lines", "english_lines", "notes"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "source_label": {"type": ["string", "null"]},
              "english_label": {"type": ["string", "null"]},
              "source_pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 6, "maximum": 13}},
              "source_tamil_lines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "english_lines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "notes": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "translator_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}