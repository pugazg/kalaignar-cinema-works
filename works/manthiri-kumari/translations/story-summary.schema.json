{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manthiri-kumari-story-summary-english-translation.schema.json",
  "title": "Manthiri Kumari source-linked English story-summary translation record",
  "type": "object",
  "required": [
    "id",
    "source_record_id",
    "target_language",
    "status",
    "mode",
    "source",
    "translation"
  ],
  "properties": {
    "id": {
      "const": "manthiri-kumari-story-summary-en-001"
    },
    "source_record_id": {
      "const": "manthiri-kumari-story-summary-001"
    },
    "target_language": {
      "const": "en"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "verified"
      ]
    },
    "mode": {
      "const": "semantic-source-faithful-prose"
    },
    "source": {
      "type": "object",
      "required": [
        "record_path",
        "tamil_status",
        "pdf_pages",
        "title_ta"
      ],
      "properties": {
        "record_path": {
          "type": "string",
          "minLength": 1
        },
        "tamil_status": {
          "const": "complete-verified"
        },
        "pdf_pages": {
          "type": "array",
          "const": [
            3,
            4,
            5
          ]
        },
        "title_ta": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": [
        "english_title",
        "sections",
        "translator_notes"
      ],
      "properties": {
        "english_title": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ordinal",
              "source_pdf_pages",
              "printed_pages_observed",
              "source_tamil",
              "english",
              "notes"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "source_pdf_pages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 5
                }
              },
              "printed_pages_observed": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 4
                }
              },
              "source_tamil": {
                "type": "string",
                "minLength": 1
              },
              "english": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "translator_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}