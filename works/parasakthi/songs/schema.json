{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parasakthi-song-inventory-schema",
  "title": "Parasakthi song / verse inventory record",
  "description": "Source-led derivative for candidate song and verse blocks. Canonical Tamil remains authoritative; booklet-wide credits do not imply item-level authorship.",
  "type": "object",
  "required": [
    "id",
    "canonical_scene",
    "candidate_kind",
    "opening_line_ta",
    "pdf_pages",
    "printed_pages",
    "canonical_scene_file",
    "dialogue_index_overlap",
    "authorship"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^parasakthi-song-[0-9]{3}$"
    },
    "canonical_scene": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    },
    "candidate_kind": {
      "enum": [
        "unlabelled-song",
        "speaker-labelled-verse",
        "quoted-verse",
        "unlabelled-reprise"
      ]
    },
    "opening_line_ta": {
      "type": "string",
      "minLength": 1
    },
    "pdf_pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "printed_pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "canonical_scene_file": {
      "type": "string",
      "pattern": "^../scenes/scene-[0-9]{2}\\.md$"
    },
    "dialogue_index_overlap": {
      "type": "boolean"
    },
    "performance_context": {
      "type": "string"
    },
    "relation": {
      "type": ["object", "null"],
      "properties": {
        "type": {"enum": ["reprise-of"]},
        "target_id": {"type": "string", "pattern": "^parasakthi-song-[0-9]{3}$"}
      },
      "required": ["type", "target_id"],
      "additionalProperties": false
    },
    "authorship": {
      "type": "object",
      "required": ["status", "lyricist_ta", "evidence_basis", "evidence_reference", "notes"],
      "properties": {
        "status": {"enum": ["verified", "review", "unresolved"]},
        "lyricist_ta": {"type": ["string", "null"]},
        "evidence_basis": {
          "enum": [
            "canonical-context-explicit",
            "printed-item-credit",
            "external-source",
            "booklet-wide-credits-only",
            "none"
          ]
        },
        "evidence_reference": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
