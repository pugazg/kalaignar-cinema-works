{
  "work_id":"parasakthi","target_language":"en","canonical_scene":7,"scene_status":"review","unit_count":24,
  "units":[
    {"id":"parasakthi-en-s007-u001","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/scenes/scene-07.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Opening arrival direction."},"page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"(Gunasekaran arrives in Madras, gets off the ship, and sits in a car.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u002","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d001","speaker_label":"பிச்சை","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Sir...","mode":"prose-faithful","notes":["`சாமி` is rendered as the respectful address `Sir` in this begging context."]}},
    {"id":"parasakthi-en-s007-u003","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d002","speaker_label":"குண","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"All right, mother, go on! What a fine first voice to hear in Tamil Nadu!... (He gives alms.)","mode":"prose-faithful","notes":["The line's irony on hearing a beggar as the `first voice` of Tamil Nadu is retained rather than explained away."]}},
    {"id":"parasakthi-en-s007-u004","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d003","speaker_label":"மற்ற","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Sir... I have children to feed.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u005","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d004","speaker_label":"குண","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"(When he has finished giving.) Driver, drive on.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u006","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/scenes/scene-07.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Bank, street pursuit, hotel and Jolly-in-room montage direction."},"page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"(Gunasekaran drives to a bank. As he receives the money, a prostitute roaming the street sees it and follows him, poison in her heart. After collecting the money, he stays at a hotel. He asks the hotel manager to book a ticket, then returns to his room and enters. There—the young woman named Jolly, who followed him, is lying down. Seeing her, he...)","mode":"prose-faithful","notes":["The source's explicit term for the woman and its metaphor `நெஞ்சிலே நஞ்சுகொண்டு` are retained in meaning rather than softened."]}},
    {"id":"parasakthi-en-s007-u007","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d005","speaker_label":"குண","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Forgive me! I came into your room by mistake. All the rooms look alike, so I couldn't tell the difference!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u008","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d006","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"No problem! No problem. What's your room number?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u009","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d007","speaker_label":"குண","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Seven!—","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u010","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d008","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Seven... mine is number eight. I'm the one who mistook the next room. (She pretends she is about to leave immediately.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u011","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d009","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"No problem! No problem. (A boy brings coffee.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u012","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d010","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Have some coffee...","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u013","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d011","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Mm... no... thanks.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u014","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d012","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Come on, have some. (He offers it.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u015","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d013","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Mm... your... hometown?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u016","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d014","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"I have to go to Madurai!—I missed the train.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u017","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d015","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Same with me.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u018","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d016","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"I have to go to the cinema!... It's getting late.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u019","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d017","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"(With distaste.) Cinema? Ugh! I don't like it one bit.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u020","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d018","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Why?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u021","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d019","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"If an association were formed to shut it down, I'd be its president. Bharatanatyam dance is what suits our country. It would be so much better to go to that. I know a place with a good dance performance—come, let's go there.","mode":"prose-faithful","notes":["The source's English code-switches (`close`, `dance`) are rendered naturally without changing source metadata."]}},
    {"id":"parasakthi-en-s007-u022","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d020","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"(Surprised.) You too?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u023","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d021","speaker_label":"ஜாலி","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"Why think of me differently like that? If I were your younger sister, wouldn't you take me along? Don't think wrongly of me like this.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s007-u024","kind":"dialogue","status":"review","target_language":"en","canonical_scene":7,"source":{"source_path":"works/parasakthi/dialogues/records/scene-07.json","source_record_id":"parasakthi-s007-d022","speaker_label":"குண","page_provenance":[{"pdf_page":11,"printed_page":10}]},"translation":{"english_text":"All right, let's go.","mode":"prose-faithful","notes":[]}}
  ]
}