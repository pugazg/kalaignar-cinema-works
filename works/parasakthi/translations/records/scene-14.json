{
  "work_id":"parasakthi","target_language":"en","canonical_scene":14,"scene_status":"verified","unit_count":19,
  "units":[
    {"id":"parasakthi-en-s014-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/scenes/scene-14.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Kalyani makes a living by running an idli shop in Madurai."},"page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"(One day at Kalyani's home in Madurai, where she makes a living by running an idli shop—)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d001","speaker_label":"சாப்பிடுபவர்","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"As of today it's come to three rupees. I'll pay tomorrow.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u003","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/scenes/scene-14.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"The merchant who extended credit arrives."},"page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"(At this moment the merchant who gave her credit arrives.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d002","speaker_label":"வியாபாரி","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Hey, Kalyaniamma! Kalyaniamma, if you have no way to repay it, why do you borrow?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d003","speaker_label":"கல்","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Please wait two more days; as soon as the customers pay me, I'll pay you.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d004","speaker_label":"வியா","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"That won't do. (At this moment Venu arrives.)","mode":"prose-faithful","notes":["The Venu-arrival direction is embedded inside the immutable dialogue record and therefore remains inside this translation unit; no extra English endearment is added for the colloquial `ம்மா` ending."]}},
    {"id":"parasakthi-en-s014-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d005","speaker_label":"வேணு","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Hey! Who's that? Coming here and quarrelling with a woman who's alone? Can't you see a big man standing here?","mode":"prose-faithful","notes":["`பெரிய மனுஷன்` is kept as Venu's self-important `big man` rather than polished into a neutral `gentleman`."]}},
    {"id":"parasakthi-en-s014-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d006","speaker_label":"வியா","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Maaf karo ji, Maharaj.","mode":"prose-faithful","notes":["The source code-switched phrase `மாப்கரோஜ் மகராஜ்` is transliterated rather than replaced, because Venu's next line plays on its sound."]}},
    {"id":"parasakthi-en-s014-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d007","speaker_label":"வேணு","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Maaf karo—rubbish! 'Roj'—how much is due?","mode":"prose-faithful","notes":["Venu mocks and breaks apart the preceding code-switched phrase (`மாப்கரோஜ்—மண்ணாங்கட்டி. ரோஜ்—...`). `Roj` is retained as sound-play; `மண்ணாங்கட்டி` is rendered idiomatically as the dismissive `rubbish` rather than explained away."]}},
    {"id":"parasakthi-en-s014-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d008","speaker_label":"வியா","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Ten rupees.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d009","speaker_label":"வேணு","page_provenance":[{"pdf_page":17,"printed_page":16}]},"translation":{"english_text":"Here you are. (He takes out money and gives it.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d010","speaker_label":"கல்","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"Brother! You don't have to pay it.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d011","speaker_label":"வேணு","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"It's all right! Go and bring idlis!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u014","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/scenes/scene-14.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":3,"description":"Kalyani goes to bring idlis."},"page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"(Kalyani goes to bring idlis.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s014-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d012","speaker_label":"மைனர்","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"Is this how you come and make a scene with a woman who's alone, you shameless dogs!","mode":"prose-faithful","notes":["The source insult `வெட்கங்கெட்ட நாய்ங்க` is retained explicitly rather than softened."]}},
    {"id":"parasakthi-en-s014-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d013","speaker_label":"வேணு","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"Why, Kalyani, do you borrow from people like this who have no sense of propriety?","mode":"prose-faithful","notes":["`தரந்தெரியா தவங்க` is colloquial/socially evaluative; `people ... who have no sense of propriety` preserves Venu's disparaging tone without assigning a modern class label not explicit in the source."]}},
    {"id":"parasakthi-en-s014-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d014","speaker_label":"கல்","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"What can I do, brother? I have to make a living.","mode":"prose-faithful","notes":["`வயிறு வளர்க்கணுமே` is rendered as the subsistence idiom `make a living`."]}},
    {"id":"parasakthi-en-s014-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d015","speaker_label":"வேணு","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"Then do as I say—look, I've just paid ten rupees. Don't repay it in cash. Every morning give idlis to two people. I usually eat tiffin at night, so every night give me four annas' worth. Say that it will be deducted from these ten rupees. Later, as time goes on, once I see that you're trustworthy, I'll give you whatever money you need.","mode":"prose-faithful","notes":["`நாணயம்` is rendered contextually through `trustworthy`/creditworthiness, not as `coin`; the surrounding line concerns whether Venu can trust Kalyani with further money."]}},
    {"id":"parasakthi-en-s014-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":14,"source":{"source_path":"works/parasakthi/dialogues/records/scene-14.json","source_record_id":"parasakthi-s014-d016","speaker_label":"மைனர்","page_provenance":[{"pdf_page":18,"printed_page":17}]},"translation":{"english_text":"Yes! It's poor people like this that we ought to help.","mode":"prose-faithful","notes":[]}}
  ]
}