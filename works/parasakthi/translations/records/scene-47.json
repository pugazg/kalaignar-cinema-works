{"work_id":"parasakthi","target_language":"en","canonical_scene":47,"scene_status":"verified","unit_count":37,"units":[{"id":"parasakthi-en-s047-u001","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d001","speaker_label":"சந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Kalyani! Kalyani!"}},{"id":"parasakthi-en-s047-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d002","speaker_label":"கல்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":["Repeated `அண்ணு` is rendered as the elder-brother address in this family reunion context."],"english_text":"Brother! Brother, look at me?"}},{"id":"parasakthi-en-s047-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d003","speaker_label":"குண","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"What's wrong with elder brother, sister-in-law?"}},{"id":"parasakthi-en-s047-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d004","speaker_label":"சரஸ்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Here is your younger brother Gunasekaran, and your younger sister Kalyani!"}},{"id":"parasakthi-en-s047-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d005","speaker_label":"சந்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":["The verified source is deliberately broken and confused in Chandrasekaran's distressed speech; the English does not harmonize its pronouns or sequence."],"english_text":"No! He... her elder brother—time kicked him away; she fell into the river. No, her elder brother sentenced her to death."}},{"id":"parasakthi-en-s047-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d006","speaker_label":"குண","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Brother!"}},{"id":"parasakthi-en-s047-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d007","speaker_label":"சந்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"I am the one who wrote the judgment; what does it matter whether elder brother or younger brother? A crime is a crime."}},{"id":"parasakthi-en-s047-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d008","speaker_label":"சர","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Here, look—Kalyani's child."}},{"id":"parasakthi-en-s047-u009","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/scenes/scene-47.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Sekar's madness clears and they shed tears of joy."},"page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"(Sekar's madness clears; they shed tears of joy.)"}},{"id":"parasakthi-en-s047-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d009","speaker_label":"சரஸ்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Who is it?"}},{"id":"parasakthi-en-s047-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d010","speaker_label":"விம","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":["The address to Gnana Sekaran is embedded in the immutable record."],"english_text":"You stay here! I'll go and see. (To Gnana Sekaran.) What do you want?"}},{"id":"parasakthi-en-s047-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d011","speaker_label":"ஞான","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Amma, is sir here?"}},{"id":"parasakthi-en-s047-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d012","speaker_label":"விம","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Why?"}},{"id":"parasakthi-en-s047-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d013","speaker_label":"ஞான","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":["Vimala's laughter is embedded in the source record."],"english_text":"We are going to hold a beggars' conference, and we came to ask for funds. (Vimala laughs.) Why are you laughing, amma? It may look like that now! A little while longer and even a beggar will become a minister."}},{"id":"parasakthi-en-s047-u015","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/scenes/scene-47.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Through the house servant they learn that he is Gnana Sekaran; the scattered family rejoices."},"page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"(Through the house servant they learn that he is Gnana Sekaran. The scattered family rejoices.)"}},{"id":"parasakthi-en-s047-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d014","speaker_label":"விம","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Then I'll take leave..."}},{"id":"parasakthi-en-s047-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d015","speaker_label":"குண","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"After all these days?"}},{"id":"parasakthi-en-s047-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d016","speaker_label":"விம","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"They'll be looking for me at home!"}},{"id":"parasakthi-en-s047-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d017","speaker_label":"குண","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Then when am I to see you?"}},{"id":"parasakthi-en-s047-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d018","speaker_label":"விம","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"From now on, you won't be able to see me at all!"}},{"id":"parasakthi-en-s047-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d019","speaker_label":"குண","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Why?"}},{"id":"parasakthi-en-s047-u022","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d020","speaker_label":"விம","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"That's just how it is."}},{"id":"parasakthi-en-s047-u023","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d021","speaker_label":"குண","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":["The sari being stopped by the rope Gunasekaran tied is embedded in the immutable dialogue record."],"english_text":"All right, then go... (Vimala's sari is stopped by the rope Gunasekaran tied.)"}},{"id":"parasakthi-en-s047-u024","kind":"song","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/songs/tracks/05-pudhu-pennin-manathai.md","canonical_scene_path":"works/parasakthi/scenes/scene-47.md","source_record_id":null,"source_occurrence_id":"parasakthi-song-013","source_locator":null,"speaker_label":null,"page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"semantic-poetic","notes":["This is verified partial reprise occurrence `parasakthi-song-013`, distinct from the primary scene-33 occurrence `parasakthi-song-011`.","Only the four source lines printed in scene 47 are translated; no omitted stanza is imported.","The pressure-sensitive source `அந்த மார்பத்தை` retains the same close semantic treatment as the verified primary occurrence."],"english_lines":["You who touch the new bride's heart and go—","tell me your thought before you go.","You who stir this young heart and go—","tell me of that breast before you go."]}},{"id":"parasakthi-en-s047-u025","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d022","speaker_label":"சேகர்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"What is it, Gunasekaran?"}},{"id":"parasakthi-en-s047-u026","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d023","speaker_label":"சரஸ்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":["The small-cord/turmeric image is kept close rather than expanded into a ritual explanation."],"english_text":"Younger brother, you don't need such a big rope for this! A small cord... just enough to fit the neck is enough! On it, a little turmeric..."}},{"id":"parasakthi-en-s047-u027","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d024","speaker_label":"குண","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":["Kalyani's arrival is embedded in the immutable dialogue record."],"english_text":"All that isn't needed in these times, sister-in-law. Two garlands, one orator—the matter is finished. (At this moment Kalyani arrives.)"}},{"id":"parasakthi-en-s047-u028","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d025","speaker_label":"கல்","page_provenance":[{"pdf_page":56,"printed_page":55}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"That alone isn't enough. You have to give birth to a girl for my boy!"}},{"id":"parasakthi-en-s047-u029","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d026","speaker_label":"குண","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":["The line deliberately recalls earlier madness/begging material; the English retains the source's abrupt `மந்திரி ... டும்! டும்!` sequence rather than reconstructing a missing exchange."],"english_text":"Come... Amma! Will you give idlis for a quarter anna? Why are you laughing? Did you think I was mad? Minister, in our great city does rain fall thrice a month—dum! dum! (He reminds them of the past.)"}},{"id":"parasakthi-en-s047-u030","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d027","speaker_label":"ஞான","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"That's right! Is that so? You all stay here. I'll come back."}},{"id":"parasakthi-en-s047-u031","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d028","speaker_label":"சேகர்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Why, younger brother, where are you going?"}},{"id":"parasakthi-en-s047-u032","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d029","speaker_label":"ஞான","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":["`பரதேசி மடம்` is retained as `paradesi mutt` rather than given an external institutional definition."],"english_text":"You and I won't fit together. You've become used to bungalow and office. I've become used to the `paradesi mutt`, the shade of the banyan tree, things like that. I'll go there."}},{"id":"parasakthi-en-s047-u033","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d030","speaker_label":"கல்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Then I'll come too."}},{"id":"parasakthi-en-s047-u034","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d031","speaker_label":"குண","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":["The source ends with colloquial `அப்படின்னு`; the English keeps the departure sense without inventing a missing listener response."],"english_text":"Then I'm setting off too."}},{"id":"parasakthi-en-s047-u035","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d032","speaker_label":"விம","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":["`பரதேசிகள்` remains `paradesis` to preserve the source's repeated contrast with bungalow-dwellers."],"english_text":"Instead of everyone going to the `paradesi mutt`, it is better to invite all the `paradesis` to the bungalow."}},{"id":"parasakthi-en-s047-u036","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d033","speaker_label":"சேகர்","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Yes! That is the right idea. Gnana Sekaran, according to your principle, a bungalow-dweller should not become a `paradesi`; it is better to turn all the `paradesis` into bungalow-dwellers."}},{"id":"parasakthi-en-s047-u037","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":47,"source":{"source_path":"works/parasakthi/dialogues/records/scene-47.json","source_record_id":"parasakthi-s047-d034","speaker_label":"ஞான","page_provenance":[{"pdf_page":57,"printed_page":56}]},"translation":{"mode":"prose-faithful","notes":["The closing instruction that they sing without distinction is embedded in the immutable dialogue record and leads into scene 48's verified song occurrence."],"english_text":"Then I'll go and bring everyone. (They sing without distinction.)"}}]}