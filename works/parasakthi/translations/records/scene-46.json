{"work_id":"parasakthi","target_language":"en","canonical_scene":46,"scene_status":"verified","unit_count":4,"units":[{"id":"parasakthi-en-s046-u001","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":46,"source":{"source_path":"works/parasakthi/dialogues/records/scene-46.json","source_record_id":"parasakthi-s046-d001","speaker_label":"ஞான","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Sir! We are going to hold a beggars' conference. Could you give some donation for it?"}},{"id":"parasakthi-en-s046-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":46,"source":{"source_path":"works/parasakthi/dialogues/records/scene-46.json","source_record_id":"parasakthi-s046-d002","speaker_label":"வீட்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Why, man, don't you have any work?"}},{"id":"parasakthi-en-s046-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":46,"source":{"source_path":"works/parasakthi/dialogues/records/scene-46.json","source_record_id":"parasakthi-s046-d003","speaker_label":"ஞான","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":["The reply preserves the source joke on having no work / holding the conference because there is no work."],"english_text":"It is because we have no work that we're holding it."}},{"id":"parasakthi-en-s046-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":46,"source":{"source_path":"works/parasakthi/dialogues/records/scene-46.json","source_record_id":"parasakthi-s046-d004","speaker_label":"வீட்","page_provenance":[{"pdf_page":55,"printed_page":54}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"If we give donations to all of you, we'll have to come along with you too. Go, go..."}}]}