{
  "work_id":"parasakthi","target_language":"en","canonical_scene":21,"scene_status":"verified","unit_count":44,
  "units":[
    {"id":"parasakthi-en-s021-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/scenes/scene-21.md","source_locator":{"kind":"scene-bracketed-stage-block","ordinal":1,"description":"Venu, driven by lust, knocks at Kalyani's door with predatory intent."},"page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"[Venu, a black cobra seized by lust, knocks at Kalyani's door intending to taste the fruit that is Kalyani.]","mode":"prose-faithful","notes":["The source itself uses the predatory metaphors `கருநாகம்` (black cobra) and `கனி` (fruit); the English retains them rather than neutralizing the stage direction."]}},
    {"id":"parasakthi-en-s021-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d001","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Kalyani!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d002","speaker_label":"கல்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"[On opening the door.] Why, brother, so late? From now on, come earlier.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d003","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"I've come at just the time I should, haven't I? Why, Kalyani, how was business today?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d004","speaker_label":"கல்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Same as always today too.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d005","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Mm... there are idlis, aren't there?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d006","speaker_label":"கல்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Wait, brother! I'll bring them.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d007","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Why, Kalyani! At a time when rice is hard to get, instead of making them entirely with rice like this, what if you mixed in a little wheat—","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d008","speaker_label":"கல்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"We can, but the taste will be spoiled.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d009","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Anything is better as two than alone. If the wheat joins in too, the profit will be greater, won't it!","mode":"prose-faithful","notes":["Venu's shift from food adulteration to `two rather than alone` carries an insinuating double meaning; the English keeps the source wording broad enough for that turn."]}},
    {"id":"parasakthi-en-s021-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d010","speaker_label":"கல்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Can we do wrong for profit, brother?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d011","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Why do you say 'brother' thirty-two times with every breath?","mode":"prose-faithful","notes":["`மூச்சிக்கு முப்பத்திரண்டு` is a comic hyperbole; the second-pass English keeps `thirty-two` while making the repeated-address construction explicit rather than saying she `puts` brothers into a breath."]}},
    {"id":"parasakthi-en-s021-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d012","speaker_label":"கல்","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"Brother! I have three elder brothers. I became a sinner not blessed to see even one of them! Out of longing, at least I call you brother, brother...","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d013","speaker_label":"வேணு","page_provenance":[{"pdf_page":26,"printed_page":25}]},"translation":{"english_text":"You fool, if the longing is so great, is calling me 'brother, brother' the answer?","mode":"prose-faithful","notes":["Venu deliberately twists Kalyani's familial `ஆசை`/longing into his sexualized line of talk; the English does not resolve the word into a single modern sense."]}},
    {"id":"parasakthi-en-s021-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d014","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Brother! There's something improper in your talk, isn't there?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d015","speaker_label":"வேணு","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"That is a way of showing desire, Kalyani!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d016","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Brother, speaking like this to women who are alone—","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d017","speaker_label":"வேணு","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Yes! A tender vine shouldn't be alone—that's why I'm here as a jackfruit tree fit for it to climb. Call me 'mama'! What a charming word! Call me 'athan'! What a substantial word.","mode":"prose-faithful","notes":["The source switches among kinship terms `அண்ணா`, `மாமா`, and `அத்தான்` as part of Venu's insinuation. `mama` and `athan` are retained transliterated so the kinship-wordplay is not falsely mapped to one English family relation.","The source form `மாழி` is left untouched in Tamil; the English reads the phrase contextually as referring to the word/expression."]}},
    {"id":"parasakthi-en-s021-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d018","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Stop! I can't bear any more.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d019","speaker_label":"வேணு","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"What life is there here! It's the same for me too—just say yes. Where there is a thatched hut, I'll build you an upper storey. Kalyani who slept on a ragged mat will sleep on a golden-jewelled bed.","mode":"prose-faithful","notes":["The opening `இங்கே என்ன வாழுதாம்! தானும் அப்படித்தான்` is compressed/colloquial; the English remains conservative rather than supplying a more specific proposition."]}},
    {"id":"parasakthi-en-s021-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d020","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Chi! Don't come near me! How many of you have set out like this thinking women suffering in poverty will fall if you cast a deceitful net?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u022","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d021","speaker_label":"வேணு","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Lamentation on a battlefield! Wailing in a field of pleasure—those are the acts of cowards, my delicate lady.","mode":"prose-faithful","notes":["The source contrasts `போர்க்களம்` with `போகக் களம்`; `field of pleasure` keeps the sexualized rhetorical contrast without adding a new metaphor."]}},
    {"id":"parasakthi-en-s021-u023","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d022","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"If you try to touch me, I'll shout.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u024","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d023","speaker_label":"வேணு","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Shout! Let your shout be music to me.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u025","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/scenes/scene-21.md","source_locator":{"kind":"scene-bracketed-stage-block","ordinal":2,"description":"Venu embraces Kalyani and attempts to kiss her; Gunasekaran arrives."},"page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"[Saying this, the lust-mad scoundrel Venu embraces Kalyani and is about to taste her red lips. At this moment Gunasekaran arrives...]","mode":"prose-faithful","notes":["The source uses `செவ்விதழைச் சுவைக்க` (`taste her red lips`) and explicitly characterizes Venu as lust-driven; the English preserves that source framing without adding action beyond the attempted assault."]}},
    {"id":"parasakthi-en-s021-u026","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d024","speaker_label":"குண","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"No need for courtesy, da, brother-in-law! [He beats Venu and drives him away.]","mode":"prose-faithful","notes":["`மைத்துனு` is retained as the taunting kinship address `brother-in-law`; the beating direction is embedded in the immutable dialogue record."]}},
    {"id":"parasakthi-en-s021-u027","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d025","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"If you hadn't come, what would have happened to me! Crazy brother, how did you come here?","mode":"prose-faithful","notes":["`கிறுக்கண்ணா` is Kalyani's address to the apparently mad Gunasekaran; `crazy brother` preserves both the madness label and `அண்ணா` kinship address."]}},
    {"id":"parasakthi-en-s021-u028","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d026","speaker_label":"குண","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Just to see you.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u029","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d027","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Crazy brother, what have you been doing under that tree for ten days?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u030","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d028","speaker_label":"குண","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Running a kingdom.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u031","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d029","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Crazy brother, I'll give you idlis. Will you eat?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u032","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d030","speaker_label":"குண","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Mm... you'll ask me for money.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u033","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d031","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"No money needed.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u034","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d032","speaker_label":"குண","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"If I tell you who I am, you won't ask for money at all.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u035","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d033","speaker_label":"கல்","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"Who are you?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u036","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d034","speaker_label":"குண","page_provenance":[{"pdf_page":27,"printed_page":26}]},"translation":{"english_text":"I... I am the Maharaja under the tree!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u037","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d035","speaker_label":"கல்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"I'll bring idlis.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u038","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d036","speaker_label":"குண","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"No... no, amma... I don't want idlis, amma... I want chutney, amma...","mode":"prose-faithful","notes":["The repeated `-ம்மா` is a feminine vocative here; the second-pass English retains it transparently as `amma` instead of the misleading literal kinship `mother`."]}},
    {"id":"parasakthi-en-s021-u039","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d037","speaker_label":"கல்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"All right, I'll bring both. (She goes.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u040","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/scenes/scene-21.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Gunasekaran goes behind and kisses the child sleeping in the cradle; tears fill his eyes."},"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"(Gunasekaran goes around to the back and kisses his 'son-in-law', who is asleep in the cradle. There are tears in his eyes.)","mode":"prose-faithful","notes":["The source calls the child `தன் மாப்பிள்ளை`; the English retains `son-in-law` in quotation marks rather than silently replacing the source kinship joke/usage."]}},
    {"id":"parasakthi-en-s021-u041","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d038","speaker_label":"கல்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"(With the idlis.) Why are you crying, crazy brother?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u042","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d039","speaker_label":"குண","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Mm...... all the subjects in my kingdom are happy... and among them, I am crying.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u043","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/scenes/scene-21.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Gunasekaran drops the rupee in his hand onto the idli plate and leaves."},"page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"(Saying this, he drops the rupee in his hand onto the idli plate and leaves.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s021-u044","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":21,"source":{"source_path":"works/parasakthi/dialogues/records/scene-21.json","source_record_id":"parasakthi-s021-d040","speaker_label":"கல்","page_provenance":[{"pdf_page":28,"printed_page":27}]},"translation":{"english_text":"Crazy brother! Crazy brother!","mode":"prose-faithful","notes":["The source uses `!` rather than the usual colon after the explicit label `கல்`; the immutable dialogue record preserves that anomaly and the translation keeps the exact label metadata."]}}
  ]
}