  "units":[
    {"id":"parasakthi-en-s010-u001","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/scenes/scene-10.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Opening Japanese bombing direction."},"page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"(Chandrasekaran, his wife Saraswathi, and his younger brother Gnanasekaran are caught in bombs dropped by Japanese aircraft while on their way.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s010-u002","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/scenes/scene-10.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Chandrasekaran and Saraswathi in hospital."},"page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"(Chandrasekaran and Saraswathi are in the hospital.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s010-u003","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d001","speaker_label":"சந்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Doctor, sir... which bed is Gnanasekaran in?","mode":"prose-faithful","notes":["The source form `பெட்டிலே` is understood contextually as hospital `bed`; the Tamil remains unchanged."]}},
    {"id":"parasakthi-en-s010-u004","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d002","speaker_label":"டாக்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Gnanasekaran? There's no one by that name here.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s010-u005","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d003","speaker_label":"சந்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Ah! Then where could he be?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s010-u006","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d004","speaker_label":"டாக்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"These are the only people left from that bombing. Everyone else is dead.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s010-u007","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d005","speaker_label":"சந்","page_provenance":[{"pdf_page":13,"printed_page":12}]},"translation":{"english_text":"Ah! Gnanasekara! Have you died? When Saraswathi goes home and Father asks, 'Where is Gnanasekaran?'—what answer will I give Kalyani?","mode":"prose-faithful","notes":["The source specifically says `சரஸ்வதி ஊருக்குப் போனவுடன்`; the English preserves Saraswathi as the grammatical subject rather than broadening it to `when we go home`."]}},
    {"id":"parasakthi-en-s010-u008","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d006","speaker_label":"சரஸ்","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Doctor! Please say something to him.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s010-u009","kind":"dialogue","status":"review","target_language":"en","canonical_scene":10,"source":{"source_path":"works/parasakthi/dialogues/records/scene-10.json","source_record_id":"parasakthi-s010-d007","speaker_label":"டாக்","page_provenance":[{"pdf_page":14,"printed_page":13}]},"translation":{"english_text":"Mr Chandrasekaran, don't agitate your mind. Stay calm.","mode":"prose-faithful","notes":[]}}
  ]
}