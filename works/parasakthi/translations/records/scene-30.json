{"work_id":"parasakthi","target_language":"en","canonical_scene":30,"scene_status":"review","unit_count":28,"units":[{"id":"parasakthi-en-s030-u001","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/scenes/scene-30.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Narayana Pillai and Karuppan are on their way back from the temple."},"page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"(Narayana Pillai and Karuppan are on their way back from the temple.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u002","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d001","speaker_label":"பிச்சை","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Sir! At least give me one of those coconut halves! (Karuppan gives one.)","mode":"prose-faithful","notes":["`தேங்காய் முடி` is provisionally rendered `coconut half`; the embedded giving action belongs to the immutable dialogue record."]}},{"id":"parasakthi-en-s030-u003","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d002","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hey, you arrogant fellow! Why did you give away the coconut?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u004","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d003","speaker_label":"கருப்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"At the temple sermon they said, 'Charity protects one's head.'","mode":"prose-faithful","notes":["The proverb-like `தர்மம் தலைகாக்கும்` is kept close to its literal image rather than replaced with a modern moral maxim."]}},{"id":"parasakthi-en-s030-u005","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d004","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Did they say that at the temple for you and me? That's money, man! Give it here. (He asks for it back.)","mode":"prose-faithful","notes":["The source abruptly invokes `பணம்`; the English preserves that turn rather than supplying an explanation."]}},{"id":"parasakthi-en-s030-u006","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d005","speaker_label":"பிச்","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"We're poor, master!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u007","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d006","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Poor... funeral! (He strikes him.) Hey—dog! You want prasad? (At this moment Gunasekaran arrives.)","mode":"prose-faithful","notes":["The source `ஏழை...ஏழவு` appears to pivot through a sound-play/abusive turn; `funeral` is provisional and should be checked in second pass without altering Tamil."]}},{"id":"parasakthi-en-s030-u008","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d007","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Who are you?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u009","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d008","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Feels like I've seen you somewhere.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u010","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d009","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"You would have, you would have.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u011","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d010","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"You... you...","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u012","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d011","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"General Merchant Narayana Pillai.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u013","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d012","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"I... chairma...","mode":"prose-faithful","notes":["The fragment `நானு சேர்மையா...` is preserved as an unfinished, pressure-sensitive utterance; the English does not complete the syntax."]}},{"id":"parasakthi-en-s030-u014","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d013","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"A servant?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u015","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d014","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"You...","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u016","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d015","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"The chairman wants to see me?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u017","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d016","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Yes! Yes! He too, from you...","mode":"prose-faithful","notes":["The source utterance is fragmentary (`அவருகூட உங்ககிட்டே`); the English remains fragmentary rather than repairing the sentence."]}},{"id":"parasakthi-en-s030-u018","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d017","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Wants sugar? He needs it by the sackful, doesn't he? Come by our house in the evening; I'll give it secretly.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u019","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d018","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"You'll give it in black?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u020","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d019","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Hey, what are you?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u021","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d020","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Then... shall I come in the evening? You'll give it in black?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u022","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d021","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Come... come.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u023","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d022","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Then; may I go now?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u024","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/scenes/scene-30.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Gunasekaran strikes Narayana Pillai."},"page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"(Gunasekaran strikes Narayana Pillai.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u025","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d023","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"What is this, man?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s030-u026","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d024","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"This is a beating, man! Hey dog, you want coconut? You want prasad meant for the poor? Give it here!","mode":"prose-faithful","notes":["Gunasekaran echoes Narayana Pillai's earlier abusive phrasing; the English keeps the repetition visible."]}},{"id":"parasakthi-en-s030-u027","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d025","speaker_label":"நாரா","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"Parasakthi! These street fellows have come to the point of beating you today.","mode":"prose-faithful","notes":["`ஒட்டப்பசங்க` is colloquial and pressure-sensitive; `street fellows` is provisional rather than a source normalization."]}},{"id":"parasakthi-en-s030-u028","kind":"dialogue","status":"review","target_language":"en","canonical_scene":30,"source":{"source_path":"works/parasakthi/dialogues/records/scene-30.json","source_record_id":"parasakthi-s030-d026","speaker_label":"குண","page_provenance":[{"pdf_page":36,"printed_page":35}]},"translation":{"english_text":"If the poor, who have been the ones running, become the ones who kick, then in a moment those who run and those who stand high will all change and become equals—understand that! You'll give it in black? Here, take one in black... (Gunasekaran kicks Narayana Pillai and knocks him down.)","mode":"prose-faithful","notes":["The source builds a rhyming political word-chain `ஓடப்பர் / உதையப்பர் / உயரப்பர் / ஒப்பப்பர்`. The English preserves the semantic progression—running, kicking, high, equal—but cannot reproduce the full sound pattern.","The final `ப்ளாக்கிலே` repetition is retained literally as `in black`; the translation does not invent a different pun."]}}]}