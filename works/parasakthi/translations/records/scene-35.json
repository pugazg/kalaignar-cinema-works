{"work_id":"parasakthi","target_language":"en","canonical_scene":35,"scene_status":"review","unit_count":11,"units":[{"id":"parasakthi-en-s035-u001","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/scenes/scene-35.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Location: refugee camp."},"page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"(Location: refugee camp.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s035-u002","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d001","speaker_label":"கல்","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Annu, I hear all the refugees have come from Rangoon!","mode":"prose-faithful","notes":["`அண்ணு` is retained as `Annu` rather than assigned a specific English kinship value."]}},{"id":"parasakthi-en-s035-u003","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d002","speaker_label":"ஆபீ","page_provenance":[{"pdf_page":42,"printed_page":41}]},"translation":{"english_text":"Yes. Who do you want?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s035-u004","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d003","speaker_label":"கல்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Chandrasekaran, Gnana Sekaran, Guna Sekaran.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s035-u005","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d004","speaker_label":"ஆபீ","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"There is no one by those names! There's a group under that banyan tree—go and inquire there.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s035-u006","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d005","speaker_label":"கல்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Annu, you all came from Burma, didn't you?","mode":"prose-faithful","notes":["The repeated `அண்ணு` address is retained as `Annu` pending second-pass contextual review."]}},{"id":"parasakthi-en-s035-u007","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d006","speaker_label":"ஒரு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Yes, amma. We came as refugees and turned into mendicants!","mode":"prose-faithful","notes":["`ஆண்டிகள்` is rendered as `mendicants`, preserving the descent from refugee status without importing a modern institutional category."]}},{"id":"parasakthi-en-s035-u008","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d007","speaker_label":"கல்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Did you know my elder brothers in Rangoon?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s035-u009","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d008","speaker_label":"மற்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"`Oorum.` What are their names?","mode":"prose-faithful","notes":["The verified source begins with the pressure-sensitive form `ஊரும்.`. The first-pass English transliterates it rather than silently correcting or guessing its function."]}},{"id":"parasakthi-en-s035-u010","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d009","speaker_label":"கல்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"Chandrasekaran... Gnana Sekaran... Guna Sekaran...","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s035-u011","kind":"dialogue","status":"review","target_language":"en","canonical_scene":35,"source":{"source_path":"works/parasakthi/dialogues/records/scene-35.json","source_record_id":"parasakthi-s035-d010","speaker_label":"ஒரு","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"english_text":"This is our whole group—only this many people. Look and see whether your brothers are among them. (Kalyani looks; they are not.)","mode":"prose-faithful","notes":["The embedded action belongs to the immutable dialogue record and remains within the same translation unit."]}}]}