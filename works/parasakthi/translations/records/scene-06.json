{
  "work_id":"parasakthi","target_language":"en","canonical_scene":6,"scene_status":"verified","unit_count":22,
  "units":[
    {"id":"parasakthi-en-s006-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/scenes/scene-06.md","source_locator":{"kind":"scene-bracketed-direction","ordinal":1,"description":"Opening location/character marker."},"page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"[In Madurai, Kalyani and her husband Thangappan]","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d001","speaker_label":"தங்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Kalyani!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d002","speaker_label":"கல்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Coming!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d003","speaker_label":"தங்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Mm... hurry up and get going.","mode":"prose-faithful","notes":["`புறப்படு சீக்கிரம்` is kept as a singular imperative; the earlier review wording `let's leave` added a first-person plural not present in the source."]}},
    {"id":"parasakthi-en-s006-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d004","speaker_label":"கல்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Why are you in such a rush? (As she comes out dressed, looking at her father.) Father, we're going out. We'll be back.......","mode":"prose-faithful","notes":["`ஏன் பறக்கிறீங்க` is rendered idiomatically as `why are you in such a rush`; the embedded source direction remains inside the dialogue unit."]}},
    {"id":"parasakthi-en-s006-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d005","speaker_label":"மாணிக்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"All right, dear. Go carefully and come back safely.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u007","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/scenes/scene-06.md","source_locator":{"kind":"scene-bracketed-direction","ordinal":2,"description":"Parvathi from the house opposite arrives."},"page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"[At this moment Parvathi from the house opposite arrives.]","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d006","speaker_label":"பார்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Kalyani...","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d007","speaker_label":"கல்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Come in, sister.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d008","speaker_label":"பார்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"I've come at just the right time... Where are you off to?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d009","speaker_label":"மாணி","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Nothing much. They're going to film a story written by the son-in-law, it seems.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d010","speaker_label":"தங்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Yes! For a long time Kalyani has been pestering me, saying she wants to watch a film being shot.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d011","speaker_label":"பார்","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"Of course she has to go. But does it look right for a woman in her condition to be going out like this at all hours?","mode":"prose-faithful","notes":["`முழுகாதிருக்கிற பெண்ணு` is a period/euphemistic reference to Kalyani's pregnancy; the English renders the contextual meaning as `a woman in her condition` rather than introducing a medical phrase absent from the source."]}},
    {"id":"parasakthi-en-s006-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d012","speaker_label":"மாணி","page_provenance":[{"pdf_page":9,"printed_page":8}]},"translation":{"english_text":"It is wrong, but the child is eager to go. Let her go and come back.","mode":"prose-faithful","notes":["`குழந்தை` is retained semantically as an affectionate reference to Kalyani, not interpreted as the unborn child."]}},
    {"id":"parasakthi-en-s006-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d013","speaker_label":"கல்","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"It's only for today, sister!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d014","speaker_label":"பார்","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Mm... go, dear, go! Son-in-law, keep listening to everything—just as you said! Once the boy comes, we'll have to rein her in.","mode":"prose-faithful","notes":["The source wording `மாப்புள்ளே நீ சொன்ன படியெல்லாம் கேட்டிரு` is colloquial/elliptical; the English deliberately does not supply the earlier review's unstated object `she`.","The final colloquial joke `பையன் வந்துல்ல அடக்கணும்` is rendered conservatively in its immediate pregnancy context."]}},
    {"id":"parasakthi-en-s006-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d015","speaker_label":"கல்","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Oh, go on, sister.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d016","speaker_label":"மாணி","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Have you already decided it'll be a boy?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d017","speaker_label":"பார்","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Whether I decide it or not, those two have apparently already decided—to name a boy Panneerselvam...","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d018","speaker_label":"தங்","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"Not only that. If it's a girl, we've decided to name her Nagamma.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u021","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/scenes/scene-06.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Kalyani and Thangappan depart."},"page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"(They leave.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s006-u022","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":6,"source":{"source_path":"works/parasakthi/dialogues/records/scene-06.json","source_record_id":"parasakthi-s006-d019","speaker_label":"மணி","page_provenance":[{"pdf_page":10,"printed_page":9}]},"translation":{"english_text":"My daughter is clever indeed. If only my sons were here to see this happiness...","mode":"prose-faithful","notes":[]}}
  ]
}