{"work_id":"parasakthi","target_language":"en","canonical_scene":31,"scene_status":"review","unit_count":15,"units":[{"id":"parasakthi-en-s031-u001","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/scenes/scene-31.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Gunasekaran washes his hands in the river."},"page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"(Gunasekaran, washing his hands in the river.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u002","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d001","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Kalyani, at least I steal, deceive and threaten people and manage to eat. What hardships are you and your child going through to satisfy your hunger?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u003","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/scenes/scene-31.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Vimala, who has got down from a boat on the river, catches hold of Gunasekaran."},"page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"(At that moment Vimala, who has got down from a boat on the river, catches hold of Gunasekaran.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u004","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d002","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"I'm not a thief! I'm not a thief!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u005","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d003","speaker_label":"விம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"You're no thief at all. I didn't think that. You're taking what your hunger needs and going. If you'd only asked me, I would have given it. If you'd received it and gone, you could simply have walked away.","mode":"prose-faithful","notes":["The last sentence preserves the source contrast between receiving the food and being able to leave by walking, rather than adding an explicit explanation about his earlier flight."]}},{"id":"parasakthi-en-s031-u006","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d004","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"I thought you'd be just like everyone else.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u007","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d005","speaker_label":"விம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Is that why you sang, 'Don't look for rationalists'?","mode":"prose-faithful","notes":["This line explicitly refers back to the pressure-sensitive wording of the scene-26 song; the English does not use it to alter that earlier Tamil occurrence."]}},{"id":"parasakthi-en-s031-u008","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d006","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Yes. It is wrong to call merciless people rationalists.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u009","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d007","speaker_label":"விம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Hey, you're quite a clever fellow... who are you?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u010","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d008","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"What am I, the Collector of this town? If you happen to ask, my story itself is a long one.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u011","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d009","speaker_label":"விம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"I like stories very much. Tell me.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u012","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d010","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"You won't be able to enjoy even an atom's worth of this story.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u013","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d011","speaker_label":"விம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"You're only whetting my curiosity more! You absolutely must tell me. Come home.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u014","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d012","speaker_label":"குண","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Home?!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s031-u015","kind":"dialogue","status":"review","target_language":"en","canonical_scene":31,"source":{"source_path":"works/parasakthi/dialogues/records/scene-31.json","source_record_id":"parasakthi-s031-d013","speaker_label":"விம","page_provenance":[{"pdf_page":37,"printed_page":36}]},"translation":{"english_text":"Just come. Don't be afraid. (She takes him along.)","mode":"prose-faithful","notes":["The embedded action is part of the immutable dialogue record and is retained inside the same translation unit."]}}]}