{"work_id":"parasakthi","target_language":"en","canonical_scene":28,"scene_status":"verified","unit_count":55,"units":[{"id":"parasakthi-en-s028-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/scenes/scene-28.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Black-marketeer Narayana Pillai, described as a tiger in cow's hide, begins his deceitful drama."},"page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"(Black-marketeer Narayana Pillai—a tiger wrapped in a cow's hide—begins his `kuzhuchiyana` deceitful drama.)","mode":"prose-faithful","notes":["The source metaphor `பசுத் தோல் போர்த்திய புலி` is retained literally. The verified source adjective `குழுச்சியான` remains semantically opaque, so the second pass transliterates it rather than silently assigning a specific meaning."]}},{"id":"parasakthi-en-s028-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d001","speaker_label":"காந்தா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Why so many books?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d002","speaker_label":"நாரா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"They're all for that C.I.D. scholar. He has read everything from the Kanda Puranam in our house to the Sri Valli cinema songbook. Now all sorts of things have come out—Kudumba Vilakku, Pandiyan Parisu, Rangoon Radha, Ilatchiya Varalaru—all of it came to fifty rupees... Mm, Kalyani... Kanta—I forgot to tell you. A new film was released today. Its name is Krishna Leela—","mode":"prose-faithful","notes":["Book and film titles are retained in transliteration rather than normalized to later English titles."]}},{"id":"parasakthi-en-s028-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d003","speaker_label":"காந்","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Come, let's go to the second show.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d004","speaker_label":"நாரா","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"I already saw it at the matinee. You go and see it.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d005","speaker_label":"காந்","page_provenance":[{"pdf_page":32,"printed_page":31}]},"translation":{"english_text":"Why should I go?","mode":"prose-faithful","notes":["The verified source form `நானக்குப் போறேன்` is colloquial/opaque; the English keeps the context-based reading without changing Tamil."]}},{"id":"parasakthi-en-s028-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d006","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Oh, go. I wouldn't say it without a reason. The love scene in it is terrific. I saw it—will you go and come back?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d007","speaker_label":"காந்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"All right, I'll go and come back.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d008","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Hmm—go. Hey, Karuppa, go with madam and come back—","mode":"prose-faithful","notes":["`அம்மா` here is a household address for Kanta; `madam` avoids a misleading literal `mother`."]}},{"id":"parasakthi-en-s028-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d009","speaker_label":"கருப்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Sir, shall I come too?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d010","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Get lost, fool!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u012","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/scenes/scene-28.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Kanta and Karuppan go to the cinema."},"page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"(Kanta and Karuppan go to the cinema.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d011","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"[To himself.] Ah, Saturn is finally gone. O helper in distress! Father! Show me a little mercy in the matter of Kalyani. You have done all sorts of things for all sorts of people! Kalyani! Kalyani!","mode":"prose-faithful","notes":["`சனியன்` retains the source's Saturn/nuisance image. `ஆபத்பாந்தவா` is rendered conservatively as `helper in distress` rather than expanded into a stronger theological claim."]}},{"id":"parasakthi-en-s028-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d012","speaker_label":"கல்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"What is it, master?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d013","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Kanta has gone off to the cinema on her own. Bring me that water vessel. Second show... mud-clod—she'll come only at twelve. From now on I'll have to call only you whenever something has to be fetched—can you read?","mode":"prose-faithful","notes":["`தண்ணுடையைக்` is rendered contextually as `water vessel`; `மண்ணுங்கட்டி` is retained as the contemptuous aside `mud-clod` rather than omitted."]}},{"id":"parasakthi-en-s028-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d014","speaker_label":"கல்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"I can.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d015","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Bravo, bravo! Then read all these books!","mode":"prose-faithful","notes":["The second pass renders the period exclamation `பலே, பலே` by function while preserving its repetition."]}},{"id":"parasakthi-en-s028-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d016","speaker_label":"கல்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"All right, master—.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d017","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"“A Widow's Love.”","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d018","speaker_label":"கல்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Ah!... [She is startled.]","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d019","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"There's a book like that. Look, some Bharathidasan too has said something about a widow.","mode":"prose-faithful","notes":["The dismissive `யாரோ பாரதிதாசனும்` is retained as character speech, not treated as an archival judgment."]}},{"id":"parasakthi-en-s028-u022","kind":"quoted-verse","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/songs/quoted-verses/001-vidhavayin-kaadhal.md","canonical_scene_path":"works/parasakthi/scenes/scene-28.md","source_record_id":null,"source_occurrence_id":"parasakthi-song-009","source_locator":null,"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_lines":["Here it lies with no one asking for it, brother—","a jackfruit ripened at the root.","Even a widow, it seems, has love.","Have you ever seen bees that do not sing,","a breeze that does not wander,","or a sound stomach that never hungers?"],"mode":"semantic-poetic","notes":["This is the verified literary quotation `parasakthi-song-009`, explicitly introduced in the source as Bharathidasan; it is not a soundtrack song."]}},{"id":"parasakthi-en-s028-u023","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d020","speaker_label":"கல்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"All right, master. I'm getting sleepy.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u024","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d021","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"I'm not sleepy, though. Kalyani, do you want an unexpected kiss?","mode":"prose-faithful","notes":["`எதிர்பாராத முத்தம்` functions as another suggestive book-title phrase in the surrounding dialogue; the English preserves the literal wording."]}},{"id":"parasakthi-en-s028-u025","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d022","speaker_label":"கல்","page_provenance":[{"pdf_page":33,"printed_page":32}]},"translation":{"english_text":"Ah! [She is startled.]","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u026","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d023","speaker_label":"நாரா","page_provenance":[{"pdf_page":33,"printed_page":32},{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"That's a book too. All sorts of things have come out. I'm looking at them just like this. All this travelling by train and car has left my whole body aching, Kalyani. Will you massage my body a little?","english_page_segments":[{"pdf_page":33,"printed_page":32,"english_text":"That's a book too. All sorts of things have come out. I'm looking at them just like this."},{"pdf_page":34,"printed_page":33,"english_text":"All this travelling by train and car has left my whole body aching, Kalyani. Will you massage my body a little?"}],"mode":"prose-faithful","notes":["This immutable dialogue record crosses PDF 33→34 and remains one English unit."]}},{"id":"parasakthi-en-s028-u027","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d024","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"(She sheds tears.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u028","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d025","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Foolish girl! Why, Kalyani! Oh, none of that, amma. Just bring me that pillow.","mode":"prose-faithful","notes":["The feminine vocative ending in `வேண்டாம்மா` is retained as `amma`, not translated as literal kinship `mother`."]}},{"id":"parasakthi-en-s028-u029","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/scenes/scene-28.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":3,"description":"As Kalyani brings the pillow, Narayana Pillai lustfully grabs her hand and pulls her."},"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"(As she brings it, he lustfully grabs Kalyani's hand and pulls her.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u030","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d026","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Master, this does not befit your standing. You are a big man!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u031","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d027","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"That's exactly why I'm behaving like this. You should be proud that a big man is fond of you.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u032","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d028","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Master! If I had wished, I would have been not a servant in your house—but a lady of rank.","mode":"prose-faithful","notes":["`சீமாட்டி` is rendered as `lady of rank`; the class contrast with household servant is retained."]}},{"id":"parasakthi-en-s028-u033","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d029","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"What's gone wrong even now! Kalyani—one glance! Just move your eyes; after that, at your feet, this humble one is your lifelong slave.","mode":"prose-faithful","notes":["`சிரஞ்சீவி அடிமை` is rendered as `lifelong slave`, preserving the extravagant submission without importing a modern romantic idiom."]}},{"id":"parasakthi-en-s028-u034","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d030","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Chi... lust-demon!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u035","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d031","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"You eat my salt and betray me?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u036","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d032","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Your salt is for my labour, not for my body. I am a worker employed in your house.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u037","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d033","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"In the inner chambers of great men, there is no room for any question of worker and master.","mode":"prose-faithful","notes":["`அந்தப்புரம்` is translated as `inner chambers`; the source's class/sexual rhetoric is not expanded or softened."]}},{"id":"parasakthi-en-s028-u038","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d034","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"If you try to touch me, you will see only my corpse.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u039","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d035","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Then at least give up your life. I'll come touching you at least as far as the cremation ground. Kalyani, you are the mistress of my pleasure.","mode":"prose-faithful","notes":["The source's macabre `சுடுகாடுவரைக்கும்` and `என்னின்ப எஜமாணி` imagery is retained rather than euphemized."]}},{"id":"parasakthi-en-s028-u040","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/scenes/scene-28.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":4,"description":"Narayana Pillai goes to embrace Kalyani."},"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"(Saying this, he goes to embrace Kalyani.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u041","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d036","speaker_label":"கல்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Ayyo, Amma... (Kanta arrives.)","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u042","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d037","speaker_label":"காந்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"A fine display of your character... the big man of the town! You sent me to Krishna Leela and you're staging Narayana Leela here? You've started even with the servant girl? The whole town is laughing itself sick about your body!","mode":"prose-faithful","notes":["The second pass removes the interpretive `bodily escapades` and keeps the compressed source phrase `உடம்பைப் பற்றித்தான் ஊர் சிரிப்பாச் சிரிக்குதே` close to its literal bodily reference."]}},{"id":"parasakthi-en-s028-u043","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d038","speaker_label":"நாரா","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"You went to the cinema—why are you back here?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u044","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d039","speaker_label":"கருப்","page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"Madam came back halfway, master.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u045","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/scenes/scene-28.md","source_locator":{"kind":"standalone-source-marker","ordinal":1,"description":"Standalone source text `பாரா-3.` appears before the PDF 35 page boundary."},"page_provenance":[{"pdf_page":34,"printed_page":33}]},"translation":{"english_text":"[Para-3.]","mode":"prose-faithful","notes":["The canonical scene contains standalone `பாரா-3.`. Its function is not inferred; the English preserves it as a source marker rather than deleting or expanding it."]}},{"id":"parasakthi-en-s028-u046","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d040","speaker_label":"காந்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Don't I know the story of this Narayana Pillai? That's why even the dolls from the houses next door and opposite are afraid to come!","mode":"prose-faithful","notes":["`பொம்மைகள்` is retained literally as `dolls`; the English does not silently decide whether the source uses it figuratively for women or girls."]}},{"id":"parasakthi-en-s028-u047","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d041","speaker_label":"நாரா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Why would they come here!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u048","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d042","speaker_label":"காந்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Yes! If someone grabbed and dragged your elder or younger sister by the hand like this, would you keep quiet?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u049","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d043","speaker_label":"நாரா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"I do what I please. Who are you to question me?","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u050","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d044","speaker_label":"காந்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Then I too am going to take someone by the hand and drag them away as I please.","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u051","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d045","speaker_label":"நாரா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Get lost, you mundi—go!","mode":"prose-faithful","notes":["`முண்டி` is an abusive source form whose exact social force remains pressure-sensitive, so it is transliterated rather than normalized."]}},{"id":"parasakthi-en-s028-u052","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d046","speaker_label":"கருப்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Ayyo, what is this, master!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u053","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d047","speaker_label":"நாரா","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Go, woman, go!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u054","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/dialogues/records/scene-28.json","source_record_id":"parasakthi-s028-d048","speaker_label":"காந்","page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"Chi! What kind of man are you! Kalyani, bolt the door properly! Any dog may come barging in!","mode":"prose-faithful","notes":[]}},{"id":"parasakthi-en-s028-u055","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":28,"source":{"source_path":"works/parasakthi/scenes/scene-28.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":5,"description":"Kalyani leaves Narayana Pillai's house."},"page_provenance":[{"pdf_page":35,"printed_page":34}]},"translation":{"english_text":"(Kalyani leaves that house.)","mode":"prose-faithful","notes":[]}}]}