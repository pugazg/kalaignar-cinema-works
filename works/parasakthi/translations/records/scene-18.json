{"work_id":"parasakthi","target_language":"en","canonical_scene":18,"scene_status":"verified","unit_count":13,"units":[{"id":"parasakthi-en-s018-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/scenes/scene-18.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"The young men are playing cards."},"page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":["The source calls them `மைனர்கள்`; the English avoids standalone `minors`, whose modern age-sense can mislead. Exact source labels remain unchanged in dialogue metadata."],"english_text":"(The young men are playing cards.)"}},{"id":"parasakthi-en-s018-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d001","speaker_label":"1வது","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Turn it over, man."}},{"id":"parasakthi-en-s018-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d002","speaker_label":"2வது","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Three kings, brother."}},{"id":"parasakthi-en-s018-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d003","speaker_label":"1வது","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"If only I had three aces..."}},{"id":"parasakthi-en-s018-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d004","speaker_label":"வேணு","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":["The source form `லாண்டறி` is treated as the English loan `laundry`; the joke remains source-dependent and is not further rationalized."],"english_text":"You'd open a laundry."}},{"id":"parasakthi-en-s018-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d005","speaker_label":"1வது","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Why are you laughing? I'm the one who's not joining the game."}},{"id":"parasakthi-en-s018-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d006","speaker_label":"வேணு","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":["`ஆள் அவுட்டா` is rendered conservatively as being `out` of the game; the source's card-table register is retained."],"english_text":"What, are you out? Just stay, man—we can win back all the money we've lost."}},{"id":"parasakthi-en-s018-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d007","speaker_label":"1வது","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":["The verified source form `டேபின்` is lexically unclear. It is retained transparently as `tebin` rather than assigned an unsupported denomination or object."],"english_text":"But even for that we need money! Hey... if you had it, wouldn't you give me some? Hey, just give me one tebin."}},{"id":"parasakthi-en-s018-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d008","speaker_label":"வேணு","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":["The Hindi code-switch `பைசா நஹி` is retained as `Paisa nahi` rather than flattened into standard English."],"english_text":"Paisa nahi! What, man... your father has given you the key to the iron safe, and you're afraid..."}},{"id":"parasakthi-en-s018-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d009","speaker_label":"1வது","page_provenance":[{"pdf_page":22,"printed_page":21}]},"translation":{"mode":"prose-faithful","notes":["The period colloquial `காக்கா வலிப்பு` denotes a fit/seizure expression. Second-pass review keeps the English generic as `fits` rather than imposing a more specific modern diagnosis or reproducing the literal crow-image."],"english_text":"It's only the key... I often get fits; that's why he gave it to me."}},{"id":"parasakthi-en-s018-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d010","speaker_label":"வேணு","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Hey—are you coming there? Let's go..."}},{"id":"parasakthi-en-s018-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/dialogues/records/scene-18.json","source_record_id":"parasakthi-s018-d011","speaker_label":"1வது","page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Where?"}},{"id":"parasakthi-en-s018-u013","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":18,"source":{"source_path":"works/parasakthi/scenes/scene-18.md","source_locator":{"kind":"scene-bracketed-stage-block","ordinal":1,"description":"The young man is taken away by Venu."},"page_provenance":[{"pdf_page":23,"printed_page":22}]},"translation":{"mode":"prose-faithful","notes":["The source uses `மைனர்`; `young man` avoids the misleading modern English legal/age sense of `minor`."],"english_text":"[The young man is led away by Venu.]"}}]}