{
  "work_id":"parasakthi","target_language":"en","canonical_scene":25,"scene_status":"review","unit_count":29,
  "units":[
    {"id":"parasakthi-en-s025-u001","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/scenes/scene-25.md","source_locator":{"kind":"scene-bracketed-stage-block","ordinal":1,"description":"Black-market dealer Narayana Pillai counts the goods he has hoarded."},"page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"[Black-market scoundrel Narayana Pillai counts what he has hoarded.]","mode":"prose-faithful","notes":["The pejorative `கள்ள மார்க்கெட் கயவன்` is part of the source stage direction and is retained rather than neutralized." ]}},
    {"id":"parasakthi-en-s025-u002","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d001","speaker_label":"நாரா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Sugar sacks, twenty; mill-cloth pieces, thirty; yarn bales, six; total...","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u003","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d002","speaker_label":"கருப்","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Fifty-six.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u004","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d003","speaker_label":"நாரா","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"Chi, fool, don't I know that! If we calculate the profit, all fifty-six...","mode":"prose-faithful","notes":["The source line trails off after `ஐம்பத்தாறும்`; the English remains incomplete rather than supplying a profit calculation." ]}},
    {"id":"parasakthi-en-s025-u005","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d004","speaker_label":"கருப்","page_provenance":[{"pdf_page":29,"printed_page":28}]},"translation":{"english_text":"What profit, sir? Even if we sold it right now, we'd get thirty thousand.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u006","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d005","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Why, won't it do if we sell later? This isn't a brinjal to rot, man—it's a virgin girl.","mode":"prose-faithful","notes":["The source abruptly compares the nonperishable hoarded goods to `கன்னிப் பொண்ணு` (`virgin girl`); the English retains the jarring metaphor rather than rationalizing it." ]}},
    {"id":"parasakthi-en-s025-u007","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d006","speaker_label":"காந்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"You've started selling virgin girls too?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u008","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d007","speaker_label":"கருப்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"We can sell them, madam! But we can't tie them up in sacks like these.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u009","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d008","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Keep quiet, fool.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u010","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d009","speaker_label":"காந்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Why... he could even tie up the black-market demon in a sack.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u011","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d010","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Didn't I tie it up before I tied the tali around your neck! You speak of the black market with contempt—everything is money. Avvaiyar sang for gruel; Kambar sang for gold. What is this if not black too?","mode":"prose-faithful","notes":["The line runs from the `tie up` joke into the marriage `தாலி` image and then Narayana Pillai's deliberately self-serving analogy about poets receiving material reward; the English preserves the rhetorical sequence without endorsing or explaining it away.","`ப்ளாக்` is retained as `black` in the closing wordplay rather than expanded into a modern economic argument." ]}},
    {"id":"parasakthi-en-s025-u012","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/scenes/scene-25.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"The Tamil scholar arrives."},"page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"(At this moment the Tamil scholar arrives.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u013","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d011","speaker_label":"சி. ஜி. டி.","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Narayana Pillaival, I am no longer a Tamil scholar. I work in the detective department. I heard that you have a lot of nool.","mode":"prose-faithful","notes":["The source's `நூல்` sets up a thread/book pun. It is retained as `nool` here so the ambiguity is not destroyed before the later clarification.","The verified source gives the explicit speaker prefix `சி. ஜி. டி.` without its usual colon; the immutable dialogue record preserves that anomaly." ]}},
    {"id":"parasakthi-en-s025-u014","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d012","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Harahara, who told you that? Do I have nool? I am an honest merchant, a big man in the town! Head of the Sanmarga Sangam.","mode":"prose-faithful","notes":["Narayana Pillai hears `நூல்` in the commodity/thread sense; `nool` is retained until C.G.T. resolves the pun explicitly." ]}},
    {"id":"parasakthi-en-s025-u015","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d013","speaker_label":"கருப்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Thieving fellows!","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u016","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d014","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Who are you calling thieving fellows?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u017","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d015","speaker_label":"கருப்","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Boss, I had kept four annas by the well. Someone swiped it and went away.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u018","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d016","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Get lost, fool.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u019","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d017","speaker_label":"சி. ஜி. டி.","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Quiet, quiet, Narayana Pillaival. I meant not the thread used to weave clothes; nool that gives off the fragrance of knowledge—a book.","mode":"prose-faithful","notes":["The source explicitly resolves the `நூல்` homonym here: weaving thread versus a book/text. `nool` remains in the English sentence at the point of resolution to keep the wordplay visible.","The verified source again gives the explicit `சி. ஜி. டி.` prefix without the usual colon; the exact label remains metadata." ]}},
    {"id":"parasakthi-en-s025-u020","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d018","speaker_label":"நாரா","page_provenance":[{"pdf_page":30,"printed_page":29}]},"translation":{"english_text":"Books? All right, C.G.T. sir! I have plenty of books! Hey Karuppa, go buy from the shop every book the gentleman asks for and bring them, understand? Then please be off; it's getting late.","mode":"prose-faithful","notes":["Narayana Pillai evades the inquiry by proposing to buy the requested books from a shop; the English keeps the comic evasion without adding an explanation." ]}},
    {"id":"parasakthi-en-s025-u021","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d019","speaker_label":"சி. ஜி. டி.","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Thank you. Greetings.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u022","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d020","speaker_label":"நாரா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Pleasure.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u023","kind":"stage-direction","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/scenes/scene-25.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"After leaving Madurai, Kalyani reaches Tiruchi and stands starving with her child near Narayana Pillai's doorway."},"page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"(At this moment Kalyani, having left Madurai, has come to Tiruchi and stands near the entrance of Narayana Pillai's house, suffering from hunger.)","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u024","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d021","speaker_label":"கல்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Sir, my child and I are starving—something...","mode":"prose-faithful","notes":["The source trails off after `ஏதாவது`; the English remains incomplete rather than supplying a specific request." ]}},
    {"id":"parasakthi-en-s025-u025","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d022","speaker_label":"நாரா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Why, mother, you've started begging at such a young age? Who are you?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u026","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d023","speaker_label":"கல்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"I'm an orphan. Even if I can get some household work, that's enough.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u027","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d024","speaker_label":"நாரா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Then will you work here?","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u028","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d025","speaker_label":"கல்","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"I'm ready, sir.","mode":"prose-faithful","notes":[]}},
    {"id":"parasakthi-en-s025-u029","kind":"dialogue","status":"review","target_language":"en","canonical_scene":25,"source":{"source_path":"works/parasakthi/dialogues/records/scene-25.json","source_record_id":"parasakthi-s025-d026","speaker_label":"நாரா","page_provenance":[{"pdf_page":31,"printed_page":30}]},"translation":{"english_text":"Hey Karuppa, take her inside.","mode":"prose-faithful","notes":[]}}
  ]
}