  "scene_status": "review",
  "unit_count": 46,
  "units": [
    {
      "id": "parasakthi-en-s002-u001",
      "kind": "stage-direction",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {
        "source_path": "works/parasakthi/scenes/scene-02.md",
        "canonical_scene_path": "works/parasakthi/scenes/scene-02.md",
        "source_locator": {"kind": "scene-parenthetical-block", "ordinal": 1, "description": "Opening direction after the scene-2 heading."},
        "page_provenance": [{"pdf_page": 5, "printed_page": 4}]
      },
      "translation": {"english_text": "(In Rangoon... Gnanasekaran enters while Gunasekaran is asleep.)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u002",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d001", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Little brother! Little brother, Gunasekara! Hey, wake up. Still sleeping? Get up, little brother—hey, Gunasekara! (Turns on the radio.) Hey, Kumbakarna, wake up!", "mode": "prose-faithful", "notes": ["`Kumbakarna` is retained as the source's teasing mythological reference to a great sleeper."]}
    },
    {
      "id": "parasakthi-en-s002-u003",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d002", "speaker_label": "குண", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Mm... ayyo... my eyes! Coming and fooling around while I'm sleeping...", "mode": "prose-faithful", "notes": ["`Ayyo` is retained as an exclamation rather than flattened into a single English equivalent."]}
    },
    {
      "id": "parasakthi-en-s002-u004",
      "kind": "stage-direction",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/scenes/scene-02.md", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_locator": {"kind": "scene-parenthetical-block", "ordinal": 2, "description": "Chandrasekar enters after Gunasekaran wakes."}, "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "(At this moment Chandrasekar enters.)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u005",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d003", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "What, have you two started already? Dawn has broken, hasn't it?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u006",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d004", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Brother, Gunasekaran only just woke up.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u007",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d005", "speaker_label": "குண", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "No, brother. I was up by five-thirty this morning.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u008",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d006", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Yes, yes—I'm the one lying.", "mode": "prose-faithful", "notes": ["Rendered as sarcastic retort from the immediate exchange; the Tamil is colloquial and compressed."]}
    },
    {
      "id": "parasakthi-en-s002-u009",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d007", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Gnanasekara! Why are you lying? Our little brother doesn't even like seeing the sunrise. Mm... from home...", "mode": "prose-faithful", "notes": ["The source trails off at `ஊரிலே இருந்து...`; the English deliberately remains incomplete."]}
    },
    {
      "id": "parasakthi-en-s002-u010",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d008", "speaker_label": "குண", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Has little sister's photograph arrived?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u011",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d009", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Father has written that little sister's marriage has been fixed!", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u012",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d010", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Hey, look at that! When are all of us going home?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u013",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d011", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "I've phoned and asked them to book the tickets. The reply should come any moment. (Goes over to his sister-in-law.)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u014",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d012", "speaker_label": "குண", "page_provenance": [{"pdf_page": 5, "printed_page": 4}]},
      "translation": {"english_text": "Sister-in-law! Good news! Did you know Kalyani is getting married?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u015",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d013", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Sister-in-law would have been the first to know, wouldn't she? No, brother...!", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u016",
      "kind": "stage-direction",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/scenes/scene-02.md", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_locator": {"kind": "scene-parenthetical-block", "ordinal": 3, "description": "Chandrasekar looks at the photograph of Saraswathi's father and weeps."}, "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "(Chandrasekar looks at a photograph of his wife Saraswathi's father and sheds tears.)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u017",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d014", "speaker_label": "சரஸ்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Little sister is getting married! Why have you suddenly become so upset?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u018",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d015", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "No... when I saw your father's photograph, I felt strange; my whole mood changed. If he had been alive, how splendidly he would have conducted our wedding. It's just that he isn't here for this wedding now...", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u019",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d016", "speaker_label": "சரஸ்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "That's what your father is there for, isn't he?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u020",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d017", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Even so, he was the one who turned a ruined family into a prosperous one, wasn't he? From childhood we grew up under his protection. We played in his lap.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u021",
      "kind": "stage-direction",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/scenes/scene-02.md", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_locator": {"kind": "scene-parenthetical-block", "ordinal": 4, "description": "The family sits down for coffee."}, "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "(They sit down to drink coffee.)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u022",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d018", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "(Looking at Guna.) Hey! Put that down. Coffee before you've even brushed your teeth?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u023",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d019", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Gnanasekara! You keep quiet. Go ahead, little brother.", "mode": "prose-faithful", "notes": ["The source `சாப்பிடு` occurs in the coffee context and is rendered idiomatically as `go ahead` rather than specifying food."]}
    },
    {
      "id": "parasakthi-en-s002-u024",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d020", "speaker_label": "குண", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "What gift should we give Kalyani?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u025",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d021", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Our very hearts are beating for Kalyani. What better gift can we give than that? (The telephone rings.) Hello—Chandrasekaran speaking.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u026",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d022", "speaker_label": "பேசு", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "You asked for tickets, I hear?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u027",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d023", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Yes...", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u028",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d024", "speaker_label": "பேசு", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "How many?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u029",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d025", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Four... four.", "mode": "prose-faithful", "notes": ["The source code-switches with English `four`; the English translation preserves the hesitation/repetition."]}
    },
    {
      "id": "parasakthi-en-s002-u030",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d026", "speaker_label": "பேசு", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Four won't be possible, sir!", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u031",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d027", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "It won't? Please, sir—somehow, try.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u032",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d028", "speaker_label": "சரஸ்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "A great barrister—and how many 'pleases' do you have to say even for this?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u033",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d029", "speaker_label": "பேசு", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Don't you know? Wartime...", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u034",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d030", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 6, "printed_page": 5}]},
      "translation": {"english_text": "Wartime, yes, sir! But this is an important marriage in our family! All of us absolutely have to go.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u035",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d031", "speaker_label": "பேசு", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "Only one person from a family is allowed. There are just three hundred seats in all. There's only one ticket...", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u036",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d032", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "All right, book it.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u037",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d033", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "What is it, brother?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u038",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d034", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "The ship leaving for Madras tomorrow has only three hundred tickets in all! And even then, only one person from each family. Our sister's golden occasion in life—we haven't been blessed with the chance for all of us to see it together.", "mode": "prose-faithful", "notes": ["The unusual source phrase `தங்கையின் வாழ்விலே பொன் விழா` is rendered conservatively as `our sister's golden occasion in life`, without supplying a more specific event than the context supports."]}
    },
    {
      "id": "parasakthi-en-s002-u039",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d035", "speaker_label": "சரஸ்", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "Then who's going?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u040",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d036", "speaker_label": "குண", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "(Eagerly.) I'll go.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u041",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d037", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "Gnanasekara, take the saris and jewellery our sister needs, put them in the trunk, and send them with Gunasekaran. (Gnanasekaran is saddened.) Gnanasekara, why are you worrying? We'll all be able to go.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u042",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d038", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "Brother, what if the war situation becomes much worse by then?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u043",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d039", "speaker_label": "சந்", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "Somehow we'll make it there.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u044",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d040", "speaker_label": "சரஸ்", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "I'll give half a dozen saris and blouses for Kalyani. Will there be room in the trunk?", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u045",
      "kind": "dialogue",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/dialogues/records/scene-02.json", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_record_id": "parasakthi-s002-d041", "speaker_label": "ஞான", "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "It's for our sister—he'd carry it on his head if he had to. Just send it, sister-in-law.", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "parasakthi-en-s002-u046",
      "kind": "stage-direction",
      "status": "review",
      "target_language": "en",
      "canonical_scene": 2,
      "source": {"source_path": "works/parasakthi/scenes/scene-02.md", "canonical_scene_path": "works/parasakthi/scenes/scene-02.md", "source_locator": {"kind": "scene-parenthetical-block", "ordinal": 5, "description": "Closing direction after the final family exchange."}, "page_provenance": [{"pdf_page": 7, "printed_page": 6}]},
      "translation": {"english_text": "(Gunasekaran departs.)", "mode": "prose-faithful", "notes": []}
    }
  ]
}
