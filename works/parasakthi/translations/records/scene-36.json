{"work_id":"parasakthi","target_language":"en","canonical_scene":36,"scene_status":"verified","unit_count":6,"units":[{"id":"parasakthi-en-s036-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":36,"source":{"source_path":"works/parasakthi/scenes/scene-36.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Hunger torments Kalyani and she begs."},"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"(Tormented by hunger, Kalyani begs.)"}},{"id":"parasakthi-en-s036-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":36,"source":{"source_path":"works/parasakthi/dialogues/records/scene-36.json","source_record_id":"parasakthi-s036-d001","speaker_label":"கல்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Sir, it has been six days since my child and I ate."}},{"id":"parasakthi-en-s036-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":36,"source":{"source_path":"works/parasakthi/dialogues/records/scene-36.json","source_record_id":"parasakthi-s036-d002","speaker_label":"வீட்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"mode":"prose-faithful","notes":["The contrast between public begging and concealed hunger inside the house is preserved without adding a broader social explanation."],"english_text":"It has been three days since we ate. You go street to street asking for alms; we stay inside the house. That is the difference. Today there is a feast at Judge Sekar's house. Go ask there."}},{"id":"parasakthi-en-s036-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":36,"source":{"source_path":"works/parasakthi/dialogues/records/scene-36.json","source_record_id":"parasakthi-s036-d003","speaker_label":"கல்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"Which house, sir?"}},{"id":"parasakthi-en-s036-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":36,"source":{"source_path":"works/parasakthi/dialogues/records/scene-36.json","source_record_id":"parasakthi-s036-d004","speaker_label":"வீட்","page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"There, you can see it—that house on the corner."}},{"id":"parasakthi-en-s036-u006","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":36,"source":{"source_path":"works/parasakthi/scenes/scene-36.md","source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Kalyani leaves."},"page_provenance":[{"pdf_page":43,"printed_page":42}]},"translation":{"mode":"prose-faithful","notes":[],"english_text":"(Kalyani leaves.)"}}]}