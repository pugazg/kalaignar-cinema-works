{"work_id":"parasakthi","canonical_scene":6,"source_scene_heading":6,"source_scene_file":"works/parasakthi/scenes/scene-06.md","record_count":19,"records":[{"id":"parasakthi-s006-d001","canonical_scene":6,"source_scene_heading":6,"speaker_label":"தங்","text":"கல்யாணி!","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d002","canonical_scene":6,"source_scene_heading":6,"speaker_label":"கல்","text":"இதோ வந்துட்டேன்.","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d003","canonical_scene":6,"source_scene_heading":6,"speaker_label":"தங்","text":"ஹூம்...புறப்படு சீக்கிரம்","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d004","canonical_scene":6,"source_scene_heading":6,"speaker_label":"கல்","text":"ஏன் பறக்கிறீங்க (ஆடை அணிந்து வரும் போது தந்தையைப் பார்த்து) அப்பா போய்விட்டு வர்றோம்.......","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d005","canonical_scene":6,"source_scene_heading":6,"speaker_label":"மாணிக்","text":"சரியம்மா ஜாக்கிரதையா போயிட்டுவாங்க,","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d006","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பார்","text":"கல்யாணி...","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d007","canonical_scene":6,"source_scene_heading":6,"speaker_label":"கல்","text":"வாங்க அக்கா","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d008","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பார்","text":"நல்ல சமயத்திலேதான் வந்திருக்கேன்.. எங்கே பிரயாணம்?","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d009","canonical_scene":6,"source_scene_heading":6,"speaker_label":"மாணி","text":"ஒண்ணுமில்ல மாப்பிள்ளை எழுதின கதை படம் பிடிக்கப் போறாங்களாம்.","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d010","canonical_scene":6,"source_scene_heading":6,"speaker_label":"தங்","text":"ஆமா! கல்யாணி ரொம்ப நாளா படம் பிடிக்கிறதை பார்க்கணும் பார்க்கணும்னு தொந்தரவு பண்ணுது.","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d011","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பார்","text":"போகவேண்டியது தான். முழுகாதிருக்கிற பெண்ணு இப்படி நேரம் காலம் இல்லாமல் வெளியே போனால் நல்லாவா இருக்கு.","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d012","canonical_scene":6,"source_scene_heading":6,"speaker_label":"மாணி","text":"தப்புதான் குழந்தை ஆசைபடுதில்லே போயிட்டுத்தான் வரட்டுமே.","page_provenance":[{"pdf_page":9,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d013","canonical_scene":6,"source_scene_heading":6,"speaker_label":"கல்","text":"இன்னைக்கு ஒரு நாளைக்குத்தானக்கா!","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d014","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பார்","text":"ம்...போம்மா! போ! மாப்புள்ளே நீ சொன்ன படியெல்லாம் கேட்டிரு! பையன் வந்துல்ல அடக்கணும்.","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d015","canonical_scene":6,"source_scene_heading":6,"speaker_label":"கல்","text":"போங்க அக்கா","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d016","canonical_scene":6,"source_scene_heading":6,"speaker_label":"மாணி","text":"அதுக்குள்ளே பையனே தீர்மானம் பண்ணிட்டியா?","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d017","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பார்","text":"நான் தீர்மானித்தாலும் தீர்மானிக்காவிட்டாலும் அவங்க ரெண்டு பேருமே தீர்மானம் பண்ணிட்டாங்களாம் பையனுக்கு பன்னீர் செல்வம்னு பெயர் வைக்கிறதா...","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d018","canonical_scene":6,"source_scene_heading":6,"speaker_label":"தங்","text":"அதுமட்டுமல்ல பெண் பிறந்தால் நாகம்மான்னு பெயர் வைக்கிறதா தீர்மானிச்சிருக்கோம்.","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"parasakthi-s006-d019","canonical_scene":6,"source_scene_heading":6,"speaker_label":"மணி","text":"என் பொண்ணு புத்திசாலிதான். இந்த சந்தோஷத்தைப் பார்க்க மகன்களும் இருந்தால்...","page_provenance":[{"pdf_page":10,"printed_page":9}],"source_scene_file":"scene-06.md"}]}