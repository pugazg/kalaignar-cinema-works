{"work_id":"parasakthi","canonical_scene":21,"source_scene_heading":21,"source_scene_file":"works/parasakthi/scenes/scene-21.md","record_count":40,"source_label_anomalies":[{"record_id":"parasakthi-s021-d040","source_form":"கல் ! கிறுக்கண்ணு! கிறுக்கண்ணு!","note":"Source uses ! after the explicit speaker label instead of the usual colon; canonical text is unchanged."}],"records":[{"id":"parasakthi-s021-d001","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"கல்யாணி!","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d002","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"[கதவைத் திறந்தவுடன்] ஏண்ணா இவ்வளவு நாழி? இனிமேல் சீக்கிரமா வந்துடுங்க.","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d003","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"வரவேண்டிய நேரத்திலேதானே வந்திருக்கேன் ஏன் கல்யாணி இன்று வியாபாரம் எப்படி?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d004","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"என்றைக்கும் போலத்தான் இன்னிக்கும்","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d005","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"ம்...இட்லி இருக்குல்லே?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d006","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"இருங்கண்ணா! கொண்டு வர்றேன்","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d007","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"ஏன் கல்யாணி! அரிசி கிடைக்காத நேரத்திலே இப்படி தனி அரிசியாய்ப் போடாமல் கொஞ்சம் கோதுமையைச் சேர்த்தால்—","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d008","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"சேர்க்கலாம் ஆனா ருசி கெட்டுடும்","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d009","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"எதுவும் தனிமையாக இருக்கிறதைவிட இரண்டாக இருந்தால் நல்லா இருக்கும். கோதுமையும் கலந்துகிட்டால் லாபமும் அதிகம் இருக்குமே!","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d010","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"லாபத்துக்காக அக்கிரமம் செய்யலாமா அண்ணா?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d011","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"என்னடி மூச்சிக்கு முப்பத்திரண்டு அண்ணா போட்ற?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d012","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"அண்ணா! எனக்கு மூன்று அண்ணன்மார்கள் உண்டு அவர்களில் ஒருவரைக்கூடப் பார்க்க கொடுத்து வைக்காத பாவியானேன்! ஆசைக்கு உங்களையாவது அண்ணா அண்ணாண்ணு கூப்பிட்றேன்","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d013","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"அட பைத்தியமே ஆசை அதிகமாயிட்டா அதுக்கு அண்ணாண்ணு கூப்பிட்றது?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d014","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"அண்ணா! உங்கள் பேச்சில் விபரீதமிருக்கிறதே?","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d015","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"ஆசையைக் காட்டிக்கொள்ளும் வழி அது வல்ல கல்யாணி!","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d016","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"அண்ணா தனியாக இருக்கும் பெண்களிடம் இப்படிப் பேசுவது—","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d017","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"ஆமா! தளிர்க்கொடி தனியாக இருக்கக் கூடாதுன்னுதான் படர்வதற்கேற்ற பலாமரமாக நான் இருக்கிறேன். மாமான்னு கூப்பிடு! அது எவ்வளவு மனோகரமான வார்த்தை! அத்தான்னு கூப்பிடு அது எத்தனை சத்தான மாழி.","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d018","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"நிறுத்து இனி என்னால் பொறுக்க முடியாது.","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d019","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"இங்கே என்ன வாழுதாம்! தானும் அப்படித்தான் நீ சரின்னு சொல்லு. ஓலைக்குடிசை இருக்கும் இடத்திலே உப்பரிகை கட்டித் தருகிறேன். கந்தல்பாயிலே படுத்த கல்யாணி கனகமணிக் கட்டிலிலே படுப்பாள்.","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d020","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"சீ நெருங்காதீர்கள்! வறுமையால் வாடும் பெண்கள் வஞ்சக வலைவீசினால் விழுவார்கள் என்று இப்படி எத்தனை பேர் கிளம்பியிருக்கிறீர்கள்?","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d021","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"போர்க்களத்திலே ஒப்பாரி! போகக் களத்திலே புலம்பல் கோழைகள் செயலடி என் கோமள நாயகி","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d022","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"என்னைத் தொட முயன்றால் சப்தம் போடுவேன்","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d023","canonical_scene":21,"source_scene_heading":21,"speaker_label":"வேணு","text":"போடு! உன் சப்தம் எனக்கு சங்கீதமாக இருக்கட்டும்.","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d024","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"மரியாதை வேண்டாமடா, மைத்துனு [என்று வேணுவை அடித்து விரட்டுகிறான்]","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d025","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"நீ வரலின்னா என்கதி என்ன ஆகியிருக்கும்! கிறுக்கண்ணா நீ எங்கே இங்கு வந்தே","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d026","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"உன்னைப் பார்க்கத்தான்","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d027","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"கிறுக்கண்ணா பத்துநாளா அந்த மரத்தடியிலே என்ன செய்யுறே!","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d028","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"ராஜாங்கம் நடத்துறேன்","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d029","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"கிறுக்கண்ணா இட்லி தர்றேன் திங்கிறியா?","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d030","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"ம்...நீ காசு கேட்பியே","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d031","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"காசு வேண்டாம்","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d032","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"நான் யாருன்னு சொன்னா நீ காசே கேட்க மாட்டே","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d033","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"நீ யாரு?","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d034","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"நானு...நானு மரத்தடி மகாராஜா!","page_provenance":[{"pdf_page":27,"printed_page":26}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d035","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"இட்லி கொண்டு வாறேன்","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d036","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"வேண்டாம்... வேண்டாம்மா... இட்லி வேண்டாம்மா... சட்டனி வேண்டும்மா...","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d037","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"சரி ரெண்டும் கொண்டு வாறேன் (போகிறாள்)","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d038","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"(இட்லியுடன்) ஏன் கிறுக்கண்ணு அழுறே","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d039","canonical_scene":21,"source_scene_heading":21,"speaker_label":"குண","text":"உம்......என் ராஜாங்க பிரஜையெல்லாம் சந்தோஷமாக இருக்காங்க...அதுலே நான் அழுறேன்.","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-21.md"},{"id":"parasakthi-s021-d040","canonical_scene":21,"source_scene_heading":21,"speaker_label":"கல்","text":"! கிறுக்கண்ணு! கிறுக்கண்ணு!","page_provenance":[{"pdf_page":28,"printed_page":27}],"source_scene_file":"scene-21.md"}]}