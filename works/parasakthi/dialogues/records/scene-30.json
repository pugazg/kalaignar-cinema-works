{"work_id":"parasakthi","canonical_scene":30,"source_scene_heading":30,"source_scene_file":"works/parasakthi/scenes/scene-30.md","record_count":26,"cross_part_scene":true,"records":[{"id":"parasakthi-s030-d001","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பிச்சை","text":"ஐயா! அந்த தேங்காய் முடியிலாவது ஒண்ணு கொடுங்கையா! (கருப்பன் கொடுத்தல்)","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d002","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"ஏண்டா திமிர் பிடிச்ச பயலே! தேங்காயை ஏண்டா கொடுத்தே?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d003","canonical_scene":30,"source_scene_heading":30,"speaker_label":"கருப்","text":"கோயிலிலே பிரசங்கத்திலே சொன்னுங்களே தர்மம் தலைகாக்கும்னு.","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d004","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"கோயிலிலே உனக்கும் எனக்குமா சொன்னுன்? பணம்டா! கொண்டா இங்கே (திருப்பி கேட்கிறார்)","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d005","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பிச்","text":"ஏழைங்க எஜமான்!","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d006","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"ஏழை...ஏழவு (அடித்தல்) ஏ—நாயே! ஒனக்குப் பிரசாதம் கேக்குதா? (இந்நேரம் குணசேகரன் வருகிறான்)","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d007","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"யாரடா நீ?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d008","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"உங்களை எங்கேயோ பாத்தாப்புல இருக்குதுல்லே","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d009","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"பார்த்திருப்பே பார்த்திருப்பே.","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d010","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"நீங்க...நீங்க...","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d011","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"ஜெனரல் மெர்ச்சண்ட் நாராயணப் பிள்ளை","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d012","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"நானு சேர்மையா...","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d013","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"வேலைக்காரனு?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d014","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"உங்களை...","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d015","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"சேர்மன் பார்க்கணும்ன்றா?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d016","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"ஆமா! ஆமா! அவருகூட உங்ககிட்டே","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d017","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"சர்க்கரை வேணும்ன்றா? அவருக்கு மூட்டை மூட்டையால்ல வேணும், சாயந்திரமாக நம்ம வீட்டு பக்கமா வா இரகசியமாக தர்றேன்.","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d018","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"ப்ளாக்கிலே தர்றீங்களா?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d019","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"அட நீ என்னப்பா?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d020","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"அப்போ...சாயந்திரமா வரட்டுங்களா? ப்ளாக்கிலே தர்றீங்களா?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d021","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"வா...வா.","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d022","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"அப்போ; இப்போ நான் போகட்டுங்களா?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d023","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"என்னடாப்பா இது?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d024","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"இது அடிடாப்பா! ஏ நாயே உனக்குத் தேங்கா கேக்குதோ? ஏழைகளுக்குப் பிரசாதம் கேக்குதா? கொண்டாடா இங்கே?","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d025","canonical_scene":30,"source_scene_heading":30,"speaker_label":"நாரா","text":"பராசக்தி உன்னை ஒட்டப்பசங்க இன்னிக்கு அடிக்கிற அளவுக்கு வந்துட்டானுங்க.","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"},{"id":"parasakthi-s030-d026","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குண","text":"ஓடப்பராயிருக்கும் ஏழையப்பர் உதையப்பராகி விட்டால் ஒரு நொடிக்குள் ஓடப்பர் உயரப்பர் எல்லாம் மாறி ஒப்பப்பராகிவிடுவார் உணரப்பா நீ! ப்ளாக்கிலே தர்றீங்களா? இந்தா ப்ளாக்கிலே ஒண்ணு வாங்கிக்கோ... (நாராயணரைக் குணசேகரன் காலால் உதைத்துக் கீழே தள்ளுகிறான்)","page_provenance":[{"pdf_page":36,"printed_page":35}],"source_scene_file":"scene-30.md"}]}