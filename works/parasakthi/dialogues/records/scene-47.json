{"work_id":"parasakthi","canonical_scene":47,"source_scene_heading":47,"source_scene_file":"works/parasakthi/scenes/scene-47.md","record_count":34,"records":[{"id":"parasakthi-s047-d001","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சந்","text":"கல்யாணி! கல்யாணி!","page_provenance":[{"pdf_page":55,"printed_page":54}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d002","canonical_scene":47,"source_scene_heading":47,"speaker_label":"கல்","text":"அண்ணு! அண்ணு என்னைப் பாருங்கள்?","page_provenance":[{"pdf_page":55,"printed_page":54}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d003","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"அண்ணனுக்கு என்ன செய்யுது அண்ணி.","page_provenance":[{"pdf_page":55,"printed_page":54}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d004","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சரஸ்","text":"இதோ உங்கள் தம்பி குணசேகரன், உங்கள் தங்கை கல்யாணி!","page_provenance":[{"pdf_page":55,"printed_page":54}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d005","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சந்","text":"இல்லை! அவன் அவள் அண்ணன் காலம் உதைத்து விட்டான், அவள் ஆற்றிலே விழுந்து விட்டாள் இல்லை அவளுக்கு அவள் அண்ணன் தூக்குத்தண்டனை விதித்துவிட்டான்.","page_provenance":[{"pdf_page":55,"printed_page":54}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d006","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"அண்ணு!","page_provenance":[{"pdf_page":55,"printed_page":54}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d007","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சந்","text":"நான்தான் ஜட்ஜ்மெண்ட் எழுதினேன்; அண்ணனாக இருந்தால் என்ன தம்பியாக இருந்தால் என்ன? குற்றம் குற்றம்தான்.","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d008","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சர","text":"இதோ பாருங்கள் கல்யாணியின் குழந்தை.","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d009","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சரஸ்","text":"யாரது?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d010","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"நீங்க இருங்க! நான் போய்ப் பார்த்து வருகிறேன்! (ஞானசேகரிடம்) என்ன வேண்டும்?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d011","canonical_scene":47,"source_scene_heading":47,"speaker_label":"ஞான","text":"அம்மா அய்யா இருக்காங்களா?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d012","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"ஏன்?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d013","canonical_scene":47,"source_scene_heading":47,"speaker_label":"ஞான","text":"நாங்க ஒரு பிச்சைக்கார மகாநாடு நடத்த போகிறோம் அதற்கு நிதி கேட்க (விமலா சிரிக்கிறாள்) ஏம்மா சிரிக்கிறீங்க? இப்ப அப்படித்தான் இருக்கும்! இன்னும் கொஞ்ச நாள் போனால் பிச்சைக்காரனும் மந்திரி ஆகிடுவான்.","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d014","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"அப்போ நான் போயிட்டு வர்றேன்...","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d015","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"இத்தனை நாளாகவா?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d016","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"வீட்டிலே தேடுவாங்க!","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d017","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"அப்புறம் உன்னை எப்ப பார்க்கிறது?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d018","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"இனிமேல் பார்க்கவே முடியாது!","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d019","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"ஏன்?","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d020","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"அது அப்படித்தான்.","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d021","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"சரி அப்படியானால் போ... (விமலாவின் சேலை குணசேகரன் கட்டிய கயிற்றினால் நிறுத்தப்படுகிறது)","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d022","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சேகர்","text":"என்னப்பா குணசேகரா","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d023","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சரஸ்","text":"தம்பி இதுக்கு இவ்வளவு பெரிய கயிறு தேவை இல்லையே! சின்னக்கயிறு...கழுத்துக்கு பொருத்தமா இருந்தாலே போதும்! அதிலே ஒரு மஞ்சள்...","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d024","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"அதெல்லாம் இந்தக் காலத்துக்கு தேவையில்லை அண்ணி. ரெண்டு மாலை, ஒரு சொற்பொழிவாளர் விஷயம் முடிஞ்சது. (இந்நேரம் கல்யாணி வருகிறாள்)","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d025","canonical_scene":47,"source_scene_heading":47,"speaker_label":"கல்","text":"அதோமட்டும் போதாது. என் பையனுக்கு ஒரு பொண்ணு பெத்துக் கொடுக்கணும்!","page_provenance":[{"pdf_page":56,"printed_page":55}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d026","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"வாங்க...அம்மா! ஒரு காலணவுக்கு இட்லி தர்றீங்களா? ஏன் சிரிக்கிறீங்க? பைத்தியக்காரனு நினைச்சிட்டியா மந்திரி நமது மாநகர் தன்னிலே மாத மும்மாரி மழை பெய்கிறதா டும்! டும்! (பழையதை நினைவூட்டுகிறான்)","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d027","canonical_scene":47,"source_scene_heading":47,"speaker_label":"ஞான","text":"சரிதான்! அப்படியா நீங்களெல்லாம் இங்கேயே இருங்க. நான் வர்றேன்.","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d028","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சேகர்","text":"ஏன் தம்பி நீ எங்கே போறே","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d029","canonical_scene":47,"source_scene_heading":47,"speaker_label":"ஞான","text":"நமக்கும் உங்களுக்கும் சரிப்பட்டு வராது. நீங்க பங்களா ஆபீஸ்னு பழகிட்டீங்க. நான் பரதேசி மடம், ஆலமரத்தடி இப்படி பழகிட்டேன் அங்கேயே போகிறேன்.","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d030","canonical_scene":47,"source_scene_heading":47,"speaker_label":"கல்","text":"அப்போ நானும் வர்றேன்.","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d031","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குண","text":"நானும் புறப்பட்டுட்டேன் அப்படின்னு.","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d032","canonical_scene":47,"source_scene_heading":47,"speaker_label":"விம","text":"எல்லோருமே பரதேசி மடத்துக்கு போறதுக்குப் பதில் பரதேசிகளெல்லாம் பங்களாவுக்கு அழைக்கிறது தான் நல்லது.","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d033","canonical_scene":47,"source_scene_heading":47,"speaker_label":"சேகர்","text":"ஆமாம்! அதுதான் சரியான யோசனை; ஞானசேகரா உன் கொள்கைப்படி பங்களாவாசி பரதேசியாக மாறக்கூடாது! பரதேசிகள் பூராவையும் பங்களாவாசியாக மாற்றுகிறதுதான் நல்லது.","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"},{"id":"parasakthi-s047-d034","canonical_scene":47,"source_scene_heading":47,"speaker_label":"ஞான","text":"அப்படின்னு நான் போய் எல்லோரையும் கூட்டிட்டு வர்றேன். (பேதமின்றி பாடுகின்றனர்)","page_provenance":[{"pdf_page":57,"printed_page":56}],"source_scene_file":"scene-47.md"}]}