{"work_id":"parasakthi","canonical_scene":25,"source_scene_heading":25,"source_scene_file":"works/parasakthi/scenes/scene-25.md","record_count":26,"source_label_anomalies":[{"record_id":"parasakthi-s025-d011","source_form":"சி. ஜி. டி. நாராயணப்பிள்ளைவாள் நான் இப்பொழுது தமிழ்ப் பண்டிதரல்ல...","note":"Source gives an explicit speaker prefix but omits the usual colon; canonical text is unchanged."},{"record_id":"parasakthi-s025-d017","source_form":"சி. ஜி. டி. அமைதி அமைதி, நாராயணப் பிள்ளைவாள்...","note":"Source gives an explicit speaker prefix but omits the usual colon; canonical text is unchanged."}],"records":[{"id":"parasakthi-s025-d001","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"சர்க்கரை மூட்டை, இருபது, மில் துணி பீஸ் முப்பது, நூல் பேல் ஆறு, ஆக மொத்தம்.","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d002","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கருப்","text":"அம்பத்தாறு","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d003","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"சீ மடையா அதுதெரியாது எனக்கு! லாபத்தைக் கணக்குப் பண்ணினால், ஐம்பத்தாறும்","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d004","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கருப்","text":"லாபம் என்னங்க, இப்பவே வித்தால்கூட முப்பதாயிரம் கிடைக்குங்க.","page_provenance":[{"pdf_page":29,"printed_page":28}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d005","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"ஏன் அப்புறம் வித்தால் ஆகாதோ? இது ஒண்ணும் கத்திரிக்கா இல்லேடா அழுகிப்போகறதுக்கு கன்னிப் பொண்ணு.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d006","canonical_scene":25,"source_scene_heading":25,"speaker_label":"காந்","text":"கன்னிப்பெண்ணைக்கூட விக்க ஆரம்பிச்சுட்டீங்களா?","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d007","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கருப்","text":"விக்கலாம் அம்மா! ஆனால் அதை இந்த மாதிரி மூட்டையாக கட்டிப்போட முடியாதே.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d008","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"சும்மா இருடா மடையா.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d009","canonical_scene":25,"source_scene_heading":25,"speaker_label":"காந்","text":"ஏன்...இவரு ப்ளாக் மார்க்கெட்டு பூதத்தைக்கூட மூட்டையாகக் கட்டிப் போட்டுருவாரே.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d010","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"அப்படிக் கட்டிப் போட்டாமலா உன் கழுத்திலே தாலியைக் கட்டினேன்! நீ ப்ளாக் மார்க்கெட்டை கேவலமா பேசறே எல்லாம் பணம்தான். ஒளவையார் கூழுக்குப் பாடினள், கம்பர் பொன்னுக்குப் பாடினாரு, இதுவும் ப்ளாக் இல்லாமல் வேறு என்ன?","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d011","canonical_scene":25,"source_scene_heading":25,"speaker_label":"சி. ஜி. டி.","text":"நாராயணப்பிள்ளைவாள் நான் இப்பொழுது தமிழ்ப் பண்டிதரல்ல. துப்பறியும் இலாகாவில் பணியாற்றுகிறேன். உங்களிடம் நிறைய நூல் இருப்பதாக கேள்விப்பட்டேன்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d012","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"அரகரா, அது யாருங்க சொன்னது? என்னண்ட நூல் இருக்கிறதா. நான் ஒரு நாணயமான வியாபாரி ஊருக்கு பெரிய மனுஷன்! சன்மார்க்க சங்கத்துக்கு தலைவன்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d013","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கருப்","text":"திருட்டுப் பயல்க!","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d014","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"யாருடா திருட்டுப் பயல்க?","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d015","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கருப்","text":"முதலாளி கிணற்றுக் கரையிலே நாலு அணாவைச் வச்சிருந்தேன். எவனோ அடிச்சிட்டு போயிட்டான்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d016","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"போடா மடையா.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d017","canonical_scene":25,"source_scene_heading":25,"speaker_label":"சி. ஜி. டி.","text":"அமைதி அமைதி, நாராயணப் பிள்ளைவாள் நான் குறிப்பிட்டது ஆடை நெய்யும் நூல் அல்ல; அறிவு வாடை வீசும் நூல், புத்தகம்.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d018","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"புத்தகமா? சரிதான் சி. ஜி. டி. சார்! எங்கிட்ட ஏராளமான புத்தகம் இருக்கு! டேய் கருப்பா அய்யா கேக்குற புத்தகத்தையெல்லாம் போயி கடையிலே வாங்கிக் கொண்டு வந்து கொடு தெரிஞ்சுதா? அப்போ புறப்படுங்கோ நேரம் ஆகுது.","page_provenance":[{"pdf_page":30,"printed_page":29}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d019","canonical_scene":25,"source_scene_heading":25,"speaker_label":"சி. ஜி. டி.","text":"நன்றி வணக்கம்","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d020","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"சந்தோஷம்","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d021","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கல்","text":"ஐயா நானும் குழந்தையும் பட்டினி ஏதாவது","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d022","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"ஏம்மா இந்த இளம் வயதிலேயே பிச்சை எடுக்க ஆரம்பிச்சுட்டியே நீ யாரு?","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d023","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கல்","text":"நான் ஒரு அநாதையா ஏதாவது ஒரு வீட்டுவேலை கிடைச்சாலும் போதும்.","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d024","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"அப்போ இங்கே வேலை பார்க்குறியா?","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d025","canonical_scene":25,"source_scene_heading":25,"speaker_label":"கல்","text":"தயாராய் இருக்கேன்யா","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"},{"id":"parasakthi-s025-d026","canonical_scene":25,"source_scene_heading":25,"speaker_label":"நாரா","text":"டேய் கருப்பா உள்ளே கூட்டிக்கிட்டு வாடா","page_provenance":[{"pdf_page":31,"printed_page":30}],"source_scene_file":"scene-25.md"}]}