{"work_id":"parasakthi","canonical_scene":35,"source_scene_heading":35,"source_scene_file":"works/parasakthi/scenes/scene-35.md","record_count":10,"records":[{"id":"parasakthi-s035-d001","canonical_scene":35,"source_scene_heading":35,"speaker_label":"கல்","text":"அண்ணு இரங்கூனிலிருந்து அகதிகள் எல்லாம் வந்திருக்காங்களாமே!","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d002","canonical_scene":35,"source_scene_heading":35,"speaker_label":"ஆபீ","text":"ஆமா யாரு வேணும்?","page_provenance":[{"pdf_page":42,"printed_page":41}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d003","canonical_scene":35,"source_scene_heading":35,"speaker_label":"கல்","text":"சந்திரசேகரன், ஞானசேகரன், குணசேகரன்.","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d004","canonical_scene":35,"source_scene_heading":35,"speaker_label":"ஆபீ","text":"அப்படி ஒருவரும் இல்லையே! அதோ அந்த ஆலமரத்தடிலே ஒரு கூட்டம் இருக்கு அங்கே போயி விசாரி.","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d005","canonical_scene":35,"source_scene_heading":35,"speaker_label":"கல்","text":"அண்ணு நீங்களெல்லாம் பர்மாவிலே இருந்துதானே வர்றீங்க?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d006","canonical_scene":35,"source_scene_heading":35,"speaker_label":"ஒரு","text":"ஆமாம்மா அகதிகளாக வந்தோம், ஆண்டிகளாக மாறிவிட்டோம்!","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d007","canonical_scene":35,"source_scene_heading":35,"speaker_label":"கல்","text":"இரங்கூனில் என் அண்ணன்மார்களைத் தெரியுமா?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d008","canonical_scene":35,"source_scene_heading":35,"speaker_label":"மற்","text":"ஊரும். அவுங்க பேரு என்ன?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d009","canonical_scene":35,"source_scene_heading":35,"speaker_label":"கல்","text":"சந்திரசேகரன்... ஞானசேகரன்... குணசேகரன்...","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"},{"id":"parasakthi-s035-d010","canonical_scene":35,"source_scene_heading":35,"speaker_label":"ஒரு","text":"எங்ககூட்டமே இவ்வளவு பேருதான் இதிலே உன் அண்ணன்மார்கள் இருக்காங்களான்னு பாரு (கல்யாணி பார்க்கிறாள் இல்லை)","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-35.md"}]}