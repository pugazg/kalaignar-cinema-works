{"work_id":"parasakthi","canonical_scene":28,"source_scene_heading":28,"source_scene_file":"works/parasakthi/scenes/scene-28.md","record_count":48,"records":[{"id":"parasakthi-s028-d001","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்தா","text":"ஏது இவ்வளவு புத்தகம்.","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d002","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"எல்லாம் அந்த சி. ஐ. டி. பண்டிதருக்குத்தான். அவன் நம்ம வீட்டிலே இருந்த கந்த புராணத்திலிருந்து ஸ்ரீவள்ளி சினிமா பாட்டு புத்தகம்வரை படிச்சுட்டான். இப்ப என்னென்னமோ வந்திருக்கு. குடும்ப விளக்கு, பாண்டியன் பரிசு, ரங்கூன் ராதா, இலட்சிய வரலாறு எல்லாம் ஐம்பது ரூபாய் ஆய்ச்சு...ம் கல்யாணி...காந்தா—சொல்ல மறந்துட்டேனே இன்னிக்கு ஒரு புது படம் ரிலீஸ் ஆயிருக்கு. பெயரு கிருஷ்ண லீலா—","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d003","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"வாங்கலேன் செகண்ட் ஷோவுக்குப் போகலாம்.","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d004","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"நான் பார்த்துட்டேன் மாட்னிஷோவே. நீ போய் பார்த்துட்டு வா.","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d005","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"நானக்குப் போறேன்","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d006","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அடா போயேன். விஷயம் இல்லாமல் சொல்ல மாட்டேன். அதிலே லவ்சீன் ரொம்ப பிரமாதம், நான் பார்த்துட்டேன் நீ போயிட்டு வர்றியா?","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d007","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"சரி நான் போயிட்டு வர்றேன்.","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d008","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"ஹும்—போ—டேய் கருப்பா அம்மாகூட போயிட்டு வாடா—","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d009","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கருப்","text":"அய்ய நானும் கூட போகட்டுங்களா?","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d010","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அட போடா மடையா!","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d011","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"[தனக்குள்] அப்பாடா தொலைஞ்சது சனியன். ஆபத்பாந்தவா! அப்பனே! கல்யாணி விஷயத்தில் கொஞ்சம் கருணை காட்டேன். நீ யார் யாருக்கோ என்னென்னமோ பண்ணியாயே! கல்யாணி! கல்யாணி!","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d012","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"ஏன் எஜமான்?","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d013","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"காந்தா அவபாட்டுக்கு சினிமாவுக்குப் போயிட்டா. அந்தத் தண்ணுடையைக் கொஞ்சம் எடேன். செகண்ட்ஷோ...மண்ணுங்கட்டி பன்னிரண்டு மணிக்குத்தான் வருவாள். இனிமேல் எடுக்கிறதுக்கெல்லாம் உன்னைத்தான் கூப்பிடனும்—உனக்குப் படிக்கத் தெரியுமா?","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d014","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"தெரியும்.","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d015","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"பலே, பலே அப்படின்னு இந்த புத்தகங்களே எல்லாம் படி!","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d016","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"சரி எஜமான்—.","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d017","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"“விதவையின் காதல்”","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d018","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"ஆ!...[திகைக்கிறாள்]","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d019","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அப்படி ஒரு புத்தகம். யாரோ பாரதிதாசனும் விதவையைப் பற்றி சொல்லியிருக்கான் பாரு","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d020","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"சரி எஜமான் எனக்கு தூக்கம் வருகிறது.","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d021","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"எனக்கு தூக்கம் வரலியே? கல்யாணி உனக்கு எதிர்பாராத முத்தம் வேணுமா?","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d022","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"ஆ [திடுக்கிடுகிறாள்]","page_provenance":[{"pdf_page":33,"printed_page":32}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d023","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அதுவும் ஒரு புத்தகம்தான். என்னென்னவோ வந்திருக்கு. நானும் இப்படித்தான் பார்க்கிறேன்.\nஇந்த ரயில்லேயும் கார்லேயும் போயிட்டு வந்தது உடம்பிலேலாம் வலிக்குது கல்யாணி உடம்பை கொஞ்சம் பிடிச்சி விட்றியா?","page_provenance":[{"pdf_page":33,"printed_page":32},{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md","page_segments":[{"pdf_page":33,"printed_page":32,"text":"அதுவும் ஒரு புத்தகம்தான். என்னென்னவோ வந்திருக்கு. நானும் இப்படித்தான் பார்க்கிறேன்."},{"pdf_page":34,"printed_page":33,"text":"இந்த ரயில்லேயும் கார்லேயும் போயிட்டு வந்தது உடம்பிலேலாம் வலிக்குது கல்யாணி உடம்பை கொஞ்சம் பிடிச்சி விட்றியா?"}]},{"id":"parasakthi-s028-d024","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"(கண்ணீர் விடுகிறாள்)","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d025","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"பைத்தியம்! ஏங் கல்யாணி! அட அது ஒண்ணும் வேண்டாம்மா? அந்தத் தலையணையைக் கொஞ்சமெடேன்.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d026","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"எஜமான் ஒங்க தகுதிக்கு இது அழகல்ல நீங்க பெரிய மனுஷர்!","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d027","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அதுதான் அப்படி நடக்கிறேன். ஒரு பெரிய மனுஷன் நம்ம மேலே பிரியமாயிருக்காருன்னு நீ பெருமைப் பட வேண்டும்.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d028","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"எஜமான்! நான் நினைத்தால் உங்கள் வீட்டு வேலைக்காரியாக அல்ல—சீமாட்டியாக இருந்திருப்பேன்.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d029","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"இப்பவேதான் என்ன கெட்டாப்போச்சி! கல்யாணி ஒரு கண் ஜாடை! உன் விழியை அசைத்தால் போதும் பிறகு என் காலடியில் அடியேன் சிரஞ்சீவி அடிமை.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d030","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"சீ...காமப் பேய்!","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d031","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"என் உப்பை தின்னுட்டு எனக்கே துரோகமா?","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d032","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"உங்கள் உப்பு என் உழைப்புக்குத்தான் உடலுக்காக அல்ல. நான் உங்கள் வீட்டில் வேலை பார்க்கும் தொழிலாளி.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d033","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"பெரிய மனுஷர்களது அந்தப்புரத்திலே தொழிலாளி முதலாளி என்ற பிரச்சினைக்கே இடமில்லை.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d034","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"என்னைத் தொடமுயன்றால் என் பிணத்தைத்தான் பார்ப்பீர்கள்.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d035","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அப்படியாவது உயிரை விடு. சுடுகாடுவரைக்கும் தொட்டுக்கிட்டாவது வர்றேன். கல்யாணி நீதான் என்னின்ப எஜமாணி.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d036","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கல்","text":"அய்யோ அம்மா...(காந்தா வந்துவிடுதல்)","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d037","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"நல்லா இருக்கு ஒங்க லட்சணம்...ஊருக்குப் பெரிய மனுஷன்! என்னைக் கிருஷ்ண லீலாவுக்கு அனுப்பி விட்டு இங்கே நாராயண லீலாவா நடத்துறீங்க, வேலைக்காரி கிட்டேயே ஆரம்பிச்சாச்சா? உடம்பைப் பற்றித்தான் ஊர் சிரிப்பாச் சிரிக்குதே!","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d038","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"சினிமாவுக்குப் போனவ நீ எங்கடி இங்கே வந்தே.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d039","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கருப்","text":"அம்மா பாதியிலே வந்துட்டாங்க எஜமான்.","page_provenance":[{"pdf_page":34,"printed_page":33}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d040","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"எனக்குத்தான் இந்த நாராயணப் பிள்ளை சங்கதி தெரியாதா? அதுதான் அடுத்த வீட்டு எதிர்வீட்டு பொம்மைகள் கூட வரப்பயப்படுறங்களே!","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d041","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"அவுங்க எதுக்குடி இங்கே வருங்க!","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d042","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"ஆமா! ஒங்க அக்கா தங்கச்சியை ஒருவன் இப்படி கையைப் பிடிச்சிழுத்தால் நீங்க சும்மா இருப்பீங்களா?","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d043","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"என் இஷ்டத்துக்கு நான் செய்யறேன். நீ என்னடி என்னைக் கேக்கிறது?","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d044","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"அப்போ நானும் என் இஷ்டத்துக்கு யாரை யாவது கையைப்பிடிச்சி இழுத்திட்டு போகப்போகிறேன்.","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d045","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"போடிமுண்டி போ!","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d046","canonical_scene":28,"source_scene_heading":28,"speaker_label":"கருப்","text":"ஐயோ என்னங்க எஜமான்!","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d047","canonical_scene":28,"source_scene_heading":28,"speaker_label":"நாரா","text":"போவடி போவ்","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"},{"id":"parasakthi-s028-d048","canonical_scene":28,"source_scene_heading":28,"speaker_label":"காந்","text":"சீ! மனுஷனா யாரு! கல்யாணி நல்லா தாழ்ப்பாள் போட்டுக்கோ! ஏதாவது நாய்க்கும் வந்து நுழையும்!","page_provenance":[{"pdf_page":35,"printed_page":34}],"source_scene_file":"scene-28.md"}]}