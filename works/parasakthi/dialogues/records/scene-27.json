{"work_id":"parasakthi","canonical_scene":27,"source_scene_heading":27,"source_scene_file":"works/parasakthi/scenes/scene-27.md","record_count":3,"records":[{"id":"parasakthi-s027-d001","canonical_scene":27,"source_scene_heading":27,"speaker_label":"சேகர்","text":"அப்பா இறந்துபோய் விட்டார் கடைசியாக என் தங்கை இட்லிசுட்டு விற்க வேண்டியதாயிற்று. ஞான சேகரன் இறந்ததை நினைக்கும்போது பயமாக இருக்கிறது.","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-27.md"},{"id":"parasakthi-s027-d002","canonical_scene":27,"source_scene_heading":27,"speaker_label":"வந்த","text":"அவுங்க போட்டோ இருக்கா?","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-27.md"},{"id":"parasakthi-s027-d003","canonical_scene":27,"source_scene_heading":27,"speaker_label":"சேகர்","text":"கல்யாணி போட்டோ இல்லை. ஆனால் குண சேகரன் போட்டோ இருக்கு.","page_provenance":[{"pdf_page":32,"printed_page":31}],"source_scene_file":"scene-27.md"}]}