{"work_id":"parasakthi","canonical_scene":37,"source_scene_heading":37,"source_scene_file":"works/parasakthi/scenes/scene-37.md","record_count":8,"records":[{"id":"parasakthi-s037-d001","canonical_scene":37,"source_scene_heading":37,"speaker_label":"நொண்டி","text":"இராகவா இன்னிக்கு ஏதாவது விசேஷம் உண்டா?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d002","canonical_scene":37,"source_scene_heading":37,"speaker_label":"ராக","text":"பாலம் ஒரு பிச்சைக்காரி ஒரு குழந்தையுடன் வந்தாள் நாங்களெல்லாம் யாருன்னு கேட்டாள். நாங்கள் இரங்கூனிலே இருந்து சம்பாதிச்சிட்டு வர்றோம்னு சொன்னோம்... இரங்கூனிலேன்னுமன்று அண்ணன்மார்களைத் தெரியுமான்னு கேட்டாள். தெரியாதுன்னு சொல்லிவிட்டோம்.","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d003","canonical_scene":37,"source_scene_heading":37,"speaker_label":"நொ","text":"அவளது பெயரை என்னவென்று சொன்னாள்?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d004","canonical_scene":37,"source_scene_heading":37,"speaker_label":"ஒரு","text":"அதுநம்ம தமிழ்நாட்டு பெயராகவே தெரியலியே?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d005","canonical_scene":37,"source_scene_heading":37,"speaker_label":"ராக","text":"என்னமோ—சந்திரசேகரன்...","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d006","canonical_scene":37,"source_scene_heading":37,"speaker_label":"நொ","text":"சந்திரசேகரன், ஞானசேகரன், குணசேகரன் என்கிறாளா?","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d007","canonical_scene":37,"source_scene_heading":37,"speaker_label":"எல்","text":"ஆம்...","page_provenance":[{"pdf_page":43,"printed_page":42}],"source_scene_file":"scene-37.md"},{"id":"parasakthi-s037-d008","canonical_scene":3