{"work_id":"parasakthi","canonical_scene":20,"source_scene_heading":20,"source_scene_file":"works/parasakthi/scenes/scene-20.md","record_count":36,"records":[{"id":"parasakthi-s020-d001","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"வடை! முறுக்கு! அய்யா! முறுக்கு வேணுமா?","page_provenance":[{"pdf_page":24,"printed_page":23}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d002","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"மூணு அணாவுக்கு கொடு","page_provenance":[{"pdf_page":24,"printed_page":23}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d003","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"அட கடவுளே! போணி ஆயி மூணு நாள் ஆகுது வடை எவ்வளவுக்கு முறுக்கு எவ்வளவுக்கு?","page_provenance":[{"pdf_page":24,"printed_page":23}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d004","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"அட ரெண்டு அணாவுக்கு இதுவும் ஓரணாவுக்கு அதுவும் கொடப்பா! (கொடுக்கிறான்)","page_provenance":[{"pdf_page":24,"printed_page":23}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d005","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"ஏம்பா உன் கை நல்லா நடக்கும்லே?","page_provenance":[{"pdf_page":24,"printed_page":23}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d006","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"கை நடக்காது—கால் நடக்கும் (என்று செய்கை மூலம் காட்டுகிறான்)","page_provenance":[{"pdf_page":24,"printed_page":23}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d007","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"அய்யோ—பாவம் பசி அதிகம் போலிருக்கு? சாப்பிடு சாப்பிடு!","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d008","canonical_scene":20,"source_scene_heading":20,"speaker_label":"அடுத்த","text":"ஏ...முறுக்கு","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d009","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"இருங்க அய்யாகிட்டே காசு வாங்கிட்டு வர்றேன் காசு எடப்பா—உம்—காசு எடு—","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d010","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"(சிரிக்கிறான்)","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d011","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"ஏனப்பா சிரிக்கிறே?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d012","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"(மீண்டும் சிரிக்கிறான்)","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d013","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"அட! என்னப்பா மறுபடியும் சிரிக்கிறே காசை எடு நாலு தெருவுக்கு போகணும்.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d014","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"ஏன் பொறுக்கவா?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d015","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"யாரடா இவன் திமிறுபடைச்சவன் காசு எடுன்னா.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d016","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"டேய்!—காசா? உனக்கா? எதுக்கு?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d017","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"ஏம்பா மாமா மச்சான் மாதிரி விளையாடுறே, என்னை ஏமாத்தலாம்னு பாக்றயா என்னை யாருனு நினைச்சே!","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d018","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"அப்படின்னா இன்னும் ரெண்டணாவுக்குக் கொடு.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d019","canonical_scene":20,"source_scene_heading":20,"speaker_label":"வியா","text":"அப்படி வா வழிக்கு! இந்தா வாங்கிக்கோ? (கொடுக்கிறான்—சாப்பிடுகிறான்) காசு எடுப்பா—ம்—நேரமாகுது.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d020","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"(பைத்தியம்போல்) அடடா பயலே—","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d021","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"முதலாளி முறுக்கு வேணுமா?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d022","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"சூடா இருக்கா?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d023","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"ரெண்டும் இருக்கு","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d024","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"அப்ப எனக்கு இதிலே ஒரணவுக்கு அதிலே ஒரணவுக்கு கொடு.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d025","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"காசை எடு.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d026","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"அட முதல்ல கொடுப்பா","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d027","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"ஏங்க உங்களுக்கு ரெண்டணவுக்கு போதுமா?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d028","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"போதாது! காசை ரொம்ப செலவழிக்க கூடாது எப்பா ரெண்டு அணவுக்கு வாங்கியிருக்கேனே கொஞ்சம் ஓசி","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d029","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"அய்யோ இதிலே கூட உங்க பிச்சைக்கார புத்தி போகலியா! இந்தா ஓசி, (கொஞ்சம் பிட்டுக் கொடுக்கிறான்) காசை எடு.","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d030","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"காசா? ரூபாய்க்கு சில்லறை இருக்கா?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d031","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"என்ன?","page_provenance":[{"pdf_page":25,"printed_page":24}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d032","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"ஒரு ரூபாய்க்கு சில்லறை இருக்கா?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d033","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"சில்லறையா? எங்கிட்டேயா? அட பாவி கொண்டாடா. (ரூபாயை வாங்கி கையில் வைத்துக்கொண்டு) நல்ல சமயமடா இதை நழுவ விடுவாயோ—ஏதுங்காணும் இந்தக் காசு?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d034","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"ஏதுங் காணும் இந்தக் காசா?","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d035","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண","text":"டேய் ‘எய்ட் நாட்திரீ’ கொண்டு போடா இந்தக் கொட்டாபுளியை [ரூபாயுடன் ஓடி விடுகிறான்]","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-20.md"},{"id":"parasakthi-s020-d036","canonical_scene":20,"source_scene_heading":20,"speaker_label":"முத","text":"சரிதான் பெட்டி இருக்குதல்ல","page_provenance":[{"pdf_page":26,"printed_page":25}],"source_scene_file":"scene-20.md"}]}