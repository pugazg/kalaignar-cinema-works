 அப்பா ஒன்கிட்டே கொடுத்திருக்காரு பயப்பட்றியே...","page_provenance":[{"pdf_page":22,"printed_page":21}],"source_scene_file":"scene-18.md"},{"id":"parasakthi-s018-d009","canonical_scene":18,"source_scene_heading":18,"speaker_label":"1வது","text":"சாவிதானே...எனக்கு அடிக்கடி காக்கா வலிப்பு வர்றது வழக்கம் அதனாலே கொடுத்திருக்காரு.","page_provenance":[{"pdf_page":22,"printed_page":21}],"source_scene_file":"scene-18.md"},{"id":"parasakthi-s018-d010","canonical_scene":18,"source_scene_heading":18,"speaker_label":"வேணு","text":"ஏய்—அங்கே வர்றியா போவோம்...","page_provenance":[{"pdf_page":23,"printed_page":22}],"source_scene_file":"scene-18.md"},{"id":"parasakthi-s018-d011","canonical_scene":18,"source_scene_heading":18,"speaker_label":"1வது","text":"எங்கே?","page_provenance":[{"pdf_page":23,"printed_page":22}],"source_scene_file":"scene-18.md"}]}