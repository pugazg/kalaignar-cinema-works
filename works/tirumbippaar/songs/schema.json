{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tirumbippaar-song-inventory-schema",
  "title": "Tirumbippaar song / performance inventory record",
  "description": "Source-led derivative for song, chant and singing-reference blocks. Canonical Tamil remains authoritative; authorship is never inferred from performer, proximity or the cover story-dialogue credit.",
  "type": "object",
  "required": [
    "id",
    "canonical_scene",
    "candidate_kind",
    "source_text_ta",
    "pdf_pages",
    "printed_pages",
    "canonical_scene_file",
    "printed_text_extent",
    "authorship"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tirumbippaar-song-[0-9]{3}$"
    },
    "canonical_scene": {
      "type": "integer",
      "minimum": 1,
      "maximum": 93
    },
    "candidate_kind": {
      "enum": [
        "performance-reference-no-printed-lyrics",
        "standalone-chant",
        "named-song-reference",
        "named-song-reprise"
      ]
    },
    "source_text_ta": {
      "type": "string",
      "minLength": 1
    },
    "pdf_pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "printed_pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "canonical_scene_file": {
      "type": "string",
      "pattern": "^../scenes/scene-[0-9]{2}\\.md$"
    },
    "dialogue_index_overlap": {
      "type": "boolean"
    },
    "printed_text_extent": {
      "enum": [
        "performance-reference-only",
        "chant-block",
        "title-or-refrain-only"
      ]
    },
    "performance_context": {
      "type": "string"
    },
    "relation": {
      "type": ["object", "null"],
      "properties": {
        "type": {"enum": ["reprise-of"]},
        "target_id": {"type": "string", "pattern": "^tirumbippaar-song-[0-9]{3}$"}
      },
      "required": ["type", "target_id"],
      "additionalProperties": false
    },
    "authorship": {
      "type": "object",
      "required": ["status", "lyricist_ta", "evidence_basis", "evidence_reference", "notes"],
      "properties": {
        "status": {"enum": ["verified", "review", "unresolved"]},
        "lyricist_ta": {"type": ["string", "null"]},
        "evidence_basis": {
          "enum": [
            "canonical-context-explicit",
            "printed-item-credit",
            "external-source",
            "none"
          ]
        },
        "evidence_reference": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
