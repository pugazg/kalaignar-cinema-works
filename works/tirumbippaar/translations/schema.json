{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tirumbippaar-translation-scene-record-schema",
  "title": "Tirumbippaar source-linked English translation scene record",
  "description": "Schema for the scene-sharded English derivative. It supports both the richer early units and the later compact units while keeping canonical Tamil external and authoritative.",
  "type": "object",
  "required": ["work_id", "target_language", "canonical_scene", "scene_status", "unit_count", "units"],
  "properties": {
    "work_id": {"const": "tirumbippaar"},
    "target_language": {"const": "en"},
    "canonical_scene": {"type": "integer", "minimum": 1, "maximum": 93},
    "pilot_status": {"enum": ["draft", "review", "verified"]},
    "scene_status": {"enum": ["draft", "review", "verified"]},
    "unit_count": {"type": "integer", "minimum": 0},
    "units": {
      "type": "array",
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "page_provenance": {
      "type": "object",
      "required": ["pdf_page", "printed_page"],
      "properties": {
        "pdf_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "source_locator": {
      "type": ["object", "null"],
      "properties": {
        "kind": {"type": "string"},
        "ordinal": {"type": "integer", "minimum": 1},
        "description": {"type": "string"}
      },
      "required": ["kind", "ordinal", "description"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["page_provenance"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "canonical_scene_path": {"type": ["string", "null"]},
        "source_record_id": {"type": ["string", "null"]},
        "source_occurrence_id": {"type": ["string", "null"]},
        "source_locator": {"$ref": "#/$defs/source_locator"},
        "speaker_label": {"type": ["string", "null"]},
        "page_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/page_provenance"}
        }
      },
      "additionalProperties": true
    },
    "english_page_segment": {
      "type": "object",
      "required": ["pdf_page", "printed_page", "english_text"],
      "properties": {
        "pdf_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": "integer", "minimum": 1},
        "english_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "properties": {
        "english_text": {"type": "string", "minLength": 1},
        "english_lines": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "english_page_segments": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/english_page_segment"}
        },
        "mode": {"enum": ["prose-faithful", "semantic-poetic"]},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "anyOf": [
        {"required": ["english_text"]},
        {"required": ["english_lines"]}
      ],
      "additionalProperties": true
    },
    "unit": {
      "type": "object",
      "required": ["id", "kind", "status", "source", "translation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tirumbippaar-en-s[0-9]{3}-u[0-9]{3}$"
        },
        "kind": {
          "enum": ["dialogue", "stage-direction", "song", "song-reference", "chant", "written-text"]
        },
        "status": {"enum": ["draft", "review", "verified"]},
        "target_language": {"const": "en"},
        "canonical_scene": {"type": "integer", "minimum": 1, "maximum": 93},
        "source": {"$ref": "#/$defs/source"},
        "translation": {"$ref": "#/$defs/translation"}
      },
      "additionalProperties": true
    }
  }
}
