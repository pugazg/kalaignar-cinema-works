{"work_id":"tirumbippaar","target_language":"en","canonical_scene":32,"scene_status":"verified","unit_count":35,"units":[{"id":"tirumbippaar-en-s032-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"(A labourer who has carried in a bale of paper speaks angrily.)"}},{"id":"tirumbippaar-en-s032-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d001","speaker_label":"கூலி","page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"I've carried such a huge load all this way. Pay me properly...."}},{"id":"tirumbippaar-en-s032-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"Eight annas, that's all. Take it and leave respectfully! Nonsense...."}},{"id":"tirumbippaar-en-s032-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d003","speaker_label":"கூலி","page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"What, sir? You're a big man, yet you use such petty words. ‘Nonsense,’ is it?...."}},{"id":"tirumbippaar-en-s032-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"(Paranthaman strikes him hard two or three times.)"}},{"id":"tirumbippaar-en-s032-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d004","speaker_label":"கூலி","page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"Don't hit me, sir. I am a worker!...."}},{"id":"tirumbippaar-en-s032-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"Worker! A worker, he says... Run...run...."}},{"id":"tirumbippaar-en-s032-u008","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":38,"printed_page":30}]},"translation":{"english_text":"(The labourer runs outside.)"}},{"id":"tirumbippaar-en-s032-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d006","speaker_label":"கருடன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"They should take whatever money they're given. These fellows all need to be kicked like this."}},{"id":"tirumbippaar-en-s032-u010","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"(They look at the office boy; he stands covering his mouth.)"}},{"id":"tirumbippaar-en-s032-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"‘The Voice of the Toiler’! Garuda! The title has turned out well, hasn't it? (Leafing through the book.)"}},{"id":"tirumbippaar-en-s032-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d008","speaker_label":"கருடன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"Not just the title! Five thousand copies sold in two days! What more do we need?"}},{"id":"tirumbippaar-en-s032-u013","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"(Paranthaman lights a cigarette. ‘The Voice of the Toiler’ lies on the table. Punnakodi enters.)"}},{"id":"tirumbippaar-en-s032-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d009","speaker_label":"கருடன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"Who are you?"}},{"id":"tirumbippaar-en-s032-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d010","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"Don't you know me? I am the labour leader. You know why I've come...."}},{"id":"tirumbippaar-en-s032-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d011","speaker_label":"கருடன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"What is it, sir?...."}},{"id":"tirumbippaar-en-s032-u017","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"(Garudan and Paranthaman look alert.)"}},{"id":"tirumbippaar-en-s032-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d012","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"The workers are asking for higher wages, and about that agitation...."}},{"id":"tirumbippaar-en-s032-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d013","speaker_label":"கருடன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"No, sir, he wasn't asking for wages. He carried this paper bale here...."}},{"id":"tirumbippaar-en-s032-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d014","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"Not him! I mean the mill workers."}},{"id":"tirumbippaar-en-s032-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d015","speaker_label":"கருடன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"Yes, yes. Employers who ignore workers' problems must not be spared."}},{"id":"tirumbippaar-en-s032-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d016","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"Garuda! What use is shouting with our mouths? If the voice of the toilers is to gain strength, we must launch a great agitation...."}},{"id":"tirumbippaar-en-s032-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d017","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":39,"printed_page":31}]},"translation":{"english_text":"That's the way to speak...."}},{"id":"tirumbippaar-en-s032-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d018","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"The toilers are the backbone of this country. The working class is the very life of a nation. We must not let it wither! I have taken a solemn vow. We must soon begin the struggle for workers' liberation."}},{"id":"tirumbippaar-en-s032-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d019","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Bravo! Bravo! If there are truly resolute young men like you, liberation will dawn for the whole world in a single day. Reading your ‘The Voice of the Toiler’ turns even a decrepit old man into a youth, and a coward into a tiger. You must preside over tomorrow's public meeting."}},{"id":"tirumbippaar-en-s032-u026","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d020","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Preside? Me? No, I am a servant of the public."}},{"id":"tirumbippaar-en-s032-u027","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d021","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"No, brother! Don't say that! Thousands of workers want it too."}},{"id":"tirumbippaar-en-s032-u028","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d022","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Workers are my comrades! I shall fulfil their loving command. From now on, everything the worker desires must happen in this world."}},{"id":"tirumbippaar-en-s032-u029","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d023","speaker_label":"கருடன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Yes...yes...."}},{"id":"tirumbippaar-en-s032-u030","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"(The office boy holds out his hand to Garudan.)"}},{"id":"tirumbippaar-en-s032-u031","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d024","speaker_label":"பையன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"A higher salary...."}},{"id":"tirumbippaar-en-s032-u032","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d025","speaker_label":"கருடன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Shoo, get lost! We're discussing great matters of the world...."}},{"id":"tirumbippaar-en-s032-u033","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d026","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Then I'll be going, sir...."}},{"id":"tirumbippaar-en-s032-u034","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d027","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"Namaskaram."}},{"id":"tirumbippaar-en-s032-u035","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s032-d028","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":40,"printed_page":32}]},"translation":{"english_text":"(To Garudan) I'll be going, sir!"}}]}