{"work_id":"tirumbippaar","target_language":"en","canonical_scene":71,"scene_status":"verified","unit_count":14,"units":[{"id":"tirumbippaar-en-s071-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"(Hotel.)"}},{"id":"tirumbippaar-en-s071-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d001","speaker_label":"கருடன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"I've arranged everything."}},{"id":"tirumbippaar-en-s071-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"Ah—what is she like? Is she beautiful?"}},{"id":"tirumbippaar-en-s071-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d003","speaker_label":"கருடன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"She possesses thirty-three marks of beauty."}},{"id":"tirumbippaar-en-s071-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d004","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"What, man—you've added one new mark!"}},{"id":"tirumbippaar-en-s071-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d005","speaker_label":"கருடன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"You'll know that mark when you see her in person."}},{"id":"tirumbippaar-en-s071-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d006","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"Ah!"}},{"id":"tirumbippaar-en-s071-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d007","speaker_label":"கருடன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"Though born a courtesan, she's just the sort of golden creeper you would describe, Paranthama!"}},{"id":"tirumbippaar-en-s071-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d008","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"Garuda!"}},{"id":"tirumbippaar-en-s071-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d009","speaker_label":"கருடன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"The moment I saw her, an idea came to me!"}},{"id":"tirumbippaar-en-s071-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d010","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"What?"}},{"id":"tirumbippaar-en-s071-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d011","speaker_label":"கருடன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"We could put her on the cover of the second edition of our book 'Vaazhu'!"}},{"id":"tirumbippaar-en-s071-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s071-d012","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"Oh, keep quiet, you businessman!"}},{"id":"tirumbippaar-en-s071-u014","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"(Paranthaman leaves for the courtesan's house.)"}}]}