{"work_id":"tirumbippaar","target_language":"en","canonical_scene":39,"scene_status":"verified","unit_count":25,"units":[{"id":"tirumbippaar-en-s039-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":50,"printed_page":42}]},"translation":{"english_text":"(Mill-strike posters have been pasted on walls throughout the town.)"}},{"id":"tirumbippaar-en-s039-u002","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":50,"printed_page":42}]},"translation":{"english_text":"(Inside the mill owner's room.)"}},{"id":"tirumbippaar-en-s039-u003","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":50,"printed_page":42}]},"translation":{"english_text":"(Paranthaman and Garudan arrive.)"}},{"id":"tirumbippaar-en-s039-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d001","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":50,"printed_page":42}]},"translation":{"english_text":"Come....sit down!...."}},{"id":"tirumbippaar-en-s039-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":50,"printed_page":42}]},"translation":{"english_text":"(The two remain standing.)"}},{"id":"tirumbippaar-en-s039-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"Why did you call us?"}},{"id":"tirumbippaar-en-s039-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"(The two sit down.)"}},{"id":"tirumbippaar-en-s039-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d003","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"Hmm...about this strike...."}},{"id":"tirumbippaar-en-s039-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d004","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"It is all my arrangement—thousands of workers are ready to follow the path I showed them."}},{"id":"tirumbippaar-en-s039-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d005","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"Mr Paranthaman! I know that only you can stop the mill workers' agitation."}},{"id":"tirumbippaar-en-s039-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d006","speaker_label":"கருடன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"Any doubt about that! If not for Paranthaman, by now they would have destroyed the mill itself!"}},{"id":"tirumbippaar-en-s039-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"And they were even about to endanger your life! I was the one who stopped them!"}},{"id":"tirumbippaar-en-s039-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d008","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"I'm pleased! Many thanks for saving my life! As a small token of help from me, I offer you these five thousand rupees."}},{"id":"tirumbippaar-en-s039-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d009","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"What...money?"}},{"id":"tirumbippaar-en-s039-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d010","speaker_label":"கருடன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"Take it! We can add it to the workers' fund! After all, we were born only to labour for the poor!"}},{"id":"tirumbippaar-en-s039-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d011","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"I am not giving this thinking of it as a bribe."}},{"id":"tirumbippaar-en-s039-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d012","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"And I am not accepting it thinking of it that way either."}},{"id":"tirumbippaar-en-s039-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d013","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"If you can somehow stop this strike....."}},{"id":"tirumbippaar-en-s039-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d014","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"It can be stopped. But that is possible only if Punnakodi is changed over!"}},{"id":"tirumbippaar-en-s039-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d015","speaker_label":"கருடன்","page_provenance":[{"pdf_page":51,"printed_page":43}]},"translation":{"english_text":"Punnakodi....he'll ask for at least three thousand!"}},{"id":"tirumbippaar-en-s039-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d016","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"I'll give it! I'll give it right now."}},{"id":"tirumbippaar-en-s039-u022","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"(He takes out the money and gives it.)"}},{"id":"tirumbippaar-en-s039-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d017","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"For the sake of your good nature, and because I want our friendship to continue, I am giving up a major agitation."}},{"id":"tirumbippaar-en-s039-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s039-d018","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"Many thanks!"}},{"id":"tirumbippaar-en-s039-u025","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"(The two rise.)"}}]}