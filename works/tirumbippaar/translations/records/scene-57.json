{"work_id":"tirumbippaar","target_language":"en","canonical_scene":57,"scene_status":"verified","unit_count":62,"units":[{"id":"tirumbippaar-en-s057-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"(In Kumudha's house in Madras. Pandiyan, freshly bathed and in new clothes, is seated in the morning. Kumudha sits opposite drinking coffee. Poomaal arrives from Coimbatore.)"}},{"id":"tirumbippaar-en-s057-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d001","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Chinnamma! Amma is coming!"}},{"id":"tirumbippaar-en-s057-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d002","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"She didn't even write beforehand that she was coming."}},{"id":"tirumbippaar-en-s057-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d003","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"She has come like this because the happiness is greater when someone arrives unexpectedly...!"}},{"id":"tirumbippaar-en-s057-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d004","speaker_label":"குமுதா","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Is everyone well, Chinnamma?"}},{"id":"tirumbippaar-en-s057-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d005","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Has Chinnappa sent Kumudha-amma any present?..."}},{"id":"tirumbippaar-en-s057-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d006","speaker_label":"குமுதா","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Hmm. He has sent one, da. Earrings for the ears, a necklace for the neck!..."}},{"id":"tirumbippaar-en-s057-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d007","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"(To Gundumani.) Here, take this box inside."}},{"id":"tirumbippaar-en-s057-u009","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"(Gundumani takes the box inside. Poomaal takes out the apples she has brought and gives them.)"}},{"id":"tirumbippaar-en-s057-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d008","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Hmm. Now you've brought fruit. When you come again four months from now, bring a spinning top, a toy cart, baby clothes, a rattle and all that...","notes":["The list contains colloquial/irregular printed wording; it is rendered conservatively from the supported context."]}},{"id":"tirumbippaar-en-s057-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d009","speaker_label":"குமுதா","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Hey, go bring coffee, da."}},{"id":"tirumbippaar-en-s057-u012","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"(Gundumani goes.)"}},{"id":"tirumbippaar-en-s057-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d010","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Why, Kumudha, are you angry because he told the truth?"}},{"id":"tirumbippaar-en-s057-u014","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"(The police enter the house. Everyone inside is startled.)"}},{"id":"tirumbippaar-en-s057-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d011","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Come... sit down..."}},{"id":"tirumbippaar-en-s057-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d012","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"No time to sit. You are Pandiyan, aren't you?"}},{"id":"tirumbippaar-en-s057-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d013","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Yes..."}},{"id":"tirumbippaar-en-s057-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d014","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"We have to search your house in connection with the Kuniyamuthur highway robbery..."}},{"id":"tirumbippaar-en-s057-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d015","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"My house?"}},{"id":"tirumbippaar-en-s057-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d016","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":72,"printed_page":64}]},"translation":{"english_text":"Yes!..."}},{"id":"tirumbippaar-en-s057-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d017","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"What are you saying, sir..."}},{"id":"tirumbippaar-en-s057-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d018","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"I'm not saying it; this order says it! Eight seven six, come on...."}},{"id":"tirumbippaar-en-s057-u023","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"(Poomaal and Kumudha are startled. The house is searched; police look everywhere.)"}},{"id":"tirumbippaar-en-s057-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d019","speaker_label":"குமுதா","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Chinnamma! (She embraces her.)"}},{"id":"tirumbippaar-en-s057-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d020","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Be quiet. Be quiet. It's nothing."}},{"id":"tirumbippaar-en-s057-u026","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d021","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Kumudha! Foolish girl! What is this! Why are you afraid? One need fear only if there is guilt."}},{"id":"tirumbippaar-en-s057-u027","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"(The police search all the boxes. They find no evidence of any kind.)"}},{"id":"tirumbippaar-en-s057-u028","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d022","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Hmm... nothing's turning up."}},{"id":"tirumbippaar-en-s057-u029","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d023","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Why, sir, are you leaving this one behind? Shouldn't you look at this too?... (To Poomaal.) Give them the key, amma!..."}},{"id":"tirumbippaar-en-s057-u030","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"(Poomaal gives the key and the box is opened.)"}},{"id":"tirumbippaar-en-s057-u031","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d024","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Why are you getting angry, boy! We're only doing our duty."}},{"id":"tirumbippaar-en-s057-u032","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"(As the clothes are taken out and examined, a necklace is found at the bottom. Poomaal is shocked. The Sub-Inspector turns the necklace over and over and looks at it. On its back are the letters 'Usha.')"}},{"id":"tirumbippaar-en-s057-u033","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d025","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"Usha! This is it."}},{"id":"tirumbippaar-en-s057-u034","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":73,"printed_page":65}]},"translation":{"english_text":"(Kumudha, Pandiyan and Poomaal are stunned.)"}},{"id":"tirumbippaar-en-s057-u035","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d026","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"We've found it. Pandiyan, I am arresting you."}},{"id":"tirumbippaar-en-s057-u036","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d027","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Ah!"}},{"id":"tirumbippaar-en-s057-u037","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d028","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"This is my box, sir. Let him go...."}},{"id":"tirumbippaar-en-s057-u038","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d029","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Shh! Say whatever you have to say in court. No one interfere with my work. (To the police.) Hmm... take him away!...."}},{"id":"tirumbippaar-en-s057-u039","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d030","speaker_label":"குமுதா","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"(Running to Pandiyan and crying.) Pandiyan! Pandiyan!"}},{"id":"tirumbippaar-en-s057-u040","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d031","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Kumudha!"}},{"id":"tirumbippaar-en-s057-u041","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d032","speaker_label":"குமுதா","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"What is this, Pandiyan? I don't understand anything....."}},{"id":"tirumbippaar-en-s057-u042","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d033","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"You don't understand? This is the world!"}},{"id":"tirumbippaar-en-s057-u043","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d034","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Sub-Inspector sir! I am the one who came from out of town. This is my box. Pandiyan has committed no offence. Let him go."}},{"id":"tirumbippaar-en-s057-u044","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d035","speaker_label":"சப்-இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Don't cause trouble. Hmm...... take him away."}},{"id":"tirumbippaar-en-s057-u045","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"(Pandiyan is taken away.)"}},{"id":"tirumbippaar-en-s057-u046","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d036","speaker_label":"குமுதா","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"(Standing stunned and crying.) Pandiyan, Pandiyan...... (She runs.)"}},{"id":"tirumbippaar-en-s057-u047","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"(Pandiyan is put into the jeep. Poomaal catches and embraces Kumudha as she runs after him crying.)"}},{"id":"tirumbippaar-en-s057-u048","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d037","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Kumudha... be calm!... Don't cry! Don't cry!"}},{"id":"tirumbippaar-en-s057-u049","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d038","speaker_label":"குமுதா","page_provenance":[{"pdf_page":74,"printed_page":66}]},"translation":{"english_text":"Are you telling me not to cry but to rejoice? How can happiness come to me? Did I come here having vowed to send him to jail, so that I could rejoice once the deed succeeded......"}},{"id":"tirumbippaar-en-s057-u050","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d039","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Kumudha!"}},{"id":"tirumbippaar-en-s057-u051","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d040","speaker_label":"குமுதா","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Why, Chinnamma, did you ruin our life like this?"}},{"id":"tirumbippaar-en-s057-u052","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d041","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Kumudha! I knew nothing of any crime, Kumudha! Without even knowing it myself, I have been used as a pawn in someone's game!"}},{"id":"tirumbippaar-en-s057-u053","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d042","speaker_label":"குமுதா","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Whose game! Why hide it? It is all your younger brother's game!... I know!... The two of you together planned to destroy our happy life...."}},{"id":"tirumbippaar-en-s057-u054","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d043","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Kumudha! Even if you cannot understand the conspiracy created by circumstance, have you forgotten even that your Chinnamma has a heart?"}},{"id":"tirumbippaar-en-s057-u055","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d044","speaker_label":"குமுதா","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"You have a heart. In it there is room only for your younger brother's welfare and gain."}},{"id":"tirumbippaar-en-s057-u056","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d045","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"(Crying out.) Kumudha!"}},{"id":"tirumbippaar-en-s057-u057","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d046","speaker_label":"குமுதா","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Paranthaman is furious that Kumudha, who should have been one of the dolls in his bedchamber, became the beloved of his enemy Pandiyan! And you are furious that Pandiyan, who should have been your lover, lies fondling Kumudha!"}},{"id":"tirumbippaar-en-s057-u058","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d047","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"Ah! What did you say! You sinner!"}},{"id":"tirumbippaar-en-s057-u059","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d048","speaker_label":"குமுதா","page_provenance":[{"pdf_page":75,"printed_page":67}]},"translation":{"english_text":"There is nothing more to say. As of today the bonds, affection and kinship of this house are all over. Here are the gold ornaments you fastened on me! Take the jewels! (She removes the ornaments and throws them down.) Live happily with your younger brother! I am leaving..."}},{"id":"tirumbippaar-en-s057-u060","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d049","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Kumudha!...."}},{"id":"tirumbippaar-en-s057-u061","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s057-d050","speaker_label":"குமுதா","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Don't touch me! From now on, who am I? Who are you?"}},{"id":"tirumbippaar-en-s057-u062","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"(She runs away. Poomaal stands motionless.)"}}]}