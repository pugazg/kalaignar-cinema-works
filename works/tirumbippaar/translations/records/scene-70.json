{"work_id":"tirumbippaar","target_language":"en","canonical_scene":70,"scene_status":"verified","unit_count":17,"units":[{"id":"tirumbippaar-en-s070-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"(Garudan Publishing House.)"}},{"id":"tirumbippaar-en-s070-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d001","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"The police have gone to arrest Punnakodi! They'll be here in a little while!"}},{"id":"tirumbippaar-en-s070-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d002","speaker_label":"கருடன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Then where do we run now!"}},{"id":"tirumbippaar-en-s070-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d003","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Only by fleeing in disguise can we escape the police's eyes."}},{"id":"tirumbippaar-en-s070-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d004","speaker_label":"கருடன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"A disguise?"}},{"id":"tirumbippaar-en-s070-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Yes. What disguise shall we put on?"}},{"id":"tirumbippaar-en-s070-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d006","speaker_label":"கருடன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"You know how to act like a madman!"}},{"id":"tirumbippaar-en-s070-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Tch. That's old now. The police will understand!"}},{"id":"tirumbippaar-en-s070-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d008","speaker_label":"கருடன்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Then are we simply supposed to get caught?"}},{"id":"tirumbippaar-en-s070-u010","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"(Hearing the sound of a police jeep, they run away. The office boy wakes from sleep upstairs and comes down. The police arrive.)"}},{"id":"tirumbippaar-en-s070-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d009","speaker_label":"இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Hey... where is Garudan?"}},{"id":"tirumbippaar-en-s070-u012","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"(The boy stares in a sleepy daze.)"}},{"id":"tirumbippaar-en-s070-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d010","speaker_label":"இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"Where is Paranthaman?"}},{"id":"tirumbippaar-en-s070-u014","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"(He stares again, rubbing his eyes.)"}},{"id":"tirumbippaar-en-s070-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d011","speaker_label":"இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":86,"printed_page":78}]},"translation":{"english_text":"You won't tell the truth. You're one of their men too, aren't you?"}},{"id":"tirumbippaar-en-s070-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d012","speaker_label":"பையன்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"No, sir! I'm a red lotus that bloomed in the mud! Let me go!"}},{"id":"tirumbippaar-en-s070-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s070-d013","speaker_label":"இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":87,"printed_page":79}]},"translation":{"english_text":"Hmm... search the place."}}]}