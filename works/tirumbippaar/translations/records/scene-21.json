{"work_id":"tirumbippaar","target_language":"en","canonical_scene":21,"scene_status":"verified","unit_count":12,"units":[{"id":"tirumbippaar-en-s021-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d001","speaker_label":"சமையல்காரி","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Amma! Chinnamma, come!"}},{"id":"tirumbippaar-en-s021-u002","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"(Kumudha comes running.)"}},{"id":"tirumbippaar-en-s021-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d002","speaker_label":"குமுதா","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Chinnamma!"}},{"id":"tirumbippaar-en-s021-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d003","speaker_label":"பூமால்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Kumudha! (They embrace.)"}},{"id":"tirumbippaar-en-s021-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d004","speaker_label":"குமுதா","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"(Looking at Pandiyan) Chinnamma, he is..."}},{"id":"tirumbippaar-en-s021-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d005","speaker_label":"பூமால்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Would you know if I told you?"}},{"id":"tirumbippaar-en-s021-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d006","speaker_label":"குமுதா","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"I know without being told. The author of 'Vaazhu, Vaazha Vidu.' Your name is Pandiyan, isn't it?"}},{"id":"tirumbippaar-en-s021-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d007","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Yes."}},{"id":"tirumbippaar-en-s021-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d008","speaker_label":"சமையல்காரி","page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"Who? That Pandiyan who killed Kovalan?..."}},{"id":"tirumbippaar-en-s021-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d009","speaker_label":"குணமணி","page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"Of course...Soundara Pandiyan. Just look at the man!..."}},{"id":"tirumbippaar-en-s021-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s021-d010","speaker_label":"குமுதா","page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"Come, first let's have coffee...."}},{"id":"tirumbippaar-en-s021-u012","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"(Scene ends.)"}}]}