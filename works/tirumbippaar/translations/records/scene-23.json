{"work_id":"tirumbippaar","target_language":"en","canonical_scene":23,"scene_status":"verified","unit_count":3,"units":[{"id":"tirumbippaar-en-s023-u001","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"(A tiger in a cage.)"}},{"id":"tirumbippaar-en-s023-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s023-d001","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"(To Bama) What would you do if I pushed you into the tiger's mouth?"}},{"id":"tirumbippaar-en-s023-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s023-d002","speaker_label":"பாமா","page_provenance":[{"pdf_page":30,"printed_page":22}]},"translation":{"english_text":"I'd turn into grass.... Even when a tiger is hungry, it won't eat grass!"}}]}