{"work_id":"tirumbippaar","target_language":"en","canonical_scene":55,"scene_status":"verified","unit_count":16,"units":[{"id":"tirumbippaar-en-s055-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"(Poomaal is preparing to leave town. Paranthaman comes there.)"}},{"id":"tirumbippaar-en-s055-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d001","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"Where are you travelling to, akka?"}},{"id":"tirumbippaar-en-s055-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d002","speaker_label":"பூமால்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"To Madras...."}},{"id":"tirumbippaar-en-s055-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d003","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"Why Madras all of a sudden!"}},{"id":"tirumbippaar-en-s055-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d004","speaker_label":"பூமால்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"What? I'm going to see Kumudha. Am I not allowed to go?"}},{"id":"tirumbippaar-en-s055-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"I'm saying you shouldn't.... Hmm.... Yes, Pandiyan is in Madras, isn't he!..."}},{"id":"tirumbippaar-en-s055-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d006","speaker_label":"பூமால்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"Yes. Why are you asking all that? For you there are no townspeople or relatives, no good people or bad people anyway."}},{"id":"tirumbippaar-en-s055-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"I did that somehow in a fit of anger, akka."}},{"id":"tirumbippaar-en-s055-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d008","speaker_label":"பூமால்","page_provenance":[{"pdf_page":69,"printed_page":61}]},"translation":{"english_text":"A fine fit of anger. If you had missed by just a little, Kumudha would have become a widow."}},{"id":"tirumbippaar-en-s055-u010","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"(She goes inside. He puts the necklace in a box. When Poomaal returns...)"}},{"id":"tirumbippaar-en-s055-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d009","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"If I have done anything wrong, forgive me, akka! (Poomaal looks at him.) It was wrong of me to try to shoot Pandiyan. She would never expose me...","notes":["The final pronoun is retained as printed rather than resolved editorially."]}},{"id":"tirumbippaar-en-s055-u012","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"(The maid comes.)"}},{"id":"tirumbippaar-en-s055-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d010","speaker_label":"வேலைக்காரி","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"It's time, amma."}},{"id":"tirumbippaar-en-s055-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d011","speaker_label":"பூமால்","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"(To Paranthaman) Shall I leave?"}},{"id":"tirumbippaar-en-s055-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s055-d012","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"All right, akka! Tell everyone I asked after them! Give Pandiyan and Kumudha my fullest blessings!"}},{"id":"tirumbippaar-en-s055-u016","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"(Scene ends.)"}}]}