{"work_id":"tirumbippaar","target_language":"en","canonical_scene":24,"scene_status":"verified","unit_count":4,"units":[{"id":"tirumbippaar-en-s024-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s024-d001","speaker_label":"பாமா","page_provenance":[{"pdf_page":31,"printed_page":23}]},"translation":{"english_text":"The blue sea—what a beautiful sight!"}},{"id":"tirumbippaar-en-s024-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s024-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":31,"printed_page":23}]},"translation":{"english_text":"If this sea were suddenly to surge..."}},{"id":"tirumbippaar-en-s024-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s024-d003","speaker_label":"பாமா","page_provenance":[{"pdf_page":31,"printed_page":23}]},"translation":{"english_text":"There is always danger beside beauty."}},{"id":"tirumbippaar-en-s024-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s024-d004","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":31,"printed_page":23}]},"translation":{"english_text":"Many people never understand that."}}]}