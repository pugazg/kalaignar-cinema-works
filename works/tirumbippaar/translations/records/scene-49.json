{"work_id":"tirumbippaar","target_language":"en","canonical_scene":49,"scene_status":"corrected-source-reconciled","unit_count":25,"units":[{"id":"tirumbippaar-en-s049-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"(The car stops. Paranthaman and Punyakodi get down.)"}},{"id":"tirumbippaar-en-s049-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d001","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Come! Come inside."}},{"id":"tirumbippaar-en-s049-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"You conducted the wedding very economically, didn't you...."}},{"id":"tirumbippaar-en-s049-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d003","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Yes.... (turning inside) Radha, Radha, come here for a moment."}},{"id":"tirumbippaar-en-s049-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"(Radha comes and stands there; indicating her.)"}},{"id":"tirumbippaar-en-s049-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d004","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"This is...."}},{"id":"tirumbippaar-en-s049-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Oh... Pandiyan has a younger sister too?"}},{"id":"tirumbippaar-en-s049-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d006","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Younger sister! She's his stepmother! My wife..."}},{"id":"tirumbippaar-en-s049-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Oh... is that so...."}},{"id":"tirumbippaar-en-s049-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d008","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"(Silly laugh) Radha! If there's tea or coffee, bring something quickly..."}},{"id":"tirumbippaar-en-s049-u011","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"(Radha goes inside.)"}},{"id":"tirumbippaar-en-s049-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d009","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"A girl worth her weight in gold! Only one defect—she is mute! She's somewhat educated..."}},{"id":"tirumbippaar-en-s049-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d010","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"Can she sing?"}},{"id":"tirumbippaar-en-s049-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d011","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"How can she sing, brother? I'm telling you she's mute..."}},{"id":"tirumbippaar-en-s049-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d012","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"Oh! Does a cuckoo call by speaking words? It makes some sound; even that they call the cuckoo singing."}},{"id":"tirumbippaar-en-s049-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d013","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"Hee, hee, hee... yes... yes. You said that very well."}},{"id":"tirumbippaar-en-s049-u017","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"(Radha comes to the table with coffee.)"}},{"id":"tirumbippaar-en-s049-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d014","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"At this old age, marrying is so that you can have her cook for you and eat, have her sing music and enjoy it, isn't it?"}},{"id":"tirumbippaar-en-s049-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d015","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"You know how it is. All my time is spent labouring for that wretched mill."}},{"id":"tirumbippaar-en-s049-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d016","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"Poor thing... and at this old age too..."}},{"id":"tirumbippaar-en-s049-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d017","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"What, brother, why do you keep saying I've grown old?... (taking the coffee from Radha) Brother, you've made plans for how the workers' matter should proceed, haven't you?... Don't forget it..."}},{"id":"tirumbippaar-en-s049-u022","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"(They drink coffee.)"}},{"id":"tirumbippaar-en-s049-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d018","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"Would I forget? I will never forget. This Paranthaman has never left unfinished what he set his mind on...."}},{"id":"tirumbippaar-en-s049-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d019","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"I was wondering where you might leave it unfinished."}},{"id":"tirumbippaar-en-s049-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s049-d020","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":65,"printed_page":57}]},"translation":{"english_text":"Then I'll be going..."}}]}