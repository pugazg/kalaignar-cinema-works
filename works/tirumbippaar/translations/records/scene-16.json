{"work_id":"tirumbippaar","target_language":"en","canonical_scene":16,"scene_status":"verified","unit_count":7,"units":[{"id":"tirumbippaar-en-s016-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/scenes/scene-16.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening direction: Garudan reads the wedding invitation."},"speaker_label":null,"page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"(Garudan is reading the wedding invitation.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s016-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-16.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":"tirumbippaar-s016-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"The wedding of writer Pandiyan, son of Punyakodi, foreman at Sivasakthi Mills, Singanallur, and Miss Bama of Coimbatore merchant Gunaratnam, will be celebrated grandly at the bride's residence. You and your family....","mode":"prose-faithful","notes":["The source invitation breaks off after `தங்கள் சுற்றமும்`; the English preserves that incompleteness.","The source identifies Punyakodi as Pandiyan's father but does not explicitly print a daughter-relationship word between merchant Gunaratnam and Bama, so the English does not add one."]}},{"id":"tirumbippaar-en-s016-u003","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/scenes/scene-16.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Paranthaman abruptly snatches, crumples and throws away the invitation."},"speaker_label":null,"page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"(Paranthaman abruptly snatches the invitation, crumples it and throws it away.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s016-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-16.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":"tirumbippaar-s016-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"That fellow Pandiyan keeps interfering in our affairs. The other day he staged a play and mocked our doctrine. And today, the woman we were supposed to marry....","mode":"prose-faithful","notes":["Garudan's colloquial first-person plural is retained because Paranthaman immediately interrupts and forces him to correct it in the next line."]}},{"id":"tirumbippaar-en-s016-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-16.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":"tirumbippaar-s016-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"Hey....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s016-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-16.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":"tirumbippaar-s016-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"No. The woman you were supposed to marry....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s016-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":16,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-16.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-16.md","source_record_id":"tirumbippaar-s016-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"Who allowed that?","mode":"prose-faithful","notes":["The source `யார் விட்டார்கள்` is kept as a terse past/perfective challenge rather than shifted into a future prediction."]}}]}