{"work_id":"tirumbippaar","target_language":"en","canonical_scene":76,"scene_status":"verified","unit_count":19,"units":[{"id":"tirumbippaar-en-s076-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d001","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Hey... where is Paranthaman?"}},{"id":"tirumbippaar-en-s076-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d002","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Why are you shouting, ayya?"}},{"id":"tirumbippaar-en-s076-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d003","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Where is that Paranthaman, da?"}},{"id":"tirumbippaar-en-s076-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d004","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Why are you shouting, ayya?"}},{"id":"tirumbippaar-en-s076-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"(Gundumani runs away.)"}},{"id":"tirumbippaar-en-s076-u006","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"(Poomaalai comes.)"}},{"id":"tirumbippaar-en-s076-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d005","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Who are you?"}},{"id":"tirumbippaar-en-s076-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d006","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Who am I? A fool who trusted a cheat. An idiot who hoisted a worthless fellow onto my head as a leader and danced around...."}},{"id":"tirumbippaar-en-s076-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d007","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"What are you saying..."}},{"id":"tirumbippaar-en-s076-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d008","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"What am I to say, amma? What your younger brother has done has ruined the livelihood of hundreds of workers!...","notes":["The source uses a colloquial dirt/food image (`வயத்ல மண்ணைப் போட்டுவிட்டான்`) for destroying the workers' livelihood; the English preserves the supported sense without normalizing the Tamil record."]}},{"id":"tirumbippaar-en-s076-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d009","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"But they released everyone, didn't they?"}},{"id":"tirumbippaar-en-s076-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d010","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"The court released us. But the mill owner dismissed all the important people in the agitation from their jobs, including me. Hundreds of families are suffering. Who brought this injustice upon us, amma?"}},{"id":"tirumbippaar-en-s076-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d011","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Wait. Don't be agitated...."}},{"id":"tirumbippaar-en-s076-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d012","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":91,"printed_page":83},{"pdf_page":92,"printed_page":84}]},"translation":{"english_text":"What else can I do but be agitated? For his own private affair, the sinner made us stage a revolution and ruined the livelihood of all these poor people. We are all 'shade cattle'—we don't know how to work in forests or fields. What other work do we know? We can beg; that's all.... Hmm, where is your younger brother, amma?","notes":["This source utterance genuinely crosses PDF 91→92. The printed expression `நிழல் மாடு` is unusual; it is retained literally as 'shade cattle' rather than silently normalized."]}},{"id":"tirumbippaar-en-s076-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d013","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":92,"printed_page":84}]},"translation":{"english_text":"He isn't at home."}},{"id":"tirumbippaar-en-s076-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d014","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":92,"printed_page":84}]},"translation":{"english_text":"Hmm... lawless fellow. Unjust fellow."}},{"id":"tirumbippaar-en-s076-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d015","speaker_label":"பூமாலை","page_provenance":[{"pdf_page":92,"printed_page":84}]},"translation":{"english_text":"Ayya, I myself will go and see the mill owner and ask him to give all of you your jobs back. Please go now."}},{"id":"tirumbippaar-en-s076-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s076-d016","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":92,"printed_page":84}]},"translation":{"english_text":"If only that fellow falls into my sight..."}},{"id":"tirumbippaar-en-s076-u019","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":92,"printed_page":84}]},"translation":{"english_text":"(He leaves.)"}}]}