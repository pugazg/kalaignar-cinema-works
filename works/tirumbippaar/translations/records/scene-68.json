{"work_id":"tirumbippaar","target_language":"en","canonical_scene":68,"scene_status":"verified","unit_count":6,"units":[{"id":"tirumbippaar-en-s068-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"(Police station—night.)"}},{"id":"tirumbippaar-en-s068-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s068-d001","speaker_label":"போலீஸ்","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"Stones were thrown at the police!"}},{"id":"tirumbippaar-en-s068-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s068-d002","speaker_label":"II போலீஸ்","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"They smashed the mill gate to pieces. They threw stones at the mill owner's house too."}},{"id":"tirumbippaar-en-s068-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s068-d003","speaker_label":"போலீஸ்","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"People are afraid even to move about in the street."}},{"id":"tirumbippaar-en-s068-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s068-d004","speaker_label":"போலீஸ்","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"They say there's going to be a big procession tomorrow morning."}},{"id":"tirumbippaar-en-s068-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s068-d005","speaker_label":"சப்- இன்ஸ்பெக்டர்","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"(Entering.) All right. Orders have come to arrest the leading figures. Move out!"}}]}
