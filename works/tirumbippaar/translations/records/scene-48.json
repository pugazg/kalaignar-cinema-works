{"work_id":"tirumbippaar","target_language":"en","canonical_scene":48,"scene_status":"verified","unit_count":19,"units":[{"id":"tirumbippaar-en-s048-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"(Punnakodi and two or three workers come along talking.)"}},{"id":"tirumbippaar-en-s048-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d001","speaker_label":"ஒரு தொழிலாளி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"(To Punnakodi) What is this, master? You said the owner would soon attend to all our grievances, but we don't see anything happening!"}},{"id":"tirumbippaar-en-s048-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d002","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"All that will happen soon, you'll see!... If it doesn't, our leader will begin the final struggle!"}},{"id":"tirumbippaar-en-s048-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d003","speaker_label":"தொழிலாளி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"All right... but some people say even the January struggle we started has fizzled out!"}},{"id":"tirumbippaar-en-s048-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d004","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"They'll talk, they'll talk! Fools. They have taken our leader Paranthaman for an ordinary man! Tell them a tiger crouches only as a sign that it is about to pounce."}},{"id":"tirumbippaar-en-s048-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d005","speaker_label":"தொழிலாளி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"Pandiyan's doubt is whether the thing crouching is a tiger or a cat!"}},{"id":"tirumbippaar-en-s048-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d006","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"Pandiyan... don't talk to me about that fellow... the scoundrel! Nowhere in the whole world have I seen a fellow who tries to stop his father from getting married."}},{"id":"tirumbippaar-en-s048-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d007","speaker_label":"தொழிலாளி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"All right, master, we'll be going..."}},{"id":"tirumbippaar-en-s048-u009","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"(Paranthaman is standing near his car.)"}},{"id":"tirumbippaar-en-s048-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d008","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"Greetings..."}},{"id":"tirumbippaar-en-s048-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d009","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"What... ah..."}},{"id":"tirumbippaar-en-s048-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d010","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"Just finished work at the mill..."}},{"id":"tirumbippaar-en-s048-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d011","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":63,"printed_page":55}]},"translation":{"english_text":"Hmm... I've been to the union side and am returning..."}},{"id":"tirumbippaar-en-s048-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d012","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Is that so? Come, let's go home."}},{"id":"tirumbippaar-en-s048-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d013","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"I have urgent work..."}},{"id":"tirumbippaar-en-s048-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d014","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Come on... you didn't even come to our wedding. At least have a cup of coffee as the wedding feast and go."}},{"id":"tirumbippaar-en-s048-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d015","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Oh... your wife is here, is she!"}},{"id":"tirumbippaar-en-s048-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d016","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"Yes."}},{"id":"tirumbippaar-en-s048-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s048-d017","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":64,"printed_page":56}]},"translation":{"english_text":"All right, come. We'll go in the car."}}]}