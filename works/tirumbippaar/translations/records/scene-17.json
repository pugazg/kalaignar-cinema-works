{"work_id":"tirumbippaar","target_language":"en","canonical_scene":17,"scene_status":"verified","unit_count":23,"units":[{"id":"tirumbippaar-en-s017-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/scenes/scene-17.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening direction describing Bama, the approaching wedding, the knock and Paranthaman's entrance."},"speaker_label":null,"page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"(Bama sits like an image of sorrow, thinking of the wedding that is to take place the next day. There is a knock at the door. Bama goes and opens it. Paranthaman enters.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Bama!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u003","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/scenes/scene-17.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Bama is startled after Paranthaman calls her."},"speaker_label":null,"page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"(Bama is startled.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"What is this outrage? I don't understand anything. Please go away....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Shh...don't make a noise! The people sleeping will wake up. Bama, look at me! Won't you look at me?..... Why, Bama, did you deceive me like this?...","mode":"prose-faithful","notes":["The corrected Tamil reads `என்னை இப்படி ஏமாற்றினாய்`; the earlier English `why are you changing like this` was based on a stale source reading and has been removed."]}},{"id":"tirumbippaar-en-s017-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Deceiving people is not my profession.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Quite right... Your lover disappeared on the wedding day. Without worrying at all about where he went or what happened to him, you hurriedly chose the next lover...an innocent who knows nothing! And I am the deceiver—isn't that it?...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Where did you go? From this world to heaven?....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Even if I had gone to heaven, I would have cast aside Tilottama who enchants there, Menaka of bewitching speech, every one of them, and leapt down from the sky thinking of your beautiful face. I went to a sorcerer's world, Bama! A sorcerer deceived me, Bama!","mode":"prose-faithful","notes":["The corrected Tamil explicitly reads `சுந்தர முகம்`, `சூனியக்கார லோகம்`, and `சூனியக்காரன்`; the stale English `conch-like face`, `world of childish fools`, and `trickster` readings are therefore removed.","Mythological names are transliterated rather than replaced."]}},{"id":"tirumbippaar-en-s017-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"What are you saying!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Some magician...said there was a kayakalpa remedy to eat, and that if one ate it youth would not change until the age of eighty. I believed him and ate it. I thought of buying some for you too. He took me somewhere. He stole the ten thousand rupees I had and the diamond necklace I had bought for you, and disappeared somewhere.","mode":"prose-faithful","notes":["`காயகல்பம்` is retained as the traditional rejuvenation concept `kayakalpa`; the corrected Tamil explicitly prints `எண்பது வயது` (`eighty years`)."]}},{"id":"tirumbippaar-en-s017-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":25,"printed_page":17}]},"translation":{"english_text":"Didn't you tell the police?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"How could I tell the outside world of this disgrace! Broken-hearted, I wandered about and came here. And when I arrived, you had made another plan for your life...Bama! I was the one who was deceived, wasn't I? Yet you have become a greater deceiver than that magician, Bama!....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"(Clutching Paranthaman's feet and sobbing) Forgive me. I could not stand up to my father's anger.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"At daybreak you will be married. Another man's wife! Who am I to forgive you!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"Save me. We can tell father right now and stop the wedding....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"He will not stop it. There is only one way for our love to continue.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"What way? (She cries.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"Don't cry! Queen of love! Ornamental sacred form of the jewel-palace of beauty! Picture that cannot be erased and redrawn—a swaying golden lamp! Kattani-pearl beauty! Eye-catching gem! If there are tears in your eyes, my heart is shaken, alas! Don't cry, Bama!.... Don't cry!","mode":"prose-faithful","notes":["The deliberately ornate sequence of endearments is preserved rather than normalized into ordinary romantic prose.","The corrected Tamil reads `அழித்தெழுதா சித்திரமே`, so the stale English `not painted even with nectar` is removed.","`கட்டாணி முத்தழகி` is kept conservatively as `Kattani-pearl beauty` rather than assigning an unsupported modern paraphrase to the source image."]}},{"id":"tirumbippaar-en-s017-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"Tell me a way for us to live.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"A way to live! We must both leave right now....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u022","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாமா","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"Ah!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s017-u023","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":17,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-17.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-17.md","source_record_id":"tirumbippaar-s017-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":26,"printed_page":18}]},"translation":{"english_text":"Listen, my gold! Write a letter to your father. 'I do not like the marriage—I have left,' write that, delight of my thoughts! Graceful peacock.... Hmm, quickly...write, my dear! My unpainted portrait, write!","mode":"prose-faithful","notes":["The source's cascading endearments and imperative rhythm are retained."]}}]}