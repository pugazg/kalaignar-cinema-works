{"work_id":"tirumbippaar","target_language":"en","canonical_scene":90,"scene_status":"verified","unit_count":38,"units":[{"id":"tirumbippaar-en-s090-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"(Bama's house. The door is open. Paranthaman goes into the hall and sits down.)"}},{"id":"tirumbippaar-en-s090-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d001","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"Kumudha! Kumudha!"}},{"id":"tirumbippaar-en-s090-u003","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"(There is no reply. He remains seated, then blows up a balloon. It bursts.)"}},{"id":"tirumbippaar-en-s090-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d002","speaker_label":"பாமா","page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"That is how your life too is going to burst and scatter!"}},{"id":"tirumbippaar-en-s090-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d003","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"Bama! (He rises in terror.)"}},{"id":"tirumbippaar-en-s090-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d004","speaker_label":"பாமா","page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"Sinner! This time you cannot escape! I am going to make you atone for the injustices you committed."}},{"id":"tirumbippaar-en-s090-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"Bama! Understand me! Don't act in haste! I am not the treacherous Paranthaman who ran away leaving Bama to suffer! I am a new Paranthaman who has entombed his wicked deeds and become a messenger of purity!"}},{"id":"tirumbippaar-en-s090-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d006","speaker_label":"பாமா","page_provenance":[{"pdf_page":106,"printed_page":98}]},"translation":{"english_text":"Yes! That's why you've come after getting Kumudha's address."}},{"id":"tirumbippaar-en-s090-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"No, Bama, no. I came to ask her forgiveness. Unexpectedly, I found you too. Bama, you too forget what happened! Let us renew our life again."}},{"id":"tirumbippaar-en-s090-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d008","speaker_label":"பாமா","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"A life—for me? I am spilt milk! Honey mixed with poison! A life for me! Schemer! Enough of your sermon! Enough. (She points the revolver.)"}},{"id":"tirumbippaar-en-s090-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d009","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"Bama!"}},{"id":"tirumbippaar-en-s090-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d010","speaker_label":"பாமா","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"I am killing you to save foolish women like me who exist in this world!"}},{"id":"tirumbippaar-en-s090-u013","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"(She is about to shoot.)"}},{"id":"tirumbippaar-en-s090-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d011","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"Bama! (He stops her; as the two struggle.) Bama! Listen to what I say! Don't kill me! I truly have reformed..."}},{"id":"tirumbippaar-en-s090-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d012","speaker_label":"பாமா","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"Sinner! Let go of me!"}},{"id":"tirumbippaar-en-s090-u016","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"(Poomaal's voice is heard calling, 'Kumudha! Kumudha!' Before that, Bama's revolver fires. Because the revolver has turned toward her own side, Bama loses her life and falls.)"}},{"id":"tirumbippaar-en-s090-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d013","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"Ah!.... (In distress.)"}},{"id":"tirumbippaar-en-s090-u018","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"(At the same moment, a bullet strikes his chest.)"}},{"id":"tirumbippaar-en-s090-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d014","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"Ah!.... (A cry.)"}},{"id":"tirumbippaar-en-s090-u020","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"(Writhing, he falls onto the sofa. The person who has now shot him is Poomaal.)"}},{"id":"tirumbippaar-en-s090-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d015","speaker_label":"பூமால்","page_provenance":[{"pdf_page":107,"printed_page":99}]},"translation":{"english_text":"Be gone, wicked man! At least from now on let the world live in peace! (To the woman lying below.) Kumudha! Kumudha! (She goes near and looks.) Ah! Bama!"}},{"id":"tirumbippaar-en-s090-u022","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"(Paranthaman breathes his last breaths.)"}},{"id":"tirumbippaar-en-s090-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d016","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"That isn't Kumudha, akka! Bama! (Sobbing.) My Bama! She killed herself!"}},{"id":"tirumbippaar-en-s090-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d017","speaker_label":"பூமால்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"Yes! From the very day she first saw you, she had already begun killing herself!"}},{"id":"tirumbippaar-en-s090-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d018","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"Akka! You still think wrongly of me, akka! You did not kill the younger brother who was committing an unworthy act—you killed gold that had been purified in fire! They had already killed the Paranthaman who was a cave of cruel games, akka! What you have killed now is the good man newly created by you! Akka, you have killed the younger brother I should have been to you. I came to ask Kumudha's forgiveness, akka. Bama, who had meant to take revenge... Bama... Bama..."}},{"id":"tirumbippaar-en-s090-u026","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d019","speaker_label":"பூமால்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"Thambi..."}},{"id":"tirumbippaar-en-s090-u027","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d020","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"Look here, akka! The toys I bought for Kumudha's child!"}},{"id":"tirumbippaar-en-s090-u028","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d021","speaker_label":"பூமால்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"Paranthama! I judged in haste—forgive me, my treasure..."}},{"id":"tirumbippaar-en-s090-u029","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d022","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"You are without fault. I am the one who ought to die, akka! This is the punishment I needed. Not for me alone, but for everyone like me. O goddess who reformed me, give me that golden hand that pointed out where I must 'look back.'"}},{"id":"tirumbippaar-en-s090-u030","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d023","speaker_label":"பூமால்","page_provenance":[{"pdf_page":108,"printed_page":100}]},"translation":{"english_text":"Not the hand that pointed the way. The hand that shot down its own brother... the hand that shot him down.","notes":["The translation preserves the source wordplay between 'சுட்டிக்காட்டிய' (pointed out) and 'சுட்டுத் தள்ளிய' (shot down)."]}},{"id":"tirumbippaar-en-s090-u031","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d024","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"No, akka! No. Give me those loving hands that raised me... those cherished hands... Akka.... bid me farewell!"}},{"id":"tirumbippaar-en-s090-u032","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d025","speaker_label":"பூமால்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Paranthama!"}},{"id":"tirumbippaar-en-s090-u033","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d026","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Run away. Escape from the police, akka."}},{"id":"tirumbippaar-en-s090-u034","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d027","speaker_label":"பூமால்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"No. Once you are gone, what life is there for me?"}},{"id":"tirumbippaar-en-s090-u035","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d028","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Akka! Akka!"}},{"id":"tirumbippaar-en-s090-u036","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d029","speaker_label":"பூமால்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Police! Police!"}},{"id":"tirumbippaar-en-s090-u037","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d030","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Akka! Akka!"}},{"id":"tirumbippaar-en-s090-u038","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s090-d031","speaker_label":"பூமால்","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Paranthama!"}}]}