{"work_id":"tirumbippaar","target_language":"en","canonical_scene":37,"scene_status":"corrected-source-reconciled","unit_count":51,"units":[{"id":"tirumbippaar-en-s037-u051","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(She leaves.)","notes":["The corrected source prints this carry-over action at the beginning of scene 37. The historical English layer had incorrectly placed it at the end of scene 36."]}},{"id":"tirumbippaar-en-s037-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(Punyakodi hands strike notices to the boy.)"}},{"id":"tirumbippaar-en-s037-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d001","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"They must be pasted all over town overnight! Not a single wall should be left! Understand?"}},{"id":"tirumbippaar-en-s037-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d002","speaker_label":"பையன்","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"Yes, sir!..."}},{"id":"tirumbippaar-en-s037-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d003","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"All right, go!"}},{"id":"tirumbippaar-en-s037-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(The boy leaves. Pandiyan enters. Seeing Pandiyan's sorrowful face, Punyakodi comes near him.)"}},{"id":"tirumbippaar-en-s037-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d004","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"What is it, son? Why are you sad?"}},{"id":"tirumbippaar-en-s037-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d005","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"Nothing, father!"}},{"id":"tirumbippaar-en-s037-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d006","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"You were happy all through yesterday! What is it again now?"}},{"id":"tirumbippaar-en-s037-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d007","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"I have no worries."}},{"id":"tirumbippaar-en-s037-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d008","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"Hmm...Pandiyan! There was something I wanted to tell you!...hmm...."}},{"id":"tirumbippaar-en-s037-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d009","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(A little startled) What is it, father?"}},{"id":"tirumbippaar-en-s037-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d010","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"That...that...."}},{"id":"tirumbippaar-en-s037-u013","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(He shows him a photograph of a woman.)"}},{"id":"tirumbippaar-en-s037-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d011","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"Look at this!"}},{"id":"tirumbippaar-en-s037-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d012","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(Looking at the picture) Father! I don't want marriage at all!"}},{"id":"tirumbippaar-en-s037-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d013","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"All right, you don't want it...but this girl...."}},{"id":"tirumbippaar-en-s037-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d014","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Whoever she is, I don't need it."}},{"id":"tirumbippaar-en-s037-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d015","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Why are you in such a hurry, son? That girl is desperately longing!"}},{"id":"tirumbippaar-en-s037-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d016","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Let her long! So what?"}},{"id":"tirumbippaar-en-s037-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d017","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"I'm saying the girl is willing."}},{"id":"tirumbippaar-en-s037-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d018","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Oh no, what trouble is this!..."}},{"id":"tirumbippaar-en-s037-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d019","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"There's no trouble...people in town will shout that an old man shouldn't marry...that's why I'm telling you all this."}},{"id":"tirumbippaar-en-s037-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d020","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"I don't want marriage now! I won't want marriage even when I'm old!"}},{"id":"tirumbippaar-en-s037-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d021","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Hey, not for you, not for you! Forget that! I'm talking about myself!"}},{"id":"tirumbippaar-en-s037-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d022","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Father! The marriage is for you?"}},{"id":"tirumbippaar-en-s037-u026","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d023","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Why are you surprised? Is this the eighth wonder of the world?"}},{"id":"tirumbippaar-en-s037-u027","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d024","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"When did this desire come to you, father?"}},{"id":"tirumbippaar-en-s037-u028","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d025","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Yes, boy! What a fine question! When did desire come, you ask? As though I have written down the year, month and date. You're asking for the horoscope of desire."}},{"id":"tirumbippaar-en-s037-u029","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d026","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Even if desire has no horoscope, there is a horoscope to prove that you have crossed sixty, father!"}},{"id":"tirumbippaar-en-s037-u030","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d027","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Impertinent fellow!"}},{"id":"tirumbippaar-en-s037-u031","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d028","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":47,"printed_page":39}]},"translation":{"english_text":"Father! Don't ruin a young woman's life!"}},{"id":"tirumbippaar-en-s037-u032","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d029","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Fool! I'm going to give a young woman a life! Don't rave without understanding! No one will marry this girl. She is mute!"}},{"id":"tirumbippaar-en-s037-u033","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d030","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"This mad society turns even women who can speak into silent women; would it leave mute women alive?"}},{"id":"tirumbippaar-en-s037-u034","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d031","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"So what do you say now?"}},{"id":"tirumbippaar-en-s037-u035","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d032","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"I ask you to change your decision."}},{"id":"tirumbippaar-en-s037-u036","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d033","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Impossible! You are the one who must change your decision. I was born before you!"}},{"id":"tirumbippaar-en-s037-u037","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d034","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Who denies it! You're at the age to fondle grandchildren!"}},{"id":"tirumbippaar-en-s037-u038","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d035","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"After I brought you into the world, raised and protected you, and made you a man, is this how you should talk back to me?"}},{"id":"tirumbippaar-en-s037-u039","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d036","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"For that I offer you a thousand salutations. But at the age when you should be handing over the garland at your son's wedding, you say you will become the bridegroom yourself; I can never permit that!"}},{"id":"tirumbippaar-en-s037-u040","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d037","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Bah! Who are you to permit me? I'll do as I please."}},{"id":"tirumbippaar-en-s037-u041","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d038","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Don't do it, father—don't make this disastrous decision!"}},{"id":"tirumbippaar-en-s037-u042","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d039","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Bah! Don't speak to me!"}},{"id":"tirumbippaar-en-s037-u043","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d040","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Your marriage?"}},{"id":"tirumbippaar-en-s037-u044","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d041","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"I'm going through with it."}},{"id":"tirumbippaar-en-s037-u045","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d042","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"Have you come to hate me?"}},{"id":"tirumbippaar-en-s037-u046","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d043","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":48,"printed_page":40}]},"translation":{"english_text":"I'll drive you out."}},{"id":"tirumbippaar-en-s037-u047","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d044","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":49,"printed_page":41}]},"translation":{"english_text":"You don't have to drive me out. I'll go myself."}},{"id":"tirumbippaar-en-s037-u048","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d045","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":49,"printed_page":41}]},"translation":{"english_text":"Get out! Don't show your face to me again! Go!"}},{"id":"tirumbippaar-en-s037-u049","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d046","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":49,"printed_page":41}]},"translation":{"english_text":"I'm going. May your intoxication clear soon. (He leaves.)"}},{"id":"tirumbippaar-en-s037-u050","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s037-d047","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":49,"printed_page":41}]},"translation":{"english_text":"Go on, go! 'May your intoxication clear,' he says. As though I'm sitting here drunk!","notes":["The source plays on Pandiyan's figurative `போதை` and Punyakodi's literal retort about drinking; the contrast is preserved explicitly."]}}]}
