{"work_id":"tirumbippaar","target_language":"en","canonical_scene":36,"scene_status":"verified","unit_count":26,"units":[{"id":"tirumbippaar-en-s036-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"(Kumudha is crying.)"}},{"id":"tirumbippaar-en-s036-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d001","speaker_label":"பூமால்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Don't cry, Kumudha! (Distressed)"}},{"id":"tirumbippaar-en-s036-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d002","speaker_label":"குமுதா","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Chinnamma! My Chinnamma hit me! I haven't done anything wrong, Chinnamma!"}},{"id":"tirumbippaar-en-s036-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d003","speaker_label":"பூமால்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Who is Paranthaman? Isn't he one of us too? How could you go and hit him?"}},{"id":"tirumbippaar-en-s036-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d004","speaker_label":"குமுதா","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Chinnamma, did Pandiyan alone behave that way with Bama?"}},{"id":"tirumbippaar-en-s036-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d005","speaker_label":"பூமால்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"I'm here to question him about that! He meant to hurt me....","notes":["The source utterance is unfinished at the page break and is preserved as unfinished rather than reconstructed."]}},{"id":"tirumbippaar-en-s036-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d006","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Your younger brother matters more to you!"}},{"id":"tirumbippaar-en-s036-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d007","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"And to you?"}},{"id":"tirumbippaar-en-s036-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d008","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"My lover matters more to me!"}},{"id":"tirumbippaar-en-s036-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d009","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"(Startled) Lover?...."}},{"id":"tirumbippaar-en-s036-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d010","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Yes! Pandiyan is my lover!"}},{"id":"tirumbippaar-en-s036-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d011","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Your lover?"}},{"id":"tirumbippaar-en-s036-u013","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"(Sobbing, Poomaal goes aside and cries in despair. Kumudha runs to her.)"}},{"id":"tirumbippaar-en-s036-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d012","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Am I not allowed to love?"}},{"id":"tirumbippaar-en-s036-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d013","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Has he given his consent?"}},{"id":"tirumbippaar-en-s036-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d014","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Our two hearts have become one!"}},{"id":"tirumbippaar-en-s036-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d015","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Oh! What a great mistake I've made, Kumudha!"}},{"id":"tirumbippaar-en-s036-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d016","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"What mistake did you make, Chinnamma? Was bringing him here the mistake? Or was introducing him to me the mistake?"}},{"id":"tirumbippaar-en-s036-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d017","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"There was no mistake in bringing him. Nor in introducing him."}},{"id":"tirumbippaar-en-s036-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d018","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Then was it wrong that I showed him affection?"}},{"id":"tirumbippaar-en-s036-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d019","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Not that either, Kumudha! The mistake was that a plant tried to climb the branch on which a creeper was already spreading.","notes":["The source's creeper/plant metaphor is preserved rather than replaced with an explicit explanation of the romantic triangle."]}},{"id":"tirumbippaar-en-s036-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d020","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"I don't understand...."}},{"id":"tirumbippaar-en-s036-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d021","speaker_label":"பூமால்","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"You need not understand; you must never understand."}},{"id":"tirumbippaar-en-s036-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d022","speaker_label":"குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}]},"translation":{"english_text":"Chinnamma! Won't you permit our love?"}},{"id":"tirumbippaar-en-s036-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s036-d023","speaker_label":"பூமால்","page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"I permit it, dear! I bless both of you this very moment....Pandiyan! Pandiyan!"}},{"id":"tirumbippaar-en-s036-u026","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":46,"printed_page":38}]},"translation":{"english_text":"(She leaves.)"}}]}