{"work_id":"tirumbippaar","target_language":"en","canonical_scene":19,"scene_status":"verified","unit_count":9,"units":[{"id":"tirumbippaar-en-s019-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/scenes/scene-19.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening direction: Poomaal prepares to leave town and a girl who studies under her comes to her."},"speaker_label":null,"page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"(Poomaal is making preparations to leave town. A girl who studies under her comes to her.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பெண்","page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"Why are you going to the city, amma?...","mode":"prose-faithful","notes":["`அம்மா` is retained as the respectful/familiar address `amma` rather than assigning a relationship not stated by the source."]}},{"id":"tirumbippaar-en-s019-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"Kumudha's examination result will be known in two days. I am going to bring her back....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"குணமணி","page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"(Coming in) Amma! Amma! Do you know what happened! The girl chosen for our young master......","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"The wedding is today. What about it?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"குணமணி","page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"They say the girl ran away last night!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":27,"printed_page":19}]},"translation":{"english_text":"Is that so! (Thinking) Hmm...where is Paranthaman?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"குணமணி","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"He...he...hmm...he was telling Garudan that he too had to go to Madras.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s019-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":19,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-19.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-19.md","source_record_id":"tirumbippaar-s019-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"(Thoughtfully) Hmm...all right, get going. It's time for the train.","mode":"prose-faithful","notes":[]}}]}