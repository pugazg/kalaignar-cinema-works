{"work_id":"tirumbippaar","target_language":"en","canonical_scene":40,"scene_status":"corrected-source-reconciled","unit_count":6,"units":[{"id":"tirumbippaar-en-s040-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s040-d001","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"(Standing up in the car) Dear workers! Our struggle has succeeded! The owner has trembled before our agitation!... He has assured me that very soon he will attend to the question of a wage increase! Warriors! We have won!"}},{"id":"tirumbippaar-en-s040-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s040-d002","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"For our leader Paranthaman!"}},{"id":"tirumbippaar-en-s040-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s040-d003","speaker_label":"மற்றவர்கள்","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"Jai! Jai!"}},{"id":"tirumbippaar-en-s040-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s040-d004","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"Therefore, as your leader, I ask all of you to return peacefully to work. We will soon celebrate our victory in grand fashion."}},{"id":"tirumbippaar-en-s040-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"(The scene ends amid slogans of 'Jai to Paranthaman!')"}},{"id":"tirumbippaar-en-s040-u006","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":52,"printed_page":44}]},"translation":{"english_text":"(The two rise.)","notes":["The corrected source prints this carry-over action at the beginning of scene 40. The historical English layer had incorrectly placed it at the end of scene 39."]}}]}