{"work_id":"tirumbippaar","target_language":"en","canonical_scene":35,"scene_status":"verified","unit_count":25,"units":[{"id":"tirumbippaar-en-s035-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"(Poomaal approaches Pandiyan, who is enjoying nature.)"}},{"id":"tirumbippaar-en-s035-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d001","speaker_label":"பூமால்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"I hope I'm not disturbing your thoughts...."}},{"id":"tirumbippaar-en-s035-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d002","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"No, no...."}},{"id":"tirumbippaar-en-s035-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d003","speaker_label":"பூமால்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"You've surrendered your heart to what lies before you! To the beauty of the sky—or the movement of the clouds?"}},{"id":"tirumbippaar-en-s035-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d004","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"In this grove ripened into silence, delighting the eye....","notes":["The source line itself is syntactically incomplete and is preserved as an unfinished poetic utterance."]}},{"id":"tirumbippaar-en-s035-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d005","speaker_label":"பூமால்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Are you yearning for the skylark's arrival? Pandiyan! Realising that the smiling jasmine and charming grove are not enough to feast your thoughts, the skylark itself has flown here!"}},{"id":"tirumbippaar-en-s035-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d006","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Where?"}},{"id":"tirumbippaar-en-s035-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d007","speaker_label":"பூமால்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Don't you see? You can see it with your eyes too. But first you must be able to see it with your heart."}},{"id":"tirumbippaar-en-s035-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d008","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"(Suspiciously) Poomaal......"}},{"id":"tirumbippaar-en-s035-u010","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"(As he speaks, she hears a voice call ‘Akka!’ and turns with a start. Paranthaman enters.)"}},{"id":"tirumbippaar-en-s035-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d009","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Who is he?"}},{"id":"tirumbippaar-en-s035-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d010","speaker_label":"பூமால்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Paranthama, this is...."}},{"id":"tirumbippaar-en-s035-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d011","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Don't tell me; I know. Who let this scoundrel into the house?"}},{"id":"tirumbippaar-en-s035-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d012","speaker_label":"பூமால்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"(Angrily) Paranthama...."}},{"id":"tirumbippaar-en-s035-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d013","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":43,"printed_page":35}]},"translation":{"english_text":"Don't interfere! What you've done is actually a good thing! I've been searching for him for many days."}},{"id":"tirumbippaar-en-s035-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d014","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Why are you looking for me?"}},{"id":"tirumbippaar-en-s035-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d015","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Ah! To give you a gift. Here—take this, one in return for the other!"}},{"id":"tirumbippaar-en-s035-u018","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"(He slaps Pandiyan. Kumudha, who has arrived there, slaps Paranthaman across the cheek.)"}},{"id":"tirumbippaar-en-s035-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d016","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Ah...what!...Kumudha!"}},{"id":"tirumbippaar-en-s035-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d017","speaker_label":"குமுதா","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Fool!"}},{"id":"tirumbippaar-en-s035-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d018","speaker_label":"பூமால்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"(Slapping Kumudha) Shame! Shut your mouth."}},{"id":"tirumbippaar-en-s035-u022","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"(She slaps her several times.)"}},{"id":"tirumbippaar-en-s035-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d019","speaker_label":"குமுதா","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"Chinnamma! Chinnamma!"}},{"id":"tirumbippaar-en-s035-u024","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"(She runs inside sobbing uncontrollably. Paranthaman leaves in fury. Pandiyan stands stunned, then slowly moves away.)"}},{"id":"tirumbippaar-en-s035-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s035-d020","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":44,"printed_page":36}]},"translation":{"english_text":"My life is an arena of contests!...."}}]}