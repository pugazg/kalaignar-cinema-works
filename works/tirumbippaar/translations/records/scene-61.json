{"work_id":"tirumbippaar","target_language":"en","canonical_scene":61,"scene_status":"verified","unit_count":9,"units":[{"id":"tirumbippaar-en-s061-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":78,"printed_page":70},{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"(A typing office. Several clerks are there. Kumudha is typing. The manager, after looking over all the desks, comes and stands behind her. Kumudha is typing the same word over and over: 'Pandiyan, Pandiyan.')"}},{"id":"tirumbippaar-en-s061-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s061-d001","speaker_label":"மேனேஜர்","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"Very neat indeed—what fine typing!"}},{"id":"tirumbippaar-en-s061-u003","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"(Kumudha starts and rises.)"}},{"id":"tirumbippaar-en-s061-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s061-d002","speaker_label":"மேனேஜர்","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"Pandiyan! Pandiyan! Enough of the work you've done. Get out!"}},{"id":"tirumbippaar-en-s061-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s061-d003","speaker_label":"குமுதா","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"Sir, please......"}},{"id":"tirumbippaar-en-s061-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s061-d004","speaker_label":"மேனேஜர்","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"Uh-uh. I said go—go!"}},{"id":"tirumbippaar-en-s061-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"(Kumudha sobs.)"}},{"id":"tirumbippaar-en-s061-u008","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"(Scene ends.)"}},{"id":"tirumbippaar-en-s061-u009","kind":"editorial-note","status":"verified","source":{"page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"The manager's first line is sarcastic; the translation preserves that tone rather than reading 'ரொம்ப ஒழுங்காயிருக்கு' literally as praise."}}]}