      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 6,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-06.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-06.md", "source_record_id": "tirumbippaar-s006-d011", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பரந்தாமன்", "page_provenance": [{"pdf_page": 16, "printed_page": 8}]},
      "translation": {"english_text": "Bama! My dear! (moves closer)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "tirumbippaar-en-s006-u015",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 6,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-06.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-06.md", "source_record_id": "tirumbippaar-s006-d012", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பாமா", "page_provenance": [{"pdf_page": 16, "printed_page": 8}]},
      "translation": {"english_text": "No...all that only after the marriage...", "mode": "prose-faithful", "notes": []}
    },
