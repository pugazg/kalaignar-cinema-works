    {
      "id": "tirumbippaar-en-s006-u006",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 6,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-06.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-06.md", "source_record_id": "tirumbippaar-s006-d003", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பரந்தாமன்", "page_provenance": [{"pdf_page": 16, "printed_page": 8}]},
      "translation": {"english_text": "I am going to put a noose around your neck too........", "mode": "prose-faithful", "notes": ["The source's wordplay on `சுருக்கு` is retained literally so Paranthaman's next line can turn it toward the marriage cord."]}
    },
    {
      "id": "tirumbippaar-en-s006-u007",
      "kind": "dialogue",
