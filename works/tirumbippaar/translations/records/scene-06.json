      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-06.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-06.md", "source_record_id": "tirumbippaar-s006-d002", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பாமா", "page_provenance": [{"pdf_page": 16, "printed_page": 8}]},
      "translation": {"english_text": "The noose meant for the pot missed and fell around my neck,", "mode": "prose-faithful", "notes": []}
