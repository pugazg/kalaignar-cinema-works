      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-06.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-06.md", "source_record_id": "tirumbippaar-s006-d013", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பரந்தாமன்", "page_provenance": [{"pdf_page": 17, "printed_page": 9}]},
      "translation": {"english_text": "But the marriage is going to happen!", "mode": "prose-faithful", "notes": []}
