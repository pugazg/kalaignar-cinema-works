{"work_id":"tirumbippaar","target_language":"en","canonical_scene":65,"scene_status":"verified","unit_count":11,"units":[{"id":"tirumbippaar-en-s065-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"(Mill owner's room.)"}},{"id":"tirumbippaar-en-s065-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d001","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"(To Paranthaman.) I will not arrange a marriage against Usha's wishes."}},{"id":"tirumbippaar-en-s065-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"They say a woman's judgement comes afterwards. In this one matter, women must act according to their parents' opinion."}},{"id":"tirumbippaar-en-s065-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d003","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"And her parents' wish is to give her in marriage to another bridegroom......"}},{"id":"tirumbippaar-en-s065-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d004","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"Then it can't be done. Is that it? Hmm........"}},{"id":"tirumbippaar-en-s065-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d005","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"What kind of question is that, man! Very nice......"}},{"id":"tirumbippaar-en-s065-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d006","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"I'm telling you for the last time: give Usha to me and all is well; otherwise you'll have a major revolution to deal with."}},{"id":"tirumbippaar-en-s065-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d007","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"What are you trying to frighten me with?......"}},{"id":"tirumbippaar-en-s065-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d008","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"This time you cannot fool Paranthaman by giving him money!"}},{"id":"tirumbippaar-en-s065-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s065-d009","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"You want me to give you my daughter and be the one who's fooled? Impossible! Do whatever you want—go!"}},{"id":"tirumbippaar-en-s065-u011","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"(Paranthaman leaves angrily. Scene ends.)"}}]}