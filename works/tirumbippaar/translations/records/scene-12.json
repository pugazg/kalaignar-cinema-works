{"work_id":"tirumbippaar","target_language":"en","canonical_scene":12,"scene_status":"verified","unit_count":25,"units":[{"id":"tirumbippaar-en-s012-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/scenes/scene-12.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening bracketed direction immediately after the canonical scene-12 heading."},"speaker_label":null,"page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"(Poomaal enters the house in anguish. Paranthaman is sitting there.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"Where have you come from....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u003","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/scenes/scene-12.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Standalone parenthetical after Poomaal's first question, describing the handwritten manuscript and author name."},"speaker_label":null,"page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"(On the handwritten manuscript titled 'Vaazhu' that he has with him, beneath 'Vaazhu' he has written the author name 'Thuravi'.)","mode":"prose-faithful","notes":["The manuscript title `வாழு` and pen name `துறவி` are transliterated in the English derivative; the Tamil source remains authoritative."]}},{"id":"tirumbippaar-en-s012-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"I am asking you—where have you come from...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"I came to my house.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"You stay in your house—I will leave.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"No one needs to go. I will go myself. I will die. Only then will you be at peace.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"Why should you die? You still have to hold swimming games in the flood of how many more women's tears.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"Enough. After you have hinted that I ought to die, am I going to remain alive? No, no.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":19,"printed_page":11}]},"translation":{"english_text":"Don't frighten me! I know that people whose very aim in life is to roll their bodies in the mire of excitement and the force of revelry are afraid even to think of death.","mode":"prose-faithful","notes":["The unusual source pairing `உற்சாகச் சேறு, உல்லாசச் சக்தி` is kept as imagery rather than normalized into a modern idiom."]}},{"id":"tirumbippaar-en-s012-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"So what exactly are you saying now?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"Do I have to say it? The whole town is saying it! It points me out and says, 'There she is—the sister of the reveler who withered the life-dream of a maiden unfamiliar with revelry.' Enough of the pain you have brought me. Father and mother must have told me a thousand times to look after my younger brother properly. I looked after you very properly indeed. Even an animal can be trained, boy...but you simply cannot be reformed......","mode":"prose-faithful","notes":["The source form `குதுவாதறியாத` is irregular; it is rendered conservatively as `unfamiliar with revelry` without altering the canonical Tamil."]}},{"id":"tirumbippaar-en-s012-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"What do you know of my situation—you will cry. The town will see it and say, 'The sister is good, the brother is bad.' Your Mukhari lament will win a complete victory... Your worry is that the wedding has stopped, that all the things bought for the feast have gone to waste, that the money given to the wedding-pandal man is lost; that the wealth already spent can never be gathered again. But only I know what my mind would have suffered after the Bama marriage had gone through, even if the money was wasted. How would you know? Are father and mother here to worry about me?","mode":"prose-faithful","notes":["`முகாரி` is retained as `Mukhari`, preserving the source's music/lament reference rather than replacing it with a different metaphor.","The compressed source clause around `பாமா பரிணயம்` is translated conservatively without repairing its Tamil syntax."]}},{"id":"tirumbippaar-en-s012-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"Brother, don't say things like that. You ran away on the day of my wedding.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"Bama is not pure. I trusted her and was deceived......","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"That cannot be—someone has told you something false. Bama is pure gold of the finest touch.","mode":"prose-faithful","notes":["The traditional gold-quality expression `பத்தரைமாற்றுப் பசும்பொன்` is rendered by meaning rather than converted into a modern numeric assay."]}},{"id":"tirumbippaar-en-s012-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"Not gold—brass plated with gold.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":20,"printed_page":12}]},"translation":{"english_text":"I cannot believe it. You are inventing a reason for your own fault...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"(Firmly) Then don't believe it. I don't like marriage. That is all...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"This enlightenment should have dawned earlier.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Even for very great men, it dawned only later. Am I ordinary......","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u022","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/scenes/scene-12.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Standalone parenthetical after Paranthaman's enlightenment remark."},"speaker_label":null,"page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"(He takes the 'Vaazhu' book and leaves.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u023","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/scenes/scene-12.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":2,"description":"Bracketed direction introducing the lesson children near the end of scene 12."},"speaker_label":null,"page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"(The children who come for lessons run up to Poomaal.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s012-u024","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d020","source_occurrence_id":null,"source_locator":null,"speaker_label":"ஒரு குழந்தை","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Sister, sister. Ambujam says a dog's tail cannot be straightened. Is that really true, sister?","mode":"prose-faithful","notes":["The proverb-like source line is translated literally; its placement after the preceding argument is not editorially explained."]}},{"id":"tirumbippaar-en-s012-u025","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":12,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-12.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-12.md","source_record_id":"tirumbippaar-s012-d021","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Yes, all right. Come, let us study...","mode":"prose-faithful","notes":[]}}]}