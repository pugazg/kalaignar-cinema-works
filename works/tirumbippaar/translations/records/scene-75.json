{"work_id":"tirumbippaar","target_language":"en","canonical_scene":75,"scene_status":"verified","unit_count":7,"units":[{"id":"tirumbippaar-en-s075-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":90,"printed_page":82}]},"translation":{"english_text":"(Garudan Publishing House.)"}},{"id":"tirumbippaar-en-s075-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s075-d001","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":90,"printed_page":82}]},"translation":{"english_text":"The chapter of Paranthaman's confession and forgiveness of sins."}},{"id":"tirumbippaar-en-s075-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s075-d002","speaker_label":"கருடன்","page_provenance":[{"pdf_page":90,"printed_page":82}]},"translation":{"english_text":"Hmm, newspaper fellows will write like that. Can we be afraid of all that?"}},{"id":"tirumbippaar-en-s075-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s075-d003","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":90,"printed_page":82}]},"translation":{"english_text":"They say my honour itself has been destroyed because I asked forgiveness."}},{"id":"tirumbippaar-en-s075-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s075-d004","speaker_label":"கருடன்","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Some honour! If a man's honour is destroyed merely by asking forgiveness, there's no need for such honour to exist at all."}},{"id":"tirumbippaar-en-s075-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s075-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"Bravo."}},{"id":"tirumbippaar-en-s075-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":91,"printed_page":83}]},"translation":{"english_text":"(Scene ends.)"}}]}