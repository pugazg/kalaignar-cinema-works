{"work_id":"tirumbippaar","target_language":"en","canonical_scene":13,"scene_status":"verified","reconciliation_status":"corrected-source-reconciled","unit_count":9,"units":[{"id":"tirumbippaar-en-s013-u001","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"(Showing the Vaazhu book) Garuda! How is the book?","mode":"prose-faithful","notes":["The source book title `வாழு` is transliterated as `Vaazhu`."]}},{"id":"tirumbippaar-en-s013-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Absolutely splendid.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s013-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பையன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"There is something very good in this book.....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s013-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"What is it?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s013-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பையன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"The cover, sir.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s013-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Tch! Is only the cover good? The printing too is gem-like.","mode":"prose-faithful","notes":["`அட்டை மாத்திரந்தான் நல்லா இருக்கா?` is a retort asking whether only the cover is good; it is not a suggestion to change the cover.","The source phrase `மணி மணியா` is retained as the image `gem-like` rather than normalized into a modern printing-quality term."]}},{"id":"tirumbippaar-en-s013-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Garuda! I did not ask for criticism of how the printing is or how the cover is; I am asking how the advice I have given is.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s013-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-13.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":"tirumbippaar-s013-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"கருடன்","page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"Ah! Do you even have to ask about that...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s013-u009","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":13,"source":{"source_path":"works/tirumbippaar/scenes/scene-13.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-13.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-performance-direction","ordinal":1,"description":"Closing parenthetical `புத்தகத்தைப் பிரித்துப் பாடல்` after Garudan's final line."},"speaker_label":null,"page_provenance":[{"pdf_page":21,"printed_page":13}]},"translation":{"english_text":"(The book is opened; a song follows.)","mode":"prose-faithful","notes":["The source does not identify a title, lyrics or performer in this line. It is therefore preserved as a direct stage/performance direction and not linked to an invented song occurrence."]}}]}