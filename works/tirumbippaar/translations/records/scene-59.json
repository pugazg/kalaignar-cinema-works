{"work_id":"tirumbippaar","target_language":"en","canonical_scene":59,"scene_status":"verified","unit_count":16,"units":[{"id":"tirumbippaar-en-s059-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d001","speaker_label":"குமுதா","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"I tried so much to secure your release. I couldn't, Pandiyan...."}},{"id":"tirumbippaar-en-s059-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d002","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Don't grieve, Kumudha! [Source wording irregular: 'எனக்கும் விடுதலையில்லா மலர் போய்விட்டுப் போகிறது.']","notes":["The remainder of this source sentence is too irregular to translate confidently without reconstruction, so it is preserved transparently rather than guessed."]}},{"id":"tirumbippaar-en-s059-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d003","speaker_label":"குமுதா","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Pandiyan, I am helpless. Until you return, who do I have to turn to?"}},{"id":"tirumbippaar-en-s059-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d004","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"You yourself are your refuge! They say they're taking me to a prison out of town. Don't let yourself fall under Paranthaman's eye. Be careful."}},{"id":"tirumbippaar-en-s059-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d005","speaker_label":"குமுதா","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Pandiyan! How can I live separated from you?"}},{"id":"tirumbippaar-en-s059-u006","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"(She cries.)"}},{"id":"tirumbippaar-en-s059-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d006","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Don't cry, Kumudha! Don't cry!.... Let me see you once with a smiling face, to cool my heart. Come, show me a smile!"}},{"id":"tirumbippaar-en-s059-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d007","speaker_label":"குமுதா","page_provenance":[{"pdf_page":76,"printed_page":68}]},"translation":{"english_text":"Smile? Leaving my very life to wither in prison, am I to smile?"}},{"id":"tirumbippaar-en-s059-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d008","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"Don't cry, Kumudha! Three years will pass quickly. When I return and meet you, I will gather into my arms the little treasure in your lap who calls me 'Appa.'"}},{"id":"tirumbippaar-en-s059-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d009","speaker_label":"குமுதா","page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"(Startled.) Pandiyan. Pandiyan."}},{"id":"tirumbippaar-en-s059-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d010","speaker_label":"வார்டர்","page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"You must leave, amma! It's time."}},{"id":"tirumbippaar-en-s059-u012","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"(Kumudha parts from Pandiyan.)"}},{"id":"tirumbippaar-en-s059-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d011","speaker_label":"குமுதா","page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"Pandiyan. Pandiyan."}},{"id":"tirumbippaar-en-s059-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s059-d012","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"Go, Kumudha!"}},{"id":"tirumbippaar-en-s059-u015","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"(Kumudha leaves.)"}},{"id":"tirumbippaar-en-s059-u016","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":77,"printed_page":69}]},"translation":{"english_text":"(Scene ends.)"}}]}