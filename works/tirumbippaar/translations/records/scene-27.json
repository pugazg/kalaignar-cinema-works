{"work_id":"tirumbippaar","target_language":"en","canonical_scene":27,"scene_status":"verified","unit_count":8,"units":[{"id":"tirumbippaar-en-s027-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s027-d001","speaker_label":"குமுதா","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"Gundumani! Isn't the tea ready yet?"}},{"id":"tirumbippaar-en-s027-u002","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"(She comes downstairs; Poomaal comes there.)"}},{"id":"tirumbippaar-en-s027-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s027-d002","speaker_label":"குமுதா","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"Chinnamma! Tell him to send tea to him. I'm going to buy film for the camera...."}},{"id":"tirumbippaar-en-s027-u004","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"(Gundumani brings the tea.)"}},{"id":"tirumbippaar-en-s027-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s027-d003","speaker_label":"பூமால்","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"Gundumani, wait!... I'll take the tea. You go attend to your work!..."}},{"id":"tirumbippaar-en-s027-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s027-d004","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"All right, amma...."}},{"id":"tirumbippaar-en-s027-u007","kind":"stage-direction","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"(She takes it and goes upstairs.)"}},{"id":"tirumbippaar-en-s027-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s027-d005","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"(To himself) Amma is standing there herself to serve Pandiyan—what's this about? Ah, no, no! Amma is a good woman...hmm...who knows? Ah, let it go. (Suspiciously) What kind of...... All right, all right—why should a servant concern himself with all this......","notes":["The source speech is deliberately fragmentary; the ellipses and uncertainty are retained rather than reconstructed."]}}]}