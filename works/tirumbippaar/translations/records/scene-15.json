{"work_id":"tirumbippaar","target_language":"en","canonical_scene":15,"scene_status":"verified","unit_count":24,"units":[{"id":"tirumbippaar-en-s015-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/scenes/scene-15.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening bracketed direction immediately after the canonical scene-15 heading."},"speaker_label":null,"page_provenance":[{"pdf_page":22,"printed_page":14}]},"translation":{"english_text":"(There is a knock at the door. Pandiyan opens it; Punnakodi comes inside.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":22,"printed_page":14}]},"translation":{"english_text":"Father, where had you gone?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":22,"printed_page":14}]},"translation":{"english_text":"It was all for a good matter.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u004","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/scenes/scene-15.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Standalone parenthetical after Punnakodi's first reply."},"speaker_label":null,"page_provenance":[{"pdf_page":22,"printed_page":14}]},"translation":{"english_text":"(He comes inside and sits down.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":22,"printed_page":14}]},"translation":{"english_text":"Why didn't you come to the play, father? The play was really excellent.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":22,"printed_page":14}]},"translation":{"english_text":"I heard.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"Who told you, father?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"All our mill workers had come, hadn't they? They told me!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"The mill workers were able to come. The superior officer couldn't come, could he, father?","mode":"prose-faithful","notes":["`மேலதிகர்` is translated conservatively as `superior officer`; the source does not name a specific post here."]}},{"id":"tirumbippaar-en-s015-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"Don't be angry! I too had gone all the way to town on a matter concerning you......","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"What matter, father!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"I have arranged your marriage.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"Why marriage for me now? Let me first get some steady job......","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"The work you have is enough! A writer's work is steady work, isn't it? Look here, son! It is a very good match...and the girl is very beautiful! Don't refuse—marry her...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"Shouldn't I see the girl, father?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"I know all about you! That is why I brought the photograph.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u017","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/scenes/scene-15.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Standalone parenthetical after Punnakodi says he brought the photograph."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"(He searches the pocket of his coat.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/scenes/scene-15.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"source-unlabelled-speech","ordinal":1,"description":"Unlabelled spoken line immediately after the coat-pocket search; the line itself includes the photograph-giving action."},"speaker_label":null,"page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"What is this—does he eat one pocket with every wash?...... (He takes out the photograph and gives it.)","mode":"prose-faithful","notes":["This spoken line has no explicit source speaker label. It remains direct scene-linked dialogue with `speaker_label: null`; no dialogue-record ID or speaker is invented.","The complaint about a pocket being `eaten` at each wash is translated literally rather than normalized into a modern laundry complaint."]}},{"id":"tirumbippaar-en-s015-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"Well, what do you say?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"As you wish.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":23,"printed_page":15}]},"translation":{"english_text":"That's the way to say it, my king! Tomorrow itself I will go to the mill owner and ask for a little money for the wedding. (Angrily) As if he is going to give it.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u022","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"I have money myself, father!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u023","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-15.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":"tirumbippaar-s015-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"Then we can hold the wedding soon.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s015-u024","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":15,"source":{"source_path":"works/tirumbippaar/scenes/scene-15.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-15.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":3,"description":"Final standalone parenthetical after Punnakodi's last line."},"speaker_label":null,"page_provenance":[{"pdf_page":24,"printed_page":16}]},"translation":{"english_text":"(Pandiyan smiles.)","mode":"prose-faithful","notes":[]}}]}