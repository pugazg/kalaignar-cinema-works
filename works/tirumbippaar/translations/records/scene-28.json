{"work_id":"tirumbippaar","target_language":"en","canonical_scene":28,"scene_status":"verified","unit_count":38,"units":[{"id":"tirumbippaar-en-s028-u001","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"(Kumudha has Pandiyan stand and takes his photograph.)"}},{"id":"tirumbippaar-en-s028-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d001","speaker_label":"குமுதா","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"Stand properly—yes—smile a little...just a little...steady please, right....thanks...."}},{"id":"tirumbippaar-en-s028-u003","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"(She takes the photograph.)"}},{"id":"tirumbippaar-en-s028-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d002","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":32,"printed_page":24}]},"translation":{"english_text":"Give it here. I'll capture you."}},{"id":"tirumbippaar-en-s028-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d003","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"What?..."}},{"id":"tirumbippaar-en-s028-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d004","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"I mean I'll take your picture."}},{"id":"tirumbippaar-en-s028-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d005","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"That's what I thought! (Shyly)"}},{"id":"tirumbippaar-en-s028-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d006","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"(Taking the camera) Hmm...steady please....."}},{"id":"tirumbippaar-en-s028-u009","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"(Kumudha stands posing like Nataraja.)"}},{"id":"tirumbippaar-en-s028-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d007","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"What's this!"}},{"id":"tirumbippaar-en-s028-u011","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"(Poomaal arrives just then.)"}},{"id":"tirumbippaar-en-s028-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d008","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Chinnamma!"}},{"id":"tirumbippaar-en-s028-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d009","speaker_label":"பூமால்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Yes, dear!"}},{"id":"tirumbippaar-en-s028-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d010","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"We took photos separately. We'll both stand together—you take one!"}},{"id":"tirumbippaar-en-s028-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d011","speaker_label":"பூமால்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Uh-uh, Kumudha! I don't know how to take one. You take it yourself!"}},{"id":"tirumbippaar-en-s028-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d012","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Oh, Chinnamma! (Taking the camera with a pout) All right, Chinnamma! You two stand together; I'll take it. (Without guile.)"}},{"id":"tirumbippaar-en-s028-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d013","speaker_label":"பூமால்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Me?"}},{"id":"tirumbippaar-en-s028-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d014","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Go and stand there, Chinnamma!"}},{"id":"tirumbippaar-en-s028-u019","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"(Poomaal goes and stands beside Pandiyan. Kumudha prepares to take the photograph.)"}},{"id":"tirumbippaar-en-s028-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d015","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Steady please...."}},{"id":"tirumbippaar-en-s028-u021","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"(Gundumani gives a joyous shout; Kumudha trembles and drops the camera.)"}},{"id":"tirumbippaar-en-s028-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d016","speaker_label":"பூமால்","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"W...what...what?"}},{"id":"tirumbippaar-en-s028-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d017","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"(Showing the paper) Kumudha-amma passed! Passed! Passed!"}},{"id":"tirumbippaar-en-s028-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d018","speaker_label":"குமுதா","page_provenance":[{"pdf_page":33,"printed_page":25}]},"translation":{"english_text":"Passed?"}},{"id":"tirumbippaar-en-s028-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d019","speaker_label":"பூமால்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"Passed! Kumudha, you're clever!"}},{"id":"tirumbippaar-en-s028-u026","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"(They embrace.)"}},{"id":"tirumbippaar-en-s028-u027","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d020","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"Kumudha, congratulations...."}},{"id":"tirumbippaar-en-s028-u028","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"(The two try to shake hands.)"}},{"id":"tirumbippaar-en-s028-u029","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d021","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"(Showing the newspaper) Look at this number: sixteen twenty-four...."}},{"id":"tirumbippaar-en-s028-u030","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d022","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"Twenty-four.... Why, my age is twenty-four too."}},{"id":"tirumbippaar-en-s028-u031","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d023","speaker_label":"குமுதா","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"My age is only sixteen."}},{"id":"tirumbippaar-en-s028-u032","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d024","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"A well-matched number indeed."}},{"id":"tirumbippaar-en-s028-u033","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d025","speaker_label":"பூமால்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"(Sharply) Hey....keep quiet...."}},{"id":"tirumbippaar-en-s028-u034","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d026","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"No, ma'am. I mean Kumudha-amma should remain sixteen forever, like Markandeya."}},{"id":"tirumbippaar-en-s028-u035","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"(Everyone laughs.)"}},{"id":"tirumbippaar-en-s028-u036","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d027","speaker_label":"பூமால்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"Then shall we leave for our town?"}},{"id":"tirumbippaar-en-s028-u037","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d028","speaker_label":"குமுதா","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"He...."}},{"id":"tirumbippaar-en-s028-u038","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s028-d029","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"You don't have to worry about him, amma. From now on, even if he comes to our house, he won't leave us!"}}]}