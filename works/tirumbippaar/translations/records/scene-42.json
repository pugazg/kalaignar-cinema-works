{"work_id":"tirumbippaar","target_language":"en","canonical_scene":42,"scene_status":"verified","unit_count":8,"units":[{"id":"tirumbippaar-en-s042-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"(Pandiyan is rapidly writing page after page. Kumudha comes near eagerly and watches.)"}},{"id":"tirumbippaar-en-s042-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s042-d001","speaker_label":"குமுதா","page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"Why have you suddenly started writing?"}},{"id":"tirumbippaar-en-s042-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s042-d002","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"I found a good situation; I'm writing a song."}},{"id":"tirumbippaar-en-s042-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s042-d003","speaker_label":"குமுதா","page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"For which magazine?"}},{"id":"tirumbippaar-en-s042-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s042-d004","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"Which magazine would I write for...."}},{"id":"tirumbippaar-en-s042-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s042-d005","speaker_label":"குமுதா","page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"Well then, let's hear the song...."}},{"id":"tirumbippaar-en-s042-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"(Pandiyan sings what he has written.)"}},{"id":"tirumbippaar-en-s042-u008","kind":"song-reference","status":"verified","source":{"source_occurrence_id":"tirumbippaar-song-007","speaker_label":null,"page_provenance":[{"pdf_page":57,"printed_page":49}]},"translation":{"english_text":"“Kalappadam, kalappadam” [“Adulteration, adulteration”]","notes":["Only the repeated title/refrain printed in the booklet is translated. No missing lyric lines are imported or reconstructed."]}}]}