{"work_id":"tirumbippaar","target_language":"en","canonical_scene":67,"scene_status":"verified","unit_count":12,"units":[{"id":"tirumbippaar-en-s067-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(Punnakodi's house—night. Punnakodi knocks at the door.)"}},{"id":"tirumbippaar-en-s067-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d001","speaker_label":"குரல்","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Radha! Radha!"}},{"id":"tirumbippaar-en-s067-u003","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(Paranthaman leaves by another side. Punnakodi comes in. Before Radha can say that Paranthaman had come...)"}},{"id":"tirumbippaar-en-s067-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d002","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Radha, serve the food quickly!"}},{"id":"tirumbippaar-en-s067-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d003","speaker_label":"ராதா","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Mm... mm... mm..."}},{"id":"tirumbippaar-en-s067-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d004","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"What... today I must eat on time...","notes":["The source phrase is colloquial/irregular; it is not normalized beyond its supported sense."]}},{"id":"tirumbippaar-en-s067-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(The gramophone is indicated for playing a song.)"}},{"id":"tirumbippaar-en-s067-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d005","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Yes! That's how music should be listened to! Serve the food!"}},{"id":"tirumbippaar-en-s067-u009","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(She points toward the window, indicating Paranthaman.)"}},{"id":"tirumbippaar-en-s067-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d006","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"If the window is open, just close it..."}},{"id":"tirumbippaar-en-s067-u011","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(She tries to say something more.)"}},{"id":"tirumbippaar-en-s067-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d007","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"Forget all that! Are you going to serve the food or not!"}}]}