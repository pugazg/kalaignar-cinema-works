    {"id":"tirumbippaar-en-s067-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(Punyakodi's house—night. Punyakodi knocks at the door.)"}},
    {"id":"tirumbippaar-en-s067-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d001","speaker_label":"குரல்","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Radha! Radha!"}},
    {"id":"tirumbippaar-en-s067-u003","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(Paranthaman leaves by another side. Punyakodi comes in. Radha tries to tell him that Paranthaman had come.)"}},
    {"id":"tirumbippaar-en-s067-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d002","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Radha, serve the food quickly!"}},
    {"id":"tirumbippaar-en-s067-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d003","speaker_label":"ராதா","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"..........","notes":["The source prints only dots for Radha's labelled response; no vocalization is invented."]}},
    {"id":"tirumbippaar-en-s067-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d004","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"What... today I have to eat on time and go to bed..."}},
    {"id":"tirumbippaar-en-s067-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(She points to the gramophone, indicating that it had been played.)"}},
    {"id":"tirumbippaar-en-s067-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d005","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Yes! Is this the time to listen to music! Serve the food!"}},
    {"id":"tirumbippaar-en-s067-u009","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(She points to the window through which Paranthaman left.)"}},
    {"id":"tirumbippaar-en-s067-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d006","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"If the window is open, just close it..."}},
    {"id":"tirumbippaar-en-s067-u011","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"(She tries to say something more.)"}},
    {"id":"tirumbippaar-en-s067-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s067-d007","speaker_label":"புண்யகோடி","page_provenance":[{"pdf_page":84,"printed_page":76}]},"translation":{"english_text":"Forget all that! Are you going to serve the food or not!"}}
  ]
