{"work_id":"tirumbippaar","target_language":"en","canonical_scene":66,"scene_status":"verified","unit_count":11,"units":[{"id":"tirumbippaar-en-s066-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"(At the entrance to the mill.)"}},{"id":"tirumbippaar-en-s066-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d001","speaker_label":"தொழிலாளி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"What are the owner and Paranthaman talking about for so long?"}},{"id":"tirumbippaar-en-s066-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d002","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"What else would they talk about! Paranthaman will come back only after deciding whether the owner is going to consider our demands or not. Is he an ordinary man! A revolutionary incarnation of Socrates."}},{"id":"tirumbippaar-en-s066-u004","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"(Paranthaman comes quickly.)"}},{"id":"tirumbippaar-en-s066-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d003","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"Brother! What did you speak about! What happened......"}},{"id":"tirumbippaar-en-s066-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d004","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":82,"printed_page":74}]},"translation":{"english_text":"What happened? I explained the grievances. I pleaded in every possible way that the demands be considered. I even warned him that a workers' revolution would come. That owner did not budge."}},{"id":"tirumbippaar-en-s066-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d005","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Then?"}},{"id":"tirumbippaar-en-s066-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d006","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"What else! I must get married!"}},{"id":"tirumbippaar-en-s066-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d007","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"What?"}},{"id":"tirumbippaar-en-s066-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d008","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"No... we must make a resolution! We must draw up a plan! All these days we stayed quiet, believing the demands would be attended to. He has mistaken that for cowardice. A man of blind judgement! Let us rise in fury! Let us raise the battle flag! Let us make revolution! Revolution!"}},{"id":"tirumbippaar-en-s066-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s066-d009","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":83,"printed_page":75}]},"translation":{"english_text":"Revolution! (Everyone raises the cry of 'Revolution!')"}}]}