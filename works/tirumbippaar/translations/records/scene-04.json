      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d004", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பூமால்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "All right, all right... ... what's wrong with that!", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "tirumbippaar-en-s004-u006",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 4,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d005", "source_occurrence_id": null, "source_locator": null, "speaker_label": "தங்கம்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "Why haven't you married, dear... ... ...", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "tirumbippaar-en-s004-u007",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 4,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d006", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பூமால்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "I'm the one responsible for this family, aren't I? My younger brother was brought up in comfort; Father and Mother ordered that the family's hardships should not be placed on him. My elder sister's daughter, who has no father or mother, is studying in Madras; I am her support.", "mode": "prose-faithful", "notes": ["`சென்னை` is rendered as `Madras` in this 1953-period translation context; the canonical Tamil place name remains unchanged."]}
    },
    {
      "id": "tirumbippaar-en-s004-u008",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 4,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d007", "source_occurrence_id": null, "source_locator": null, "speaker_label": "குணரத்தனம்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "It is because you are a motherly support to everyone like this that they are looking for your life-partner as someone who will live here with the household!...... ...", "mode": "prose-faithful", "notes": ["The source refers to a husband who would remain with Poomaal's household; no modern family-law terminology is added."]}
    },
    {
      "id": "tirumbippaar-en-s004-u009",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 4,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d008", "source_occurrence_id": null, "source_locator": null, "speaker_label": "தங்கம்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "Oh dear...you won't find a husband like that... the girl looks like Lakshmi herself!", "mode": "prose-faithful", "notes": ["`லக்ஷ்மி` is treated as the source's comparison to Lakshmi, not normalized in Tamil metadata."]}
    },
    {
