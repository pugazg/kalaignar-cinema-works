      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d011", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பூமால்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "They've come to fix the marriage! Well... ... you agree, don't you... ... ...", "mode": "prose-faithful", "notes": []}
