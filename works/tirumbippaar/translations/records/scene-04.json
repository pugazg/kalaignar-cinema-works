      "translation": {"english_text": "(Paranthaman enters, bathed and dressed.)", "mode": "prose-faithful", "notes": []}
    },
    {
      "id": "tirumbippaar-en-s004-u011",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 4,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d009", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பூமால்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "Come, brother! Do you know these people? (Paranthaman stares blankly.) Oh! Looks as though you know only their daughter... ... Bama's parents!.", "mode": "prose-faithful", "notes": ["The embedded source action remains inside the dialogue unit because it is part of the immutable dialogue record."]}
    },
