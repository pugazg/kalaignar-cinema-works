      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d001", "source_occurrence_id": null, "source_locator": null, "speaker_label": "குணரத்தனம்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "Then I'm happy. The seventh is an auspicious day... ... ...", "mode": "prose-faithful", "notes": []}
