      "canonical_scene": 4,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-04.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-04.md", "source_record_id": "tirumbippaar-s004-d003", "source_occurrence_id": null, "source_locator": null, "speaker_label": "குணரத்தனம்", "page_provenance": [{"pdf_page": 12, "printed_page": 4}]},
      "translation": {"english_text": "No, madam! I have a little faith in the stars.", "mode": "prose-faithful", "notes": ["`நக்ஷத்திரம்` is rendered as the astrological `stars` without expanding the belief beyond what the source says."]}
    },
    {
