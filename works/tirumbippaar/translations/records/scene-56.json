{"work_id":"tirumbippaar","target_language":"en","canonical_scene":56,"scene_status":"verified","unit_count":16,"units":[{"id":"tirumbippaar-en-s056-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d001","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"Usha! Didn't I tell you not to go out at night! Did you listen? You go saying you're helping the poor."}},{"id":"tirumbippaar-en-s056-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d002","speaker_label":"உஷா","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"Why talk about what has already happened, Appa? What did the police say?"}},{"id":"tirumbippaar-en-s056-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d003","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"What did they say? Apparently no one has been caught!"}},{"id":"tirumbippaar-en-s056-u004","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"(Paranthaman enters saying, 'He's been caught!')"}},{"id":"tirumbippaar-en-s056-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d004","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"Who?"}},{"id":"tirumbippaar-en-s056-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d005","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"(Sitting down.) I heard everything. Oh... so this is Usha! (To Usha.) It was God who averted the danger that befell you."}},{"id":"tirumbippaar-en-s056-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d006","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":70,"printed_page":62}]},"translation":{"english_text":"Leave that aside—you said the man has been caught!"}},{"id":"tirumbippaar-en-s056-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d007","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Yes. This is the work of violent men who incite the workers!"}},{"id":"tirumbippaar-en-s056-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d008","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Ah... a violent man!"}},{"id":"tirumbippaar-en-s056-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d009","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"That man is Pandiyan."}},{"id":"tirumbippaar-en-s056-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d010","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Pandiyan?"}},{"id":"tirumbippaar-en-s056-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d011","speaker_label":"உஷா","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Pandiyan?"}},{"id":"tirumbippaar-en-s056-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d012","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"The very same! He has held the inaugural ceremony for lawlessness. Soon he'll set fire to the mill itself. He has gathered a small gang solely to destroy you."}},{"id":"tirumbippaar-en-s056-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d013","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Hmm! Evidence to catch him!"}},{"id":"tirumbippaar-en-s056-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d014","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Evidence! Where in Madras do you think the stolen diamond necklace is? It must be in his house. Inform the police at once and have his house searched. This must be done urgently. Phone them right now!"}},{"id":"tirumbippaar-en-s056-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s056-d015","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":71,"printed_page":63}]},"translation":{"english_text":"Bravo! Exactly the right idea! (He picks up the phone and speaks.) Hello! Police station!"}}]}