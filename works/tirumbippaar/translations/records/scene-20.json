{"work_id":"tirumbippaar","target_language":"en","canonical_scene":20,"scene_status":"verified","unit_count":22,"units":[{"id":"tirumbippaar-en-s020-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/scenes/scene-20.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening direction: Poomaal is seated in the train."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"(Poomaal is seated in the train.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"குணமணி","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Amma! Then I'll get into the next carriage.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u003","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/scenes/scene-20.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Gunamani leaves; Pandiyan enters the same carriage; Poomaal recognizes him through his book and takes out tiffin."},"speaker_label":null,"page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"(She leaves. Pandiyan comes and gets into the same carriage. From the book he wrote, 'Vaazhu Vaazha Vidu,' Poomaal recognizes who he is. Then she takes out the tiffin.)","mode":"prose-faithful","notes":["The Tamil book title is transliterated to preserve its connection to the earlier title contrast."]}},{"id":"tirumbippaar-en-s020-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Please eat....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"No, thank you.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Have a little.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Many thanks! You eat!....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Which town are you going to?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u009","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"I...I don't know myself.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"You are in great anguish. Such things are common in the world. You should not take them to heart....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Do you know me!...","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"I do...here... (She shows the book.)","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u013","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"(Lowering his head) What a disgrace...alas....","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Don't be distressed.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d013","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":28,"printed_page":20}]},"translation":{"english_text":"Can you understand my whole story?","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u016","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d014","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"(Uneasily) I understand. You, who should have been a bridegroom today......","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u017","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d015","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Enough...I should never show my face to the world again!","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u018","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d016","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"But you have done nothing wrong.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u019","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d017","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"I did nothing wrong. I, who lived bound by honour and self-respect, have today become a symbol of disgrace because of my foolishness. For everyone who sees me to spit in contempt, for those who behold me to mock me—though I had eyes I was blind, though I had ears I was deaf. Without thoroughly enquiring about that cactus-like woman, I dressed myself up as a bridegroom and came running like a fool. I did nothing wrong.","mode":"prose-faithful","notes":["The source's repeated `நானு தவறு செய்யவில்லை` frames the speech and is preserved.","The unusual insult `கள்ளி பொறுத்தி` is rendered conservatively as `cactus-like woman` rather than silently replaced with a modern epithet."]}},{"id":"tirumbippaar-en-s020-u020","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d018","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமால்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Be quiet now. Come to Madras and take a little rest at our house.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u021","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-20.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":"tirumbippaar-s020-d019","source_occurrence_id":null,"source_locator":null,"speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"Rest? No rest can drive away this pain.","mode":"prose-faithful","notes":[]}},{"id":"tirumbippaar-en-s020-u022","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":20,"source":{"source_path":"works/tirumbippaar/scenes/scene-20.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-20.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Closing direction: the train moves on."},"speaker_label":null,"page_provenance":[{"pdf_page":29,"printed_page":21}]},"translation":{"english_text":"(The train moves on.)","mode":"prose-faithful","notes":[]}}]}