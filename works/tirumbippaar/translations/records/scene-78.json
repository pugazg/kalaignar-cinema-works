{"work_id":"tirumbippaar","target_language":"en","canonical_scene":78,"scene_status":"verified","unit_count":6,"units":[{"id":"tirumbippaar-en-s078-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s078-d001","speaker_label":"வார்டர்","page_provenance":[{"pdf_page":94,"printed_page":86}]},"translation":{"english_text":"You're being released, appa."}},{"id":"tirumbippaar-en-s078-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s078-d002","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":94,"printed_page":86}]},"translation":{"english_text":"So soon? Three years haven't passed yet..."}},{"id":"tirumbippaar-en-s078-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s078-d003","speaker_label":"வார்டர்","page_provenance":[{"pdf_page":94,"printed_page":86}]},"translation":{"english_text":"Not just you. Today this whole subcontinent is being freed—it's the Independence Day celebration. That's why you're being released."}},{"id":"tirumbippaar-en-s078-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s078-d004","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":94,"printed_page":86}]},"translation":{"english_text":"Sir! They'll give me a pass to go to Madras, won't they?"}},{"id":"tirumbippaar-en-s078-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s078-d005","speaker_label":"வார்டர்","page_provenance":[{"pdf_page":94,"printed_page":86}]},"translation":{"english_text":"Oh. They'll give you one for whichever town you need to go to. Your family is in Madras, isn't it...."}},{"id":"tirumbippaar-en-s078-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s078-d006","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":94,"printed_page":86}]},"translation":{"english_text":"Yes. My Kumudha is there."}}]}