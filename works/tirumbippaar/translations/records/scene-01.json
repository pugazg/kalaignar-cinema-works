        "speaker_label": "பூமால்",
        "page_provenance": [
          {"pdf_page": 9, "printed_page": 1}
        ]
      },
      "translation": {
        "english_text": "No. Pandiyan is innocent! He did not commit the murder—did not commit the murder. I alone committed the murder.",
        "mode": "prose-faithful",
        "notes": [
          "The source repeats the denial across the dash; the English deliberately preserves that repetition rather than smoothing it away."
        ]
      }
    },
