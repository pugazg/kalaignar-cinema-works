{"work_id":"tirumbippaar","target_language":"en","canonical_scene":91,"scene_status":"verified","unit_count":22,"units":[{"id":"tirumbippaar-en-s091-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d001","speaker_label":"ஊஷா","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Appa, during the quarrel between Poomaal and Paranthaman I understood clearly that it was Paranthaman who committed the highway robbery and stole the necklace."}},{"id":"tirumbippaar-en-s091-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d002","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Poor innocent Pandiyan suffered for nothing because of me.","notes":["The Tamil source is grammatically irregular at the end of the sentence; the translation follows the supported sense without altering the source record."]}},{"id":"tirumbippaar-en-s091-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d003","speaker_label":"ஊஷா","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"There is only one way to atone for that sin."}},{"id":"tirumbippaar-en-s091-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d004","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"What is it, Usha?"}},{"id":"tirumbippaar-en-s091-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d005","speaker_label":"ஊஷா","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Grant equality to the workers according to Pandiyan's principles."}},{"id":"tirumbippaar-en-s091-u006","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"(Pandiyan enters.)"}},{"id":"tirumbippaar-en-s091-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d006","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":109,"printed_page":101}]},"translation":{"english_text":"Pandiyan!"}},{"id":"tirumbippaar-en-s091-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d007","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Don't try to fool me again by baring your teeth in a smile! This time it is one thing or the other. The workers who were unjustly dismissed must be given their jobs back immediately."}},{"id":"tirumbippaar-en-s091-u009","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d008","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Pandiyan!"}},{"id":"tirumbippaar-en-s091-u010","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d009","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Is taking revenge on so many families for one man's mistake what you call humanity?"}},{"id":"tirumbippaar-en-s091-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d010","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"I understand that, Pandiyan!"}},{"id":"tirumbippaar-en-s091-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d011","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Understanding is not enough. A remedy must be made immediately."}},{"id":"tirumbippaar-en-s091-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d012","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Pandiyan! Not only will I take the workers back. As atonement for the cruelty I inflicted on you though you were innocent, I give permission for the very administration of Sivasakthi Mill to be run according to your principles and Usha's principles."}},{"id":"tirumbippaar-en-s091-u014","kind":"dialogue","status":"verified","source":{"source_record_id":null,"speaker_label":null,"page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"(Pointing to the workers.) Here are the owners of the mill! Your comrades! (Handing it over.) Here is the administration of the mill!","notes":["The booklet prints this passage in parentheses without repeating a speaker label; the evident contextual attribution is not inserted into metadata."]}},{"id":"tirumbippaar-en-s091-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d013","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Is that so! Long live your fame! May this quality flourish! Comrades! From today Sivasakthi Mill will become Jana Sakthi Mill! Labour according to ability, facilities according to need. Equality will flourish—social justice will shine—a social renaissance will take shape!"}},{"id":"tirumbippaar-en-s091-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d014","speaker_label":"தொழிலாளர்கள்","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Long live Pandiyan! Long live Pandiyan!"}},{"id":"tirumbippaar-en-s091-u017","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"(A servant runs in.)"}},{"id":"tirumbippaar-en-s091-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d015","speaker_label":"வேலைக்காரன்","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Master, have you seen this?"}},{"id":"tirumbippaar-en-s091-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d016","speaker_label":"முதலாளி","page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"Ah! What!"}},{"id":"tirumbippaar-en-s091-u020","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":110,"printed_page":102}]},"translation":{"english_text":"(The newspaper is handed to Pandiyan.)"}},{"id":"tirumbippaar-en-s091-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s091-d017","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":111,"printed_page":103}]},"translation":{"english_text":"Yes!"}},{"id":"tirumbippaar-en-s091-u022","kind":"written-text","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":111,"printed_page":103}]},"translation":{"english_text":"Newspaper News: 'Elder sister killed younger brother.'","notes":["The booklet marks this explicitly as 'பத்திரிகை News'; it is preserved as written newspaper content rather than dialogue."]}}]}