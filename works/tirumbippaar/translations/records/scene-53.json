{"work_id":"tirumbippaar","target_language":"en","canonical_scene":53,"scene_status":"verified","unit_count":8,"units":[{"id":"tirumbippaar-en-s053-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s053-d001","speaker_label":"முரடன்","page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"Look at this. When I grabbed Usha and pulled her, this necklace snapped off too and came away in my hand."}},{"id":"tirumbippaar-en-s053-u002","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"(Paranthaman takes the necklace and looks at it.)"}},{"id":"tirumbippaar-en-s053-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s053-d002","speaker_label":"கருடன்","page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"Ah! Fine diamonds. It must be very valuable. Hmm... give it, give it. That is, whatever remains. We'll put it in the box."}},{"id":"tirumbippaar-en-s053-u004","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"(Paranthaman does not give the necklace.)"}},{"id":"tirumbippaar-en-s053-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s053-d003","speaker_label":"பையன்","page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"Speaking as though spitting fire. Writing with biting heat. Running a party without restraint. Blindly inciting workers. All these are the trailing tiger's tail of the false leader.","notes":["The final metaphor follows the verified source wording conservatively rather than replacing it with a familiar expression."]}},{"id":"tirumbippaar-en-s053-u006","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"(He comes along reading Pandiyan's book 'The False Leader.')"}},{"id":"tirumbippaar-en-s053-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"(Paranthaman's anger increases.)"}},{"id":"tirumbippaar-en-s053-u008","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":68,"printed_page":60}]},"translation":{"english_text":"(Scene ends.)"}}]}