{"work_id":"tirumbippaar","target_language":"en","canonical_scene":64,"scene_status":"verified","unit_count":7,"units":[{"id":"tirumbippaar-en-s064-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"(Watchman's house.)"}},{"id":"tirumbippaar-en-s064-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s064-d001","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"Why do you keep grieving, amma! Be happy, amma!"}},{"id":"tirumbippaar-en-s064-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s064-d002","speaker_label":"குமுதா","page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"What happiness is there for me! When I think that I have come under your shelter only to become another burden......"}},{"id":"tirumbippaar-en-s064-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s064-d003","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"Never mind, amma... What's that to worry about! You can stay right here until your husband comes back from jail. Who else do I have? You're like my own daughter!........"}},{"id":"tirumbippaar-en-s064-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s064-d004","speaker_label":"குமுதா","page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"I can never forget your help!......"}},{"id":"tirumbippaar-en-s064-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s064-d005","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"All right, take care, amma! I'll go to the hospital and come back."}},{"id":"tirumbippaar-en-s064-u007","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":81,"printed_page":73}]},"translation":{"english_text":"(Scene ends.)"}}]}