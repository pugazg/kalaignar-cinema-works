{"work_id":"tirumbippaar","target_language":"en","canonical_scene":29,"scene_status":"verified","unit_count":27,"units":[{"id":"tirumbippaar-en-s029-u001","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"(Paranthaman arrives.)"}},{"id":"tirumbippaar-en-s029-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d001","speaker_label":"கருடன்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"Come, man! The last two or three weeks must have been one grand, jolly life...."}},{"id":"tirumbippaar-en-s029-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d002","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":34,"printed_page":26}]},"translation":{"english_text":"Poor thing...Bama longed to set up a family in Chennai and put me in the prison of domestic life... Where she went, what happened to her!...."}},{"id":"tirumbippaar-en-s029-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d003","speaker_label":"கருடன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Hmm...family life and all that—man ought to be free, like me. Hasn't God created an example for us—the one that flits from flower to flower......","notes":["The source leaves the flower-to-flower comparison unfinished; the historical English insertion of `bee` has been removed."]}},{"id":"tirumbippaar-en-s029-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d004","speaker_label":"பையன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"The monkey that leaps from tree to tree."}},{"id":"tirumbippaar-en-s029-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d005","speaker_label":"கருடன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Hey...."}},{"id":"tirumbippaar-en-s029-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d006","speaker_label":"பையன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"I thought you had forgotten, so I reminded you."}},{"id":"tirumbippaar-en-s029-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d007","speaker_label":"கருடன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Kambar's son Ambikapathi! Keep quiet, you meddlesome little cashew nut!"}},{"id":"tirumbippaar-en-s029-u009","kind":"stage-direction","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"(The sound of a workers' procession passing along the street is heard.)"}},{"id":"tirumbippaar-en-s029-u010","kind":"written-text","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Slogan","notes":["Structural heading `கோஷம்`; retained separately from the chant body."]}},{"id":"tirumbippaar-en-s029-u011","kind":"chant","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Raise the wages of the Sivasakthi Mill workers. Raise the workers' wages...raise the workers' wages.","notes":["The source labels this standalone block `கோஷம்`; no individual speaker is invented."]}},{"id":"tirumbippaar-en-s029-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d008","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"What's that?"}},{"id":"tirumbippaar-en-s029-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d009","speaker_label":"பையன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"It has nothing to do with us."}},{"id":"tirumbippaar-en-s029-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d010","speaker_label":"கருடன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Not to us—to us! Tell the matter including him too, you donkey!","notes":["The compressed colloquial `நமக்காமில்ல நமக்கு! இவரும் சேந்துக்கிறாரு` is kept deliberately close to the source rather than expanded into a different explanation."]}},{"id":"tirumbippaar-en-s029-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d011","speaker_label":"பையன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"The mill workers are agitating for a wage increase!..."}},{"id":"tirumbippaar-en-s029-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d012","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Is that so? Then it has nothing to do with us."}},{"id":"tirumbippaar-en-s029-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d013","speaker_label":"கருடன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Why not? I've got an idea. If we make use of this agitation and write a book about the toilers, it will sell well at a time like this."}},{"id":"tirumbippaar-en-s029-u018","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d014","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":35,"printed_page":27}]},"translation":{"english_text":"Yes....I'll start writing today itself. What shall we call the book...ah...right.... 'The Toiler's Voice.'"}},{"id":"tirumbippaar-en-s029-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d015","speaker_label":"கருடன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"Bravo! 'The Toiler's Voice.' What a brain! What a brain!"}},{"id":"tirumbippaar-en-s029-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d016","speaker_label":"பையன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"First pay a little attention to my voice!"}},{"id":"tirumbippaar-en-s029-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d017","speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"What is it?"}},{"id":"tirumbippaar-en-s029-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d018","speaker_label":"பையன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"My wages."}},{"id":"tirumbippaar-en-s029-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d019","speaker_label":"கருடன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"(Angrily) Hey! If a book is written for the mill workers..."}},{"id":"tirumbippaar-en-s029-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d020","speaker_label":"பையன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"I'm a worker too, sir!..."}},{"id":"tirumbippaar-en-s029-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d021","speaker_label":"கருடன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"A great worker he is! Paranthama! You start writing! Of the profit, one quarter for you and three quarters for me."}},{"id":"tirumbippaar-en-s029-u026","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d022","speaker_label":"பையன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"For me..."}},{"id":"tirumbippaar-en-s029-u027","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s029-d023","speaker_label":"கருடன்","page_provenance":[{"pdf_page":36,"printed_page":28}]},"translation":{"english_text":"A slap! (He slaps him.)"}}]}