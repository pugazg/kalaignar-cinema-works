{"work_id":"tirumbippaar","target_language":"en","canonical_scene":34,"scene_status":"verified","unit_count":10,"units":[{"id":"tirumbippaar-en-s034-u001","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s034-d001","speaker_label":"பூமால்","page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"Name two people who said there should be no violence against living beings."}},{"id":"tirumbippaar-en-s034-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s034-d002","speaker_label":"பையன்","page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"Buddha, Gandhi."}},{"id":"tirumbippaar-en-s034-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s034-d003","speaker_label":"பூமால்","page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"Good! Who are the Three Crowned Kings?"}},{"id":"tirumbippaar-en-s034-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s034-d004","speaker_label":"பையன்","page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"The Chera, the Chola.... (Hesitates.)"}},{"id":"tirumbippaar-en-s034-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s034-d005","speaker_label":"பூமால்","page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"Hmm. Say it...... Pandiyan...."}},{"id":"tirumbippaar-en-s034-u006","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"(At the word ‘Pandiyan,’ her expression changes. Garudan murmurs. Then, to the students:)"}},{"id":"tirumbippaar-en-s034-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s034-d006","speaker_label":"பூமால்","page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"All right, go home and come back tomorrow......."}},{"id":"tirumbippaar-en-s034-u008","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"(She sends everyone away.)"}},{"id":"tirumbippaar-en-s034-u009","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"(After they leave, she goes toward the garden.)"}},{"id":"tirumbippaar-en-s034-u010","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":42,"printed_page":34}]},"translation":{"english_text":"(Scene ends.)"}}]}