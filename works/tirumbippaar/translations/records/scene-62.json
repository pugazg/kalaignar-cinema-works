{"work_id":"tirumbippaar","target_language":"en","canonical_scene":62,"scene_status":"verified","unit_count":5,"units":[{"id":"tirumbippaar-en-s062-u005","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"(Kumudha moves away.)"}},{"id":"tirumbippaar-en-s062-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"(Behind a house.)"}},{"id":"tirumbippaar-en-s062-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s062-d001","speaker_label":"அம்மாமி","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"What a fine job you're doing, girl! It looks as though you'll smash all the things in our house!... Go, go! Enough—enough of you and your work. That's why I said we shouldn't take a pregnant woman on for work."}},{"id":"tirumbippaar-en-s062-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s062-d002","speaker_label":"குமுதா","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"Amma! Think of me as your own daughter..."}},{"id":"tirumbippaar-en-s062-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s062-d003","speaker_label":"அம்மாமி","page_provenance":[{"pdf_page":79,"printed_page":71}]},"translation":{"english_text":"Daughter, indeed! I've already got nine girls born here! Do I need you too? I said go—go!"}}]}