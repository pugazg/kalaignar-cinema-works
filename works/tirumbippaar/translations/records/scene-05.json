      "source": {"source_path": "works/tirumbippaar/scenes/scene-05.md", "canonical_scene_path": "works/tirumbippaar/scenes/scene-05.md", "source_record_id": null, "source_occurrence_id": null, "source_locator": {"kind": "scene-bracketed-stage-direction", "ordinal": 1, "description": "Opening bracketed direction immediately after the canonical scene-5 heading."}, "speaker_label": null, "page_provenance": [{"pdf_page": 13, "printed_page": 5}]},
      "translation": {"english_text": "(The sound 'tak, tak' is heard as the publishing house rubber stamp is pressed onto tied parcels and book-post packets.)", "mode": "prose-faithful", "notes": ["The source's sound effect is retained rather than replaced with an invented effect."]}
    },
    {
      "id": "tirumbippaar-en-s005-u002",
      "kind": "dialogue",
      "status": "verified",
      "target_language": "en",
      "canonical_scene": 5,
      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-05.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-05.md", "source_record_id": "tirumbippaar-s005-d001", "source_occurrence_id": null, "source_locator": null, "speaker_label": "கருடன்", "page_provenance": [{"pdf_page": 13, "printed_page": 5}]},
      "translation": {"english_text": "(To the office boy) Boy...hmm...it's time for the parcels. Go...go. We can send the rest tomorrow.", "mode": "prose-faithful", "notes": []}
    },
    {
