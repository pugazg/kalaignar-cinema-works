      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-05.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-05.md", "source_record_id": "tirumbippaar-s005-d023", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பரந்தாமன்", "page_provenance": [{"pdf_page": 15, "printed_page": 7}]},
      "translation": {"english_text": "Hey...the fact that I was slapped must not get outside!", "mode": "prose-faithful", "notes": []}
