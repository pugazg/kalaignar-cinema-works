      "source": {"source_path": "works/tirumbippaar/dialogues/records/scene-05.json", "canonical_scene_path": "works/tirumbippaar/scenes/scene-05.md", "source_record_id": "tirumbippaar-s005-d025", "source_occurrence_id": null, "source_locator": null, "speaker_label": "பரந்தாமன்", "page_provenance": [{"pdf_page": 15, "printed_page": 7}]},
      "translation": {"english_text": "Even if it was not a commercial success, Illara Jothi has given me a delightful light.", "mode": "prose-faithful", "notes": ["The source plays on the title word `ஜோதி` (`light`); the English retains the title and its closing semantic echo without inventing a new pun."]}
