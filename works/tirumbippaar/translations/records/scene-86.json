{"work_id":"tirumbippaar","target_language":"en","canonical_scene":86,"scene_status":"verified","unit_count":30,"units":[{"id":"tirumbippaar-en-s086-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"(Watchman's house.)"}},{"id":"tirumbippaar-en-s086-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d001","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Kumudha! Kumudha!"}},{"id":"tirumbippaar-en-s086-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d002","speaker_label":"குமுதா","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Pandiyan!...."}},{"id":"tirumbippaar-en-s086-u004","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"(They embrace.)"}},{"id":"tirumbippaar-en-s086-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d003","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Kumudha! Do you know all the places I wandered searching for you? Yes—where is the child? (He fondles the child.)"}},{"id":"tirumbippaar-en-s086-u006","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d004","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Kumudha, what is the child's name?"}},{"id":"tirumbippaar-en-s086-u007","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d005","speaker_label":"குமுதா","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"What could it be? You tell me!"}},{"id":"tirumbippaar-en-s086-u008","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d006","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Grandfather's name?"}},{"id":"tirumbippaar-en-s086-u009","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"(Punnakodi comes begging with a group of men and women, including the mute woman. The watchman, returning home, sees them.)"}},{"id":"tirumbippaar-en-s086-u010","kind":"chant","status":"verified","source":{"speaker_label":null,"page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Samba Sadasivam—Samba Sadasivam—Samba...","notes":["This is a source-visible collective begging chant embedded in the stage direction; no individual speaker is invented."]}},{"id":"tirumbippaar-en-s086-u011","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d007","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"What is this, man.... Even when one person comes there is no one to give alms, and you come bringing a whole battalion."}},{"id":"tirumbippaar-en-s086-u012","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d008","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"We all come together because coming one by one would be troublesome. Hmm, what can we do! Such is our time. We used to live well!"}},{"id":"tirumbippaar-en-s086-u013","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d009","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":103,"printed_page":95}]},"translation":{"english_text":"Oh, are you weavers!"}},{"id":"tirumbippaar-en-s086-u014","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d010","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Forget that! We're all mill workers—and from Coimbatore at that! No work. We're suffering like this."}},{"id":"tirumbippaar-en-s086-u015","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d011","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Kumudha! Kumudha! Bring a little rice, amma!"}},{"id":"tirumbippaar-en-s086-u016","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d012","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"A little?—after seeing this crowd......"}},{"id":"tirumbippaar-en-s086-u017","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d013","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"What then—do you expect them to give a whole measure!"}},{"id":"tirumbippaar-en-s086-u018","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"(Pandiyan and Kumudha come out.)"}},{"id":"tirumbippaar-en-s086-u019","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d014","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"(Seeing Punnakodi.) Appa! Appa!"}},{"id":"tirumbippaar-en-s086-u020","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d015","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Pandiyan! My son! Have you seen what has become of your father!"}},{"id":"tirumbippaar-en-s086-u021","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d016","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Appa! You've become a destitute wanderer?"}},{"id":"tirumbippaar-en-s086-u022","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d017","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"That Paranthaman made me this way."}},{"id":"tirumbippaar-en-s086-u023","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d018","speaker_label":"குமுதா","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"(To the watchman.) This is Pandiyan! My husband!"}},{"id":"tirumbippaar-en-s086-u024","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d019","speaker_label":"வாட்ச்மேன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Is that so!"}},{"id":"tirumbippaar-en-s086-u025","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d020","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Yes. (To the watchman.) This is my father. Appa! What happened?"}},{"id":"tirumbippaar-en-s086-u026","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d021","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Paranthaman made us strike for his own selfish purpose and then asked forgiveness. Because of that, the owner said there was no work for any of us."}},{"id":"tirumbippaar-en-s086-u027","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d022","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"Ah! Who committed the offence? And who is suffering the cruelty?"}},{"id":"tirumbippaar-en-s086-u028","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d023","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":104,"printed_page":96}]},"translation":{"english_text":"It's not only us, son! Hundreds of families have ended up like this!"}},{"id":"tirumbippaar-en-s086-u029","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d024","speaker_label":"பாண்டியன்","page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"Hundreds of families! I will meet that owner on behalf of the workers who are suffering."}},{"id":"tirumbippaar-en-s086-u030","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s086-d025","speaker_label":"புண்ணகோடி","page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"My son is truly my son. (He embraces him.)"}}]}