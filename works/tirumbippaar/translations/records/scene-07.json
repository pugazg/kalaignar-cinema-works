  "units":[
    {"id":"tirumbippaar-en-s007-u001","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/scenes/scene-07.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-bracketed-stage-direction","ordinal":1,"description":"Opening bracketed direction immediately after the canonical scene-7 heading."},"speaker_label":null,"page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"(Several women inside are busy with wedding preparations. Kumudha arrives. Poomalai eagerly runs to her—)","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u002","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d001","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமாலை","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Kumudha!","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u003","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d002","source_occurrence_id":null,"source_locator":null,"speaker_label":"குமுதா","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Chinnamma! (They embrace.)","mode":"prose-faithful","notes":["The kinship address `சின்னம்மா` is transliterated rather than assigned a narrower English relationship."]}},
    {"id":"tirumbippaar-en-s007-u004","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d003","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமாலை","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Why are you so late, dear?","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u005","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d004","source_occurrence_id":null,"source_locator":null,"speaker_label":"குமுதா","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Exams, Chinnamma. I couldn't come at once...","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u006","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d005","source_occurrence_id":null,"source_locator":null,"speaker_label":"பூமாலை","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Sit down, Kumudha. I had thought I would marry you to my younger brother and keep you here in the household...","mode":"prose-faithful","notes":["The corrected source's `வீட்டோட இருப்பேன்னு` is retained; the historical English had dropped the household-continuity phrase."]}},
    {"id":"tirumbippaar-en-s007-u007","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d006","source_occurrence_id":null,"source_locator":null,"speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"But before that, he already went and had a love marriage.","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u008","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d007","source_occurrence_id":null,"source_locator":null,"speaker_label":"குமுதா","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Hey, Gundumani.","mode":"prose-faithful","notes":["The corrected source label is `குண்டுமணி`; the stale `குணமணி` metadata is not retained."]}},
    {"id":"tirumbippaar-en-s007-u009","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/scenes/scene-07.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":1,"description":"Standalone entrance cue before Paranthaman's first line."},"speaker_label":null,"page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"(Paranthaman enters.)","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u010","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d008","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Ah! When did Goddess Kumudha arrive?","mode":"prose-faithful","notes":["The mock-formal `தேவி` is retained as `Goddess` to preserve Paranthaman's playful register."]}},
    {"id":"tirumbippaar-en-s007-u011","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d009","source_occurrence_id":null,"source_locator":null,"speaker_label":"குமுதா","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Uncle, you're still in full bridegroom style! Tell me, is my aunt fair or dark?","mode":"prose-faithful","notes":["`மாப்பிள்ளை முறுக்கிலேயே` is retained as a joking reference to his bridegroom swagger/style, not location."]}},
    {"id":"tirumbippaar-en-s007-u012","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d010","source_occurrence_id":null,"source_locator":null,"speaker_label":"பரந்தாமன்","page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"Oh dear...and an educated girl doesn't even know this! Would anyone like a woman if she were red in colour? Blood and kumkum are red—who would touch that colour? From now on, ask like this: lemon-fruit colour, jamun-fruit colour, or a mixture of the two?","mode":"prose-faithful","notes":["The source's colour-based joking and period vocabulary are translated without modernization."]}},
    {"id":"tirumbippaar-en-s007-u013","kind":"stage-direction","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/scenes/scene-07.md","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":null,"source_occurrence_id":null,"source_locator":{"kind":"scene-parenthetical-block","ordinal":2,"description":"Standalone parenthetical after Paranthaman's colour joke."},"speaker_label":null,"page_provenance":[{"pdf_page":17,"printed_page":9}]},"translation":{"english_text":"(Kumudha laughs.)","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u014","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d011","source_occurrence_id":null,"source_locator":null,"speaker_label":"குமுதா","page_provenance":[{"pdf_page":18,"printed_page":10}]},"translation":{"english_text":"In the excitement of the wedding, poetry is pouring out of Uncle!","mode":"prose-faithful","notes":[]}},
    {"id":"tirumbippaar-en-s007-u015","kind":"dialogue","status":"verified","target_language":"en","canonical_scene":7,"source":{"source_path":"works/tirumbippaar/dialogues/records/scene-07.json","canonical_scene_path":"works/tirumbippaar/scenes/scene-07.md","source_record_id":"tirumbippaar-s007-d012","source_occurrence_id":null,"source_locator":null,"speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":18,"printed_page":10}]},"translation":{"english_text":"And colour poetry is pouring out too! (Laughter)","mode":"prose-faithful","notes":["The corrected source reads `கலர் கவிதைகளால்ல`; the historical `cover-poetry` rendering was based on stale text."]}}
  ]
}