{"work_id":"tirumbippaar","target_language":"en","canonical_scene":87,"scene_status":"verified","unit_count":5,"units":[{"id":"tirumbippaar-en-s087-u001","kind":"stage-direction","status":"verified","source":{"page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"(Poomaal finishes drinking coffee. Gundumani runs in carrying a newspaper.)"}},{"id":"tirumbippaar-en-s087-u002","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s087-d001","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"Amma! Amma! Did you see this! Your younger brother has put out an advertisement asking for Kumudha-amma's address!"}},{"id":"tirumbippaar-en-s087-u003","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s087-d002","speaker_label":"பூமால்","page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"Ah! (She looks at the newspaper.) Paranthaman is searching for Kumudha—the sinner! Some danger is going to come to her too! Gundumani, I must leave for Madras immediately."}},{"id":"tirumbippaar-en-s087-u004","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s087-d003","speaker_label":"குண்டுமணி","page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"All right..."}},{"id":"tirumbippaar-en-s087-u005","kind":"dialogue","status":"verified","source":{"source_record_id":"tirumbippaar-s087-d004","speaker_label":"பூமால்","page_provenance":[{"pdf_page":105,"printed_page":97}]},"translation":{"english_text":"Only if I go can I save Kumudha from that destroyer!"}}]}