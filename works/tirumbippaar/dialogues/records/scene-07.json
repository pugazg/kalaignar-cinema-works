[{"id":"tirumbippaar-s007-d001","canonical_scene":7,"source_scene_heading":7,"speaker_label":"பூமால்","text":"குமுதா!","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d002","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குமுதா","text":"சின்னம்மா! (இருவரும் தழுவல்)","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d003","canonical_scene":7,"source_scene_heading":7,"speaker_label":"பூமால்","text":"எம்மா இவ்வளவு தாமதம்?","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d004","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குமுதா","text":"பரீட்சை சின்னம்மா. உடனே வரமுடியலே...","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d005","canonical_scene":7,"source_scene_heading":7,"speaker_label":"பூமால்","text":"உட்காரு குமுதா. தம்பிக்கு உன்னை கல்யாணம் செஞ்சு வச்சு விட்டோம்னு நெனச்சேன்...","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d006","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குணமணி","text":"அதுக்குள்ளதான் அவரு காதல் திருமணம் பண்ணிட்டாரே.","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d007","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குமுதா","text":"ஏய் குணமணி.","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d008","canonical_scene":7,"source_scene_heading":7,"speaker_label":"பரந்தாமன்","text":"அடடே! குமுதா தேவி எப்போது வந்தார்கள்?","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d009","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குமுதா","text":"மாமா, மாப்பிள்ளை மூக்கிலேயே இருக்காரே! என் மாமா, மாமி சிகப்பா கருப்பா?","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d010","canonical_scene":7,"source_scene_heading":7,"speaker_label":"பரந்தாமன்","text":"அய்ய...படிச்ச பெண்ணுக்கு இதுகூட தெரியிலேயே. ஒரு பெண்ணு சிகப்பு நிறமாயிருந்த எவனாவது விரும்புவானு? ரத்தம், குங்குமம் இதெல்லாம் சிகப்பு-இந்த நிறத்தை எவன் தொடுவான். இனிமேல் இப்படிக் கேளு. எழுமிச்சம்பழ நிறமா, நாகற்பழ நிறமா, அல்லது இரண்டுங் கலந்ததா?","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d011","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குமுதா","text":"கல்யாண உற்சாகத்திலே மாமாவுக்கு கவிதைகளால்ல ஊறுது!","page_provenance":[{"pdf_page":18,"printed_page":10}],"source_scene_file":"scene-07.md"},{"id":"tirumbippaar-s007-d012","canonical_scene":7,"source_scene_heading":7,"speaker_label":"குணமணி","text":"அதுவும் கவர் கவிதைகளால்ல ஊறுது! (சிரிப்பு)","page_provenance":[{"pdf_page":18,"printed_page":10}],"source_scene_file":"scene-07.md"}]