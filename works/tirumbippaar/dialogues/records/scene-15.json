[{"id":"tirumbippaar-s015-d001","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"அப்பா எங்கேப்பா போயிருந்தீங்க.","page_provenance":[{"pdf_page":22,"printed_page":14}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d002","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"எல்லாம் நல்ல காரியமாகத்தான்.","page_provenance":[{"pdf_page":22,"printed_page":14}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d003","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"ஏம்ப்பா நாடகத்துக்கு வர வில்ல. நாடகம் ரொம்ப ஜோர்.","page_provenance":[{"pdf_page":22,"printed_page":14}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d004","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"கேள்விப்பட்டேன்.","page_provenance":[{"pdf_page":22,"printed_page":14}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d005","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"யாருப்பா சொன்னு?","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d006","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"நம்ம மில்லு தொழிலாளிங்க எல்லாம் வந்திருந்தாங்களே, அவங்க சொன்னாங்க!","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d007","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"மில் தொழிலாளிகள் வர முடிந்தது. மேலதிகர் வர முடியலே, இல்லேப்பா!","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d008","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"கோபிக்காதே! நானும் உன் விஷயமாகத்தான் டவுன் வரையிலும் போயிருந்தேன்......","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d009","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"என்ன விஷயமப்பா!","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d010","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"உனக்கு கல்யாணம் நிச்சயம் பண்ணிட்டேன்.","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d011","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"இப்ப ஏன் எனக்குக் கல்யாணம். ஏதாவது நிலையா ஒரு வேல கிடைச்சு......","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d012","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"இருக்கிற வேல போதும்! எழுத்தாளன் வேலை நிலையா வேலதானே. இந்தா பாரு தம்பி! ரொம்ப நல்ல இடம்...பெண்ணும் நல்ல அழகு! மறுக்காம கல்யாணம் பண்ணிக்க...","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d013","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"பெண்ணை நான் பார்க்க வேண்டாமாப்பா?","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d014","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"தெரியுமே உன் சேதி எனக்கு! அதுக்குத்தானே போட்டோவை வாங்கிட்டு வந்திருக்கேன்.","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d015","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"என்னப்பா சொல்றே!","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d016","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"உங்களிஷ்டம்.","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d017","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"அப்படிச் சொல்லு ராஜா! நாளைக்கே மில் முதலாளி கிட்ட போயி கல்யாணத்துக்குக் கொஞ்சம் பணம் கேக்கிறேன். (ஆத்திரமாக) அவன் எங்க தரப்போறன்.","page_provenance":[{"pdf_page":23,"printed_page":15}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d018","canonical_scene":15,"source_scene_heading":15,"speaker_label":"பாண்டியன்","text":"என்கிட்டேயே பணம் இருக்குப்பா!","page_provenance":[{"pdf_page":24,"printed_page":16}],"source_scene_file":"scene-15.md"},{"id":"tirumbippaar-s015-d019","canonical_scene":15,"source_scene_heading":15,"speaker_label":"புண்ணகோடி","text":"அப்போ சீக்கிரமே கல்யாணத்தை நடத்திடலாம்.","page_provenance":[{"pdf_page":24,"printed_page":16}],"source_scene_file":"scene-15.md"}]
