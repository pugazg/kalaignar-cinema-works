[
  {"id":"tirumbippaar-s047-d001","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"பரந்தாமன்! அடப்பாவி ! என்ன செய்தாய்!","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d002","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பரந்தாமன்","text":"விடு. பரந்தாமனுக்கு இந்த உலகத்தில் பகைவர்களும் இருக்கக்கூடாது, பயன்படாதவர்களும் இருக்கக்கூடாது!","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d003","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"குமுதா! குமுதா!","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d004","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"(அலறல்) குமுதா...","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d005","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குமுதா","text":"சின்னம்மா... (தழுவுதல்)","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d006","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பாண்டியன்","text":"என்னைக்கொல்ல முயற்சித்திருக்கிறார்கள் யாரோ.","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d007","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குமுதா","text":"வேறு யார்,எல்லாம் நம் வீட்டு விரோதிதான், சின்னம்மா! இந்த வீட்டைவிட்டு நாங்கள் வெளியேற வேண்டும். அல்லது உன் தம்பி வெளியேற வேண்டும்.","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d008","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"அவனை வெளியேறச் சொல்ல உனக்கும் எனக்கும் என்ன உரிமை இருக்கிறது.","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d009","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குமுதா","text":"என் கணவனை கொலை செய்யச் சொல்லத்தான் உனக்கு உரிமை இருக்கிறதாக்கும்.","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d010","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பாண்டியன்","text":"குமுதா! என்ன இது !","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d011","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"பேசட்டும் அவளைப் பேச விடுங்கள். அவள் தானே பாக்கி ! அவளும் பேசிவிட்டால் பிறகு எனக்கென்ன குறையிருக்கிறது.","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d012","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"பாண்டியன்! நான் சொல்வதை தயவுசெய்து கேளுங்கள். நீங்களும் குமுதாவும் இந்த ஊரைவிட்டே கொஞ்சநாள்.....","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d013","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பாண்டியன்","text":"சாவுக்கு பயந்தா, ஊஹும்...","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d014","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"என் குமுதாவிற்காக. அவள் கூந்தலிலே குலுங்கும் மலர்க்காடு அழிந்துவிடாமல் இருப்பதற்காக, இந்த ஒரே ஒரு வரத்தைக் கொடுங்கள் பாண்டியன். என் குமுதா துன்பத்தைத் தொட்டும் பாராதவள். எனக்குத் தெரியும், அவளைத் துண்டு துண்டாக வெட்டிப் போட்டாலும், தொடர்ச்சி கெடாமல் ஒட்டிவிடக் கூடிய மாமருந்து நீங்கள். அந்த மருந்தை, குமுதாவின் இன்ப விருந்தை நான் அழியவிட மாட்டேன். தயவு செய்யுங்கள். நான் உங்களுக்காக தியாகம் செய்தேனே காதல். (குமுதா action) அந்த தியாகத்தின் பெயரால், அந்தக் காதலின் பெயரால் கேட்கிறேன். கெஞ்சுகிறேன், சம்மதியுங்கள்.","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d015","canonical_scene":47,"source_scene_heading":47,"speaker_label":"குமுதா","text":"சின்னம்மா... (ஓடிவரல்).","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d016","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பூமாலை","text":"பாருங்கள் பாண்டியன் என் குமுதாவை, அவள் வாழ்வு வளைந்து விடாமல் காப்பாற்றுங்கள். இருவரும் சென்னைக்குச் சென்று விடுங்கள், உங்கள் பகைவனின் ஆத்திரம் தீர்ந்த பிறகு திரும்பலாம்....","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"},
  {"id":"tirumbippaar-s047-d017","canonical_scene":47,"source_scene_heading":47,"speaker_label":"பாண்டியன்","text":"சரி, உங்களிஷ்டப்படியே செய்கிறோம் .....","page_provenance":[{"pdf_page":62,"printed_page":54}],"source_scene_file":"scene-47.md"}
