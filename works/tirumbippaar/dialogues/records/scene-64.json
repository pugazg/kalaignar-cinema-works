[{"id":"tirumbippaar-s064-d001","canonical_scene":64,"source_scene_heading":64,"speaker_label":"வாட்ச்மேன்","text":"ஏம்மா வருத்தப்பட்டுகிட்டே இருக்கே ! சந்தோஷமா இரும்மா !","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-64.md"},{"id":"tirumbippaar-s064-d002","canonical_scene":64,"source_scene_heading":64,"speaker_label":"குமுதா","text":"எனக்கேது சந்தோஷம் ! உங்களுடைய நிலைமையில் நான் வேறே பாரமா வந்திருக்கிறேனே என்று நினைக்கும் ......","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-64.md"},{"id":"tirumbippaar-s064-d003","canonical_scene":64,"source_scene_heading":64,"speaker_label":"வாட்ச்மேன்","text":"பரவாயில்லேம்மா... அதனால என்னம்மா! உன் புருஷன் ஜெயில்லேருந்து வர்ர வரையிலும் நீ இங்கேயே இருக்கலாம். எனக்குத்தான் வேற யாரு! நீ தான் எம் பொண்ணு மாதிரி !.","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-64.md"},{"id":"tirumbippaar-s064-d004","canonical_scene":64,"source_scene_heading":64,"speaker_label":"குமுதா","text":"உங்க உதவியை மறக்கவே முடியாது !.","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-64.md"},{"id":"tirumbippaar-s064-d005","canonical_scene":64,"source_scene_heading":64,"speaker_label":"வாட்ச்மேன்","text":"சரி, பத்திரமாயிரும்மா ! நான் ஆஸ்பத்திரிக்குப் போய்ட்டு வாரேன்.","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-64.md"}]
