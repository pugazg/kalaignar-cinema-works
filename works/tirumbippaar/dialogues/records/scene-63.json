[
  {"id":"tirumbippaar-s063-d001","canonical_scene":63,"source_scene_heading":63,"speaker_label":"புண்ணகோடி","text":"எதற்காக இங்கேலாம் சொல்றேன்னு தொழிலாளர் கோரிக்கை கூடய சக்கரம் நிறைவேறியாகணும். நம்மை நம்பிவிட்டு ஆயிரக் கணக்கான தொழிலாளிகள் இருக்காங்க!","page_provenance":[{"pdf_page":79,"printed_page":71}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d002","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"கவலைப்படாதீர்!","page_provenance":[{"pdf_page":79,"printed_page":71}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d003","canonical_scene":63,"source_scene_heading":63,"speaker_label":"புண்ணகோடி","text":"நீங்க அதுக்குத்தான் திட்டம் தீட்டுறீங்கன்னு தெரியும்! இருந்தாலும் சில தொழிலாளிங்க கொஞ்சங்\nகொஞ்சமா அந்தப் பாண்டியன் கட்சியிலே சேர்ந்துகிட்டு, பகுத்தறிவு அது இதுன்னு பேசிக்கிட்டு நம்பள கொஞ்சம் கேவலமா நினைக்கிறாங்க!","page_provenance":[{"pdf_page":79,"printed_page":71},{"pdf_page":80,"printed_page":72}],"page_segments":[{"pdf_page":79,"printed_page":71,"text":"நீங்க அதுக்குத்தான் திட்டம் தீட்டுறீங்கன்னு தெரியும்! இருந்தாலும் சில தொழிலாளிங்க கொஞ்சங்"},{"pdf_page":80,"printed_page":72,"text":"கொஞ்சமா அந்தப் பாண்டியன் கட்சியிலே சேர்ந்துகிட்டு, பகுத்தறிவு அது இதுன்னு பேசிக்கிட்டு நம்பள கொஞ்சம் கேவலமா நினைக்கிறாங்க!"}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d004","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"பரவாயில்லை. அவர்களால் என்ன செய்ய முடியும்? அவனுந்தான் ஜெயில்ல கிடக்கிறான். உம். நீங்க போங்க நான் எல்லாம் உடனடியாக கவனிக்கிறேன்.","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d005","canonical_scene":63,"source_scene_heading":63,"speaker_label":"புண்ணகோடி","text":"நான் வர்றேன். நமஸ்காரம். என்ன, உங்க களித்தாலே...","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d006","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"வாழ்க தொழிலாளி வர்க்கம்!","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d007","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"இவன் வேற தொழிலாளி தொழிலாளின்னு உயிரைவாங்குறான்.","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d008","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"அட சும்மா இருப்பா! அந்தத் திரை மறைவிலே தானே நம்ம நினைச்சதெல்லாம் நடத்த முடியுது!","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d009","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"நினைத்ததெல்லாம் வெற்றிதான், ஆனாலும் அந்த ஊஷா விஷயம் Failure ஆயிட்டுதே!","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d010","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"அதெல்லாம் ஒன்றும் ஆகாது! அதுக்குத்தான் சொல்றேன், நீ ஊஷாவை கல்யாணம் பண்ணிட்டேன்னு, அவ்வளவு பெரிய மில்லு உனக்குச் சொந்தம்! ஆயிரக் கணக்கான தொழிலாளிகள் உனக்கு அடிமை ...","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d011","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"தொழிலாளி தலைவன் மில் முதலாளி மகளைக் கல்யாணம் செய்வது....","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d012","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"அட “மாஸ் சைகாலஜி” தெரியாது உனக்கு? அதுக்கும் ஒரு காரணம் சொல்லிவிடலாம்.","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d013","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"சொல்லலாம். ஆனால் முன்னுக்குப் பின் முரணுகப் பேசுவது......","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d014","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"அப்படித்தான் பேசணும், அப்புறம் தலைவன்னு என்னு கெளரவம்... நான் சொல்றபடி செயப்பா!","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d015","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"ஊஷாவைக் கல்யாணம் பண்ணவேண்டும். அவ்வளவு தானே!","page_provenance":[{"pdf_page":80,"printed_page":72}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d016","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"ஆமாம்! அப்படிச் செஞ்சா எவ்வளவோ காரியத்துக்குச் செளகரியம். முதலல்ல நம்ப பதிப்பகத்தையே விருத்தி பண்ணலாம்.","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d017","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"சரி, அக்காளிடமே சொல்லி பெண் கேட்டுச் சொல்லவோம்.","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d018","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"அட, இதுக்கெல்லாம் எம்ப்பா அக்கா. அதுவேற எதுக்கெடுத்தாலும் தடை சொல்லும் சனியன் மாதிரி!","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d019","canonical_scene":63,"source_scene_heading":63,"speaker_label":"பரந்தாமன்","text":"ஏ கருடா! நிதானமா பேசு! எங்க அக்காளைப் பத்தி எதுவும் பேசாதே!","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d020","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"மன்னிச்சிக்கோ! மன்னிச்சுக்க!","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-63.md"},
  {"id":"tirumbippaar-s063-d021","canonical_scene":63,"source_scene_heading":63,"speaker_label":"கருடன்","text":"ஒரு டெலிபோன் பார்த்தேன். அக்காகிட்ட தம்பிக்கு எவ்வளவு அன்பு இருக்குன்னு........","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-63.md"}
