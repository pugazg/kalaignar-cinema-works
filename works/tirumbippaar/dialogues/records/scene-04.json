[{"id":"tirumbippaar-s004-d001","canonical_scene":4,"source_scene_heading":4,"speaker_label":"குணரத்தனம்","text":"அப்ப சந்தோஷம். ஏழாந்தேதி ஒரு நல்ல நாள் இருக்கு ... ... ...","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d002","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பூமாலை","text":"நாள் எதா இருந்தா என்ன!","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d003","canonical_scene":4,"source_scene_heading":4,"speaker_label":"குணரத்தனம்","text":"இல்லம்மா! எனக்கு நாள் நக்ஷத்திரத்திலே கொஞ்சம் நம்பிக்கை.","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d004","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பூமாலை","text":"சரி சரி ... ... அதனால் என்ன!","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d005","canonical_scene":4,"source_scene_heading":4,"speaker_label":"தங்கம்","text":"நீ ஏம்மா கல்யாணம் பண்ணிக்காம ... ... ...","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d006","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பூமாலை","text":"இந்தக் குடும்பத்து பொறுப்பாளியே நான்தானே. தம்பி செல்வமாக வளர்ந்தவன், குடும்ப கஷ்டத்தை அவனுக்கு கொடுக்கக் கூடாதுன்னு அப்பா அம்மா உத்தரவு. அக்கா மகள், தாய் தந்தை இல்லாதவள் சென்னையில் படித்துக்கொண்டிருக்கிறாள், அவளுக்கு நான்தான் துணை.","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d007","canonical_scene":4,"source_scene_heading":4,"speaker_label":"குணரத்தனம்","text":"இப்படி எல்லோருக்கும் அம்மா துணையா இருக்கிற தாலதான் அவங்க வாழ்க்கைத் துணைவரை வீட்டோட இருக்கிறவரா பாக்கிறாங்க!...... ...","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d008","canonical_scene":4,"source_scene_heading":4,"speaker_label":"தங்கம்","text":"ஏம்பா....அது மாதிரி புருஷன் கிடைக்காது ... லக்ஷிமி மாதிரி இருக்குது பொண்ணு!","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d009","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பூமாலை","text":"வா தம்பி! இவங்கள்ளாம் தெரியுமா? (பரந்தாமன் முழித்தல்) ஓ! இவுங்க பெண்ணைமாத்திரந்தான் தெரியும் போலிருக்கு ... ... பாமாவோட பெற்றோர்!.","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d010","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பரந்தாமன்","text":"ஒகோ! நமஸ்காரம்!","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d011","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பூமாலை","text":"கல்யாணம் நிச்சயம் பண்ண வந்திருக்காங்க! என்ன ... ... சம்மதந்தானே உனக்கு ... ... ...","page_provenance":[{"pdf_page":12,"printed_page":4}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d012","canonical_scene":4,"source_scene_heading":4,"speaker_label":"குணரத்தனம்","text":"என்ன கேக்கிறீங்க இதைப்போயி! வாழைப்பழம் வேண்டாங்கிற குழந்தை உண்டாங்கிறேன்.","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d013","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பூமாலை","text":"என்ன பரந்தாமா!","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d014","canonical_scene":4,"source_scene_heading":4,"speaker_label":"பரந்தாமன்","text":"சரிக்கா!","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-04.md"},{"id":"tirumbippaar-s004-d015","canonical_scene":4,"source_scene_heading":4,"speaker_label":"குணரத்தனம்","text":"அப்பசரி. நாங்க வரோம். சந்தோஷம். ஆக வேண்டியதைக் கவனிப்போம்.","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-04.md"}]