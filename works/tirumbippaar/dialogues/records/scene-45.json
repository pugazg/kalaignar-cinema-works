[
  {"id":"tirumbippaar-s045-d001","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"ஒருவன் தொலைந்தானென்று பெருமூச்சு விட்டேன். இன்னொருவன் முளைக்கிறான். பாண்டியன்.","page_provenance":[{"pdf_page":58,"printed_page":50}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d002","canonical_scene":45,"source_scene_heading":45,"speaker_label":"ஊஷா","text":"எல்லோரையும் பரந்தாமனைப்போல நினைத்து பணத்தால் அடித்துவிட முடியுமா! லட்சியத்தில் உறுதி உள்ளவர்கள் இருப்புப் பெட்டிக்குத் தலைவணங்க மாட்டார்களப்பா!","page_provenance":[{"pdf_page":58,"printed_page":50}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d003","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"நீ சும்மாகிட ஊஷா! உனக்கு ஒன்றும் தெரியாது!","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d004","canonical_scene":45,"source_scene_heading":45,"speaker_label":"ஊஷா","text":"எம்ப்பா லேடி டாக்டருக்கு உலக விஷயம் தெரியாதுன்னு உங்கள் அபிப்பிராயமா!","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d005","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"லேடி டாக்டர்!...தொழிலாளர் தொழிலாளர் என்று தொல்லை கொடுத்து ஆயிரக் கணக்கில் எனக்கு நஷ்டம் உண்டாக்குகிறார்களே. அந்த மனவேதனைக்கு மருந்து கொடுக்க முடியுமா உன்னால்?","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d006","canonical_scene":45,"source_scene_heading":45,"speaker_label":"ஊஷா","text":"ஓ! கொடுக்க முடியும். ஆனால் இந்த மருந்தை இருதயம் என்ற இலையில் வைத்து, இரக்கம் என்ற தேனில் கலந்து சாப்பிட வேண்டும். மருந்துக்குப் பெயர் என்ன தெரியுமா அப்பா? சமதர்மம். சமத்துவம். முதலில் கொஞ்சம் கசப்பாயிருக்கும். பிறகு சரியாகி விடும்.","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d007","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"ஊஷா!","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d008","canonical_scene":45,"source_scene_heading":45,"speaker_label":"ஊஷா","text":"ஏன் ஆத்திரப்படுகிறீர்கள். தொழிலாளியின் குறைகள் கவனியுங்கள். எல்லாம் அடங்கிவிடும்.","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d009","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பியூன்","text":"பாண்டியனும். உங்களைப் பார்க்க வந்திருக்கிறார்.","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d010","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"பாண்டியன்! வரச்சொல்! வரச்சொல்! பார்த்தாயா ஊஷா! எல்லாம் பண வேட்டைக்குத்தான் பயல்கள் தலைவர் வேஷம் போடுகிறார்கள்.","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d011","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"(உட்கார்ந்து) உங்களிடம் ஒரு முக்கியமான செய்தி பற்றி....","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d012","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"சொல்லு...","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d013","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"தொழிலாளர்கள்.","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d014","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"தெரியும். அவர்களை அடக்க எவ்வளவு பணம் வேண்டுமானாலும் கேள் தருகிறேன்.","page_provenance":[{"pdf_page":59,"printed_page":51}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d015","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"ஐயா! “மஞ்சத்திலே முதலாளி-பஞ்சத்திலே பாட்டாளி” என்று முழங்கிவிட்டு, லஞ்சத்திலே சிக்கவடி-\nகும் பரந்தாமனல்ல நான். பாண்டியன். பாட்டாளிகளின் தோழன்...","page_provenance":[{"pdf_page":59,"printed_page":51},{"pdf_page":60,"printed_page":52}],"page_segments":[{"pdf_page":59,"printed_page":51,"text":"ஐயா! “மஞ்சத்திலே முதலாளி-பஞ்சத்திலே பாட்டாளி” என்று முழங்கிவிட்டு, லஞ்சத்திலே சிக்கவடி-"},{"pdf_page":60,"printed_page":52,"text":"கும் பரந்தாமனல்ல நான். பாண்டியன். பாட்டாளிகளின் தோழன்..."}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d016","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"பாண்டியா என் பேச்சைக் கேள்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d017","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"உங்கள் பேச்சை நான் கேட்க வேண்டாம். உழைப்பவர்களின் பெருமூச்சை நீங்கள் கவனியுங்கள்!","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d018","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"பெருமூச்சு, உழைப்பு, வியர்வை, ரத்தம் எல்லாம் கேட்டுக்கேட்டு காது அடைத்து விட்டதப்பா!","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d019","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"காது அடைத்துவிடும், கண் இருட்டிவிடும், வாய் மூடிவிடும். கைகள் அசையாது! கடைசியில் இருதயமே நின்றுவிடும். அந்தப் பரிதாபகரமான நிலமை ஏற்பட வேண்டாமென்று எச்சரிக்கிறேன்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d020","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"ஏ, இங்கென்ன பிரசங்கமா செய்ய வந்தாய்?","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d021","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"இல்ல. பின்னடைந்துபோன தொழிலாளர் நிலை கண்டு, மனம் புண்ணடைந்து புலம்ப வந்தேன்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d022","canonical_scene":45,"source_scene_heading":45,"speaker_label":"முதலாளி","text":"புலம்புவதற்கு சுடுகாட்டுக்குப் போ.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"},
  {"id":"tirumbippaar-s045-d023","canonical_scene":45,"source_scene_heading":45,"speaker_label":"பாண்டியன்","text":"சுகபோகியே! ஞாபகமிருக்கட்டும்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-45.md"}
