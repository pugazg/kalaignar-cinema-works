[{"id":"tirumbippaar-s028-d001","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"நில்லுங்க சரியா—ஆங்-கொஞ்சம் சிரிங்க... கொஞ்சம் கொஞ்சம்...ஸ்டடி பிளீஸ், ரைட்....தேங்க்ஸ்...","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d002","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பாண்டியன்","text":"இங்கே கொடு. நான் உன்னைப் பிடிக்கிறேன்.","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d003","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"என்னது...","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d004","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பாண்டியன்","text":"படம் பிடிக்கிறேங்கிறேன்.","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d005","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"அதானே! (வெட்கமுடன்)","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d006","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பாண்டியன்","text":"(கேமராவை வாங்கி) ம்...ஸ்டடி ப்ளீஸ்.....","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d007","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பாண்டியன்","text":"இது என்ன இது!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d008","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"சின்னம்மா!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d009","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"ஏங்கண்ணு!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d010","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"நாங்க தனித்தனியா போட்டோ எடுத்துட்டோம். ரெண்டுபேரும் நிக்கிறோம் நீ எடு!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d011","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"ஊஹூம் குமுதா! எனக்குத் எடுத்துத் தெரியிலே நீயே எடு!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d012","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"போசின்னம்மா! (சிணுங்கியபடி கேமராவை வாங்கிக்கொண்டு) சரி சின்னம்மா! நீங்க ரெண்டுபேரும் நில்லுங்க நான் எடுக்கிறேன். (களங்கமில்லாமல்)","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d013","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"நானு.","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d014","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"போய் நில்லு சின்னம்மா!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d015","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"ஸ்டடி ப்ளீஸ்...","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d016","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"எ...என்ன...என்ன?","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d017","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குண்டுமணி","text":"(பேப்பரைக் காட்டி) குமுதாம்மா பாஸ்! பாஸ்! பாஸ்!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d018","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"பாஸா!","page_provenance":[{"pdf_page":33,"printed_page":25}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d019","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"பாஸ்! குமுதா நீ கெட்டிக்காரி!","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d020","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பாண்டியன்","text":"குமுதா கங்க்ராஜுலேஷன்ஸ்...","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d021","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குண்டுமணி","text":"(பத்திரிகையைக் காட்டி) இந்த பாருங்க நம்பரு. பதினறு இருப்பத்தினாலு....","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d022","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பாண்டியன்","text":"இருப்பத்தினாலு....அட என் வயசுகூட இருப்பத்தி நாலுதான்.","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d023","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"என் வயசு பதினறுதான்.","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d024","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குண்டுமணி","text":"பொருத்தமான நம்பருதான்.","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d025","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"(அதட்டல்) ஏய்....சும்மா இரு ...","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d026","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குண்டுமணி","text":"இல்லிங்க. குமுதாம்மா இன்னும் பதினறு வயசா மார்க்கண்டி மாதிரி இருக்கணுங்கிறேன்.","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d027","canonical_scene":28,"source_scene_heading":28,"speaker_label":"பூமால்","text":"அப்ப ஊருக்குப் புறப்படலாமா!","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d028","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குமுதா","text":"அவர்...","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"},{"id":"tirumbippaar-s028-d029","canonical_scene":28,"source_scene_heading":28,"speaker_label":"குண்டுமணி","text":"அவரைப்பத்தி நீங்க கவலைப்படவேண்டதில்லம்மா. இனிமே நம்ப வீட்டினுகூட அவர் நம்பளவிட்டுப் போமாட்டாரு!","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-28.md"}]