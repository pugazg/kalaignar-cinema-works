  {"id":"tirumbippaar-s049-d002","canonical_scene":49,"source_scene_heading":49,"speaker_label":"பரந்தாமன்","text":"கல்யாணத்தை ரொம்ப சிக்கனமாத்தான் செய்து விட்டீர்கள் இல்லையா....","page_provenance":[{"pdf_page":64,"printed_page":56}],"source_scene_file":"scene-49.md"},
  {"id":"tirumbippaar-s049-d003","canonical_scene":49,"source_scene_heading":49,"speaker_label":"புண்ணகோடி","text":"ஆமாம்..... (உள்ளே திரும்பி) ராதா ராதா கொஞ்சம் வந்துட்டுப் போ.","page_provenance":[{"pdf_page":64,"printed_page":56}],"source_scene_file":"scene-49.md"},
