[{"id":"tirumbippaar-s035-d001","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"சிந்தனைக்கு இடையூறு ஒன்றும் இல்லையே...","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d002","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பாண்டியன்","text":"இல்லை, இல்லை....","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d003","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"எதிலே பறிகொடுத்திருக்கிறீர்கள் மனதை ! வானத்தின் அழகிலா - மேகத்தின் அசைவிலா?","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d004","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பாண்டியன்","text":"மோனத்திருக்கும் முதிர் சோலையில், கானத்தால் களிப்பூட்டும்","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d005","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"வானம்பாடியின் வரவை எதிர்ப்பார்த்து ஏக்கமா? பாண்டியன்! சிரிக்கும் முல்லையும், சிங்காரக் கொல்லையும் உங்கள் சிந்தைக்கு விருந்தளிக்கப் போதவில்லை என்பதை உணர்ந்துதான் வானம்பாடி பறந்து வந்திருக்கிறது !","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d006","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பாண்டியன்","text":"எங்கே?","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d007","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"தெரியவில்லை.விழியாலும் காணலாம். ஆனால் முதலில் நெஞ்சத்தால்தான் காண முயலவேண்டும்.","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d008","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பாண்டியன்","text":"(சந்தேகத்தோடு) பூமாலை .......","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d009","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பரந்தாமன்","text":"யார் இவன்?","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d010","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"பரந்தாமா, இவர்தான் ..","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d011","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பரந்தாமன்","text":"சொல்லவேண்டாம் தெரிகிறது.இந்த அயோக்யனை வீட்டுக்குள்ளே யார் அனுமதித்தது?","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d012","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"(கோபமாக) பரந்தாமா..","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d013","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பரந்தாமன்","text":"அதட்டாதே ! நீ செய்ததும் ஒரு நல்ல காரியம்தான் ! இவனை நான் பலநாளாகத் தேடிக்கொண்டிருக்கிறேன்.","page_provenance":[{"pdf_page":43,"printed_page":35}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d014","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பாண்டியன்","text":"எதற்கு என்னைத் தேடுகிறாய்!","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d015","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பரந்தாமன்","text":"ஆ! பரிசு கொடுக்க. இந்தா பதிலுக்குப் பதில் வாங்கிக்கொள்!","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d016","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பரந்தாமன்","text":"ஆ ...என்ன !...குமுதா!","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d017","canonical_scene":35,"source_scene_heading":35,"speaker_label":"குமுதா","text":"முட்டாள் !","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d018","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பூமாலை","text":"(குமுதாவை அறைந்து) சீ ! வாயை மூடு.","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d019","canonical_scene":35,"source_scene_heading":35,"speaker_label":"குமுதா","text":"சின்னம்மா ! சின்னம்மா!","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"},{"id":"tirumbippaar-s035-d020","canonical_scene":35,"source_scene_heading":35,"speaker_label":"பாண்டியன்","text":"என் வாழ்க்கை ஒரு போட்டி மேடை!...","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-35.md"}]
