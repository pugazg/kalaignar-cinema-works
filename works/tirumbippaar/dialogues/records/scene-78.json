[
  {"id":"tirumbippaar-s078-d001","canonical_scene":78,"source_scene_heading":78,"speaker_label":"வார்டர்","text":"உனக்கு விடுதலையப்பா.","page_provenance":[{"pdf_page":94,"printed_page":86}],"source_scene_file":"scene-78.md"},
  {"id":"tirumbippaar-s078-d002","canonical_scene":78,"source_scene_heading":78,"speaker_label":"பாண்டியன்","text":"அதற்குள்ளாகவா—மூன்று வருஷம் ஆகவில்லையே...","page_provenance":[{"pdf_page":94,"printed_page":86}],"source_scene_file":"scene-78.md"},
  {"id":"tirumbippaar-s078-d003","canonical_scene":78,"source_scene_heading":78,"speaker_label":"வார்டர்","text":"உனக்கு மட்டுமல்ல. இன்றைக்கு இந்த உபகண்டத்திற்கே விடுதலை—சுதந்திரதின விழா—அதனால்தான் நீ விடுதலை செய்யப்படறே.","page_provenance":[{"pdf_page":94,"printed_page":86}],"source_scene_file":"scene-78.md"},
  {"id":"tirumbippaar-s078-d004","canonical_scene":78,"source_scene_heading":78,"speaker_label":"பாண்டியன்","text":"சார்! நான் மெட்ராஸ் போறதுக்கு பாஸ் கொடுப்பாங்களே!","page_provenance":[{"pdf_page":94,"printed_page":86}],"source_scene_file":"scene-78.md"},
  {"id":"tirumbippaar-s078-d005","canonical_scene":78,"source_scene_heading":78,"speaker_label":"வார்டர்","text":"ஓ. நீ போகவேண்டிய ஊருக்கே கொடுப்பாங்க. மெட்ராஸிலே தானே உன் குடும்பம்....","page_provenance":[{"pdf_page":94,"printed_page":86}],"source_scene_file":"scene-78.md"},
  {"id":"tirumbippaar-s078-d006","canonical_scene":78,"source_scene_heading":78,"speaker_label":"பாண்டியன்","text":"ஆம். அங்கேதான் என் குமுதா.","page_provenance":[{"pdf_page":94,"printed_page":86}],"source_scene_file":"scene-78.md"}
