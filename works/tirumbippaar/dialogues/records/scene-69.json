[{"id":"tirumbippaar-s069-d001","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"(சாப்பிட்டுக் கொண்டே) ராதா! விடியற்காலம் நாலு மணிக்கு எனக்கு வேலையிருக்கு தலைவர் பரந்தாமன் கட்டளைப்படி பெரிய புரட்சி ஊர்வலம் நடத்த தொழிலாளர்களை ஒன்று சேர்க்கணும் ! மறந்துடாதே! நாலு மணிக்கெல்லாம் எழுப்பி விட்டுடு!..","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d002","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"(எழுந்து கடிகாரத்தைப் பார்த்து) சபாஷ்! பின் தூங்கி முன் எழும் பத்தினி என்பார்கள் முன்னோர்கள். அந்தப் பத்தினி நீயேதான் !....ம் கோட்டை எடு!","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d003","canonical_scene":69,"source_scene_heading":69,"speaker_label":"பரந்தாமன்","text":"எப்படி வந்தேன்னு ஆச்சரியமாயிருக்கா! இது விஞ்ஞான காலம், கடிகாரம் தேவைப்படுகிறது !","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d004","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"அடபாவி! பாதகா !","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d005","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"அடே கலியுக இந்திரா! பாட்டாளிகளின் தலைவன் நீதானாடா ! உன்னை பெரிய தலைவன்னு நம்பி நான் மோசம் போனேண்டா ! அயோக்கிய பயலே! இந்திரனை கெளதமர் சபிச்சாராம்,உடம்பெல்லாம் கண்களாப் போச்சொல்லி ! உன்னை அப்படி சபிக்கக்கூடாது ! ரெண்டு கண்ணை வச்சிக்கிட்டே நீ இப்படி ரெண்டகம் பண்றியே உடம்பெல்லாம் கண்ணாப்போனா நீ ஊர்ப் பெண்களையெல்லாம் விடமாட்டே ! உன்னை உயிரோடவே விடக்கூடாது !","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d006","canonical_scene":69,"source_scene_heading":69,"speaker_label":"பரந்தாமன்","text":"ஏ கிழவா ! மரியாதையாகப் பேசு!","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d007","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"என்ன சொன்னே சண்டாளப் பயலே!","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d008","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"இந்தப் பகல் வேஷக்காரனை நம்பி பாட்டாளி மக்களை யெல்லாம் கெடுத்துட்டேன் பாவிப் பயல்!","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d009","canonical_scene":69,"source_scene_heading":69,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"புண்யகோடி நீர் கைதுசெய்யப்படுகிறீர்!","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d010","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"ஆ! ஏன்?","page_provenance":[{"pdf_page":85,"printed_page":77}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d011","canonical_scene":69,"source_scene_heading":69,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"ஸ்ட்ரைக் செய்து அராஜகம் நடத்தியதற்காக","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d012","canonical_scene":69,"source_scene_heading":69,"speaker_label":"புண்யகோடி","text":"அது என் குற்றமில்லீங்க!","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-69.md"},{"id":"tirumbippaar-s069-d013","canonical_scene":69,"source_scene_heading":69,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"கோர்ட்டில் சொல்லும்!","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-69.md"}]
