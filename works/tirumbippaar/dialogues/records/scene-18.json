[{"id":"tirumbippaar-s018-d001","canonical_scene":18,"source_scene_heading":18,"speaker_label":"புண்யகோடி","text":"சீக்கிரம் புறப்படுடா தம்பி ! எல்லாம் தயாரா இருக்கு.","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-18.md"},{"id":"tirumbippaar-s018-d002","canonical_scene":18,"source_scene_heading":18,"speaker_label":"பாண்டியன்","text":"ஊர்வலம் வேணுமாப்பா? எனக்கென்னமோ பிடிக்கலை","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-18.md"},{"id":"tirumbippaar-s018-d003","canonical_scene":18,"source_scene_heading":18,"speaker_label":"புண்யகோடி","text":"அது கெட்டுது போ ! ஊர்வலமே வேண்டாமா ! நம்ப என்ன அவாளை இவாளை கூப்பிட்டு கச்சேரியா வைக்கப் போறோம். கொஞ்சம் சிறப்பா, வெறும் மாப்பிள்ளை ஊர்வலம் கூடவா கூடாது—பெண் உன் பக்கத்திலே இருக்கப் போறதில்லை நீ ஏன் வெட்கப் படுறே.","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-18.md"}]
