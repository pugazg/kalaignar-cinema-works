[
  {"id":"tirumbippaar-s083-d001","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பரந்தாமன்","text":"நீ உடனே தினசரி பத்திரிகை ஆபீஸ்களுக்குச் செல்லவேண்டும்.","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d002","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பையன்","text":"எங்க...","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d003","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பரந்தாமன்","text":"இந்த விளம்பரத்தை எல்லாப் பத்திரிகைகளிலும் போட்டவேண்டும்.","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d004","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பையன்","text":"எங்க வீணு சிரமம் குமுதா அம்மாளுக்கே நேரா ஒரு கார்டு போட்டா போவது!","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d005","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பரந்தாமன்","text":"ஏ. என்னு எனக்கு புத்தி வந்தவுடனே உனக்கு புத்தி மறுஞ்சுது! குமுதா விலாசம் தெரிஞ்சா இந்த விளம்பரம் எதுக்கு! உம்...","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d006","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பையன்","text":"ஓ....அதை மறந்துட்டேன்.","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d007","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பரந்தாமன்","text":"(நூறு ரூபாய் பணம் எடுத்துக் கொடுத்து) இந்தா விளம்பர சார்ஜுக்குக் கொடு! எல்லா பத்திரிகையிலும் இன்னைக்கே போட்டச் சொல்லணும்!","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d008","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பையன்","text":"(பணத்தையும் காகிதத்தையும் வாங்கியபடி) சரிங்க!...","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"},
  {"id":"tirumbippaar-s083-d009","canonical_scene":83,"source_scene_heading":83,"speaker_label":"பரந்தாமன்","text":"நிச்சயம் என் குமுதா இருக்குமிடம் தெரிந்து விடும்! அவளிடம் ஓடிவேன். மன்னிப்புக் கேட்பேன். சீரழிந்த குடும்பத்திலே மறுமலர்ச்சி உண்டாக்குவேன்!","page_provenance":[{"pdf_page":101,"printed_page":93}],"source_scene_file":"scene-83.md"}
