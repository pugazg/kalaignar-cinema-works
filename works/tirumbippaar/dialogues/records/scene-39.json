[{"id":"tirumbippaar-s039-d001","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"வாருங்கள்....உட்காருங்கள்!....","page_provenance":[{"pdf_page":50,"printed_page":42}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d002","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"அழைத்த காரியமென்ன?","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d003","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"ம்...இந்த வேலை நிறுத்தத்தைப்பற்றி...","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d004","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"எல்லாம் என் ஏற்பாடுதான்—நான் காட்டிய வழியில் செல்ல ஆயிரக் கணக்கான தொழிலாளர்கள் தயாராயிருக்கிறார்கள்.","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d005","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"மிஸ்டர் பரந்தாமன்! மில் தொழிலாளர்களின் கிளர்ச்சியை உங்களால்தான் நிறுத்த முடியுமென்று எனக்குத் தெரியும்.","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d006","canonical_scene":39,"source_scene_heading":39,"speaker_label":"கருடன்","text":"சந்தேகமா அதிலே! பரந்தாமன் மாத்திரம் இல்லா விட்டால் இந்நேரம் மில்லையே அழித்திருப்பார்கள்!","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d007","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"அதோட, தங்கள் உயிருக்கே ஆபத்து ஏற்படத் இருந்தார்கள்! நான்தான் தடுத்தேன்!","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d008","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"சந்தோஷம்! ரொம்ப நன்றி! என் உயிரைக் காப்பாற்றியதற்காக! தங்களுக்கு என்னுடைய சிறிய உதவியாக இந்த ஐயாயிர ரூபாயை அளிக்கிறேன்.","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d009","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"என்ன...பணமா!","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d010","canonical_scene":39,"source_scene_heading":39,"speaker_label":"கருடன்","text":"வாங்கிக் கொள்ளப்பா! தொழிலாளர் நிதியில் சேர்த்துவிடலாம்! ஏழைகளுக்காக உழைக்கவே ஜென்மம் எடுத்துட்டோமே!","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d011","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"நான் இதை லஞ்சமாக நினைத்துக் கொடுக்கவில்லை.","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d012","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"நானும் இதை அப்படி நினைத்து வாங்கவில்லை.","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d013","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"இந்த ஸ்டிரைக்கை எப்படியாவது நிறுத்திவிடுவீர்களானால்.....","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d014","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"நிறுத்திவிடலாம். அதற்கு புண்ணகோடியை மாற்றினால்தான் முடியும்!","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d015","canonical_scene":39,"source_scene_heading":39,"speaker_label":"கருடன்","text":"புண்ணகோடி....அவன் மூவாயிரமாவது கேட்பான்!","page_provenance":[{"pdf_page":51,"printed_page":43}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d016","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"தருகிறேன்! இப்போதே தருகிறேன்.","page_provenance":[{"pdf_page":52,"printed_page":44}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d017","canonical_scene":39,"source_scene_heading":39,"speaker_label":"பரந்தாமன்","text":"தங்களுடைய நல்ல குணத்திற்காகவும், நம்முடைய நட்பு நீடிக்க வேண்டுமென்பதற்காகவும், ஒரு பெரிய கிளர்ச்சியை விட்டுக்கொடுக்கிறேன்.","page_provenance":[{"pdf_page":52,"printed_page":44}],"source_scene_file":"scene-39.md"},{"id":"tirumbippaar-s039-d018","canonical_scene":39,"source_scene_heading":39,"speaker_label":"முதலாளி","text":"ரொம்ப நன்றி!","page_provenance":[{"pdf_page":52,"printed_page":44}],"source_scene_file":"scene-39.md"}]