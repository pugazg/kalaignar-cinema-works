[{"id":"tirumbippaar-s002-d001","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"நாளைக்கு காலையிலே வந்துடணும்...","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d002","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பரந்தாமன்","text":"(தூங்கியெழுந்த சோம்பலுடன் வந்துகொண்டே) ஆமாம் காலையிலே வந்துடுங்க! மனுஷனை தூங்கவிடாமல் கத்தலாம்...","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d003","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"கத்தலா இது! கற்கண்டைவிட இனிப்பாயிற்றே மழலை மொழி!","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d004","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பரந்தாமன்","text":"அக்கா! இதெல்லாம் எனக்குப் பிடிக்கிலே! பஞ்சத்திலே அடிபட்டதையெல்லாம் இங்கே ஏன் கூப்பிடுறே? எங்கயாவது தர்மப் பள்ளிக்கூடத்துக்குப் போகட்டுமே...","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d005","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"எனக்குப் பொழுதுபோக வேண்டும் தம்பி!","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d006","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பரந்தாமன்","text":"பணக்கார வீட்டுப் பெண்களுக்கு பொழுதைக் கழிக்கவா வழியில்லை? பல வழியிருக்கு! பேட்மிட்டன், பிங்பாங், லேடீஸ் கிளப், இங்கிலீஷ் பிக்சர், So many entertainments.","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d007","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"பல வழியிருக்கலாம் தம்பி! ஆனால் மற்றவர்களுக்கும் பயனுள்ளதாக இருக்க வேண்டாமா?","page_provenance":[{"pdf_page":10,"printed_page":2}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d008","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பரந்தாமன்","text":"சரி...உன் இஷ்டம்! இனிமே இந்த வீட்டுக்கு படுக்க வர்ரதே தப்பு! நமக்கு சத்திரம் சாவடியா இல்லை.","page_provenance":[{"pdf_page":11,"printed_page":3}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d009","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"தம்பி அப்படியெல்லாம் சொல்லாதே! கடல் போல வீடு இருக்கு!","page_provenance":[{"pdf_page":11,"printed_page":3}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d010","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பரந்தாமன்","text":"நல்லா இருந்ததுபோ! அக்கா! பணம் எதுக்காக இருக்கு...அனுபவிக்க—வாழ்வு, சுகம், பணம்—எல்லாமே மூன்று எழுத்து.","page_provenance":[{"pdf_page":11,"printed_page":3}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d011","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"அன்பு, தொண்டு—அதுகூட மூன்று எழுத்துத்தான், பரந்தாமா வாழ்வு தேவைதான். ஆனால் மற்றவர்களுக்காக வாழ்கிற வாழ்வு—சுகம் வேண்டியதுதான்—பிறருடைய ஆனந்தத்திலே ஏற்படுகிற இதய சுகம் .... ... ...","page_provenance":[{"pdf_page":11,"printed_page":3}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d012","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பரந்தாமன்","text":"ஊம் கும். கூடிய சீக்கிரம் இந்த வீடு ஒரு ஆஸ்ரமமா ஆயிடும்.","page_provenance":[{"pdf_page":11,"printed_page":3}],"source_scene_file":"scene-02.md"},{"id":"tirumbippaar-s002-d013","canonical_scene":2,"source_scene_heading":2,"speaker_label":"பூமாலை","text":"யாரு ... ... ஓ ... ... வாங்க வாங்க! உக்காருங்க! குண்டுமணி! டீ கொண்டுவா!","page_provenance":[{"pdf_page":11,"printed_page":3}],"source_scene_file":"scene-02.md"}]