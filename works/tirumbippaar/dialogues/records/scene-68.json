[{"id":"tirumbippaar-s068-d001","canonical_scene":68,"source_scene_heading":68,"speaker_label":"போலீஸ்","text":"போலீஸார் மீது கல்வீச்சு!","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-68.md"},{"id":"tirumbippaar-s068-d002","canonical_scene":68,"source_scene_heading":68,"speaker_label":"II போலீஸ்","text":"மில்லின் கதவையே தூள் தூளாக உடைத்து விட்டார்கள். மில் முதலாளி வீட்டிலும் கல் வீசினார்கள்.","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-68.md"},{"id":"tirumbippaar-s068-d003","canonical_scene":68,"source_scene_heading":68,"speaker_label":"போலீஸ்","text":"தெருவில் ஜனங்கள் நடமாடவே பயப்படுகிறார்கள்.","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-68.md"},{"id":"tirumbippaar-s068-d004","canonical_scene":68,"source_scene_heading":68,"speaker_label":"போலீஸ்","text":"நாளைக்கு காலையிலே பெரிய ஊர்வலம் ஒண்ணு இருக்காம்.","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-68.md"},{"id":"tirumbippaar-s068-d005","canonical_scene":68,"source_scene_heading":68,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"(வந்து) சரி, முக்கியஸ்தர்களை யெல்லாம் கைதுசெய்ய உத்திரவு வந்திருக்கு. புறப்படுங்க!","page_provenance":[{"pdf_page":84,"printed_page":76}],"source_scene_file":"scene-68.md"}]
