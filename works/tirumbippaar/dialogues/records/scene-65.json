[{"id":"tirumbippaar-s065-d001","canonical_scene":65,"source_scene_heading":65,"speaker_label":"முதலாளி","text":"(பரந்தாமனிடம்) உஷாவின் இஷ்டத்துக்கு விரோதமா திருமணம் செய்ய மாட்டேன்.","page_provenance":[{"pdf_page":81,"printed_page":73}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d002","canonical_scene":65,"source_scene_heading":65,"speaker_label":"பரந்தாமன்","text":"பெண்புத்தி பின்புத்தி என்பார்கள். இந்த ஒரு விஷயத்தில் பெற்றோர்கள் அபிப்ராயத்திற்குத்தான் பெண்கள் நடக்க வேண்டும்.","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d003","canonical_scene":65,"source_scene_heading":65,"speaker_label":"முதலாளி","text":"பெற்றோர்கள் இஷ்டமே வேறு மாப்பிள்ளைக்கு அவளைக் கொடுக்க வேண்டும் என்று தானே.....","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d004","canonical_scene":65,"source_scene_heading":65,"speaker_label":"பரந்தாமன்","text":"அப்படியானால் முடியாது. இல்லையா? உம்.","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d005","canonical_scene":65,"source_scene_heading":65,"speaker_label":"முதலாளி","text":"இது என்னய்யா கேள்வி! நல்லாயிருக்கு .....","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d006","canonical_scene":65,"source_scene_heading":65,"speaker_label":"பரந்தாமன்","text":"கடைசியாகச் சொல்கிறேன், உஷாவை எனக்குக் கொடுத்தால் சரி ; இல்லாவிட்டால் பெரியதொரு புரட்சியை சமாளிக்க நேரிடும்.","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d007","canonical_scene":65,"source_scene_heading":65,"speaker_label":"முதலாளி","text":"என்னய்யா பூச்சி காட்ற...","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d008","canonical_scene":65,"source_scene_heading":65,"speaker_label":"பரந்தாமன்","text":"இந்தத் தடவை பணத்தைக் கொடுத்து ஏமாற்ற முடியாது பரந்தாமனை !","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"},{"id":"tirumbippaar-s065-d009","canonical_scene":65,"source_scene_heading":65,"speaker_label":"முதலாளி","text":"பெண்ணைக் கொடுத்து ஏமாறச் சொல்றியா? முடியாது ! எது வேண்டுமானால் செய்துக்கொள் போ !","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-65.md"}]
