[{"id":"tirumbippaar-s071-d001","canonical_scene":71,"source_scene_heading":71,"speaker_label":"கருடன்","text":"எல்லாம் அரேஞ்ச் பண்ணிட்டேன்.","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d002","canonical_scene":71,"source_scene_heading":71,"speaker_label":"பரந்தாமன்","text":"ஆள் எப்படி அழகிதானா?","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d003","canonical_scene":71,"source_scene_heading":71,"speaker_label":"கருடன்","text":"முப்பத்தி மூணு லட்சணம் பொருந்தியவள்.","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d004","canonical_scene":71,"source_scene_heading":71,"speaker_label":"பரந்தாமன்","text":"என்னப்பா ஒரு லட்சணம் புதுசா சொல்றே !","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d005","canonical_scene":71,"source_scene_heading":71,"speaker_label":"கருடன்","text":"அவ லட்சணத்தெ நீ நேரா பாத்தா தெரியும்.","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d006","canonical_scene":71,"source_scene_heading":71,"speaker_label":"பரந்தாமன்","text":"ஆ !","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d007","canonical_scene":71,"source_scene_heading":71,"speaker_label":"கருடன்","text":"தாஸியாகப் பொறந்தாலும், நீ வர்ணிப்பியே ; அது மாதிரி தங்கக் கொடி பரந்தாமா!","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d008","canonical_scene":71,"source_scene_heading":71,"speaker_label":"பரந்தாமன்","text":"கருடா!","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d009","canonical_scene":71,"source_scene_heading":71,"speaker_label":"கருடன்","text":"அவளெப் பாத்தோன்ன எனக்கு ஒரு ஐடியா தோணுச்சி !","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d010","canonical_scene":71,"source_scene_heading":71,"speaker_label":"பரந்தாமன்","text":"என்ன?","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d011","canonical_scene":71,"source_scene_heading":71,"speaker_label":"கருடன்","text":"நம்ப 'வாழு' புஸ்தகத்தின் இரண்டாம் பதிப்புக்கு அவளை அட்டைப் படமா போடலாம்!","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"},{"id":"tirumbippaar-s071-d012","canonical_scene":71,"source_scene_heading":71,"speaker_label":"பரந்தாமன்","text":"ஏ சும்மாயிருடா பிஸ்னஸ்!","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-71.md"}]
