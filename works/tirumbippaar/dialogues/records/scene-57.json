[{"id":"tirumbippaar-s057-d001","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குண்டுமணி","text":"சின்னம்மா ! அம்மா வர்ராங்க!","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d002","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"வருவதாய் முன்கூட்டி எழுதக்கூட இல்லையே.","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d003","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குண்டுமணி","text":"எதிர்பார்க்காத நேரத்தில் வந்தாதான் சந்தோஷம் ஜாஸ்தியாகும்னு இப்படி வந்திருக்காங்க ...!","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d004","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"எல்லோரும் சௌக்கியமா சின்னம்மா?","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d005","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குண்டுமணி","text":"குமுதா அம்மாக்கு சின்னய்யா ஏதாவது பிரசன்டேசன் அனுப்பியிருக்காரா?.","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d006","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"உம். அனுப்பியிருக்காருடா. காதுக்கு கம்மல், கழுத்துக்கு நெக்லஸ் !...","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d007","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"(குண்டுமணியிடம்) இந்தா பெட்டியைக் கொண்டு உள்ளே வையி.","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d008","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குண்டுமணி","text":"உம். இப்ப பழம் வாங்கிட்டு வந்திருக்கீங்க. இன்னம் நாலு மாசங்கழித்து வரும் போது பம்பரம், படபடா வண்டி, பாலாடை, கிலுகிலுப்பை எல்லாம் வாங்கிட்டு வருவீங்க...","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d009","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"ஏய், போய் காபி கொண்டாடா.","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d010","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"ஏன் குமுதா,உண்மையைச் சொன்னா கோபமா?","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d011","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"வாங்க... உட்காருங்கள் ....","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d012","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"உட்கார நேரமில்லை நீங்கள்தானே பாண்டியன்?","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d013","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"ஆமாம்","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d014","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப் - இன்ஸ்பெக்டர்","text":"குனியமுத்தூர் வழிப்பறி சம்பந்தமா உங்க வீட்டை சோதனை போட வேண்டியிருக்கு ...","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d015","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"என் வீட்டையா?","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d016","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"yes!...","page_provenance":[{"pdf_page":72,"printed_page":64}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d017","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"என்ன சார் சொல்றீங்க...","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d018","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"நான் சொல்லலே, இந்த ஆர்டர் சொல்லுது! எய்ட் செவன் சிக்ஸ், கமான்....","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d019","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"சின்னம்மா (கட்டிக் கொள்ளல்)","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d020","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"சும்மா இரு. சும்மா இரு. ஒண்ணுமில்லை.","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d021","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"குமுதா! பைத்தியம்! என்ன இது! ஏன் பயப்படுகிறாய்? குற்றம் இருந்தால்தானே பயப்பட வேண்டும்.","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d022","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"ம்... கிடைக்கலியே.","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d023","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குண்டுமணி","text":"ஏன் சார் இதை மிச்சம் வச்சுட்டுப் போறீங்க. இதையும் பாத்துக்குங்க (பூமாலையிடம்) சாவி கொடுங்கம்மா!...","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d024","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"என்னப்பா உனக்கு கோபம் வருது! எங்க கடமையை நாங்க செய்றோம்.","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d025","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப்- இன்ஸ்பெக்டர்","text":"உஷா ! இதேதான்.","page_provenance":[{"pdf_page":73,"printed_page":65}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d026","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப் - இன்ஸ்பெக்டர்","text":"அகப்பட்டுவிட்டது. பாண்டியன் உம்மை அரஸ்ட் செய்திருக்கிறேன்.","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d027","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"ஆ","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d028","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"இது என் பெட்டி சார். அவரை விட்டுடுங்க...","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d029","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப் - இன்ஸ்பெக்டர்","text":"ஸ்!... சொல்ல வேண்டியவைகளை கோர்ட்டில் சொல்லுங்கள்.என் வேலையை யாரும் தடுக்காதீர்கள். (போலீஸாரிடம் ) ம் ...கொண்டு போங்கள் !","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d030","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"(பாண்டியனிடம் ஓடிவந்து அலறல்) பாண்டியன்! பாண்டியன்!","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d031","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"குமுதா!","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d032","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"இது என்ன பாண்டியன். எனக்கொன்றுமே புரிய......","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d033","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பாண்டியன்","text":"புரியவில்லையா! இதுதான் உலகம் !","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d034","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"சப் - இன்ஸ்பெக்டர் சார் ! நான் தான் ஊரிலிருந்து வந்தேன். இது என் பெட்டிதான். பாண்டியன் மீது எந்த குற்றமுமில்லை. அவரை விட்டு விடுங்கள்.","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d035","canonical_scene":57,"source_scene_heading":57,"speaker_label":"சப் - இன்ஸ்பெக்டர்","text":"தொந்திரவு கொடுக்காதீர்கள். உம் கொண்டு போங்கள்.","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d036","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"(திகைத்து நின்று ஓடுகிறாள்) பாண்டியன், பாண்டியன் ...... (ஓடுகிறாள்)","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d037","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"குமுதா... அமைதியாயிரு !... அழாதே ! அழாதே !","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d038","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"அழாமல் ஆனந்தமடையச் சொல்கிறாயா! எனக்கு எப்படி வரும் ஆனந்தம் ? அவரை ஜெயிலுக்கு அனுப்ப வேண்டும் என்று நான் கங்கணம் கட்டிக்கொண்டா வந்தேன், காரியம் கை கூடியதும் மகிழ்ச்சியடைய","page_provenance":[{"pdf_page":74,"printed_page":66}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d039","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"குமுதா!","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d040","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"ஏன் சின்னம்மா, எங்கள் வாழ்வை இப்படிக் கெடுத்தாய்?","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d041","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"குமுதா! நான் ஒரு குற்றமும் அறியாதவள் குமுதா! யாருடைய சூதாட்டத்திற்கோ நான் வெட்டுக்காயாக பயன்பட்டு விட்டேன், என்னையும் அறியாமல்","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d042","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"யாருடைய சூதாட்டம்! ஏன் மறைக்கிறாய். எல்லாம் உன் தம்பியின் சூதாட்டம்தான் !...தெரியும் எனக்கு !.. இருவருமே சேர்ந்துகொண்டு எங்கள் இன்ப வாழ்வைக் கெடுக்க திட்டம் போட்டிருக்கிறீர்கள் என்று....","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d043","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"குமுதா ! சந்தர்ப்பம் செய்திருக்கும் சதியை உன்னால் உணர முடியாவிட்டாலும் உன் சின்னம்மாவுக்கு இருதயம் என்று ஒன்று இருக்கிறது என்பதைக்கூடவா மறந்து விட்டாய்!","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d044","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"இருதயம் இருக்கிறது. அதில் உன் தம்பியின் ஷேம லாபங்களுக்கு மட்டுமே இடமுமிருக்கிறது.","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d045","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"(அலறல்) குமுதா!","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d046","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"தன்னுடைய படுக்கையறைப் பதுமைகளில் ஒருத்தியாக இருக்கவேண்டிய குமுதா பகைவன் பாண்டியனின் காதலியாகிவிட்டாளே என்ற ஆத்திரம் பரந்தாமனுக்கு! நம்முடைய காதலனாக இருக்கவேண்டிய பாண்டியன் குமுதாவோடு கொஞ்சிக் கிடக்கிறானே என்ற குமுறல் உனக்கு !","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d047","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"ஆ ! என்ன சொன்னாய்! அடி பாவி!","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d048","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"இனிமேல் எதுவும் சொல்ல வேண்டியதில்லை. இந்த வீட்டு பந்தம், பாசம், சொந்தம் எல்லாம் இன்றோடு தொலைந்தது ! போய் வருகிறேன். இந்தா நீ பூட்டிய பொன் அணிகள் ! பூணாரங்கள் எடுத்துக்கொள்! (நகைகளைக் கழற்றி எறிதல்) தம்பியோடு சுகமாயிரு ! நான் போகிறேன் ..","page_provenance":[{"pdf_page":75,"printed_page":67}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d049","canonical_scene":57,"source_scene_heading":57,"speaker_label":"பூமாலை","text":"குமுதா !...","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-57.md"},{"id":"tirumbippaar-s057-d050","canonical_scene":57,"source_scene_heading":57,"speaker_label":"குமுதா","text":"என்னைத் தொடாதே ! இனி நான் யார்? நீ யார்?","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-57.md"}]
