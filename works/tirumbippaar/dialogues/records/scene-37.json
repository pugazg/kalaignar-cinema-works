[{"id":"tirumbippaar-s037-d001","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"ராத்திரியோட ராத்திரியா ஊர்முழுக்க ஒட்டணும்! ஒரு சுவரு பாக்கி இருக்கக்கூடாது! தெரியுமா!","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d002","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பையன்","text":"சரிங்க !...","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d003","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"ஆமாம் போ !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d004","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"எம்ப்பா தம்பி ? ஏன் வருத்தமாயிருக்கே !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d005","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஒண்ணுமில்லப்பா !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d006","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"நேத்திலேயெல்லாம் சந்தோஷமாயிருந்தே ! மறு படியும் என்ன ?","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d007","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஒரு கவலையுமில்ல.","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d008","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"ம்...பாண்டியா ! உங்கிட்டே ஒரு விஷயம் சொல்லணும்னு இருந்தேன்......ம்....","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d009","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"(சிறிது திகைத்து) என்னப்பா !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d010","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"அது .....அது...","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d011","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"இதபாரு !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d012","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"(படத்தைப் பார்த்து) அப்பா ! எனக்குக் கல்யாணமே வேண்டாம்ப்பா !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d013","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"உனக்கு வேண்டாம்..சரி..இந்தப் பொண்ணு...","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d014","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"யாராயிருந்தாலும் சரி தேவையில்ல.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d015","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"நீ என்னப்பா அவசரக்காரனாயிருக்கே! அந்தப் பொண்ணு துடியா துடிக்குது.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d016","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"துடிக்கட்டும் ! அதற்காக !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d017","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"பெண்ணுக்கு இஷ்டமிருக்குன்னு சொல்றேன். நீ என்னடான்னா !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d018","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஐயோ இது என்ன வம்பு !...","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d019","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"வம்பு ஒண்ணும் இல்லடா ...வயசானவன் கல்யாணம் பண்ணிக்கக்கூடாதுன்னு... ஊர்ல கத்துவாங்களே அதுக்குத்தான் இவ்வளவும் சொல்றேன்","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d020","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"எனக்கு இப்பவும் கல்யாணம் வேண்டாம்! வயசான பிறகும் கல்யாணம் வேண்டாம்.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d021","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"அட உனக்கில்லடா உனக்கில்ல ! அது கெடக்குது போ ! என்னைப்பத்தி சொல்றேன் நான் !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d022","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"அப்பா ! திருமணம் உங்களுக்கா ?","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d023","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"ஏன் ஆச்சரியப்படுறே ? இது என்ன உலகத்திலே எட்டாவது அதிசயமா ?","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d024","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"எப்போதப்பா உங்களுக்கு இந்த ஆசை வந்தது ?","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d025","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"ஆமாண்டா ! நல்ல கேள்விடா ! எப்ப ஆசை வந்ததாம்? நான் வருஷம், மாதம், தேதி குறிச்சா வச்சிருக்கேன். ஆசைக்கு ஜாதகம் கேக்கிறே !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d026","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஆசைக்கு ஜாதகம் இல்லாவிட்டாலும், அறுபது வயதை நீங்கள் கடந்து விட்டீர்கள் என்பதற்கு ஜாதகம் இருக்கிறதப்பா !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d027","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"அதிகப்பிரசங்கி ...","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d028","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"அப்பா ! ஒரு இளம் பெண்ணின் வாழ்க்கைக் கெடுக்காதீர்கள் !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d029","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"முட்டாள் ! இளம் பெண்ணுக்கு வாழ்க்கை கொடுக்கப் போகிறேன். விஷயம் புரியாமல் உளறாதே ! இந்தப் பெண்ணை யாரும் கல்யாணம் பண்ணிக்கமாட்டேங்கிறான், இது ஒரு ஊமை","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d030","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"பேசத் தெரிந்த பெண்களையே பேசாமடந்தை யாக்கிவிடும் பைத்தியக்கார சமூகம், ஊமைகளையா உயிரோடு விட்டு வைக்கிறது !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d031","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"இப்ப என்னடா சொல்றே ?","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d032","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"உங்கள் முடிவை மாற்றிக் கொள்ள வேண்டுகிறேன்.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d033","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"முடியாது ! உன் முடிவைத்தான் மாற்றிக் கொள்ள வேண்டும். உனக்கு முன்னாடி பிறந்தவன் நான்.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d034","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"யார் மறுக்கிறார்கள் ! பேரன் பேத்தியை கொஞ்சவேண்டிய வயது !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d035","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"உன்னை பெத்து வளர்த்து பாதுகாத்த மனுஷனுக்கு இப்படி எதிர்த்துத்தான்டா பேசணும்","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d036","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"அதற்காக ஆயிரம் வணக்கம் செலுத்துகிறேன். ஆனால் மகன் கல்யாணத்தில், மாலை எடுத்துத் தரவேண்டிய பருவத்தில், மாப்பிள்ளையாக மாறுகிறேன் என்கிறீர்களே, அதை என்னால் அனுமதிக்கவே முடியாது !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d037","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"சீ ! நீ என்னடா அனுமதிக்கிறது. என் இஷ்டம். நான் செய்றேன்.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d038","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"வேண்டாம்ப்பா இந்த விபரீத முடிவு","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d039","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"சீ ! என்கிட்டே பேசாதே !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d040","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"உங்கள் கல்யாணத்தை ?","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d041","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"நடத்தத்தான் போறேன்","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d042","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"என்னை வெறுத்து விட்டா ?","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d043","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"உன்னை விரட்டிவிட்டு...","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d044","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"நீங்க விரட்டலேன்னா, நானே போயிடலாம் போல இருக்குது","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d045","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"போடா போ ! உன் நெனப்பே வேண்டாம் எனக்கு !","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d046","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"போகிறேன்ப்பா !","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d047","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்ணகோடி","text":"போ... போ !..","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"}]
