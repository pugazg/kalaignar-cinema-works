[{"id":"tirumbippaar-s037-d001","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"ராத்ரியோட ராத்ரியா ஊர்முழுக்க ஓட்டணும்! ஒரு சுவரு பாக்கி இருக்கக்கூடாது ! தெரியுமா!","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d002","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பையன்","text":"சரிங்க!...","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d003","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"ஆமாம் போ !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d004","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"ஏம்ப்பா தம்பீ. ஏன் வருத்தமாயிருக்கே!","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d005","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஒண்ணுமில்லப்பா !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d006","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"நேத்தியெல்லாம் சந்தோஷமாயிருந்தே! மறுபடியும் என்னா?","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d007","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஒரு கவலையுமில்லை.","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d008","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"ம்... பாண்டியா! உன்கிட்டே ஒரு விஷயம் சொல்லணும்னு இருந்தேனே!.. உம் ...","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d009","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"(சிறிது திகைத்து) என்னப்பா!","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d010","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"அது... அது...","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d011","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"இதபாரு !","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d012","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"(படத்தைப் பார்த்து) அப்பா ! எனக்கு கல்யாணமே வேண்டாமப்பா!","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d013","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"உனக்கு வேண்டாம் சரி... இந்தப் பெண்ணு","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d014","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"யாராயிருந்தாலும் சரி தேவையில்லை.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d015","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"நீ என்னப்பா அவசரக்காரனாயிருக்கே ! அந்தப் பெண்ணு துடியா துடிக்குது!","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d016","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"துடிக்கட்டும்! அதற்காக !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d017","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"பெண்ணுக்கு இஷ்டம் இருக்குன்னு சொல்றேன்.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d018","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஐயோ இது என்னா வம்பு !...","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d019","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"வம்பு ஒண்ணும் இல்லடா ... வயசானவன் கல்யாணம் பண்ணிக்கக்கூடாதுன்னு ஊர்ல கத்துவாங்களே ... அதுக்குத்தான் இவ்வளவும் சொல்றேன்.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d020","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"எனக்கு இப்பவும் கல்யாணம் வேண்டாம்! வயசான பிறகும் கல்யாணம் வேண்டாம்!","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d021","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"அட உனக்கு இல்லடா உனக்கு இல்ல! அது கெட்டுது போ! என்னைப்பத்தி சொல்றேன் நான் !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d022","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"அப்பா ! திருமணம் உங்களுக்கா?","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d023","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"ஏன் ஆச்சரியப்படுறே ! இது என்னா உலகத்திலே எட்டாவது அதிசயமா?","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d024","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"எப்போதப்பா உங்களுக்கு இந்த ஆசை வந்தது !","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d025","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"ஆமாண்டா! நல்ல கேள்விடா ! எப்ப ஆசை வந்ததாம்? நான் வருஷம்,மாதம்,தேதி குறிச்சா வைத்திருக்கேன். ஆசைக்கு ஜாதகம் கேக்கிறான்.","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d026","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"ஆசைக்கு ஜாதகம் இல்லாவிட்டாலும், அறுபது வயதை நீங்கள் கடந்துவிட்டீர்கள் என்பதற்கு ஜாதகம் இருக்கிறதப்பா!","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d027","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"அதிகப்பிரசங்கி!","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d028","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"அப்பா ! ஒரு இளம் பெண்ணின் வாழ்வைக் கெடுக்காதீர்கள்!","page_provenance":[{"pdf_page":47,"printed_page":39}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d029","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"முட்டாள்! இளம் பெண்ணுக்கு வாழ்வை கொடுக்கப் போகிறேன்! விஷயம் புரியாமல் உளறாதே! இந்தப் பெண்ணை யாரும் கல்யாணம் பண்ணிக்கமாட்டேங்கிறான். இது ஒரு ஊமை!","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d030","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"பேசத் தெரிந்த பெண்களையே பேசாமடந்தையாக்கிவிடும் பைத்தியக்கார சமூகம், ஊமைகளையா உயிரோடு விடப்போகிறது.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d031","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"இப்ப என்னடா சொல்றே !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d032","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"உங்கள் முடிவை மாற்றிக்கொள்ள வேண்டுகிறேன்.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d033","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"முடியாது! உன் முடிவைத்தான் மாற்றிக்கொள்ள வேண்டும். உனக்கு முன்னாடி பிறந்தவன் நான்!","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d034","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"யார் மறுக்கிறார்கள் ! பேரன் பேத்தியை கொஞ்சவேண்டிய வயது !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d035","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"உன்னைப் பெத்து வளர்த்து பாதுகாத்து மனுஷனாக்கி விட்டதுக்கு, இப்படி எதிர்த்துத்தாண்டா பேசணும்!","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d036","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"அதற்காக ஆயிரம் வணக்கம் செலுத்துகிறேன். ஆனால் மகன் கல்யாணத்தில், மாலை எடுத்துத் தரவேண்டிய பருவத்தில், மாப்பிள்ளையாக மாறுகிறேன் என்கிறீர்களே ; அதை என்னால் அனுமதிக்கவே முடியாது!","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d037","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"சீ ! நீ என்னடா அனுமதிக்கிறது. என் இஷ்டம் நான் செய்கிறேன்.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d038","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"வேண்டாமப்பா இந்த விபரீத முடிவு!","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d039","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"சீ ! என்கிட்ட பேசாதே !","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d040","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"உங்கள் கல்யாணத்தை ?","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d041","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"நடத்தத்தான் போறேன்.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d042","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"என்னை வெறுத்துவிட்டா?","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d043","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"உன்னை விரட்டிவிட்டு.","page_provenance":[{"pdf_page":48,"printed_page":40}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d044","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"நீங்கள் விரட்டவேண்டாம். நானே போகிறேன்.","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d045","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"போடா ! என் முகத்திலேயே முழிக்காதே! போடா போ!","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d046","canonical_scene":37,"source_scene_heading":37,"speaker_label":"பாண்டியன்","text":"போகிறேன். உங்கள் போதை விரைவில் தெளியட்டும். ( போகிறான்)","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"},{"id":"tirumbippaar-s037-d047","canonical_scene":37,"source_scene_heading":37,"speaker_label":"புண்யகோடி","text":"போடா போ ! போதை தெளியட்டுமாமில்ல. இங்க என்ன குடிச்சிபிட்டா உட்கார்ந்திருக்காங்க.","page_provenance":[{"pdf_page":49,"printed_page":41}],"source_scene_file":"scene-37.md"}]
