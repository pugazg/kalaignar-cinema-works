[
  {"id":"tirumbippaar-s087-d001","canonical_scene":87,"source_scene_heading":87,"speaker_label":"குண்டுமணி","text":"அம்மா அம்மா பாத்தீங்களா! குமுதா அம்மா விலாசத்தைக் கேட்டு உங்க தம்பி விளம்பரம் பண்ணியிருக்காரு!","page_provenance":[{"pdf_page":105,"printed_page":97}],"source_scene_file":"scene-87.md"},
  {"id":"tirumbippaar-s087-d002","canonical_scene":87,"source_scene_heading":87,"speaker_label":"பூமால்","text":"ஆ! (பத்திரிகையைப் பார்த்தல்) குமுதாவைத் தேடுகிறான் பரந்தாமன்—பாவி! அவளுக்கும் ஏதோ ஆபத்து வரப்போகிறது! குண்டுமணி நான் உடனே மதராஸ் புறப்பட வேண்டும்.","page_provenance":[{"pdf_page":105,"printed_page":97}],"source_scene_file":"scene-87.md"},
  {"id":"tirumbippaar-s087-d003","canonical_scene":87,"source_scene_heading":87,"speaker_label":"குண்டுமணி","text":"சரிங்க...","page_provenance":[{"pdf_page":105,"printed_page":97}],"source_scene_file":"scene-87.md"},
  {"id":"tirumbippaar-s087-d004","canonical_scene":87,"source_scene_heading":87,"speaker_label":"பூமால்","text":"நான் போனால்தான் அந்த நாசகாரனிடமிருந்து குமுதாவைக் காப்பாற்ற முடியும்!","page_provenance":[{"pdf_page":105,"printed_page":97}],"source_scene_file":"scene-87.md"}
