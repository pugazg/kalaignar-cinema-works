[
  {"id":"tirumbippaar-s091-d001","canonical_scene":91,"source_scene_heading":91,"speaker_label":"உஷா","text":"பரந்தாமன்தான் வழிப்பறிசெய்து நெக்லஸை திருடினான் என்பது பூமாலை பரந்தாமன் சச்சரவின்போது எனக்கு நன்றாக புரிந்து விட்டதப்பா.","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d002","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"பாபம் நிரபராதியான பாண்டியனை வீணே கஷ்டப் படுத்தி விட்டேன்.","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d003","canonical_scene":91,"source_scene_heading":91,"speaker_label":"உஷா","text":"அந்தப் பாபத்தை போக்கிக்கொள்ள ஒரே வழிதான் இருக்கிறது.","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d004","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"என்ன உஷா?","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d005","canonical_scene":91,"source_scene_heading":91,"speaker_label":"உஷா","text":"பாண்டியனின் கொள்கைப்படி பாட்டாளிகளுக்கு சமத்துவம் வழங்குங்கள்.","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d006","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"பாண்டியன்!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d007","canonical_scene":91,"source_scene_heading":91,"speaker_label":"பாண்டியன்","text":"பல்லைக்காட்டி ஏமாற்ற நினைக்காதீர் மறுபடியும்! இம்முறை இரண்டிலொன்று. அநியாயமாக நீக்கப்பட்ட தொழிலாளருக்கு வேலைதரவேண்டும் உடனடியாக.","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d008","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"பாண்டியன்!","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d009","canonical_scene":91,"source_scene_heading":91,"speaker_label":"பாண்டியன்","text":"யாரோ ஒருவன் செய்த தவறுக்காக இத்தனை குடும்பங்கள் மீது பழிவாங்கிக்கொள்வதுதான் மனிதத் தன்மையா?","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d010","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"நான் அதை உணர்கிறேன் பாண்டியன்!","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d011","canonical_scene":91,"source_scene_heading":91,"speaker_label":"பாண்டியன்","text":"உணர்ந்தால் போதாது. உடனடியாக பரிகாரம் தேட வேண்டும்.","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d012","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"பாண்டியன்! தொழிலாளிகளை வேலைக்கு சேர்ப்பது மட்டுமல்ல. குற்றமற்ற உனக்கு நான் செய்த கொடுமைக்காக சிவசக்தி மில் நிர்வாகமே உன் கொள்கைப்படியும் உஷாவின் கொள்கைப்படியும் நடக்க அனுமதி தருகிறேன்.","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d013","canonical_scene":91,"source_scene_heading":91,"speaker_label":"பாண்டியன்","text":"அப்படியா ! வாழ்க உங்கள் புகழ்! வளர்க இந்தப் பண்பு தோழர்களே ! சிவசக்தி மில் இன்று முதல் ஜனசக்தி மில்லாக மாறும் ! சக்திக்கேற்ற உழைப்பு, தேவைக்கேற்ற வசதி. சமத்துவம் கொழிக்கும் - சமதர்மம் திகழும்- சமுதாய மறுமலர்ச்சி உருவாகும்!","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d014","canonical_scene":91,"source_scene_heading":91,"speaker_label":"தொழிலாளர்கள்","text":"பாண்டியன் வாழ்க! பாண்டியன் வாழ்க!","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d015","canonical_scene":91,"source_scene_heading":91,"speaker_label":"வேலைக்காரன்","text":"எஜமான் பாத்திங்களா?","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d016","canonical_scene":91,"source_scene_heading":91,"speaker_label":"முதலாளி","text":"ஆ என்ன !","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"},
  {"id":"tirumbippaar-s091-d017","canonical_scene":91,"source_scene_heading":91,"speaker_label":"பாண்டியன்","text":"ஆங்!","page_provenance":[{"pdf_page":110,"printed_page":102}],"source_scene_file":"scene-91.md"}
]
