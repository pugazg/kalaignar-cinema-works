[{"id":"tirumbippaar-s019-d001","canonical_scene":19,"source_scene_heading":19,"speaker_label":"பெண்","text":"பட்டணத்துக்கு ஏம்மா போறீங்க...","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d002","canonical_scene":19,"source_scene_heading":19,"speaker_label":"பூமாலை","text":"குமுதாவுக்கு பரிக்ஷை முடிவு ரெண்டுநாளில் தெரிந்துவிடும். அவளை அழைத்து வருவதற்காகப் போகிறேன்","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d003","canonical_scene":19,"source_scene_heading":19,"speaker_label":"குண்டுமணி","text":"(வந்தபடி) அம்மா! அம்மா! விஷயம் தெரியுமா! நம்ப சின்ன எஜமானுக்குப் பாத்த பெண்ணு ...","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d004","canonical_scene":19,"source_scene_heading":19,"speaker_label":"பூமாலை","text":"இன்னைக்கு கல்யாணம் அதுக்கு என்ன?","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d005","canonical_scene":19,"source_scene_heading":19,"speaker_label":"குண்டுமணி","text":"பெண்ணு நேத்தி ராத்திரி ஓடிட்டுதாம்!","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d006","canonical_scene":19,"source_scene_heading":19,"speaker_label":"பூமாலை","text":"அப்படியா! (யோசனை) ம்... பரந்தாமன் எங்கே ?","page_provenance":[{"pdf_page":27,"printed_page":19}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d007","canonical_scene":19,"source_scene_heading":19,"speaker_label":"குண்டுமணி","text":"அவரு...அவரு...ம்...அவருகூட மெட்ராஸ் போகணும்னு கருடன் கிட்ட சொல்லிக்கிட்டு இருந்தாரு.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-19.md"},{"id":"tirumbippaar-s019-d008","canonical_scene":19,"source_scene_heading":19,"speaker_label":"பூமாலை","text":"(சிந்தனை) ம்... சரி புறப்படு. ரயிலுக்கு நேரமாச்சு.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-19.md"}]
