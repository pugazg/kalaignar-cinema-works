[
  {"id":"tirumbippaar-s082-d001","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பையன்","text":"சார்! ஆசிரியர் சார்!","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d002","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"அப்படிக் கூப்பிடாதே! ஆசிரியன்—அறிவு நூல்கள் எழுதும் ஆசிரியன்—அழகான எழுத்தோவியன்—அவதிப்படும் பாட்டாளிகளின் தலைவன்—இந்தப் பலபலப்பான பட்டுத் திரைகளுக்குப் பின்னே மறைந்துகிடக்கும் பயங்கரமான ரகசியங்கள் உனக்குத் தெரியாது தம்பி! உனக்குத் தெரியாது.","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d003","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"பரந்தாமா!","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d004","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"பரந்தாமனல்ல—பயங்கர மிருகம், மிருகம்! மிருகமல்ல—மனிதனாகிவிட்டேன். இன்றுதான் மனிதனானேன்.","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d005","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"என்னப்பா சொல்றே பைத்தியம் பிடிச்சவன் மாதிரி.","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d006","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"பைத்தியம் பிடிப்பதா—பிடித்திருந்த பைத்தியம் இப்போதுதான் தெளிந்திருக்கிறது என் அக்காளால்.","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d007","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"சரிதான். அக்காள் உபதேசம் பண்ணிருக்காப்பல இருக்கு. உருப்பட்டாப்பலதான்.","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d008","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"அக்காளைப்பற்றி ஒன்றும் சொல்லாதே—அது என் தெய்வம். மூடிக்கிடந்த என் இருதயக்கதவுகளைத் திறந்து விட்ட தெய்வம்! என் இருண்ட பாதையிலே ஜோதி விளக்குக் காட்டிய மங்கையர் குல திலகம். இழிவுப் படுகுழியிலே விழப்போன எனக்கு இறுதி மூச்சு வழங்கி-பாரடா பண்பு கெட்ட விண்ணே. நீ நடந்துவந்த பாதையிலே உன் காலடி பட்டுக் கசங்கிப்போன மலர்முகவதிகள் எத்தனை பேர்—திக்கற்றவர்கள்—திசைமாறிப் போனவர்கள்—திண்டாடித் தெருவில் நிற்போர் அவர்களின் தொகை எவ்வளவு? துரோகியே திரும்பிப்பார் என்று ஆணையிட்டு என்னைத் திருத்திய தெய்வம் என் அன்புச் சகோதரி அவள்தான்டா எனக்கு கண்கண்ட தெய்வம். கருடா, நான் தீயவழியிலேதான் நடந்துவிட்டேன். நீயுந்தான், நீயுந்தான். நீயும் திருந்திவிடு—திரும்பிப்பார் என் தோழனே—திரும்பிப்பார்!","page_provenance":[{"pdf_page":99,"printed_page":91}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d009","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"அட போப்பா!","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d010","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"உன்னால் சுலபத்தில் திரும்பிப்பார்க்க முடியாது நீ ஒரு யானை.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d011","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"பரந்தாமா, உனக்கு என்னப்பா திடீர்னு இந்த கெட்ட புத்தி.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d012","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"நல்ல புத்தி வந்துவிட்டதடா நாசகாரா—இனியும் என்னை உன் வலையில் தள்ளாதே. பரந்தாமன் பாதை மாறி விட்டது. அவன் செய்த அக்கிரமங்களுக்கு சாந்தி தேடப் போகிறான். அக்கா! உங்கள் தம்பி உடனடியாக ஒரு நல்ல காரியத்தில் பிரவேசிக்கப் போகிறான். பாண்டியன் குமுதா அவர்களை ஒன்று சேர்த்து மகிழப் போகிறான். பாமாவிடம் மன்னிப்புக் கேட்கப் போகிறான்.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d013","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"பரந்தாமா!","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d014","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"வருகிறேன். என்னைக் கூப்பிடாதே.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d015","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பையன்","text":"நானும் வர்றேங்க உங்களோட.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d016","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பரந்தாமன்","text":"வா தம்பி வா. இங்கிருந்தால் நீயும் கெட்டு விடுவாய்.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d017","canonical_scene":82,"source_scene_heading":82,"speaker_label":"கருடன்","text":"ஏய் என்னடா?","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"},
  {"id":"tirumbippaar-s082-d018","canonical_scene":82,"source_scene_heading":82,"speaker_label":"பையன்","text":"திரும்பிப்பார்.","page_provenance":[{"pdf_page":100,"printed_page":92}],"source_scene_file":"scene-82.md"}
