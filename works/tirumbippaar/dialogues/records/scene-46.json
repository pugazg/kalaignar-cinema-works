[
  {"id":"tirumbippaar-s046-d001","canonical_scene":46,"source_scene_heading":46,"speaker_label":"பரந்தாமன்","text":"(கருடனிடம்) கூட்டத்தில் அவ்வளவு பேசினான். கேட்டுக்கொண்டு வந்தாய்...ம்...","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-46.md"},
  {"id":"tirumbippaar-s046-d002","canonical_scene":46,"source_scene_heading":46,"speaker_label":"கருடன்","text":"நான் என்னப்பா செய்றது. தனி மனுஷன்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-46.md"},
  {"id":"tirumbippaar-s046-d003","canonical_scene":46,"source_scene_heading":46,"speaker_label":"பரந்தாமன்","text":"படாடோபம்,பத்திரிகை விளம்பரம், பரந்தாமனுக்கு ஜே...நேரிடையாகவே தாக்கியிருக்கிறான்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-46.md"},
  {"id":"tirumbippaar-s046-d004","canonical_scene":46,"source_scene_heading":46,"speaker_label":"கருடன்","text":"தாக்கினாலும் பரவாயில்லை. அந்த ஐயாயிரம் விஷயத்தையும் சொல்லிவிட்டான்","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-46.md"},
  {"id":"tirumbippaar-s046-d005","canonical_scene":46,"source_scene_heading":46,"speaker_label":"பரந்தாமன்","text":"பாண்டியன்! என் வீட்டுக்குள்ளேயே எதிரி! உயிரோடு உலவக்கூடாது அவன்.","page_provenance":[{"pdf_page":60,"printed_page":52}],"source_scene_file":"scene-46.md"},
  {"id":"tirumbippaar-s046-d006","canonical_scene":46,"source_scene_heading":46,"speaker_label":"கருடன்","text":"பிணமா உலவினால்கூட உன்பெருமைக்கு ஆபத்துதான்.","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-46.md"},
  {"id":"tirumbippaar-s046-d007","canonical_scene":46,"source_scene_heading":46,"speaker_label":"பரந்தாமன்","text":"முடிவு கட்டுகிறேன். இன்றைக்கே முடிவு கட்டுகிறேன்.","page_provenance":[{"pdf_page":61,"printed_page":53}],"source_scene_file":"scene-46.md"}
]
