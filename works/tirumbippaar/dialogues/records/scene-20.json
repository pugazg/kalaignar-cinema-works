[{"id":"tirumbippaar-s020-d001","canonical_scene":20,"source_scene_heading":20,"speaker_label":"குண்டுமணி","text":"அம்மா! அப்ப நான் அடுத்த வண்டீல ஏறிக்கிறேன்.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d002","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"சாப்பிடுங்கள் ...","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d003","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"இல்லை வேண்டாம்.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d004","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"கொஞ்சம் எடுத்துக் கொள்ளுங்கள்.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d005","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"ரொம்ப நன்றி! நீங்கள் சாப்பிடுங்கள்!....","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d006","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"நீங்கள் எந்த ஊருக்குப் போகிறீர்கள்.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d007","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"நானா எனக்கே தெரியவில்லை.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d008","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"மிகவும் மனவேதனை அடைந்திருக்கிறீர்கள். இதெல்லாம் உலகத்தில் சகஜம். பொருட்படுத்தக் கூடாது.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d009","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"என்னைத் தெரியுமா உங்களுக்கு!..","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d010","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"தெரியும்... இதோ. (புத்தகத்தைக் காட்டுதல்)","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d011","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"(தலையைத் தாழ்த்தியபடி) வெட்கக் கேடு அய்யோ...","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d012","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"வருத்தப்படாதீர்கள்.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d013","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"என் கதை முழுதும் புரியுமா உங்களுக்கு.","page_provenance":[{"pdf_page":28,"printed_page":20}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d014","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"(சஞ்சலமுடன்) புரியும். இன்று மணமகனாய் இருக்க வேண்டிய நீங்கள்........","page_provenance":[{"pdf_page":29,"printed_page":21}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d015","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"போதும் உலகத்தின் முகத்திலேயே நான் விழிக்கக் கூடாது!","page_provenance":[{"pdf_page":29,"printed_page":21}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d016","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"நீங்கள் ஒரு தவறும் செய்யவில்லையே.","page_provenance":[{"pdf_page":29,"printed_page":21}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d017","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"நானா தவறு செய்யவில்லை. மானம் மரியாதைக்குக் கட்டுப்பட்டு வாழ்ந்த நான், இன்று அவமானச் சின்னமாக மாறிவிட்டேன், என் அறிவீனத்தால், கண்டவர் காரி உமிழ, காணாதவர் கேலி பேச, கண்ணிருந்தும் குருடனாய், காதிருந்தும் செவிடனாய் கள்ளி யொருத்தியைப் பற்றி தீர விசாரிக்காமல் கல்யாண மாப்பிள்ளையாக வேஷங் கட்டிக்கொண்டு ஓடி வந்தேனே முட்டாள். நானா தவறு செய்யவில்லை.","page_provenance":[{"pdf_page":29,"printed_page":21}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d018","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பூமாலை","text":"சும்மாயிருங்கள். சென்னைக்கு வந்து எங்கள் வீட்டில் கொஞ்சம் ஓய்வு எடுத்துக் கொள்ளலாம்.","page_provenance":[{"pdf_page":29,"printed_page":21}],"source_scene_file":"scene-20.md"},{"id":"tirumbippaar-s020-d019","canonical_scene":20,"source_scene_heading":20,"speaker_label":"பாண்டியன்","text":"ஓய்வு. இந்த வேதனையை விரட்ட எந்த ஓய்வாலும் முடியாது.","page_provenance":[{"pdf_page":29,"printed_page":21}],"source_scene_file":"scene-20.md"}]
