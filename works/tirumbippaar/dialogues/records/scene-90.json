[
  {"id":"tirumbippaar-s090-d001","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"குமுதா! குமுதா!","page_provenance":[{"pdf_page":106,"printed_page":98}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d002","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பாமா","text":"அப்படித்தான் வெடித்துச் சிதறப்போகிறது உன் வாழ்வும்!","page_provenance":[{"pdf_page":106,"printed_page":98}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d003","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"பாமா! (என்று திகிலுடன் எழுகிறான்)","page_provenance":[{"pdf_page":106,"printed_page":98}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d004","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பாமா","text":"பாவி! இந்த முறை நீ தப்பமுடியாது! நீ செய்த அக்கிரமங்களுக்கு பிராயச்சித்தம் செய்யப்போகிறேன்.","page_provenance":[{"pdf_page":106,"printed_page":98}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d005","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"பாமா! என்னை உணர்ந்துகொள்! அவசரப்பட்டு விடாதே! துடிக்கத் துடிக்க பாமாவை விட்டுவிட்டு ஓடிய துரோகி பரந்தாமனல்ல! துன்மார்க்க செயல்களுக்கு சமாதி கட்டிவிட்டு தூய்மையின் தூதுவனாகவே மாறிவிட்ட புதுப் பரந்தாமன்!","page_provenance":[{"pdf_page":106,"printed_page":98}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d006","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பாமா","text":"ஆமாம்! அதனால்தான் குமுதாவுக்கு விலாசம் வந்திருக்கிறாய்.","page_provenance":[{"pdf_page":106,"printed_page":98}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d007","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"இல்ல பாமா இல்ல. அவளிடம் மன்னிப்புக் கேட்க வந்தேன். எதிர்பாராதவிதமாக உன்னையும் கண்டேன். பாமா நீயும் நடந்தவைகளை மறந்துவிடு! மீண்டும் நம் வாழ்க்கையைப் புதுமை செய்வோம்.","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d008","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பாமா","text":"வாழ்வு எனக்கா? நான் முறிந்துபோன பால்! விஷங் கலந்த தேன்! எனக்கா வாழ்வு! சதிகாரா! போதுமடா உன் உபதேசம்! போதும். (ரிவால்வரை நீட்டி)","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d009","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"பாமா!","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d010","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பாமா","text":"உலகத்திலே இருக்கிற என்போன்ற பேதைகளைக் காப்பாற்றுவதற்காக உன்னைக் கொல்லுகிறேன்!","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d011","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"பாமா! (தடுக்கிறான்—இருவருடைய போராட்டத்தில்) பாமா! நான் சொல்வதைக் கேள்! என்னைக் கொல்லாதே! நான் உண்மையிலேயே திருந்திவிட்டேன்...","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d012","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பாமா","text":"பாவி! விடு என்னை!","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d013","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"ஆ!....(கவலை)","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d014","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"ஆ!....(அலறல்)","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d015","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"தொலைந்துபோ துஷ்டனே! இனிமேலாவது உலகம் நிம்மதியாயிருக்கட்டும்! (கீழே கிடப்பவளிடம்) குமுதா! குமுதா! (அருகே போய் பார்க்கிறாள்) ஆ! பாமா!","page_provenance":[{"pdf_page":107,"printed_page":99}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d016","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"அது குமுதா இல்லக்கா! பாமா! (விம்மலுடன்) என் பாமா! அவளே அவளைக் கொன்றுகொண்டாள்!","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d017","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"ஆமாம்! என்னைக்கு உன்னை முதன்முதலாகப் பார்த்தாளோ அன்றைக்கே அவள் தன்னைத்தானே கொல்ல ஆரம்பித்துவிட்டாள்!","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d018","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"அக்கா! என்னை இன்னும் தவறாக நினைக்கிறீர்கள் அக்கா! தகாத செயல் புரியும் தம்பியை அல்ல தாங்கள் கொன்றது! தணலில் புடம்போட்டு எடுக்கப்பட்ட தங்கத்தை! கோர விளையாட்டுக்களின் குகையாயிருந்த பரந்தாமனை முன்பே கொன்றுவிட்டார்கள் அக்கா! இப்போது நீங்கள் கொன்றது உங்களால் புதிதாக சிருஷ்டிக்கப்பட்ட உத்தமன்! உங்களுக்கு யார் தம்பியாய் இருக்க வேண்டுமோ அந்தத் தம்பியை கொன்றுவிட்டார்களே அக்கா. குமுதாவிடத்திலே மன்னிப்புக்கேட்க வந்தேன் அக்கா. பழிவாங்க எண்ணியிருந்த பாமா....பாமா...","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d019","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"தம்பி...","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d020","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"இதோ பாருங்கக்கா! குமுதாவின் குழந்தைக்காக நான் வாங்கி வந்த விளையாட்டுச் சாமான்கள்!","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d021","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"பரந்தாமா! அவசரப்பட்டு அறிந்துவிட்டேன்—என்னை மன்னித்துக்கொள்ளடா என் செல்வமே...","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d022","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"நீங்கள் குற்றமற்றவர். நான் சாகவேண்டியவன் அக்கா! எனக்குத் தேவையான தண்டனைதான். எனக்கு மட்டுமல்ல என்னைப்போலுள்ள எல்லோருக்கும். என்னைத் திருத்திய தெய்வமே, எங்கே திரும்பிப்பார் என்று சுட்டிக் காட்டிய அந்தப் பொற்கரத்தை இப்படிக் கொடுங்கள்.","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d023","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"சுட்டிக்காட்டிய கரமல்ல. சகோதரனை சுட்டுத் தள்ளிய கரம்...சுட்டுத்தள்ளிய கரம்.","page_provenance":[{"pdf_page":108,"printed_page":100}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d024","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"இல்ல அக்கா! இல்ல. கொடுங்கள் என்னை வளர்த்த அந்த அன்புக் கரங்களை...ஆசைக் கரங்களை... அக்கா....விடை கொடுங்கள்!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d025","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"பரந்தாமா!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d026","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"நீங்கள் ஓடிவிடுங்கள். போலீசாரிடமிருந்து தப்பி விடுங்கள் அக்கா.","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d027","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"வேண்டாம். நீயே போனபிறகு எனக்கு எதற்கடா வாழ்வு.","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d028","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"அக்கா! அக்கா!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d029","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"போலீஸ்! போலீஸ்!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d030","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பரந்தாமன்","text":"அக்கா! அக்கா!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"},
  {"id":"tirumbippaar-s090-d031","canonical_scene":90,"source_scene_heading":90,"speaker_label":"பூமால்","text":"பரந்தாமா!","page_provenance":[{"pdf_page":109,"printed_page":101}],"source_scene_file":"scene-90.md"}
]
