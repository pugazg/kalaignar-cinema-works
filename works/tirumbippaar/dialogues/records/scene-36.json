[{"id":"tirumbippaar-s036-d001","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"அழாதே குமுதா! (கலங்கியபடி )","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d002","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"சின்னம்மா! ! ஏன் சின்னம்மா என்னை அடிச்சே! என்மேல் ஒரு தவறும் இல்லியே சின்னம்மா !","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d003","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"பரந்தாமனுக்கு யாரு ! நம்மைப் போலத்தானே அவனும் ! அவனைப்போயி நீ அடிக்கலாமா?","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d004","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"சின்னம்மா பாண்டியனை மட்டும் மாமா அப்படி நடத்தலாமா?","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d005","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"அதைக் கேட்க நான் இருக்கிறேனே! அவனை எனக்கு நேராகவே","page_provenance":[{"pdf_page":44,"printed_page":36}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d006","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"உனக்கு உன் தம்பி பெரிசு!","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d007","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"உனக்கு ?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d008","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"எனக்கு என் காதலன் பெரிசு !","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d009","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"(திடுக்கிட்டு) காதலனா?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d010","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"ஆமாம்! பாண்டியன் என் காதலன்!","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d011","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"உன் காதலன்?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d012","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"நான் காதலிக்கக் கூடாதா?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d013","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"அவர் சம்மதம் கொடுத்துவிட்டாரா?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d014","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"இருவர் உள்ளமும் ஒன்றுபட்டுவிட்டது !","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d015","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"சே ! எவ்வளவு பெரிய தவறு செய்துவிட்டேன்! குமுதா","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d016","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"என்ன தவறு செய்துவிட்டாய் சின்னம்மா ? அவரை அழைத்து வந்தாயே அது தவறா? அல்லது எனக்கு அறிமுகப்படுத்தினாயே அது தவறா?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d017","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"அழைத்து வந்ததிலும் தவறில்லை. அறிமுகப்படுத்தியதிலும் தவறில்லை.","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d018","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"பிறகென்ன நான் அன்பு காட்டியது தவறா?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d019","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"அதுவுமில்லை குமுதா! கொடி படரும் கொம்பிலே செடி படர முயன்றதுதான் தவறு.","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d020","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"விளங்கவில்லையே ....","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d021","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"விளங்க வேண்டாம் உனக்கு, விளங்கவே வேண்டாம்.","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d022","canonical_scene":36,"source_scene_heading":36,"speaker_label":"குமுதா","text":"சின்னம்மா! எங்கள் காதலை நீங்கள் அனுமதிக்கவில்லையா?","page_provenance":[{"pdf_page":45,"printed_page":37}],"source_scene_file":"scene-36.md"},{"id":"tirumbippaar-s036-d023","canonical_scene":36,"source_scene_heading":36,"speaker_label":"பூமாலை","text":"அனுமதிக்கிறேன் கண்ணே! இப்போதே உங்களிருவரையும் வாழ்த்துகிறேன்....பாண்டியன்! பாண்டியன்!","page_provenance":[{"pdf_page":46,"printed_page":38}],"source_scene_file":"scene-36.md"}]
