[{"id":"tirumbippaar-s006-d001","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"இது என்ன வேல...","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d002","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"குடத்திலே விழுந்த சுருக்கு தவறி என் கழுத்திலே விழுந்தது,","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d003","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பரந்தாமன்","text":"கழுத்திலேயுந்தான் சுருக்குப் போட்டுப் போறேனே........","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d004","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"என்னது......","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d005","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பரந்தாமன்","text":"பயப்படாதே! இந்தக் கயிற்றால் அல்ல. உன் மரகதமணிக் கழுத்திலே மஞ்சள் தோய்ந்த மாங்கல்யக் கயிற்றால். (பாமா வெட்கம்) பாமா! சொன்னது சரிதானே! அட சொல்லு...... (பாமா புன்னகை) ஆகா! புயலை அடக்கும் தென்றல், எரிமலையை அணைக்கின்ற பனிக்கட்டி, கேள்விப்பட்டதே இல்ல நான்!... ஆனால் அந்தப் புதுமையான சக்தியை உன்னுடைய ஒரு புன்னகையிலேயே காணமுடிகிறது.","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d006","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"இதெல்லாம் வெறும் வர்ணனையாகப் போய்விடாதே?","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d007","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பரந்தாமன்","text":"ஏன் சந்தேகம்! (தோளில் கை வைத்து) நேற்று தானே அறிமுகமானேன். இன்று தொட்டு விளையாடுகிறேன், நாளை ஓடிவிடுவேனு என்று அஞ்சுகிறாயா? கொஞ்ச மொழியாலே! கூர்ந்து கவனிக்கவில்லையா நீ, இல்லற ஜோதியிலே என்ன எழுதியிருக்கிறேனென்று.","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d008","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"எழுதியபடியே நடப்பீர்களா?","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d009","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பரந்தாமன்","text":"(அலட்சியமாய்) பெண்களே இப்படித்தான் சந்தேகப் பிராணிகள்.","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d010","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"இல்ல...யில்ல... (அவன் முகத்தைத் திருப்பி) இங்கு பாருங்கள்...","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d011","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பரந்தாமன்","text":"பாமா! கண்ணே! (நெருங்கல்)","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d012","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"ஊஹூம்...எல்லாம் திருமணம் ஆனபிறகு...","page_provenance":[{"pdf_page":16,"printed_page":8}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d013","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பரந்தாமன்","text":"திருமணந்தான் ஆகப்போகிறதே!","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-06.md"},{"id":"tirumbippaar-s006-d014","canonical_scene":6,"source_scene_heading":6,"speaker_label":"பாமா","text":"திருமணம். நான் பாக்கியசாலி.","page_provenance":[{"pdf_page":17,"printed_page":9}],"source_scene_file":"scene-06.md"}]