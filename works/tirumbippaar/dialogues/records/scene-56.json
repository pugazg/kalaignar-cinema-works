[
  {"id":"tirumbippaar-s056-d001","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"உஷா ! இரவு நேரங்களில் வெளியில் போகாதே என்று சொன்னேனே ! கேட்டாயா! ஏழைகளுக்கு உதவி செய்கிறேன் என்று நீ போகிறாய்","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d002","canonical_scene":56,"source_scene_heading":56,"speaker_label":"உஷா","text":"போனதைப்பற்றி ஏனப்பா பேசுகிறீர்கள். போலீஸார் என்ன சொன்னார்கள்.","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d003","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"என்ன சொன்னார்கள். யாரும் அகப்படவில்லையாம்!","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d004","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"யார்?","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d005","canonical_scene":56,"source_scene_heading":56,"speaker_label":"பரந்தாமன்","text":"(உட்கார்ந்துகொண்டே) எல்லாம் கேள்விப்பட்டேன். ஓ... இதுதான் உஷாவோ ! (உஷாவிடம்) உங்களுக்கேற்பட்ட ஆபத்தை ஆண்டவன்தான் தடுத்திருக்கிறான்.","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d006","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"அதிருக்கட்டும் ஆள் அகப்பட்டுவிட்டான் என்றீரே!","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d007","canonical_scene":56,"source_scene_heading":56,"speaker_label":"பரந்தாமன்","text":"ஆமாம். தொழிலாளர்களைத் தூண்டிவிடும் பலாத்காரவாதிகளின் வேலையிது !","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d008","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"ஆங்... பலாத்காரவாதி!","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d009","canonical_scene":56,"source_scene_heading":56,"speaker_label":"பரந்தாமன்","text":"அவன்தான் பாண்டியன்.","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d010","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"பாண்டியனா?","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d011","canonical_scene":56,"source_scene_heading":56,"speaker_label":"உஷா","text":"பாண்டியனா?","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d012","canonical_scene":56,"source_scene_heading":56,"speaker_label":"பரந்தாமன்","text":"அவனேதான்!அராஜகத்திற்கு ஆரம்பவிழா நடத்தியிருக்கிறான். விரைவில் ஆலைக்கே தீ வைப்பான். உங்களை அழிப்பதற்கே ஒரு சிறு கும்பலை சேர்த்து வைத்திருக்கிறான் அவன்.","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d013","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"உம் ! அவனைப் பிடிக்க ஆதாரம்!","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d014","canonical_scene":56,"source_scene_heading":56,"speaker_label":"பரந்தாமன்","text":"ஆதாரம் ! கொள்ளையடிக்கப்பட்ட வைர நெக்லஸ் சென்னையில் எங்கே யிருக்குமென்று எண்ணுகிறீர்கள். அவன் வீட்டில்தானிருக்க வேண்டும் உடனே போலீஸாருக்கு தகவல் கொடுத்து அவன் வீட்டை சோதனை போட வேண்டும். இதை அவசரமாகச் செய்ய வேண்டும். இப்போதே Phone செய்யுங்கள்!","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"},
  {"id":"tirumbippaar-s056-d015","canonical_scene":56,"source_scene_heading":56,"speaker_label":"முதலாளி","text":"சபாஸ்! சரியான யோசனை ! ( போனை எடுத்துப் பேசுகிறார்) ஹலோ! போலீஸ் ஸ்டேஷன் !","page_provenance":[{"pdf_page":71,"printed_page":63}],"source_scene_file":"scene-56.md"}
]
