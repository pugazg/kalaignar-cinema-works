[{"id":"tirumbippaar-s005-d001","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"(ஆபீஸ் பையனிடம்) பையா...உம்...பார்சலுக்கு நேரமாச்சு புறப்படு...புறப்படு. பாக்கி நாளைக்கு அனுப்பலாம்.","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d002","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"யாரு? உள்ளே வாங்க.","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d003","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"யாரு...எங்கேயோ பார்த்தமாதிரி...(சந்தேகமாய்)","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d004","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பாண்டியன்","text":"(கோபமாய்) மறந்திருப்பீர். நான்தான் பாண்டியன். ஞாபகமிருக்கிறதா? (தன் கையிலுள்ள நூலைக் காட்டி) இந்தப் புத்தகத்தின் உண்மையான ஆசிரியர்......","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d005","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"சே சே...இதற்கு ஆசிரியர் பரந்தாமன் என்று அட்டையிலே போட்டிருக்கிறதே!","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d006","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பாண்டியன்","text":"அச்சு யந்திரத்திற்கு என்ன தெரியும் நீங்கள் செய்யும் அநியாயம். சிந்தித்து சிந்தித்து செந்நீரையெல்லாம் வியர்வையாகி சிரமத்தை சுமந்து பலநாள் பாடு பட்டு எழுதிய எனக்கல்லவா தெரியும் இது யார் எழுதிய தென்று.","page_provenance":[{"pdf_page":13,"printed_page":5}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d007","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"இல்ல பரந்தாமன்.","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d008","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பாண்டியன்","text":"யாரது பரந்தாமன்?","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d009","canonical_scene":5,"source_scene_heading":5,"speaker_label":"குரு","text":"பக்தா!","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d010","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"ஏன் ஆத்திரப்படுகிறாய்? பதறுகிறாய்—பரந்தாமன் அழைத்த விஷயமென்ன? யார் இவன்?","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d011","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"பாண்டியனும்...","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d012","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"யார் அவன்! பாண்டியன்! தலையாலங்கானத்து செருவென்ற பாண்டியனு? ஆரியப்படை கடந்த நெடுஞ்செழியனு? போர்க்கருவி எதுவுமின்றி புகுந்த பாண்டியன் நீ யாரப்பா?","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d013","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பாண்டியன்","text":"நானு? எழுத்துத் திருடன் சந்திக்கவந்த இல்லற ஜோதியின் உண்மை ஆசிரியர் பாண்டியன்...","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d014","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"ஹம்...ஹம்...ஹம்...இல்லற ஜோதிக்கு நீ ஆசிரியனு? புத்தகத்திற்கா?...சபாஷ்!...சபாஷ்!...","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d015","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பாண்டியன்","text":"அச்சியற்றவனாக என்னிடத்திலே வாங்கி அயோக்கியத்தனம் செய்துவிட்டு, சிரித்து மறைக்கிறீர்களா; திருடர்களே. எழுத்தைக் சுவறாடிப் பிழைப்பதைக் காட்டிலும், கழுத்திலே ஒரு கயிறு மாட்டிக்கொள்ளலாமே.","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d016","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"மரியாதையாகப் போகமாட்டாய் நீ!...","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d017","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பாண்டியன்","text":"சீ...பேசாதே! (பரந்தாமனின் கன்னத்தில் அறை விழ) மரியாதை வேறு மானங்கெட்டவர்களுக்கு! இப்படி எத்தனை பேர் கிளம்பியிருக்கிறீர்கள்? ஊரான் எழுத்தைச் சுரண்டிச் சாப்பிட.","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d018","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பையன்","text":"அது பலபேரு கிளம்பியிருக்காங்க...போய்யா,","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d019","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"(பையனிடம்) சீ முந்திரிக்கொட்டை...","page_provenance":[{"pdf_page":14,"printed_page":6}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d020","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"ஸ்...சும்மா இரு! அப்புறம் தம்பி எண்ணனும்...நல்ல வேல செஞ்ச...","page_provenance":[{"pdf_page":15,"printed_page":7}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d021","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"விடக்கூடாது...","page_provenance":[{"pdf_page":15,"printed_page":7}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d022","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"(கம்பீரமாய்) ஆமாம் விடக்கூடாது!","page_provenance":[{"pdf_page":15,"printed_page":7}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d023","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"ஏய்...நான் அடிபட்டதை வெளியில் விடக்கூடாது!","page_provenance":[{"pdf_page":15,"printed_page":7}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d024","canonical_scene":5,"source_scene_heading":5,"speaker_label":"கருடன்","text":"அது சரி...நான் அப்பவே சொன்னேன். பிறத்தியான் எழுதினதை உன் பேரால் போட்டவேண்டாமென்று—இப்ப பஞ்சண புத்தகம் எழுதியிருக்கே! அதுக்கு இருக்கிற மதிப்பு...இல்லற ஜோதிக்கு இருக்குதா? என் வீண் வம்பு அனாவசியமா. அடாடா...பஞ்சணையைப்பத்தி லெட்டர்கள் வந்திருக்கு...யார் அந்தத் துறவி என்பவர். அவரைப் பார்க்க முடியுமா? போட்டோ இருக்கா? அவர் வரகவியா, சுய கவியா? அவர் கையிலே பேனா இருக்கிறதா, மண்டையின் வில்லே இருக்கிறதா? பேனாவிலே மை இருக்கிறதா, அல்லது கருப்பஞ்சு சாறே இருக்கிறதா? இப்படியெல்லாம் உன்னை வர்ணிக்கிறார்கள். இல்லற ஜோதியை அப்படி வர்ணிக்கவும் இல்ல. அது நிறைய விக்கவும் இல்ல.","page_provenance":[{"pdf_page":15,"printed_page":7}],"source_scene_file":"scene-05.md"},{"id":"tirumbippaar-s005-d025","canonical_scene":5,"source_scene_heading":5,"speaker_label":"பரந்தாமன்","text":"வியாபாரமாகாவிட்டாலும், இல்லற ஜோதி எனக்கு ஒரு இன்பமான ஜோதியை அளித்திருக்கிறது.","page_provenance":[{"pdf_page":15,"printed_page":7}],"source_scene_file":"scene-05.md"}]