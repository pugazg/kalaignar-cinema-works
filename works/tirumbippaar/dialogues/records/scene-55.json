[
  {"id":"tirumbippaar-s055-d001","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பரந்தாமன்","text":"எங்கக்கா பயணம்?","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d002","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பூமால்","text":"மதராஸுக்கு....","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d003","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பரந்தாமன்","text":"என்ன திடீர்னு மதராஸ்!","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d004","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பூமால்","text":"என்ன? குமுதாவைப் பார்க்கப் போறேன். போகக் கூடாதா?","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d005","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பரந்தாமன்","text":"கூடாதுன்னு சொல்லுகிறேன்....ம்....ஆமாம் பாண்டியன் மெட்ராஸில்தானே!...","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d006","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பூமால்","text":"ஆமாம். நீ ஏன் அதெல்லாம் கேக்கிறே? உனக்குத்தான் ஊரார் உறவினர், நல்லவர் கெட்டவர் எதுவும் கிடையாதே.","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d007","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பரந்தாமன்","text":"ஏதோ ஆத்திரத்தில் செய்துவிட்டேனக்கா அப்படி.","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d008","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பூமால்","text":"நல்ல ஆத்திரம், கொஞ்சம் தவறியிருந்தால் குமுதா விதவையாகி ஆகியிருப்பாள்.","page_provenance":[{"pdf_page":69,"printed_page":61}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d009","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பரந்தாமன்","text":"நான் ஏதாவது தவறு செய்திருந்தால் மன்னித்து விடக்கா! (பூமால் பார்த்தல்) நான் பாண்டியனை சுட முயன்றது தவறுதான். என்ன ஒருபோதும் காட்டிக் கொடுக்க மாட்டாளே...","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d010","canonical_scene":55,"source_scene_heading":55,"speaker_label":"வேலைக்காரி","text":"நேரம் ஆச்சம்மா.","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d011","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பூமால்","text":"(பரந்தாமனிடம்) நான் வரட்டுமா.","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-55.md"},
  {"id":"tirumbippaar-s055-d012","canonical_scene":55,"source_scene_heading":55,"speaker_label":"பரந்தாமன்","text":"சரிக்கா! எல்லாரையும் விசாரிச்சேன்னு சொல்லு! பாண்டியனுக்கும் குமுதாவுக்கும் என் பரிபூரண ஆசீர்வாதங்கள் சொல்லு!","page_provenance":[{"pdf_page":70,"printed_page":62}],"source_scene_file":"scene-55.md"}
]
