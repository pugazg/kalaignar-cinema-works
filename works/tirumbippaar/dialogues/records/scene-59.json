[{"id":"tirumbippaar-s059-d001","canonical_scene":59,"source_scene_heading":59,"speaker_label":"குமுதா","text":"உங்களை விடுதலை செய்ய எவ்வளவோ முயற்சித்தேன். முடியவில்லை பாண்டியன்....","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d002","canonical_scene":59,"source_scene_heading":59,"speaker_label":"பாண்டியன்","text":"வருந்தாதே குமுதா ! எனக்கும் விடுதலையில்லாமலா போய்விடப் போகிறது.","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d003","canonical_scene":59,"source_scene_heading":59,"speaker_label":"குமுதா","text":"பாண்டியன் நான் திக்கற்றவள்.நீங்கள் வரும்வரை எனக்கு யார் கதி","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d004","canonical_scene":59,"source_scene_heading":59,"speaker_label":"பாண்டியன்","text":"நீயேதான் கதி ! என்னை வெளியூர் ஜெயிலுக்குக் கொண்டு போகிறார்களாம். பரந்தாமன் கண்களில் பட்டுவிடாதே.ஜாக்ரதையா இரு.","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d005","canonical_scene":59,"source_scene_heading":59,"speaker_label":"குமுதா","text":"பாண்டியன் ! உங்களைப் பிரிந்து எப்படி இருப்பேன்.","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d006","canonical_scene":59,"source_scene_heading":59,"speaker_label":"பாண்டியன்","text":"அழாதே குமுதா! அழாதே !... உன்னை சிரித்த முகத்தோடு என் சிந்தை குளிர ஒருமுறை பார்க்கிறேன். எங்கே சிரிப்பு காட்டு!","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d007","canonical_scene":59,"source_scene_heading":59,"speaker_label":"குமுதா","text":"சிரிக்கவா ? சிறைச்சாலையிலே என் ஜீவனை வாடவிட்டு நான் சிரிக்கவா?","page_provenance":[{"pdf_page":76,"printed_page":68}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d008","canonical_scene":59,"source_scene_heading":59,"speaker_label":"பாண்டியன்","text":"அழாதே குமுதா! மூன்று வருடங்கள் விரைவில் ஓடிவிடும். நான் திரும்பி வந்து உன்னை சந்திக்கும் போது உன் மடியிலிருந்து அப்பா என அழைக்கும் மழலைச் செல்வத்தை வாரி அணைத்துக்கொள்வேன்.","page_provenance":[{"pdf_page":77,"printed_page":69}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d009","canonical_scene":59,"source_scene_heading":59,"speaker_label":"குமுதா","text":"(பதறி) பாண்டியன். பாண்டியன்.","page_provenance":[{"pdf_page":77,"printed_page":69}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d010","canonical_scene":59,"source_scene_heading":59,"speaker_label":"வார்டர்","text":"புறப்படம்மா ! டயம் ஆச்சு.","page_provenance":[{"pdf_page":77,"printed_page":69}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d011","canonical_scene":59,"source_scene_heading":59,"speaker_label":"குமுதா","text":"பாண்டியன். பாண்டியன்.","page_provenance":[{"pdf_page":77,"printed_page":69}],"source_scene_file":"scene-59.md"},{"id":"tirumbippaar-s059-d012","canonical_scene":59,"source_scene_heading":59,"speaker_label":"பாண்டியன்","text":"போய்வா குமுதா!","page_provenance":[{"pdf_page":77,"printed_page":69}],"source_scene_file":"scene-59.md"}]
