[{"id":"tirumbippaar-s013-d001","canonical_scene":13,"source_scene_heading":13,"speaker_label":"பரந்தாமன்","text":"(வாழு புத்தகத்தைக் காட்டியபடி)கருடா! புத்தகம் எப்படி?","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d002","canonical_scene":13,"source_scene_heading":13,"speaker_label":"கருடன்","text":"ரொம்ப பிரமாதம்.","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d003","canonical_scene":13,"source_scene_heading":13,"speaker_label":"பையன்","text":"இந்த புஸ்தகத்திலே ரொம்ப நல்லாயிருக்கிறது....","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d004","canonical_scene":13,"source_scene_heading":13,"speaker_label":"கருடன்","text":"என்னடா?","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d005","canonical_scene":13,"source_scene_heading":13,"speaker_label":"பையன்","text":"மேல் அட்டைங்க.","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d006","canonical_scene":13,"source_scene_heading":13,"speaker_label":"கருடன்","text":"சீ | அட்டை மாத்திரந்தான் நல்லா இருக்கா? அச்சு கூடத்தான் மணி மணியா இருக்கு.","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d007","canonical_scene":13,"source_scene_heading":13,"speaker_label":"பரந்தாமன்","text":"கருடா / அச்சு எப்படி, அட்டை எப்படி என்று விமர்சனம் கேட்கவில்லை : அறிவுரைகள் தந்திருக்கிறேனே, அது எப்படி என்றுதான்.","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"},{"id":"tirumbippaar-s013-d008","canonical_scene":13,"source_scene_heading":13,"speaker_label":"கருடன்","text":"ஆஹா / அதைக் கேக்கணுமா ...","page_provenance":[{"pdf_page":21,"printed_page":13}],"source_scene_file":"scene-13.md"}]