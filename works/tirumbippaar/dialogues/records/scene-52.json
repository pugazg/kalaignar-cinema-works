[
  {"id":"tirumbippaar-s052-d001","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"சாப்பிட்டுக் கொண்டே பரந்தாமன் போல ஒரு தாயானவன் கும்மாளம் பார்க்க முடியாது. நல்ல ஒழுக்கம், நேர்மையான நடத்தை இவைகளுக்கு செல்லாம் ஒரே ஒரு ஏக எடுத்துக்காட்டு நமது பரந்தாமன்தான்.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d002","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி ஒருவன்","text":"நீங்க புகழ்ந்து பேசுறீங்க. உங்க புள்ள தான் எழுதியிருக்க “போலித் தலைவன்” என்று.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d003","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"புள்ள எழுதுவான் புத்தி கெட்டவன். அவன் எனக்குப் புள்ளையா, துரோகி.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d004","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"சும்மா இருங்க. பாண்டியன் பொய் படுத்தறிவு வழி விளக்கிப் போறான் உண்மையைத் தொண்டன்.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d005","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"அவனு...துரோகி!","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d006","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"“போலித் தலைவன்னு” சினிமாகூட எடுக்கப்போறங்கலாம்.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d007","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"எடுப்பாங்க எடுப்பாங்க! முதல்ல இந்த சினிமாவே ஒழியணும். சீற்றிருக்கும் மண்ணுங்கட்டி, வீட்டுக்கு திருமணம். பாவம் விவாகம் கூடாது. வயசானவனுக்கு கல்யாணமா. இதெல்லாம் சினிமா. எப்ப ஒழியுமோ இந்த சினிமா.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d008","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"ஏன் உங்களையே தாக்குதோ!","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d009","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"ஏய், பாட்டாளிங்க ஏண்டா படக்காட்சி!","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d010","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"நான் முழுதும் கஷ்டப்பட்டு வேலை செய்தவனுக்கு கொஞ்சம் நீம்மதி தாண்டி சினிமா. அந்த அவசரம் போதாதே சந்தேக வேண்டாம்கிறீங்களா?","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d011","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"அய்யா சந்தோஷம். உலகம் பூரா இந்த கரண்டு கட்டு வந்து சினிமாவே ஒழிஞ்சி போகணும்.","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d012","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"நல்ல எண்ணத்தைப் பாருடா. சினிமா ஒழியறதுக்காக மழை பேஞ்சு ஊரே செத்துப்போகத்தும் கூடாதுங்கிறாரு!","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d013","canonical_scene":52,"source_scene_heading":52,"speaker_label":"மற்றொரு தொழிலாளி","text":"வயசானவனே இப்படித்தான் உள்ளவங்க.","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d014","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்ணகோடி","text":"யாருக்கடா வயசாச்சு....வல்லக் கட்டிடுவேன். இந்தப் பசங்களாம் பாண்டியன் கோஷ்டிபோல இருக்கு. அவனும் இப்படித்தான் சொன்னான். வயசாயிட்டுமா வயசு. இது பழனி பஞ்சாமிருதம் பட்ட தன்.","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"}
]
