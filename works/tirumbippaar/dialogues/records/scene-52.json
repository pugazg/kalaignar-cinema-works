[
  {"id":"tirumbippaar-s052-d001","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"(சாப்பிட்டுக் கொண்டே) பரந்தாமனைப் போல ஒரு நாணயமான தலைவனைப் பார்க்க முடியாது. நல்ல ஒழுக்கம், நேர்மையான நடத்தை இவைகளுக்கெல்லாம் ஒரே ஒரு ஏக எடுத்துக்காட்டு நமது பரந்தாமனேதான்.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d002","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி ஒருவன்","text":"நீங்க புகழ்ந்து பேசுறீங்க. உங்க புள்ளைதான் எழுதியிருக்கு 'போலித் தலைவன்' என்று.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d003","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"புள்ளை எழுதுவான் புத்தி கெட்டவன். அவன் எனக்குப் புள்ளையா, துரோகி.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d004","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"சும்மா இருங்க. பாண்டியன் பெரிய பகுத்தறிவுவாதி ! இலட்சிய வீரன் ! உண்மைத் தொண்டன்","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d005","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"அவனா..துரோகி!","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d006","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"போலித் தலைவன்னு சினிமாகூட எடுக்கப்போறாங்களாம்.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d007","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"எடுப்பாங்க எடுப்பாங்க ! முதல்ல இந்த சினிமாவே ஒழியணும். சீர்திருத்தம் மண்ணாங்கட்டி, விதவைக்கு திருமணம். பால்ய விவாகம் கூடாது. வயசானவனுக்குக் கல்யாணமா. இதெல்லாம் சினிமா. எப்ப ஒழியுமோ இந்த சினிமா.","page_provenance":[{"pdf_page":67,"printed_page":59}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d008","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"ஏன் உங்களையே தாக்குதோ","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d009","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"ஏய், பாட்டாளிக்கு ஏண்டா படக்காட்சி !","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d010","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"நாள் முழுதும் கஷ்டப்பட்டு வேலை செய்றவனுக்கு கொஞ்சம் நிம்மதி தர்றது சினிமா. அந்த அல்ப சந்தோஷங்கூட வேண்டாங்கிறீங்களா?","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d011","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"அய்ய சந்தோஷம். உலகம் பூறா இந்த கரண்டுகட்டு வந்து சினிமாவே ஒழிஞ்சி போகணும்.","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d012","canonical_scene":52,"source_scene_heading":52,"speaker_label":"தொழிலாளி","text":"நல்ல எண்ணத்தைப் பாருடா. சினிமா ஒழியறத்துக்காக மழை பேஞ்சு ஊரு செழிப்பாகறதும் கூடாதுங்கிறாரு !","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d013","canonical_scene":52,"source_scene_heading":52,"speaker_label":"மற்றொரு தொழிலாளி","text":"வயசானாலே இப்படித்தான் உளறுவாங்க.","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"},
  {"id":"tirumbippaar-s052-d014","canonical_scene":52,"source_scene_heading":52,"speaker_label":"புண்யகோடி","text":"யாருக்கடா வயசாச்சு ... பல்லைத் தட்டிடுவேன். இந்தப் பசங்கள்ளாம் பாண்டியன் கோஷ்டிபோல இருக்கு. அவனும் இப்படித்தான் சொன்னான். வயசாயிட்டுதாம்ல வயசு. இது பழனி பஞ்சாமிருதம் பட்ட தலை.","page_provenance":[{"pdf_page":68,"printed_page":60}],"source_scene_file":"scene-52.md"}
]
