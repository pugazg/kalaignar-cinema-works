[{"id":"tirumbippaar-s029-d001","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"வாப்பா! இரண்டு மூணு வாரமா ஏக ஜாலியா இருந்திருக்கும் life ..","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d002","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பரந்தாமன்","text":"பாவம்... சென்னையிலே குடும்பம் அமைத்து என்னை சம்சார சிறையிலே போடலாமென்று துடித்தாள் பாமா... எங்கே போனாளோ என்ன ஆனாளோ!....","page_provenance":[{"pdf_page":34,"printed_page":26}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d003","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"ம்... சம்சாரமாவது ஒண்ணாவது மனுஷன் free-யா இருக்கணும், என்னாட்டம். நமக்கு உதாரணமாகத்தானே கடவுள் படைத்திருக்கிறான், மலருக்கு மலர் தாவுகிற......","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d004","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"மரத்துக்கு மரம் தாவுகிற மந்தி","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d005","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"டே...","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d006","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"மறந்துட்டிங்களோன்னு ஞாபகப்படுத்தினே.","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d007","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"கம்பர் மகன் அம்பிகாபதி! சும்மாயிருடா முந்திரிக்கொட்டை!","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d008","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பரந்தாமன்","text":"என்னடா?","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d009","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"நமக்குச் சம்மந்தமில்லை.","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d010","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"நமக்காமில்ல நமக்கு! இவரும் சேந்துக்கிறாரு விஷயத்தை சொல்லு கழுதை!","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d011","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"மில் தொழிலாளிங்க சம்பள உயர்வுக்காக கிளர்ச்சி பண்றாங்க!...","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d012","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பரந்தாமன்","text":"அப்படியா? அப்ப நமக்கு சம்பந்தமில்லை.","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d013","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"ஏன் இல்லை? எனக்கு ஒரு வழி தோணுது. இந்தக் கிளர்ச்சியை சாதகமாக்கிக்கிட்டு பாட்டாளிகளைப்பத்தி ஒரு புஸ்தகம் எழுதினா இந்தச் சமயம் நல்லா விக்கும்.","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d014","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பரந்தாமன்","text":"ஆமாம்.... இன்றைக்கே எழுத ஆரம்பிக்கிறேன். பெயர் என்ன வைக்கலாம்—புஸ்தகத்துக்கு... ஆங்...சரி.... பாட்டாளியின் குரல்.","page_provenance":[{"pdf_page":35,"printed_page":27}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d015","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"சபாஷ்! பாட்டாளியின் குரல். என்ன மூளா! என்ன மூளா!","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d016","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"முதல்ல என் குரல் கொஞ்சம் கவனிங்க!","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d017","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பரந்தாமன்","text":"என்னடா?","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d018","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"எனக்கு சம்பளம்....","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d019","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"(கோபமாய்) டேய்! மில் தொழிலாளிகளுக்காக புஸ்தகம் எழுதினு ...","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d020","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"நானும் ஒரு தொழிலாளிதானுங்க!....","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d021","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"பெரிய தொழிலாளி இவரு! பரந்தாமா! நீ எழுத ஆரம்பிச்சுடு! லாபத்திலே உனக்கு கால், எனக்கு முக்கால்.","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d022","canonical_scene":29,"source_scene_heading":29,"speaker_label":"பையன்","text":"எனக்கு...","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"},{"id":"tirumbippaar-s029-d023","canonical_scene":29,"source_scene_heading":29,"speaker_label":"கருடன்","text":"அறை! (அறைதல்)","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-29.md"}]
