[
  {"id":"tirumbippaar-s086-d001","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"குமுதா! குமுதா!","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d002","canonical_scene":86,"source_scene_heading":86,"speaker_label":"குமுதா","text":"பாண்டியன்!....","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d003","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"குமுதா! உன்னைத் தேடி எங்கெல்லாம் அலைந்தேன் தெரியுமா? ஆமாம் குழந்தை எங்கே? (குழந்தையை கொஞ்சுதல்)","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d004","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"என்ன குமுதா குழந்தைக்குப் பெயர்?","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d005","canonical_scene":86,"source_scene_heading":86,"speaker_label":"குமுதா","text":"என்னவாயிருக்கும் சொல்லுங்களேன்!","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d006","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"தாத்தா பெயரா?","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d007","canonical_scene":86,"source_scene_heading":86,"speaker_label":"வாட்ச்மேன்","text":"என்னப்பா....ஒருத்தன் வந்தாலே பிச்சைபோட ஆள் இல்ல. நீ பெரிய பட்டாளமே திரட்டிக்கிட்டு வாரியே.","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d008","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"ஒருத்த ஒருத்தரா வந்தா தொல்லையா இருக்கும்னுதான் எல்லோரும் சேர்ந்து வர்றோம். ம் என்னு செய்றது! எங்க காலம். நல்லாத்தான் வாழ்ந்தோம்!","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d009","canonical_scene":86,"source_scene_heading":86,"speaker_label":"வாட்ச்மேன்","text":"ஓகோ நெசவாளிங்களா!","page_provenance":[{"pdf_page":103,"printed_page":95}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d010","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"அது கெட்டது போ! நாங்களெல்லாம் மில் தொழிலாளிங்க. அதும் கோயமுத்தூரு! வேலை கிடையாது. இப்படி வேதனைபடுறோம்.","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d011","canonical_scene":86,"source_scene_heading":86,"speaker_label":"வாட்ச்மேன்","text":"குமுதா! குமுதா! கொஞ்சம் அரிசி கொண்டாம்மா!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d012","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"கொஞ்சமா—கூட்டத்தைப் பார்த்துட்டு......","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d013","canonical_scene":86,"source_scene_heading":86,"speaker_label":"வாட்ச்மேன்","text":"பின்னே என்ன குருணியா போடுவாங்க!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d014","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"(புண்ணகோடியைக் கண்டு) அப்பா! அப்பா!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d015","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"பாண்டியா! என் மகனே! பாத்தியா உங்கப்பன் கதியை!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d016","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"அப்பா! பரதேசியா மாறிவிட்டீர்கள்?","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d017","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"மாத்திட்டான் அந்தப் பரந்தாமன்.","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d018","canonical_scene":86,"source_scene_heading":86,"speaker_label":"குமுதா","text":"(வாட்ச்மேனிடம்) இவர்தான் பாண்டியன்! என் கணவர்!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d019","canonical_scene":86,"source_scene_heading":86,"speaker_label":"வாட்ச்மேன்","text":"அப்படியா!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d020","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"ஆமாம். (வாட்ச்மேனிடம்) இவர்தான் எங்கப்பா. அப்பா! என்னப்பா நடந்தது?","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d021","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"பரந்தாமன் சுயநலத்துக்காக வேலை நிறுத்தம் பண்ணி மன்னிப்பு. அதுக்காக எங்களுக்கெல்லாம் வேலை இல்லேனுட்டான் முதலாளி.","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d022","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"ஆ! குற்றம் செய்தது யார்? கொடுமை அனுபவிப்பது யார்?","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d023","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"நாங்கமாத்திரம் இல்லப்பா! நூற்றுக்கணக்கான குடும்பங்கள் இப்படி ஆயிட்டுது!","page_provenance":[{"pdf_page":104,"printed_page":96}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d024","canonical_scene":86,"source_scene_heading":86,"speaker_label":"பாண்டியன்","text":"நூற்றுக்கணக்கான குடும்பங்கள்! வேதனைப் படும் தொழிலாளர்களின் சார்பில் நான் அந்த முதலாளியை சந்திக்கிறேன்.","page_provenance":[{"pdf_page":105,"printed_page":97}],"source_scene_file":"scene-86.md"},
  {"id":"tirumbippaar-s086-d025","canonical_scene":86,"source_scene_heading":86,"speaker_label":"புண்ணகோடி","text":"என் மகனு மகன்தான். (கட்டிக்கொள்கிறான்)","page_provenance":[{"pdf_page":105,"printed_page":97}],"source_scene_file":"scene-86.md"}
]
