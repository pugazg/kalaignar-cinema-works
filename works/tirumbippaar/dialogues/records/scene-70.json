[{"id":"tirumbippaar-s070-d001","canonical_scene":70,"source_scene_heading":70,"speaker_label":"பரந்தாமன்","text":"புண்யகோடியை அரஸ்ட் செய்ய போலீஸ் போயிருக்கிறது! இன்னும் கொஞ்ச நேரத்தில் இங்கு வந்து விடுவார்கள்!","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d002","canonical_scene":70,"source_scene_heading":70,"speaker_label":"கருடன்","text":"அய்யோ இப்ப எங்க ஓடுறது !","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d003","canonical_scene":70,"source_scene_heading":70,"speaker_label":"பரந்தாமன்","text":"மாறுவேஷத்தில் ஓடினால்தான் போலீஸார் கண்ணிலிருந்து தப்பிக்கலாம்.","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d004","canonical_scene":70,"source_scene_heading":70,"speaker_label":"கருடன்","text":"மாறுவேஷமா?","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d005","canonical_scene":70,"source_scene_heading":70,"speaker_label":"பரந்தாமன்","text":"ஆமாம். என்ன மாறுவேஷம் போடுவது?","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d006","canonical_scene":70,"source_scene_heading":70,"speaker_label":"கருடன்","text":"உனக்குத்தான் பைத்யம் மாதிரி நடிக்கத் தெரியுமே!","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d007","canonical_scene":70,"source_scene_heading":70,"speaker_label":"பரந்தாமன்","text":"சே. அதெல்லாம் பழசாப் போச்சு. போலீஸுக்குப் புரிஞ்சுடும்!","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d008","canonical_scene":70,"source_scene_heading":70,"speaker_label":"கருடன்","text":"அப்புறம் ஆப்புட்டுக்க வேண்டியதுதானா?","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d009","canonical_scene":70,"source_scene_heading":70,"speaker_label":"இன்ஸ்பெக்டர்","text":"ஏ...கருடன் எங்கே?","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d010","canonical_scene":70,"source_scene_heading":70,"speaker_label":"இன்ஸ்பெக்டர்","text":"பரந்தாமன் எங்கே?","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d011","canonical_scene":70,"source_scene_heading":70,"speaker_label":"இன்ஸ்பெக்டர்","text":"நீ உண்மையைச் சொல்லமாட்டே. நீயும் அவுங்க ஆளுதானே?","page_provenance":[{"pdf_page":86,"printed_page":78}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d012","canonical_scene":70,"source_scene_heading":70,"speaker_label":"பையன்","text":"இல்லிங்க! நான் சேத்திலே மலர்ந்த செந்தாமரை ! என்னை விட்டுடுங்க!","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-70.md"},{"id":"tirumbippaar-s070-d013","canonical_scene":70,"source_scene_heading":70,"speaker_label":"இன்ஸ்பெக்டர்","text":"ம் .. தேடிப் பாருங்க.","page_provenance":[{"pdf_page":87,"printed_page":79}],"source_scene_file":"scene-70.md"}]
