[
  {"id":"tirumbippaar-s084-d001","canonical_scene":84,"source_scene_heading":84,"speaker_label":"வாட்ச்மேன்","text":"(பாண்டியனைப் பார்த்து) தம்பி! கொஞ்சம் நில்லேன்! (அருகே வந்து) இந்தப் பக்கம்தானே போறே?","page_provenance":[{"pdf_page":102,"printed_page":94}],"source_scene_file":"scene-84.md"},
  {"id":"tirumbippaar-s084-d002","canonical_scene":84,"source_scene_heading":84,"speaker_label":"பாண்டியன்","text":"ஆமாம்.","page_provenance":[{"pdf_page":102,"printed_page":94}],"source_scene_file":"scene-84.md"},
  {"id":"tirumbippaar-s084-d003","canonical_scene":84,"source_scene_heading":84,"speaker_label":"வாட்ச்மேன்","text":"உம். இந்தக் கார்டை கொஞ்சம் தபால் பெட்டியிலே போட்டுட்டு போய்டேன். (பாண்டியன் வாங்குதல்) ரொம்ப அவசரம் எனக்கு ஆஸ்பத்திரி நேரம். வெளியே போக்கூடாது! போட்டுரியா?","page_provenance":[{"pdf_page":102,"printed_page":94}],"source_scene_file":"scene-84.md"},
  {"id":"tirumbippaar-s084-d004","canonical_scene":84,"source_scene_heading":84,"speaker_label":"பாண்டியன்","text":"ம்... (வாங்கிக்கொண்டு போகிறான்)","page_provenance":[{"pdf_page":102,"printed_page":94}],"source_scene_file":"scene-84.md"}
]
