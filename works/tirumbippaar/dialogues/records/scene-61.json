[{"id":"tirumbippaar-s061-d001","canonical_scene":61,"source_scene_heading":61,"speaker_label":"மேனேஜர்","text":"ரொம்ப ஒழுங்காயிருக்கு டைப் பண்ற லக்ஷணம்!","page_provenance":[{"pdf_page":79,"printed_page":71}],"source_scene_file":"scene-61.md"},{"id":"tirumbippaar-s061-d002","canonical_scene":61,"source_scene_heading":61,"speaker_label":"மேனேஜர்","text":"பாண்டியன்! பாண்டியன்! போதும் நீ செஞ்ச வேலை. வெளியே போ!","page_provenance":[{"pdf_page":79,"printed_page":71}],"source_scene_file":"scene-61.md"},{"id":"tirumbippaar-s061-d003","canonical_scene":61,"source_scene_heading":61,"speaker_label":"குமுதா","text":"சார் தயவு செய்து .......","page_provenance":[{"pdf_page":79,"printed_page":71}],"source_scene_file":"scene-61.md"},{"id":"tirumbippaar-s061-d004","canonical_scene":61,"source_scene_heading":61,"speaker_label":"மேனேஜர்","text":"ஊஹும். போன்னா போ !","page_provenance":[{"pdf_page":79,"printed_page":71}],"source_scene_file":"scene-61.md"}]
