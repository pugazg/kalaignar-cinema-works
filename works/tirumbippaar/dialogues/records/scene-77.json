  {"id":"tirumbippaar-s077-d001","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"யார்ரா இது?","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d002","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பையன்","text":"இவங்கதான் பரந்தாமனின் அக்காள்!","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d003","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"பரந்தாமன் அக்காள்...இங்க எங்க வந்தே...போ—போ....","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d004","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"கோபிக்காதீர்கள்...நான் வந்த விஷயம்...","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d005","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"பரந்தாமனுக்கு பெண் கேட்க...இல்லையா?","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d006","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"பரந்தாமனுக்கு பெண் கேட்க அல்ல—பாட்டாளிகளுக்கு வாழ்வு கேட்க!","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d007","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"என்ன உளறே?","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d008","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"பல தொழிலாளிகளை கிளர்ச்சியில் ஈடுபட்டார்கள் என்பதற்காக வேலையைவிட்டு நீக்கிவிட்டீர்கள். அவர்கள் எல்லாம் வேதனை தாங்காமல் வாடுகிறார்கள். அவர்களை மறுபடியும்...","page_provenance":[{"pdf_page":92,"printed_page":84}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d009","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"சரிதான். இப்ப தலைமைப்பதவி மாறியிருக்கோ—தம்பி போயி அக்காள்! குடும்பத்துக்குள்ளேயே சுத்துதே தலைமைப் பதவி.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d010","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"தவிப்பவர்கள் குறையைச் சொல்ல தலைவியாகத்தான் வரவேண்டுமோ? அய்யா அப்படியொன்றும் நான் வரவில்லை. ஏழைத் தொழிலாளிகளின் ஏக்கத்தைப் போக்குகிறேன் என்று சொல்லுங்கள்—போதும்.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d011","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"இந்தப் புத்தியை முன்னமேயே உன் தம்பிகிட்ட சொல்லியிருக்கணும் நீ.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d012","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"தம்பி செய்த பாவத்திற்குத்தான் அக்காள் பிராயச்சித்தம் செய்ய வந்திருக்கிறாள். தயவுசெய்யுங்கள் அய்யா.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d013","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"முடியாது...போ....போய்விடு.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d014","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"(காலில் விழுந்து) அய்யா! உங்கள் காலைப்பிடித்துக் கொள்கிறேன், கதியற்றவரின் கண்ணீரைத் துடையுங்கள். பசி, பட்டினி, பஞ்சத்தில் பாட்டாளிகளைத் தள்ளாதீர்கள். என்ன இருந்தாலும் அவர்கள் உங்களிடம் வேலை செய்பவர்கள். உங்களுக்கு குழந்தைகள் மாதிரி ஐயா!...","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d015","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"விடு காலை.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d016","canonical_scene":77,"source_scene_heading":77,"speaker_label":"பூமால்","text":"விட முடியாது. வேதனைக் குரலுக்கு நீங்கள் செவி சாய்க்கும் வரையில், வாழ முடியாதவர்களுக்கு நீங்கள் வகைசெய்யும் வரையில் விட முடியாது.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d017","canonical_scene":77,"source_scene_heading":77,"speaker_label":"முதலாளி","text":"சீ மூதேவி.","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"},
  {"id":"tirumbippaar-s077-d018","canonical_scene":77,"source_scene_heading":77,"speaker_label":"ஊஷா","text":"அடடே! பூமாலையா....பலமாக அடிபட்டுவிட்டதே. டேய்....யார் அங்கே?","page_provenance":[{"pdf_page":93,"printed_page":85}],"source_scene_file":"scene-77.md"}
]
