  {"id":"tirumbippaar-s041-d001","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பாண்டியன்","text":"என்ன தேடுகிறாய்?","page_provenance":[{"pdf_page":53,"printed_page":45}],"source_scene_file":"scene-41.md"},
