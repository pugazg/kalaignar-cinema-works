  {"id":"tirumbippaar-s041-d003","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பாண்டியன்","text":"கேளேன் தருகிறேன் ...","page_provenance":[{"pdf_page":53,"printed_page":45}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d004","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"(கேலியாக சிரித்து விட்டு) சரியான திருடனப்பா ! நீ மரியாதையாகப் பணத்தைக் கொடுக்கிறாயா இல்லையா?...","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d005","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பாண்டியன்","text":"என்ன சொல்கிறாய் இப்போது?","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d006","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"ஏய் ! சரிதான்.வீட்டுக்குள்ளேயே திருட ஆரம்பிச்சுட்டியா நீ! நானே வீட்ல திருடுறது கிடையாது.","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d007","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"என்னப்பா","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d008","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"பாரு அக்கா. பணம் வச்சிருந்தேன் திருடிவிட்டான்.","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d009","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"ஏது பணம்?","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d010","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"பதிப்பகத்திலேயிருந்து வாங்கிக்கொண்டுவந்தேன்.","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d011","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"தெரியும் எனக்கு எங்கேயிருந்து வாங்கிக்கொண்டு வந்ததென்று.","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d012","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"உண்மைதான் அக்கா!","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d013","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"முத்திரை போட்டிருக்கிறது பார். முதுகெலும்பு உடைய பாடுபடும் தொழிலாளிக்கு முகாரிதான் மோகன கீதமா என்று முழக்கம் செய்தாயே. அந்த முழக்கத்திற்குப் பரிசாக மில் முதலாளி வழங்கிய பணம் இதுவென்று முத்திரை போட்டிருக்கிறது பார் !","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d014","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"ஓ....பணத்தைத் திருடி உன்னிடம் கொடுத்து விட்டானா?","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d015","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"போதும்! கருங்காலித்தனம் செய்து ஏழைகளைக் காட்டிக் கொடுத்துவிட்டு கைக் கூலி பெறுகிற உனக்கு பேச்சுவேறு.","page_provenance":[{"pdf_page":54,"printed_page":46}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d016","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"அக்கா! அதை எதற்காக வாங்கினேன் என்று உனக்குத் தெரியாது. தொழிலாளர் க்ஷேம நிதியில் சேர்ப்பதற்காக !","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d017","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"படித்தேனப்பா அதையும்.... இதோ பார் . கல்யாணிக்கு ஆயிரம், சுபத்ராவுக்கு முன்னூறு, சுலோசனாவுக்கு ஐநூறு, தேவகிக்கு ஆயிரத்து இருநூறு.","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d018","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"(சமாளிப்பதற்காக) ஹ ஹ ஹ - அட அட அடா அதைத் தவறாகப் புரிந்துகொண்டயா. ஐயோ, ராமா,முருகா, நானும் கருடனும் சேர்ந்து சினிமா தியேட்டர் ஒண்ணு ஓப்பன் பண்ணப்போகிறோம். அதிலே கல்யாணி, சுபத்ரா, சுலோசனா, தேவகி இந்தப் படமெல்லாம் ரிலீஸ் பண்றத்துக்கு அட்வான்ஸ் கொடுத்த கணக்கு இது ! ஹ ஹ ஹ அய்யோ அய்யோ","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d019","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"ஏய். நீதான் இவ்வளவுக்கும் காரணம்.","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d020","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பாண்டியன்","text":"எதற்கு ? லஞ்சம் வாங்கியதற்கா,தொழிலாளரைக் காட்டிக் கொடுப்பதற்கா","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d021","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"மரியாதையாகப் பேசு !","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d022","canonical_scene":41,"source_scene_heading":41,"speaker_label":"குமுதா","text":"அதை நீ கற்றுக்கொள்ள வேண்டும் மாமா?","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d023","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"குமுதா ! நீ அவரை அழைத்துக்கொண்டு போம்மா உள்ளே !","page_provenance":[{"pdf_page":55,"printed_page":47}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d024","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"ஆமாம்! அழைத்துக் கொண்டு போயி ஆராரோ பாடி பாப்பாவைத் தாலாட்டு போ!","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d025","canonical_scene":41,"source_scene_heading":41,"speaker_label":"குமுதா","text":"(கோபமுடன்) போதும்!","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d026","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"(அதட்டல்) குமுதா","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d027","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"இது வீடா, வேசி மடமா என்று தெரியவில்லை எனக்கு !","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d028","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"பரந்தாமா ! நிதானமாகப் பேசு !","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d029","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"பிறகென்ன, கல்யாணமாகாத பெண்ணை ஒரு காலிப் பயலுடன் திரியவிடுவது மாத்திரம் நன்றாயிருக்கிறதா ?","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d030","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"கல்யாணமாகிவிட்டது அவளுக்கு. பாண்டியனும் குமுதாவும் கணவனும் மனைவியும்.","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d031","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"காந்தர்வ மணமா அல்லது கனவு கண்டாயா?","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d032","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"பதிவுத் திருமணம்.","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d033","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"பதிவுத் திருமணம். நான் ஒருவன் இருக்கிறேன் வீட்டில். எனக்குத் தெரியாமல் பதிவுத் திருமணம்..","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d037","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"நீ வீட்டிலா இருக்கிறாய்... 'வீடு' என்றாவது உன் வாயால் சொன்னாயே. அதுவே எனக்கு சந்தோஷம்!...","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d038","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"அக்கா ! உன்னை உணர்ந்துகொண்டேன். தம்பீ தம்பீ என்று நீ பாசங்காட்டியதெல்லாம் வெறும் பாசாங்கு என்று புரிந்துகொண்டேன். இல்லாவிட்டால் குமுதா உனக்காக வாழ்கிறாள், உன் மனைவிதான் அவள் என்று அன்பு வழிவதுபோலக் கூறிவிட்டு, இப்போது யாரோ ஒரு அனாதைப் பயலுக்கு அவளை மனைவியாக்கிவிட்டேன் என்று கூறுவாயா!","page_provenance":[{"pdf_page":56,"printed_page":48}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d034","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"உனக்கேன் மனைவி ? உனக்குத்தான் நினைத்தபோதெல்லாம் மனைவிகள் கிடைக்கிறார்களே ! அன்பைக் கேட்-\nகாமல் ஐஸ்வரியத்தைக் கேட்கும் அந்த அழகிகளுக்கு அள்ளி அள்ளிக் கொடுக்க அப்பாவித் தொழிலாளர்கள் இருக்கிறார்கள் மில் முதலாளியிடம் அடகுவைக்க...","page_provenance":[{"pdf_page":56,"printed_page":48},{"pdf_page":57,"printed_page":49}],"page_segments":[{"pdf_page":56,"printed_page":48,"text":"உனக்கேன் மனைவி ? உனக்குத்தான் நினைத்தபோதெல்லாம் மனைவிகள் கிடைக்கிறார்களே ! அன்பைக் கேட்-"},{"pdf_page":57,"printed_page":49,"text":"காமல் ஐஸ்வரியத்தைக் கேட்கும் அந்த அழகிகளுக்கு அள்ளி அள்ளிக் கொடுக்க அப்பாவித் தொழிலாளர்கள் இருக்கிறார்கள் மில் முதலாளியிடம் அடகுவைக்க..."}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d035","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பரந்தாமன்","text":"போதும் நிறுத்து !","page_provenance":[{"pdf_page":57,"printed_page":49}],"source_scene_file":"scene-41.md"},
  {"id":"tirumbippaar-s041-d036","canonical_scene":41,"source_scene_heading":41,"speaker_label":"பூமாலை","text":"புத்திசாலி ! புனிதமானவன் ! இப்படியெல்லாம் உனக்கு புகழுரைகள் வரவேண்டுமென்று எதிர்பார்த்தேன். பரத்தைலோலன், பாதகன் என்ற பழிச்சொற்கள் வருமென்று நினைக்கவேயில்லை.","page_provenance":[{"pdf_page":57,"printed_page":49}],"source_scene_file":"scene-41.md"}
]
