[{"id":"tirumbippaar-s030-d001","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குணரத்னம்","text":"அவள் மாத்திரமா போனாள்.வீட்டை அடமானம் வச்சு, செஞ்சுப்போட்ட ஆயிரம் ரூபாய் நகையோடவும் போய்ட்டா!","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d002","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பூமாலை","text":"ஆயிர ரூபாய் நகைதானே.இந்தாருங்கள்... (தன் அணிகலன்களைக் கழற்றிக்கொடுத்து) இதை வைத்துக்கொள்ளுங்கள். (கொடுக்கிறாள்)","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d003","canonical_scene":30,"source_scene_heading":30,"speaker_label":"குணரத்னம்","text":"(அதை வாங்கி) ஏன்? இதை நான் யாருக்குப் போட்டு அழகு பார்க்கப் போகிறேன். நீயே வச்சுக்க. (கீழே போட்டுவிட்டு) எனக்குத் துரோகம் பண்ணுனவுங்க தொலைஞ்சு போய்டுவாங்க !...","page_provenance":[{"pdf_page":36,"printed_page":28}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d004","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பரந்தாமன்","text":"அக்கா. இது ஏது நகை?","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d005","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பரந்தாமன்","text":"ஏன் இப்படிக் கீழே கிடக்கிறது. (எடுக்கிறான்) எல்லாம் பொன்னகைதானே?","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d006","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பூமாலை","text":"இல்லை. துரோகத்தின் புன்னகை !","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d007","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பரந்தாமன்","text":"(புரியாதவன்போல) என்னடா இது ! என்னக்கா விஷயம்?","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d008","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பூமாலை","text":"மான் தோலிலே வேங்கை அதிக நாள் வாழமுடியாது பரந்தாமா ! அதையும் வேட்டையாட ஒரு வேடன் வந்துவிடுவான். ஊர்ப் பெண்களிடம் விளையாடுகிறவர்களை உயிரோடு விடுவதில்லை மக்கள் !... அதை ஞாபகம் வைத்துக்கொள்!","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d009","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பரந்தாமன்","text":"எப்போது வீட்டுக்கு வந்தாலும் இந்த ஒப்பாரிதானா ? மனிதன் நிம்மதியா வாழவே முடியாது போலிருக்கிறது!","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d010","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பூமாலை","text":"மனிதன் தான் மாத்திரம் வாழக்கூடாது. மற்றவரையும் வாழவிட வேண்டும்!","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d011","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பரந்தாமன்","text":"சரி போதும் போதும். காவியாடை கட்டிக்கொண்டு எங்கேயாவது தொலைய வேண்டியதுதான்.","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d012","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பூமாலை","text":"ஏன் ! அந்தத் திரைமறைவிலே சுலபமாக ஏமாற்ற முடியுமென்று கருதுகிறாயா? பெண் இனத்தை மண்ணில் நெளியும் புழுக் கூட்டமாக மதித்துவிட்ட பித்தனே ! எங்கு போனாள் பாமா? சொல். எங்கே அவளைத் தவிக்கவிட்டாய்? எரிமலைமீது விளையாட வந்த அந்த ஏழைச் சிறுமியின் கதி என்னவாயிற்று. சொல்! சொல்ல மாட்டாயா பாவி ! எங்கே பாமா?","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d013","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பரந்தாமன்","text":"பரலோகத்தில் போய் தேடிப்பார் !","page_provenance":[{"pdf_page":37,"printed_page":29}],"source_scene_file":"scene-30.md"},{"id":"tirumbippaar-s030-d014","canonical_scene":30,"source_scene_heading":30,"speaker_label":"பூமாலை","text":"(கண்ணீர் பெருக) ஆ ! அம்மா ! அப்பா ! உங்களுக்குக் கொடுத்த உறுதிமொழியை என்னால் காப்பாற்ற முடியாது போலிருக்கிறதே!","page_provenance":[{"pdf_page":38,"printed_page":30}],"source_scene_file":"scene-30.md"}]
