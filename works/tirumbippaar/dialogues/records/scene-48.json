[
  {"id":"tirumbippaar-s048-d001","canonical_scene":48,"source_scene_heading":48,"speaker_label":"ஒரு தொழிலாளி","text":"(புண்ணகோடியிடம்) என்னங்க. மேஸ்திரி குறைகளையெல்லாம் சீக்கிரம் கவனிக்கப்போறாரு முதலாளின்னீங்க ஒண்ணியும் காணுமே!","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d002","canonical_scene":48,"source_scene_heading":48,"speaker_label":"புண்ணகோடி","text":"அதெல்லாம் சீக்கிரம் நடக்கும் பாரு!... நடக்கலேன்னு நம்ம தலைவர் இறுதிப் போராட்டம் ஆரம்பிச்சுருவாரு!","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d003","canonical_scene":48,"source_scene_heading":48,"speaker_label":"தொழிலாளி","text":"அது சரி...இப்ப ஆரம்பிச்ச ஜனவரிப் போராட்டமே பிசு பிசுன்னு போயிட்டுதுன்னு சில பேர் பேசிக்கிறாங்களே!","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d004","canonical_scene":48,"source_scene_heading":48,"speaker_label":"புண்ணகோடி","text":"பேசுவாங்க, பேசுவாங்க! முட்டாள்கள். நம்முடைய தலைவர் பரந்தாமனின் சாதாரணமா நினைச்சுக் கிட்டாங்க! புலி பதுங்குறது பாய்ச்சலுக்கு அடையாளம்னு சொல்லு.","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d005","canonical_scene":48,"source_scene_heading":48,"speaker_label":"தொழிலாளி","text":"பதுங்கிறது புலியா பூனையான்னுதானே சந்தேகப்படுறாரு பாண்டியன்!","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d006","canonical_scene":48,"source_scene_heading":48,"speaker_label":"புண்ணகோடி","text":"பாண்டியன்...அந்தப் பய பேச்சை என்கிட்டே பேசாதிங்க...அயோக்கியப் பயல்! அப்பன் கல்யாணம் பண்ணிக்கிறதைத் தடுக்கிற பயல் அகில உலகத்திலேயும் நான் கண்டதில்ல.","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d007","canonical_scene":48,"source_scene_heading":48,"speaker_label":"தொழிலாளி","text":"சரி மேஸ்திரி நாங்க வர்றோம்...","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
