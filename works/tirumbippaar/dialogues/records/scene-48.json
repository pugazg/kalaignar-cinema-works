  {"id":"tirumbippaar-s048-d009","canonical_scene":48,"source_scene_heading":48,"speaker_label":"பரந்தாமன்","text":"என்ன...ஆங்...","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d010","canonical_scene":48,"source_scene_heading":48,"speaker_label":"புண்ணகோடி","text":"இப்பதான் மில்வேல முடிஞ்சு...","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
  {"id":"tirumbippaar-s048-d011","canonical_scene":48,"source_scene_heading":48,"speaker_label":"பரந்தாமன்","text":"ம்...நான் சங்கத்துப் பக்கம் போயிட்டு வர்றேன்...","page_provenance":[{"pdf_page":63,"printed_page":55}],"source_scene_file":"scene-48.md"},
