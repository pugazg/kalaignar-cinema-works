[{"id":"tirumbippaar-s027-d001","canonical_scene":27,"source_scene_heading":27,"speaker_label":"குமுதா","text":"குண்டுமணி! இன்னுமா டீ தயாராகவில்ல?","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-27.md"},{"id":"tirumbippaar-s027-d002","canonical_scene":27,"source_scene_heading":27,"speaker_label":"குமுதா","text":"சின்னம்மா! நீ அவருக்கு டீ அனுப்பச்சொல்லு. நான் போயி கேமராவுக்கு பிலிம் வாங்கிட்டு வர்றேன்...","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-27.md"},{"id":"tirumbippaar-s027-d003","canonical_scene":27,"source_scene_heading":27,"speaker_label":"பூமால்","text":"குண்டுமணி இரு!...நான் கொண்டுபோறேன் டீயை. நீ போய் வேலையைப் பாரு!...","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-27.md"},{"id":"tirumbippaar-s027-d004","canonical_scene":27,"source_scene_heading":27,"speaker_label":"குண்டுமணி","text":"சரிம்மா...","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-27.md"},{"id":"tirumbippaar-s027-d005","canonical_scene":27,"source_scene_heading":27,"speaker_label":"குண்டுமணி","text":"(தனக்குள்) பாண்டியனுக்கு உபசாரம் பன்றதுன்னு அம்மா முன்னாடி நிக்கிறாங்களே என்னு விஷயம். ஆச் சேசே! அம்மா நல்லவங்க...ம்...யாரு கண்டா. அப் போயிட்டே (சந்தேகம்) எப்பேர்ப்பட்ட ...... சரிசரி வேலைக்காரனுக்கு என்னு இதெல்லாம்......","page_provenance":[{"pdf_page":32,"printed_page":24}],"source_scene_file":"scene-27.md"}]