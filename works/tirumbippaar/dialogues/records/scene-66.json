[
  {"id":"tirumbippaar-s066-d001","canonical_scene":66,"source_scene_heading":66,"speaker_label":"தொழிலாளி","text":"என்ன இவ்வளவு நேரமா பேசுறாங்க முதலாளியும் பரந்தாமனும்?","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d002","canonical_scene":66,"source_scene_heading":66,"speaker_label":"புண்ணகோடி","text":"என்ன பேசுவாங்க! நம்ப கோரிக்கையை முதலாளி கவனிக்கப் போறாரா இல்லையான்னு ஒரு முடிவு கட்டிட்டு தான் வருவாரு பரந்தாமன். அவர் என்ன சாமான்யமா! சாக்ரடீஸ் புரட்சி அவதாரம்.","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d003","canonical_scene":66,"source_scene_heading":66,"speaker_label":"புண்ணகோடி","text":"தம்பி! என்ன பேசினீங்க! என்ன ஆச்சு......","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d004","canonical_scene":66,"source_scene_heading":66,"speaker_label":"பரந்தாமன்","text":"என்ன ஆச்சு. குறைகள் எடுத்துச் சொன்னேன். கோரிக்கையை கவனிக்கும்படியாக எப்படி எப்படியோ கேட்டுக்கொண்டேன். தொழிலாளர் புரட்சி வரும் என்று கூட எச்சரித்தேன். அசையவில்லை அந்த முதலாளி.","page_provenance":[{"pdf_page":82,"printed_page":74}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d005","canonical_scene":66,"source_scene_heading":66,"speaker_label":"புண்ணகோடி","text":"அப்புறம்?","page_provenance":[{"pdf_page":83,"printed_page":75}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d006","canonical_scene":66,"source_scene_heading":66,"speaker_label":"பரந்தாமன்","text":"அப்புறமென்ன! திருமணம் செய்யவேண்டியது தான்!","page_provenance":[{"pdf_page":83,"printed_page":75}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d007","canonical_scene":66,"source_scene_heading":66,"speaker_label":"புண்ணகோடி","text":"என்ன?","page_provenance":[{"pdf_page":83,"printed_page":75}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d008","canonical_scene":66,"source_scene_heading":66,"speaker_label":"பரந்தாமன்","text":"இல்ல ... தீர்மானம் செய்ய வேண்டியதுதான்! திட்டம் தீட்ட வேண்டியதுதான்! கோரிக்கைகள் கவனிப்பதாக இத்தனை நாள் அமைதியாயிருந்தோம். அதை கோழைத்தனம் என்று கருதிவிட்டார். குருடுமதி படைத்தவர்! கொதித்துக் கிளம்புவோம்! போர்க்கோடியை உயர்த்துவோம்! புரட்சி நடத்துவோம்! புரட்சி!","page_provenance":[{"pdf_page":83,"printed_page":75}],"source_scene_file":"scene-66.md"},
  {"id":"tirumbippaar-s066-d009","canonical_scene":66,"source_scene_heading":66,"speaker_label":"புண்ணகோடி","text":"புரட்சி! (எல்லோரும் புரட்சி கோஷம்)","page_provenance":[{"pdf_page":83,"printed_page":75}],"source_scene_file":"scene-66.md"}
]
