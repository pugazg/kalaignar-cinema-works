[{"id":"tirumbippaar-s032-d001","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கூலி","text":"இவ்வளவு பெரிய சுமை எங்கேருந்து தூக்கிட்டு வந்திருக்கேன். ஒழுங்காக காசை கொடுய்யா..","page_provenance":[{"pdf_page":38,"printed_page":30}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d002","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"எட்டணாதான் அதோட மரியாதையா போ! நான்சன்ஸ்...","page_provenance":[{"pdf_page":38,"printed_page":30}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d003","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கூலி","text":"ஏன்ய்யா பெரிய மனுஷன் சின்ன வார்த்தையெல்லாம் பேசுரே. நான்சன்சாம்ல ...","page_provenance":[{"pdf_page":38,"printed_page":30}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d004","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கூலி","text":"அடிக்காதிய்யா. நான் தொழிலாளி !","page_provenance":[{"pdf_page":38,"printed_page":30}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d005","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"தொழிலாளி. தொழிலாளியாம் தொழிலாளி ... ........","page_provenance":[{"pdf_page":38,"printed_page":30}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d006","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"கொடுக்கிற காசை வாங்கிக்கிலேன்னா, இந்தப் பசங்களை யெல்லாம் இப்படித் தான் உதைக்கணும்.","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d007","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"பாட்டாளியின் குரல்! கருடா ! பேரு நல்லா அமஞ்சு போச்சில்ல. (புத்தகத்தை புரட்டியபடி)","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d008","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"பேரு மட்டுமா ! இரண்டு நாள்ள 5000 காப்பி வித்திருக்கு ! அப்றம் என்ன?","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d009","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"யார் நீங்க !","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d010","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"தெரியலியா என்னை. நான்தான் தொழிலாளர் தலைவன். நான் ஏன் வந்திருக்கேன் தெரியுமில்ல....","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d011","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"என்னாங்க....","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d012","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"தொழிலாளி சம்பளம் ஜாஸ்தியா கேட்டா, அதை சிந்திச்சு பார்க்க..","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d013","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"இல்லிங்க, அவன் சம்பளம் கேக்கிலே. இந்த பேப்பர் பேலை தூக்கிட்டு வந்தான்","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d014","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"அது இல்லிங்க! நான் மில் தொழிலாளியை சொல்கிறேன்.","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d015","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"ஆமாம் ஆமாம். தொழிலாளிகள் பிரச்சினையை கவனிக்காத முதலாளிகளை சும்மாவிடக்கூடாது.","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d016","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"கருடா ! வாயால் கத்தி பயன் என்ன? பாட்டாளிகளின் குரல் பலம் பெறவேண்டுமானால், பெரிய கிளர்ச்சி நடத்தவேண்டும்..","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d017","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"அப்படிச் சொல்லுங்க...","page_provenance":[{"pdf_page":39,"printed_page":31}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d018","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"இந்த நாட்டின் முதுகெலும்புகள் பாட்டாளிகள். ஒரு தேசத்தின் உயிரே தொழிலாளி வர்க்கம். அதைத் துவண்டுபோக விடக்கூடாது ! நான் கங்கணம் கட்டிவிட்டேன். தொழிலாளி விடுதலைப் போராட்டத்தை விரைவில் தொடங்க வேண்டும்.","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d019","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"சபாஷ் ! சபாஷ் ! தங்களைப்போன்ற உண்மையான உறுதி படைத்த வாலிபர்கள் இருந்தால் உலகத்துக்கே ஒரே நாளில் விமோசனம் பிறந்துவிடும். தாங்கள் எழுதிய பாட்டாளியின் குரல் படிக்கும்போது, படுகிழவனையும் பாலகனாக்குகிறது. கோழையையும் புலியாக்குகிறது. நாளையதினம் நடைபெறும் பொதுக்கூட்டத்திற்கு தாங்கள் தலைமை வகித்தாக வேண்டும்.","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d020","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"தலைமையா? நானா! வேண்டாம் நான் பொதுஜனத் தொண்டன்.","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d021","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"இல்லை தம்பி ! அப்படிச் சொல்லக்கூடாது ! ஆயிரக்கணக்கான தொழிலாளரும் விரும்புகிறார்கள்.","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d022","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"தொழிலாளர் என் தோழர்கள் ! அவர்கள் அன்புக்கட்டளையை நிறைவேற்றுகிறேன். இனி இந்த உலகத்தில் தொழிலாளி நினைத்ததெல்லாம் நடக்கவேண்டும்.","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d023","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"ஆமா ...ஆமா .","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d024","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பையன்","text":"சம்பளம் ஜாஸ்தியா .","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d025","canonical_scene":32,"source_scene_heading":32,"speaker_label":"கருடன்","text":"சீ போடா! பெரிய உலக விஷயம் பேசிட்டு இருக்கும்போது...","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d026","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"அப்ப நான் வர்ரேங்க...","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d027","canonical_scene":32,"source_scene_heading":32,"speaker_label":"பரந்தாமன்","text":"நமஸ்காரம்.","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"},{"id":"tirumbippaar-s032-d028","canonical_scene":32,"source_scene_heading":32,"speaker_label":"புண்யகோடி","text":"(கருடனிடம்) நான் வர்ரேங்க!","page_provenance":[{"pdf_page":40,"printed_page":32}],"source_scene_file":"scene-32.md"}]
